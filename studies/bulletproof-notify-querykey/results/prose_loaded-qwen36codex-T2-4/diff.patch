+import { useUser } from '@/lib/auth';
+
+import { useUpdateUserRole } from '../api/update-user-role';
+
+type UpdateUserRoleProps = {
+  userId: string;
+  currentRole: 'ADMIN' | 'USER';
+};
+
+export const UpdateUserRole = ({ userId, currentRole }: UpdateUserRoleProps) => {
+  const user = useUser();
+
+  if (user.data?.role !== 'ADMIN') {
+    return <span className="text-gray-500">-</span>;
+  }
+
+  const updateUserRoleMutation = useUpdateUserRole();
+
+  return (
+    <select
+      value={currentRole}
+      onChange={(e) =>
+        updateUserRoleMutation.mutate({
+          userId,
+          data: { role: e.target.value as 'ADMIN' | 'USER' },
+        })
+      }
+      disabled={updateUserRoleMutation.isPending}
+      className="rounded-md border border-gray-300 bg-white px-2 py-1 text-sm disabled:opacity-50"
+    >
+      <option value="ADMIN">ADMIN</option>
+      <option value="USER">USER</option>
+    </select>
+  );
+};
