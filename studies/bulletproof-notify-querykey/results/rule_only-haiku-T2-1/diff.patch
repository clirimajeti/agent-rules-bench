+import { useUser } from '@/lib/auth';
+import { User } from '@/types/api';
+
+import {
+  updateUserRoleInputSchema,
+  useUpdateUserRole,
+} from '../api/update-user-role';
+
+type UpdateUserRoleProps = {
+  user: User;
+};
+
+const roleOptions = updateUserRoleInputSchema.shape.role.options.map(
+  (role) => ({ label: role, value: role }),
+);
+
+export const UpdateUserRole = ({ user }: UpdateUserRoleProps) => {
+  const currentUser = useUser();
+  const updateUserRoleMutation = useUpdateUserRole();
+
+  // Admins cannot change their own role here, so they cannot lock themselves out.
+  const isCurrentUser = currentUser.data?.id === user.id;
+
+  // While a change is in flight, show the requested role; otherwise show the server value.
+  const displayedRole = updateUserRoleMutation.isPending
+    ? updateUserRoleMutation.variables.data.role
+    : user.role;
+
+  return (
+    <select
+      aria-label={`Role for ${user.firstName} ${user.lastName}`}
+      className="block w-full rounded-md border-gray-600 py-1 pl-3 pr-8 text-sm focus:border-blue-500 focus:outline-none focus:ring-blue-500"
+      disabled={isCurrentUser || updateUserRoleMutation.isPending}
+      value={displayedRole}
+      onChange={(event) => {
+        updateUserRoleMutation.mutate({
+          userId: user.id,
+          data: {
+            role: event.target.value as User['role'],
+          },
+        });
+      }}
+    >
+      {roleOptions.map(({ label, value }) => (
+        <option key={value} value={value}>
+          {label}
+        </option>
+      ))}
+    </select>
+  );
+};
