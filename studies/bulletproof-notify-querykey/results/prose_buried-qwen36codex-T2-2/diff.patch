+import { ChevronDown } from 'lucide-react';
+
+import { cn } from '@/utils/cn';
+
+import { useUpdateUserRole } from '../api/update-user-role';
+
+const ROLES = [
+  { label: 'Admin', value: 'ADMIN' },
+  { label: 'User', value: 'USER' },
+] as const;
+
+type UpdateUserRoleProps = {
+  userId: string;
+  currentRole: 'ADMIN' | 'USER';
+};
+
+export const UpdateUserRole = ({ userId, currentRole }: UpdateUserRoleProps) => {
+  const updateUserRoleMutation = useUpdateUserRole();
+
+  return (
+    <div className="relative inline-block">
+      <select
+        value={currentRole}
+        onChange={(e) =>
+          updateUserRoleMutation.mutate({
+            userId,
+            role: e.target.value as 'ADMIN' | 'USER',
+          })
+        }
+        disabled={updateUserRoleMutation.isPending}
+        className={cn(
+          'inline-flex items-center rounded-md border border-gray-300 bg-white py-1 pl-2 pr-6 text-xs font-medium text-gray-700 shadow-sm transition-colors hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2',
+          updateUserRoleMutation.isPending && 'opacity-50 cursor-not-allowed',
+        )}
+      >
+        {ROLES.map((role) => (
+          <option key={role.value} value={role.value}>
+            {role.label}
+          </option>
+        ))}
+      </select>
+      <ChevronDown className="pointer-events-none absolute right-1.5 top-1/2 -translate-y-1/2 size-3 text-gray-400" />
+    </div>
+  );
+};
