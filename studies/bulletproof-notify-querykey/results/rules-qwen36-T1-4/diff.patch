diff --git a/apps/react-vite/src/features/comments/components/edit-comment.tsx b/apps/react-vite/src/features/comments/components/edit-comment.tsx
new file mode 100644
index 0000000..91a2457
--- /dev/null
+++ b/apps/react-vite/src/features/comments/components/edit-comment.tsx
@@ -0,0 +1,86 @@
+import { Edit } from 'lucide-react';
+
+import { Button } from '@/components/ui/button';
+import { Form, FormDrawer, Textarea } from '@/components/ui/form';
+
+import { useUpdateComment, updateCommentInputSchema } from '../api/update-comment';
+import { Comment } from '@/types/api';
+
+import { Authorization, POLICIES } from '@/lib/authorization';
+import { useUser } from '@/lib/auth';
+
+type EditCommentProps = {
+  id: string;
+  discussionId: string;
+  comment: Comment;
+};
+
+export const EditComment = ({ id, discussionId, comment }: EditCommentProps) => {
+  const user = useUser();
+  const editCommentMutation = useUpdateComment({
+    discussionId,
+  });
+
+  const canEdit = POLICIES['comment:update'](
+    user.data as any,
+    comment,
+  );
+
+  if (!canEdit) {
+    return null;
+  }
+
+  return (
+    <Authorization
+      policyCheck={canEdit}
+      forbiddenFallback={null}
+    >
+      <FormDrawer
+        isDone={editCommentMutation.isSuccess}
+        triggerButton={
+          <Button
+            variant="outline"
+            size="sm"
+            icon={<Edit className="size-4" />}
+          >
+            Edit Comment
+          </Button>
+        }
+        title="Edit Comment"
+        submitButton={
+          <Button
+            isLoading={editCommentMutation.isPending}
+            form="edit-comment"
+            type="submit"
+            size="sm"
+            disabled={editCommentMutation.isPending}
+          >
+            Submit
+          </Button>
+        }
+      >
+        <Form
+          id="edit-comment"
+          defaultValues={{
+            body: comment.body,
+          }}
+          onSubmit={(values) => {
+            editCommentMutation.mutate({
+              commentId: id,
+              data: values,
+            });
+          }}
+          schema={updateCommentInputSchema}
+        >
+          {({ register, formState }) => (
+            <Textarea
+              label="Body"
+              error={formState.errors['body']}
+              registration={register('body')}
+            />
+          )}
+        </Form>
+      </FormDrawer>
+    </Authorization>
+  );
+};
diff --git a/apps/react-vite/src/lib/authorization.tsx b/apps/react-vite/src/lib/authorization.tsx
