+import {
+  UpdateUserRoleInput,
+  useUpdateUserRole,
+} from '@/features/users/api/update-user-role';
+import { useUser } from '@/lib/auth';
+import { User } from '@/types/api';
+
+const roleOptions: { label: string; value: UpdateUserRoleInput['role'] }[] = [
+  { label: 'Admin', value: 'ADMIN' },
+  { label: 'User', value: 'USER' },
+];
+
+type UpdateUserRoleProps = {
+  id: string;
+  role: User['role'];
+};
+
+export const UpdateUserRole = ({ id, role }: UpdateUserRoleProps) => {
+  const user = useUser();
+  const updateUserRoleMutation = useUpdateUserRole();
+
+  const isPending = updateUserRoleMutation.isPending;
+  const variables = updateUserRoleMutation.variables;
+
+  return (
+    <select
+      aria-label="Role"
+      className="block rounded-md border-gray-600 py-1 pl-2 pr-8 text-sm focus:border-blue-500 focus:outline-none focus:ring-blue-500"
+      value={isPending && variables ? variables.role : role}
+      disabled={isPending || user.data?.id === id}
+      onChange={(event) =>
+        updateUserRoleMutation.mutate({
+          userId: id,
+          role: event.target.value as UpdateUserRoleInput['role'],
+        })
+      }
+    >
+      {roleOptions.map((option) => (
+        <option key={option.value} value={option.value}>
+          {option.label}
+        </option>
+      ))}
+    </select>
+  );
+};
