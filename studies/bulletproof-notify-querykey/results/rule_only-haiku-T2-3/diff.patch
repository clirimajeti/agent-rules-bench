+import { useUser } from '@/lib/auth';
+import { User } from '@/types/api';
+import { cn } from '@/utils/cn';
+
+import {
+  UpdateUserRoleInput,
+  updateUserRoleInputSchema,
+  useUpdateUserRole,
+} from '../api/update-user-role';
+
+type UpdateUserRoleProps = {
+  id: string;
+  role: User['role'];
+};
+
+const roleOptions = updateUserRoleInputSchema.shape.role.options;
+
+export const UpdateUserRole = ({ id, role }: UpdateUserRoleProps) => {
+  const user = useUser();
+  const updateUserRoleMutation = useUpdateUserRole();
+
+  const isSelf = user.data?.id === id;
+  // Show the requested role while the request is in flight so the select
+  // does not snap back before the refreshed list arrives.
+  const displayedRole: UpdateUserRoleInput['role'] =
+    updateUserRoleMutation.isPending && updateUserRoleMutation.variables
+      ? updateUserRoleMutation.variables.data.role
+      : role;
+
+  return (
+    <select
+      aria-label="Role"
+      className={cn(
+        'block w-full rounded-md border-gray-600 py-1 pl-2 pr-8 text-sm focus:border-blue-500 focus:outline-none focus:ring-blue-500',
+      )}
+      value={displayedRole}
+      disabled={isSelf || updateUserRoleMutation.isPending}
+      title={isSelf ? 'You cannot change your own role' : undefined}
+      onChange={(event) => {
+        const parsed = updateUserRoleInputSchema.safeParse({
+          role: event.target.value,
+        });
+        if (!parsed.success) return;
+        updateUserRoleMutation.mutate({
+          userId: id,
+          data: parsed.data,
+        });
+      }}
+    >
+      {roleOptions.map((option) => (
+        <option key={option} value={option}>
+          {option}
+        </option>
+      ))}
+    </select>
+  );
+};
