diff --git a/apps/react-vite/src/features/comments/components/update-comment.tsx b/apps/react-vite/src/features/comments/components/update-comment.tsx
new file mode 100644
index 0000000..091f9ee
--- /dev/null
+++ b/apps/react-vite/src/features/comments/components/update-comment.tsx
@@ -0,0 +1,72 @@
+import { MoreVertical } from 'lucide-react';
+
+import { Button } from '@/components/ui/button';
+import { Form, FormDrawer, Textarea } from '@/components/ui/form';
+
+import {
+  updateCommentInputSchema,
+  useUpdateComment,
+} from '../api/update-comment';
+
+type UpdateCommentProps = {
+  id: string;
+  discussionId: string;
+  currentBody: string;
+};
+
+export const UpdateComment = ({
+  id,
+  discussionId,
+  currentBody,
+}: UpdateCommentProps) => {
+  const updateCommentMutation = useUpdateComment({
+    discussionId,
+  });
+
+  return (
+    <FormDrawer
+      isDone={updateCommentMutation.isSuccess}
+      triggerButton={
+        <Button variant="ghost" size="sm" icon={<MoreVertical className="size-4" />}>
+          Edit
+        </Button>
+      }
+      title="Update Comment"
+      submitButton={
+        <Button
+          isLoading={updateCommentMutation.isPending}
+          form="update-comment"
+          type="submit"
+          size="sm"
+          disabled={updateCommentMutation.isPending}
+        >
+          Submit
+        </Button>
+      }
+    >
+      <Form
+        id="update-comment"
+        onSubmit={(values) => {
+          updateCommentMutation.mutate({
+            commentId: id,
+            data: values,
+          });
+        }}
+        schema={updateCommentInputSchema}
+        options={{
+          defaultValues: {
+            body: currentBody,
+          },
+        }}
+      >
+        {({ register, formState }) => (
+          <Textarea
+            label="Body"
+            error={formState.errors['body']}
+            registration={register('body')}
+          />
+        )}
+      </Form>
+    </FormDrawer>
+  );
+};
