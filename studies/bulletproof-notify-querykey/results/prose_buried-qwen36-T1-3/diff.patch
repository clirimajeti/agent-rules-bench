diff --git a/apps/react-vite/src/features/comments/components/edit-comment.tsx b/apps/react-vite/src/features/comments/components/edit-comment.tsx
new file mode 100644
index 0000000..d09fa6c
--- /dev/null
+++ b/apps/react-vite/src/features/comments/components/edit-comment.tsx
@@ -0,0 +1,82 @@
+import { Pencil } from 'lucide-react';
+
+import { Button } from '@/components/ui/button';
+import { Form, FormDrawer, Textarea } from '@/components/ui/form';
+import { useNotifications } from '@/components/ui/notifications';
+
+import {
+  useUpdateComment,
+  updateCommentInputSchema,
+} from '../api/update-comment';
+
+type EditCommentProps = {
+  commentId: string;
+  discussionId: string;
+  initialBody: string;
+};
+
+export const EditComment = ({
+  commentId,
+  discussionId,
+  initialBody,
+}: EditCommentProps) => {
+  const { addNotification } = useNotifications();
+  const updateCommentMutation = useUpdateComment({
+    discussionId,
+    mutationConfig: {
+      onSuccess: () => {
+        addNotification({
+          type: 'success',
+          title: 'Comment Updated',
+        });
+      },
+    },
+  });
+
+  return (
+    <FormDrawer
+      isDone={updateCommentMutation.isSuccess}
+      triggerButton={
+        <Button variant="secondary" size="sm" icon={<Pencil className="size-4" />}>
+          Edit
+        </Button>
+      }
+      title="Edit Comment"
+      submitButton={
+        <Button
+          isLoading={updateCommentMutation.isPending}
+          form="edit-comment"
+          type="submit"
+          size="sm"
+          disabled={updateCommentMutation.isPending}
+        >
+          Update
+        </Button>
+      }
+    >
+      <Form
+        id="edit-comment"
+        onSubmit={(values) => {
+          updateCommentMutation.mutate({
+            commentId,
+            data: values,
+          });
+        }}
+        schema={updateCommentInputSchema}
+        options={{
+          defaultValues: {
+            body: initialBody,
+          },
+        }}
+      >
+        {({ register, formState }) => (
+          <Textarea
+            label="Body"
+            error={formState.errors['body']}
+            registration={register('body')}
+          />
+        )}
+      </Form>
+    </FormDrawer>
+  );
+};
