@@ -0,0 +1,36 @@
+import { cn } from '@/utils/cn';
+
+import { useUpdateUserRole } from '../api/update-user-role';
+
+type RoleSelectProps = {
+  userId: string;
+  currentRole: 'ADMIN' | 'USER';
+};
+
+const roles: Array<{ label: string; value: 'ADMIN' | 'USER' }> = [
+  { label: 'Admin', value: 'ADMIN' },
+  { label: 'User', value: 'USER' },
+];
+
+export const RoleSelect = ({ userId, currentRole }: RoleSelectProps) => {
+  const { mutate, isPending } = useUpdateUserRole();
+
+  return (
+    <select
+      disabled={isPending}
+      value={currentRole}
+      onChange={(e) =>
+        mutate({ userId, role: e.target.value as 'ADMIN' | 'USER' })
+      }
+      className={cn(
+        'inline-block w-full rounded-md border-gray-300 bg-white py-1 pl-2 pr-6 text-sm focus:border-blue-500 focus:outline-none focus:ring-blue-500 disabled:cursor-not-allowed disabled:opacity-60',
+      )}
+    >
+      {roles.map(({ label, value }) => (
+        <option key={value} value={value}>
+          {label}
+        </option>
+      ))}
+    </select>
+  );
+};
