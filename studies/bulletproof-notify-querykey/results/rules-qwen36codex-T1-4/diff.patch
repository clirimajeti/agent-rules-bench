@@ -0,0 +1,72 @@
+import { Edit } from 'lucide-react';
+
+import { Button } from '@/components/ui/button';
+import { Form, FormDrawer, Textarea } from '@/components/ui/form';
+
+import {
+  updateCommentInputSchema,
+  useUpdateComment,
+} from '../api/update-comment';
+
+type UpdateCommentProps = {
+  commentId: string;
+  initialBody: string;
+};
+
+export const UpdateComment = ({
+  commentId,
+  initialBody,
+}: UpdateCommentProps) => {
+  const updateCommentMutation = useUpdateComment({
+    mutationConfig: {
+      onSuccess: () => {},
+    },
+  });
+
+  return (
+    <FormDrawer
+      isDone={updateCommentMutation.isSuccess}
+      triggerButton={
+        <Button variant="ghost" size="sm" icon={<Edit className="size-4" />}>
+          Edit Comment
+        </Button>
+      }
+      title="Edit Comment"
+      submitButton={
+        <Button
+          isLoading={updateCommentMutation.isPending}
+          form="update-comment"
+          type="submit"
+          size="sm"
+          disabled={updateCommentMutation.isPending}
+        >
+          Save
+        </Button>
+      }
+    >
+      <Form
+        id="update-comment"
+        onSubmit={(values) => {
+          updateCommentMutation.mutate({
+            data: values,
+            commentId,
+          });
+        }}
+        schema={updateCommentInputSchema}
+        options={{
+          defaultValues: {
+            body: initialBody,
+          },
+        }}
+      >
+        {({ register, formState }) => (
+          <Textarea
+            label="Body"
+            error={formState.errors['body']}
+            registration={register('body')}
+          />
+        )}
+      </Form>
+    </FormDrawer>
+  );
+};
