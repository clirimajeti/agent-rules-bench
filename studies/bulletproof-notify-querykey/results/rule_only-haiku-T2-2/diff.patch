@@ -0,0 +1,41 @@
+import { Select } from '@/components/ui/form';
+import { useUser } from '@/lib/auth';
+import { User } from '@/types/api';
+
+import {
+  updateUserRoleInputSchema,
+  useUpdateUserRole,
+} from '../api/update-user-role';
+
+const roleOptions = [
+  { label: 'Admin', value: 'ADMIN' },
+  { label: 'User', value: 'USER' },
+];
+
+type UpdateUserRoleProps = {
+  id: string;
+  role: User['role'];
+};
+
+export const UpdateUserRole = ({ id, role }: UpdateUserRoleProps) => {
+  const user = useUser();
+  const updateUserRoleMutation = useUpdateUserRole();
+
+  // Admins cannot change their own role, to avoid locking themselves out.
+  const isCurrentUser = user.data?.id === id;
+
+  return (
+    <Select
+      options={roleOptions}
+      value={role}
+      disabled={isCurrentUser || updateUserRoleMutation.isPending}
+      onChange={(event) => {
+        const parsed = updateUserRoleInputSchema.safeParse({
+          role: event.target.value,
+        });
+        if (!parsed.success) return;
+        updateUserRoleMutation.mutate({ userId: id, data: parsed.data });
+      }}
+    />
+  );
+};
