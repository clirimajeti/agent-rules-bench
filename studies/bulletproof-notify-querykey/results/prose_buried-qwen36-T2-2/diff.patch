diff --git a/apps/react-vite/src/features/users/components/update-user-role.tsx b/apps/react-vite/src/features/users/components/update-user-role.tsx
new file mode 100644
index 0000000..6b3e84d
--- /dev/null
+++ b/apps/react-vite/src/features/users/components/update-user-role.tsx
@@ -0,0 +1,31 @@
+import { cn } from '@/utils/cn';
+
+import { useUpdateUserRole } from '../api/update-user-role';
+
+type UpdateUserRoleProps = {
+  userId: string;
+  initialRole: 'ADMIN' | 'USER';
+};
+
+export const UpdateUserRole = ({ userId, initialRole }: UpdateUserRoleProps) => {
+  const updateUserRoleMutation = useUpdateUserRole();
+
+  const handleRoleChange = (newRole: 'ADMIN' | 'USER') => {
+    updateUserRoleMutation.mutate({ userId, role: newRole });
+  };
+
+  return (
+    <select
+      value={initialRole}
+      onChange={(e) => handleRoleChange(e.target.value as 'ADMIN' | 'USER')}
+      disabled={updateUserRoleMutation.isPending}
+      className={cn(
+        'rounded-md border border-gray-300 bg-white py-1 pl-2 pr-8 text-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500',
+        updateUserRoleMutation.isPending && 'opacity-50',
+      )}
+    >
+      <option value="ADMIN">ADMIN</option>
+      <option value="USER">USER</option>
+    </select>
+  );
+};
