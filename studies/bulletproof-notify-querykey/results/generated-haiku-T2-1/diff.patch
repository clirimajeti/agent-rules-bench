@@ -0,0 +1,41 @@
+import { Select } from '@/components/ui/form';
+import {
+  UpdateUserRoleInput,
+  useUpdateUserRole,
+} from '@/features/users/api/update-user-role';
+import { useUser } from '@/lib/auth';
+import { User } from '@/types/api';
+
+const roleOptions = [
+  { label: 'Admin', value: 'ADMIN' },
+  { label: 'User', value: 'USER' },
+];
+
+type UpdateUserRoleProps = {
+  user: User;
+};
+
+export const UpdateUserRole = ({ user }: UpdateUserRoleProps) => {
+  const currentUser = useUser();
+  const updateUserRoleMutation = useUpdateUserRole();
+
+  // Like delete, an admin cannot change their own role from the list.
+  if (currentUser.data?.id === user.id) return <span>{user.role}</span>;
+
+  return (
+    <Select
+      label="Role"
+      options={roleOptions}
+      value={user.role}
+      registration={{
+        name: 'role',
+        onChange: (event: { target: HTMLSelectElement }) => {
+          updateUserRoleMutation.mutate({
+            userId: user.id,
+            data: { role: event.target.value as UpdateUserRoleInput['role'] },
+          });
+        },
+      }}
+    />
+  );
+};
