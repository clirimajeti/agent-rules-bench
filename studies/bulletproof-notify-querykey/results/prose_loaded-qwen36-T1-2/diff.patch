diff --git a/apps/react-vite/src/features/comments/components/edit-comment.tsx b/apps/react-vite/src/features/comments/components/edit-comment.tsx
new file mode 100644
index 0000000..d3f9962
--- /dev/null
+++ b/apps/react-vite/src/features/comments/components/edit-comment.tsx
@@ -0,0 +1,65 @@
+import { Pencil } from 'lucide-react';
+
+import { Button } from '@/components/ui/button';
+import { Form, FormDrawer, Textarea } from '@/components/ui/form';
+
+import {
+  useUpdateComment,
+  updateCommentInputSchema,
+} from '../api/update-comment';
+
+type EditCommentProps = {
+  id: string;
+  discussionId: string;
+  initialBody: string;
+};
+
+export const EditComment = ({ id, discussionId, initialBody }: EditCommentProps) => {
+  const editCommentMutation = useUpdateComment({ discussionId });
+
+  return (
+    <FormDrawer
+      isDone={editCommentMutation.isSuccess}
+      triggerButton={
+        <Button variant="ghost" size="sm" icon={<Pencil className="size-4" />}>
+          Edit
+        </Button>
+      }
+      title="Edit Comment"
+      submitButton={
+        <Button
+          isLoading={editCommentMutation.isPending}
+          form="edit-comment"
+          type="submit"
+          size="sm"
+        >
+          Update Comment
+        </Button>
+      }
+    >
+      <Form
+        id="edit-comment"
+        onSubmit={(values) => {
+          editCommentMutation.mutate({
+            commentId: id,
+            data: values,
+          });
+        }}
+        schema={updateCommentInputSchema}
+        options={{
+          defaultValues: {
+            body: initialBody,
+          },
+        }}
+      >
+        {({ register, formState }) => (
+          <Textarea
+            label="Body"
+            error={formState.errors['body']}
+            registration={register('body')}
+          />
+        )}
+      </Form>
+    </FormDrawer>
+  );
+};
