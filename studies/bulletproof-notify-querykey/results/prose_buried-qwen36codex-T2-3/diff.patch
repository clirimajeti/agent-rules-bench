@@ -0,0 +1,33 @@
+import { Select } from '@/components/ui/form/select';
+
+import { useUpdateUserRole } from '../api/update-user-role';
+
+type UpdateUserRoleProps = {
+  userId: string;
+  currentRole: 'ADMIN' | 'USER';
+};
+
+export const UpdateUserRole = ({
+  userId,
+  currentRole,
+}: UpdateUserRoleProps) => {
+  const { mutate, isPending } = useUpdateUserRole();
+
+  const roles: Array<{ label: string; value: string }> = [
+    { label: 'ADMIN', value: 'ADMIN' },
+    { label: 'USER', value: 'USER' },
+  ];
+
+  return (
+    <Select
+      options={roles}
+      defaultValue={currentRole}
+      registration={{
+        onChange: (e: React.ChangeEvent<HTMLSelectElement>) => {
+          mutate({ userId, role: e.target.value as 'ADMIN' | 'USER' });
+        },
+      }}
+      className="max-w-[120px]"
+    />
+  );
+};
