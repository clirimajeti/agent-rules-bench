@@ -0,0 +1,45 @@
+import { useUser } from '@/lib/auth';
+import { User } from '@/types/api';
+
+import {
+  updateUserRoleInputSchema,
+  userRoles,
+  useUpdateUserRole,
+} from '../api/update-user-role';
+
+type UpdateUserRoleProps = {
+  user: User;
+};
+
+export const UpdateUserRole = ({ user }: UpdateUserRoleProps) => {
+  const currentUser = useUser();
+  const updateUserRoleMutation = useUpdateUserRole();
+
+  const isCurrentUser = currentUser.data?.id === user.id;
+
+  return (
+    <select
+      aria-label={`Role for ${user.firstName} ${user.lastName}`}
+      className="block w-full rounded-md border-gray-600 py-1 pl-2 pr-8 text-sm focus:border-blue-500 focus:outline-none focus:ring-blue-500"
+      value={user.role}
+      disabled={isCurrentUser || updateUserRoleMutation.isPending}
+      title={isCurrentUser ? 'You cannot change your own role' : undefined}
+      onChange={(event) => {
+        const parsed = updateUserRoleInputSchema.safeParse({
+          role: event.target.value,
+        });
+        if (!parsed.success) return;
+        updateUserRoleMutation.mutate({
+          userId: user.id,
+          data: parsed.data,
+        });
+      }}
+    >
+      {userRoles.map((role) => (
+        <option key={role} value={role}>
+          {role}
+        </option>
+      ))}
+    </select>
+  );
+};
