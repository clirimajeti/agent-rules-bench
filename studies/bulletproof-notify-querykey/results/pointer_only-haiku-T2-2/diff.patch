@@ -0,0 +1,35 @@
+import { useUser } from '@/lib/auth';
+import { User } from '@/types/api';
+
+import { useUpdateUserRole } from '../api/update-user-role';
+
+type UpdateUserRoleProps = {
+  user: User;
+};
+
+export const UpdateUserRole = ({ user }: UpdateUserRoleProps) => {
+  const currentUser = useUser();
+  const updateUserRoleMutation = useUpdateUserRole();
+
+  // Admins cannot change their own role, so they cannot lock themselves out.
+  const isCurrentUser = currentUser.data?.id === user.id;
+
+  return (
+    <select
+      aria-label={`Role of ${user.firstName} ${user.lastName}`}
+      className="block rounded-md border-gray-600 py-1 pl-3 pr-8 text-sm focus:border-blue-500 focus:outline-none focus:ring-blue-500 disabled:opacity-50"
+      value={user.role}
+      disabled={isCurrentUser || updateUserRoleMutation.isPending}
+      title={isCurrentUser ? 'You cannot change your own role' : undefined}
+      onChange={(event) => {
+        updateUserRoleMutation.mutate({
+          userId: user.id,
+          role: event.target.value as User['role'],
+        });
+      }}
+    >
+      <option value="ADMIN">Admin</option>
+      <option value="USER">User</option>
+    </select>
+  );
+};
