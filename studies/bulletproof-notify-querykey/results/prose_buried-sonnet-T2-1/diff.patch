@@ -0,0 +1,39 @@
+import { Authorization, ROLES } from '@/lib/authorization';
+import { User } from '@/types/api';
+
+import { useUpdateUserRole } from '../api/update-user-role';
+
+type UpdateUserRoleProps = {
+  id: string;
+  role: User['role'];
+};
+
+export const UpdateUserRole = ({ id, role }: UpdateUserRoleProps) => {
+  const updateUserRoleMutation = useUpdateUserRole();
+
+  return (
+    <Authorization
+      allowedRoles={[ROLES.ADMIN]}
+      forbiddenFallback={<span>{role}</span>}
+    >
+      <select
+        aria-label="Role"
+        className="rounded-md border-gray-300 py-1 pl-2 pr-8 text-sm"
+        value={role}
+        disabled={updateUserRoleMutation.isPending}
+        onChange={(e) =>
+          updateUserRoleMutation.mutate({
+            userId: id,
+            data: { role: e.target.value as User['role'] },
+          })
+        }
+      >
+        {Object.values(ROLES).map((r) => (
+          <option key={r} value={r}>
+            {r}
+          </option>
+        ))}
+      </select>
+    </Authorization>
+  );
+};
