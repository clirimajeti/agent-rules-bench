@@ -0,0 +1,37 @@
+import { useUser } from '@/lib/auth';
+
+import { useUpdateUserRole } from '../api/update-user-role';
+
+type UpdateUserRoleProps = {
+  userId: string;
+  currentRole: 'ADMIN' | 'USER';
+};
+
+export const UpdateUserRole = ({ userId, currentRole }: UpdateUserRoleProps) => {
+  const user = useUser();
+  const updateUserRoleMutation = useUpdateUserRole();
+
+  const canManage = user.data?.role === 'ADMIN';
+
+  const roles: Array<'ADMIN' | 'USER'> = ['ADMIN', 'USER'];
+
+  return (
+    <select
+      disabled={!canManage}
+      value={currentRole}
+      onChange={(e) =>
+        updateUserRoleMutation.mutate({
+          userId,
+          role: e.target.value as 'ADMIN' | 'USER',
+        })
+      }
+      className="block w-full rounded-md border-gray-300 py-1 pl-2 pr-6 text-sm focus:border-blue-500 focus:ring-blue-500 disabled:cursor-not-allowed disabled:opacity-60"
+    >
+      {roles.map((role) => (
+        <option key={role} value={role}>
+          {role}
+        </option>
+      ))}
+    </select>
+  );
+};
