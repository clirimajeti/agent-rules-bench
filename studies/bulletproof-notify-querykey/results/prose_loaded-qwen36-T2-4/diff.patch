new file mode 100644
index 0000000..9217567
--- /dev/null
+++ b/apps/react-vite/src/features/users/components/update-user-role.tsx
@@ -0,0 +1,78 @@
+import { Check, ChevronDown } from 'lucide-react';
+import { useState } from 'react';
+
+import { UpdateUserRoleInput } from '../api/update-user-role';
+import { useUpdateUserRole } from '../api/update-user-role';
+
+type UpdateUserRoleProps = {
+  userId: string;
+  currentRole: 'ADMIN' | 'USER';
+};
+
+const ROLES: { value: 'ADMIN' | 'USER'; label: string }[] = [
+  { value: 'ADMIN', label: 'Admin' },
+  { value: 'USER', label: 'User' },
+];
+
+export const UpdateUserRole = ({ userId, currentRole }: UpdateUserRoleProps) => {
+  const [isOpen, setIsOpen] = useState(false);
+  const [isSaving, setIsSaving] = useState(false);
+  const [selectedRole, setSelectedRole] = useState<'ADMIN' | 'USER'>(currentRole);
+  const updateUserRoleMutation = useUpdateUserRole();
+
+  const handleSelectRole = (role: 'ADMIN' | 'USER') => {
+    if (role === selectedRole) {
+      setIsOpen(false);
+      return;
+    }
+    setSelectedRole(role);
+    setIsSaving(true);
+    updateUserRoleMutation.mutate({
+      userId,
+      data: { role },
+    });
+  };
+
+  return (
+    <div className="relative">
+      <button
+        type="button"
+        onClick={() => setIsOpen(!isOpen)}
+        disabled={isSaving || updateUserRoleMutation.isPending}
+        className="flex items-center gap-1 rounded-md border border-gray-300 bg-white px-2 py-1 text-sm text-gray-700 hover:bg-gray-50"
+      >
+        <span>{selectedRole}</span>
+        {isOpen ? (
+          <ChevronDown className="size-4 text-gray-500" />
+        ) : (
+          <Check className="size-4 text-gray-500" />
+        )}
+      </button>
+
+      {isOpen && (
+        <>
+          <div
+            className="fixed inset-0 z-10"
+            onClick={() => setIsOpen(false)}
+          />
+          <div className="absolute left-0 z-20 mt-1 w-32 origin-top-left rounded-md border border-gray-200 bg-white py-1 shadow-lg">
+            {ROLES.map((role) => (
+              <button
+                key={role.value}
+                type="button"
+                onClick={() => handleSelectRole(role.value)}
+                className={`w-full px-3 py-1.5 text-left text-sm ${
+                  selectedRole === role.value
+                    ? 'bg-gray-100 font-medium text-gray-900'
+                    : 'text-gray-700 hover:bg-gray-50'
+                }`}
+              >
+                {role.label}
+              </button>
+            ))}
+          </div>
+        </>
+      )}
+    </div>
+  );
+};
