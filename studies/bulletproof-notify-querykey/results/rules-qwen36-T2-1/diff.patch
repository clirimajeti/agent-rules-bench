+import { useEffect, useState } from 'react';
+
+import { useUser } from '@/lib/auth';
+import { User } from '@/types/api';
+
+import { useUpdateUserRole } from '../api/update-user-role';
+
+type UpdateUserRoleProps = {
+  user: User;
+};
+
+const ROLES = [
+  { label: 'Admin', value: 'ADMIN' as const },
+  { label: 'User', value: 'USER' as const },
+];
+
+export const UpdateUserRole = ({ user }: UpdateUserRoleProps) => {
+  const userQuery = useUser();
+  const updateUserRoleMutation = useUpdateUserRole({
+    mutationConfig: {
+      onSuccess: () => {
+        /* Notification handled in hook */
+      },
+    },
+  });
+
+  const [role, setRole] = useState(user.role);
+
+  useEffect(() => {
+    setRole(user.role);
+  }, [user.role]);
+
+  if (userQuery.data?.role !== 'ADMIN') {
+    return <span className="capitalize">{role.toLowerCase()}</span>;
+  }
+
+  const handleRoleChange = (e: React.ChangeEvent<HTMLSelectElement>) => {
+    const newRole = e.target.value as 'ADMIN' | 'USER';
+    setRole(newRole);
+    updateUserRoleMutation.mutate(
+      {
+        userId: user.id,
+        data: { role: newRole },
+      }
+    );
+  };
+
+  return (
+    <select
+      value={role}
+      onChange={handleRoleChange}
+      className="rounded-md border border-gray-300 px-2 py-1 text-sm focus:border-blue-500 focus:ring-blue-500"
+      disabled={updateUserRoleMutation.isPending}
+    >
+      {ROLES.map((option) => (
+        <option key={option.value} value={option.value}>
+          {option.label}
+        </option>
+      ))}
+    </select>
+  );
+};
