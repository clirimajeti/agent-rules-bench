@@ -0,0 +1,69 @@
+import { Check, ChevronDown } from 'lucide-react';
+import { useEffect, useState } from 'react';
+
+import { User } from '@/types/api';
+
+type UserRoleSelectProps = {
+  user: User;
+  onRoleChange: (userId: string, role: 'ADMIN' | 'USER') => void;
+};
+
+const ROLES = [
+  { value: 'ADMIN', label: 'Admin' },
+  { value: 'USER', label: 'User' },
+] as const;
+
+export const UserRoleSelect = ({ user, onRoleChange }: UserRoleSelectProps) => {
+  const [isOpen, setIsOpen] = useState(false);
+  const [currentRole, setCurrentRole] = useState(user.role);
+
+  useEffect(() => {
+    setCurrentRole(user.role);
+  }, [user.role]);
+
+  const handleRoleChange = (newRole: 'ADMIN' | 'USER') => {
+    setCurrentRole(newRole);
+    setIsOpen(false);
+    onRoleChange(user.id, newRole);
+  };
+
+  return (
+    <div className="relative">
+      <button
+        type="button"
+        onClick={() => setIsOpen(!isOpen)}
+        className="flex min-h-[28px] w-32 items-center justify-between rounded-md bg-gray-50 px-2 text-sm text-gray-700 ring-1 ring-gray-300 transition-colors hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
+      >
+        <span>{ROLES.find((r) => r.value === currentRole)?.label}</span>
+        <ChevronDown className="ml-1 h-4 w-4 text-gray-400" />
+      </button>
+
+      {isOpen && (
+        <>
+          <div
+            className="fixed inset-0 z-10"
+            onClick={() => setIsOpen(false)}
+          />
+          <div className="absolute right-0 z-20 mt-1 w-32 rounded-md bg-white py-1 shadow-lg ring-1 ring-gray-300 focus:outline-none">
+            {ROLES.map((role) => (
+              <div
+                key={role.value}
+                className={`flex cursor-pointer items-center px-3 py-2 text-sm ${
+                  currentRole === role.value
+                    ? 'bg-blue-50 text-blue-700 font-medium'
+                    : 'text-gray-700 hover:bg-gray-50'
+                }`}
+                onClick={() => handleRoleChange(role.value)}
+              >
+                {currentRole === role.value && (
+                  <Check className="mr-2 h-4 w-4" />
+                )}
+                <span>{role.label}</span>
+              </div>
+            ))}
+          </div>
+        </>
+      )}
+    </div>
+  );
+};
