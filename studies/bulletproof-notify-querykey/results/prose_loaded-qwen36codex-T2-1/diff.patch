+import { Check, ChevronDown } from 'lucide-react';
+import * as React from 'react';
+
+import { cn } from '@/utils/cn';
+
+import {
+  DropdownMenu,
+  DropdownMenuContent,
+  DropdownMenuItem,
+  DropdownMenuTrigger,
+} from '@/components/ui/dropdown';
+
+import { UserRoleInput, useUpdateUserRole } from '../api/update-user-role';
+
+type UpdateUserRoleSelectProps = {
+  userId: string;
+  currentRole: UserRoleInput;
+};
+
+const roles: { label: string; value: UserRoleInput }[] = [
+  { label: 'Admin', value: 'ADMIN' },
+  { label: 'User', value: 'USER' },
+];
+
+export const UpdateUserRoleSelect = ({
+  userId,
+  currentRole,
+}: UpdateUserRoleSelectProps) => {
+  const [open, setOpen] = React.useState(false);
+  const [selectedRole, setSelectedRole] =
+    React.useState<UserRoleInput>(currentRole);
+
+  const updateUserRoleMutation = useUpdateUserRole();
+
+  const handleRoleChange = async (newRole: UserRoleInput) => {
+    await updateUserRoleMutation.mutateAsync({ userId, role: newRole });
+    setSelectedRole(newRole);
+    setOpen(false);
+  };
+
+  const displayRole = roles.find((r) => r.value === selectedRole)?.label ?? currentRole;
+
+  return (
+    <DropdownMenu open={open} onOpenChange={setOpen}>
+      <DropdownMenuTrigger asChild>
+        <button className="flex items-center gap-1 rounded border px-2 py-1 text-xs hover:bg-gray-50">
+          {displayRole}
+          <ChevronDown className="size-3" />
+        </button>
+      </DropdownMenuTrigger>
+      <DropdownMenuContent align="start">
+        {roles.map((role) => (
+          <DropdownMenuItem
+            key={role.value}
+            className={cn(
+              'cursor-pointer items-center gap-2',
+              selectedRole === role.value && 'bg-gray-100',
+            )}
+            onClick={() => handleRoleChange(role.value)}
+            disabled={updateUserRoleMutation.isPending}
+          >
+            {selectedRole === role.value && <Check className="size-3" />}
+            {role.label}
+          </DropdownMenuItem>
+        ))}
+      </DropdownMenuContent>
+    </DropdownMenu>
+  );
+};
