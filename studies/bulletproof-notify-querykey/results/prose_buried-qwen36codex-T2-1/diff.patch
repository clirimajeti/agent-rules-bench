@@ -0,0 +1,87 @@
+import { ChevronDown, ChevronUp } from 'lucide-react';
+import * as React from 'react';
+
+import { User } from '@/types/api';
+
+import { useUpdateUserRole } from '../api/update-user-role';
+
+export const UserRoleSelect = ({
+  user,
+  onSuccess,
+}: {
+  user: User;
+  onSuccess?: () => void;
+}) => {
+  const updateUserRoleMutation = useUpdateUserRole({
+    mutationConfig: {
+      onSuccess: (...args) => {
+        onSuccess?.();
+      },
+    },
+  });
+
+  const [isOpen, setIsOpen] = React.useState(false);
+  const containerRef = React.useRef<HTMLDivElement>(null);
+
+  const handleRoleChange = (newRole: 'ADMIN' | 'USER') => {
+    updateUserRoleMutation.mutate({
+      userId: user.id,
+      data: { role: newRole },
+    });
+    setIsOpen(false);
+  };
+
+  React.useEffect(() => {
+    const handleClickOutside = (event: MouseEvent) => {
+      if (containerRef.current && !containerRef.current.contains(event.target as Node)) {
+        setIsOpen(false);
+      }
+    };
+    document.addEventListener('mousedown', handleClickOutside);
+    return () => {
+      document.removeEventListener('mousedown', handleClickOutside);
+    };
+  }, []);
+
+  const options: Array<{ label: string; value: 'ADMIN' | 'USER' }> = [
+    { label: 'Admin', value: 'ADMIN' },
+    { label: 'User', value: 'USER' },
+  ];
+
+  return (
+    <div ref={containerRef} className="relative inline-block">
+      <button
+        type="button"
+        className="flex w-24 items-center justify-between rounded border border-gray-300 bg-white px-2 py-1 text-sm text-gray-700 hover:border-gray-400 focus:border-blue-500 focus:outline-none"
+        onClick={() => setIsOpen(!isOpen)}
+        disabled={updateUserRoleMutation.isPending}
+      >
+        <span>{user.role}</span>
+        {isOpen ? (
+          <ChevronUp className="ml-1 size-3 text-gray-400" />
+        ) : (
+          <ChevronDown className="ml-1 size-3 text-gray-400" />
+        )}
+      </button>
+      {isOpen && (
+        <div className="absolute right-0 z-10 mt-1 w-24 rounded border border-gray-300 bg-white shadow-sm">
+          {options.map((option) => (
+            <button
+              key={option.value}
+              type="button"
+              className={`w-full px-3 py-1.5 text-left text-sm hover:bg-gray-100 ${
+                user.role === option.value
+                  ? 'bg-gray-100 font-medium text-gray-900'
+                  : 'text-gray-700'
+              } ${updateUserRoleMutation.isPending ? 'cursor-not-allowed opacity-60' : ''}`}
+              onClick={() => handleRoleChange(option.value)}
+              disabled={updateUserRoleMutation.isPending}
+            >
+              {option.label}
+            </button>
+          ))}
+        </div>
+      )}
+    </div>
+  );
+};
