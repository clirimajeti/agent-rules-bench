new file mode 100644
index 0000000..4f23634
--- /dev/null
+++ b/apps/react-vite/src/features/users/components/update-user-role.tsx
@@ -0,0 +1,29 @@
+import {
+  useUpdateUserRole,
+} from '../api/update-user-role';
+
+type UserRoleSelectProps = {
+  id: string;
+  currentRole: 'ADMIN' | 'USER';
+};
+
+export const UserRoleSelect = ({ id, currentRole }: UserRoleSelectProps) => {
+  const updateUserRoleMutation = useUpdateUserRole();
+
+  const handleRoleChange = (e: React.ChangeEvent<HTMLSelectElement>) => {
+    const newRole = e.target.value as 'ADMIN' | 'USER';
+    updateUserRoleMutation.mutate({ userId: id, role: newRole });
+  };
+
+  return (
+    <select
+      value={currentRole}
+      onChange={handleRoleChange}
+      className="rounded border border-gray-300 px-2 py-1 text-sm focus:border-blue-500 focus:outline-none"
+      disabled={updateUserRoleMutation.isPending}
+    >
+      <option value="ADMIN">ADMIN</option>
+      <option value="USER">USER</option>
+    </select>
+  );
+};
