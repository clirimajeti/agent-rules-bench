{"type":"tool_execution_end","toolCallId":"call_rg07we69","toolName":"read","result":{"content":[{"type":"text","text":"import { useNotifications } from '@/components/ui/notifications';\n\nimport {\n  useUpdateUserRole,\n  UpdateUserRoleDTO,\n} from '../api/update-user-role';\n\ntype UserRoleSelectProps = {\n  userId: string;\n  currentRole: 'ADMIN' | 'USER';\n};\n\nconst ROLES: { label: string; value: 'ADMIN' | 'USER' }[] = [\n  { label: 'Admin', value: 'ADMIN' },\n  { label: 'User', value: 'USER' },\n];\n\nexport const UpdateUserRole = ({ userId, currentRole }: UserRoleSelectProps) => {\n  const { addNotification } = useNotifications();\n  const updateUserRoleMutation = useUpdateUserRole({\n    mutationConfig: {\n      onSuccess: () => {\n        addNotification({\n          type: 'success',\n          title: 'User Role Updated',\n        });\n      },\n    },\n  });\n\n  return (\n    <select\n      disabled={updateUserRoleMutation.isPending}\n      value={currentRole}\n      onChange={(e) => {\n        const newRole = e.target.value as 'ADMIN' | 'USER';\n        const payload: UpdateUserRoleDTO = {\n          userId,\n          data: { role: newRole },\n        };\n        updateUserRoleMutation.mutate(payload);\n      }}\n      className=\"rounded border border-gray-300 px-2 py-1 text-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500\"\n    >\n      {ROLES.map((option) => (\n        <option key={option.value} value={option.value}>\n          {option.label}\n        </option>\n      ))}\n    </select>\n  );\n};\n"}],"structuredContent":"import { useNotifications } from '@/components/ui/notifications';\n\nimport {\n  useUpdateUserRole,\n  UpdateUserRoleDTO,\n} from '../api/update-user-role';\n\ntype UserRoleSelectProps = {\n  userId: string;\n  currentRole: 'ADMIN' | 'USER';\n};\n\nconst ROLES: { label: string; value: 'ADMIN' | 'USER' }[] = [\n  { label: 'Admin', value: 'ADMIN' },\n  { label: 'User', value: 'USER' },\n];\n\nexport const