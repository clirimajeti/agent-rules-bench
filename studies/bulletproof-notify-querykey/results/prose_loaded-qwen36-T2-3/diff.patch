@@ -0,0 +1,40 @@
+import {
+  useUpdateUserRole,
+  UpdateUserRoleDTO,
+} from '../api/update-user-role';
+
+type UserRoleSelectProps = {
+  userId: string;
+  currentRole: 'ADMIN' | 'USER';
+};
+
+const ROLES: { label: string; value: 'ADMIN' | 'USER' }[] = [
+  { label: 'Admin', value: 'ADMIN' },
+  { label: 'User', value: 'USER' },
+];
+
+export const UpdateUserRole = ({ userId, currentRole }: UserRoleSelectProps) => {
+  const updateUserRoleMutation = useUpdateUserRole();
+
+  return (
+    <select
+      disabled={updateUserRoleMutation.isPending}
+      value={currentRole}
+      onChange={(e) => {
+        const newRole = e.target.value as 'ADMIN' | 'USER';
+        const payload: UpdateUserRoleDTO = {
+          userId,
+          data: { role: newRole },
+        };
+        updateUserRoleMutation.mutate(payload);
+      }}
+      className="rounded border border-gray-300 px-2 py-1 text-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500"
+    >
+      {ROLES.map((option) => (
+        <option key={option.value} value={option.value}>
+          {option.label}
+        </option>
+      ))}
+    </select>
+  );
+};
