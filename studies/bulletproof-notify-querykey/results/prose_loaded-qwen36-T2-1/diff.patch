diff --git a/apps/react-vite/src/features/users/components/update-role.tsx b/apps/react-vite/src/features/users/components/update-role.tsx
new file mode 100644
index 0000000..8973698
--- /dev/null
+++ b/apps/react-vite/src/features/users/components/update-role.tsx
@@ -0,0 +1,37 @@
+import { useEffect, useState } from 'react';
+
+import { User } from '@/types/api';
+
+import { UpdateUserRoleInput, useUpdateUserRole } from '../api/update-user-role';
+
+type UpdateRoleProps = {
+  user: User;
+};
+
+export const UpdateRole = ({ user }: UpdateRoleProps) => {
+  const [role, setRole] = useState(user.role);
+
+  const updateUserRoleMutation = useUpdateUserRole();
+
+  useEffect(() => {
+    setRole(user.role);
+  }, [user.role]);
+
+  const handleChange = (e: React.ChangeEvent<HTMLSelectElement>) => {
+    const newRole = e.target.value as UpdateUserRoleInput['role'];
+    setRole(newRole);
+    updateUserRoleMutation.mutate({ userId: user.id, role: newRole });
+  };
+
+  return (
+    <select
+      value={role}
+      onChange={handleChange}
+      disabled={updateUserRoleMutation.isPending}
+      className="rounded border border-gray-300 bg-white px-2 py-1 text-sm dark:border-gray-600 dark:bg-gray-800 dark:text-gray-200"
+    >
+      <option value="ADMIN">Admin</option>
+      <option value="USER">User</option>
+    </select>
+  );
+};
