@@ -0,0 +1,29 @@
+import { User } from '@/types/api';
+
+import { useUpdateUserRole } from '../api/update-user-role';
+
+interface UpdateUserRoleProps {
+  userId: string;
+  currentRole: 'ADMIN' | 'USER';
+}
+
+export const UpdateUserRole = ({ userId, currentRole }: UpdateUserRoleProps) => {
+  const updateRoleMutation = useUpdateUserRole();
+
+  const handleRoleChange = (e: React.ChangeEvent<HTMLSelectElement>) => {
+    const newRole = e.target.value as 'ADMIN' | 'USER';
+    updateRoleMutation.mutate({ userId, role: newRole });
+  };
+
+  return (
+    <select
+      value={currentRole}
+      onChange={handleRoleChange}
+      disabled={updateRoleMutation.isPending}
+      className="cursor-pointer rounded border-gray-300 bg-white p-1 text-sm text-gray-700 focus:border-indigo-500 focus:ring-indigo-500"
+    >
+      <option value="ADMIN">Admin</option>
+      <option value="USER">User</option>
+    </select>
+  );
+};
