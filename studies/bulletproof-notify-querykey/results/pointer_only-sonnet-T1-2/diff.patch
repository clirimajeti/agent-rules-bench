@@ -0,0 +1,67 @@
+import { Pen } from 'lucide-react';
+
+import { Button } from '@/components/ui/button';
+import { Form, FormDrawer, Textarea } from '@/components/ui/form';
+import { Comment } from '@/types/api';
+
+import {
+  updateCommentInputSchema,
+  useUpdateComment,
+} from '../api/update-comment';
+
+type UpdateCommentProps = {
+  comment: Comment;
+  discussionId: string;
+};
+
+export const UpdateComment = ({ comment, discussionId }: UpdateCommentProps) => {
+  const updateCommentMutation = useUpdateComment({ discussionId });
+  const formId = `update-comment-${comment.id}`;
+
+  return (
+    <FormDrawer
+      isDone={updateCommentMutation.isSuccess}
+      triggerButton={
+        <Button size="sm" variant="outline" icon={<Pen className="size-4" />}>
+          Edit
+        </Button>
+      }
+      title="Edit Comment"
+      submitButton={
+        <Button
+          isLoading={updateCommentMutation.isPending}
+          form={formId}
+          type="submit"
+          size="sm"
+          disabled={updateCommentMutation.isPending}
+        >
+          Submit
+        </Button>
+      }
+    >
+      <Form
+        id={formId}
+        onSubmit={(values) => {
+          updateCommentMutation.mutate({
+            data: values,
+            commentId: comment.id,
+          });
+        }}
+        schema={updateCommentInputSchema}
+        options={{
+          defaultValues: {
+            body: comment.body,
+          },
+        }}
+      >
+        {({ register, formState }) => (
+          <Textarea
+            label="Body"
+            error={formState.errors['body']}
+            registration={register('body')}
+          />
+        )}
+      </Form>
+    </FormDrawer>
+  );
+};
