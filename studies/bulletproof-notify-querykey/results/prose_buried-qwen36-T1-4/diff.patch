diff --git a/apps/react-vite/src/features/comments/components/edit-comment.tsx b/apps/react-vite/src/features/comments/components/edit-comment.tsx
new file mode 100644
index 0000000..31d7671
--- /dev/null
+++ b/apps/react-vite/src/features/comments/components/edit-comment.tsx
@@ -0,0 +1,70 @@
+import { Pencil } from 'lucide-react';
+
+import { Button } from '@/components/ui/button';
+import { FormDrawer, Form, Textarea } from '@/components/ui/form';
+
+import {
+  useUpdateComment,
+  updateCommentInputSchema,
+} from '../api/update-comment';
+
+type EditCommentProps = {
+  id: string;
+  discussionId: string;
+  currentBody: string;
+};
+
+export const EditComment = ({ id, discussionId, currentBody }: EditCommentProps) => {
+  const updateCommentMutation = useUpdateComment({ discussionId });
+
+  return (
+    <FormDrawer
+      isDone={updateCommentMutation.isSuccess}
+      triggerButton={
+        <Button
+          variant="ghost"
+          size="sm"
+          icon={<Pencil className="size-4" />}
+        >
+          Edit Comment
+        </Button>
+      }
+      title="Edit Comment"
+      submitButton={
+        <Button
+          isLoading={updateCommentMutation.isPending}
+          form="edit-comment"
+          type="submit"
+          size="sm"
+          disabled={updateCommentMutation.isPending}
+        >
+          Submit
+        </Button>
+      }
+    >
+      <Form
+        id="edit-comment"
+        onSubmit={(values) => {
+          updateCommentMutation.mutate({
+            commentId: id,
+            data: values,
+          });
+        }}
+        schema={updateCommentInputSchema}
+        options={{
+          defaultValues: {
+            body: currentBody,
+          },
+        }}
+      >
+        {({ register, formState }) => (
+          <Textarea
+            label="Body"
+            error={formState.errors['body']}
+            registration={register('body')}
+          />
+        )}
+      </Form>
+    </FormDrawer>
+  );
+};
