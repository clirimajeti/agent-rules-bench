+import { ChangeEvent } from 'react';
+
+import { User } from '@/types/api';
+
+import {
+  UpdateUserRoleInput,
+  useUpdateUserRole,
+} from '../api/update-user-role';
+
+type UpdateUserRoleProps = {
+  id: string;
+  role: User['role'];
+};
+
+const roleOptions: { label: string; value: User['role'] }[] = [
+  { label: 'Admin', value: 'ADMIN' },
+  { label: 'User', value: 'USER' },
+];
+
+export const UpdateUserRole = ({ id, role }: UpdateUserRoleProps) => {
+  const updateUserRoleMutation = useUpdateUserRole();
+
+  const handleChange = (event: ChangeEvent<HTMLSelectElement>) => {
+    const data: UpdateUserRoleInput = {
+      role: event.target.value as User['role'],
+    };
+    updateUserRoleMutation.mutate({ userId: id, data });
+  };
+
+  return (
+    <select
+      aria-label="Role"
+      className="block rounded-md border-gray-600 py-1 pl-3 pr-10 text-sm focus:border-blue-500 focus:outline-none focus:ring-blue-500 disabled:opacity-50"
+      value={role}
+      disabled={updateUserRoleMutation.isPending}
+      onChange={handleChange}
+    >
+      {roleOptions.map((option) => (
+        <option key={option.value} value={option.value}>
+          {option.label}
+        </option>
+      ))}
+    </select>
+  );
+};
