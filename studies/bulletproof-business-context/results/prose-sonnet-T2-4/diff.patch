+++ b/apps/react-vite/src/app/routes/app/__tests__/users.test.tsx
@@ -0,0 +1,39 @@
+import { ROLES } from '@/lib/authorization';
+import {
+  createUser,
+  renderApp,
+  screen,
+  userEvent,
+  waitFor,
+} from '@/testing/test-utils';
+
+import { default as UsersRoute } from '../users';
+
+test('should change the role of a team member', async () => {
+  const admin = await createUser({ role: ROLES.ADMIN });
+  const member = await createUser({ role: ROLES.USER, teamId: admin.teamId });
+
+  await renderApp(<UsersRoute />, { user: admin });
+
+  expect(await screen.findByText(member.email)).toBeInTheDocument();
+
+  const select = (await screen.findAllByRole('combobox')).find(
+    (element) => (element as HTMLSelectElement).name === `role-${member.id}`,
+  ) as HTMLSelectElement;
+
+  expect(select.value).toBe(ROLES.USER);
+
+  await userEvent.selectOptions(select, ROLES.ADMIN);
+
+  expect(await screen.findByText(/user role updated/i)).toBeInTheDocument();
+
+  await waitFor(() => {
+    const updated = screen
+      .getAllByRole('combobox')
+      .find(
+        (element) =>
+          (element as HTMLSelectElement).name === `role-${member.id}`,
+      ) as HTMLSelectElement;
+    expect(updated.value).toBe(ROLES.ADMIN);
+  });
+});
diff --git a/apps/react-vite/src/features/users/api/update-user-role.ts b/apps/react-vite/src/features/users/api/update-user-role.ts
