diff --git a/apps/react-vite/e2e/tests/discussion-comments.spec.ts b/apps/react-vite/e2e/tests/discussion-comments.spec.ts
new file mode 100644
index 0000000..e2bd176
--- /dev/null
+++ b/apps/react-vite/e2e/tests/discussion-comments.spec.ts
@@ -0,0 +1,94 @@
+import { test, expect } from '@playwright/test';
+
+import {
+  createDiscussion,
+  createComment,
+} from '../../src/testing/data-generators';
+
+test('discussion comments', async ({ page }) => {
+  const discussion = createDiscussion();
+  const firstComment = createComment();
+  const secondComment = createComment();
+  const firstBody = `${firstComment.body} - first`;
+  const secondBody = `${secondComment.body} - second`;
+
+  await page.goto('/');
+  await page.getByRole('button', { name: 'Get started' }).click();
+  await page.waitForURL('/app');
+
+  // create discussion:
+  await page.getByRole('link', { name: 'Discussions' }).click();
+  await page.waitForURL('/app/discussions');
+
+  await page.getByRole('button', { name: 'Create Discussion' }).click();
+  await page.getByLabel('Title').click();
+  await page.getByLabel('Title').fill(discussion.title);
+  await page.getByLabel('Body').click();
+  await page.getByLabel('Body').fill(discussion.body);
+  await page.getByRole('button', { name: 'Submit' }).click();
+  await page
+    .getByLabel('Discussion Created')
+    .getByRole('button', { name: 'Close' })
+    .click();
+
+  // visit discussion page:
+  await page
+    .getByRole('row', { name: new RegExp(discussion.title) })
+    .getByRole('link', { name: 'View' })
+    .click();
+  await expect(
+    page.getByRole('heading', { name: discussion.title }),
+  ).toBeVisible();
+
+  // create first comment:
+  await page.getByRole('button', { name: 'Create Comment' }).click();
+  await page.getByLabel('Body').click();
+  await page.getByLabel('Body').fill(firstBody);
+  await page.getByRole('button', { name: 'Submit' }).click();
+  await expect(page.getByText(firstBody)).toBeVisible();
+  await page
+    .getByLabel('Comment Created')
+    .getByRole('button', { name: 'Close' })
+    .click();
+
+  // create second comment:
+  await page.getByRole('button', { name: 'Create Comment' }).click();
+  await page.getByLabel('Body').click();
+  await page.getByLabel('Body').fill(secondBody);
+  await page.getByRole('button', { name: 'Submit' }).click();
+  await expect(page.getByText(secondBody)).toBeVisible();
+  await page
+    .getByLabel('Comment Created')
+    .getByRole('button', { name: 'Close' })
+    .click();
+
+  await expect(page.getByText(firstBody)).toBeVisible();
+  await expect(page.getByRole('listitem', { name: /^comment-/ })).toHaveCount(
+    2,
+  );
+
+  // delete the first comment:
+  await page
+    .getByRole('listitem', { name: /^comment-/ })
+    .filter({ hasText: firstBody })
+    .getByRole('button', { name: 'Delete Comment' })
+    .click();
+  await expect(
+    page.getByText('Are you sure you want to delete this comment?'),
+  ).toBeVisible();
+  await page
+    .getByRole('dialog')
+    .getByRole('button', { name: 'Delete Comment' })
+    .click();
+  await page
+    .getByLabel('Comment Deleted')
+    .getByRole('button', { name: 'Close' })
+    .click();
+
+  // only the second comment is left:
+  await expect(page.getByText(firstBody)).toBeHidden();
+  await expect(page.getByText(secondBody)).toBeVisible();
+  await expect(page.getByRole('listitem', { name: /^comment-/ })).toHaveCount(
+    1,
+  );
+});
