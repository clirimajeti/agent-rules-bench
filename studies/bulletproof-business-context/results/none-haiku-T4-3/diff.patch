@@ -0,0 +1,50 @@
+import type { Mock } from 'vitest';
+
+import { createTeam } from '@/testing/data-generators';
+import {
+  renderApp,
+  screen,
+  userEvent,
+  waitFor,
+  within,
+} from '@/testing/test-utils';
+
+import { default as TeamsRoute } from '../teams';
+
+beforeAll(() => {
+  vi.spyOn(console, 'error').mockImplementation(() => {});
+});
+
+afterAll(() => {
+  (console.error as Mock).mockRestore();
+});
+
+test('should create a team and list it', { timeout: 10000 }, async () => {
+  await renderApp(<TeamsRoute />);
+
+  const newTeam = createTeam();
+
+  expect(await screen.findByText(/no entries/i)).toBeInTheDocument();
+
+  await userEvent.click(screen.getByRole('button', { name: /create team/i }));
+
+  const drawer = await screen.findByRole('dialog', {
+    name: /create team/i,
+  });
+
+  await userEvent.type(within(drawer).getByText(/name/i), newTeam.name);
+  await userEvent.type(
+    within(drawer).getByText(/description/i),
+    newTeam.description,
+  );
+
+  await userEvent.click(within(drawer).getByRole('button', { name: /submit/i }));
+
+  await waitFor(() => expect(drawer).not.toBeInTheDocument());
+
+  await screen.findByText(/team created/i);
+
+  expect(
+    await screen.findByRole('cell', { name: newTeam.name }, { timeout: 5000 }),
+  ).toBeInTheDocument();
+});
