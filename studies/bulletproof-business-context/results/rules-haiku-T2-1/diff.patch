@@ -0,0 +1,40 @@
+import { Select } from '@/components/ui/form';
+import { ROLES } from '@/lib/authorization';
+import { User } from '@/types/api';
+
+import {
+  UpdateUserRoleInput,
+  useUpdateUserRole,
+} from '../api/update-user-role';
+
+const roleOptions = [
+  { label: 'Admin', value: ROLES.ADMIN },
+  { label: 'User', value: ROLES.USER },
+];
+
+type UpdateUserRoleProps = {
+  user: User;
+};
+
+export const UpdateUserRole = ({ user }: UpdateUserRoleProps) => {
+  const updateUserRoleMutation = useUpdateUserRole();
+
+  return (
+    <Select
+      // Remount when the server role changes, so the select shows the stored role again after a failed change.
+      key={user.role}
+      options={roleOptions}
+      defaultValue={user.role}
+      registration={{
+        name: 'role',
+        disabled: updateUserRoleMutation.isPending,
+        onChange: async (event: { target: HTMLSelectElement }) => {
+          updateUserRoleMutation.mutate({
+            userId: user.id,
+            data: { role: event.target.value as UpdateUserRoleInput['role'] },
+          });
+        },
+      }}
+    />
+  );
+};
