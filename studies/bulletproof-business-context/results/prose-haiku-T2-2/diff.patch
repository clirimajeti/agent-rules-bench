+import * as React from 'react';
+
+import { Select } from '@/components/ui/form';
+import { useUser } from '@/lib/auth';
+import { POLICIES, ROLES } from '@/lib/authorization';
+import { User } from '@/types/api';
+
+import {
+  updateUserRoleInputSchema,
+  useUpdateUserRole,
+} from '../api/update-user-role';
+
+const roleOptions = [
+  { label: 'Admin', value: ROLES.ADMIN },
+  { label: 'User', value: ROLES.USER },
+];
+
+type UpdateUserRoleProps = {
+  user: User;
+};
+
+export const UpdateUserRole = ({ user }: UpdateUserRoleProps) => {
+  const currentUser = useUser();
+  // Bumping the key remounts the select, so after a failed change it shows
+  // the role the server still has instead of the value the user picked.
+  const [selectResetCount, setSelectResetCount] = React.useState(0);
+
+  const updateUserRoleMutation = useUpdateUserRole({
+    mutationConfig: {
+      onError: () => setSelectResetCount((count) => count + 1),
+    },
+  });
+
+  const canChangeRole = currentUser.data
+    ? POLICIES['user:update-role'](currentUser.data, user)
+    : false;
+
+  if (!canChangeRole) {
+    return <span>{user.role}</span>;
+  }
+
+  const handleRoleChange = async (event: { target: HTMLSelectElement }) => {
+    const parsed = updateUserRoleInputSchema.safeParse({
+      role: event.target.value,
+    });
+
+    if (parsed.success) {
+      updateUserRoleMutation.mutate({ userId: user.id, data: parsed.data });
+    }
+  };
+
+  return (
+    <Select
+      key={`${user.role}-${selectResetCount}`}
+      label="Role"
+      options={roleOptions}
+      defaultValue={user.role}
+      registration={{ name: `role-${user.id}`, onChange: handleRoleChange }}
+    />
+  );
+};
