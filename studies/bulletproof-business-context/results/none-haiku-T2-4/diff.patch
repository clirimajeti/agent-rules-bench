@@ -0,0 +1,42 @@
+import { Select } from '@/components/ui/form';
+import { useUser } from '@/lib/auth';
+import { ROLES } from '@/lib/authorization';
+import { User } from '@/types/api';
+
+import { useUpdateUserRole } from '../api/update-user-role';
+
+type UserRoleSelectProps = {
+  id: string;
+  role: User['role'];
+};
+
+const roleOptions = [
+  { label: 'Admin', value: ROLES.ADMIN },
+  { label: 'User', value: ROLES.USER },
+];
+
+export const UserRoleSelect = ({ id, role }: UserRoleSelectProps) => {
+  const user = useUser();
+  const updateUserRoleMutation = useUpdateUserRole();
+
+  // An admin keeps their own role here, so they cannot lock themselves out.
+  if (user.data?.id === id) return <span>{role}</span>;
+
+  return (
+    <Select
+      key={role}
+      label="Role"
+      options={roleOptions}
+      defaultValue={role}
+      registration={{
+        name: 'role',
+        disabled: updateUserRoleMutation.isPending,
+        onChange: (event) =>
+          updateUserRoleMutation.mutate({
+            userId: id,
+            data: { role: event.target.value as ROLES },
+          }),
+      }}
+    />
+  );
+};
