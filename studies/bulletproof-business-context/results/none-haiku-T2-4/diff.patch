@@ -0,0 +1,39 @@
+import type { Mock } from 'vitest';
+
+import {
+  createUser,
+  renderApp,
+  screen,
+  userEvent,
+  waitFor,
+} from '@/testing/test-utils';
+
+import { default as UsersRoute } from '../users';
+
+beforeAll(() => {
+  vi.spyOn(console, 'error').mockImplementation(() => {});
+});
+
+afterAll(() => {
+  (console.error as Mock).mockRestore();
+});
+
+test('should let an admin change a member role from the users list', async () => {
+  const admin = await createUser({ role: 'ADMIN', teamId: 'team-role-test' });
+  await createUser({ role: 'USER', teamId: 'team-role-test' });
+
+  await renderApp(<UsersRoute />, { user: admin });
+
+  const roleSelect = await screen.findByRole('combobox', { name: 'Role' });
+  expect(roleSelect).toHaveValue('USER');
+
+  await userEvent.selectOptions(roleSelect, 'ADMIN');
+
+  await screen.findByText(/role updated/i);
+
+  await waitFor(() =>
+    expect(screen.getByRole('combobox', { name: 'Role' })).toHaveValue(
+      'ADMIN',
+    ),
+  );
+});
diff --git a/apps/react-vite/src/features/users/api/update-user-role.ts b/apps/react-vite/src/features/users/api/update-user-role.ts
