+import { Button } from '@/components/ui/button';
+import { Form, Select } from '@/components/ui/form';
+import { useUser } from '@/lib/auth';
+import { Authorization, POLICIES, ROLES } from '@/lib/authorization';
+import { User } from '@/types/api';
+
+import {
+  UpdateUserRoleInput,
+  updateUserRoleInputSchema,
+  useUpdateUserRole,
+} from '../api/update-user-role';
+
+type UpdateUserRoleProps = {
+  user: User;
+};
+
+export const UpdateUserRole = ({ user }: UpdateUserRoleProps) => {
+  const currentUser = useUser();
+  const updateUserRoleMutation = useUpdateUserRole();
+
+  if (!currentUser.data) return null;
+
+  const canChangeRole = POLICIES['user:update-role'](currentUser.data, user);
+  const readOnlyRole = <span>{user.role}</span>;
+
+  return (
+    <Authorization
+      allowedRoles={[ROLES.ADMIN]}
+      forbiddenFallback={readOnlyRole}
+    >
+      <Authorization
+        policyCheck={canChangeRole}
+        forbiddenFallback={readOnlyRole}
+      >
+        <Form
+          key={user.role}
+          schema={updateUserRoleInputSchema}
+          options={{ defaultValues: { role: ROLES[user.role] } }}
+          onSubmit={(values: UpdateUserRoleInput) =>
+            updateUserRoleMutation.mutate({ userId: user.id, data: values })
+          }
+          className="flex items-end gap-2 space-y-0"
+        >
+          {({ register, formState }) => (
+            <>
+              <Select
+                label="Role"
+                error={formState.errors.role}
+                registration={register('role')}
+                options={[
+                  { label: 'Admin', value: ROLES.ADMIN },
+                  { label: 'User', value: ROLES.USER },
+                ]}
+              />
+              <Button
+                type="submit"
+                size="sm"
+                disabled={!formState.isDirty}
+                isLoading={updateUserRoleMutation.isPending}
+              >
+                Save
+              </Button>
+            </>
+          )}
+        </Form>
+      </Authorization>
+    </Authorization>
+  );
+};
