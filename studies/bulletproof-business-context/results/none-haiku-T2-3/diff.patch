+import {
+  createUser,
+  renderApp,
+  screen,
+  userEvent,
+  waitFor,
+} from '@/testing/test-utils';
+
+import { default as UsersRoute } from '../users';
+
+test('should let an admin change a member role and show the new role', async () => {
+  const admin = await createUser({ role: 'ADMIN', teamId: 'team-role-test' });
+  const member = await createUser({
+    role: 'USER',
+    teamId: 'team-role-test',
+    firstName: 'Mia',
+    lastName: 'Member',
+  });
+
+  await renderApp(<UsersRoute />, { user: admin });
+
+  const roleLabel = `Role of ${member.firstName} ${member.lastName}`;
+  const roleSelect = await screen.findByRole('combobox', { name: roleLabel });
+
+  expect(roleSelect).toHaveValue('USER');
+
+  await userEvent.selectOptions(roleSelect, 'ADMIN');
+
+  await screen.findByText(/role updated/i);
+
+  await waitFor(() =>
+    expect(screen.getByRole('combobox', { name: roleLabel })).toHaveValue(
+      'ADMIN',
+    ),
+  );
+});
