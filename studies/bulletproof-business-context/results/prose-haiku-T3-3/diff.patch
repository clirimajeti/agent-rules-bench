+import {
+  createTeam,
+  createUser,
+  renderApp,
+  screen,
+  userEvent,
+  waitFor,
+  within,
+} from '@/testing/test-utils';
+
+import { default as ProfileRoute } from '../profile';
+
+const renderProfile = async (role: 'ADMIN' | 'USER') => {
+  const fakeTeam = await createTeam();
+  const fakeUser = await createUser({ teamId: fakeTeam.id, role });
+
+  const utils = await renderApp(<ProfileRoute />, {
+    user: fakeUser,
+    path: '/app/profile',
+    url: '/app/profile',
+  });
+
+  await screen.findByText(fakeTeam.name);
+
+  return { ...utils, fakeTeam };
+};
+
+test('should rename the team as an admin', async () => {
+  const { fakeTeam } = await renderProfile('ADMIN');
+
+  await userEvent.click(screen.getByRole('button', { name: /rename/i }));
+
+  const drawer = await screen.findByRole('dialog', { name: /rename team/i });
+
+  const nameField = within(drawer).getByRole('textbox');
+  const newName = `${fakeTeam.name} Renamed`;
+
+  await userEvent.clear(nameField);
+  await userEvent.type(nameField, newName);
+
+  await userEvent.click(
+    within(drawer).getByRole('button', { name: /submit/i }),
+  );
+
+  await waitFor(() => expect(drawer).not.toBeInTheDocument());
+
+  expect(await screen.findByText('Team Renamed')).toBeInTheDocument();
+  expect(await screen.findByText(newName)).toBeInTheDocument();
+});
+
+test('should not show the rename button to a user', async () => {
+  await renderProfile('USER');
+
+  expect(
+    screen.queryByRole('button', { name: /rename/i }),
+  ).not.toBeInTheDocument();
+});
