@@ -0,0 +1,42 @@
+import { Select } from '@/components/ui/form';
+import { ROLES } from '@/lib/authorization';
+import { User } from '@/types/api';
+
+import {
+  updateUserRoleInputSchema,
+  useUpdateUserRole,
+} from '../api/update-user-role';
+
+type UpdateUserRoleProps = {
+  user: User;
+};
+
+const roleLabels: Record<ROLES, string> = {
+  [ROLES.ADMIN]: 'Admin',
+  [ROLES.USER]: 'User',
+};
+
+export const UpdateUserRole = ({ user }: UpdateUserRoleProps) => {
+  const updateUserRoleMutation = useUpdateUserRole();
+
+  return (
+    <Select
+      label="Role"
+      value={user.role}
+      disabled={updateUserRoleMutation.isPending}
+      options={Object.values(ROLES).map((role) => ({
+        label: roleLabels[role],
+        value: role,
+      }))}
+      registration={{
+        name: 'role',
+        onChange: async (event) => {
+          const data = updateUserRoleInputSchema.parse({
+            role: event.target.value,
+          });
+          updateUserRoleMutation.mutate({ userId: user.id, data });
+        },
+      }}
+    />
+  );
+};
