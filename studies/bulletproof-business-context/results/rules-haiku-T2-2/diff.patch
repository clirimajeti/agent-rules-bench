diff --git a/apps/react-vite/src/features/users/api/update-user-role.ts b/apps/react-vite/src/features/users/api/update-user-role.ts
new file mode 100644
index 0000000..a4e8a75
--- /dev/null
+++ b/apps/react-vite/src/features/users/api/update-user-role.ts
@@ -0,0 +1,59 @@
+import { useMutation, useQueryClient } from '@tanstack/react-query';
+import { z } from 'zod';
+
+import { useNotifications } from '@/components/ui/notifications';
+import { api } from '@/lib/api-client';
+import { ROLES } from '@/lib/authorization';
+import { MutationConfig } from '@/lib/react-query';
+import { User } from '@/types/api';
+
+import { getUsersQueryOptions } from './get-users';
+
+export const updateUserRoleInputSchema = z.object({
+  role: z.nativeEnum(ROLES),
+});
+
+export type UpdateUserRoleInput = z.infer<typeof updateUserRoleInputSchema>;
+
+export type UpdateUserRoleDTO = {
+  userId: string;
+  data: UpdateUserRoleInput;
+};
+
+export const updateUserRole = ({
+  userId,
+  data,
+}: UpdateUserRoleDTO): Promise<User> => {
+  return api.patch(`/users/${userId}/role`, data);
+};
+
+type UseUpdateUserRoleOptions = {
+  mutationConfig?: MutationConfig<typeof updateUserRole>;
+};
+
+export const useUpdateUserRole = ({
+  mutationConfig,
+}: UseUpdateUserRoleOptions = {}) => {
+  const queryClient = useQueryClient();
+  const { addNotification } = useNotifications();
+
+  const { onSuccess, ...restConfig } = mutationConfig || {};
+
+  return useMutation({
+    onSuccess: async (...args) => {
+      const [user] = args;
+      // Wait for the refetch so the row shows the new role before the mutation settles.
+      await queryClient.invalidateQueries({
+        queryKey: getUsersQueryOptions().queryKey,
+      });
+      addNotification({
+        type: 'success',
+        title: 'Role Updated',
+        message: `${user.firstName} ${user.lastName} is now ${user.role}`,
+      });
+      onSuccess?.(...args);
+    },
+    ...restConfig,
+    mutationFn: updateUserRole,
+  });
+};
diff --git a/apps/react-vite/src/features/users/components/__tests__/update-user-role.test.tsx b/apps/react-vite/src/features/users/components/__tests__/update-user-role.test.tsx
