--- /dev/null
+++ b/apps/react-vite/src/features/users/components/__tests__/update-user-role.test.tsx
@@ -0,0 +1,31 @@
+import {
+  createUser,
+  renderApp,
+  screen,
+  userEvent,
+  waitFor,
+  within,
+} from '@/testing/test-utils';
+
+import { UsersList } from '../users-list';
+
+test('should let an admin change a member role and show the new role', async () => {
+  const admin = await createUser({ role: 'ADMIN' });
+  const member = await createUser({ teamId: admin.teamId, role: 'USER' });
+
+  await renderApp(<UsersList />, { user: admin });
+
+  const getMemberRow = () =>
+    screen.getByText(member.email).closest('tr') as HTMLElement;
+  const getMemberRoleSelect = () =>
+    within(getMemberRow()).getByRole('combobox');
+
+  await screen.findByText(member.email);
+  expect(getMemberRoleSelect()).toHaveValue('USER');
+
+  await userEvent.selectOptions(getMemberRoleSelect(), 'ADMIN');
+
+  await screen.findByText(/role updated/i);
+
+  await waitFor(() => expect(getMemberRoleSelect()).toHaveValue('ADMIN'));
+});
