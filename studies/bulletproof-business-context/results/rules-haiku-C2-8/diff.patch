+import { test, expect } from '@playwright/test';
+
+import {
+  createDiscussion,
+  createComment,
+} from '../../src/testing/data-generators';
+
+test('discussion comments', async ({ page }) => {
+  const discussion = createDiscussion();
+  const firstComment = createComment();
+  const secondComment = createComment();
+
+  await page.goto('/app/discussions');
+  await page.waitForURL('/app/discussions');
+
+  // create discussion:
+  await page.getByRole('button', { name: 'Create Discussion' }).click();
+  await page.getByLabel('Title').click();
+  await page.getByLabel('Title').fill(discussion.title);
+  await page.getByLabel('Body').click();
+  await page.getByLabel('Body').fill(discussion.body);
+  await page.getByRole('button', { name: 'Submit' }).click();
+  await page
+    .getByLabel('Discussion Created')
+    .getByRole('button', { name: 'Close' })
+    .click();
+
+  // visit discussion page:
+  await page.getByRole('link', { name: 'View' }).click();
+  await expect(
+    page.getByRole('heading', { name: discussion.title }),
+  ).toBeVisible();
+
+  const commentItems = page
+    .getByRole('list', { name: 'comments' })
+    .getByRole('listitem');
+
+  // add two comments:
+  for (const comment of [firstComment, secondComment]) {
+    await page.getByRole('button', { name: 'Create Comment' }).click();
+    await page.getByLabel('Body').click();
+    await page.getByLabel('Body').fill(comment.body);
+    await page.getByRole('button', { name: 'Submit' }).click();
+    await expect(
+      commentItems.filter({ hasText: comment.body }),
+    ).toBeVisible();
+    await page
+      .getByLabel('Comment Created')
+      .getByRole('button', { name: 'Close' })
+      .click();
+  }
+
+  await expect(commentItems).toHaveCount(2);
+
+  // delete the first comment:
+  await commentItems
+    .filter({ hasText: firstComment.body })
+    .getByRole('button', { name: 'Delete Comment' })
+    .click();
+  await expect(
+    page.getByText('Are you sure you want to delete this comment?'),
+  ).toBeVisible();
+  await page
+    .getByRole('dialog')
+    .getByRole('button', { name: 'Delete Comment' })
+    .click();
+  await page
+    .getByLabel('Comment Deleted')
+    .getByRole('button', { name: 'Close' })
+    .click();
+
+  // only the second comment is left:
+  await expect(commentItems).toHaveCount(1);
+  await expect(
+    commentItems.filter({ hasText: secondComment.body }),
+  ).toBeVisible();
+  await expect(page.getByText(firstComment.body)).toBeHidden();
+});
