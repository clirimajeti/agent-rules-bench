@@ -0,0 +1,61 @@
+import { Pen } from 'lucide-react';
+
+import { Button } from '@/components/ui/button';
+import { Form, FormDrawer, Input } from '@/components/ui/form';
+import { Authorization, ROLES } from '@/lib/authorization';
+
+import { updateTeamInputSchema, useUpdateTeam } from '../api/update-team';
+
+type RenameTeamProps = {
+  teamId: string;
+  currentName: string;
+};
+
+export const RenameTeam = ({ teamId, currentName }: RenameTeamProps) => {
+  const updateTeamMutation = useUpdateTeam();
+
+  return (
+    <Authorization allowedRoles={[ROLES.ADMIN]}>
+      <FormDrawer
+        isDone={updateTeamMutation.isSuccess}
+        triggerButton={
+          <Button icon={<Pen className="size-4" />} size="sm">
+            Rename
+          </Button>
+        }
+        title="Rename Team"
+        submitButton={
+          <Button
+            form="rename-team"
+            type="submit"
+            size="sm"
+            isLoading={updateTeamMutation.isPending}
+          >
+            Submit
+          </Button>
+        }
+      >
+        <Form
+          id="rename-team"
+          onSubmit={(values) => {
+            updateTeamMutation.mutate({ data: values, teamId });
+          }}
+          options={{
+            defaultValues: {
+              name: currentName,
+            },
+          }}
+          schema={updateTeamInputSchema}
+        >
+          {({ register, formState }) => (
+            <Input
+              label="Team Name"
+              error={formState.errors['name']}
+              registration={register('name')}
+            />
+          )}
+        </Form>
+      </FormDrawer>
+    </Authorization>
+  );
+};
