@@ -0,0 +1,58 @@
+import { Pen } from 'lucide-react';
+
+import { Button } from '@/components/ui/button';
+import { Form, FormDrawer, Input } from '@/components/ui/form';
+import { Team } from '@/types/api';
+
+import { updateTeamInputSchema, useUpdateTeam } from '../api/update-team';
+
+type UpdateTeamProps = {
+  team: Team;
+};
+
+export const UpdateTeam = ({ team }: UpdateTeamProps) => {
+  const updateTeamMutation = useUpdateTeam();
+
+  return (
+    <FormDrawer
+      isDone={updateTeamMutation.isSuccess}
+      triggerButton={
+        <Button icon={<Pen className="size-4" />} size="sm">
+          Rename
+        </Button>
+      }
+      title="Rename Team"
+      submitButton={
+        <Button
+          form="update-team"
+          type="submit"
+          size="sm"
+          isLoading={updateTeamMutation.isPending}
+        >
+          Submit
+        </Button>
+      }
+    >
+      <Form
+        id="update-team"
+        onSubmit={(values) => {
+          updateTeamMutation.mutate({ data: values, teamId: team.id });
+        }}
+        options={{
+          defaultValues: {
+            name: team.name,
+          },
+        }}
+        schema={updateTeamInputSchema}
+      >
+        {({ register, formState }) => (
+          <Input
+            label="Team Name"
+            error={formState.errors['name']}
+            registration={register('name')}
+          />
+        )}
+      </Form>
+    </FormDrawer>
+  );
+};
