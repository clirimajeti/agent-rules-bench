index 0000000..b306957
--- /dev/null
+++ b/apps/react-vite/src/features/comments/components/update-comment.tsx
@@ -0,0 +1,76 @@
+import { Pen } from 'lucide-react';
+
+import { Button } from '@/components/ui/button';
+import { Form, FormDrawer, Textarea } from '@/components/ui/form';
+
+import {
+  updateCommentInputSchema,
+  useUpdateComment,
+} from '../api/update-comment';
+
+type UpdateCommentProps = {
+  id: string;
+  discussionId: string;
+  body: string;
+};
+
+export const UpdateComment = ({
+  id,
+  discussionId,
+  body,
+}: UpdateCommentProps) => {
+  const updateCommentMutation = useUpdateComment({
+    discussionId,
+  });
+
+  return (
+    <FormDrawer
+      isDone={updateCommentMutation.isSuccess}
+      triggerButton={
+        <Button
+          variant="outline"
+          size="sm"
+          icon={<Pen className="size-4" />}
+        >
+          Edit Comment
+        </Button>
+      }
+      title="Edit Comment"
+      submitButton={
+        <Button
+          isLoading={updateCommentMutation.isPending}
+          form="update-comment"
+          type="submit"
+          size="sm"
+          disabled={updateCommentMutation.isPending}
+        >
+          Submit
+        </Button>
+      }
+    >
+      <Form
+        id="update-comment"
+        onSubmit={(values) => {
+          updateCommentMutation.mutate({
+            data: values,
+            commentId: id,
+          });
+        }}
+        schema={updateCommentInputSchema}
+        options={{
+          defaultValues: {
+            body,
+          },
+        }}
+      >
+        {({ register, formState }) => (
+          <Textarea
+            label="Body"
+            error={formState.errors['body']}
+            registration={register('body')}
+          />
+        )}
+      </Form>
+    </FormDrawer>
+  );
+};
