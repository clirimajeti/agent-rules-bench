+    const commentElement = (
+      await within(commentsList).findAllByRole('listitem')
+    )[0];
+
+    await userEvent.click(
+      within(commentElement).getByRole('button', { name: /edit comment/i }),
+    );
+
+    const editDrawer = await screen.findByRole('dialog', {
+      name: /edit comment/i,
+    });
+
+    const bodyField = within(editDrawer).getByRole('textbox');
+    expect(bodyField).toHaveValue(comment);
+
+    await userEvent.clear(bodyField);
