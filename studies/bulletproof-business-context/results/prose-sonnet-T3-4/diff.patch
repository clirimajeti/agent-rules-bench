+import { createTeam } from '@/testing/data-generators';
+import { db } from '@/testing/mocks/db';
+import {
+  createUser,
+  renderApp,
+  screen,
+  userEvent,
+  waitFor,
+  within,
+} from '@/testing/test-utils';
+
+import { default as ProfileRoute } from '../profile';
+
+test('admin can rename their team', { timeout: 10000 }, async () => {
+  const team = db.team.create(createTeam());
+  const user = await createUser({ teamId: team.id, role: 'ADMIN' });
+  const newName = 'Renamed Team';
+
+  await renderApp(<ProfileRoute />, { user });
+
+  expect(await screen.findByText(team.name)).toBeInTheDocument();
+
+  await userEvent.click(screen.getByRole('button', { name: /rename/i }));
+
+  const drawer = await screen.findByRole('dialog', { name: /rename team/i });
+  const nameField = within(drawer).getByLabelText(/team name/i);
+
+  await userEvent.clear(nameField);
+  await userEvent.type(nameField, newName);
+  await userEvent.click(
+    within(drawer).getByRole('button', { name: /submit/i }),
+  );
+
+  await screen.findByText(/team renamed/i);
+  await waitFor(() => expect(drawer).not.toBeInTheDocument());
+  expect(await screen.findByText(newName)).toBeInTheDocument();
+});
+
+test('regular users cannot rename their team', async () => {
+  const team = db.team.create(createTeam());
+  const user = await createUser({ teamId: team.id, role: 'USER' });
+
+  await renderApp(<ProfileRoute />, { user });
+
+  expect(await screen.findByText(team.name)).toBeInTheDocument();
+  expect(
+    screen.queryByRole('button', { name: /rename/i }),
+  ).not.toBeInTheDocument();
+});
