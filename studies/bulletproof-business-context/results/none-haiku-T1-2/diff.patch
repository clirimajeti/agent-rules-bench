+test('should edit only the own comments', async () => {
+  const fakeUser = await createUser();
+  const otherUser = await createUser({ teamId: fakeUser.teamId });
+  const fakeDiscussion = await createDiscussion({ teamId: fakeUser.teamId });
+
+  await createComment({
+    discussionId: fakeDiscussion.id,
+    authorId: fakeUser.id,
+    body: 'My original comment',
+  });
+  await createComment({
+    discussionId: fakeDiscussion.id,
+    authorId: otherUser.id,
+    body: 'Somebody else comment',
+  });
+
+  await renderApp(<DiscussionRoute />, {
+    user: fakeUser,
+    path: `/app/discussions/:discussionId`,
+    url: `/app/discussions/${fakeDiscussion.id}`,
+  });
+
+  await screen.findByText(fakeDiscussion.title);
+
+  const commentsList = await screen.findByRole('list', { name: 'comments' });
+  await within(commentsList).findByText('My original comment');
+
+  // only the own comment offers an edit button
+  const editButtons = within(commentsList).getAllByRole('button', {
+    name: /edit comment/i,
+  });
+  expect(editButtons).toHaveLength(1);
+
+  await userEvent.click(editButtons[0]);
+
+  const drawer = await screen.findByRole('dialog', {
+    name: /edit comment/i,
+  });
+
+  const bodyField = within(drawer).getByRole('textbox');
+  expect(bodyField).toHaveValue('My original comment');
+
+  await userEvent.clear(bodyField);
+  await userEvent.type(bodyField, 'My edited comment');
+
+  const submitButton = within(drawer).getByRole('button', {
+    name: /submit/i,
+  });
+  await userEvent.click(submitButton);
+
+  await waitFor(() => expect(drawer).not.toBeInTheDocument());
+
+  expect(await screen.findByText(/comment updated/i)).toBeInTheDocument();
+  expect(
+    await within(commentsList).findByText('My edited comment'),
+  ).toBeInTheDocument();
+  expect(
+    within(commentsList).queryByText('My original comment'),
+  ).not.toBeInTheDocument();
+});
