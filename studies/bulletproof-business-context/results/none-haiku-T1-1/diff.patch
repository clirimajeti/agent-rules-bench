+test('should edit own comment but not comments of other members', async () => {
+  const fakeUser = await createUser();
+  const otherUser = await createUser({ teamId: fakeUser.teamId });
+  const fakeDiscussion = await createDiscussion({ teamId: fakeUser.teamId });
+
+  await db.comment.create(
+    createComment({
+      authorId: fakeUser.id,
+      discussionId: fakeDiscussion.id,
+      body: 'My comment',
+    }),
+  );
+  await db.comment.create(
+    createComment({
+      authorId: otherUser.id,
+      discussionId: fakeDiscussion.id,
+      body: 'Their comment',
+    }),
+  );
+
+  await renderApp(<DiscussionRoute />, {
+    user: fakeUser,
+    path: `/app/discussions/:discussionId`,
+    url: `/app/discussions/${fakeDiscussion.id}`,
+  });
+
+  await screen.findByText(fakeDiscussion.title);
+  const commentsList = await screen.findByRole('list', { name: 'comments' });
+
+  const otherComment = await within(commentsList).findByRole('listitem', {
+    name: /their comment/i,
+  });
+  expect(
+    within(otherComment).queryByRole('button', { name: /edit/i }),
+  ).not.toBeInTheDocument();
+
+  const ownComment = within(commentsList).getByRole('listitem', {
+    name: /my comment/i,
+  });
+  await userEvent.click(
+    within(ownComment).getByRole('button', { name: /edit/i }),
+  );
+
+  const drawer = await screen.findByRole('dialog', { name: /edit comment/i });
+  const bodyField = within(drawer).getByRole('textbox');
+  expect(bodyField).toHaveValue('My comment');
+
+  await userEvent.clear(bodyField);
+  await userEvent.type(bodyField, 'Edited comment');
+  await userEvent.click(
+    within(drawer).getByRole('button', { name: /submit/i }),
+  );
+
+  await waitFor(() => expect(drawer).not.toBeInTheDocument());
+
+  expect(await screen.findByText(/comment updated/i)).toBeInTheDocument();
+  expect(await screen.findByText('Edited comment')).toBeInTheDocument();
+  expect(screen.queryByText('My comment')).not.toBeInTheDocument();
+});
