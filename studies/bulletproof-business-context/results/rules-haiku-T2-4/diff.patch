+import * as React from 'react';
+
+import { Select } from '@/components/ui/form';
+import { useUser } from '@/lib/auth';
+import { Authorization, POLICIES, ROLES } from '@/lib/authorization';
+import { User } from '@/types/api';
+
+import { useUpdateUserRole } from '../api/update-user-role';
+
+const roleOptions: { label: string; value: ROLES }[] = [
+  { label: 'Admin', value: ROLES.ADMIN },
+  { label: 'User', value: ROLES.USER },
+];
+
+type UpdateUserRoleProps = {
+  id: string;
+  role: User['role'];
+};
+
+export const UpdateUserRole = ({ id, role }: UpdateUserRoleProps) => {
+  const user = useUser();
+  // Changing the key remounts the select, which resets it to the stored role after a failed change.
+  const [selectKey, setSelectKey] = React.useState(0);
+  const updateUserRoleMutation = useUpdateUserRole({
+    mutationConfig: {
+      onError: () => setSelectKey((key) => key + 1),
+    },
+  });
+
+  return (
+    <Authorization
+      policyCheck={
+        user.data ? POLICIES['user:change-role'](user.data, { id }) : false
+      }
+      forbiddenFallback={<span>{role}</span>}
+    >
+      <Select
+        key={selectKey}
+        options={roleOptions}
+        defaultValue={role}
+        registration={{
+          name: `role-${id}`,
+          onChange: (event) =>
+            updateUserRoleMutation.mutate({
+              userId: id,
+              data: { role: event.target.value as ROLES },
+            }),
+        }}
+      />
+    </Authorization>
+  );
+};
