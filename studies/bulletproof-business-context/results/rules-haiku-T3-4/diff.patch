+import { createTeam } from '@/testing/data-generators';
+import { db } from '@/testing/mocks/db';
+import {
+  createUser,
+  renderApp,
+  screen,
+  userEvent,
+  waitFor,
+  within,
+} from '@/testing/test-utils';
+
+import { default as ProfileRoute } from '../profile';
+
+const renderProfile = async (role: 'ADMIN' | 'USER') => {
+  const team = db.team.create(createTeam({ name: 'Old Team Name' }));
+  const user = await createUser({ role, teamId: team.id });
+
+  const utils = await renderApp(<ProfileRoute />, {
+    user,
+    path: '/app/profile',
+    url: '/app/profile',
+  });
+
+  await screen.findByText(team.name);
+
+  return { ...utils, team };
+};
+
+test('should show the team name to a user without the rename button', async () => {
+  const { team } = await renderProfile('USER');
+
+  expect(screen.getByText(team.name)).toBeInTheDocument();
+  expect(
+    screen.queryByRole('button', { name: /rename team/i }),
+  ).not.toBeInTheDocument();
+});
+
+test('should let an admin rename the team', async () => {
+  const { team } = await renderProfile('ADMIN');
+
+  await userEvent.click(
+    screen.getByRole('button', { name: /rename team/i }),
+  );
+
+  const drawer = await screen.findByRole('dialog', {
+    name: /rename team/i,
+  });
+
+  const nameField = within(drawer).getByRole('textbox');
+  await userEvent.clear(nameField);
+  await userEvent.type(nameField, 'New Team Name');
+
+  await userEvent.click(
+    within(drawer).getByRole('button', { name: /submit/i }),
+  );
+
+  await waitFor(() => expect(drawer).not.toBeInTheDocument());
+
+  expect(await screen.findByText(/team renamed/i)).toBeInTheDocument();
+  expect(await screen.findByText('New Team Name')).toBeInTheDocument();
+  expect(screen.queryByText(team.name)).not.toBeInTheDocument();
+});
