+import { test, expect } from '@playwright/test';
+
+import {
+  createDiscussion,
+  createComment,
+} from '../../src/testing/data-generators';
+
+test('discussion comments', async ({ page }) => {
+  const discussion = createDiscussion();
+  const keptComment = createComment({ body: `Kept: ${createComment().body}` });
+  const deletedComment = createComment({
+    body: `Deleted: ${createComment().body}`,
+  });
+
+  await page.goto('/app/discussions');
+  await page.waitForURL('/app/discussions');
+
+  // create discussion:
+  await page.getByRole('button', { name: 'Create Discussion' }).click();
+  await page.getByLabel('Title').fill(discussion.title);
+  await page.getByLabel('Body').fill(discussion.body);
+  await page.getByRole('button', { name: 'Submit' }).click();
+  await page
+    .getByLabel('Discussion Created')
+    .getByRole('button', { name: 'Close' })
+    .click();
+
+  // visit discussion page:
+  await page.getByRole('link', { name: 'View' }).click();
+  await expect(
+    page.getByRole('heading', { name: discussion.title }),
+  ).toBeVisible();
+
+  // create two comments:
+  for (const comment of [keptComment, deletedComment]) {
+    await page.getByRole('button', { name: 'Create Comment' }).click();
+    await page.getByLabel('Body').fill(comment.body);
+    await page.getByRole('button', { name: 'Submit' }).click();
+    await expect(page.getByText(comment.body)).toBeVisible();
+    await page
+      .getByLabel('Comment Created')
+      .getByRole('button', { name: 'Close' })
+      .click();
+  }
+
+  const comments = page.getByRole('list', { name: 'comments' });
+  await expect(comments.getByRole('listitem')).toHaveCount(2);
+
+  // delete one of the comments:
+  await comments
+    .getByRole('listitem')
+    .filter({ hasText: deletedComment.body })
+    .getByRole('button', { name: 'Delete Comment' })
+    .click();
+  await expect(
+    page.getByText('Are you sure you want to delete this comment?'),
+  ).toBeVisible();
+  await page
+    .getByRole('dialog')
+    .getByRole('button', { name: 'Delete Comment' })
+    .click();
+  await page
+    .getByLabel('Comment Deleted')
+    .getByRole('button', { name: 'Close' })
+    .click();
+
+  // only the other comment is left:
+  await expect(comments.getByRole('listitem')).toHaveCount(1);
+  await expect(page.getByText(keptComment.body)).toBeVisible();
+  await expect(page.getByText(deletedComment.body)).toBeHidden();
+
+  // clean up, so other tests see an empty discussions list:
+  await page.getByRole('link', { name: 'Discussions' }).click();
+  await page.waitForURL('/app/discussions');
+  await page.getByRole('button', { name: 'Delete Discussion' }).click();
+  await page.getByRole('button', { name: 'Delete Discussion' }).click();
+  await page
+    .getByLabel('Discussion Deleted')
+    .getByRole('button', { name: 'Close' })
+    .click();
+  await expect(
+    page.getByRole('heading', { name: 'No Entries Found' }),
+  ).toBeVisible();
+});
