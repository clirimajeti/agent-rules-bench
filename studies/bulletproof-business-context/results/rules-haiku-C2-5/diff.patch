+++ b/apps/react-vite/e2e/tests/discussion-comments.spec.ts
@@ -0,0 +1,80 @@
+import { test, expect, type Page } from '@playwright/test';
+
+import {
+  createDiscussion,
+  createComment,
+} from '../../src/testing/data-generators';
+
+// each comment is a list item labelled "comment-<body>-<index>"
+const commentItem = (page: Page, body: string) =>
+  page.getByRole('listitem', { name: body });
+
+test('discussion comments', async ({ page }) => {
+  const discussion = createDiscussion();
+  const keptComment = createComment();
+  const deletedComment = createComment();
+
+  await page.goto('/');
+  await page.getByRole('button', { name: 'Get started' }).click();
+  await page.waitForURL('/app');
+
+  // create discussion:
+  await page.getByRole('link', { name: 'Discussions' }).click();
+  await page.waitForURL('/app/discussions');
+
+  await page.getByRole('button', { name: 'Create Discussion' }).click();
+  await page.getByLabel('Title').click();
+  await page.getByLabel('Title').fill(discussion.title);
+  await page.getByLabel('Body').click();
+  await page.getByLabel('Body').fill(discussion.body);
+  await page.getByRole('button', { name: 'Submit' }).click();
+  await page
+    .getByLabel('Discussion Created')
+    .getByRole('button', { name: 'Close' })
+    .click();
+
+  // visit discussion page:
+  await page.getByRole('link', { name: 'View' }).click();
+  await expect(
+    page.getByRole('heading', { name: discussion.title }),
+  ).toBeVisible();
+
+  // add two comments, closing each confirmation before the next one:
+  for (const comment of [keptComment, deletedComment]) {
+    await page.getByRole('button', { name: 'Create Comment' }).click();
+    await page.getByLabel('Body').click();
+    await page.getByLabel('Body').fill(comment.body);
+    await page.getByRole('button', { name: 'Submit' }).click();
+    await expect(commentItem(page, comment.body)).toBeVisible();
+    await page
+      .getByLabel('Comment Created')
+      .getByRole('button', { name: 'Close' })
+      .click();
+  }
+
+  await expect(
+    page.getByRole('list', { name: 'comments' }).getByRole('listitem'),
+  ).toHaveCount(2);
+
+  // delete one of the comments:
+  await commentItem(page, deletedComment.body)
+    .getByRole('button', { name: 'Delete Comment' })
+    .click();
+
+  const dialog = page.getByRole('dialog');
+  await expect(
+    dialog.getByText('Are you sure you want to delete this comment?'),
+  ).toBeVisible();
+  await dialog.getByRole('button', { name: 'Delete Comment' }).click();
+  await page
+    .getByLabel('Comment Deleted')
+    .getByRole('button', { name: 'Close' })
+    .click();
+
+  // only the other comment is left:
+  await expect(commentItem(page, deletedComment.body)).toBeHidden();
+  await expect(commentItem(page, keptComment.body)).toBeVisible();
+  await expect(
+    page.getByRole('list', { name: 'comments' }).getByRole('listitem'),
+  ).toHaveCount(1);
+});
