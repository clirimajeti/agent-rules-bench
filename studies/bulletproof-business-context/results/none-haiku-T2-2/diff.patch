+import { Button } from '@/components/ui/button';
+import { Form, Select } from '@/components/ui/form';
+import { ROLES } from '@/lib/authorization';
+import { User } from '@/types/api';
+
+import {
+  type UpdateUserRoleInput,
+  updateUserRoleInputSchema,
+  useUpdateUserRole,
+} from '../api/update-user-role';
+
+const ROLE_OPTIONS: { label: string; value: ROLES }[] = [
+  { label: 'Admin', value: ROLES.ADMIN },
+  { label: 'User', value: ROLES.USER },
+];
+
+type UpdateUserRoleProps = {
+  id: string;
+  role: User['role'];
+};
+
+export const UpdateUserRole = ({ id, role }: UpdateUserRoleProps) => {
+  const updateUserRoleMutation = useUpdateUserRole();
+
+  return (
+    <Form
+      id={`update-user-role-${id}`}
+      className="flex items-center gap-2 space-y-0"
+      onSubmit={(values: UpdateUserRoleInput) => {
+        updateUserRoleMutation.mutate({ userId: id, data: values });
+      }}
+      options={{ defaultValues: { role: ROLES[role] } }}
+      schema={updateUserRoleInputSchema}
+    >
+      {({ register, formState }) => (
+        <>
+          <Select
+            options={ROLE_OPTIONS}
+            error={formState.errors['role']}
+            registration={register('role')}
+          />
+          <Button
+            type="submit"
+            size="sm"
+            isLoading={updateUserRoleMutation.isPending}
+          >
+            Save
+          </Button>
+        </>
+      )}
+    </Form>
+  );
+};
