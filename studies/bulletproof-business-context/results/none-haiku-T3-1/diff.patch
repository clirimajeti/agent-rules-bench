+import { Pen } from 'lucide-react';
+
+import { Button } from '@/components/ui/button';
+import { Form, FormDrawer, Input } from '@/components/ui/form';
+import { Authorization, ROLES } from '@/lib/authorization';
+import { Team } from '@/types/api';
+
+import { updateTeamInputSchema, useUpdateTeam } from '../api/update-team';
+
+type RenameTeamProps = {
+  team: Team;
+};
+
+export const RenameTeam = ({ team }: RenameTeamProps) => {
+  const renameTeamMutation = useUpdateTeam();
+
+  return (
+    <Authorization allowedRoles={[ROLES.ADMIN]}>
+      <FormDrawer
+        isDone={renameTeamMutation.isSuccess}
+        triggerButton={
+          <Button icon={<Pen className="size-4" />} size="sm">
+            Rename
+          </Button>
+        }
+        title="Rename Team"
+        submitButton={
+          <Button
+            form="rename-team"
+            type="submit"
+            size="sm"
+            isLoading={renameTeamMutation.isPending}
+          >
+            Submit
+          </Button>
+        }
+      >
+        <Form
+          id="rename-team"
+          onSubmit={(values) => {
+            renameTeamMutation.mutate({ data: values, teamId: team.id });
+          }}
+          options={{
+            defaultValues: {
+              name: team.name,
+            },
+          }}
+          schema={updateTeamInputSchema}
+        >
+          {({ register, formState }) => (
+            <Input
+              label="Team Name"
+              error={formState.errors['name']}
+              registration={register('name')}
+            />
+          )}
+        </Form>
+      </FormDrawer>
+    </Authorization>
+  );
+};
