+import { useUser } from '@/lib/auth';
+
+import { useTeams } from '../api/get-teams';
+
+import { RenameTeam } from './rename-team';
+
+export const TeamInfo = () => {
+  const user = useUser();
+  const teamsQuery = useTeams();
+
+  const team = teamsQuery.data?.data.find(
+    (item) => item.id === user.data?.teamId,
+  );
+
+  if (!team) return null;
+
+  return (
+    <div className="overflow-hidden bg-white shadow sm:rounded-lg">
+      <div className="px-4 py-5 sm:px-6">
+        <div className="flex justify-between">
+          <h3 className="text-lg font-medium leading-6 text-gray-900">
+            Team
+          </h3>
+          <RenameTeam team={team} />
+        </div>
+        <p className="mt-1 max-w-2xl text-sm text-gray-500">
+          The team you belong to.
+        </p>
+      </div>
+      <div className="border-t border-gray-200 px-4 py-5 sm:p-0">
+        <dl className="sm:divide-y sm:divide-gray-200">
+          <div className="py-4 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6 sm:py-5">
+            <dt className="text-sm font-medium text-gray-500">Team Name</dt>
+            <dd className="mt-1 text-sm text-gray-900 sm:col-span-2 sm:mt-0">
+              {team.name}
+            </dd>
+          </div>
+        </dl>
+      </div>
+    </div>
+  );
+};
