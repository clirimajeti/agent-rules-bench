@@ -0,0 +1,69 @@
+import { default as ProfileRoute } from '@/app/routes/app/profile';
+import { db } from '@/testing/mocks/db';
+import {
+  createUser,
+  renderApp,
+  screen,
+  userEvent,
+  waitFor,
+  within,
+} from '@/testing/test-utils';
+
+const renderProfile = async (role: 'ADMIN' | 'USER') => {
+  const team = db.team.create({ name: 'Old Team Name' });
+  const fakeUser = await createUser({ teamId: team.id, role });
+
+  const utils = await renderApp(<ProfileRoute />, {
+    user: fakeUser,
+    path: '/app/profile',
+    url: '/app/profile',
+  });
+
+  await screen.findByText('Old Team Name');
+
+  return { ...utils, team };
+};
+
+test('should show the team name and a rename button to admins', async () => {
+  await renderProfile('ADMIN');
+
+  expect(screen.getByText('Team Name')).toBeInTheDocument();
+  expect(screen.getByRole('button', { name: /rename/i })).toBeInTheDocument();
+});
+
+test('should show the team name but hide the rename button from users', async () => {
+  await renderProfile('USER');
+
+  expect(screen.getByText('Old Team Name')).toBeInTheDocument();
+  expect(
+    screen.queryByRole('button', { name: /rename/i }),
+  ).not.toBeInTheDocument();
+});
+
+test('should rename the team and show a success message', async () => {
+  const { team } = await renderProfile('ADMIN');
+
+  await userEvent.click(screen.getByRole('button', { name: /rename/i }));
+
+  const drawer = await screen.findByRole('dialog', {
+    name: /rename team/i,
+  });
+
+  const nameField = within(drawer).getByRole('textbox');
+  await userEvent.clear(nameField);
+  await userEvent.type(nameField, 'New Team Name');
+
+  await userEvent.click(
+    within(drawer).getByRole('button', { name: /submit/i }),
+  );
+
+  await waitFor(() => expect(drawer).not.toBeInTheDocument());
+
+  expect(await screen.findByText('Team Renamed')).toBeInTheDocument();
+  expect(await screen.findByText('New Team Name')).toBeInTheDocument();
+
+  const storedTeam = db.team.findFirst({
+    where: { id: { equals: team.id } },
+  });
+  expect(storedTeam?.name).toBe('New Team Name');
+});
