+import { Button } from '@/components/ui/button';
+import { Form, Select } from '@/components/ui/form';
+import { ROLES } from '@/lib/authorization';
+import { User } from '@/types/api';
+
+import {
+  updateUserRoleInputSchema,
+  useUpdateUserRole,
+} from '../api/update-user-role';
+
+const roleOptions = [
+  { label: 'Admin', value: ROLES.ADMIN },
+  { label: 'User', value: ROLES.USER },
+];
+
+type UpdateUserRoleProps = {
+  userId: string;
+  role: User['role'];
+};
+
+export const UpdateUserRole = ({ userId, role }: UpdateUserRoleProps) => {
+  const updateUserRoleMutation = useUpdateUserRole();
+
+  return (
+    <Form
+      id={`update-user-role-${userId}`}
+      schema={updateUserRoleInputSchema}
+      options={{
+        defaultValues: {
+          role: role as ROLES,
+        },
+      }}
+      onSubmit={(values) => {
+        updateUserRoleMutation.mutate({ userId, data: values });
+      }}
+    >
+      {({ register, formState }) => (
+        <div className="flex items-end gap-2">
+          <Select
+            label="Role"
+            options={roleOptions}
+            error={formState.errors['role']}
+            registration={register('role')}
+          />
+          <Button
+            type="submit"
+            size="sm"
+            isLoading={updateUserRoleMutation.isPending}
+          >
+            Save
+          </Button>
+        </div>
+      )}
+    </Form>
+  );
+};
