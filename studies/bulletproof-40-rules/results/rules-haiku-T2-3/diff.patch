+import type { ChangeEvent } from 'react';
+
+import { Select } from '@/components/ui/form';
+import { useUser } from '@/lib/auth';
+import { POLICIES, ROLES } from '@/lib/authorization';
+import { User } from '@/types/api';
+
+import {
+  UpdateUserRoleInput,
+  useUpdateUserRole,
+} from '../api/update-user-role';
+
+const roleOptions = [
+  { label: 'Admin', value: ROLES.ADMIN },
+  { label: 'User', value: ROLES.USER },
+];
+
+type UpdateUserRoleProps = {
+  user: User;
+};
+
+export const UpdateUserRole = ({ user }: UpdateUserRoleProps) => {
+  const currentUser = useUser();
+  const updateUserRoleMutation = useUpdateUserRole();
+
+  const canUpdateRole =
+    !!currentUser.data &&
+    POLICIES['user:update-role'](currentUser.data, user);
+
+  if (!canUpdateRole) {
+    return <span>{user.role}</span>;
+  }
+
+  return (
+    <Select
+      label="Role"
+      options={roleOptions}
+      defaultValue={user.role}
+      registration={{
+        name: 'role',
+        onChange: (event: ChangeEvent<HTMLSelectElement>) => {
+          const select = event.currentTarget;
+          const data = { role: select.value as UpdateUserRoleInput['role'] };
+
+          updateUserRoleMutation.mutate(
+            { userId: user.id, data },
+            {
+              // Revert the select if the server rejects the change.
+              onError: () => {
+                select.value = user.role;
+              },
+            },
+          );
+        },
+      }}
+    />
+  );
+};
