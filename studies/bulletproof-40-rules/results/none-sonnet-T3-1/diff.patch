+import { Spinner } from '@/components/ui/spinner';
+import { Authorization, ROLES } from '@/lib/authorization';
+
+import { useTeams } from '../api/get-teams';
+
+import { UpdateTeam } from './update-team';
+
+type TeamSectionProps = {
+  teamId: string;
+};
+
+export const TeamSection = ({ teamId }: TeamSectionProps) => {
+  const teamsQuery = useTeams();
+  const team = teamsQuery.data?.data.find((t) => t.id === teamId);
+
+  return (
+    <div className="mt-6 overflow-hidden bg-white shadow sm:rounded-lg">
+      <div className="px-4 py-5 sm:px-6">
+        <div className="flex justify-between">
+          <h3 className="text-lg font-medium leading-6 text-gray-900">Team</h3>
+          {team && (
+            <Authorization allowedRoles={[ROLES.ADMIN]}>
+              <UpdateTeam teamId={team.id} name={team.name} />
+            </Authorization>
+          )}
+        </div>
+      </div>
+      <div className="border-t border-gray-200 px-4 py-5 sm:p-0">
+        {teamsQuery.isLoading ? (
+          <div className="flex h-24 items-center justify-center">
+            <Spinner />
+          </div>
+        ) : (
+          <dl>
+            <div className="py-4 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6 sm:py-5">
+              <dt className="text-sm font-medium text-gray-500">Team Name</dt>
+              <dd className="mt-1 text-sm text-gray-900 sm:col-span-2 sm:mt-0">
+                {team?.name ?? '-'}
+              </dd>
+            </div>
+          </dl>
+        )}
+      </div>
+    </div>
+  );
+};
