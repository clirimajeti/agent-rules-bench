+import * as React from 'react';
+
+import { Select } from '@/components/ui/form';
+import { ROLES } from '@/lib/authorization';
+import { User } from '@/types/api';
+
+import { useUpdateUserRole } from '../api/update-user-role';
+
+const roleOptions = [
+  { label: 'Admin', value: ROLES.ADMIN },
+  { label: 'User', value: ROLES.USER },
+];
+
+type UpdateUserRoleProps = {
+  id: string;
+  role: User['role'];
+};
+
+export const UpdateUserRole = ({ id, role }: UpdateUserRoleProps) => {
+  // The select is uncontrolled, so it is remounted on error to show the role the server still has.
+  const [selectKey, setSelectKey] = React.useState(0);
+  const updateUserRoleMutation = useUpdateUserRole({
+    mutationConfig: {
+      onError: () => {
+        setSelectKey((key) => key + 1);
+      },
+    },
+  });
+
+  return (
+    <Select
+      key={`${role}-${selectKey}`}
+      options={roleOptions}
+      defaultValue={role}
+      registration={{
+        name: 'role',
+        onChange: async (event: { target: { value: string } }) => {
+          updateUserRoleMutation.mutate({
+            userId: id,
+            data: { role: event.target.value as ROLES },
+          });
+        },
+      }}
+    />
+  );
+};
