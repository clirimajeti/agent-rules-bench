+import { Form, Select } from '@/components/ui/form';
+import { useUser } from '@/lib/auth';
+import { Authorization, POLICIES, ROLES } from '@/lib/authorization';
+import { User } from '@/types/api';
+
+import {
+  UpdateUserRoleInput,
+  updateUserRoleInputSchema,
+  useUpdateUserRole,
+} from '../api/update-user-role';
+
+const roleOptions = Object.values(ROLES).map((role) => ({
+  label: role,
+  value: role,
+}));
+
+type UpdateUserRoleProps = {
+  user: User;
+};
+
+export const UpdateUserRole = ({ user }: UpdateUserRoleProps) => {
+  const currentUser = useUser();
+  const updateUserRoleMutation = useUpdateUserRole();
+
+  const canUpdate = currentUser.data
+    ? POLICIES['user:update-role'](currentUser.data, user)
+    : false;
+
+  const submitRole = (data: UpdateUserRoleInput) => {
+    updateUserRoleMutation.mutate({ userId: user.id, data });
+  };
+
+  return (
+    <Authorization
+      policyCheck={canUpdate}
+      forbiddenFallback={<span>{user.role}</span>}
+    >
+      <Form
+        onSubmit={submitRole}
+        schema={updateUserRoleInputSchema}
+        options={{
+          values: { role: user.role as UpdateUserRoleInput['role'] },
+        }}
+      >
+        {({ register, handleSubmit }) => (
+          <Select
+            options={roleOptions}
+            registration={register('role', {
+              onChange: () => {
+                handleSubmit(submitRole)();
+              },
+            })}
+          />
+        )}
+      </Form>
+    </Authorization>
+  );
+};
