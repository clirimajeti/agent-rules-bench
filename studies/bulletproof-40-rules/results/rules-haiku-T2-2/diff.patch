+import { Select } from '@/components/ui/form';
+import { useUser } from '@/lib/auth';
+import { Authorization, POLICIES, ROLES } from '@/lib/authorization';
+import { User } from '@/types/api';
+
+import {
+  UpdateUserRoleInput,
+  useUpdateUserRole,
+} from '../api/update-user-role';
+
+const roleOptions: { label: string; value: UpdateUserRoleInput['role'] }[] = [
+  { label: 'Admin', value: ROLES.ADMIN },
+  { label: 'User', value: ROLES.USER },
+];
+
+type UpdateUserRoleProps = {
+  user: User;
+};
+
+export const UpdateUserRole = ({ user }: UpdateUserRoleProps) => {
+  const currentUser = useUser();
+  const updateUserRoleMutation = useUpdateUserRole();
+
+  return (
+    <Authorization
+      policyCheck={
+        currentUser.data
+          ? POLICIES['user:update-role'](currentUser.data, user)
+          : false
+      }
+      forbiddenFallback={<span>{user.role}</span>}
+    >
+      <Select
+        key={`${user.role}-${updateUserRoleMutation.status}`}
+        label="Role"
+        options={roleOptions}
+        defaultValue={user.role}
+        registration={{
+          name: 'role',
+          onChange: (event) =>
+            updateUserRoleMutation.mutate({
+              userId: user.id,
+              data: { role: event.target.value as UpdateUserRoleInput['role'] },
+            }),
+        }}
+      />
+    </Authorization>
+  );
+};
