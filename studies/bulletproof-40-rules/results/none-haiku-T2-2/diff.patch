+import { Form, Select } from '@/components/ui/form';
+import { useUser } from '@/lib/auth';
+import { ROLES } from '@/lib/authorization';
+import { User } from '@/types/api';
+
+import {
+  updateUserRoleInputSchema,
+  useUpdateUserRole,
+} from '../api/update-user-role';
+
+const roleOptions = Object.values(ROLES).map((role) => ({
+  label: role,
+  value: role,
+}));
+
+type UpdateUserRoleProps = {
+  id: string;
+  role: User['role'];
+};
+
+export const UpdateUserRole = ({ id, role }: UpdateUserRoleProps) => {
+  const user = useUser();
+  const updateUserRoleMutation = useUpdateUserRole();
+
+  return (
+    <Form
+      schema={updateUserRoleInputSchema}
+      options={{ values: { role } }}
+      className="space-y-0"
+      onSubmit={(data) => updateUserRoleMutation.mutate({ userId: id, data })}
+    >
+      {({ register, formState }) => {
+        const { onChange, ...roleRegistration } = register('role');
+
+        return (
+          <Select
+            label="Role"
+            className="mt-0 w-auto rounded-md py-1 pl-2 pr-8 text-sm"
+            error={formState.errors['role']}
+            options={roleOptions}
+            disabled={user.data?.id === id || updateUserRoleMutation.isPending}
+            registration={{
+              ...roleRegistration,
+              onChange: (event) => {
+                void onChange(event);
+                event.currentTarget.form?.requestSubmit();
+              },
+            }}
+          />
+        );
+      }}
+    </Form>
+  );
+};
