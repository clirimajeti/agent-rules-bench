+import { Form, Select } from '@/components/ui/form';
+import { useUser } from '@/lib/auth';
+import { ROLES } from '@/lib/authorization';
+import { User } from '@/types/api';
+
+import {
+  updateUserRoleInputSchema,
+  useUpdateUserRole,
+} from '../api/update-user-role';
+
+const roleOptions = [
+  { label: 'Admin', value: ROLES.ADMIN },
+  { label: 'User', value: ROLES.USER },
+];
+
+type UpdateUserRoleProps = {
+  id: string;
+  role: User['role'];
+};
+
+export const UpdateUserRole = ({ id, role }: UpdateUserRoleProps) => {
+  const user = useUser();
+  const updateUserRoleMutation = useUpdateUserRole();
+
+  // Admins cannot change their own role, so they cannot lock themselves out.
+  if (user.data?.id === id) {
+    return <span className="text-sm">{role}</span>;
+  }
+
+  return (
+    <Form
+      schema={updateUserRoleInputSchema}
+      options={{ defaultValues: { role: ROLES[role] } }}
+      onSubmit={(data) =>
+        updateUserRoleMutation.mutate({ userId: id, data })
+      }
+    >
+      {({ register }) => (
+        <Select
+          options={roleOptions}
+          registration={register('role', {
+            onChange: (event) => event.target.form?.requestSubmit(),
+          })}
+        />
+      )}
+    </Form>
+  );
+};
