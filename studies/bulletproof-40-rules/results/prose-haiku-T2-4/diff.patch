+import * as React from 'react';
+
+import { Select } from '@/components/ui/form';
+import { Authorization, ROLES } from '@/lib/authorization';
+import { User } from '@/types/api';
+
+import {
+  updateUserRoleInputSchema,
+  useUpdateUserRole,
+} from '../api/update-user-role';
+
+const roleOptions = [
+  { label: 'Admin', value: ROLES.ADMIN },
+  { label: 'User', value: ROLES.USER },
+];
+
+type UpdateUserRoleProps = {
+  user: User;
+};
+
+export const UpdateUserRole = ({ user }: UpdateUserRoleProps) => {
+  // Bumped when a change fails, so the uncontrolled select remounts
+  // and shows the role the server still has.
+  const [selectVersion, setSelectVersion] = React.useState(0);
+  const updateUserRoleMutation = useUpdateUserRole();
+
+  return (
+    <Authorization
+      allowedRoles={[ROLES.ADMIN]}
+      forbiddenFallback={<span>{user.role}</span>}
+    >
+      <Select
+        key={`${user.role}-${selectVersion}`}
+        options={roleOptions}
+        defaultValue={user.role}
+        registration={{
+          name: 'role',
+          onChange: (event: { target: { value: unknown } }) => {
+            const parsed = updateUserRoleInputSchema.safeParse({
+              role: event.target.value,
+            });
+            if (!parsed.success) return;
+
+            updateUserRoleMutation.mutate(
+              { userId: user.id, data: parsed.data },
+              {
+                onError: () => setSelectVersion((version) => version + 1),
+              },
+            );
+          },
+        }}
+      />
+    </Authorization>
+  );
+};
