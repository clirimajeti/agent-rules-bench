@@ -0,0 +1,19 @@
+import { User } from '@/types/api';
+import { toCsv } from '@/utils/csv';
+
+export const getUsersCsv = (users: User[]) =>
+  toCsv<User>(
+    [
+      {
+        header: 'Name',
+        value: (user) => `${user.firstName} ${user.lastName}`,
+      },
+      { header: 'Email', value: (user) => user.email },
+      { header: 'Role', value: (user) => user.role },
+      {
+        header: 'Joined',
+        value: (user) => new Date(user.createdAt).toISOString(),
+      },
+    ],
+    users,
+  );
diff --git a/apps/react-vite/src/utils/csv.ts b/apps/react-vite/src/utils/csv.ts
new file mode 100644
index 0000000..305a5ac
--- /dev/null
+++ b/apps/react-vite/src/utils/csv.ts
@@ -0,0 +1,44 @@
+export type CsvColumn<Row> = {
+  header: string;
+  value: (row: Row) => string | number | null | undefined;
+};
+
+// Cells that start with these characters are evaluated as formulas by
+// spreadsheet apps, so they are prefixed with an apostrophe to stay plain text.
+const FORMULA_PREFIXES = ['=', '+', '-', '@', '\t', '\r'];
+
+const escapeCsvCell = (value: string | number | null | undefined) => {
+  let text = value == null ? '' : String(value);
+
+  if (FORMULA_PREFIXES.some((prefix) => text.startsWith(prefix))) {
+    text = `'${text}`;
+  }
+
+  return `"${text.replace(/"/g, '""')}"`;
+};
+
+export const toCsv = <Row>(columns: CsvColumn<Row>[], rows: Row[]) => {
+  const lines = [
+    columns.map(({ header }) => escapeCsvCell(header)),
+    ...rows.map((row) =>
+      columns.map(({ value }) => escapeCsvCell(value(row))),
+    ),
+  ];
+
+  return lines.map((line) => line.join(',')).join('\r\n');
+};
+
+export const downloadCsv = (filename: string, csv: string) => {
+  // The UTF-8 byte order mark makes spreadsheet apps read non-ASCII names correctly.
+  const blob = new Blob(['﻿', csv], { type: 'text/csv;charset=utf-8' });
+  const url = URL.createObjectURL(blob);
+
+  const link = document.createElement('a');
+  link.href = url;
+  link.download = filename;
+  document.body.appendChild(link);
+  link.click();
+  link.remove();
+
+  setTimeout(() => URL.revokeObjectURL(url), 0);
+};
