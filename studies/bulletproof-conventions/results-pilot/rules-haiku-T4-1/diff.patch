+import { Input, Select } from '@/components/ui/form';
+import { ROLES } from '@/lib/authorization';
+
+import { RoleFilter } from '../utils/filter-users';
+
+const ROLE_FILTER_OPTIONS: { label: string; value: RoleFilter }[] = [
+  { label: 'All roles', value: 'ALL' },
+  { label: 'Admin', value: ROLES.ADMIN },
+  { label: 'User', value: ROLES.USER },
+];
+
+export type UsersFiltersProps = {
+  search: string;
+  role: RoleFilter;
+  onSearchChange: (search: string) => void;
+  onRoleChange: (role: RoleFilter) => void;
+};
+
+export const UsersFilters = ({
+  search,
+  role,
+  onSearchChange,
+  onRoleChange,
+}: UsersFiltersProps) => {
+  return (
+    <div className="flex flex-col gap-4 sm:flex-row">
+      <div className="sm:w-72">
+        <Input
+          label="Search by name or email"
+          type="search"
+          placeholder="Jane Doe or jane@example.com"
+          value={search}
+          registration={{
+            onChange: (event) => onSearchChange(event.target.value),
+          }}
+        />
+      </div>
+      <div className="sm:w-48">
+        <Select
+          // Remount when the role changes so the uncontrolled select reflects URL-driven updates.
+          key={role}
+          label="Role"
+          defaultValue={role}
+          options={ROLE_FILTER_OPTIONS}
+          registration={{
+            onChange: (event) => onRoleChange(event.target.value as RoleFilter),
+          }}
+        />
+      </div>
+    </div>
+  );
+};
