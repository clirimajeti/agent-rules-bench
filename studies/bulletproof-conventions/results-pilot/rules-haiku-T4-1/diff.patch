index 0000000..aa96ad2
--- /dev/null
+++ b/apps/react-vite/src/features/users/utils/filter-users.ts
@@ -0,0 +1,34 @@
+import { ROLES } from '@/lib/authorization';
+import { User } from '@/types/api';
+
+export const ROLE_FILTERS = ['ALL', ROLES.ADMIN, ROLES.USER] as const;
+
+export type RoleFilter = (typeof ROLE_FILTERS)[number];
+
+export const parseRoleFilter = (value: string | null): RoleFilter =>
+  ROLE_FILTERS.find((role) => role === value) ?? 'ALL';
+
+type UserFilters = {
+  role: RoleFilter;
+  search: string;
+};
+
+export const filterUsers = (users: User[], { role, search }: UserFilters) => {
+  const query = search.trim().toLowerCase();
+  const usersInRole =
+    role === 'ALL'
+      ? users
+      : (Object.groupBy(users, (user) => user.role)[role] ?? []);
+
+  return usersInRole.filter((user) => {
+    if (!query) {
+      return true;
+    }
+
+    const fullName = `${user.firstName} ${user.lastName}`.toLowerCase();
+
+    return (
+      fullName.includes(query) || user.email.toLowerCase().includes(query)
+    );
+  });
+};
diff --git a/apps/react-vite/src/features/users/utils/users-csv.ts b/apps/react-vite/src/features/users/utils/users-csv.ts
