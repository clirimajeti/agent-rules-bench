f.write('              <div className="mt-1 max-w-2xl text-sm text-gray-500">\n')
f.write('                <MDPreview value={discussion.body} />\n')
f.write('              </div>\n')
f.write('            </div>\n')
f.write('          </div>\n')
f.write('        </div>\n')
f.write('      </div>\n')
f.write('      <div className="mt-4 flex justify-end">\n')
f.write('        <Authorization allowedRoles={[ROLES.ADMIN]}>\n')
f.write('          <PinDiscussionButton discussionId={discussionId} isPinned={discussion.pinned} />\n')
f.write('        </Authorization>\n')
f.write('      </div>\n')
f.write('    </div>\n')
f.write('  );\n')
f.write('};\n\n')
f.write('const PinDiscussionButton = ({ discussionId, isPinned }: { discussionId: string; isPinned: boolean }) => {\n')
f.write('  const pinDiscussionMutation = usePinDiscussion({});\n\n')
f.write('  return (\n')
f.write('    <Button\n')
f.write('      variant="outline"\n')
f.write('      isLoading={pinDiscussionMutation.isPending}\n')
f.write('      icon={isPinned ? <PinOff className="size-4" /> : <Pin className="size-4" />}\n')
f.write('      onClick={() => pinDiscussionMutation.mutate({ discussionId })}\n')
f.write('    >\n')
f.write('      {isPinned ? "Unpin" : "Pin"}\n')
f.write('    </Button>\n')
f.write('  );\n')
f.write('};\n')
f.close()
print('OK')
EOF
