+import { User } from '@/types/api';
+import { CsvCell, downloadCsv } from '@/utils/csv';
+import { formatDate } from '@/utils/format';
+
+const CSV_HEADER: CsvCell[] = ['Name', 'Email', 'Role', 'Joined'];
+
+export const usersToCsvRows = (users: User[]): CsvCell[][] => [
+  CSV_HEADER,
+  ...users.map((user) => [
+    `${user.firstName} ${user.lastName}`,
+    user.email,
+    user.role,
+    formatDate(user.createdAt),
+  ]),
+];
+
+export const exportUsersCsv = (users: User[]) => {
+  downloadCsv('users.csv', usersToCsvRows(users));
+};
