--- /dev/null
+++ b/apps/react-vite/src/utils/csv.ts
@@ -0,0 +1,44 @@
+export type CsvCell = string | number | boolean | null | undefined;
+
+// Spreadsheet apps execute cells that start with these characters as formulas.
+// Prefixing them with a single quote neutralizes CSV/formula injection.
+// See https://owasp.org/www-community/attacks/CSV_Injection
+const FORMULA_TRIGGER = /^[=+\-@\t\r]/;
+
+const escapeCell = (cell: CsvCell): string => {
+  if (cell === null || cell === undefined) return '';
+
+  let value = String(cell);
+
+  if (typeof cell === 'string' && FORMULA_TRIGGER.test(value)) {
+    value = `'${value}`;
+  }
+
+  if (/[",\r\n]/.test(value)) {
+    value = `"${value.replace(/"/g, '""')}"`;
+  }
+
+  return value;
+};
+
+// Serializes rows to RFC 4180 CSV.
+export const toCsv = (rows: CsvCell[][]): string =>
+  rows.map((row) => row.map(escapeCell).join(',')).join('\r\n');
+
+export const downloadCsv = (filename: string, rows: CsvCell[][]) => {
+  // The BOM makes Excel detect UTF-8 so accented names render correctly.
+  const blob = new Blob(['﻿', toCsv(rows)], {
+    type: 'text/csv;charset=utf-8',
+  });
+  const url = URL.createObjectURL(blob);
+
+  const link = document.createElement('a');
+  link.href = url;
+  link.download = filename;
+  link.style.display = 'none';
+  document.body.appendChild(link);
+  link.click();
+  link.remove();
+
+  URL.revokeObjectURL(url);
+};
