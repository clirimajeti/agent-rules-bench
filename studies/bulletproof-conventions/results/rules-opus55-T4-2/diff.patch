index 0000000..9d6c570
--- /dev/null
+++ b/apps/react-vite/src/features/users/hooks/use-users-filters.ts
@@ -0,0 +1,34 @@
+import { useSearchParams } from 'react-router';
+
+import { UsersFilters, parseUsersFilters } from '../api/get-users';
+
+export type UsersFilterKey = keyof UsersFilters;
+
+// Filters live in the URL so they survive reloads and can be shared as links.
+export const useUsersFilters = () => {
+  const [searchParams, setSearchParams] = useSearchParams();
+
+  const filters = parseUsersFilters(searchParams);
+
+  // The raw value keeps the search field in sync with what the user typed,
+  // including leading or trailing spaces that the parsed filter trims away.
+  const searchInput = searchParams.get('search') ?? '';
+
+  const setFilter = (key: UsersFilterKey, value: string) => {
+    setSearchParams(
+      (prev) => {
+        const next = new URLSearchParams(prev);
+        if (value) {
+          next.set(key, value);
+        } else {
+          next.delete(key);
+        }
+        return next;
+      },
+      // Avoid one history entry per keystroke.
+      { replace: true },
+    );
+  };
+
+  return { filters, searchInput, setFilter };
+};
