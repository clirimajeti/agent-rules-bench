@@ -0,0 +1,26 @@
+import { toCsv } from '../csv';
+
+test('should join cells with commas and rows with CRLF', () => {
+  expect(
+    toCsv([
+      ['a', 'b'],
+      ['c', 'd'],
+    ]),
+  ).toBe('a,b\r\nc,d');
+});
+
+test('should quote cells that contain commas, quotes or line breaks', () => {
+  expect(toCsv([['a,b', 'say "hi"', 'line\nbreak']])).toBe(
+    '"a,b","say ""hi""","line\nbreak"',
+  );
+});
+
+test('should neutralize cells that a spreadsheet would run as formulas', () => {
+  expect(toCsv([['=1+1', '+1', '-1', '@SUM(A1)']])).toBe(
+    "'=1+1,'+1,'-1,'@SUM(A1)",
+  );
+});
+
+test('should keep numbers as they are and write empty cells for null or undefined', () => {
+  expect(toCsv([[-1, 42, null, undefined, true]])).toBe('-1,42,,,true');
+});
diff --git a/apps/react-vite/src/utils/csv.ts b/apps/react-vite/src/utils/csv.ts
