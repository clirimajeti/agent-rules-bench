+import type { Mock } from 'vitest';
+
+import {
+  createUser,
+  renderApp,
+  screen,
+  userEvent,
+  waitFor,
+} from '@/testing/test-utils';
+
+import { default as UsersRoute } from '../users';
+
+const readBlob = (blob: Blob) =>
+  new Promise<string>((resolve, reject) => {
+    const reader = new FileReader();
+    reader.onload = () => resolve(reader.result as string);
+    reader.onerror = () => reject(reader.error);
+    reader.readAsText(blob);
+  });
+
+beforeAll(() => {
+  vi.spyOn(console, 'error').mockImplementation(() => {});
+});
+
+afterAll(() => {
+  (console.error as Mock).mockRestore();
+});
+
+test(
+  'should filter users by role and search, and export the shown users',
+  { timeout: 15000 },
+  async () => {
+    const admin = await createUser({ role: 'ADMIN' });
+    const member = await createUser({ role: 'USER', teamId: admin.teamId });
+
+    await renderApp(<UsersRoute />, { user: admin });
+
+    expect(
+      await screen.findByRole('cell', { name: admin.email }),
+    ).toBeInTheDocument();
+    expect(screen.getByRole('cell', { name: member.email })).toBeInTheDocument();
+
+    // Filter by role
+    await userEvent.selectOptions(
+      screen.getByRole('combobox', { name: /role/i }),
+      'USER',
+    );
+
+    await waitFor(() =>
+      expect(
+        screen.queryByRole('cell', { name: admin.email }),
+      ).not.toBeInTheDocument(),
+    );
+    expect(screen.getByRole('cell', { name: member.email })).toBeInTheDocument();
+
+    // Search by email, across all roles
+    await userEvent.selectOptions(
+      screen.getByRole('combobox', { name: /role/i }),
+      '',
+    );
+    await userEvent.type(
+      screen.getByRole('searchbox', { name: /search/i }),
+      admin.email,
+    );
+
+    await waitFor(() =>
+      expect(
+        screen.queryByRole('cell', { name: member.email }),
+      ).not.toBeInTheDocument(),
+    );
+    expect(screen.getByRole('cell', { name: admin.email })).toBeInTheDocument();
+
+    // Export only what is shown
+    // jsdom does not implement object URLs
+    const createObjectURL = vi.fn((_blob: Blob) => 'blob:users');
+    const revokeObjectURL = vi.fn();
+    URL.createObjectURL = createObjectURL;
+    URL.revokeObjectURL = revokeObjectURL;
+
+    await userEvent.click(screen.getByRole('button', { name: /export csv/i }));
+
+    expect(createObjectURL).toHaveBeenCalledTimes(1);
+    const csv = await readBlob(createObjectURL.mock.calls[0][0]);
+
+    expect(csv).toContain('Name,Email,Role,Joined');
+    expect(csv).toContain(admin.email);
+    expect(csv).not.toContain(member.email);
+    expect(revokeObjectURL).toHaveBeenCalledWith('blob:users');
+  },
+);
