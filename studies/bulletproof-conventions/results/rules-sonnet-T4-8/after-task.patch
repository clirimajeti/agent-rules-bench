diff --git a/apps/react-vite/src/features/users/utils/filter-users.ts b/apps/react-vite/src/features/users/utils/filter-users.ts
new file mode 100644
index 0000000..c2429e8
--- /dev/null
+++ b/apps/react-vite/src/features/users/utils/filter-users.ts
@@ -0,0 +1,17 @@
+import { User } from '@/types/api';
+
+export type RoleFilter = User['role'] | '';
+
+export const filterUsers = (
+  users: User[],
+  { role, search }: { role: RoleFilter; search: string },
+) => {
+  const query = search.trim().toLowerCase();
+
+  return users.filter((user) => {
+    if (role && user.role !== role) return false;
+    if (!query) return true;
+    const name = `${user.firstName} ${user.lastName}`.toLowerCase();
+    return name.includes(query) || user.email.toLowerCase().includes(query);
+  });
+};
diff --git a/apps/react-vite/src/features/users/utils/users-csv.ts b/apps/react-vite/src/features/users/utils/users-csv.ts
new file mode 100644
index 0000000..f705e57
--- /dev/null
+++ b/apps/react-vite/src/features/users/utils/users-csv.ts
@@ -0,0 +1,32 @@
+import { User } from '@/types/api';
+
+const HEADERS = ['Name', 'Email', 'Role', 'Joined'];
+
+// Prefix values that spreadsheets could interpret as formulas.
+const escapeCell = (value: string) => {
+  const safe = /^[=+\-@\t\r]/.test(value) ? `'${value}` : value;
+  return `"${safe.replace(/"/g, '""')}"`;
+};
+
+export const buildUsersCsv = (users: User[]) => {
+  const rows = users.map((user) => [
+    `${user.firstName} ${user.lastName}`.trim(),
+    user.email,
+    user.role,
+    new Date(user.createdAt).toISOString(),
+  ]);
+
+  return [HEADERS, ...rows]
+    .map((row) => row.map(escapeCell).join(','))
+    .join('\r\n');
+};
+
+export const downloadCsv = (filename: string, content: string) => {
+  const blob = new Blob([content], { type: 'text/csv;charset=utf-8;' });
+  const url = URL.createObjectURL(blob);
+  const link = document.createElement('a');
+  link.href = url;
+  link.download = filename;
+  link.click();
+  URL.revokeObjectURL(url);
+};
