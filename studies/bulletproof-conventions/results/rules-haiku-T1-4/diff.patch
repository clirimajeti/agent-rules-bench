diff --git a/apps/react-vite/src/features/discussions/components/pin-discussion.tsx b/apps/react-vite/src/features/discussions/components/pin-discussion.tsx
new file mode 100644
index 0000000..74d089c
--- /dev/null
+++ b/apps/react-vite/src/features/discussions/components/pin-discussion.tsx
@@ -0,0 +1,34 @@
+import { Pin, PinOff } from 'lucide-react';
+
+import { Button } from '@/components/ui/button';
+import { Authorization, ROLES } from '@/lib/authorization';
+
+import { usePinDiscussion } from '../api/pin-discussion';
+
+type PinDiscussionProps = {
+  discussionId: string;
+  pinned: boolean;
+};
+
+export const PinDiscussion = ({ discussionId, pinned }: PinDiscussionProps) => {
+  const pinDiscussionMutation = usePinDiscussion();
+
+  return (
+    <Authorization allowedRoles={[ROLES.ADMIN]}>
+      <Button
+        size="sm"
+        variant="outline"
+        type="button"
+        isLoading={pinDiscussionMutation.isPending}
+        icon={
+          pinned ? <PinOff className="size-4" /> : <Pin className="size-4" />
+        }
+        onClick={() =>
+          pinDiscussionMutation.mutate({ discussionId, pinned: !pinned })
+        }
+      >
+        {pinned ? 'Unpin Discussion' : 'Pin Discussion'}
+      </Button>
+    </Authorization>
+  );
+};
