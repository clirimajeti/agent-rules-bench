index 0000000..f661154
--- /dev/null
+++ b/apps/react-vite/src/features/users/api/export-users.ts
@@ -0,0 +1,27 @@
+import { User } from '@/types/api';
+
+export const downloadUsersCsv = (users: User[]) => {
+  const header = 'Name,Email,Role,Joined\n';
+  const rows = users
+    .map((user) => {
+      const name = `"${user.firstName} ${user.lastName}"`;
+      const email = `"${user.email}"`;
+      const role = user.role;
+      const joined = `"${new Date(user.createdAt).toLocaleDateString('en-GB', {
+        day: '2-digit',
+        month: '2-digit',
+        year: 'numeric',
+      })}"`;
+      return `${name},${email},${role},${joined}`;
+    })
+    .join('\n');
+
+  const csvContent = `${header}${rows}`;
+  const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
+  const url = URL.createObjectURL(blob);
+  const link = document.createElement('a');
+  link.href = url;
+  link.download = 'users.csv';
+  link.click();
+  URL.revokeObjectURL(url);
+};
