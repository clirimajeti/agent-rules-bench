@@ -1,9 +1,33 @@
 import { queryOptions, useQuery } from '@tanstack/react-query';
+import { z } from 'zod';
 
 import { api } from '@/lib/api-client';
+import { ROLES, hasRole } from '@/lib/authorization';
 import { QueryConfig } from '@/lib/react-query';
 import { User } from '@/types/api';
 
+export const usersFilterInputSchema = z.object({
+  search: z.string(),
+  // An empty string means "all roles".
+  role: z.union([z.nativeEnum(ROLES), z.literal('')]),
+});
+
+export type UsersFilterInput = z.infer<typeof usersFilterInputSchema>;
+
+export const filterUsers = (users: User[], filters: UsersFilterInput) => {
+  const search = filters.search.trim().toLowerCase();
+
+  return users.filter((user) => {
+    if (filters.role && !hasRole(user, [filters.role])) return false;
+    if (!search) return true;
+
+    const name = `${user.firstName} ${user.lastName}`.toLowerCase();
+    return (
+      name.includes(search) || user.email.toLowerCase().includes(search)
+    );
+  });
+};
+
 export const getUsers = (): Promise<{ data: User[] }> => {
   return api.get(`/users`);
 };
