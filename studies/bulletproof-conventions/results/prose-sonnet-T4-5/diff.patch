diff --git a/apps/react-vite/src/utils/csv.ts b/apps/react-vite/src/utils/csv.ts
new file mode 100644
index 0000000..8fae215
--- /dev/null
+++ b/apps/react-vite/src/utils/csv.ts
@@ -0,0 +1,22 @@
+const escapeCell = (value: string) => {
+  // Prefix cells that spreadsheets could read as formulas.
+  const safe = /^[=+\-@\t\r]/.test(value) ? `'${value}` : value;
+
+  return `"${safe.replace(/"/g, '""')}"`;
+};
+
+export const toCsv = (header: string[], rows: string[][]) =>
+  [header, ...rows].map((row) => row.map(escapeCell).join(',')).join('\r\n');
+
+export const downloadCsv = (filename: string, content: string) => {
+  const blob = new Blob([content], { type: 'text/csv;charset=utf-8;' });
+  const url = URL.createObjectURL(blob);
+  const link = document.createElement('a');
+
+  link.href = url;
+  link.download = filename;
+  document.body.appendChild(link);
+  link.click();
+  link.remove();
+  URL.revokeObjectURL(url);
+};
