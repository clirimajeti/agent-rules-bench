diff --git a/apps/react-vite/src/features/users/utils/export-users-csv.ts b/apps/react-vite/src/features/users/utils/export-users-csv.ts
new file mode 100644
index 0000000..cfdd624
--- /dev/null
+++ b/apps/react-vite/src/features/users/utils/export-users-csv.ts
@@ -0,0 +1,38 @@
+import { User } from '@/types/api';
+import { formatDate } from '@/utils/format';
+
+const FORMULA_TRIGGER = /^[=+\-@\t\r]/;
+
+const escapeCsvValue = (value: string) => {
+  // Prefix formula triggers so spreadsheet apps do not run user supplied text.
+  const safe = FORMULA_TRIGGER.test(value) ? `'${value}` : value;
+  return `"${safe.replace(/"/g, '""')}"`;
+};
+
+export const buildUsersCsv = (users: User[]) => {
+  const rows = [
+    ['Name', 'Email', 'Role', 'Joined'],
+    ...users.map((user) => [
+      `${user.firstName} ${user.lastName}`.trim(),
+      user.email,
+      user.role,
+      formatDate(user.createdAt),
+    ]),
+  ];
+
+  return rows.map((row) => row.map(escapeCsvValue).join(',')).join('\r\n');
+};
+
+export const downloadUsersCsv = (users: User[], fileName = 'users.csv') => {
+  const blob = new Blob([buildUsersCsv(users)], {
+    type: 'text/csv;charset=utf-8;',
+  });
+  const url = URL.createObjectURL(blob);
+  const link = document.createElement('a');
+  link.href = url;
+  link.download = fileName;
+  document.body.appendChild(link);
+  link.click();
+  document.body.removeChild(link);
+  URL.revokeObjectURL(url);
+};
