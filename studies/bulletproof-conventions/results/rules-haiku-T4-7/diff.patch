diff --git a/apps/react-vite/src/features/users/utils/export-users-csv.ts b/apps/react-vite/src/features/users/utils/export-users-csv.ts
new file mode 100644
index 0000000..bfef612
--- /dev/null
+++ b/apps/react-vite/src/features/users/utils/export-users-csv.ts
@@ -0,0 +1,38 @@
+import { User } from '@/types/api';
+import { formatDate } from '@/utils/format';
+
+const HEADERS = ['Name', 'Email', 'Role', 'Joined'];
+
+const escapeCsvValue = (value: string) => {
+  // Prefix values that spreadsheet apps would evaluate as formulas (CSV injection).
+  const safe = /^[=+\-@\t\r]/.test(value) ? `'${value}` : value;
+  return `"${safe.replace(/"/g, '""')}"`;
+};
+
+const toCsvRow = (values: string[]) => values.map(escapeCsvValue).join(',');
+
+export const exportUsersToCsv = (users: User[]) => {
+  const rows = users.map((user) =>
+    toCsvRow([
+      `${user.firstName} ${user.lastName}`,
+      user.email,
+      user.role,
+      formatDate(user.createdAt),
+    ]),
+  );
+
+  // The UTF-8 BOM lets spreadsheet apps detect the encoding of non-ASCII names.
+  const csv = `﻿${[toCsvRow(HEADERS), ...rows].join('\r\n')}`;
+  const url = URL.createObjectURL(
+    new Blob([csv], { type: 'text/csv;charset=utf-8' }),
+  );
+
+  const link = document.createElement('a');
+  link.href = url;
+  link.download = 'users.csv';
+  document.body.appendChild(link);
+  link.click();
+  link.remove();
+
+  setTimeout(() => URL.revokeObjectURL(url), 0);
+};
diff --git a/apps/react-vite/src/features/users/utils/filter-users.ts b/apps/react-vite/src/features/users/utils/filter-users.ts
new file mode 100644
index 0000000..7b502e9
--- /dev/null
+++ b/apps/react-vite/src/features/users/utils/filter-users.ts
@@ -0,0 +1,15 @@
+import { User } from '@/types/api';
+
+import { UsersFilters } from '../api/get-users';
+
+export const filterUsers = (users: User[], { search, role }: UsersFilters) => {
+  const term = search.trim().toLowerCase();
+
+  return users.filter((user) => {
+    if (role !== 'ALL' && user.role !== role) return false;
+    if (!term) return true;
+
+    const name = `${user.firstName} ${user.lastName}`.toLowerCase();
+    return name.includes(term) || user.email.toLowerCase().includes(term);
+  });
+};
