diff --git a/apps/react-vite/src/utils/csv.ts b/apps/react-vite/src/utils/csv.ts
new file mode 100644
index 0000000..a75cca4
--- /dev/null
+++ b/apps/react-vite/src/utils/csv.ts
@@ -0,0 +1,30 @@
+const FORMULA_PREFIXES = ['=', '+', '-', '@', '\t', '\r'];
+
+// Cells that start with a spreadsheet formula character are prefixed with a
+// quote so that Excel and similar tools show them as text instead of running them.
+const escapeCsvCell = (value: string) => {
+  const isFormula = FORMULA_PREFIXES.some((prefix) => value.startsWith(prefix));
+  const safeValue = isFormula ? `'${value}` : value;
+  return `"${safeValue.replace(/"/g, '""')}"`;
+};
+
+export const toCsv = (headers: string[], rows: string[][]) => {
+  return [headers, ...rows]
+    .map((row) => row.map(escapeCsvCell).join(','))
+    .join('\r\n');
+};
+
+export const downloadCsv = (filename: string, csv: string) => {
+  // The byte order mark tells spreadsheet apps that the file is UTF-8.
+  const blob = new Blob(['﻿' + csv], {
+    type: 'text/csv;charset=utf-8',
+  });
+  const url = URL.createObjectURL(blob);
+  const link = document.createElement('a');
+  link.href = url;
+  link.download = filename;
+  document.body.appendChild(link);
+  link.click();
+  link.remove();
+  URL.revokeObjectURL(url);
+};
