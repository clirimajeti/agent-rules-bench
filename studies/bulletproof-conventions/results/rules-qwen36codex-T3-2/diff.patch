@@ -0,0 +1,66 @@
+import { Lock } from 'lucide-react';
+
+import { Button } from '@/components/ui/button';
+import { Form, FormDrawer, Input } from '@/components/ui/form';
+
+import {
+  changePasswordInputSchema,
+  useChangePassword,
+} from '../api/change-password';
+
+export const ChangePasswordForm = () => {
+  const changePasswordMutation = useChangePassword();
+
+  return (
+    <FormDrawer
+      isDone={changePasswordMutation.isSuccess}
+      triggerButton={
+        <Button icon={<Lock className="size-4" />} size="sm">
+          Change Password
+        </Button>
+      }
+      title="Change Password"
+      submitButton={
+        <Button
+          form="change-password"
+          type="submit"
+          size="sm"
+          isLoading={changePasswordMutation.isPending}
+        >
+          Submit
+        </Button>
+      }
+    >
+      <Form
+        id="change-password"
+        onSubmit={(values) => {
+          changePasswordMutation.mutate({ data: values });
+        }}
+        schema={changePasswordInputSchema}
+      >
+        {({ register, formState }) => (
+          <>
+            <Input
+              label="Current Password"
+              type="password"
+              error={formState.errors['currentPassword']}
+              registration={register('currentPassword')}
+            />
+            <Input
+              label="New Password"
+              type="password"
+              error={formState.errors['newPassword']}
+              registration={register('newPassword')}
+            />
+            <Input
+              label="Confirm New Password"
+              type="password"
+              error={formState.errors['confirmPassword']}
+              registration={register('confirmPassword')}
+            />
+          </>
+        )}
+      </Form>
+    </FormDrawer>
+  );
+};
