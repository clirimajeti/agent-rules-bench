+const getCommentStats = (discussionId: string) => {
+  const comments = db.comment.findMany({
+    where: {
+      discussionId: {
+        equals: discussionId,
+      },
+    },
+  });
+  return {
+    commentsCount: comments.length,
+    lastCommentAt: comments.reduce<number | null>(
+      (latest, { createdAt }) =>
+        latest === null || createdAt > latest ? createdAt : latest,
+      null,
+    ),
+  };
+};
