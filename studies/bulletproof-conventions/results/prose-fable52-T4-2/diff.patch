diff --git a/apps/react-vite/src/utils/__tests__/csv.test.ts b/apps/react-vite/src/utils/__tests__/csv.test.ts
new file mode 100644
index 0000000..68a4df3
--- /dev/null
+++ b/apps/react-vite/src/utils/__tests__/csv.test.ts
@@ -0,0 +1,20 @@
+import { toCsv } from '../csv';
+
+test('should join cells with commas and rows with CRLF', () => {
+  expect(
+    toCsv([
+      ['Name', 'Email'],
+      ['Jane Doe', 'jane@example.com'],
+    ]),
+  ).toBe('Name,Email\r\nJane Doe,jane@example.com');
+});
+
+test('should quote cells that contain commas, quotes or line breaks', () => {
+  expect(toCsv([['May 1, 2024', 'say "hi"', 'a\nb']])).toBe(
+    '"May 1, 2024","say ""hi""","a\nb"',
+  );
+});
+
+test('should neutralize cells that start with a formula character', () => {
+  expect(toCsv([['=SUM(A1:A2)', '@cmd']])).toBe("'=SUM(A1:A2),'@cmd");
+});
diff --git a/apps/react-vite/src/utils/csv.ts b/apps/react-vite/src/utils/csv.ts
new file mode 100644
index 0000000..50c089c
--- /dev/null
+++ b/apps/react-vite/src/utils/csv.ts
@@ -0,0 +1,28 @@
+const FORMULA_PREFIX = /^[=+\-@\t\r]/;
+
+const escapeCell = (value: string) => {
+  // Stop spreadsheet applications from reading user-supplied text as a formula.
+  const safeValue = FORMULA_PREFIX.test(value) ? `'${value}` : value;
+
+  return /[",\r\n]/.test(safeValue)
+    ? `"${safeValue.replace(/"/g, '""')}"`
+    : safeValue;
+};
+
+export const toCsv = (rows: string[][]) =>
+  rows.map((row) => row.map(escapeCell).join(',')).join('\r\n');
+
+export const downloadCsv = (filename: string, csv: string) => {
+  // The byte order mark makes spreadsheet applications read the file as UTF-8.
+  const blob = new Blob(['﻿', csv], { type: 'text/csv;charset=utf-8' });
+  const url = URL.createObjectURL(blob);
+
+  const link = document.createElement('a');
+  link.href = url;
+  link.download = filename;
+  document.body.appendChild(link);
+  link.click();
+  link.remove();
+
+  URL.revokeObjectURL(url);
+};
