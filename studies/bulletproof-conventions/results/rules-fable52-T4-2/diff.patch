+import { Input, Select } from '@/components/ui/form';
+import { ROLES } from '@/lib/authorization';
+
+import { GetUsersParams } from '../api/get-users';
+
+export type UsersFiltersValue = {
+  search: string;
+  // No role means all roles.
+  role: GetUsersParams['role'];
+};
+
+const ALL_ROLES = '';
+
+const roleOptions: {
+  label: string;
+  value: string;
+  role: UsersFiltersValue['role'];
+}[] = [
+  { label: 'All roles', value: ALL_ROLES, role: undefined },
+  { label: 'Admin', value: ROLES.ADMIN, role: ROLES.ADMIN },
+  { label: 'User', value: ROLES.USER, role: ROLES.USER },
+];
+
+type UsersFiltersProps = {
+  filters: UsersFiltersValue;
+  onChange: (filters: UsersFiltersValue) => void;
+};
+
+export const UsersFilters = ({ filters, onChange }: UsersFiltersProps) => {
+  return (
+    <div className="flex flex-wrap items-end gap-4">
+      <div className="w-full sm:w-72">
+        <Input
+          type="search"
+          label="Search"
+          placeholder="Name or email"
+          value={filters.search}
+          onChange={(event) =>
+            onChange({ ...filters, search: event.target.value })
+          }
+          registration={{}}
+        />
+      </div>
+      <div className="w-full sm:w-48">
+        <Select
+          label="Role"
+          options={roleOptions.map(({ label, value }) => ({ label, value }))}
+          defaultValue={filters.role ?? ALL_ROLES}
+          registration={{
+            name: 'role',
+            onChange: async (event) => {
+              const selected = roleOptions.find(
+                ({ value }) => value === event.target.value,
+              );
+              onChange({ ...filters, role: selected?.role });
+            },
+          }}
+        />
+      </div>
+    </div>
+  );
+};
