+import { ROLES } from '@/lib/authorization';
+import {
+  createUser,
+  renderApp,
+  screen,
+  userEvent,
+  waitFor,
+} from '@/testing/test-utils';
+
+import { default as UsersRoute } from '../users';
+
+const teamId = 'team-1';
+
+const renderUsers = async () => {
+  const admin = await createUser({
+    teamId,
+    role: ROLES.ADMIN,
+    firstName: 'Alice',
+    lastName: 'Anderson',
+    email: 'alice@example.com',
+  });
+  await createUser({
+    teamId,
+    role: ROLES.USER,
+    firstName: 'Bob',
+    lastName: 'Brown',
+    email: 'bob@example.com',
+  });
+  await createUser({
+    teamId,
+    role: ROLES.USER,
+    firstName: 'Carol',
+    lastName: 'Clark',
+    email: 'carol@sample.org',
+  });
+
+  await renderApp(<UsersRoute />, { user: admin });
+
+  expect(
+    await screen.findByRole('cell', { name: 'alice@example.com' }),
+  ).toBeInTheDocument();
+};
+
+const queryEmailCell = (email: string) =>
+  screen.queryByRole('cell', { name: email });
+
+test('should search users by name or email', async () => {
+  await renderUsers();
+
+  const search = screen.getByLabelText(/search/i);
+
+  await userEvent.type(search, 'bob br');
+
+  expect(queryEmailCell('bob@example.com')).toBeInTheDocument();
+  expect(queryEmailCell('alice@example.com')).not.toBeInTheDocument();
+  expect(queryEmailCell('carol@sample.org')).not.toBeInTheDocument();
+
+  await userEvent.clear(search);
+  await userEvent.type(search, 'SAMPLE.ORG');
+
+  expect(queryEmailCell('carol@sample.org')).toBeInTheDocument();
+  expect(queryEmailCell('bob@example.com')).not.toBeInTheDocument();
+
+  await userEvent.clear(search);
+  await userEvent.type(search, 'nobody');
+
+  expect(screen.getByText(/no entries/i)).toBeInTheDocument();
+  expect(screen.getByRole('button', { name: /export csv/i })).toBeDisabled();
+});
+
+test('should filter users by role', async () => {
+  await renderUsers();
+
+  await userEvent.selectOptions(screen.getByLabelText(/role/i), ROLES.USER);
+
+  await waitFor(() =>
+    expect(queryEmailCell('alice@example.com')).not.toBeInTheDocument(),
+  );
+  expect(queryEmailCell('bob@example.com')).toBeInTheDocument();
+  expect(queryEmailCell('carol@sample.org')).toBeInTheDocument();
+});
+
+test('should export the users currently shown as CSV', async () => {
+  // jsdom does not implement object URLs.
+  const createObjectURL = vi.fn((blob: Blob) => `blob:${blob.size}`);
+  Object.assign(URL, { createObjectURL, revokeObjectURL: vi.fn() });
+  const click = vi
+    .spyOn(HTMLAnchorElement.prototype, 'click')
+    .mockImplementation(() => {});
+
+  try {
+    await renderUsers();
+
+    await userEvent.type(screen.getByLabelText(/search/i), 'bob');
+    await userEvent.click(screen.getByRole('button', { name: /export csv/i }));
+
+    expect(click).toHaveBeenCalledTimes(1);
+    expect(createObjectURL).toHaveBeenCalledTimes(1);
+    expect(createObjectURL.mock.calls[0][0].type).toBe(
+      'text/csv;charset=utf-8',
+    );
+  } finally {
+    click.mockRestore();
+  }
+});
