@@ -0,0 +1,36 @@
+import { toCsv } from '../csv';
+
+type Row = { name: string; note: string };
+
+const columns = [
+  { header: 'Name', value: (row: Row) => row.name },
+  { header: 'Note', value: (row: Row) => row.note },
+];
+
+test('should render a header line and one line per row', () => {
+  const csv = toCsv(
+    [
+      { name: 'Jane', note: 'first' },
+      { name: 'John', note: 'second' },
+    ],
+    columns,
+  );
+
+  expect(csv).toBe('Name,Note\r\nJane,first\r\nJohn,second');
+});
+
+test('should render only the header line when there are no rows', () => {
+  expect(toCsv([], columns)).toBe('Name,Note');
+});
+
+test('should quote cells that contain commas, quotes or line breaks', () => {
+  const csv = toCsv([{ name: 'Doe, Jane', note: 'said "hi"\nbye' }], columns);
+
+  expect(csv).toBe('Name,Note\r\n"Doe, Jane","said ""hi""\nbye"');
+});
+
+test('should neutralize cells that a spreadsheet would run as a formula', () => {
+  const csv = toCsv([{ name: '=SUM(A1:A2)', note: '-1+2' }], columns);
+
+  expect(csv).toBe("Name,Note\r\n'=SUM(A1:A2),'-1+2");
+});
diff --git a/apps/react-vite/src/utils/csv.ts b/apps/react-vite/src/utils/csv.ts
new file mode 100644
index 0000000..6f2c305
--- /dev/null
+++ b/apps/react-vite/src/utils/csv.ts
@@ -0,0 +1,37 @@
+export type CsvColumn<Row> = {
+  header: string;
+  value: (row: Row) => string;
+};
+
+// Spreadsheet apps run cells that start with these characters as formulas.
+const FORMULA_PREFIX = /^[=+@\t\r-]/;
+const NEEDS_QUOTES = /[",\r\n]/;
+
+const escapeCell = (value: string) => {
+  const safe = FORMULA_PREFIX.test(value) ? `'${value}` : value;
+  return NEEDS_QUOTES.test(safe) ? `"${safe.replace(/"/g, '""')}"` : safe;
+};
+
+export const toCsv = <Row>(rows: Row[], columns: CsvColumn<Row>[]) => {
+  const lines = [
+    columns.map((column) => column.header),
+    ...rows.map((row) => columns.map((column) => column.value(row))),
+  ];
+
+  return lines.map((cells) => cells.map(escapeCell).join(',')).join('\r\n');
+};
+
+export const downloadCsv = (filename: string, csv: string) => {
+  // The BOM makes Excel read the file as UTF-8.
+  const blob = new Blob(['﻿', csv], { type: 'text/csv;charset=utf-8' });
+  const url = URL.createObjectURL(blob);
+
+  const link = document.createElement('a');
+  link.href = url;
+  link.download = filename;
+  document.body.appendChild(link);
+  link.click();
+  link.remove();
+
+  URL.revokeObjectURL(url);
+};
