diff --git a/apps/react-vite/src/features/users/utils/export-users-csv.ts b/apps/react-vite/src/features/users/utils/export-users-csv.ts
new file mode 100644
index 0000000..fcd7371
--- /dev/null
+++ b/apps/react-vite/src/features/users/utils/export-users-csv.ts
@@ -0,0 +1,35 @@
+import { User } from '@/types/api';
+
+// Prefix values that spreadsheets could run as formulas.
+const FORMULA_PREFIX = /^[=+\-@\t\r]/;
+
+const toCell = (value: string) => {
+  const safe = FORMULA_PREFIX.test(value) ? `'${value}` : value;
+  return `"${safe.replace(/"/g, '""')}"`;
+};
+
+export const usersToCsv = (users: User[]) => {
+  const rows = [
+    ['Name', 'Email', 'Role', 'Joined'],
+    ...users.map((user) => [
+      `${user.firstName} ${user.lastName}`.trim(),
+      user.email,
+      user.role,
+      new Date(user.createdAt).toISOString(),
+    ]),
+  ];
+
+  return rows.map((row) => row.map(toCell).join(',')).join('\r\n');
+};
+
+export const downloadUsersCsv = (users: User[], filename = 'users.csv') => {
+  const blob = new Blob([usersToCsv(users)], {
+    type: 'text/csv;charset=utf-8;',
+  });
+  const url = URL.createObjectURL(blob);
+  const link = document.createElement('a');
+  link.href = url;
+  link.download = filename;
+  link.click();
+  URL.revokeObjectURL(url);
+};
diff --git a/apps/react-vite/src/features/users/utils/filter-users.ts b/apps/react-vite/src/features/users/utils/filter-users.ts
new file mode 100644
index 0000000..02ac6a1
--- /dev/null
+++ b/apps/react-vite/src/features/users/utils/filter-users.ts
@@ -0,0 +1,16 @@
+import { User } from '@/types/api';
+
+import { UsersFilter } from '../api/get-users';
+
+export const filterUsers = (users: User[], { search, role }: UsersFilter) => {
+  const term = search.trim().toLowerCase();
+  const wantedRole: string = role;
+
+  return users.filter((user) => {
+    if (wantedRole && user.role !== wantedRole) return false;
+    if (!term) return true;
+
+    const name = `${user.firstName} ${user.lastName}`.toLowerCase();
+    return name.includes(term) || user.email.toLowerCase().includes(term);
+  });
+};
