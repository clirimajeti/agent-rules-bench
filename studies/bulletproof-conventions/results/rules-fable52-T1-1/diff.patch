@@ -0,0 +1,46 @@
+import { Pin, PinOff } from 'lucide-react';
+
+import { Button } from '@/components/ui/button';
+import { Authorization, ROLES } from '@/lib/authorization';
+
+import { useDiscussion } from '../api/get-discussion';
+import { usePinDiscussion } from '../api/pin-discussion';
+
+type PinDiscussionProps = {
+  discussionId: string;
+};
+
+export const PinDiscussion = ({ discussionId }: PinDiscussionProps) => {
+  const discussionQuery = useDiscussion({ discussionId });
+  const pinDiscussionMutation = usePinDiscussion();
+
+  const discussion = discussionQuery.data?.data;
+
+  if (!discussion) return null;
+
+  return (
+    <Authorization allowedRoles={[ROLES.ADMIN]}>
+      <Button
+        variant="outline"
+        size="sm"
+        icon={
+          discussion.pinned ? (
+            <PinOff className="size-4" />
+          ) : (
+            <Pin className="size-4" />
+          )
+        }
+        isLoading={pinDiscussionMutation.isPending}
+        disabled={pinDiscussionMutation.isPending}
+        onClick={() =>
+          pinDiscussionMutation.mutate({
+            discussionId,
+            data: { pinned: !discussion.pinned },
+          })
+        }
+      >
+        {discussion.pinned ? 'Unpin Discussion' : 'Pin Discussion'}
+      </Button>
+    </Authorization>
+  );
+};
