diff --git a/apps/react-vite/src/features/users/utils/export-users-csv.ts b/apps/react-vite/src/features/users/utils/export-users-csv.ts
new file mode 100644
index 0000000..60a6f61
--- /dev/null
+++ b/apps/react-vite/src/features/users/utils/export-users-csv.ts
@@ -0,0 +1,34 @@
+import { User } from '@/types/api';
+import { formatDate } from '@/utils/format';
+
+// Prefix cells that spreadsheets could interpret as formulas (CSV injection).
+const escapeCell = (value: string) => {
+  const safe = /^[=+\-@\t\r]/.test(value) ? `'${value}` : value;
+  return `"${safe.replace(/"/g, '""')}"`;
+};
+
+export const usersToCsv = (users: User[]): string => {
+  const rows = [
+    ['Name', 'Email', 'Role', 'Joined'],
+    ...users.map((user) => [
+      `${user.firstName} ${user.lastName}`,
+      user.email,
+      user.role,
+      formatDate(user.createdAt),
+    ]),
+  ];
+
+  return rows.map((row) => row.map(escapeCell).join(',')).join('\r\n');
+};
+
+export const downloadUsersCsv = (users: User[], filename = 'users.csv') => {
+  const blob = new Blob([usersToCsv(users)], {
+    type: 'text/csv;charset=utf-8;',
+  });
+  const url = URL.createObjectURL(blob);
+  const link = document.createElement('a');
+  link.href = url;
+  link.download = filename;
+  link.click();
+  URL.revokeObjectURL(url);
+};
diff --git a/apps/react-vite/src/features/users/utils/filter-users.ts b/apps/react-vite/src/features/users/utils/filter-users.ts
new file mode 100644
index 0000000..2e6fb42
--- /dev/null
+++ b/apps/react-vite/src/features/users/utils/filter-users.ts
@@ -0,0 +1,23 @@
+import { User } from '@/types/api';
+
+export type RoleFilter = 'ALL' | User['role'];
+
+type UserFilters = {
+  role: RoleFilter;
+  search: string;
+};
+
+export const filterUsers = (
+  users: User[],
+  { role, search }: UserFilters,
+): User[] => {
+  const query = search.trim().toLowerCase();
+
+  return users.filter((user) => {
+    if (role !== 'ALL' && user.role !== role) return false;
+    if (!query) return true;
+
+    const name = `${user.firstName} ${user.lastName}`.toLowerCase();
+    return name.includes(query) || user.email.toLowerCase().includes(query);
+  });
+};
