diff --git a/apps/react-vite/src/features/users/utils/export-users-csv.ts b/apps/react-vite/src/features/users/utils/export-users-csv.ts
new file mode 100644
index 0000000..6c5d3fa
--- /dev/null
+++ b/apps/react-vite/src/features/users/utils/export-users-csv.ts
@@ -0,0 +1,44 @@
+import { User } from '@/types/api';
+import { formatDate } from '@/utils/format';
+
+import { getFullName } from './filter-users';
+
+const CSV_HEADERS = ['Name', 'Email', 'Role', 'Joined'];
+
+// Spreadsheet applications treat cells starting with these characters as formulas.
+const FORMULA_PREFIX = /^[=+\-@\t\r]/;
+
+const escapeCsvCell = (value: string) => {
+  const safeValue = FORMULA_PREFIX.test(value) ? `'${value}` : value;
+  return `"${safeValue.replace(/"/g, '""')}"`;
+};
+
+export const buildUsersCsv = (users: User[]) => {
+  const rows = users.map((user) => [
+    getFullName(user),
+    user.email,
+    user.role,
+    formatDate(user.createdAt),
+  ]);
+
+  return [CSV_HEADERS, ...rows]
+    .map((row) => row.map(escapeCsvCell).join(','))
+    .join('\r\n');
+};
+
+export const downloadUsersCsv = (users: User[], fileName: string) => {
+  // The byte order mark lets spreadsheet applications detect UTF-8.
+  const blob = new Blob(['﻿', buildUsersCsv(users)], {
+    type: 'text/csv;charset=utf-8',
+  });
+  const url = URL.createObjectURL(blob);
+
+  const link = document.createElement('a');
+  link.href = url;
+  link.download = fileName;
+  document.body.appendChild(link);
+  link.click();
+  link.remove();
+
+  setTimeout(() => URL.revokeObjectURL(url), 0);
+};
diff --git a/apps/react-vite/src/features/users/utils/filter-users.ts b/apps/react-vite/src/features/users/utils/filter-users.ts
new file mode 100644
index 0000000..1200c25
--- /dev/null
+++ b/apps/react-vite/src/features/users/utils/filter-users.ts
@@ -0,0 +1,25 @@
+import { User } from '@/types/api';
+
+export type UserRoleFilter = 'ALL' | User['role'];
+
+export type UserFilters = {
+  search: string;
+  role: UserRoleFilter;
+};
+
+export const getFullName = (user: Pick<User, 'firstName' | 'lastName'>) =>
+  `${user.firstName} ${user.lastName}`;
+
+export const filterUsers = (users: User[], { search, role }: UserFilters) => {
+  const query = search.trim().toLowerCase();
+
+  return users.filter((user) => {
+    if (role !== 'ALL' && user.role !== role) return false;
+    if (!query) return true;
+
+    return (
+      getFullName(user).toLowerCase().includes(query) ||
+      user.email.toLowerCase().includes(query)
+    );
+  });
+};
