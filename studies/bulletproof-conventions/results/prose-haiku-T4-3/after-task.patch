 import { queryOptions, useQuery } from '@tanstack/react-query';
+import { z } from 'zod';
 
 import { api } from '@/lib/api-client';
+import { ROLES } from '@/lib/authorization';
 import { QueryConfig } from '@/lib/react-query';
 import { User } from '@/types/api';
 
+// Filters are applied to the list already loaded by `getUsers`, so this schema
+// only describes the values of the users filter form.
+export const usersFilterSchema = z.object({
+  search: z.string(),
+  role: z.union([z.literal('ALL'), z.nativeEnum(ROLES)]),
+});
+
+export type UsersFilterValues = z.infer<typeof usersFilterSchema>;
+
 export const getUsers = (): Promise<{ data: User[] }> => {
   return api.get(`/users`);
 };
