+import { Form, Input, Select } from '@/components/ui/form';
+import { ROLES } from '@/lib/authorization';
+
+import { usersFilterSchema, UsersFilterValues } from '../api/get-users';
+
+const roleOptions = [
+  { label: 'All roles', value: 'ALL' },
+  { label: 'Admin', value: ROLES.ADMIN },
+  { label: 'User', value: ROLES.USER },
+];
+
+type UsersFiltersProps = {
+  onChange: (filters: UsersFilterValues) => void;
+};
+
+export const UsersFilters = ({ onChange }: UsersFiltersProps) => {
+  return (
+    <Form
+      schema={usersFilterSchema}
+      onSubmit={onChange}
+      options={{ defaultValues: { search: '', role: 'ALL' } }}
+    >
+      {({ register, getValues }) => (
+        <div className="grid gap-4 sm:grid-cols-[1fr_12rem]">
+          <Input
+            label="Search by name or email"
+            type="search"
+            placeholder="Search users"
+            registration={register('search', {
+              onChange: () => onChange(getValues()),
+            })}
+          />
+          <Select
+            label="Role"
+            options={roleOptions}
+            registration={register('role', {
+              onChange: () => onChange(getValues()),
+            })}
+          />
+        </div>
+      )}
+    </Form>
+  );
+};
