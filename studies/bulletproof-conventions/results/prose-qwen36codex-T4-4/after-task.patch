diff --git a/apps/react-vite/src/features/users/api/download-users-csv.ts b/apps/react-vite/src/features/users/api/download-users-csv.ts
new file mode 100644
index 0000000..f5ee1f2
--- /dev/null
+++ b/apps/react-vite/src/features/users/api/download-users-csv.ts
@@ -0,0 +1,30 @@
+import { User } from '@/types/api';
+
+import { formatDate } from '@/utils/format';
+
+export const downloadUsersCsv = (users: User[]) => {
+  const headers = ['Name', 'Email', 'Role', 'Joined'];
+  const rows = users.map((user) => [
+    `${user.firstName} ${user.lastName}`,
+    user.email,
+    user.role,
+    formatDate(user.createdAt),
+  ]);
+
+  const csvContent = [
+    headers.join(','),
+    ...rows.map((row) =>
+      row.map((cell) => `"${String(cell).replace(/"/g, '""')}"`).join(','),
+    ),
+  ].join('\n');
+
+  const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
+  const url = URL.createObjectURL(blob);
+  const link = document.createElement('a');
+  link.href = url;
+  link.setAttribute('download', 'users.csv');
+  document.body.appendChild(link);
+  link.click();
+  document.body.removeChild(link);
+  URL.revokeObjectURL(url);
+};
