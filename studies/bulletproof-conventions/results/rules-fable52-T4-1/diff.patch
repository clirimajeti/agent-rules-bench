@@ -0,0 +1,30 @@
+import { describe, expect, test } from 'vitest';
+
+import { toCsv } from '../csv';
+
+type Row = { name: string; note: string };
+
+const columns = [
+  { header: 'Name', value: (row: Row) => row.name },
+  { header: 'Note', value: (row: Row) => row.note },
+];
+
+describe('toCsv', () => {
+  test('writes a header line and one line for each row', () => {
+    const csv = toCsv([{ name: 'Jane', note: 'hello' }], columns);
+
+    expect(csv).toBe('"Name","Note"\r\n"Jane","hello"');
+  });
+
+  test('escapes quotes, commas and line breaks', () => {
+    const csv = toCsv([{ name: 'Doe, "JD" Jane', note: 'a\nb' }], columns);
+
+    expect(csv).toBe('"Name","Note"\r\n"Doe, ""JD"" Jane","a\nb"');
+  });
+
+  test('neutralizes cells that spreadsheet apps would run as formulas', () => {
+    const csv = toCsv([{ name: '=SUM(A1)', note: '@cmd' }], columns);
+
+    expect(csv).toBe('"Name","Note"\r\n"\'=SUM(A1)","\'@cmd"');
+  });
+});
diff --git a/apps/react-vite/src/utils/csv.ts b/apps/react-vite/src/utils/csv.ts
new file mode 100644
index 0000000..3e1d44a
--- /dev/null
+++ b/apps/react-vite/src/utils/csv.ts
@@ -0,0 +1,36 @@
+export type CsvColumn<Row> = {
+  header: string;
+  value: (row: Row) => string;
+};
+
+// Cells that start with these characters are run as formulas by spreadsheet apps.
+const FORMULA_PREFIX = /^[=+\-@\t\r]/;
+
+const escapeCell = (value: string) => {
+  const safeValue = FORMULA_PREFIX.test(value) ? `'${value}` : value;
+  return `"${safeValue.replace(/"/g, '""')}"`;
+};
+
+export const toCsv = <Row>(rows: Row[], columns: CsvColumn<Row>[]) => {
+  const lines = [
+    columns.map((column) => column.header),
+    ...rows.map((row) => columns.map((column) => column.value(row))),
+  ];
+
+  return lines.map((cells) => cells.map(escapeCell).join(',')).join('\r\n');
+};
+
+export const downloadCsv = (filename: string, csv: string) => {
+  // The BOM makes Excel read the file as UTF-8.
+  const blob = new Blob(['﻿', csv], { type: 'text/csv;charset=utf-8' });
+  const url = URL.createObjectURL(blob);
+
+  const link = document.createElement('a');
+  link.href = url;
+  link.download = filename;
+  document.body.appendChild(link);
+  link.click();
+  link.remove();
+
+  URL.revokeObjectURL(url);
+};
