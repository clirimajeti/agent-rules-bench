@@ -0,0 +1,25 @@
+import { ROLES } from '@/lib/authorization';
+import { User } from '@/types/api';
+
+export type UsersFilters = {
+  search: string;
+  role?: ROLES;
+};
+
+export const parseUserRole = (value: string | null) =>
+  Object.values(ROLES).find((role) => role === value);
+
+export const filterUsers = (users: User[], { search, role }: UsersFilters) => {
+  const term = search.trim().toLowerCase();
+
+  // The role filter selects table rows by a data field; it is not an access check.
+  const shownRoles: string[] | undefined = role ? [role] : undefined;
+
+  return users.filter((user) => {
+    if (shownRoles && !shownRoles.includes(user.role)) return false;
+    if (!term) return true;
+
+    const name = `${user.firstName} ${user.lastName}`.toLowerCase();
+    return name.includes(term) || user.email.toLowerCase().includes(term);
+  });
+};
