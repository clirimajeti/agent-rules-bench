@@ -0,0 +1,50 @@
+import { describe, expect, test } from 'vitest';
+
+import { ROLES } from '@/lib/authorization';
+import { User } from '@/types/api';
+
+import { filterUsers } from '../filter-users';
+
+const createUser = (overrides: Partial<User>): User => ({
+  id: '1',
+  createdAt: 0,
+  firstName: 'Jane',
+  lastName: 'Doe',
+  email: 'jane@example.com',
+  role: ROLES.USER,
+  teamId: 'team',
+  bio: '',
+  ...overrides,
+});
+
+const jane = createUser({ id: '1' });
+const john = createUser({
+  id: '2',
+  firstName: 'John',
+  lastName: 'Smith',
+  email: 'boss@company.org',
+  role: ROLES.ADMIN,
+});
+const users = [jane, john];
+
+describe('filterUsers', () => {
+  test('returns all users when no filter is set', () => {
+    expect(filterUsers(users, { search: '' })).toEqual(users);
+  });
+
+  test('filters by role', () => {
+    expect(filterUsers(users, { search: '', role: ROLES.ADMIN })).toEqual([john]);
+  });
+
+  test('searches the full name and ignores case and outer spaces', () => {
+    expect(filterUsers(users, { search: '  john SM ' })).toEqual([john]);
+  });
+
+  test('searches the email', () => {
+    expect(filterUsers(users, { search: 'example.com' })).toEqual([jane]);
+  });
+
+  test('applies role and search together', () => {
+    expect(filterUsers(users, { search: 'jane', role: ROLES.ADMIN })).toEqual([]);
+  });
+});
