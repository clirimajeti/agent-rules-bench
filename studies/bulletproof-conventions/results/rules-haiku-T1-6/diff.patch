@@ -0,0 +1,51 @@
+import { useMutation, useQueryClient } from '@tanstack/react-query';
+
+import { useNotifications } from '@/components/ui/notifications';
+import { api } from '@/lib/api-client';
+import { MutationConfig } from '@/lib/react-query';
+import { Discussion } from '@/types/api';
+
+import { getDiscussionQueryOptions } from './get-discussion';
+import { getDiscussionsQueryOptions } from './get-discussions';
+
+export const pinDiscussion = ({
+  discussionId,
+  pinned,
+}: {
+  discussionId: string;
+  pinned: boolean;
+}): Promise<Discussion> => {
+  return api.patch(`/discussions/${discussionId}/pin`, { pinned });
+};
+
+type UsePinDiscussionOptions = {
+  mutationConfig?: MutationConfig<typeof pinDiscussion>;
+};
+
+export const usePinDiscussion = ({
+  mutationConfig,
+}: UsePinDiscussionOptions = {}) => {
+  const queryClient = useQueryClient();
+  const { addNotification } = useNotifications();
+
+  const { onSuccess, ...restConfig } = mutationConfig || {};
+
+  return useMutation({
+    onSuccess: (data, ...args) => {
+      // The server re-sorts the list, so refetch the discussions list too.
+      queryClient.refetchQueries({
+        queryKey: getDiscussionsQueryOptions().queryKey,
+      });
+      queryClient.refetchQueries({
+        queryKey: getDiscussionQueryOptions(data.id).queryKey,
+      });
+      addNotification({
+        type: 'success',
+        title: data.pinned ? 'Discussion Pinned' : 'Discussion Unpinned',
+      });
+      onSuccess?.(data, ...args);
+    },
+    ...restConfig,
+    mutationFn: pinDiscussion,
+  });
+};
