@@ -0,0 +1,50 @@
+import { Download } from 'lucide-react';
+
+import { Button } from '@/components/ui/button';
+import { Form, Input } from '@/components/ui/form';
+
+import { usersFilterSchema } from '../api/get-users';
+
+type UsersToolbarProps = {
+  onSearchChange: (search: string) => void;
+  onExport: () => void;
+  canExport: boolean;
+};
+
+export const UsersToolbar = ({
+  onSearchChange,
+  onExport,
+  canExport,
+}: UsersToolbarProps) => {
+  return (
+    <Form
+      schema={usersFilterSchema}
+      onSubmit={() => undefined}
+      options={{ defaultValues: { search: '' } }}
+    >
+      {({ register }) => (
+        <div className="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
+          <div className="grid w-full gap-4 sm:max-w-xl">
+            <Input
+              label="Search by name or email"
+              type="search"
+              placeholder="Search users"
+              registration={register('search', {
+                onChange: (event) => onSearchChange(event.target.value),
+              })}
+            />
+          </div>
+          <Button
+            type="button"
+            variant="outline"
+            onClick={onExport}
+            disabled={!canExport}
+            icon={<Download className="size-4" />}
+          >
+            Export CSV
+          </Button>
+        </div>
+      )}
+    </Form>
+  );
+};
diff --git a/apps/react-vite/src/features/users/utils/export-users-csv.ts b/apps/react-vite/src/features/users/utils/export-users-csv.ts
new file mode 100644
index 0000000..e3e6f3b
--- /dev/null
+++ b/apps/react-vite/src/features/users/utils/export-users-csv.ts
@@ -0,0 +1,43 @@
+import { User } from '@/types/api';
+import { formatDate } from '@/utils/format';
+
+const HEADERS = ['Name', 'Email', 'Role', 'Date Joined'];
+
+// Spreadsheet apps treat cells starting with these characters as formulas.
+const FORMULA_PREFIX = /^[=+\-@\t\r]/;
+
+const escapeCell = (value: string) => {
+  const safeValue = FORMULA_PREFIX.test(value) ? `'${value}` : value;
+
+  return `"${safeValue.replace(/"/g, '""')}"`;
+};
+
+export const usersToCsv = (users: User[]) => {
+  const rows = users.map((user) => [
+    `${user.firstName} ${user.lastName}`.trim(),
+    user.email,
+    user.role,
+    formatDate(user.createdAt),
+  ]);
+
+  return [HEADERS, ...rows]
+    .map((row) => row.map(escapeCell).join(','))
+    .join('\r\n');
+};
+
+export const downloadUsersCsv = (users: User[]) => {
+  // The BOM lets spreadsheet apps detect UTF-8 so non-ASCII names display correctly.
+  const blob = new Blob(['﻿', usersToCsv(users)], {
+    type: 'text/csv;charset=utf-8',
+  });
+  const url = URL.createObjectURL(blob);
+  const link = document.createElement('a');
+
+  link.href = url;
+  link.download = `users-${new Date().toISOString().slice(0, 10)}.csv`;
+  document.body.appendChild(link);
+  link.click();
+  link.remove();
+
+  setTimeout(() => URL.revokeObjectURL(url), 0);
+};
diff --git a/apps/react-vite/src/features/users/utils/filter-users.ts b/apps/react-vite/src/features/users/utils/filter-users.ts
