diff --git a/apps/react-vite/src/features/users/utils/filter-users.ts b/apps/react-vite/src/features/users/utils/filter-users.ts
new file mode 100644
index 0000000..6e63556
--- /dev/null
+++ b/apps/react-vite/src/features/users/utils/filter-users.ts
@@ -0,0 +1,37 @@
+import { ROLES } from '@/lib/authorization';
+import { User } from '@/types/api';
+
+export const ALL_ROLES = 'ALL';
+
+export type RoleFilter = typeof ALL_ROLES | User['role'];
+
+const roleValues: string[] = Object.values(ROLES);
+
+export const isRoleFilter = (value: string): value is RoleFilter => {
+  return value === ALL_ROLES || roleValues.includes(value);
+};
+
+type UserFilters = {
+  search: string;
+  role: RoleFilter;
+};
+
+export const filterUsers = (users: User[], { search, role }: UserFilters) => {
+  const query = search.trim().toLowerCase();
+
+  return users.filter((user) => {
+    if (role !== ALL_ROLES && user.role !== role) {
+      return false;
+    }
+
+    if (!query) {
+      return true;
+    }
+
+    const fullName = `${user.firstName} ${user.lastName}`.toLowerCase();
+
+    const email = user.email.toLowerCase();
+
+    return fullName.includes(query) || email.includes(query);
+  });
+};
