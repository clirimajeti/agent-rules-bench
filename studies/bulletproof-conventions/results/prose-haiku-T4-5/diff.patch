@@ -0,0 +1,44 @@
+import { User } from '@/types/api';
+import { formatDate } from '@/utils/format';
+
+// Cells starting with these characters are interpreted as formulas by
+// spreadsheet applications, so they are prefixed with a single quote.
+const FORMULA_PREFIX_PATTERN = /^[=+\-@\t\r]/;
+
+const escapeCsvCell = (value: string) => {
+  const safeValue = FORMULA_PREFIX_PATTERN.test(value) ? `'${value}` : value;
+
+  return `"${safeValue.replace(/"/g, '""')}"`;
+};
+
+export const usersToCsv = (users: User[]) => {
+  const header = ['Name', 'Email', 'Role', 'Joined'];
+
+  const rows = users.map((user) => [
+    `${user.firstName} ${user.lastName}`,
+    user.email,
+    user.role,
+    formatDate(user.createdAt),
+  ]);
+
+  return [header, ...rows]
+    .map((row) => row.map(escapeCsvCell).join(','))
+    .join('\r\n');
+};
+
+export const downloadCsv = (filename: string, content: string) => {
+  // The byte order mark makes spreadsheet applications read the file as UTF-8.
+  const blob = new Blob([`﻿${content}`], {
+    type: 'text/csv;charset=utf-8',
+  });
+  const url = URL.createObjectURL(blob);
+  const link = document.createElement('a');
+
+  link.href = url;
+  link.download = filename;
+  document.body.appendChild(link);
+  link.click();
+  link.remove();
+
+  setTimeout(() => URL.revokeObjectURL(url), 0);
+};
