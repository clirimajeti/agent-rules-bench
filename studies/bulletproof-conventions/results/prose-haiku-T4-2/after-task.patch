diff --git a/apps/react-vite/src/features/users/utils/filter-users.ts b/apps/react-vite/src/features/users/utils/filter-users.ts
new file mode 100644
index 0000000..ae785c6
--- /dev/null
+++ b/apps/react-vite/src/features/users/utils/filter-users.ts
@@ -0,0 +1,27 @@
+import { User } from '@/types/api';
+
+export type RoleFilter = 'ALL' | User['role'];
+
+type UserFilters = {
+  search: string;
+  role: RoleFilter;
+};
+
+export const filterUsers = (users: User[], { search, role }: UserFilters) => {
+  const query = search.trim().toLowerCase();
+
+  return users.filter((user) => {
+    if (role !== 'ALL' && user.role !== role) {
+      return false;
+    }
+
+    if (!query) {
+      return true;
+    }
+
+    const fullName = `${user.firstName} ${user.lastName}`.toLowerCase();
+    return (
+      fullName.includes(query) || user.email.toLowerCase().includes(query)
+    );
+  });
+};
diff --git a/apps/react-vite/src/utils/csv.ts b/apps/react-vite/src/utils/csv.ts
new file mode 100644
index 0000000..53a5a84
--- /dev/null
+++ b/apps/react-vite/src/utils/csv.ts
@@ -0,0 +1,39 @@
+type DownloadCsvOptions = {
+  filename: string;
+  headers: string[];
+  rows: string[][];
+};
+
+// Cells starting with these characters are read as formulas by spreadsheet
+// apps. Prefixing them with a single quote stops that (CSV injection).
+const FORMULA_PREFIX_PATTERN = /^[=+\-@\t\r]/;
+
+const escapeCsvCell = (value: string) => {
+  const neutralised = FORMULA_PREFIX_PATTERN.test(value) ? `'${value}` : value;
+  return `"${neutralised.replace(/"/g, '""')}"`;
+};
+
+export const downloadCsv = ({
+  filename,
+  headers,
+  rows,
+}: DownloadCsvOptions) => {
+  const lines = [headers, ...rows].map((row) =>
+    row.map(escapeCsvCell).join(','),
+  );
+
+  // The byte order mark makes spreadsheet apps read the file as UTF-8.
+  const blob = new Blob([`﻿${lines.join('\r\n')}`], {
+    type: 'text/csv;charset=utf-8',
+  });
+  const url = URL.createObjectURL(blob);
+
+  const link = document.createElement('a');
+  link.href = url;
+  link.download = filename;
+  document.body.appendChild(link);
+  link.click();
+  link.remove();
+
+  setTimeout(() => URL.revokeObjectURL(url), 0);
+};
