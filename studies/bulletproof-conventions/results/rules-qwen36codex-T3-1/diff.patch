@@ -0,0 +1,49 @@
+import { useMutation } from '@tanstack/react-query';
+import { z } from 'zod';
+
+import { api } from '@/lib/api-client';
+import { useNotifications } from '@/components/ui/notifications';
+import { MutationConfig } from '@/lib/react-query';
+
+export const changePasswordInputSchema = z
+  .object({
+    currentPassword: z.string().min(1, 'Required'),
+    newPassword: z.string().min(5, 'Must be at least 5 characters'),
+    confirmPassword: z.string(),
+  })
+  .refine((data) => data.newPassword === data.confirmPassword, {
+    message: "Passwords don't match",
+    path: ['confirmPassword'],
+  });
+
+export type ChangePasswordInput = z.infer<typeof changePasswordInputSchema>;
+
+export const changePassword = ({
+  data,
+}: {
+  data: ChangePasswordInput;
+}): Promise<void> => {
+  return api.post('/auth/change-password', data);
+};
+
+type UseChangePasswordOptions = {
+  mutationConfig?: MutationConfig<typeof changePassword>;
+};
+
+export const useChangePassword = ({
+  mutationConfig,
+}: UseChangePasswordOptions = {}) => {
+  const { onSuccess, ...restConfig } = mutationConfig || {};
+
+  return useMutation({
+    onSuccess: (...args) => {
+      useNotifications.getState().addNotification({
+        type: 'success',
+        title: 'Password Changed',
+      });
+      onSuccess?.(...args);
+    },
+    ...restConfig,
+    mutationFn: changePassword,
+  });
+};
diff --git a/apps/react-vite/src/features/auth/components/change-password.tsx b/apps/react-vite/src/features/auth/components/change-password.tsx
