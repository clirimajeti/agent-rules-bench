diff --git a/apps/react-vite/src/features/users/utils/filter-users.ts b/apps/react-vite/src/features/users/utils/filter-users.ts
new file mode 100644
index 0000000..7194b97
--- /dev/null
+++ b/apps/react-vite/src/features/users/utils/filter-users.ts
@@ -0,0 +1,22 @@
+import { matchesRole } from '@/lib/authorization';
+import { User } from '@/types/api';
+
+import { UsersFilter } from '../api/get-users';
+
+export const filterUsers = (users: User[], { search, role }: UsersFilter) => {
+  const query = search.trim().toLowerCase();
+
+  return users.filter((user) => {
+    if (!matchesRole(user, role)) {
+      return false;
+    }
+
+    if (!query) {
+      return true;
+    }
+
+    const fullName = `${user.firstName} ${user.lastName}`.toLowerCase();
+
+    return fullName.includes(query) || user.email.toLowerCase().includes(query);
+  });
+};
diff --git a/apps/react-vite/src/features/users/utils/users-csv.ts b/apps/react-vite/src/features/users/utils/users-csv.ts
new file mode 100644
index 0000000..b11b4ed
--- /dev/null
+++ b/apps/react-vite/src/features/users/utils/users-csv.ts
@@ -0,0 +1,45 @@
+import { User } from '@/types/api';
+import { formatDate } from '@/utils/format';
+
+const CSV_HEADERS = ['Name', 'Email', 'Role', 'Joined'];
+
+// Spreadsheet apps run cells starting with these characters as formulas.
+const FORMULA_PREFIXES = ['=', '+', '-', '@', '\t', '\r'];
+
+const escapeCsvField = (value: string) => {
+  const safeValue = FORMULA_PREFIXES.some((prefix) => value.startsWith(prefix))
+    ? `'${value}`
+    : value;
+
+  return `"${safeValue.replace(/"/g, '""')}"`;
+};
+
+const toCsvRow = (fields: string[]) => fields.map(escapeCsvField).join(',');
+
+export const buildUsersCsv = (users: User[]) => {
+  const rows = users.map((user) =>
+    toCsvRow([
+      `${user.firstName} ${user.lastName}`,
+      user.email,
+      user.role,
+      formatDate(user.createdAt),
+    ]),
+  );
+
+  return [toCsvRow(CSV_HEADERS), ...rows].join('\r\n');
+};
+
+export const downloadUsersCsv = (users: User[]) => {
+  // The BOM makes spreadsheet apps read the file as UTF-8.
+  const content = `﻿${buildUsersCsv(users)}`;
+  const blob = new Blob([content], { type: 'text/csv;charset=utf-8' });
+  const url = URL.createObjectURL(blob);
+  const link = document.createElement('a');
+
+  link.href = url;
+  link.download = `users-${new Date().toISOString().slice(0, 10)}.csv`;
+  document.body.appendChild(link);
+  link.click();
+  link.remove();
+  URL.revokeObjectURL(url);
+};
