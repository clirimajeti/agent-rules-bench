@@ -0,0 +1,105 @@
+import type { Mock } from 'vitest';
+
+import { db } from '@/testing/mocks/db';
+import { hash } from '@/testing/mocks/utils';
+import {
+  createUser,
+  renderApp,
+  screen,
+  userEvent,
+  waitFor,
+  within,
+} from '@/testing/test-utils';
+
+import { default as ProfileRoute } from '../profile';
+
+beforeAll(() => {
+  vi.spyOn(console, 'error').mockImplementation(() => {});
+});
+
+afterAll(() => {
+  (console.error as Mock).mockRestore();
+});
+
+const getStoredPassword = (id: string) =>
+  db.user.findFirst({ where: { id: { equals: id } } })?.password;
+
+test(
+  'should reject a wrong current password and accept the correct one',
+  { timeout: 15000 },
+  async () => {
+    const currentPassword = 'current-password';
+    const newPassword = 'new-password';
+    const user = await createUser({ password: currentPassword });
+
+    await renderApp(<ProfileRoute />, { user });
+
+    await userEvent.click(
+      await screen.findByRole('button', { name: /change password/i }),
+    );
+
+    const drawer = await screen.findByRole('dialog', {
+      name: /change password/i,
+    });
+    const currentPasswordField =
+      within(drawer).getByLabelText('Current Password');
+    const submitButton = within(drawer).getByRole('button', {
+      name: /submit/i,
+    });
+
+    await userEvent.type(currentPasswordField, 'wrong-password');
+    await userEvent.type(
+      within(drawer).getByLabelText('New Password'),
+      newPassword,
+    );
+    await userEvent.type(
+      within(drawer).getByLabelText('Confirm New Password'),
+      newPassword,
+    );
+    await userEvent.click(submitButton);
+
+    expect(
+      await screen.findByText(/the current password is incorrect/i),
+    ).toBeInTheDocument();
+    expect(drawer).toBeInTheDocument();
+    expect(getStoredPassword(user.id)).toBe(hash(currentPassword));
+
+    await userEvent.clear(currentPasswordField);
+    await userEvent.type(currentPasswordField, currentPassword);
+    await userEvent.click(submitButton);
+
+    expect(await screen.findByText(/password updated/i)).toBeInTheDocument();
+    await waitFor(() => expect(drawer).not.toBeInTheDocument());
+    expect(getStoredPassword(user.id)).toBe(hash(newPassword));
+  },
+);
+
+test('should require the new password to be entered twice identically', async () => {
+  await renderApp(<ProfileRoute />);
+
+  await userEvent.click(
+    await screen.findByRole('button', { name: /change password/i }),
+  );
+
+  const drawer = await screen.findByRole('dialog', {
+    name: /change password/i,
+  });
+
+  await userEvent.type(
+    within(drawer).getByLabelText('Current Password'),
+    'current-password',
+  );
+  await userEvent.type(
+    within(drawer).getByLabelText('New Password'),
+    'new-password',
+  );
+  await userEvent.type(
+    within(drawer).getByLabelText('Confirm New Password'),
+    'other-password',
+  );
+  await userEvent.click(within(drawer).getByRole('button', { name: /submit/i }));
+
+  expect(
+    await within(drawer).findByText(/passwords do not match/i),
+  ).toBeInTheDocument();
+});
