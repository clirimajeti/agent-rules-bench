diff --git a/apps/react-vite/src/utils/csv.ts b/apps/react-vite/src/utils/csv.ts
new file mode 100644
index 0000000..5ed4882
--- /dev/null
+++ b/apps/react-vite/src/utils/csv.ts
@@ -0,0 +1,27 @@
+// Values starting with these characters can be run as formulas by spreadsheet apps.
+const FORMULA_PREFIX = /^[=+\-@\t\r]/;
+
+const escapeCsvValue = (value: string) => {
+  const safeValue = FORMULA_PREFIX.test(value) ? `'${value}` : value;
+  return `"${safeValue.replace(/"/g, '""')}"`;
+};
+
+export const toCsv = (rows: string[][]) =>
+  rows.map((row) => row.map(escapeCsvValue).join(',')).join('\r\n');
+
+export const downloadCsv = (fileName: string, rows: string[][]) => {
+  // The BOM makes spreadsheet apps read the file as UTF-8.
+  const blob = new Blob(['﻿', toCsv(rows)], {
+    type: 'text/csv;charset=utf-8',
+  });
+  const url = URL.createObjectURL(blob);
+
+  const link = document.createElement('a');
+  link.href = url;
+  link.download = fileName;
+  document.body.appendChild(link);
+  link.click();
+  link.remove();
+
+  URL.revokeObjectURL(url);
+};
