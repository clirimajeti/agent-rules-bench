@@ -0,0 +1,19 @@
+import { User } from '@/types/api';
+import { CsvColumn, downloadCsv, toCsv } from '@/utils/csv';
+import { formatIsoDate } from '@/utils/format';
+
+const usersCsvColumns: CsvColumn<User>[] = [
+  {
+    header: 'Name',
+    value: (user) => `${user.firstName} ${user.lastName}`.trim(),
+  },
+  { header: 'Email', value: (user) => user.email },
+  { header: 'Role', value: (user) => user.role },
+  { header: 'Joined', value: (user) => formatIsoDate(user.createdAt) },
+];
+
+export const usersToCsv = (users: User[]) => toCsv(users, usersCsvColumns);
+
+export const exportUsersCsv = (users: User[]) => {
+  downloadCsv(usersToCsv(users), `users-${formatIsoDate(Date.now())}.csv`);
+};
diff --git a/apps/react-vite/src/features/users/utils/filter-users.ts b/apps/react-vite/src/features/users/utils/filter-users.ts
new file mode 100644
index 0000000..a7974f3
--- /dev/null
+++ b/apps/react-vite/src/features/users/utils/filter-users.ts
@@ -0,0 +1,36 @@
+import { User } from '@/types/api';
+
+import { UsersFilters, usersFiltersSchema } from '../api/get-users';
+
+export const parseUsersFilters = (
+  searchParams: URLSearchParams,
+): UsersFilters =>
+  usersFiltersSchema.parse({
+    search: searchParams.get('search') ?? '',
+    role: searchParams.get('role') || undefined,
+  });
+
+// This filters the rows of the users table by the role picked in the
+// filter dropdown. It is not an access check: who may see this list is
+// decided by `<Authorization allowedRoles={[ROLES.ADMIN]}>` in the route.
+const hasRole = ({ role }: User, wanted: UsersFilters['role']) =>
+  !wanted || role === wanted;
+
+const matchesSearch = (
+  { firstName, lastName, email }: User,
+  search: string,
+) => {
+  if (!search) return true;
+
+  const fullName = `${firstName} ${lastName}`.toLowerCase();
+
+  return fullName.includes(search) || email.toLowerCase().includes(search);
+};
+
+export const filterUsers = (users: User[], filters: UsersFilters): User[] => {
+  const search = filters.search.trim().toLowerCase();
+
+  return users.filter(
+    (entry) => hasRole(entry, filters.role) && matchesSearch(entry, search),
+  );
+};
diff --git a/apps/react-vite/src/utils/csv.ts b/apps/react-vite/src/utils/csv.ts
new file mode 100644
index 0000000..5b2d129
--- /dev/null
+++ b/apps/react-vite/src/utils/csv.ts
@@ -0,0 +1,47 @@
+export type CsvColumn<Row> = {
+  header: string;
+  value: (row: Row) => string | number;
+};
+
+// Cells starting with these characters can be interpreted as formulas by
+// spreadsheet applications (CSV/formula injection), so they get neutralized.
+const FORMULA_TRIGGER = /^[=+\-@\t\r]/;
+
+const escapeCsvCell = (value: string | number): string => {
+  let cell = String(value);
+
+  if (FORMULA_TRIGGER.test(cell)) {
+    cell = `'${cell}`;
+  }
+
+  if (/[",\r\n]/.test(cell) || cell !== cell.trim()) {
+    cell = `"${cell.replace(/"/g, '""')}"`;
+  }
+
+  return cell;
+};
+
+export const toCsv = <Row>(rows: Row[], columns: CsvColumn<Row>[]): string => {
+  const header = columns.map((column) => escapeCsvCell(column.header));
+  const body = rows.map((row) =>
+    columns.map((column) => escapeCsvCell(column.value(row))).join(','),
+  );
+
+  // RFC 4180 uses CRLF as the line separator
+  return [header.join(','), ...body].join('\r\n');
+};
+
+export const downloadCsv = (csv: string, filename: string) => {
+  // the BOM makes Excel detect UTF-8 correctly (e.g. for accented names)
+  const blob = new Blob(['﻿', csv], { type: 'text/csv;charset=utf-8' });
+  const url = URL.createObjectURL(blob);
+
+  const link = document.createElement('a');
+  link.href = url;
+  link.download = filename;
+  document.body.appendChild(link);
+  link.click();
+  link.remove();
+
+  URL.revokeObjectURL(url);
+};
