+++ b/apps/react-vite/src/features/users/utils/export-users-csv.ts
@@ -0,0 +1,34 @@
+import { User } from '@/types/api';
+import { formatDate } from '@/utils/format';
+
+const escapeCsvValue = (value: string) => {
+  // Prefix formula triggers so spreadsheets do not run them.
+  const safe = /^[=+\-@\t\r]/.test(value) ? `'${value}` : value;
+  return `"${safe.replace(/"/g, '""')}"`;
+};
+
+export const buildUsersCsv = (users: User[]) => {
+  const rows = [
+    ['Name', 'Email', 'Role', 'Joined'],
+    ...users.map((user) => [
+      `${user.firstName} ${user.lastName}`,
+      user.email,
+      user.role,
+      formatDate(user.createdAt),
+    ]),
+  ];
+
+  return rows.map((row) => row.map(escapeCsvValue).join(',')).join('\r\n');
+};
+
+export const downloadUsersCsv = (users: User[]) => {
+  const blob = new Blob([buildUsersCsv(users)], {
+    type: 'text/csv;charset=utf-8;',
+  });
+  const url = URL.createObjectURL(blob);
+  const link = document.createElement('a');
+  link.href = url;
+  link.download = 'users.csv';
+  link.click();
+  URL.revokeObjectURL(url);
+};
