@@ -0,0 +1,40 @@
+import { Pin, PinOff } from 'lucide-react';
+
+import { Button } from '@/components/ui/button';
+import { Authorization, ROLES } from '@/lib/authorization';
+
+import { usePinDiscussion } from '../api/pin-discussion';
+
+type PinDiscussionProps = {
+  discussionId: string;
+  isPinned: boolean;
+};
+
+export const PinDiscussion = ({
+  discussionId,
+  isPinned,
+}: PinDiscussionProps) => {
+  const pinDiscussionMutation = usePinDiscussion();
+
+  return (
+    <Authorization allowedRoles={[ROLES.ADMIN]}>
+      <Button
+        type="button"
+        variant="outline"
+        size="sm"
+        icon={
+          isPinned ? <PinOff className="size-4" /> : <Pin className="size-4" />
+        }
+        isLoading={pinDiscussionMutation.isPending}
+        onClick={() =>
+          pinDiscussionMutation.mutate({
+            data: { isPinned: !isPinned },
+            discussionId,
+          })
+        }
+      >
+        {isPinned ? 'Unpin Discussion' : 'Pin Discussion'}
+      </Button>
+    </Authorization>
+  );
+};
