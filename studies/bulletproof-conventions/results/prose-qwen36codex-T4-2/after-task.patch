new file mode 100644
index 0000000..a2f1da4
--- /dev/null
+++ b/apps/react-vite/src/components/ui/select.tsx
@@ -0,0 +1,34 @@
+import * as React from 'react';
+
+import { cn } from '@/utils/cn';
+
+type Option = {
+  label: string;
+  value: string;
+};
+
+type SelectProps = {
+  options: Option[];
+  value: string;
+  onChange: (value: string) => void;
+  className?: string;
+};
+
+export const Select = ({ options, value, onChange, className }: SelectProps) => {
+  return (
+    <select
+      value={value}
+      onChange={(e) => onChange(e.target.value)}
+      className={cn(
+        'inline-flex h-8 w-32 items-center justify-center rounded-md border border-input bg-transparent px-2 py-1 text-sm shadow-sm transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-50',
+        className,
+      )}
+    >
+      {options.map(({ label, value: optValue }) => (
+        <option key={label} value={optValue}>
+          {label}
+        </option>
+      ))}
+    </select>
+  );
+};
