diff --git a/apps/react-vite/src/features/users/utils/filter-users.ts b/apps/react-vite/src/features/users/utils/filter-users.ts
new file mode 100644
index 0000000..cc408ec
--- /dev/null
+++ b/apps/react-vite/src/features/users/utils/filter-users.ts
@@ -0,0 +1,26 @@
+import { User } from '@/types/api';
+
+export type RoleFilter = 'ALL' | User['role'];
+
+export type UserFilters = {
+  role: RoleFilter;
+  search: string;
+};
+
+export const filterUsers = (users: User[], { role, search }: UserFilters) => {
+  const query = search.trim().toLowerCase();
+
+  return users.filter((user) => {
+    if (role !== 'ALL' && user.role !== role) {
+      return false;
+    }
+
+    if (!query) {
+      return true;
+    }
+
+    const fullName = `${user.firstName} ${user.lastName}`.toLowerCase();
+
+    return fullName.includes(query) || user.email.toLowerCase().includes(query);
+  });
+};
diff --git a/apps/react-vite/src/features/users/utils/users-csv.ts b/apps/react-vite/src/features/users/utils/users-csv.ts
new file mode 100644
index 0000000..70d3123
--- /dev/null
+++ b/apps/react-vite/src/features/users/utils/users-csv.ts
@@ -0,0 +1,36 @@
+import { User } from '@/types/api';
+import { downloadFile } from '@/utils/download';
+import { formatDate } from '@/utils/format';
+
+const CSV_HEADERS = ['Name', 'Email', 'Role', 'Joined'];
+
+const escapeCsvField = (value: string) => {
+  // Prefix values that spreadsheet apps would read as formulas (CSV injection).
+  const safeValue = /^[=+\-@\t\r]/.test(value) ? `'${value}` : value;
+
+  return `"${safeValue.replace(/"/g, '""')}"`;
+};
+
+export const usersToCsv = (users: User[]) => {
+  const rows = users.map((user) => [
+    `${user.firstName} ${user.lastName}`,
+    user.email,
+    user.role,
+    formatDate(user.createdAt),
+  ]);
+
+  return [CSV_HEADERS, ...rows]
+    .map((row) => row.map(escapeCsvField).join(','))
+    .join('\r\n');
+};
+
+export const downloadUsersCsv = (users: User[]) => {
+  const today = new Date().toISOString().slice(0, 10);
+
+  downloadFile({
+    // The UTF-8 byte order mark lets spreadsheet apps detect the encoding.
+    content: `﻿${usersToCsv(users)}`,
+    fileName: `users-${today}.csv`,
+    mimeType: 'text/csv;charset=utf-8',
+  });
+};
diff --git a/apps/react-vite/src/utils/download.ts b/apps/react-vite/src/utils/download.ts
new file mode 100644
index 0000000..4106b70
--- /dev/null
+++ b/apps/react-vite/src/utils/download.ts
@@ -0,0 +1,21 @@
+export const downloadFile = ({
+  content,
+  fileName,
+  mimeType,
+}: {
+  content: string;
+  fileName: string;
+  mimeType: string;
+}) => {
+  const blob = new Blob([content], { type: mimeType });
+  const url = URL.createObjectURL(blob);
+
+  const link = document.createElement('a');
+  link.href = url;
+  link.download = fileName;
+  document.body.appendChild(link);
+  link.click();
+  link.remove();
+
+  setTimeout(() => URL.revokeObjectURL(url), 0);
+};
