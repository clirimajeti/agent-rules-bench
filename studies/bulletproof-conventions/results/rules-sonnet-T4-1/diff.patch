diff --git a/apps/react-vite/src/features/users/utils/export-users-csv.ts b/apps/react-vite/src/features/users/utils/export-users-csv.ts
new file mode 100644
index 0000000..09ac345
--- /dev/null
+++ b/apps/react-vite/src/features/users/utils/export-users-csv.ts
@@ -0,0 +1,38 @@
+import { User } from '@/types/api';
+import { formatDate } from '@/utils/format';
+
+const FORMULA_PREFIX = /^[=+\-@\t\r]/;
+
+const escapeCell = (value: string) => {
+  // Prevent spreadsheet formula injection from user-controlled values.
+  const safe = FORMULA_PREFIX.test(value) ? `'${value}` : value;
+  return `"${safe.replace(/"/g, '""')}"`;
+};
+
+export const usersToCsv = (users: User[]) => {
+  const header = ['Name', 'Email', 'Role', 'Joined'];
+  const rows = users.map((user) => [
+    `${user.firstName} ${user.lastName}`,
+    user.email,
+    user.role,
+    formatDate(user.createdAt),
+  ]);
+
+  return [header, ...rows]
+    .map((row) => row.map(escapeCell).join(','))
+    .join('\r\n');
+};
+
+export const downloadUsersCsv = (users: User[]) => {
+  const blob = new Blob([usersToCsv(users)], {
+    type: 'text/csv;charset=utf-8;',
+  });
+  const url = URL.createObjectURL(blob);
+  const link = document.createElement('a');
+  link.href = url;
+  link.download = 'users.csv';
+  document.body.appendChild(link);
+  link.click();
+  link.remove();
+  URL.revokeObjectURL(url);
+};
diff --git a/apps/react-vite/src/features/users/utils/users-filter.ts b/apps/react-vite/src/features/users/utils/users-filter.ts
new file mode 100644
index 0000000..dea1e83
--- /dev/null
+++ b/apps/react-vite/src/features/users/utils/users-filter.ts
@@ -0,0 +1,14 @@
+import { User } from '@/types/api';
+
+import { UsersFilter } from '../api/get-users';
+
+export const filterUsers = (users: User[], { search }: UsersFilter) => {
+  const query = search.trim().toLowerCase();
+
+  return users.filter((user) => {
+    if (!query) return true;
+
+    const name = `${user.firstName} ${user.lastName}`.toLowerCase();
+    return name.includes(query) || user.email.toLowerCase().includes(query);
+  });
+};
