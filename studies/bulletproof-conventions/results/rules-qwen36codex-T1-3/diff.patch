+import { Pin, PinOff } from 'lucide-react';
+
+import { Button } from '@/components/ui/button';
+import { Authorization, ROLES } from '@/lib/authorization';
+
+import { useToggleDiscussionPinned } from '../api/toggle-discussion-pinned';
+
+type ToggleDiscussionPinnedProps = {
+  discussionId: string;
+  isPinned: boolean;
+};
+
+export const ToggleDiscussionPinned = ({
+  discussionId,
+  isPinned,
+}: ToggleDiscussionPinnedProps) => {
+  const togglePinnedMutation = useToggleDiscussionPinned({
+    mutationConfig: {
+      onSuccess: () => {
+        // Notification is handled inside the mutation hook
+      },
+    },
+  });
+
+  return (
+    <Authorization allowedRoles={[ROLES.ADMIN]}>
+      <Button
+        variant="secondary"
+        size="sm"
+        isLoading={togglePinnedMutation.isPending}
+        icon={isPinned ? <PinOff className="size-4" /> : <Pin className="size-4" />}
+        onClick={() =>
+          togglePinnedMutation.mutate({ discussionId })
+        }
+      >
+        {isPinned ? 'Unpin' : 'Pin'}
+      </Button>
+    </Authorization>
+  );
+};
