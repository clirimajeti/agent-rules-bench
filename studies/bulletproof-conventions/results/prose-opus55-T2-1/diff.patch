+const getCommentsStats = (discussionId: string) => {
+  const comments = db.comment.findMany({
+    where: {
+      discussionId: {
+        equals: discussionId,
+      },
+    },
+  });
+
+  const lastCommentAt = comments.reduce<number | null>(
+    (latest, comment) =>
+      latest === null || comment.createdAt > latest
+        ? comment.createdAt
+        : latest,
+    null,
+  );
+
+  return {
+    commentsCount: comments.length,
+    lastCommentAt,
+  };
+};
