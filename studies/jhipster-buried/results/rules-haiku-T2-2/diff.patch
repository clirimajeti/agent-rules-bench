+package io.github.jhipster.sample.service;
+
+import io.github.jhipster.sample.domain.Operation;
+import io.github.jhipster.sample.repository.OperationRepository;
+import java.time.Clock;
+import java.time.Instant;
+import java.time.temporal.ChronoUnit;
+import java.util.List;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+/**
+ * Service Implementation for managing {@link io.github.jhipster.sample.domain.Operation}.
+ */
+@Service
+@Transactional(readOnly = true)
+public class OperationService {
+
+    private static final Logger LOG = LoggerFactory.getLogger(OperationService.class);
+
+    private static final long RECENT_WINDOW_DAYS = 30;
+
+    private final OperationRepository operationRepository;
+    private final Clock clock;
+
+    public OperationService(OperationRepository operationRepository, Clock clock) {
+        this.operationRepository = operationRepository;
+        this.clock = clock;
+    }
+
+    /**
+     * Get the operations whose date lies within the last 30 days, most recent first.
+     *
+     * @return the operations dated from 30 days ago up to now.
+     */
+    public List<Operation> findRecentOperations() {
+        LOG.debug("Request to get Operations of the last {} days", RECENT_WINDOW_DAYS);
+        Instant now = Instant.now(clock);
+        return operationRepository.findAllWithEagerRelationshipsByDateBetween(now.minus(RECENT_WINDOW_DAYS, ChronoUnit.DAYS), now);
+    }
+}
