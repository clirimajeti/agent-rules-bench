+<?xml version="1.0" encoding="utf-8"?>
+<databaseChangeLog
+    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
+    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
+    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
+    <!--
+        Index supporting the query for users created in a recent period (UserRepository#findLoginsByCreatedDateAfter).
+    -->
+    <changeSet id="20261104120000-1" author="jhipster">
+        <createIndex indexName="idx_jhi_user_created_date" tableName="jhi_user">
+            <column name="created_date"/>
+        </createIndex>
+    </changeSet>
+</databaseChangeLog>
