+package io.github.jhipster.sample.web.rest;
+
+import static org.hamcrest.Matchers.hasItem;
+import static org.hamcrest.Matchers.not;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+import io.github.jhipster.sample.IntegrationTest;
+import io.github.jhipster.sample.domain.Operation;
+import io.github.jhipster.sample.repository.OperationRepository;
+import io.github.jhipster.sample.security.AuthoritiesConstants;
+import java.math.BigDecimal;
+import java.time.Clock;
+import java.time.Instant;
+import java.time.temporal.ChronoUnit;
+import java.util.List;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc;
+import org.springframework.security.test.context.support.WithMockUser;
+import org.springframework.test.web.servlet.MockMvc;
+
+/**
+ * Integration tests for the recent operations endpoint of the {@link OperationResource} REST controller.
+ */
+@IntegrationTest
+@AutoConfigureMockMvc
+class OperationRecentResourceIT {
+
+    private static final String RECENT_API_URL = "/api/operations/recent";
+
+    private static final String RECENT_DESCRIPTION = "RECENT_OPERATION_IT";
+    private static final String OLD_DESCRIPTION = "OLD_OPERATION_IT";
+
+    @Autowired
+    private OperationRepository operationRepository;
+
+    @Autowired
+    private MockMvc restOperationMockMvc;
+
+    @Autowired
+    private Clock clock;
+
+    private List<Operation> insertedOperations;
+
+    @BeforeEach
+    void initTest() {
+        Instant now = Instant.now(clock);
+        insertedOperations = List.of(
+            operationRepository.saveAndFlush(
+                new Operation().date(now.minus(1, ChronoUnit.DAYS)).description(RECENT_DESCRIPTION).amount(BigDecimal.ONE)
+            ),
+            operationRepository.saveAndFlush(
+                new Operation().date(now.minus(60, ChronoUnit.DAYS)).description(OLD_DESCRIPTION).amount(BigDecimal.ONE)
+            )
+        );
+    }
+
+    @AfterEach
+    void cleanup() {
+        operationRepository.deleteAll(insertedOperations);
+    }
+
+    @Test
+    @WithMockUser(authorities = AuthoritiesConstants.ADMIN)
+    void shouldReturnOnlyOperationsFromTheLast30Days() throws Exception {
+        restOperationMockMvc
+            .perform(get(RECENT_API_URL))
+            .andExpect(status().isOk())
+            .andExpect(jsonPath("$.[*].description").value(hasItem(RECENT_DESCRIPTION)))
+            .andExpect(jsonPath("$.[*].description").value(not(hasItem(OLD_DESCRIPTION))));
+    }
+
+    @Test
+    @WithMockUser
+    void shouldForbidNonAdministrators() throws Exception {
+        restOperationMockMvc.perform(get(RECENT_API_URL)).andExpect(status().isForbidden());
+    }
+}
