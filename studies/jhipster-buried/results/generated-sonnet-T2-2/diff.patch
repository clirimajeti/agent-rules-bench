+package io.github.jhipster.sample.service.dto;
+
+import io.github.jhipster.sample.domain.Operation;
+import java.math.BigDecimal;
+import java.time.Instant;
+
+/**
+ * A DTO for the {@link Operation} entity without its relationships.
+ */
+public record OperationDTO(Long id, Instant date, String description, BigDecimal amount) {
+    public static OperationDTO from(Operation operation) {
+        return new OperationDTO(operation.getId(), operation.getDate(), operation.getDescription(), operation.getAmount());
+    }
+}
