+    @Transactional(readOnly = true)
+    public List<String> getRecentlyCreatedUserLogins() {
+        Instant since = Instant.now(clock).minus(RECENTLY_CREATED_DAYS, ChronoUnit.DAYS);
+        return userRepository
+            .findAllByCreatedDateAfterOrderByCreatedDateDesc(since)
+            .stream()
+            .map(User::getLogin)
+            .toList();
