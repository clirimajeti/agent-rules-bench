+package io.github.jhipster.sample.service;
+
+import io.github.jhipster.sample.repository.OperationRepository;
+import io.github.jhipster.sample.service.dto.OperationDTO;
+import io.github.jhipster.sample.service.mapper.OperationMapper;
+import java.time.Clock;
+import java.time.Duration;
+import java.time.Instant;
+import java.util.List;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+/**
+ * Service for querying {@link io.github.jhipster.sample.domain.Operation} by business rules.
+ */
+@Service
+@Transactional(readOnly = true)
+public class OperationService {
+
+    private static final Logger LOG = LoggerFactory.getLogger(OperationService.class);
+
+    static final Duration RECENT_WINDOW = Duration.ofDays(30);
+
+    private final OperationRepository operationRepository;
+
+    private final OperationMapper operationMapper;
+
+    private final Clock clock;
+
+    public OperationService(OperationRepository operationRepository, OperationMapper operationMapper, Clock clock) {
+        this.operationRepository = operationRepository;
+        this.operationMapper = operationMapper;
+        this.clock = clock;
+    }
+
+    /**
+     * Get the operations whose date lies within the last 30 days, newest first.
+     *
+     * @return the operations dated between now minus 30 days and now.
+     */
+    public List<OperationDTO> findRecentOperations() {
+        Instant now = Instant.now(clock);
+        Instant since = now.minus(RECENT_WINDOW);
+        LOG.debug("Request to get Operations dated between {} and {}", since, now);
+        return operationRepository
+            .findAllWithBankAccountByDateBetween(since, now)
+            .stream()
+            .map(operationMapper::toDto)
+            .toList();
+    }
+}
