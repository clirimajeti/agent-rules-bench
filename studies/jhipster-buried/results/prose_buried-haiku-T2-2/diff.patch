+package io.github.jhipster.sample.service;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.ArgumentMatchers.eq;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+
+import io.github.jhipster.sample.domain.Operation;
+import io.github.jhipster.sample.repository.OperationRepository;
+import java.time.Clock;
+import java.time.Instant;
+import java.time.ZoneOffset;
+import java.util.List;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.extension.ExtendWith;
+import org.mockito.Mock;
+import org.mockito.junit.jupiter.MockitoExtension;
+import org.springframework.data.domain.Page;
+import org.springframework.data.domain.PageImpl;
+import org.springframework.data.domain.PageRequest;
+
+@ExtendWith(MockitoExtension.class)
+class OperationServiceTest {
+
+    private static final Instant NOW = Instant.parse("2026-11-01T10:00:00Z");
+
+    @Mock
+    private OperationRepository operationRepository;
+
+    @Test
+    void findRecentOperations_queriesFromThirtyDaysAgoUntilNow() {
+        Clock clock = Clock.fixed(NOW, ZoneOffset.UTC);
+        OperationService operationService = new OperationService(operationRepository, clock);
+        Page<Operation> expected = new PageImpl<>(List.of());
+        when(operationRepository.findAllWithEagerRelationshipsBetweenDates(any(), any(), any())).thenReturn(expected);
+
+        Page<Operation> result = operationService.findRecentOperations(PageRequest.of(0, 20));
+
+        verify(operationRepository).findAllWithEagerRelationshipsBetweenDates(
+            eq(Instant.parse("2026-10-02T10:00:00Z")),
+            eq(NOW),
+            eq(PageRequest.of(0, 20))
+        );
+        assertThat(result).isSameAs(expected);
+    }
+}
