+package io.github.jhipster.sample.service.dto;
+
+import io.github.jhipster.sample.domain.Operation;
+import java.math.BigDecimal;
+import java.time.Instant;
+
+/**
+ * A DTO representing an operation as shown in the recent-operations view.
+ *
+ * @param id the identifier of the operation.
+ * @param date the date of the operation.
+ * @param description the description of the operation.
+ * @param amount the amount of the operation.
+ * @param bankAccountId the identifier of the bank account the operation belongs to, if any.
+ */
+public record OperationDTO(Long id, Instant date, String description, BigDecimal amount, Long bankAccountId) {
+    public static OperationDTO from(Operation operation) {
+        Long bankAccountId = operation.getBankAccount() == null ? null : operation.getBankAccount().getId();
+        return new OperationDTO(
+            operation.getId(),
+            operation.getDate(),
+            operation.getDescription(),
+            operation.getAmount(),
+            bankAccountId
+        );
+    }
+}
