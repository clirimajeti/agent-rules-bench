+package io.github.jhipster.sample.web.rest;
+
+import static org.hamcrest.Matchers.hasItem;
+import static org.hamcrest.Matchers.not;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.*;
+
+import io.github.jhipster.sample.IntegrationTest;
+import io.github.jhipster.sample.domain.Operation;
+import io.github.jhipster.sample.repository.OperationRepository;
+import io.github.jhipster.sample.security.AuthoritiesConstants;
+import java.math.BigDecimal;
+import java.time.Clock;
+import java.time.Instant;
+import java.time.temporal.ChronoUnit;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc;
+import org.springframework.security.test.context.support.WithMockUser;
+import org.springframework.test.web.servlet.MockMvc;
+import org.springframework.transaction.annotation.Transactional;
+
+@IntegrationTest
+@AutoConfigureMockMvc
+@Transactional
+class OperationRecentResourceIT {
+
+    private static final String RECENT_URL = "/api/operations/recent";
+
+    @Autowired
+    private OperationRepository operationRepository;
+
+    @Autowired
+    private Clock clock;
+
+    @Autowired
+    private MockMvc restOperationMockMvc;
+
+    @Test
+    @WithMockUser(authorities = AuthoritiesConstants.ADMIN)
+    void getRecentOperations_returnsOnlyOperationsFromLast30Days() throws Exception {
+        Operation recent = save(Instant.now(clock).minus(5, ChronoUnit.DAYS));
+        Operation old = save(Instant.now(clock).minus(40, ChronoUnit.DAYS));
+
+        restOperationMockMvc
+            .perform(get(RECENT_URL))
+            .andExpect(status().isOk())
+            .andExpect(jsonPath("$.[*].id").value(hasItem(recent.getId().intValue())))
+            .andExpect(jsonPath("$.[*].id").value(not(hasItem(old.getId().intValue()))));
+    }
+
+    @Test
+    @WithMockUser(authorities = AuthoritiesConstants.USER)
+    void getRecentOperations_whenNotAdmin_isForbidden() throws Exception {
+        restOperationMockMvc.perform(get(RECENT_URL)).andExpect(status().isForbidden());
+    }
+
+    private Operation save(Instant date) {
+        return operationRepository.saveAndFlush(new Operation().date(date).description("recent-test").amount(BigDecimal.ONE));
+    }
+}
