diff --git a/apps/web/app/(app)/workspaces/[workspaceId]/settings/account/profile/components/DownloadMyData.tsx b/apps/web/app/(app)/workspaces/[workspaceId]/settings/account/profile/components/DownloadMyData.tsx
new file mode 100644
index 000000000..f59de02c0
--- /dev/null
+++ b/apps/web/app/(app)/workspaces/[workspaceId]/settings/account/profile/components/DownloadMyData.tsx
@@ -0,0 +1,25 @@
+"use client";
+
+import { useTranslation } from "react-i18next";
+import { Button } from "@/modules/ui/components/button";
+
+export const DownloadMyData = ({ data }: Readonly<{ data: unknown }>) => {
+  const { t } = useTranslation();
+
+  const download = () => {
+    const url = URL.createObjectURL(
+      new Blob([JSON.stringify(data, null, 2)], { type: "application/json" })
+    );
+    const link = document.createElement("a");
+    link.href = url;
+    link.download = "my-data.json";
+    link.click();
+    URL.revokeObjectURL(url);
+  };
+
+  return (
+    <Button type="button" variant="secondary" onClick={download}>
+      {t("workspace.settings.profile.download_my_data")}
+    </Button>
+  );
+};
