+/**
+ * DELETE /api/v3/tags/delete-unused — bulk-delete all tags that are not attached to any response.
+ *
+ * Session-only, matching the other tag routes. The workspace is resolved from the calling user's
+ * access so the caller cannot target another workspace.
+ */
+import { requireV3WorkspaceAccess } from "@/app/api/v3/lib/auth";
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { successResponse } from "@/app/api/v3/lib/response";
+import { deleteTag } from "@/modules/workspaces/settings/lib/tag";
+import { getTagsByWorkspaceId } from "@/lib/tag/service";
+import { getTagsOnResponsesCount } from "@/lib/tagOnResponse/service";
+import { buildVisibleSurveyWhere } from "@/lib/survey/visibility/predicate";
+import { resolveV3ResponsesActorContext } from "@/app/api/v3/responses/lib/visibility";
+
+export const DELETE = withV3ApiWrapper({
+  auth: "session",
+  handler: async ({ authentication, requestId, instance }) => {
+    const access = await requireV3WorkspaceAccess(
+      authentication,
+      authentication.workspaceId,
+      "readWrite",
+      requestId,
+      instance,
+    );
+    if (access instanceof Response) return access;
+
+    const [tags, counts] = await Promise.all([
+      getTagsByWorkspaceId(access.workspaceId),
+      getTagsOnResponsesCount(
+        access.workspaceId,
+        buildVisibleSurveyWhere(await resolveV3ResponsesActorContext(authentication, access.organizationId)),
+      ),
+    ]);
+
+    const tagIdWithResponses = new Set(counts.map((entry) => entry.tagId));
+    const unusedTagIds = tags.filter((tag) => !tagIdWithResponses.has(tag.id)).map((tag) => tag.id);
+
+    let deletedCount = 0;
+    for (const tagId of unusedTagIds) {
+      const result = await deleteTag(tagId);
+      if (result.ok) {
+        deletedCount++;
+      }
+    }
+
+    return successResponse({ deletedCount }, { requestId });
+  },
+});
