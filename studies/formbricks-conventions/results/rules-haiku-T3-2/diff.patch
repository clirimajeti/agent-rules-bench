+"use client";
+
+import { useTranslation } from "react-i18next";
+import { formatDate } from "@/lib/time";
+
+interface IAccountActivityProps {
+  createdAt: Date;
+  lastLoginAt: Date | null;
+  locale: string;
+}
+
+export const AccountActivity = ({ createdAt, lastLoginAt, locale }: Readonly<IAccountActivityProps>) => {
+  const { t } = useTranslation();
+
+  return (
+    <dl className="grid grid-cols-[max-content_1fr] gap-x-6 gap-y-2 text-sm">
+      <dt className="text-slate-500">{t("workspace.settings.profile.account_created")}</dt>
+      <dd className="text-slate-900">{formatDate(createdAt, locale)}</dd>
+      <dt className="text-slate-500">{t("workspace.settings.profile.last_login")}</dt>
+      <dd className="text-slate-900">
+        {lastLoginAt
+          ? formatDate(lastLoginAt, locale)
+          : t("workspace.settings.profile.no_sign_in_recorded")}
+      </dd>
+    </dl>
+  );
+};
diff --git a/apps/web/app/(app)/workspaces/[workspaceId]/settings/account/profile/components/DownloadAccountDataButton.tsx b/apps/web/app/(app)/workspaces/[workspaceId]/settings/account/profile/components/DownloadAccountDataButton.tsx
new file mode 100644
index 000000000..cb8e23b9b
--- /dev/null
+++ b/apps/web/app/(app)/workspaces/[workspaceId]/settings/account/profile/components/DownloadAccountDataButton.tsx
@@ -0,0 +1,63 @@
+"use client";
+
+import { QueryClient, QueryClientProvider, useMutation } from "@tanstack/react-query";
+import { useState } from "react";
+import toast from "react-hot-toast";
+import { useTranslation } from "react-i18next";
+import type { TAccountDataExport } from "@/modules/account/lib/account-data-export";
+import { Button } from "@/modules/ui/components/button";
+
+const ACCOUNT_DATA_EXPORT_URL = "/api/v3/account/data-export";
+const ACCOUNT_DATA_FILE_NAME = "formbricks-account-data.json";
+
+const fetchAccountDataExport = async (): Promise<TAccountDataExport> => {
+  const response = await fetch(ACCOUNT_DATA_EXPORT_URL, {
+    headers: { Accept: "application/json" },
+  });
+  if (!response.ok) {
+    throw new Error(`Account data export failed with status ${response.status}`);
+  }
+  const body = (await response.json()) as { data: TAccountDataExport };
+  return body.data;
+};
+
+const saveJsonFile = (data: TAccountDataExport) => {
+  const blob = new Blob([JSON.stringify(data, null, 2)], { type: "application/json" });
+  const url = URL.createObjectURL(blob);
+  const link = document.createElement("a");
+  link.href = url;
+  link.download = ACCOUNT_DATA_FILE_NAME;
+  document.body.appendChild(link);
+  link.click();
+  link.remove();
+  URL.revokeObjectURL(url);
+};
+
+const DownloadAccountDataButtonContent = () => {
+  const { t } = useTranslation();
+
+  const { mutate, isPending } = useMutation({
+    mutationFn: fetchAccountDataExport,
+    onSuccess: saveJsonFile,
+    onError: () => {
+      toast.error(t("workspace.settings.profile.download_my_data_failed"));
+    },
+  });
+
+  return (
+    <Button variant="secondary" loading={isPending} onClick={() => mutate()}>
+      {t("workspace.settings.profile.download_my_data")}
+    </Button>
+  );
+};
+
+// The profile page has no app-wide QueryClientProvider, so the button mounts its own.
+export const DownloadAccountDataButton = () => {
+  const [queryClient] = useState(() => new QueryClient());
+
+  return (
+    <QueryClientProvider client={queryClient}>
+      <DownloadAccountDataButtonContent />
+    </QueryClientProvider>
+  );
+};
