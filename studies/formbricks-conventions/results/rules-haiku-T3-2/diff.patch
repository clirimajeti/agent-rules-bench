@@ -0,0 +1,23 @@
+/**
+ * GET /api/v3/account/data-export - the signed-in user's own name, email, locale, notification settings and
+ * organization memberships. Session-only; used by the "Download my data" button on the profile page.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { problemNotFound, problemUnauthorized, successResponse } from "@/app/api/v3/lib/response";
+import { getAccountDataExport } from "@/modules/account/lib/account-data-export";
+
+export const GET = withV3ApiWrapper({
+  auth: "session",
+  handler: async ({ authentication, requestId, instance }) => {
+    if (!authentication || !("user" in authentication)) {
+      return problemUnauthorized(requestId, undefined, instance);
+    }
+
+    const data = await getAccountDataExport(authentication.user.id);
+    if (!data) {
+      return problemNotFound(requestId, "User", authentication.user.id, instance);
+    }
+
+    return successResponse(data, { requestId });
+  },
+});
