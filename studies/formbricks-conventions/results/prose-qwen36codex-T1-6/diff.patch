+/**
+ * POST /api/v3/api-keys/{apiKeyId}/rotate
+ *
+ * Rotate the secret for one API key. The key's label, permissions and workspace
+ * assignments are preserved; only the hashed secret and its lookup hash change.
+ *
+ * Returns the new plaintext secret (shown once) alongside the persisted key record.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { ZV3EmptyQuery } from "@/app/api/v3/lib/schemas";
+import { rotateV3ApiKey } from "../lib/operations";
+import { ZV3ApiKeyIdParams } from "../lib/schemas";
+
+export const POST = withV3ApiWrapper({
+  auth: "both",
+  action: "rotated",
+  targetType: "apiKey",
+  schemas: { params: ZV3ApiKeyIdParams, query: ZV3EmptyQuery },
+  handler: async ({ authentication, parsedInput, auditLog, requestId, instance }) =>
+    rotateV3ApiKey({
+      apiKeyId: parsedInput.params.apiKeyId,
+      authentication,
+      auditLog,
+      requestId,
+      instance,
+    }),
+});
