@@ -0,0 +1,61 @@
+import "server-only";
+import { assertCan } from "@/lib/authorization";
+import { getOrganizationIdFromApiKeyId } from "@/lib/utils/helper";
+import { rotateApiKey } from "@/modules/organization/settings/api-keys/lib/api-key";
+import {
+  type TV3HandlerParams,
+  problemBadRequest,
+  problemUnauthorized,
+  problemForbidden,
+} from "@/app/api/v3/lib/response";
+import type { TV3ApiKeyIdParams } from "./schemas";
+
+export async function rotateV3ApiKey({
+  apiKeyId,
+  authentication,
+  auditLog,
+  requestId,
+  instance,
+}: TV3HandlerParams<{ params: TV3ApiKeyIdParams }>): Promise<Response> {
+  // Must be authenticated
+  if (!authentication) {
+    return problemUnauthorized();
+  }
+
+  // Resolve the organization so we can authorize
+  let organizationId: string;
+  try {
+    organizationId = await getOrganizationIdFromApiKeyId(apiKeyId);
+  } catch {
+    return problemBadRequest({
+      field: "apiKeyId",
+      reason: "invalid",
+      message: "API key not found",
+    });
+  }
+
+  // Check authorization
+  try {
+    await assertCan({ type: "user", id: authentication.userId }, "apiKey.manage", {
+      type: "apiKey",
+      id: apiKeyId,
+    });
+  } catch {
+    return problemForbidden();
+  }
+
+  // Perform the rotation
+  const result = await rotateApiKey(apiKeyId, authentication.userId);
+
+  return Response.json({
+    data: {
+      id: result.id,
+      label: result.label,
+      createdAt: result.createdAt,
+      lastUsedAt: result.lastUsedAt,
+      organizationAccess: result.organizationAccess,
+      apiKeyWorkspaces: result.apiKeyWorkspaces,
+      actualKey: result.actualKey,
+    },
+  });
+}
