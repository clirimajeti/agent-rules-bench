diff --git a/apps/web/modules/integrations/webhooks/lib/api-client.ts b/apps/web/modules/integrations/webhooks/lib/api-client.ts
new file mode 100644
index 000000000..25fe9dce1
--- /dev/null
+++ b/apps/web/modules/integrations/webhooks/lib/api-client.ts
@@ -0,0 +1,30 @@
+import { parseV3ApiError } from "@/modules/api/lib/v3-client";
+
+/** The copy as the duplicate route returns it. Dates arrive as ISO strings. */
+export type TDuplicatedWebhook = {
+  id: string;
+  workspaceId: string;
+  name: string | null;
+  url: string;
+  source: string;
+  triggers: string[];
+  surveyIds: string[];
+  secret: string | null;
+  createdAt: string;
+  updatedAt: string;
+};
+
+/**
+ * `POST /api/v3/webhooks/{webhookId}/duplicate`. Throws a parsed `V3ApiError` on a non-2xx response, so the
+ * caller can show the server's own message.
+ */
+export const duplicateWebhook = async (webhookId: string): Promise<TDuplicatedWebhook> => {
+  const response = await fetch(`/api/v3/webhooks/${encodeURIComponent(webhookId)}/duplicate`, {
+    method: "POST",
+    cache: "no-store",
+  });
+  if (!response.ok) {
+    throw await parseV3ApiError(response);
+  }
+  return ((await response.json()) as { data: TDuplicatedWebhook }).data;
+};
