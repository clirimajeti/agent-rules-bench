+/**
+ * POST /api/v3/webhooks/{webhookId}/duplicate - copy a webhook with its URL, triggers and surveys, under a new
+ * name and a new signing secret.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { ZV3EmptyQuery } from "@/app/api/v3/lib/schemas";
+import { duplicateV3Webhook } from "../../lib/operations";
+import { ZV3WebhookIdParams } from "../../lib/schemas";
+
+export const POST = withV3ApiWrapper({
+  auth: "both",
+  action: "created",
+  targetType: "webhook",
+  schemas: { params: ZV3WebhookIdParams, query: ZV3EmptyQuery },
+  handler: async ({ authentication, parsedInput, auditLog, requestId, instance }) =>
+    duplicateV3Webhook({
+      webhookId: parsedInput.params.webhookId,
+      authentication,
+      auditLog,
+      requestId,
+      instance,
+    }),
+});
diff --git a/apps/web/app/api/v3/webhooks/lib/operations.ts b/apps/web/app/api/v3/webhooks/lib/operations.ts
new file mode 100644
index 000000000..d1ac793ea
--- /dev/null
+++ b/apps/web/app/api/v3/webhooks/lib/operations.ts
@@ -0,0 +1,98 @@
+import "server-only";
+import type { Webhook } from "@formbricks/database/prisma";
+import { logger } from "@formbricks/logger";
+import { InvalidInputError } from "@formbricks/types/errors";
+import { requireV3WorkspaceAccess } from "@/app/api/v3/lib/auth";
+import { mapV3ThrownError } from "@/app/api/v3/lib/errors";
+import { problemBadRequest, problemForbidden, successResponse } from "@/app/api/v3/lib/response";
+import type { TV3AuditLog, TV3Authentication } from "@/app/api/v3/lib/types";
+import { assertNewlyAttachedSurveysWorkspaceVisible } from "@/lib/survey/visibility/outbound";
+import { getWebhook } from "@/modules/api/v2/management/webhooks/[webhookId]/lib/webhook";
+import { createWebhook } from "@/modules/integrations/webhooks/lib/webhook";
+
+type TV3WebhookOperationContext = {
+  authentication: TV3Authentication;
+  auditLog?: TV3AuditLog;
+  requestId: string;
+  instance?: string;
+};
+
+/** The name a duplicate receives: "Copy of" plus the original's name, or its URL when it has none. */
+export const copyWebhookName = (original: { name: string | null; url: string }): string =>
+  `Copy of ${original.name || original.url}`;
+
+/** The webhook as the API returns it. The signing secret is included once, in the creating response. */
+const serializeV3Webhook = (webhook: Webhook) => ({
+  id: webhook.id,
+  workspaceId: webhook.workspaceId,
+  name: webhook.name,
+  url: webhook.url,
+  source: webhook.source,
+  triggers: webhook.triggers,
+  surveyIds: webhook.surveyIds,
+  secret: webhook.secret,
+  createdAt: webhook.createdAt,
+  updatedAt: webhook.updatedAt,
+});
+
+/**
+ * `POST /api/v3/webhooks/{webhookId}/duplicate` → 201 `{ data }`.
+ *
+ * The copy gets the original's URL, triggers and surveys, the name "Copy of" plus the original name, and a
+ * new signing secret. Its source is `user`, so its URL can be edited like any webhook the user created.
+ * A webhook that does not exist answers the same 403 as one the caller may not see.
+ */
+export async function duplicateV3Webhook({
+  webhookId,
+  authentication,
+  auditLog,
+  requestId,
+  instance,
+}: TV3WebhookOperationContext & { webhookId: string }): Promise<Response> {
+  const log = logger.withContext({ requestId, webhookId });
+
+  try {
+    const existing = await getWebhook(webhookId);
+    if (!existing.ok) return problemForbidden(requestId, undefined, instance);
+
+    const source = existing.data;
+    const access = await requireV3WorkspaceAccess(
+      authentication,
+      source.workspaceId,
+      "readWrite",
+      requestId,
+      instance
+    );
+    if (access instanceof Response) return access;
+
+    await assertNewlyAttachedSurveysWorkspaceVisible(source.surveyIds);
+
+    const copy = await createWebhook(access.workspaceId, {
+      name: copyWebhookName(source),
+      url: source.url,
+      source: "user",
+      triggers: source.triggers,
+      surveyIds: source.surveyIds,
+    });
+
+    const webhook = serializeV3Webhook(copy);
+    if (auditLog) {
+      auditLog.targetId = copy.id;
+      auditLog.organizationId = access.organizationId;
+      // The audit trail records the copy without its signing secret.
+      auditLog.newObject = { ...webhook, secret: null, duplicatedFrom: webhookId };
+    }
+
+    return successResponse(webhook, { requestId, status: 201 });
+  } catch (error) {
+    // createWebhook re-validates the URL. A URL the original was allowed to keep can fail that check now
+    // (for example after the internal-URL setting changed), and that is the caller's input, not a fault.
+    if (error instanceof InvalidInputError) {
+      return problemBadRequest(requestId, "Invalid webhook URL", {
+        instance,
+        invalid_params: [{ name: "url", reason: "The webhook URL is not allowed." }],
+      });
+    }
+    return mapV3ThrownError(error, { log, requestId, instance, operation: "webhooks.duplicate" });
+  }
+}
