index 000000000..8825a27f4
--- /dev/null
+++ b/apps/web/modules/organization/settings/api-keys/lib/rotate-api-key-client.ts
@@ -0,0 +1,21 @@
+import { parseV3ApiError } from "@/modules/api/lib/v3-client";
+import type { TApiKeyWithEnvironmentPermission } from "@/modules/organization/settings/api-keys/types/api-keys";
+
+/** A rotated key as the route returns it: the stored fields plus the new plaintext key, shown once. */
+export type TRotatedApiKey = Omit<TApiKeyWithEnvironmentPermission, "createdAt" | "lastUsedAt"> & {
+  createdAt: string;
+  lastUsedAt: string | null;
+  actualKey: string;
+};
+
+/** Replace an API key's secret, keeping its label and access settings. */
+export async function rotateApiKey(apiKeyId: string): Promise<TRotatedApiKey> {
+  const response = await fetch(`/api/internal/api-keys/${encodeURIComponent(apiKeyId)}/rotate`, {
+    method: "POST",
+    cache: "no-store",
+    signal: AbortSignal.timeout(15_000),
+  });
+  if (!response.ok) throw await parseV3ApiError(response);
+  const body = (await response.json()) as { data: TRotatedApiKey };
+  return body.data;
+}
