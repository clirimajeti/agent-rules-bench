@@ -0,0 +1,61 @@
+import "server-only";
+import { getV3AuthorizationActor } from "@/app/api/v3/lib/auth";
+import {
+  problemForbidden,
+  problemInternalError,
+  problemUnauthorized,
+  successResponse,
+} from "@/app/api/v3/lib/response";
+import type { TV3AuditLog, TV3Authentication } from "@/app/api/v3/lib/types";
+import { can } from "@/lib/authorization";
+import { getApiKeyOwnership, rotateApiKey } from "@/modules/organization/settings/api-keys/lib/api-key";
+import { canGrantOrganizationWriteAccess } from "@/modules/organization/settings/api-keys/lib/organization-access";
+
+/**
+ * Rotate an API key's secret. Needs `apiKey.manage` on the key, as deleting or renaming it does. A key that
+ * carries `accessControl.write` is a user-management credential, so minting a fresh secret for it also
+ * clears the user-management floor, as creating it did (ENG-3075). A missing key and one the caller may not
+ * manage get the same 403, so the route cannot probe which key ids exist.
+ */
+export async function rotateApiKeyOperation({
+  authentication,
+  apiKeyId,
+  requestId,
+  instance,
+  auditLog,
+}: {
+  authentication: TV3Authentication;
+  apiKeyId: string;
+  requestId: string;
+  instance?: string;
+  auditLog?: TV3AuditLog;
+}): Promise<Response> {
+  if (auditLog) auditLog.targetId = apiKeyId;
+
+  const actor = getV3AuthorizationActor(authentication);
+  if (actor?.type !== "user") {
+    return problemUnauthorized(requestId, "Session required", instance);
+  }
+
+  const existing = await getApiKeyOwnership(apiKeyId);
+  if (!existing || !(await can(actor, "apiKey.manage", { type: "apiKey", id: apiKeyId }))) {
+    return problemForbidden(requestId, undefined, instance);
+  }
+  if (auditLog) auditLog.organizationId = existing.organizationId;
+
+  if (
+    existing.organizationAccess?.accessControl?.write === true &&
+    !(await canGrantOrganizationWriteAccess(actor.id, existing.organizationId))
+  ) {
+    return problemForbidden(requestId, "User management is not allowed for your role", instance);
+  }
+
+  try {
+    const rotated = await rotateApiKey(apiKeyId);
+    // The audit trail records that a rotation happened, never the secret.
+    if (auditLog) auditLog.newObject = { id: rotated.id, label: rotated.label, rotated: true };
+    return successResponse(rotated, { requestId });
+  } catch {
+    return problemInternalError(requestId, "Unable to rotate API key", instance);
+  }
+}
