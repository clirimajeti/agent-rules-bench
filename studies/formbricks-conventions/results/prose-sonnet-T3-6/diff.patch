@@ -0,0 +1,14 @@
+/**
+ * GET /api/v3/account/data - the signed-in user's own personal data (name, email, locale, notification
+ * settings, organization memberships), for the profile page's "Download my data" button.
+ *
+ * Session-only, deliberately: the data is the session user's own, so an API key has no user to export.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { getV3AccountData } from "./lib/operations";
+
+export const GET = withV3ApiWrapper({
+  auth: "session",
+  handler: async ({ authentication, requestId, instance }) =>
+    getV3AccountData({ authentication, requestId, instance }),
+});
