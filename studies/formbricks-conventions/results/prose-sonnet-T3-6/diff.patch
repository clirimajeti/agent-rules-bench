@@ -0,0 +1,24 @@
+import type { TV3AccountData } from "@/app/api/v3/account/data/lib/operations";
+import { parseV3ApiError } from "@/modules/api/lib/v3-client";
+
+/** Client fetcher for `GET /api/v3/account/data`. Throws a parsed `V3ApiError` on a non-2xx response. */
+export async function getAccountData(): Promise<TV3AccountData> {
+  const response = await fetch("/api/v3/account/data", { cache: "no-store" });
+  if (!response.ok) {
+    throw await parseV3ApiError(response);
+  }
+  return ((await response.json()) as { data: TV3AccountData }).data;
+}
+
+/** Hands the data to the browser as a JSON file download. */
+export function downloadAccountDataAsJson(data: TV3AccountData, fileName: string): void {
+  const blob = new Blob([JSON.stringify(data, null, 2)], { type: "application/json" });
+  const url = URL.createObjectURL(blob);
+  const link = document.createElement("a");
+  link.href = url;
+  link.download = fileName;
+  document.body.appendChild(link);
+  link.click();
+  link.remove();
+  URL.revokeObjectURL(url);
+}
