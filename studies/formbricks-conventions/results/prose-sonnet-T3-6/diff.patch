+"use client";
+
+import { useMutation } from "@tanstack/react-query";
+import { useTranslation } from "react-i18next";
+import toast from "react-hot-toast";
+import {
+  downloadAccountDataAsJson,
+  getAccountData,
+} from "@/app/(app)/workspaces/[workspaceId]/settings/account/profile/lib/account-data-client";
+import { formatDateTimeForDisplay } from "@/lib/utils/datetime";
+import { getV3ApiErrorMessage } from "@/modules/api/lib/v3-client";
+import { Button } from "@/modules/ui/components/button";
+
+interface AccountActivityProps {
+  createdAt: Date;
+  lastLoginAt: Date | null;
+  locale: string;
+}
+
+export const AccountActivity = ({ createdAt, lastLoginAt, locale }: Readonly<AccountActivityProps>) => {
+  const { t } = useTranslation();
+
+  const downloadMutation = useMutation({
+    mutationFn: getAccountData,
+    onSuccess: (data) => downloadAccountDataAsJson(data, "formbricks-account-data.json"),
+    onError: (error) =>
+      toast.error(getV3ApiErrorMessage(error, t("workspace.settings.profile.download_my_data_failed"))),
+  });
+
+  return (
+    <div className="space-y-4">
+      <dl className="grid grid-cols-1 gap-4 sm:grid-cols-2">
+        <div>
+          <dt className="text-sm font-medium text-slate-900">
+            {t("workspace.settings.profile.account_created")}
+          </dt>
+          <dd className="mt-1 text-sm text-slate-600">{formatDateTimeForDisplay(createdAt, locale)}</dd>
+        </div>
+        <div>
+          <dt className="text-sm font-medium text-slate-900">{t("workspace.settings.profile.last_login")}</dt>
+          <dd className="mt-1 text-sm text-slate-600">
+            {lastLoginAt ? formatDateTimeForDisplay(lastLoginAt, locale) : t("workspace.settings.profile.never")}
+          </dd>
+        </div>
+      </dl>
+      <div className="flex flex-col gap-2 border-t border-slate-200 pt-4">
+        <p className="text-sm text-slate-500">{t("workspace.settings.profile.download_my_data_description")}</p>
+        <div>
+          <Button
+            type="button"
+            variant="secondary"
+            loading={downloadMutation.isPending}
+            onClick={() => downloadMutation.mutate()}>
+            {t("workspace.settings.profile.download_my_data")}
+          </Button>
+        </div>
+      </div>
+    </div>
+  );
+};
