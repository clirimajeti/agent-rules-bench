@@ -0,0 +1,63 @@
+import { prisma } from "@formbricks/database";
+import type { TV3Authentication } from "@/app/api/v3/lib/types";
+import { problemNotFound, problemUnauthorized, successResponse } from "@/app/api/v3/lib/response";
+
+export type TV3AccountData = {
+  name: string;
+  email: string;
+  locale: string;
+  notificationSettings: unknown;
+  organizationMemberships: { organizationName: string; role: string }[];
+};
+
+/**
+ * The signed-in user's own personal data, for the "Download my data" button on the profile page.
+ *
+ * Scoped to the session user by construction: the id comes from the session, never from the request.
+ * Only accepted memberships are listed, since a pending invite is not yet a membership.
+ */
+export async function getV3AccountData({
+  authentication,
+  requestId,
+  instance,
+}: {
+  authentication: TV3Authentication;
+  requestId: string;
+  instance: string;
+}): Promise<Response> {
+  if (!authentication || !("user" in authentication) || !authentication.user?.id) {
+    return problemUnauthorized(requestId, "Session required", instance);
+  }
+
+  const user = await prisma.user.findUnique({
+    where: { id: authentication.user.id },
+    select: {
+      name: true,
+      email: true,
+      locale: true,
+      notificationSettings: true,
+      memberships: {
+        where: { accepted: true },
+        select: { role: true, organization: { select: { name: true } } },
+        orderBy: { organization: { name: "asc" } },
+      },
+    },
+  });
+
+  if (!user) {
+    return problemNotFound(requestId, "User", authentication.user.id, instance);
+  }
+
+  const data: TV3AccountData = {
+    name: user.name,
+    email: user.email,
+    locale: user.locale,
+    notificationSettings: user.notificationSettings,
+    organizationMemberships: user.memberships.map((membership) => ({
+      organizationName: membership.organization.name,
+      role: membership.role,
+    })),
+  };
+
+  return successResponse(data, { requestId });
+}
