+/**
+ * POST /api/v3/webhooks/{webhookId}/duplicate - copy a webhook's URL, triggers and surveys under a new secret.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { ZV3EmptyQuery } from "@/app/api/v3/lib/schemas";
+import { duplicateV3Webhook } from "../../lib/duplicate-operations";
+import { ZV3WebhookIdParams } from "../../lib/schemas";
+
+export const POST = withV3ApiWrapper({
+  // Session only: this operation is not in the v3 OpenAPI spec yet, so it is not offered to API keys.
+  auth: "session",
+  action: "created",
+  targetType: "webhook",
+  schemas: { params: ZV3WebhookIdParams, query: ZV3EmptyQuery },
+  handler: ({ authentication, parsedInput, auditLog, requestId, instance }) =>
+    duplicateV3Webhook({
+      webhookId: parsedInput.params.webhookId,
+      authentication,
+      auditLog,
+      requestId,
+      instance,
+    }),
+});
diff --git a/apps/web/app/api/v3/webhooks/lib/duplicate-operations.ts b/apps/web/app/api/v3/webhooks/lib/duplicate-operations.ts
new file mode 100644
index 000000000..a2ad23a81
--- /dev/null
+++ b/apps/web/app/api/v3/webhooks/lib/duplicate-operations.ts
@@ -0,0 +1,96 @@
+import "server-only";
+import { prisma } from "@formbricks/database";
+import { logger } from "@formbricks/logger";
+import { requireV3WorkspaceAccess } from "@/app/api/v3/lib/auth";
+import { mapV3ThrownError } from "@/app/api/v3/lib/errors";
+import { createdResponse, problemForbidden } from "@/app/api/v3/lib/response";
+import type { TV3AuditLog, TV3Authentication } from "@/app/api/v3/lib/types";
+import { assertNewlyAttachedSurveysWorkspaceVisible } from "@/lib/survey/visibility/outbound";
+import { createWebhook } from "@/modules/integrations/webhooks/lib/webhook";
+
+/**
+ * `POST /api/v3/webhooks/{webhookId}/duplicate` → 201 `{ data }` with `Location`.
+ *
+ * Copies a webhook's URL, triggers and surveys into a new webhook named "Copy of" plus the original name
+ * (or its URL when it has none). The copy is created with a fresh signing secret, so it never shares the
+ * original's secret. The caller needs write access to the workspace the webhook belongs to; a webhook
+ * that does not exist answers the same 403 as one the caller may not see.
+ */
+export async function duplicateV3Webhook({
+  webhookId,
+  authentication,
+  requestId,
+  instance,
+  auditLog,
+}: {
+  webhookId: string;
+  authentication: TV3Authentication;
+  requestId: string;
+  instance: string;
+  auditLog?: TV3AuditLog;
+}): Promise<Response> {
+  const log = logger.withContext({ requestId, webhookId });
+
+  try {
+    const original = await prisma.webhook.findUnique({
+      where: { id: webhookId },
+      select: { name: true, url: true, triggers: true, surveyIds: true, workspaceId: true },
+    });
+    if (!original) {
+      return problemForbidden(requestId, undefined, instance);
+    }
+
+    const access = await requireV3WorkspaceAccess(
+      authentication,
+      original.workspaceId,
+      "readWrite",
+      requestId,
+      instance
+    );
+    if (access instanceof Response) {
+      return access;
+    }
+
+    // The copy attaches these surveys to a new webhook, so the workspace-visibility guard runs again.
+    await assertNewlyAttachedSurveysWorkspaceVisible(original.surveyIds);
+
+    const copy = await createWebhook(access.workspaceId, {
+      name: `Copy of ${original.name || original.url}`,
+      url: original.url,
+      source: "user",
+      triggers: original.triggers,
+      surveyIds: original.surveyIds,
+    });
+
+    if (auditLog) {
+      auditLog.targetId = copy.id;
+      auditLog.organizationId = access.organizationId;
+      auditLog.newObject = {
+        id: copy.id,
+        name: copy.name,
+        url: copy.url,
+        source: copy.source,
+        triggers: copy.triggers,
+        surveyIds: copy.surveyIds,
+        duplicatedFrom: webhookId,
+      };
+    }
+
+    return createdResponse(
+      {
+        id: copy.id,
+        name: copy.name,
+        url: copy.url,
+        source: copy.source,
+        triggers: copy.triggers,
+        surveyIds: copy.surveyIds,
+        workspaceId: copy.workspaceId,
+        createdAt: copy.createdAt.toISOString(),
+        updatedAt: copy.updatedAt.toISOString(),
+      },
+      { location: `/api/v2/management/webhooks/${copy.id}`, requestId }
+    );
+  } catch (error) {
+    return mapV3ThrownError(error, { log, requestId, instance, operation: "webhooks.duplicate" });
+  }
+}
