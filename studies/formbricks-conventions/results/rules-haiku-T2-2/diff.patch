index 000000000..9273c7008
--- /dev/null
+++ b/apps/web/modules/integrations/webhooks/lib/api-client.ts
@@ -0,0 +1,12 @@
+import { parseV3ApiError } from "@/modules/api/lib/v3-client";
+
+export async function duplicateWebhook(webhookId: string): Promise<void> {
+  const response = await fetch(`/api/v3/webhooks/${webhookId}/duplicate`, {
+    method: "POST",
+    cache: "no-store",
+  });
+
+  if (!response.ok) {
+    throw await parseV3ApiError(response);
+  }
+}
