+import { parseV3ApiError } from "@/modules/api/lib/v3-client";
+
+/**
+ * Client fetchers for the API key v3 routes. Every call throws a parsed `V3ApiError` on a non-2xx response,
+ * so the hooks can surface the server's own message.
+ */
+
+const BASE_PATH = "/api/v3/api-keys";
+
+async function request<T>(url: string, init: RequestInit): Promise<T> {
+  const response = await fetch(url, { cache: "no-store", ...init });
+  if (!response.ok) {
+    throw await parseV3ApiError(response);
+  }
+  return ((await response.json()) as { data: T }).data;
+}
+
+/** The new plaintext key is present only in this response; the server keeps no copy of it. */
+export type TRotatedApiKey = { id: string; actualKey: string; lastUsedAt: null };
+
+export async function rotateApiKey(params: { apiKeyId: string }): Promise<TRotatedApiKey> {
+  return request<TRotatedApiKey>(`${BASE_PATH}/${params.apiKeyId}/rotate`, { method: "POST" });
+}
