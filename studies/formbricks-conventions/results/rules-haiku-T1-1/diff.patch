+/**
+ * POST /api/v3/api-keys/{apiKeyId}/rotate - replace a key's secret, keeping its label and access settings.
+ * The response carries the new plaintext key once; it cannot be retrieved again. Session-only, matching
+ * the server action this replaces.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { rotateV3ApiKey } from "../../lib/operations";
+import { ZV3ApiKeyIdParams } from "../../lib/schemas";
+
+export const POST = withV3ApiWrapper({
+  auth: "session",
+  action: "updated",
+  targetType: "apiKey",
+  schemas: { params: ZV3ApiKeyIdParams },
+  handler: async ({ authentication, parsedInput, auditLog, requestId, instance }) =>
+    rotateV3ApiKey({
+      authentication,
+      apiKeyId: parsedInput.params.apiKeyId,
+      auditLog,
+      requestId,
+      instance,
+    }),
+});
diff --git a/apps/web/app/api/v3/api-keys/lib/operations.ts b/apps/web/app/api/v3/api-keys/lib/operations.ts
new file mode 100644
index 000000000..577d6683d
--- /dev/null
+++ b/apps/web/app/api/v3/api-keys/lib/operations.ts
@@ -0,0 +1,55 @@
+import "server-only";
+import { AuthorizationError } from "@formbricks/types/errors";
+import { getV3SessionUserId } from "@/app/api/v3/lib/auth";
+import { problemForbidden, problemUnauthorized, successResponse } from "@/app/api/v3/lib/response";
+import type { TV3AuditLog, TV3Authentication } from "@/app/api/v3/lib/types";
+import { assertCan } from "@/lib/authorization";
+import { getApiKey } from "@/lib/utils/services";
+import { rotateApiKey } from "@/modules/organization/settings/api-keys/lib/api-key";
+
+type TBaseParams = {
+  authentication: TV3Authentication;
+  requestId: string;
+  instance?: string;
+};
+
+/**
+ * Rotating a key replaces its secret, so the caller must hold `apiKey.manage` on that key. The
+ * organization is resolved from the key itself, never from the request. An unknown key answers 403, not
+ * 404, so a signed-in user cannot probe key ids across instances.
+ */
+export async function rotateV3ApiKey(
+  params: TBaseParams & { apiKeyId: string; auditLog?: TV3AuditLog }
+): Promise<Response> {
+  const { apiKeyId, authentication, auditLog, requestId, instance } = params;
+
+  const userId = getV3SessionUserId(authentication);
+  if (!userId) {
+    return problemUnauthorized(requestId, "Session required", instance);
+  }
+
+  const apiKey = await getApiKey(apiKeyId);
+  if (!apiKey) {
+    return problemForbidden(requestId, "You are not authorized to access this resource", instance);
+  }
+
+  try {
+    await assertCan({ type: "user", id: userId }, "apiKey.manage", { type: "apiKey", id: apiKeyId });
+  } catch (error) {
+    if (error instanceof AuthorizationError) {
+      return problemForbidden(requestId, "You are not authorized to access this resource", instance);
+    }
+    throw error;
+  }
+
+  if (auditLog) {
+    auditLog.organizationId = apiKey.organizationId;
+    auditLog.targetId = apiKeyId;
+  }
+
+  // The new plaintext is returned here once. It is not written to the audit log, and the old hashes are
+  // not either, so the log cannot be used to recover or replay either secret.
+  const rotated = await rotateApiKey(apiKeyId);
+
+  return successResponse({ id: rotated.id, actualKey: rotated.actualKey, lastUsedAt: null }, { requestId });
+}
