+post:
+  operationId: duplicateWebhookV3
+  # Session-only: this is the route behind the Duplicate button on the webhooks settings page. An
+  # API-key caller reading the published reference would only ever get a 401, so it is excluded from
+  # the generated docs pages like the `/tags` operations (ENG-2533); it stays in the bundle for the
+  # contract tests.
+  x-excluded: true
+  summary: Duplicate a webhook
+  description: |
+    Creates a new webhook in the same workspace with the source webhook's URL, triggers and surveys.
+    The copy is named `Copy of` plus the source's name (a source without a name gives a copy without
+    one), has `source: user`, and gets a signing secret of its own. The source webhook is unchanged.
+
+    The workspace is resolved from the webhook itself, so the caller cannot choose which scope it is
+    authorized against. Requires organization owner/manager, or a workspace team membership with
+    read-write permission. An unknown `webhookId` answers `403`, not `404`, so webhook ids cannot be
+    probed for existence.
+
+    Answers `422` when the copy cannot be created from the source as it is now: one of its surveys is
+    no longer visible to the whole workspace, or its URL is no longer an allowed webhook URL.
+
+    The response never carries the signing secret.
+  tags:
+    - V3 Webhooks
+  parameters:
+    - in: path
+      name: webhookId
+      required: true
+      schema:
+        type: string
+        format: cuid2
+      description: The webhook to copy.
+  responses:
+    "201":
+      description: Webhook duplicated successfully
+      content:
+        application/json:
+          schema:
+            type: object
+            required:
+              - data
+            properties:
+              data:
+                $ref: ../components/schemas/WebhookResource.yml
+    "400":
+      $ref: ../components/responses/V3BadRequest.yml
+    "401":
+      $ref: ../components/responses/V3UnauthorizedSession.yml
+    "403":
+      $ref: ../components/responses/V3Forbidden.yml
+    "422":
+      $ref: ../components/responses/V3UnprocessableContent.yml
+    "429":
+      $ref: ../components/responses/V3TooManyRequests.yml
+    "500":
+      $ref: ../components/responses/V3InternalServerError.yml
+  security:
+    - sessionAuth: []
