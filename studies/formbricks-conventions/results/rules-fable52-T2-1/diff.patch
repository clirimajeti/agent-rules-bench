@@ -0,0 +1,173 @@
+import { beforeEach, describe, expect, test, vi } from "vitest";
+import { InvalidInputError } from "@formbricks/types/errors";
+import { requireV3WorkspaceAccess } from "@/app/api/v3/lib/auth";
+import { findNotWorkspaceVisibleSurveyIds } from "@/lib/survey/visibility/outbound";
+import { getWebhook } from "@/modules/api/v2/management/webhooks/[webhookId]/lib/webhook";
+import { duplicateWebhook } from "@/modules/integrations/webhooks/lib/webhook";
+import { duplicateV3Webhook } from "./operations";
+
+vi.mock("server-only", () => ({}));
+
+vi.mock("@/app/api/v3/lib/auth", () => ({
+  requireV3WorkspaceAccess: vi.fn(),
+  getV3SessionUserId: vi.fn(() => null),
+}));
+vi.mock("@/lib/posthog", () => ({ capturePostHogEvent: vi.fn() }));
+vi.mock("@/lib/survey/visibility/outbound", () => ({
+  SURVEY_NOT_WORKSPACE_VISIBLE_MESSAGE: "not workspace visible",
+  findNotWorkspaceVisibleSurveyIds: vi.fn(),
+}));
+vi.mock("@/modules/api/v2/management/webhooks/[webhookId]/lib/webhook", () => ({ getWebhook: vi.fn() }));
+vi.mock("@/modules/integrations/webhooks/lib/webhook", () => ({ duplicateWebhook: vi.fn() }));
+vi.mock("@formbricks/logger", () => ({
+  logger: { withContext: vi.fn(() => ({ error: vi.fn(), warn: vi.fn() })) },
+}));
+
+const workspaceId = "clxx1234567890123456789012";
+const organizationId = "clzz1234567890123456789012";
+const webhookId = "clww1234567890123456789012";
+const copyId = "clcc1234567890123456789012";
+const surveyId = "clss1234567890123456789012";
+
+const source = {
+  id: webhookId,
+  name: "Slack relay",
+  url: "https://example.com/hook",
+  source: "zapier" as const,
+  triggers: ["responseFinished" as const],
+  surveyIds: [surveyId],
+  workspaceId,
+  createdAt: new Date("2026-04-21T10:00:00.000Z"),
+  updatedAt: new Date("2026-04-22T10:00:00.000Z"),
+};
+
+const copy = {
+  ...source,
+  id: copyId,
+  name: "Copy of Slack relay",
+  source: "user" as const,
+  createdAt: new Date("2026-05-01T10:00:00.000Z"),
+  updatedAt: new Date("2026-05-01T10:00:00.000Z"),
+  secret: "whsec_new",
+};
+
+const base = { authentication: null, requestId: "req_1", instance: "/api/v3/webhooks" };
+
+const findSource = () =>
+  vi.mocked(getWebhook).mockResolvedValue({ ok: true, data: source } as Awaited<
+    ReturnType<typeof getWebhook>
+  >);
+
+const grantAccess = () =>
+  vi
+    .mocked(requireV3WorkspaceAccess)
+    .mockResolvedValue({ workspaceId, organizationId } as Awaited<
+      ReturnType<typeof requireV3WorkspaceAccess>
+    >);
+
+beforeEach(() => {
+  vi.resetAllMocks();
+  vi.mocked(findNotWorkspaceVisibleSurveyIds).mockResolvedValue([]);
+});
+
+describe("duplicateV3Webhook", () => {
+  test("answers 201 with the copy, and never with its signing secret", async () => {
+    findSource();
+    grantAccess();
+    vi.mocked(duplicateWebhook).mockResolvedValue(copy);
+
+    const response = await duplicateV3Webhook({ ...base, webhookId });
+    const body = await response.json();
+
+    expect(response.status).toBe(201);
+    expect(duplicateWebhook).toHaveBeenCalledWith(source);
+    expect(body.data).toEqual({
+      id: copyId,
+      name: "Copy of Slack relay",
+      url: source.url,
+      source: "user",
+      triggers: source.triggers,
+      surveyIds: source.surveyIds,
+      workspaceId,
+      createdAt: "2026-05-01T10:00:00.000Z",
+      updatedAt: "2026-05-01T10:00:00.000Z",
+    });
+    expect(JSON.stringify(body)).not.toContain("whsec_new");
+  });
+
+  test("authorizes write access against the webhook's own workspace", async () => {
+    findSource();
+    grantAccess();
+    vi.mocked(duplicateWebhook).mockResolvedValue(copy);
+
+    await duplicateV3Webhook({ ...base, webhookId });
+
+    expect(requireV3WorkspaceAccess).toHaveBeenCalledWith(
+      null,
+      workspaceId,
+      "readWrite",
+      "req_1",
+      "/api/v3/webhooks"
+    );
+  });
+
+  test("403s an unknown webhook, so webhook ids cannot be probed for existence", async () => {
+    vi.mocked(getWebhook).mockResolvedValue({
+      ok: false,
+      error: { type: "not_found", details: [] },
+    } as Awaited<ReturnType<typeof getWebhook>>);
+
+    const response = await duplicateV3Webhook({ ...base, webhookId });
+
+    expect(response.status).toBe(403);
+    expect(requireV3WorkspaceAccess).not.toHaveBeenCalled();
+    expect(duplicateWebhook).not.toHaveBeenCalled();
+  });
+
+  test("propagates the authorization failure instead of creating a copy", async () => {
+    findSource();
+    vi.mocked(requireV3WorkspaceAccess).mockResolvedValue(new Response(null, { status: 403 }));
+
+    const response = await duplicateV3Webhook({ ...base, webhookId });
+
+    expect(response.status).toBe(403);
+    expect(duplicateWebhook).not.toHaveBeenCalled();
+  });
+
+  test("422s when the source carries a survey that is no longer workspace-visible", async () => {
+    findSource();
+    grantAccess();
+    vi.mocked(findNotWorkspaceVisibleSurveyIds).mockResolvedValue([surveyId]);
+
+    const response = await duplicateV3Webhook({ ...base, webhookId });
+
+    expect(response.status).toBe(422);
+    expect(findNotWorkspaceVisibleSurveyIds).toHaveBeenCalledWith(source.surveyIds);
+    expect(duplicateWebhook).not.toHaveBeenCalled();
+  });
+
+  test("422s when the source's URL is refused on create", async () => {
+    findSource();
+    grantAccess();
+    vi.mocked(duplicateWebhook).mockRejectedValue(new InvalidInputError("Internal URLs are not allowed"));
+
+    const response = await duplicateV3Webhook({ ...base, webhookId });
+    const body = await response.json();
+
+    expect(response.status).toBe(422);
+    expect(body.invalid_params).toEqual([{ name: "url", reason: "Internal URLs are not allowed" }]);
+  });
+
+  test("records the copy in the audit log without its secret", async () => {
+    findSource();
+    grantAccess();
+    vi.mocked(duplicateWebhook).mockResolvedValue(copy);
+    const auditLog = {} as NonNullable<Parameters<typeof duplicateV3Webhook>[0]["auditLog"]>;
+
+    await duplicateV3Webhook({ ...base, webhookId, auditLog });
+
+    expect(auditLog).toMatchObject({ organizationId, targetId: copyId });
+    expect(auditLog.newObject).toMatchObject({ id: copyId, name: "Copy of Slack relay" });
+    expect(auditLog.newObject).not.toHaveProperty("secret");
+  });
+});
diff --git a/apps/web/app/api/v3/webhooks/lib/operations.ts b/apps/web/app/api/v3/webhooks/lib/operations.ts
new file mode 100644
index 000000000..4d390dd4e
--- /dev/null
+++ b/apps/web/app/api/v3/webhooks/lib/operations.ts
@@ -0,0 +1,110 @@
+import "server-only";
+import { logger } from "@formbricks/logger";
+import { InvalidInputError } from "@formbricks/types/errors";
+import { getV3SessionUserId, requireV3WorkspaceAccess } from "@/app/api/v3/lib/auth";
+import { mapV3ThrownError } from "@/app/api/v3/lib/errors";
+import {
+  problemForbidden,
+  problemInternalError,
+  problemUnprocessableContent,
+  successResponse,
+} from "@/app/api/v3/lib/response";
+import type { TV3AuditLog, TV3Authentication } from "@/app/api/v3/lib/types";
+import { capturePostHogEvent } from "@/lib/posthog";
+import {
+  SURVEY_NOT_WORKSPACE_VISIBLE_MESSAGE,
+  findNotWorkspaceVisibleSurveyIds,
+} from "@/lib/survey/visibility/outbound";
+import { getWebhook } from "@/modules/api/v2/management/webhooks/[webhookId]/lib/webhook";
+import { duplicateWebhook } from "@/modules/integrations/webhooks/lib/webhook";
+import { serializeV3Webhook } from "../serializers";
+
+type TDuplicateV3WebhookParams = {
+  authentication: TV3Authentication;
+  webhookId: string;
+  auditLog?: TV3AuditLog;
+  requestId: string;
+  instance?: string;
+};
+
+/**
+ * Create a copy of a webhook in the same workspace: same URL, triggers and surveys, named "Copy of" plus
+ * the source's name, with a signing secret of its own.
+ *
+ * The workspace is resolved from the webhook itself, never from the caller, so a webhook id cannot be
+ * paired with a workspace the caller happens to have access to. An unknown webhook answers 403, not 404,
+ * like the other v3 resources: a 404 would let any signed-in user probe webhook ids for existence.
+ */
+export async function duplicateV3Webhook(params: TDuplicateV3WebhookParams): Promise<Response> {
+  const { authentication, webhookId, auditLog, requestId, instance } = params;
+
+  const source = await getWebhook(webhookId);
+  if (!source.ok) {
+    return source.error.type === "not_found"
+      ? problemForbidden(requestId, "You are not authorized to access this resource", instance)
+      : problemInternalError(requestId, "Unable to duplicate webhook", instance);
+  }
+
+  const access = await requireV3WorkspaceAccess(
+    authentication,
+    source.data.workspaceId,
+    "readWrite",
+    requestId,
+    instance
+  );
+  if (access instanceof Response) return access;
+
+  if (auditLog) auditLog.organizationId = access.organizationId;
+
+  // The copy is a new outbound connection, so every survey on it is newly attached. A survey that was
+  // restricted after the source was created stays on the source (dispatch skips it), but it must not be
+  // carried onto a new webhook (ENG-3283).
+  const blockedSurveyIds = await findNotWorkspaceVisibleSurveyIds(source.data.surveyIds);
+  if (blockedSurveyIds.length > 0) {
+    return problemUnprocessableContent(requestId, SURVEY_NOT_WORKSPACE_VISIBLE_MESSAGE, { instance });
+  }
+
+  let webhook: Awaited<ReturnType<typeof duplicateWebhook>>;
+  try {
+    webhook = await duplicateWebhook(source.data);
+  } catch (error) {
+    // The source's URL is validated again on create. A URL that was accepted when the source was saved
+    // can be refused now (for example after internal URLs were disallowed): the caller's to fix, not a 500.
+    if (error instanceof InvalidInputError) {
+      return problemUnprocessableContent(requestId, "The webhook URL is not allowed", {
+        instance,
+        invalid_params: [{ name: "url", reason: error.message }],
+      });
+    }
+    return mapV3ThrownError(error, {
+      log: logger.withContext({ requestId, webhookId }),
+      requestId,
+      instance: instance ?? "",
+      operation: "webhooks.duplicate",
+    });
+  }
+
+  // The serializer drops the secret, so it goes neither into the audit trail nor into the response.
+  const data = serializeV3Webhook(webhook);
+
+  if (auditLog) {
+    auditLog.targetId = webhook.id;
+    auditLog.newObject = data;
+  }
+
+  const userId = getV3SessionUserId(authentication);
+  if (userId) {
+    capturePostHogEvent(
+      userId,
+      "integration_connected",
+      {
+        integration_type: "webhook",
+        organization_id: access.organizationId,
+        workspace_id: access.workspaceId,
+      },
+      { organizationId: access.organizationId, workspaceId: access.workspaceId }
+    );
+  }
+
+  return successResponse(data, { requestId, status: 201 });
+}
