+/**
+ * @vitest-environment jsdom
+ */
+import { QueryClient, QueryClientProvider } from "@tanstack/react-query";
+import { renderHook, waitFor } from "@testing-library/react";
+import { type ReactNode, createElement } from "react";
+import { afterEach, beforeEach, describe, expect, test, vi } from "vitest";
+import { useDuplicateWebhook } from "./use-duplicate-webhook";
+
+const refresh = vi.hoisted(() => vi.fn());
+
+vi.mock("next/navigation", () => ({ useRouter: () => ({ refresh }) }));
+
+const webhookId = "clww1234567890123456789012";
+
+const wrapper = () => {
+  const queryClient = new QueryClient({ defaultOptions: { mutations: { retry: false } } });
+  const Wrapper = ({ children }: Readonly<{ children: ReactNode }>) =>
+    createElement(QueryClientProvider, { client: queryClient }, children);
+  Wrapper.displayName = "useDuplicateWebhookTestWrapper";
+  return Wrapper;
+};
+
+describe("useDuplicateWebhook", () => {
+  beforeEach(() => {
+    (globalThis as typeof globalThis & { IS_REACT_ACT_ENVIRONMENT?: boolean }).IS_REACT_ACT_ENVIRONMENT =
+      true;
+    refresh.mockReset();
+    vi.stubGlobal("fetch", vi.fn());
+  });
+
+  afterEach(() => {
+    vi.unstubAllGlobals();
+  });
+
+  test("posts to the duplicate sub-route, then refreshes the server-rendered list", async () => {
+    vi.mocked(global.fetch).mockResolvedValue(
+      new Response(JSON.stringify({ data: { id: "clcc1234567890123456789012" } }), {
+        status: 201,
+        headers: { "Content-Type": "application/json" },
+      })
+    );
+
+    const { result } = renderHook(() => useDuplicateWebhook(), { wrapper: wrapper() });
+    result.current.mutate({ webhookId });
+
+    await waitFor(() => expect(result.current.isSuccess).toBe(true));
+    expect(vi.mocked(global.fetch).mock.calls[0][0]).toBe(`/api/v3/webhooks/${webhookId}/duplicate`);
+    expect(vi.mocked(global.fetch).mock.calls[0][1]).toMatchObject({ method: "POST" });
+    // Without the refresh the copy exists but the list, which the server page renders, does not show it.
+    expect(refresh).toHaveBeenCalledTimes(1);
+  });
+
+  test("surfaces a rejected request and leaves the list alone", async () => {
+    vi.mocked(global.fetch).mockResolvedValue(
+      new Response(
+        JSON.stringify({ title: "Forbidden", status: 403, detail: "not yours", code: "forbidden" }),
+        { status: 403, headers: { "Content-Type": "application/problem+json" } }
+      )
+    );
+
+    const { result } = renderHook(() => useDuplicateWebhook(), { wrapper: wrapper() });
+
+    await expect(result.current.mutateAsync({ webhookId })).rejects.toThrow("not yours");
+    expect(refresh).not.toHaveBeenCalled();
+  });
+});
diff --git a/apps/web/modules/integrations/webhooks/hooks/use-duplicate-webhook.ts b/apps/web/modules/integrations/webhooks/hooks/use-duplicate-webhook.ts
