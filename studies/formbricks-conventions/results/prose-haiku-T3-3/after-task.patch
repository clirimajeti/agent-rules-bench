@@ -0,0 +1,32 @@
+"use client";
+
+import { useTranslation } from "react-i18next";
+import { TUserDataExport } from "@/modules/account/lib/user-data-export";
+import { Button } from "@/modules/ui/components/button";
+
+interface DownloadUserDataButtonProps {
+  data: TUserDataExport;
+}
+
+export const DownloadUserDataButton = ({ data }: DownloadUserDataButtonProps) => {
+  const { t } = useTranslation();
+
+  const handleDownload = () => {
+    const blob = new Blob([JSON.stringify(data, null, 2)], { type: "application/json" });
+    const url = URL.createObjectURL(blob);
+
+    const link = document.createElement("a");
+    link.href = url;
+    link.download = "formbricks-user-data.json";
+    link.click();
+
+    // Revoke after the click has been dispatched so the browser can start the download first.
+    setTimeout(() => URL.revokeObjectURL(url), 0);
+  };
+
+  return (
+    <Button type="button" variant="secondary" onClick={handleDownload}>
+      {t("workspace.settings.profile.download_my_data")}
+    </Button>
+  );
+};
