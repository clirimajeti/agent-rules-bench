diff --git a/apps/web/modules/account/lib/user-data-export.ts b/apps/web/modules/account/lib/user-data-export.ts
new file mode 100644
index 000000000..ee6251082
--- /dev/null
+++ b/apps/web/modules/account/lib/user-data-export.ts
@@ -0,0 +1,33 @@
+import type { TOrganizationRole } from "@formbricks/types/memberships";
+import type { TUser, TUserLocale, TUserNotificationSettings } from "@formbricks/types/user";
+
+export type TUserDataExportOrganization = {
+  name: string;
+  role: TOrganizationRole;
+};
+
+export type TUserDataExport = {
+  name: string;
+  email: string;
+  locale: TUserLocale;
+  notificationSettings: TUserNotificationSettings;
+  organizations: TUserDataExportOrganization[];
+};
+
+/**
+ * The data the account "Download my data" button exports. Only the fields listed here are included;
+ * the object is serialized as-is, so anything added to it becomes part of the downloaded file.
+ */
+export const buildUserDataExport = (
+  user: Pick<TUser, "name" | "email" | "locale" | "notificationSettings">,
+  organizations: TUserDataExportOrganization[]
+): TUserDataExport => ({
+  name: user.name,
+  email: user.email,
+  locale: user.locale,
+  notificationSettings: user.notificationSettings,
+  organizations: organizations.map((organization) => ({
+    name: organization.name,
+    role: organization.role,
+  })),
+});
