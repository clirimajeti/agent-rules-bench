+/**
+ * POST /api/v3/api-keys/{apiKeyId}/rotate — replace a key's secret, keeping its label and access, and
+ * return the new secret once. Session-only: rotation hands back a working credential, so it backs the
+ * organization API keys settings page and is not open to API keys.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { rotateV3ApiKey } from "../../lib/operations";
+import { ZV3ApiKeyIdParams } from "../../lib/schemas";
+
+export const POST = withV3ApiWrapper({
+  auth: "session",
+  action: "updated",
+  targetType: "apiKey",
+  schemas: { params: ZV3ApiKeyIdParams },
+  handler: async ({ authentication, parsedInput, auditLog, requestId, instance }) =>
+    rotateV3ApiKey({
+      authentication,
+      apiKeyId: parsedInput.params.apiKeyId,
+      auditLog,
+      requestId,
+      instance,
+    }),
+});
diff --git a/apps/web/app/api/v3/api-keys/lib/operations.ts b/apps/web/app/api/v3/api-keys/lib/operations.ts
new file mode 100644
index 000000000..21d50b304
--- /dev/null
+++ b/apps/web/app/api/v3/api-keys/lib/operations.ts
@@ -0,0 +1,77 @@
+import "server-only";
+import { logger } from "@formbricks/logger";
+import { AuthorizationError, OperationNotAllowedError, ResourceNotFoundError } from "@formbricks/types/errors";
+import { getV3SessionUserId } from "@/app/api/v3/lib/auth";
+import { problemForbidden, problemUnauthorized, successResponse } from "@/app/api/v3/lib/response";
+import type { TV3AuditLog, TV3Authentication } from "@/app/api/v3/lib/types";
+import { assertCan } from "@/lib/authorization";
+import {
+  getApiKeyAuthorizationScope,
+  rotateApiKey,
+} from "@/modules/organization/settings/api-keys/lib/api-key";
+import { assertCanGrantOrganizationAccess } from "@/modules/organization/settings/api-keys/lib/organization-access";
+import type { TV3RotatedApiKey } from "./schemas";
+
+type TRotateParams = {
+  authentication: TV3Authentication;
+  apiKeyId: string;
+  auditLog?: TV3AuditLog;
+  requestId: string;
+  instance?: string;
+};
+
+/**
+ * Replace a key's secret and return the new one once.
+ *
+ * Authorization asks two questions, because rotating hands the caller a working credential:
+ *   - `apiKey.manage` on the key, the same check `deleteApiKeyAction` and `updateApiKeyAction` make;
+ *   - the ENG-3075 user-management floor for a key with `accessControl.write`. Without it a manager who
+ *     may not grant that access could rotate an owner's key and walk away with a secret that carries it,
+ *     which is exactly what `createApiKeyAction` refuses to mint.
+ *
+ * An unknown key answers 403, not 404, so key ids cannot be probed across organizations.
+ */
+export async function rotateV3ApiKey(params: TRotateParams): Promise<Response> {
+  const { authentication, apiKeyId, auditLog, requestId, instance } = params;
+
+  const userId = getV3SessionUserId(authentication);
+  if (!userId) {
+    return problemUnauthorized(requestId, "Session required", instance);
+  }
+
+  const apiKey = await getApiKeyAuthorizationScope(apiKeyId);
+  if (!apiKey) {
+    return problemForbidden(requestId, "You are not authorized to access this resource", instance);
+  }
+
+  try {
+    await assertCan({ type: "user", id: userId }, "apiKey.manage", { type: "apiKey", id: apiKeyId });
+    await assertCanGrantOrganizationAccess(userId, apiKey.organizationId, apiKey.organizationAccess);
+  } catch (error) {
+    if (
+      error instanceof AuthorizationError ||
+      error instanceof OperationNotAllowedError ||
+      error instanceof ResourceNotFoundError
+    ) {
+      logger
+        .withContext({ requestId, apiKeyId })
+        .warn({ statusCode: 403, errorCode: error.name }, "API key rotation not permitted");
+      return problemForbidden(requestId, "You are not authorized to access this resource", instance);
+    }
+    throw error;
+  }
+
+  if (auditLog) {
+    auditLog.organizationId = apiKey.organizationId;
+    auditLog.targetId = apiKeyId;
+    auditLog.oldObject = apiKey;
+  }
+
+  const rotated = await rotateApiKey(apiKeyId);
+
+  // The audit trail records that the secret changed, never the secret itself.
+  if (auditLog) auditLog.newObject = { ...apiKey, secretRotated: true };
+
+  const body: TV3RotatedApiKey = { id: rotated.id, apiKey: rotated.actualKey };
+  return successResponse(body, { requestId });
+}
