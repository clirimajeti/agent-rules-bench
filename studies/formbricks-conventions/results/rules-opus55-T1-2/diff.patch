--- /dev/null
+++ b/docs/api-v3-reference/src/paths/api_v3_api-keys_{apiKeyId}_rotate.yml
@@ -0,0 +1,63 @@
+post:
+  operationId: rotateApiKeyV3
+  # Session-only by design: rotating a key returns a usable secret, so only a signed-in organization
+  # owner or manager may do it, never another API key. Excluded from the generated docs pages for the
+  # same reason as the `/tags` operations; it stays in the bundle for the contract tests.
+  x-excluded: true
+  summary: Rotate an API key
+  description: |
+    Replaces the key's secret with a new one. The key keeps its id, label, organization access and
+    workspace permissions; the old secret stops working at once. `lastUsedAt` is reset to `null`, since
+    it describes the secret, and the new one has not been used yet.
+
+    The new secret is returned once, in `data.apiKey`, and cannot be read again.
+
+    Session cookie only. Requires the caller to manage this key (organization owner or manager). A key
+    with organization user-management write access can only be rotated by a caller who could grant that
+    access, because rotating hands the caller a credential that carries it.
+
+    An unknown `apiKeyId` answers `403`, not `404`, so key ids cannot be probed for existence.
+  tags:
+    - V3 API Keys
+  parameters:
+    - in: path
+      name: apiKeyId
+      required: true
+      schema:
+        type: string
+        format: cuid2
+  responses:
+    "200":
+      description: API key rotated successfully
+      content:
+        application/json:
+          schema:
+            type: object
+            required:
+              - data
+            properties:
+              data:
+                type: object
+                required:
+                  - id
+                  - apiKey
+                properties:
+                  id:
+                    type: string
+                    format: cuid2
+                    description: The rotated key's id. Unchanged by the rotation.
+                  apiKey:
+                    type: string
+                    description: The new secret, in the `fbk_` format. Shown once; store it now.
+    "400":
+      $ref: ../components/responses/V3BadRequest.yml
+    "401":
+      $ref: ../components/responses/V3UnauthorizedSession.yml
+    "403":
+      $ref: ../components/responses/V3Forbidden.yml
+    "429":
+      $ref: ../components/responses/V3TooManyRequests.yml
+    "500":
+      $ref: ../components/responses/V3InternalServerError.yml
+  security:
+    - sessionAuth: []
