+++ b/apps/web/modules/workspaces/settings/tags/lib/api-client.ts
@@ -43,3 +43,12 @@ export async function mergeTags(params: { tagId: string; newTagId: string }): Pr
     body: JSON.stringify({ newTagId: params.newTagId }),
   });
 }
+
+export async function bulkDeleteUnusedTags(params: { workspaceId: string }): Promise<{ deletedCount: number }> {
+  const query = new URLSearchParams({ workspaceId: params.workspaceId });
+  return request<{ deletedCount: number }>(`${BASE_PATH}/bulk-delete-unused?${query.toString()}`, {
+    method: "POST",
+    headers: { "Content-Type": "application/json" },
+    body: JSON.stringify({ workspaceId: params.workspaceId }),
+  });
+}
