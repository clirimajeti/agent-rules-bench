@@ -0,0 +1,54 @@
+post:
+  operationId: duplicateWebhookV3
+  # Session-only by design, like the tags operations. Excluded from the generated docs pages; the
+  # operation stays in the bundle for the contract tests.
+  x-excluded: true
+  summary: Duplicate a webhook
+  description: |
+    Creates a webhook in the same workspace with the same URL, triggers and surveys as `{webhookId}`.
+    The copy is named `Copy of <original name>` and gets a newly generated signing secret of its own.
+
+    An unknown `webhookId` answers `403`, not `404`, so webhook ids cannot be probed for existence.
+    The copy goes through the same URL validation and survey visibility rules as a new webhook, so it
+    answers `403` or `422` where creating the original again would.
+  tags:
+    - V3 Webhooks
+  parameters:
+    - in: path
+      name: webhookId
+      required: true
+      schema:
+        type: string
+        format: cuid2
+      description: The webhook to copy.
+  responses:
+    "200":
+      description: Webhook duplicated successfully
+      headers:
+        X-Request-Id:
+          schema:
+            type: string
+          description: Request correlation ID
+      content:
+        application/json:
+          schema:
+            type: object
+            required:
+              - data
+            properties:
+              data:
+                $ref: ../components/schemas/WebhookResource.yml
+    "400":
+      $ref: ../components/responses/V3BadRequest.yml
+    "401":
+      $ref: ../components/responses/V3UnauthorizedSession.yml
+    "403":
+      $ref: ../components/responses/V3Forbidden.yml
+    "422":
+      $ref: ../components/responses/V3UnprocessableContent.yml
+    "429":
+      $ref: ../components/responses/V3TooManyRequests.yml
+    "500":
+      $ref: ../components/responses/V3InternalServerError.yml
+  security:
+    - sessionAuth: []
