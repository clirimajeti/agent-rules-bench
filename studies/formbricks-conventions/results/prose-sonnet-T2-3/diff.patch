+export const POST = withV3ApiWrapper({
+  auth: "session",
+  action: "created",
+  targetType: "webhook",
+  schemas: { params: ZV3WebhookIdParams },
+  handler: async ({ authentication, parsedInput, auditLog, requestId, instance }) =>
+    duplicateV3Webhook({
+      authentication,
+      webhookId: parsedInput.params.webhookId,
+      auditLog,
+      requestId,
+      instance,
+    }),
+});
diff --git a/apps/web/app/api/v3/webhooks/lib/operations.ts b/apps/web/app/api/v3/webhooks/lib/operations.ts
new file mode 100644
index 000000000..4c02e0dbd
--- /dev/null
+++ b/apps/web/app/api/v3/webhooks/lib/operations.ts
@@ -0,0 +1,88 @@
+import "server-only";
+import { prisma } from "@formbricks/database";
+import { InvalidInputError, OperationNotAllowedError } from "@formbricks/types/errors";
+import { requireV3WorkspaceAccess } from "@/app/api/v3/lib/auth";
+import {
+  problemForbidden,
+  problemUnprocessableContent,
+  successResponse,
+} from "@/app/api/v3/lib/response";
+import type { TV3AuditLog, TV3Authentication } from "@/app/api/v3/lib/types";
+import { assertNewlyAttachedSurveysWorkspaceVisible } from "@/lib/survey/visibility/outbound";
+import { createWebhook, getWebhooks } from "@/modules/integrations/webhooks/lib/webhook";
+import { serializeV3Webhook } from "../serializers";
+
+type TBaseParams = {
+  authentication: TV3Authentication;
+  requestId: string;
+  instance?: string;
+};
+
+export async function listV3Webhooks(params: TBaseParams & { workspaceId: string }): Promise<Response> {
+  const { authentication, workspaceId, requestId, instance } = params;
+
+  const access = await requireV3WorkspaceAccess(authentication, workspaceId, "read", requestId, instance);
+  if (access instanceof Response) return access;
+
+  const webhooks = await getWebhooks(access.workspaceId);
+
+  return successResponse(webhooks.map(serializeV3Webhook), { requestId });
+}
+
+/**
+ * Copy a webhook into the same workspace: same URL, triggers and surveys, named "Copy of <name>", with a
+ * secret of its own (`createWebhook` generates one, so the original's secret is never reused).
+ *
+ * The workspace is resolved from the webhook, never from the request. An unknown webhook answers 403, not
+ * 404, so a signed-in user cannot probe webhook ids across the instance.
+ */
+export async function duplicateV3Webhook(
+  params: TBaseParams & { webhookId: string; auditLog?: TV3AuditLog }
+): Promise<Response> {
+  const { authentication, webhookId, auditLog, requestId, instance } = params;
+
+  const original = await prisma.webhook.findUnique({ where: { id: webhookId } });
+  if (!original) {
+    return problemForbidden(requestId, "You are not authorized to access this resource", instance);
+  }
+
+  const access = await requireV3WorkspaceAccess(
+    authentication,
+    original.workspaceId,
+    "readWrite",
+    requestId,
+    instance
+  );
+  if (access instanceof Response) return access;
+
+  try {
+    // The copy attaches the surveys anew, so it faces the same outbound visibility rule as a create.
+    await assertNewlyAttachedSurveysWorkspaceVisible(original.surveyIds);
+
+    const copy = await createWebhook(original.workspaceId, {
+      name: `Copy of ${original.name ?? ""}`.trim(),
+      url: original.url,
+      source: "user",
+      triggers: original.triggers,
+      surveyIds: original.surveyIds,
+    });
+
+    if (auditLog) {
+      auditLog.organizationId = access.organizationId;
+      auditLog.targetId = copy.id;
+      auditLog.newObject = { ...copy, secret: undefined };
+    }
+
+    return successResponse(serializeV3Webhook(copy), { requestId });
+  } catch (error) {
+    if (error instanceof OperationNotAllowedError) {
+      return problemForbidden(requestId, error.message, instance);
+    }
+    // The URL is validated again at copy time, so a host that stopped resolving to a public address, or a
+    // setting that changed since the original was saved, is the caller's to resolve.
+    if (error instanceof InvalidInputError) {
+      return problemUnprocessableContent(requestId, error.message, { instance });
+    }
+    throw error;
+  }
+}
