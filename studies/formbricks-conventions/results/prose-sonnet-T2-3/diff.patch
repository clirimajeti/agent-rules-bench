+/**
+ * GET /api/v3/webhooks — list a workspace's webhooks, newest first.
+ *
+ * Session-only, like the server actions this replaces: the response carries each webhook's signing secret.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { listV3Webhooks } from "./lib/operations";
+import { ZV3WebhookListQuery } from "./lib/schemas";
+
+export const GET = withV3ApiWrapper({
+  auth: "session",
+  schemas: { query: ZV3WebhookListQuery },
+  handler: async ({ authentication, parsedInput, requestId, instance }) =>
+    listV3Webhooks({
+      authentication,
+      workspaceId: parsedInput.query.workspaceId,
+      requestId,
+      instance,
+    }),
+});
