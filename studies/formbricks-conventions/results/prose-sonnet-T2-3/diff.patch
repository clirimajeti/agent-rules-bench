@@ -0,0 +1,32 @@
+import type { Webhook } from "@formbricks/database/prisma";
+
+/**
+ * The signing secret is part of the resource on purpose: the webhook detail modal shows it, and the
+ * page already handed it to the client before this route existed. The routes are session-only, so no
+ * API-key caller can read it.
+ */
+export type TV3Webhook = {
+  id: string;
+  name: string | null;
+  url: string;
+  source: string;
+  triggers: string[];
+  surveyIds: string[];
+  workspaceId: string;
+  secret: string | null;
+  createdAt: string;
+  updatedAt: string;
+};
+
+export const serializeV3Webhook = (webhook: Webhook): TV3Webhook => ({
+  id: webhook.id,
+  name: webhook.name,
+  url: webhook.url,
+  source: webhook.source,
+  triggers: webhook.triggers,
+  surveyIds: webhook.surveyIds,
+  workspaceId: webhook.workspaceId,
+  secret: webhook.secret,
+  createdAt: webhook.createdAt.toISOString(),
+  updatedAt: webhook.updatedAt.toISOString(),
+});
