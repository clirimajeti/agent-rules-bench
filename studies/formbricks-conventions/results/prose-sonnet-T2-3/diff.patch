+get:
+  operationId: listWebhooksV3
+  # Session-only by design, like the tags operations: the response carries signing secrets, so it is
+  # excluded from the generated docs pages. The operation stays in the bundle for the contract tests.
+  x-excluded: true
+  summary: List webhooks
+  description: |
+    Returns a workspace's webhooks, newest first, each with its signing secret.
+
+    Session cookie only. Webhooks are managed from the Formbricks app (Workspace settings → Integrations →
+    Webhooks); this endpoint backs that screen, so it does not accept `x-api-key`.
+  tags:
+    - V3 Webhooks
+  parameters:
+    - in: query
+      name: workspaceId
+      required: true
+      schema:
+        type: string
+        format: cuid2
+      description: |
+        Workspace identifier. This is the canonical container ID for v3 APIs.
+  responses:
+    "200":
+      description: Webhooks retrieved successfully
+      headers:
+        X-Request-Id:
+          schema:
+            type: string
+          description: Request correlation ID
+        Cache-Control:
+          schema:
+            type: string
+          example: private, no-store
+      content:
+        application/json:
+          schema:
+            type: object
+            required:
+              - data
+            properties:
+              data:
+                type: array
+                items:
+                  $ref: ../components/schemas/WebhookResource.yml
+    "400":
+      $ref: ../components/responses/V3BadRequest.yml
+    "401":
+      $ref: ../components/responses/V3UnauthorizedSession.yml
+    "403":
+      $ref: ../components/responses/V3Forbidden.yml
+    "429":
+      $ref: ../components/responses/V3TooManyRequests.yml
+    "500":
+      $ref: ../components/responses/V3InternalServerError.yml
