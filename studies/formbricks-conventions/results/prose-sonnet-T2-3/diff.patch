+const webhookCacheKeyBase = ["workspace-webhooks"] as const;
+
+export const webhookKeys = {
+  all: webhookCacheKeyBase,
+  list: (workspaceId: string) => [...webhookCacheKeyBase, "list", workspaceId] as const,
+};
