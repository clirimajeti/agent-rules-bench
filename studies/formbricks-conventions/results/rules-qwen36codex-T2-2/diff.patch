diff --git a/apps/web/modules/integrations/webhooks/hooks/use-duplicate-webhook.ts b/apps/web/modules/integrations/webhooks/hooks/use-duplicate-webhook.ts
new file mode 100644
index 000000000..dcdded1b7
--- /dev/null
+++ b/apps/web/modules/integrations/webhooks/hooks/use-duplicate-webhook.ts
@@ -0,0 +1,22 @@
+"use client";
+
+import { useMutation, useQueryClient } from "@tanstack/react-query";
+import { duplicateWebhook } from "@/modules/integrations/webhooks/lib/api-client";
+import { webhookKeys } from "@/modules/integrations/webhooks/lib/query";
+
+/**
+ * Hook that duplicates a webhook via the v3 API.
+ *
+ * On success, invalidates the workspace's webhook list so the table refreshes with the new row.
+ */
+export const useDuplicateWebhook = () => {
+  const queryClient = useQueryClient();
+
+  return useMutation({
+    mutationFn: (webhookId: string) => duplicateWebhook(webhookId),
+    onSuccess: (_data, webhookId) => {
+      // Invalidate all workspace-scoped webhook lists so the table picks up the new row.
+      queryClient.invalidateQueries({ queryKey: webhookKeys.lists() });
+    },
+  });
+};
diff --git a/apps/web/modules/integrations/webhooks/lib/api-client.ts b/apps/web/modules/integrations/webhooks/lib/api-client.ts
new file mode 100644
index 000000000..82d3fd499
--- /dev/null
+++ b/apps/web/modules/integrations/webhooks/lib/api-client.ts
@@ -0,0 +1,28 @@
+import { parseV3ApiError } from "@/modules/api/lib/v3-client";
+import { Webhook } from "@formbricks/database/prisma";
+
+/**
+ * Client fetchers for the internal webhook management routes.
+ */
+
+const BASE_PATH = "/api/v3/webhooks";
+const MUTATION_TIMEOUT_MS = 15_000;
+
+/**
+ * Duplicate (clone) a webhook. The new webhook gets the name "Copy of <original name>".
+ *
+ * Resolves with the newly created webhook on success; throws a parsed `V3ApiError` on a
+ * non-2xx response.
+ */
+export async function duplicateWebhook(webhookId: string): Promise<Webhook> {
+  const response = await fetch(`${BASE_PATH}/${encodeURIComponent(webhookId)}/duplicate`, {
+    method: "POST",
+    signal: AbortSignal.timeout(MUTATION_TIMEOUT_MS),
+  });
+
+  if (!response.ok) {
+    throw await parseV3ApiError(response);
+  }
+
+  return ((await response.json()) as { data: Webhook }).data;
+}
diff --git a/apps/web/modules/integrations/webhooks/lib/query.ts b/apps/web/modules/integrations/webhooks/lib/query.ts
new file mode 100644
index 000000000..7a0762d80
--- /dev/null
+++ b/apps/web/modules/integrations/webhooks/lib/query.ts
@@ -0,0 +1,13 @@
+import type { Webhook } from "@formbricks/database/prisma-browser";
+
+/**
+ * Typed query-key factory for webhook-related queries.
+ */
+export const webhookKeys = {
+  all: ["webhooks"] as const,
+  lists: () => [...webhookKeys.all, "list"] as const,
+  list: (workspaceId: string) => [...webhookKeys.lists(), workspaceId] as const,
+  webhook: (webhookId: string) => [...webhookKeys.all, webhookId] as const,
+  /** Infer the result type of a query so the caller never has to type `data` manually. */
+  webhookType: () => null as unknown as Webhook,
+};
