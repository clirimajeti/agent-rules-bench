@@ -0,0 +1,71 @@
+/**
+ * POST /api/v3/webhooks/{webhookId}/duplicate — clone a webhook into a new one.
+ *
+ * Reads the source webhook, asserts workspace.write authorization, and creates a copy with
+ * "Copy of <name>" as the default name.
+ */
+import { z } from "zod";
+import { ZId } from "@formbricks/types/common";
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { assertCan } from "@/lib/authorization";
+import { capturePostHogEvent } from "@/lib/posthog";
+import { assertNewlyAttachedSurveysWorkspaceVisible } from "@/lib/survey/visibility/outbound";
+import { getOrganizationIdFromWebhookId, getWorkspaceIdFromWebhookId } from "@/lib/utils/helper";
+import { getWebhook } from "@/modules/api/v2/management/webhooks/[webhookId]/lib/webhook";
+import { applyRateLimit } from "@/modules/core/rate-limit/helpers";
+import { rateLimitConfigs } from "@/modules/core/rate-limit/rate-limit-configs";
+import { createWebhook } from "@/modules/integrations/webhooks/lib/webhook";
+import { problemNotFound, successResponse } from "@/app/api/v3/lib/response";
+
+export const POST = withV3ApiWrapper({
+  auth: "both",
+  action: "created",
+  targetType: "webhook",
+  schemas: { params: z.object({ webhookId: ZId }).strict() },
+  handler: async ({ req, parsedInput, authentication, auditLog, requestId, instance }) => {
+    const webhookId = parsedInput.params.webhookId;
+    const organizationId = await getOrganizationIdFromWebhookId(webhookId);
+    const webhookResult = await getWebhook(webhookId);
+
+    if (!webhookResult.ok) {
+      return problemNotFound(requestId, "Webhook", webhookId, instance);
+    }
+
+    const existing = webhookResult.data;
+
+    const workspaceId = await getWorkspaceIdFromWebhookId(webhookId);
+    await assertCan({ type: "user", id: authentication.userId }, "workspace.write", {
+      type: "workspace",
+      id: workspaceId,
+    });
+    await applyRateLimit(rateLimitConfigs.actions.stateMutation, workspaceId);
+    await assertNewlyAttachedSurveysWorkspaceVisible(existing.surveyIds);
+
+    const newWebhook = await createWebhook(workspaceId, {
+      name: `Copy of ${existing.name ?? "Webhook"}`,
+      url: existing.url,
+      source: existing.source,
+      triggers: existing.triggers,
+      surveyIds: existing.surveyIds,
+    });
+
+    auditLog!.objectType = "webhook";
+    auditLog!.objectId = newWebhook.id;
+    auditLog!.objectName = newWebhook.name ?? undefined;
+    auditLog!.organizationId = organizationId;
+    auditLog!.workspaceId = workspaceId;
+
+    capturePostHogEvent(
+      authentication.userId,
+      "integration_connected",
+      {
+        integration_type: "webhook",
+        organization_id: organizationId,
+        workspace_id: workspaceId,
+      },
+      { organizationId, workspaceId }
+    );
+
+    return successResponse(newWebhook, { requestId });
+  },
+});
