+/**
+ * POST /api/v3/api-keys/{apiKeyId}/rotate — rotate the secret for an API key.
+ *
+ * Thin adapter: authorization and audit logging go through the v3 wrapper; the
+ * business logic stays in the library.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { ZV3EmptyQuery } from "@/app/api/v3/lib/schemas";
+import { ZApiKeyIdParams } from "../lib/schemas";
+import { rotateApiKeyOperation } from "../lib/operations";
+
+export const POST = withV3ApiWrapper({
+  auth: "both",
+  action: "updated",
+  targetType: "apiKey",
+  schemas: { params: ZApiKeyIdParams, query: ZV3EmptyQuery },
+  handler: async ({ authentication, parsedInput, auditLog, requestId, instance }) =>
+    rotateApiKeyOperation({
+      authentication,
+      apiKeyId: parsedInput.params.apiKeyId,
+      auditLog,
+      requestId,
+      instance,
+    }),
+});
diff --git a/apps/web/app/api/v3/api-keys/lib/operations.ts b/apps/web/app/api/v3/api-keys/lib/operations.ts
new file mode 100644
index 000000000..17ff6b0af
--- /dev/null
+++ b/apps/web/app/api/v3/api-keys/lib/operations.ts
@@ -0,0 +1,58 @@
+import "server-only";
+import { rotateApiKey } from "@/modules/organization/settings/api-keys/lib/api-key";
+import { assertCan } from "@/lib/authorization";
+import { getOrganizationIdFromApiKeyId } from "@/lib/utils/helper";
+import type { TV3Authentication, TV3AuditLog } from "@/app/api/v3/lib/types";
+import { problemForbidden, problemNotFound } from "@/app/api/v3/lib/response";
+import { serializeV3ApiKey } from "../serializers";
+
+export interface RotateApiKeyOperationParams {
+  authentication: TV3Authentication;
+  apiKeyId: string;
+  auditLog: TV3AuditLog;
+  requestId: string;
+  instance: string;
+}
+
+export async function rotateApiKeyOperation({
+  authentication,
+  apiKeyId,
+  auditLog,
+  requestId,
+  instance,
+}: RotateApiKeyOperationParams): Promise<Response> {
+  // Resolve the organization from the API key for authorization
+  const organizationId = await getOrganizationIdFromApiKeyId(apiKeyId);
+  if (!organizationId) {
+    return problemNotFound(requestId, "API key not found", instance);
+  }
+
+  // Authorize: the caller must have apiKey.manage on this specific key
+  if ("type" in authentication && authentication.type === "session") {
+    await assertCan(
+      { type: "user", id: authentication.userId },
+      "apiKey.manage",
+      { type: "apiKey", id: apiKeyId }
+    );
+  } else if ("type" in authentication && authentication.type === "apiKey") {
+    // API keys can only rotate themselves (defense-in-depth)
+    if (authentication.apiKeyId !== apiKeyId) {
+      return problemForbidden(requestId, "Cannot rotate another API key", instance);
+    }
+  }
+
+  // Perform the rotation
+  const result = await rotateApiKey(apiKeyId);
+
+  // Update audit log
+  auditLog.targetId = apiKeyId;
+  auditLog.status = "success";
+  auditLog.newObject = { id: result.id };
+
+  return new Response(
+    JSON.stringify({
+      data: serializeV3ApiKey(result),
+    }),
+    { status: 200, headers: { "Content-Type": "application/json" } }
+  );
+}
