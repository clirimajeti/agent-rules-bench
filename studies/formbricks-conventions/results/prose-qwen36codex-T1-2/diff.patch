     throw error;
   }
 };
+
+export const rotateApiKey = async (apiKeyId: string): Promise<{ id: string; actualKey: string }> => {
+  try {
+    // Generate a new secret
+    const secret = randomBytes(32).toString("base64url");
+    const lookupHash = hashSha256(secret);
+    const hashedKey = await hashSecret(secret, 12);
+
+    // Update the API key with new secret, keeping label and permissions
+    const updatedApiKey = await prisma.apiKey.update({
+      where: { id: apiKeyId },
+      data: {
+        hashedKey,
+        lookupHash,
+      },
+    });
+
+    await runPostCommitProjection("api_key_rotate_relationship_reconciliation", () =>
+      reconcileApiKeyRelationships({ apiKeyIds: [apiKeyId] })
+    );
+
+    return { id: updatedApiKey.id, actualKey: `fbk_${secret}` };
+  } catch (error) {
+    if (error instanceof Prisma.PrismaClientKnownRequestError) {
+      throw new DatabaseError(error.message);
+    }
+    throw error;
+  }
+};
diff --git a/apps/web/modules/organization/settings/api-keys/lib/rotate-api-key-client.ts b/apps/web/modules/organization/settings/api-keys/lib/rotate-api-key-client.ts
new file mode 100644
index 000000000..3c9495821
--- /dev/null
+++ b/apps/web/modules/organization/settings/api-keys/lib/rotate-api-key-client.ts
@@ -0,0 +1,20 @@
+import { parseV3ApiError } from "@/modules/api/lib/v3-client";
+
+/**
+ * Rotate the secret for an API key via the v3 API.
+ *
+ * Resolves with the new plaintext key. The key is returned once and only once;
+ * the caller must store it immediately.
+ */
+export async function rotateApiKeyClient({ apiKeyId }: { apiKeyId: string }): Promise<{ id: string; actualKey: string }> {
+  const response = await fetch(`/api/v3/api-keys/${encodeURIComponent(apiKeyId)}/rotate`, {
+    method: "POST",
+    signal: AbortSignal.timeout(15_000),
+  });
+
+  if (!response.ok) {
+    throw await parseV3ApiError(response);
+  }
+
+  return ((await response.json()) as { data: { id: string; actualKey: string } }).data;
+}
