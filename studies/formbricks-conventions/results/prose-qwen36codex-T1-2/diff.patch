@@ -0,0 +1,12 @@
+/**
+ * Public v3 API-key shape. Exposes only the id and the new secret; the caller
+ * must store the secret immediately because it is never returned again.
+ */
+export type TV3ApiKeyResource = {
+  id: string;
+  actualKey: string;
+};
+
+export function serializeV3ApiKey({ id, actualKey }: { id: string; actualKey: string }): TV3ApiKeyResource {
+  return { id, actualKey };
+}
