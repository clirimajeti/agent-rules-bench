+++ b/docs/api-v3-reference/src/paths/api_v3_webhooks_{webhookId}_duplicate.yml
@@ -0,0 +1,103 @@
+post:
+  operationId: duplicateWebhookV3
+  # Session-only by design (the webhooks settings page is the only consumer), so an API-key caller reading
+  # the published reference would only ever get a 401. Excluded from the generated docs pages, like the
+  # tags operations; the operation stays in the bundle for the contract tests.
+  x-excluded: true
+  summary: Duplicate a webhook
+  description: |
+    Copies a webhook. The copy has the same URL, triggers and surveys, is named `Copy of ` followed by
+    the original's name (or its URL when the original has no name), and gets a new signing secret of its
+    own. The secret is not part of the response; it is shown in the copy's settings.
+
+    Needs write access to the webhook's workspace. The copy can only attach surveys that are visible to
+    the whole workspace.
+  tags:
+    - V3 Webhooks
+  parameters:
+    - in: path
+      name: webhookId
+      required: true
+      schema:
+        type: string
+        format: cuid2
+      description: The webhook to copy.
+  responses:
+    "201":
+      description: The copy
+      headers:
+        X-Request-Id:
+          schema:
+            type: string
+          description: Request correlation ID
+        Cache-Control:
+          schema:
+            type: string
+          example: private, no-store
+        Location:
+          schema:
+            type: string
+          example: /api/v3/webhooks/clwebhook0000000000000002
+      content:
+        application/json:
+          schema:
+            type: object
+            required:
+              - data
+            properties:
+              data:
+                type: object
+                required:
+                  - id
+                  - name
+                  - url
+                  - source
+                  - triggers
+                  - surveyIds
+                  - workspaceId
+                  - createdAt
+                  - updatedAt
+                properties:
+                  id:
+                    type: string
+                    format: cuid2
+                  name:
+                    type:
+                      - string
+                      - "null"
+                  url:
+                    type: string
+                  source:
+                    type: string
+                    enum: [user, zapier, make, n8n, activepieces]
+                  triggers:
+                    type: array
+                    items:
+                      type: string
+                      enum: [responseFinished, responseCreated, responseUpdated]
+                  surveyIds:
+                    type: array
+                    items:
+                      type: string
+                      format: cuid2
+                  workspaceId:
+                    type: string
+                    format: cuid2
+                  createdAt:
+                    type: string
+                    format: date-time
+                  updatedAt:
+                    type: string
+                    format: date-time
+    "400":
+      $ref: ../components/responses/V3BadRequest.yml
+    "401":
+      $ref: ../components/responses/V3UnauthorizedSession.yml
+    "403":
+      $ref: ../components/responses/V3Forbidden.yml
+    "429":
+      $ref: ../components/responses/V3TooManyRequests.yml
+    "500":
+      $ref: ../components/responses/V3InternalServerError.yml
+  security:
+    - sessionAuth: []
