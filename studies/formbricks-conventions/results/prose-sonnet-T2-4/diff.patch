+/**
+ * POST /api/v3/webhooks/{webhookId}/duplicate — copy a webhook with the same URL, triggers and surveys.
+ *
+ * Session-only, deliberately: the webhooks settings page is the only consumer, and API keys already
+ * create webhooks through the management API.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { ZV3EmptyQuery } from "@/app/api/v3/lib/schemas";
+import { duplicateV3Webhook } from "../../lib/operations";
+import { ZV3WebhookIdParams } from "../../lib/schemas";
+
+export const POST = withV3ApiWrapper({
+  auth: "session",
+  action: "created",
+  targetType: "webhook",
+  schemas: { params: ZV3WebhookIdParams, query: ZV3EmptyQuery },
+  handler: async ({ authentication, parsedInput, auditLog, requestId, instance }) =>
+    duplicateV3Webhook({
+      webhookId: parsedInput.params.webhookId,
+      authentication,
+      auditLog,
+      requestId,
+      instance,
+    }),
+});
diff --git a/apps/web/app/api/v3/webhooks/lib/operations.ts b/apps/web/app/api/v3/webhooks/lib/operations.ts
new file mode 100644
index 000000000..00bdfdfbc
--- /dev/null
+++ b/apps/web/app/api/v3/webhooks/lib/operations.ts
@@ -0,0 +1,71 @@
+import "server-only";
+import { logger } from "@formbricks/logger";
+import { requireV3WorkspaceAccess } from "@/app/api/v3/lib/auth";
+import { mapV3ThrownError } from "@/app/api/v3/lib/errors";
+import { createdResponse, problemForbidden } from "@/app/api/v3/lib/response";
+import type { TV3AuditLog, TV3Authentication } from "@/app/api/v3/lib/types";
+import { assertNewlyAttachedSurveysWorkspaceVisible } from "@/lib/survey/visibility/outbound";
+import { getWebhook } from "@/modules/api/v2/management/webhooks/[webhookId]/lib/webhook";
+import { createWebhook } from "@/modules/integrations/webhooks/lib/webhook";
+import { serializeV3Webhook } from "../serializers";
+
+const COPY_NAME_PREFIX = "Copy of ";
+
+/**
+ * `POST /api/v3/webhooks/{webhookId}/duplicate` → 201. The copy keeps the original's URL, triggers and
+ * surveys, is named "Copy of <name>", and gets a signing secret of its own (generated by `createWebhook`,
+ * never copied). The response omits the secret, like every other webhook read.
+ *
+ * The workspace is resolved from the webhook itself, so a caller cannot pair a foreign webhook id with a
+ * workspace they can write to. An unknown webhook answers 403, not 404, to avoid probing ids.
+ */
+export async function duplicateV3Webhook(params: {
+  webhookId: string;
+  authentication: TV3Authentication;
+  auditLog?: TV3AuditLog;
+  requestId: string;
+  instance?: string;
+}): Promise<Response> {
+  const { webhookId, authentication, auditLog, requestId, instance } = params;
+  const log = logger.withContext({ requestId, webhookId });
+
+  try {
+    const original = await getWebhook(webhookId);
+    if (!original.ok) {
+      return problemForbidden(requestId, "You are not authorized to access this resource", instance);
+    }
+
+    const access = await requireV3WorkspaceAccess(
+      authentication,
+      original.data.workspaceId,
+      "readWrite",
+      requestId,
+      instance
+    );
+    if (access instanceof Response) return access;
+
+    // The copy is a new attachment, so the outbound survey-visibility guard applies to all its surveys.
+    await assertNewlyAttachedSurveysWorkspaceVisible(original.data.surveyIds);
+
+    const copy = await createWebhook(access.workspaceId, {
+      name: `${COPY_NAME_PREFIX}${original.data.name ?? original.data.url}`,
+      url: original.data.url,
+      source: "user",
+      triggers: original.data.triggers,
+      surveyIds: original.data.surveyIds,
+    });
+
+    const { secret: _secret, ...copyWithoutSecret } = copy;
+    const webhook = serializeV3Webhook(copyWithoutSecret);
+
+    if (auditLog) {
+      auditLog.organizationId = access.organizationId;
+      auditLog.targetId = webhook.id;
+      auditLog.newObject = { ...webhook, duplicatedFrom: webhookId };
+    }
+
+    return createdResponse(webhook, { location: `/api/v3/webhooks/${webhook.id}`, requestId });
+  } catch (error) {
+    return mapV3ThrownError(error, { log, requestId, instance, operation: "webhooks.duplicate" });
+  }
+}
