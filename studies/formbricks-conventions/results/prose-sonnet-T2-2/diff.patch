+get:
+  operationId: listWebhooksV3
+  # Session-only by design, like the tags operations: these endpoints back the webhooks settings screen.
+  # Excluded from the generated docs pages; the operation stays in the bundle for the contract tests.
+  x-excluded: true
+  summary: List webhooks
+  description: |
+    Returns a workspace's webhooks, newest first.
+
+    Session cookie only. Webhooks are managed from the Formbricks app (Workspace settings → Integrations →
+    Webhooks); this endpoint backs that screen, so it does not accept `x-api-key`.
+  tags:
+    - V3 Webhooks
+  parameters:
+    - in: query
+      name: workspaceId
+      required: true
+      schema:
+        type: string
+        format: cuid2
+      description: |
+        Workspace identifier. This is the canonical container ID for v3 APIs.
+  responses:
+    "200":
+      description: Webhooks retrieved successfully
+      headers:
+        X-Request-Id:
+          schema:
+            type: string
+          description: Request correlation ID
+        Cache-Control:
+          schema:
+            type: string
+          example: private, no-store
+      content:
+        application/json:
+          schema:
+            type: object
+            required:
+              - data
+            properties:
+              data:
+                type: array
+                items:
+                  $ref: ../components/schemas/WebhookResource.yml
+    "400":
+      $ref: ../components/responses/V3BadRequest.yml
+    "401":
+      $ref: ../components/responses/V3UnauthorizedSession.yml
+    "403":
+      $ref: ../components/responses/V3Forbidden.yml
+    "429":
+      $ref: ../components/responses/V3TooManyRequests.yml
+    "500":
+      $ref: ../components/responses/V3InternalServerError.yml
+  security:
+    - sessionAuth: []
diff --git a/docs/api-v3-reference/src/paths/api_v3_webhooks_{webhookId}_duplicate.yml b/docs/api-v3-reference/src/paths/api_v3_webhooks_{webhookId}_duplicate.yml
new file mode 100644
index 000000000..8642f8abe
--- /dev/null
+++ b/docs/api-v3-reference/src/paths/api_v3_webhooks_{webhookId}_duplicate.yml
@@ -0,0 +1,52 @@
+post:
+  operationId: duplicateWebhookV3
+  # Session-only by design, like the tags operations. Excluded from the generated docs pages; the
+  # operation stays in the bundle for the contract tests.
+  x-excluded: true
+  summary: Duplicate a webhook
+  description: |
+    Creates a new webhook with the same URL, triggers and surveys as `{webhookId}`. The copy is named
+    `Copy of <name>` (or `Copy of <url>` when the original has no name) and gets a new signing secret.
+    The secret is returned in this response.
+
+    The workspace is resolved from the webhook itself. An unknown `webhookId` answers `403`, not `404`, so
+    webhook ids cannot be probed for existence. Requires organization owner/manager, or a workspace team
+    membership with read-write permission.
+
+    A webhook whose URL is no longer allowed answers `422`.
+  tags:
+    - V3 Webhooks
+  parameters:
+    - in: path
+      name: webhookId
+      required: true
+      schema:
+        type: string
+        format: cuid2
+      description: The webhook to copy.
+  responses:
+    "201":
+      description: Webhook duplicated successfully
+      content:
+        application/json:
+          schema:
+            type: object
+            required:
+              - data
+            properties:
+              data:
+                $ref: ../components/schemas/WebhookResource.yml
+    "400":
+      $ref: ../components/responses/V3BadRequest.yml
+    "401":
+      $ref: ../components/responses/V3UnauthorizedSession.yml
+    "403":
+      $ref: ../components/responses/V3Forbidden.yml
+    "422":
+      $ref: ../components/responses/V3UnprocessableContent.yml
+    "429":
+      $ref: ../components/responses/V3TooManyRequests.yml
+    "500":
+      $ref: ../components/responses/V3InternalServerError.yml
+  security:
+    - sessionAuth: []
