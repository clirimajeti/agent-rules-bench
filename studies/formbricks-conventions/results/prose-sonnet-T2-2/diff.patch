+type: object
+required:
+  - id
+  - name
+  - url
+  - source
+  - workspaceId
+  - triggers
+  - surveyIds
+  - secret
+  - createdAt
+  - updatedAt
+properties:
+  id:
+    type: string
+    format: cuid2
+  name:
+    type: [string, "null"]
+    description: Label shown in the app. A copy made with the duplicate operation is named `Copy of <name>`.
+  url:
+    type: string
+    format: uri
+    description: Endpoint that receives the webhook requests.
+  source:
+    type: string
+    enum: [user, zapier, make, n8n, activepieces]
+  workspaceId:
+    type: string
+    format: cuid2
+  triggers:
+    type: array
+    items:
+      type: string
+      enum: [responseFinished, responseCreated, responseUpdated]
+  surveyIds:
+    type: array
+    items:
+      type: string
+      format: cuid2
+    description: Surveys the webhook listens to. An empty list means all surveys.
+  secret:
+    type: [string, "null"]
+    description: Signing secret used to sign the webhook requests.
+  createdAt:
+    type: string
+    format: date-time
+  updatedAt:
+    type: string
+    format: date-time
