diff --git a/apps/web/modules/integrations/webhooks/hooks/use-duplicate-webhook.ts b/apps/web/modules/integrations/webhooks/hooks/use-duplicate-webhook.ts
new file mode 100644
index 000000000..bea64fb73
--- /dev/null
+++ b/apps/web/modules/integrations/webhooks/hooks/use-duplicate-webhook.ts
@@ -0,0 +1,14 @@
+"use client";
+
+import { useMutation, useQueryClient } from "@tanstack/react-query";
+import { duplicateWebhook } from "../lib/api-client";
+import { webhookKeys } from "../lib/query";
+
+/** Duplicate a webhook, then invalidate the list so the copy shows up. */
+export const useDuplicateWebhook = (workspaceId: string) => {
+  const queryClient = useQueryClient();
+  return useMutation({
+    mutationFn: (variables: { webhookId: string }) => duplicateWebhook(variables),
+    onSuccess: () => queryClient.invalidateQueries({ queryKey: webhookKeys.list(workspaceId) }),
+  });
+};
diff --git a/apps/web/modules/integrations/webhooks/hooks/use-webhooks.ts b/apps/web/modules/integrations/webhooks/hooks/use-webhooks.ts
new file mode 100644
index 000000000..8774b60e4
--- /dev/null
+++ b/apps/web/modules/integrations/webhooks/hooks/use-webhooks.ts
@@ -0,0 +1,17 @@
+"use client";
+
+import { useQuery } from "@tanstack/react-query";
+import type { Webhook } from "@formbricks/database/prisma-browser";
+import { getWebhooks } from "../lib/api-client";
+import { webhookKeys } from "../lib/query";
+
+/**
+ * A workspace's webhooks - the table's only data source. The server-rendered page seeds the cache with
+ * `initialData`, so the first paint needs no request; later changes invalidate the list.
+ */
+export const useWebhooks = (workspaceId: string, initialData: Webhook[]) =>
+  useQuery({
+    queryKey: webhookKeys.list(workspaceId),
+    queryFn: ({ signal }) => getWebhooks({ workspaceId, signal }),
+    initialData,
+  });
