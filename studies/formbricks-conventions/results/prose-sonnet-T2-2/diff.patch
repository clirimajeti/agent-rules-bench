+/**
+ * POST /api/v3/webhooks/{webhookId}/duplicate — copy a webhook (URL, triggers, surveys) under the name
+ * "Copy of <name>", with a newly generated signing secret.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { duplicateV3Webhook } from "../../lib/operations";
+import { ZV3WebhookIdParams } from "../../lib/schemas";
+
+export const POST = withV3ApiWrapper({
+  auth: "session",
+  action: "created",
+  targetType: "webhook",
+  schemas: { params: ZV3WebhookIdParams },
+  handler: async ({ authentication, parsedInput, auditLog, requestId, instance }) =>
+    duplicateV3Webhook({
+      authentication,
+      webhookId: parsedInput.params.webhookId,
+      auditLog,
+      requestId,
+      instance,
+    }),
+});
diff --git a/apps/web/app/api/v3/webhooks/lib/operations.ts b/apps/web/app/api/v3/webhooks/lib/operations.ts
new file mode 100644
index 000000000..10592b605
--- /dev/null
+++ b/apps/web/app/api/v3/webhooks/lib/operations.ts
@@ -0,0 +1,101 @@
+import "server-only";
+import { logger } from "@formbricks/logger";
+import { InvalidInputError } from "@formbricks/types/errors";
+import { requireV3WorkspaceAccess } from "@/app/api/v3/lib/auth";
+import { mapV3ThrownError } from "@/app/api/v3/lib/errors";
+import { problemForbidden, problemUnprocessableContent, successResponse } from "@/app/api/v3/lib/response";
+import type { TV3AuditLog, TV3Authentication } from "@/app/api/v3/lib/types";
+import { assertNewlyAttachedSurveysWorkspaceVisible } from "@/lib/survey/visibility/outbound";
+import { getWebhookWithSecret } from "@/modules/api/v2/management/webhooks/[webhookId]/lib/webhook";
+import { createWebhook, getWebhooks } from "@/modules/integrations/webhooks/lib/webhook";
+import { serializeV3Webhook } from "../serializers";
+
+type TBaseParams = {
+  authentication: TV3Authentication;
+  requestId: string;
+  instance: string;
+};
+
+export async function listV3Webhooks(params: TBaseParams & { workspaceId: string }): Promise<Response> {
+  const { authentication, workspaceId, requestId, instance } = params;
+
+  const access = await requireV3WorkspaceAccess(authentication, workspaceId, "read", requestId, instance);
+  if (access instanceof Response) return access;
+
+  try {
+    const webhooks = await getWebhooks(access.workspaceId);
+    return successResponse(webhooks.map(serializeV3Webhook), { requestId });
+  } catch (error) {
+    return mapV3ThrownError(error, {
+      log: logger.withContext({ requestId }),
+      requestId,
+      instance,
+      operation: "webhooks.list",
+    });
+  }
+}
+
+/**
+ * Copy a webhook: same URL, triggers and surveys, named "Copy of <name>", with a secret of its own.
+ *
+ * The workspace is resolved from the webhook itself, never from the client. An unknown webhook answers
+ * 403, not 404, so webhook ids cannot be probed for existence (same rule as `/api/v3/tags/{tagId}`).
+ * Authorization matches the create action: read-write on the workspace.
+ */
+export async function duplicateV3Webhook(
+  params: TBaseParams & { webhookId: string; auditLog?: TV3AuditLog }
+): Promise<Response> {
+  const { authentication, webhookId, auditLog, requestId, instance } = params;
+  const log = logger.withContext({ requestId, webhookId });
+
+  try {
+    const original = await getWebhookWithSecret(webhookId);
+    if (!original.ok) {
+      return problemForbidden(requestId, "You are not authorized to access this resource", instance);
+    }
+    const source = original.data;
+
+    const access = await requireV3WorkspaceAccess(
+      authentication,
+      source.workspaceId,
+      "readWrite",
+      requestId,
+      instance
+    );
+    if (access instanceof Response) return access;
+
+    // The copy attaches the same surveys as a new webhook would, so it passes the same visibility gate.
+    await assertNewlyAttachedSurveysWorkspaceVisible(source.surveyIds);
+
+    let copy;
+    try {
+      // No secret is passed, so `createWebhook` generates a new one for the copy.
+      copy = await createWebhook(source.workspaceId, {
+        name: `Copy of ${source.name || source.url}`,
+        url: source.url,
+        triggers: source.triggers,
+        surveyIds: source.surveyIds,
+      });
+    } catch (error) {
+      // The stored URL is checked again on create, so a webhook whose URL is no longer allowed
+      // cannot be copied. That is the webhook's state, not a server fault.
+      if (error instanceof InvalidInputError) {
+        return problemUnprocessableContent(requestId, "The webhook URL is no longer allowed", { instance });
+      }
+      throw error;
+    }
+
+    if (auditLog) {
+      auditLog.organizationId = access.organizationId;
+      auditLog.targetId = copy.id;
+      // The signing secret never goes into the audit trail.
+      const { secret: _secret, ...copyWithoutSecret } = copy;
+      auditLog.newObject = copyWithoutSecret;
+    }
+
+    // 201 with the secret: this response is the one place the copy's new secret is shown.
+    return successResponse(serializeV3Webhook(copy), { requestId, status: 201 });
+  } catch (error) {
+    return mapV3ThrownError(error, { log, requestId, instance, operation: "webhooks.duplicate" });
+  }
+}
