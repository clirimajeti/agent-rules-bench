@@ -0,0 +1,29 @@
+import { parseV3ApiError } from "@/modules/api/lib/v3-client";
+
+const JSON_HEADERS = { "Content-Type": "application/json" };
+
+/**
+ * Client fetchers for the Webhooks v3 routes. Every call throws a parsed `V3ApiError` on a
+ * non-2xx response.
+ */
+
+export async function duplicateWebhook(params: {
+  webhookId: string;
+  workspaceId: string;
+}): Promise<unknown> {
+  const url = `/api/v3/webhooks/${params.webhookId}/duplicate?workspaceId=${encodeURIComponent(params.workspaceId)}`;
+
+  const response = await fetch(url, {
+    method: "POST",
+    cache: "no-store",
+    headers: JSON_HEADERS,
+    signal: AbortSignal.timeout(15_000),
+  });
+
+  if (!response.ok) {
+    throw await parseV3ApiError(response);
+  }
+
+  const body = (await response.json()) as { data: unknown };
+  return body.data;
+}
