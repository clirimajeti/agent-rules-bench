diff --git a/apps/web/modules/integrations/webhooks/hooks/use-duplicate-webhook.ts b/apps/web/modules/integrations/webhooks/hooks/use-duplicate-webhook.ts
new file mode 100644
index 000000000..8598bb15c
--- /dev/null
+++ b/apps/web/modules/integrations/webhooks/hooks/use-duplicate-webhook.ts
@@ -0,0 +1,17 @@
+"use client";
+
+import { useMutation, useQueryClient } from "@tanstack/react-query";
+import { duplicateWebhook } from "../lib/api-client";
+
+export const useDuplicateWebhook = () => {
+  const queryClient = useQueryClient();
+
+  return useMutation({
+    mutationFn: ({ webhookId, workspaceId }: { webhookId: string; workspaceId: string }) =>
+      duplicateWebhook({ webhookId, workspaceId }),
+    onSuccess: () => {
+      // Invalidate webhook list queries so the new webhook appears in the table.
+      queryClient.invalidateQueries({ queryKey: ["webhooks"] });
+    },
+  });
+};
