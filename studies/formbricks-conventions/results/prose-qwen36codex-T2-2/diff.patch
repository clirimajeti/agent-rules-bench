+/**
+ * POST /api/v3/webhooks/{webhookId}/duplicate — clone an existing webhook into the same workspace.
+ *
+ * Reads the source webhook, constructs a new input with `Copy of <name>`, and delegates to the
+ * service-layer `createWebhook`. Mirrors the audit / rate-limit / authorization that the legacy
+ * server action performed.
+ */
+import { z } from "zod";
+import { ZId } from "@formbricks/types/common";
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { generateWebhookSecret } from "@/lib/crypto";
+import { assertCan } from "@/lib/authorization";
+import { getOrganizationIdFromWebhookId, getWorkspaceIdFromWebhookId } from "@/lib/utils/helper";
+import { getWebhook } from "@/modules/api/v2/management/webhooks/[webhookId]/lib/webhook";
+import { applyRateLimit } from "@/modules/core/rate-limit/helpers";
+import { rateLimitConfigs } from "@/modules/core/rate-limit/rate-limit-configs";
+import { createWebhook } from "@/modules/integrations/webhooks/lib/webhook";
+import { ZWebhookInput } from "@/modules/integrations/webhooks/types/webhooks";
+
+export const POST = withV3ApiWrapper({
+  auth: "session",
+  action: "created",
+  targetType: "webhook",
+  schemas: {
+    params: z.object({ webhookId: ZId }),
+    query: z.object({ workspaceId: ZId }),
+  },
+  handler: async ({ authentication, parsedInput, auditLog, requestId, instance }) => {
+    const { webhookId } = parsedInput.params;
+    const { workspaceId } = parsedInput.query;
+
+    const organizationId = await getOrganizationIdFromWebhookId(webhookId);
+    const sourceWorkspaceId = await getWorkspaceIdFromWebhookId(webhookId);
+
+    await assertCan({ type: "user", id: authentication.userId }, "workspace.write", {
+      type: "workspace",
+      id: sourceWorkspaceId,
+    });
+    await applyRateLimit(rateLimitConfigs.actions.stateMutation, sourceWorkspaceId);
+
+    const sourceWebhook = await getWebhook(webhookId);
+    if (!sourceWebhook.ok) {
+      return new Response(
+        JSON.stringify({
+          error: "not_found",
+          detail: `Webhook ${webhookId} not found`,
+        }),
+        { status: 404, headers: { "Content-Type": "application/json" } }
+      );
+    }
+
+    const newWebhookInput: ZWebhookInput = {
+      name: sourceWebhook.data.name ? `Copy of ${sourceWebhook.data.name}` : undefined,
+      url: sourceWebhook.data.url,
+      triggers: sourceWebhook.data.triggers,
+      surveyIds: sourceWebhook.data.surveyIds,
+    };
+
+    const newWebhook = await createWebhook(workspaceId, newWebhookInput, generateWebhookSecret());
+
+    auditLog.webhookId = webhookId;
+    auditLog.newObject = newWebhookInput;
+    auditLog.organizationId = organizationId;
+
+    return new Response(JSON.stringify({ data: newWebhook }), {
+      status: 201,
+      headers: { "Content-Type": "application/json" },
+    });
+  },
+});
