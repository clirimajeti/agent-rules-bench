diff --git a/apps/web/modules/integrations/webhooks/components/duplicate-webhook-button.tsx b/apps/web/modules/integrations/webhooks/components/duplicate-webhook-button.tsx
new file mode 100644
index 000000000..c4822937c
--- /dev/null
+++ b/apps/web/modules/integrations/webhooks/components/duplicate-webhook-button.tsx
@@ -0,0 +1,54 @@
+"use client";
+
+import { useRouter } from "next/navigation";
+import { useState } from "react";
+import toast from "react-hot-toast";
+import { useTranslation } from "react-i18next";
+import { Webhook } from "@formbricks/database/prisma-browser";
+import { getFormattedErrorMessage } from "@/lib/utils/error-message";
+import { Button } from "@/modules/ui/components/button";
+import { createWebhookAction } from "../actions";
+
+interface DuplicateWebhookButtonProps {
+  webhook: Webhook;
+}
+
+export const DuplicateWebhookButton = ({ webhook }: Readonly<DuplicateWebhookButtonProps>) => {
+  const { t } = useTranslation();
+  const router = useRouter();
+  const [isDuplicating, setIsDuplicating] = useState(false);
+
+  const handleDuplicate = async () => {
+    setIsDuplicating(true);
+    try {
+      // No webhookSecret is passed, so the server generates a new signing secret for the copy.
+      const createWebhookActionResult = await createWebhookAction({
+        workspaceId: webhook.workspaceId,
+        webhookInput: {
+          name: t("workspace.integrations.webhooks.copy_of_webhook", {
+            name: webhook.name || webhook.url,
+          }),
+          url: webhook.url,
+          source: "user",
+          triggers: webhook.triggers,
+          surveyIds: webhook.surveyIds,
+        },
+      });
+
+      if (createWebhookActionResult?.data) {
+        router.refresh();
+        toast.success(t("workspace.integrations.webhooks.webhook_duplicated_successfully"));
+      } else {
+        toast.error(getFormattedErrorMessage(createWebhookActionResult));
+      }
+    } finally {
+      setIsDuplicating(false);
+    }
+  };
+
+  return (
+    <Button type="button" variant="secondary" size="sm" loading={isDuplicating} onClick={handleDuplicate}>
+      {t("common.duplicate")}
+    </Button>
+  );
+};
