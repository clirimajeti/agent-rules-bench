@@ -0,0 +1,68 @@
+post:
+  operationId: duplicateWebhookV3
+  # Session-only by design, so an API-key caller reading the published reference would only ever get a
+  # 401. Excluded from the generated docs pages like the `/tags` operations (ENG-2533); the operation
+  # stays in the bundle for the contract tests.
+  x-excluded: true
+  summary: Duplicate a webhook
+  description: |
+    Creates a copy of a webhook in the same workspace. The copy has the same URL, triggers and surveys
+    as the original, the name `Copy of <original name>` (the original's URL stands in when it has no
+    name), the source `user`, and a new signing secret of its own. The secret is not returned; read it
+    in the app's webhook settings.
+
+    The workspace is resolved from the webhook itself, so the caller cannot choose which scope it is
+    authorized against. Requires organization owner/manager, or a workspace team membership with
+    read-write permission. An unknown `webhookId` answers `403`, not `404`, so webhook ids cannot be
+    probed for existence.
+
+    Answers `422`, and creates nothing, when a survey of the original is no longer visible to the whole
+    workspace or when the instance no longer accepts the original's URL.
+
+    Session cookie only. This endpoint backs the Duplicate button in the Formbricks app (Workspace
+    settings → Integrations → Webhooks), so it does not accept `x-api-key`.
+  tags:
+    - V3 Webhooks
+  parameters:
+    - in: path
+      name: webhookId
+      required: true
+      schema:
+        type: string
+        format: cuid2
+      description: The webhook to copy.
+  responses:
+    "201":
+      description: The copy
+      headers:
+        X-Request-Id:
+          schema:
+            type: string
+          description: Request correlation ID
+        Cache-Control:
+          schema:
+            type: string
+          example: private, no-store
+      content:
+        application/json:
+          schema:
+            type: object
+            required:
+              - data
+            properties:
+              data:
+                $ref: ../components/schemas/WebhookResource.yml
+    "400":
+      $ref: ../components/responses/V3BadRequest.yml
+    "401":
+      $ref: ../components/responses/V3UnauthorizedSession.yml
+    "403":
+      $ref: ../components/responses/V3Forbidden.yml
+    "422":
+      $ref: ../components/responses/V3UnprocessableContent.yml
+    "429":
+      $ref: ../components/responses/V3TooManyRequests.yml
+    "500":
+      $ref: ../components/responses/V3InternalServerError.yml
+  security:
+    - sessionAuth: []
