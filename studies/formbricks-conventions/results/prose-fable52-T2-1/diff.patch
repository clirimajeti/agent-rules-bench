+import "server-only";
+import { prisma } from "@formbricks/database";
+import type { Webhook } from "@formbricks/database/prisma";
+import { generateWebhookSecret } from "@/lib/crypto";
+
+/** The columns a webhook is returned with. The signing secret is left out on purpose. */
+const webhookWithoutSecretSelect = {
+  id: true,
+  name: true,
+  url: true,
+  source: true,
+  workspaceId: true,
+  triggers: true,
+  surveyIds: true,
+  createdAt: true,
+  updatedAt: true,
+} as const;
+
+export type TWebhookWithoutSecret = Omit<Webhook, "secret">;
+
+export const getWebhookWithoutSecret = (webhookId: string): Promise<TWebhookWithoutSecret | null> =>
+  prisma.webhook.findUnique({ where: { id: webhookId }, select: webhookWithoutSecretSelect });
+
+/** The name a copy gets. A webhook without a name is listed by its URL, so the copy is named after that. */
+export const getWebhookCopyName = (source: Pick<Webhook, "name" | "url">): string =>
+  `Copy of ${source.name?.trim() || source.url}`;
+
+/**
+ * Creates a copy of `source` in the same workspace: same URL, triggers and surveys, a "Copy of" name
+ * and a signing secret of its own. The copy is always a `user` webhook, because a person made it in
+ * the app, whatever integration made the original.
+ */
+export const createWebhookCopy = (source: TWebhookWithoutSecret): Promise<TWebhookWithoutSecret> =>
+  prisma.webhook.create({
+    data: {
+      name: getWebhookCopyName(source),
+      url: source.url,
+      triggers: source.triggers,
+      surveyIds: source.surveyIds,
+      secret: generateWebhookSecret(),
+      workspaceId: source.workspaceId,
+    },
+    select: webhookWithoutSecretSelect,
+  });
