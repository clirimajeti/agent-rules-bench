+"use client";
+
+import { CopyIcon } from "lucide-react";
+import toast from "react-hot-toast";
+import { useTranslation } from "react-i18next";
+import { useDuplicateWebhook } from "@/modules/integrations/webhooks/hooks/use-duplicate-webhook";
+import { Button } from "@/modules/ui/components/button";
+import { TooltipRenderer } from "@/modules/ui/components/tooltip";
+
+export const DuplicateWebhookButton = ({ webhookId }: Readonly<{ webhookId: string }>) => {
+  const { t } = useTranslation();
+  const { mutate, isPending } = useDuplicateWebhook();
+
+  const handleDuplicate = () => {
+    mutate(
+      { webhookId },
+      {
+        onSuccess: () => toast.success(t("workspace.integrations.webhooks.webhook_duplicated_successfully")),
+        onError: () => toast.error(t("workspace.integrations.webhooks.webhook_duplicate_failed")),
+      }
+    );
+  };
+
+  return (
+    <TooltipRenderer tooltipContent={t("common.duplicate")}>
+      <Button
+        type="button"
+        variant="ghost"
+        size="icon"
+        aria-label={t("workspace.integrations.webhooks.duplicate_webhook")}
+        loading={isPending}
+        disabled={isPending}
+        onClick={handleDuplicate}>
+        <CopyIcon />
+      </Button>
+    </TooltipRenderer>
+  );
+};
