+import { beforeEach, describe, expect, test, vi } from "vitest";
+import { prisma } from "@formbricks/database";
+import { createWebhookCopy, getWebhookCopyName } from "./service";
+
+vi.mock("server-only", () => ({}));
+vi.mock("@formbricks/database", () => ({
+  prisma: { webhook: { create: vi.fn(), findUnique: vi.fn() } },
+}));
+vi.mock("@/lib/crypto", () => ({ generateWebhookSecret: () => "whsec_new" }));
+
+const source = {
+  id: "clww1234567890123456789012",
+  name: "CRM sync",
+  url: "https://example.com/hook",
+  source: "zapier" as const,
+  workspaceId: "clxx1234567890123456789012",
+  triggers: ["responseFinished" as const, "responseCreated" as const],
+  surveyIds: ["clss1234567890123456789012"],
+  createdAt: new Date("2026-04-21T10:00:00.000Z"),
+  updatedAt: new Date("2026-04-22T10:00:00.000Z"),
+};
+
+beforeEach(() => {
+  vi.resetAllMocks();
+});
+
+describe("getWebhookCopyName", () => {
+  test("prefixes the name of the original", () => {
+    expect(getWebhookCopyName({ name: "CRM sync", url: "https://example.com/hook" })).toBe(
+      "Copy of CRM sync"
+    );
+  });
+
+  test("uses the URL when the original has no name, as the list does", () => {
+    expect(getWebhookCopyName({ name: null, url: "https://example.com/hook" })).toBe(
+      "Copy of https://example.com/hook"
+    );
+    expect(getWebhookCopyName({ name: "  ", url: "https://example.com/hook" })).toBe(
+      "Copy of https://example.com/hook"
+    );
+  });
+});
+
+describe("createWebhookCopy", () => {
+  test("copies URL, triggers and surveys into the same workspace with a new secret", async () => {
+    await createWebhookCopy(source);
+
+    const { data, select } = vi.mocked(prisma.webhook.create).mock.calls[0][0];
+    expect(data).toEqual({
+      name: "Copy of CRM sync",
+      url: source.url,
+      triggers: source.triggers,
+      surveyIds: source.surveyIds,
+      secret: "whsec_new",
+      workspaceId: source.workspaceId,
+    });
+    // The secret is written but never read back, so it cannot reach a response or an audit entry.
+    expect(select).not.toHaveProperty("secret");
+  });
+});
