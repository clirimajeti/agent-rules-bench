+/**
+ * POST /api/v3/webhooks/{webhookId}/duplicate - copy a webhook: same URL, triggers and surveys, a
+ * "Copy of" name and a new signing secret.
+ *
+ * Session-only, deliberately. It backs the Duplicate button in the app's webhook settings; API keys
+ * manage webhooks through the v2 management API.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { duplicateV3Webhook } from "../../lib/operations";
+import { ZV3WebhookIdParams } from "../../lib/schemas";
+
+export const POST = withV3ApiWrapper({
+  auth: "session",
+  action: "created",
+  targetType: "webhook",
+  schemas: { params: ZV3WebhookIdParams },
+  handler: async ({ authentication, parsedInput, auditLog, requestId, instance }) =>
+    duplicateV3Webhook({
+      authentication,
+      webhookId: parsedInput.params.webhookId,
+      auditLog,
+      requestId,
+      instance,
+    }),
+});
diff --git a/apps/web/app/api/v3/webhooks/lib/operations.test.ts b/apps/web/app/api/v3/webhooks/lib/operations.test.ts
new file mode 100644
index 000000000..c52f79af8
