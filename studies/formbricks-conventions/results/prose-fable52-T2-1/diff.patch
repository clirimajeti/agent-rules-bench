+import { afterEach, describe, expect, test, vi } from "vitest";
+import { duplicateWebhook } from "./api-client";
+
+afterEach(() => {
+  vi.restoreAllMocks();
+  vi.unstubAllGlobals();
+});
+
+const webhookId = "clww1234567890123456789012";
+
+describe("duplicateWebhook", () => {
+  test("posts to the duplicate sub-route and returns body.data", async () => {
+    const copy = { id: "clcc1234567890123456789012", name: "Copy of CRM sync" };
+    const fetchMock = vi.fn().mockResolvedValue(
+      new Response(JSON.stringify({ data: copy }), {
+        status: 201,
+        headers: { "Content-Type": "application/json" },
+      })
+    );
+    vi.stubGlobal("fetch", fetchMock);
+
+    await expect(duplicateWebhook({ webhookId })).resolves.toEqual(copy);
+    expect(fetchMock).toHaveBeenCalledWith(
