@@ -0,0 +1,92 @@
+import "server-only";
+import { InvalidInputError } from "@formbricks/types/errors";
+import { requireV3WorkspaceAccess } from "@/app/api/v3/lib/auth";
+import { problemForbidden, problemUnprocessableContent, successResponse } from "@/app/api/v3/lib/response";
+import type { TV3AuditLog, TV3Authentication } from "@/app/api/v3/lib/types";
+import {
+  SURVEY_NOT_WORKSPACE_VISIBLE_MESSAGE,
+  findNotWorkspaceVisibleSurveyIds,
+} from "@/lib/survey/visibility/outbound";
+import { validateWebhookUrl } from "@/lib/utils/validate-webhook-url";
+import { isDiscordWebhook } from "@/modules/integrations/webhooks/lib/utils";
+import { serializeV3Webhook } from "./serializers";
+import { createWebhookCopy, getWebhookWithoutSecret } from "./service";
+
+type TDuplicateV3WebhookParams = {
+  authentication: TV3Authentication;
+  webhookId: string;
+  auditLog?: TV3AuditLog;
+  requestId: string;
+  instance?: string;
+};
+
+/** Whether the URL of the original may still be a webhook target on this instance. */
+const isWebhookUrlStillAllowed = async (url: string): Promise<boolean> => {
+  if (isDiscordWebhook(url)) return false;
+
+  try {
+    await validateWebhookUrl(url);
+    return true;
+  } catch (error) {
+    if (error instanceof InvalidInputError) return false;
+    throw error;
+  }
+};
+
+/**
+ * Duplicates a webhook in its own workspace.
+ *
+ * The workspace comes from the webhook, never from the request, so a caller cannot pair another
+ * tenant's webhook id with a workspace they can write to. An unknown webhook answers 403, not 404, so
+ * webhook ids cannot be probed for existence (same rule as `/api/v3/tags/{tagId}`).
+ *
+ * A copy attaches its surveys and its URL anew, so both are checked as they are for a new webhook: a
+ * survey that became restricted after the original was made, or a URL the instance no longer accepts,
+ * answers 422 and nothing is written.
+ */
+export async function duplicateV3Webhook(params: TDuplicateV3WebhookParams): Promise<Response> {
+  const { authentication, webhookId, auditLog, requestId, instance } = params;
+
+  const source = await getWebhookWithoutSecret(webhookId);
+  if (!source) {
+    return problemForbidden(requestId, "You are not authorized to access this resource", instance);
+  }
+
+  const access = await requireV3WorkspaceAccess(
+    authentication,
+    source.workspaceId,
+    "readWrite",
+    requestId,
+    instance
+  );
+  if (access instanceof Response) return access;
+
+  if (auditLog) {
+    auditLog.organizationId = access.organizationId;
+    auditLog.oldObject = source;
+  }
+
+  const [urlAllowed, blockedSurveyIds] = await Promise.all([
+    isWebhookUrlStillAllowed(source.url),
+    findNotWorkspaceVisibleSurveyIds(source.surveyIds),
+  ]);
+
+  if (!urlAllowed) {
+    return problemUnprocessableContent(requestId, "The URL of this webhook is no longer allowed", {
+      instance,
+    });
+  }
+
+  if (blockedSurveyIds.length > 0) {
+    return problemUnprocessableContent(requestId, SURVEY_NOT_WORKSPACE_VISIBLE_MESSAGE, { instance });
+  }
+
+  const copy = await createWebhookCopy(source);
+
+  if (auditLog) {
+    auditLog.targetId = copy.id;
+    auditLog.newObject = copy;
+  }
+
+  return successResponse(serializeV3Webhook(copy), { requestId, status: 201 });
+}
