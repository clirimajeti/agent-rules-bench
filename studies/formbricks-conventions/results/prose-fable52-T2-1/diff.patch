+import type { Webhook } from "@formbricks/database/prisma";
+
+/** A webhook as v3 returns it. The signing secret is never part of it. */
+export type TV3Webhook = {
+  id: string;
+  name: string | null;
+  url: string;
+  source: Webhook["source"];
+  workspaceId: string;
+  triggers: Webhook["triggers"];
+  surveyIds: string[];
+  createdAt: string;
+  updatedAt: string;
+};
+
+export const serializeV3Webhook = (webhook: Omit<Webhook, "secret">): TV3Webhook => ({
+  id: webhook.id,
+  name: webhook.name,
+  url: webhook.url,
+  source: webhook.source,
+  workspaceId: webhook.workspaceId,
+  triggers: webhook.triggers,
+  surveyIds: webhook.surveyIds,
+  createdAt: webhook.createdAt.toISOString(),
+  updatedAt: webhook.updatedAt.toISOString(),
+});
