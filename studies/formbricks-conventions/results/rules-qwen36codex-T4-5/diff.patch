@@ -0,0 +1,29 @@
+import "server-only";
+import { cache as reactCache } from "react";
+import { prisma } from "@formbricks/database";
+import { ZId } from "@formbricks/types/common";
+import { validateInputs } from "@/lib/utils/validate";
+
+/**
+ * Find tags in a workspace that are not associated with any response.
+ * Uses an outer join to detect tags with no matching TagsOnResponses entry.
+ */
+export const getUnusedTagsByWorkspaceId = reactCache(
+  async (workspaceId: string): Promise<string[]> => {
+    validateInputs([workspaceId, ZId]);
+
+    const unusedTags = await prisma.tag.findMany({
+      where: {
+        workspaceId,
+        responses: {
+          none: {},
+        },
+      },
+      select: {
+        id: true,
+      },
+    });
+
+    return unusedTags.map((tag) => tag.id);
+  }
+);
