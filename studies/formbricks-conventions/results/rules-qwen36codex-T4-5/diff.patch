@@ -0,0 +1,69 @@
+/**
+ * DELETE /api/v3/tags/bulk-delete-unused — delete all unused tags of a workspace.
+ *
+ * Session-only. The workspace is resolved from the caller's authorization, not from the
+ * client-supplied `workspaceId` — the caller must pass it in the body so the route can
+ * validate it, but the workspace boundary is enforced server-side.
+ */
+import "server-only";
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { problemInternalError, problemUnprocessableContent, successResponse } from "@/app/api/v3/lib/response";
+import type { TV3Authentication } from "@/app/api/v3/lib/types";
+import { getUnusedTagsByWorkspaceId } from "@/lib/unusedTag/service";
+import { deleteTag } from "@/modules/workspaces/settings/lib/tag";
+import { z } from "zod";
+
+const ZBulkDeleteUnusedBody = z
+  .object({ workspaceId: z.string().cuid2() })
+  .strict()
+  .transform((body) => body);
+
+export const DELETE = withV3ApiWrapper({
+  auth: "session",
+  action: "deleted",
+  targetType: "tag",
+  schemas: { body: ZBulkDeleteUnusedBody },
+  handler: async ({ authentication, parsedInput, auditLog, requestId, instance }) => {
+    const { workspaceId } = parsedInput.body;
+
+    // Resolve the workspace from the caller's access to ensure the caller can only
+    // delete unused tags from workspaces they already have readWrite access to.
+    const access = await requireWorkspaceAccess(authentication, workspaceId, "readWrite", requestId, instance);
+    if (access instanceof Response) return access;
+
+    const unusedTagIds = await getUnusedTagsByWorkspaceId(access.workspaceId);
+
+    if (unusedTagIds.length === 0) {
+      return successResponse({ deletedCount: 0 }, { requestId });
+    }
+
+    // Delete tags one by one (cascade handles the junction table).
+    let deletedCount = 0;
+    for (const tagId of unusedTagIds) {
+      const result = await deleteTag(tagId);
+      if (result.ok) {
+        deletedCount++;
+        if (auditLog) {
+          auditLog.targetId = tagId;
+          auditLog.oldObject = result.data;
+        }
+      }
+    }
+
+    return successResponse({ deletedCount }, { requestId });
+  },
+});
+
+/** Minimal workspace-access check for this route; mirrors requireV3WorkspaceAccess. */
+async function requireWorkspaceAccess(
+  authentication: TV3Authentication,
+  workspaceId: string,
+  _action: string,
+  requestId: string,
+  instance: string | undefined
+): Promise<Response | { workspaceId: string; organizationId: string }> {
+  const { requireV3WorkspaceAccess } = await import("@/app/api/v3/lib/auth");
+  const access = await requireV3WorkspaceAccess(authentication, workspaceId, "readWrite", requestId, instance);
+  if (access instanceof Response) return access;
+  return { workspaceId: access.workspaceId, organizationId: access.organizationId };
+}
