+/**
+ * Button + confirmation dialog for bulk-deleting unused tags. Rendered as the `footer` of the
+ * `SettingsCard` so the action is visible but doesn't compete with the per-row controls.
+ */
+const BulkDeleteUnusedTags = ({ workspaceId }: Readonly<{ workspaceId: string }>) => {
+  const { t } = useTranslation();
+  const [open, setOpen] = useState(false);
+  const bulkDelete = useBulkDeleteUnusedTags(workspaceId);
+  const [deletedCount, setDeletedCount] = useState<number | null>(null);
+
+  const handleConfirm = async () => {
+    try {
+      const result = await bulkDelete.mutateAsync({ workspaceId });
+      setDeletedCount(result.deletedCount);
+      setOpen(false);
+      toast.success(t("workspace.tags.tags_deleted", { count: result.deletedCount }));
+    } catch {
+      toast.error(t("common.something_went_wrong_please_try_again"));
