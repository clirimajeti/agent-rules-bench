--- /dev/null
+++ b/apps/web/modules/workspaces/settings/tags/hooks/use-bulk-delete-unused-tags.ts
@@ -0,0 +1,14 @@
+"use client";
+
+import { useMutation, useQueryClient } from "@tanstack/react-query";
+import { bulkDeleteUnusedTags } from "../lib/api-client";
+import { tagKeys } from "../lib/query";
+
+/** Delete all unused tags in a workspace, then invalidate the list. */
+export const useBulkDeleteUnusedTags = (workspaceId: string) => {
+  const queryClient = useQueryClient();
+  return useMutation({
+    mutationFn: ({ workspaceId: wid }: { workspaceId: string }) => bulkDeleteUnusedTags({ workspaceId: wid }),
+    onSuccess: () => queryClient.invalidateQueries({ queryKey: tagKeys.list(workspaceId) }),
+  });
+};
