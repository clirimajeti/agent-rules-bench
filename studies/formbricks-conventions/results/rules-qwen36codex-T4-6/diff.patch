@@ -1,3 +1,4 @@
+import { prisma } from "@formbricks/database";
 import "server-only";
 import { requireV3WorkspaceAccess } from "@/app/api/v3/lib/auth";
 import {
@@ -188,3 +189,49 @@ export async function mergeV3Tags(
 
   return successResponse({ id: newTagId }, { requestId });
 }
+
+export async function deleteUnusedV3Tags(
+  params: TBaseParams & { workspaceId: string; auditLog?: TV3AuditLog }
+): Promise<Response> {
+  const { workspaceId, authentication, requestId, instance } = params;
+
+  const access = await requireV3WorkspaceAccess(authentication, workspaceId, "readWrite", requestId, instance);
+  if (access instanceof Response) return access;
+
+  // Find all tags in this workspace that have zero response associations
+  const tags = await getTagsByWorkspaceId(workspaceId);
+
+  // Get tags that have zero count (not used on any response)
+  const countByTagId = new Map(
+    (
+      await getTagsOnResponsesCount(
+        workspaceId,
+        buildVisibleSurveyWhere(await resolveV3ResponsesActorContext(authentication, access.organizationId))
+      )
+    ).map((entry) => [entry.tagId, entry.count])
+  );
+
+  const unusedTagIds = tags
+    .filter((tag) => countByTagId.get(tag.id) === 0)
+    .map((tag) => tag.id);
+
+  if (unusedTagIds.length === 0) {
+    return successResponse({ deletedCount: 0 }, { requestId });
+  }
+
+  // Delete the unused tags (Prisma's deleteMany cascades to tagsOnResponses)
+  const result = await prisma.tag.deleteMany({
+    where: {
+      id: { in: unusedTagIds },
+      workspaceId,
+    },
+  });
+
+  if (auditLog) {
+    auditLog.organizationId = access.organizationId;
+    auditLog.targetId = unusedTagIds.join(",");
+    auditLog.oldObject = { tagIds: unusedTagIds, deletedCount: result.count };
+  }
+
+  return successResponse({ deletedCount: result.count }, { requestId });
+}
