+/**
+ * DELETE /api/v3/tags/delete-unused — delete all unused tags of the workspace.
+ *
+ * The workspace is resolved from the authenticated user's access, matching the pattern used by
+ * other v3 tag mutations. Session-only.
+ */
+import { z } from "zod";
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { deleteUnusedV3Tags } from "../lib/operations";
+
+export const DELETE = withV3ApiWrapper({
+  auth: "session",
+  action: "deleted",
+  targetType: "tag",
+  schemas: { query: z.object({ workspaceId: z.string().cuid2() }).strict() },
+  handler: async ({ authentication, parsedInput, auditLog, requestId, instance }) =>
+    deleteUnusedV3Tags({
+      authentication,
+      workspaceId: parsedInput.query.workspaceId,
+      auditLog,
+      requestId,
+      instance,
+    }),
+});
