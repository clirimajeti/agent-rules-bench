diff --git a/apps/web/modules/workspaces/settings/tags/hooks/use-delete-unused-tags.ts b/apps/web/modules/workspaces/settings/tags/hooks/use-delete-unused-tags.ts
new file mode 100644
index 000000000..c4b7c743c
--- /dev/null
+++ b/apps/web/modules/workspaces/settings/tags/hooks/use-delete-unused-tags.ts
@@ -0,0 +1,14 @@
+"use client";
+
+import { useMutation, useQueryClient } from "@tanstack/react-query";
+import { deleteUnusedTags } from "../lib/api-client";
+import { tagKeys } from "../lib/query";
+
+/** Bulk-delete unused tags, then invalidate the list. */
+export const useDeleteUnusedTags = (workspaceId: string) => {
+  const queryClient = useQueryClient();
+  return useMutation({
+    mutationFn: (variables: { workspaceId: string }) => deleteUnusedTags(variables),
+    onSuccess: () => queryClient.invalidateQueries({ queryKey: tagKeys.list(workspaceId) }),
+  });
+};
