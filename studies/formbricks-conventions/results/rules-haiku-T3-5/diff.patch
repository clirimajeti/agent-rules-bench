diff --git a/apps/web/app/(app)/workspaces/[workspaceId]/settings/account/profile/components/DownloadMyDataButton.tsx b/apps/web/app/(app)/workspaces/[workspaceId]/settings/account/profile/components/DownloadMyDataButton.tsx
new file mode 100644
index 000000000..3cb89f076
--- /dev/null
+++ b/apps/web/app/(app)/workspaces/[workspaceId]/settings/account/profile/components/DownloadMyDataButton.tsx
@@ -0,0 +1,41 @@
+"use client";
+
+import { DownloadIcon } from "lucide-react";
+import { useTranslation } from "react-i18next";
+import type { TUser } from "@formbricks/types/user";
+import { Button } from "@/modules/ui/components/button";
+
+export interface TUserDataExport {
+  name: string;
+  email: string;
+  locale: string;
+  notificationSettings: TUser["notificationSettings"];
+  organizationMemberships: { organizationName: string; role: string }[];
+}
+
+interface DownloadMyDataButtonProps {
+  data: TUserDataExport;
+}
+
+export const DownloadMyDataButton = ({ data }: Readonly<DownloadMyDataButtonProps>) => {
+  const { t } = useTranslation();
+
+  const handleDownload = () => {
+    const blob = new Blob([JSON.stringify(data, null, 2)], { type: "application/json" });
+    const url = URL.createObjectURL(blob);
+    const link = document.createElement("a");
+    link.href = url;
+    link.download = "formbricks-my-data.json";
+    document.body.appendChild(link);
+    link.click();
+    link.remove();
+    URL.revokeObjectURL(url);
+  };
+
+  return (
+    <Button variant="secondary" size="sm" onClick={handleDownload}>
+      <DownloadIcon className="mr-2 size-4" />
+      {t("workspace.settings.profile.download_my_data")}
+    </Button>
+  );
+};
diff --git a/apps/web/app/(app)/workspaces/[workspaceId]/settings/account/profile/lib/organization-memberships.ts b/apps/web/app/(app)/workspaces/[workspaceId]/settings/account/profile/lib/organization-memberships.ts
new file mode 100644
index 000000000..5872593f4
--- /dev/null
+++ b/apps/web/app/(app)/workspaces/[workspaceId]/settings/account/profile/lib/organization-memberships.ts
@@ -0,0 +1,29 @@
+import { cache as reactCache } from "react";
+import { prisma } from "@formbricks/database";
+
+export interface TUserOrganizationMembership {
+  organizationName: string;
+  role: string;
+}
+
+/**
+ * Organizations the user has accepted membership in, with the role they hold there.
+ * Pending invites are not memberships yet, so they are left out of the export.
+ */
+export const getUserOrganizationMemberships = reactCache(
+  async (userId: string): Promise<TUserOrganizationMembership[]> => {
+    const memberships = await prisma.membership.findMany({
+      where: { userId, accepted: true },
+      select: {
+        role: true,
+        organization: { select: { name: true } },
+      },
+      orderBy: { organization: { name: "asc" } },
+    });
+
+    return memberships.map((membership) => ({
+      organizationName: membership.organization.name,
+      role: membership.role,
+    }));
+  }
+);
