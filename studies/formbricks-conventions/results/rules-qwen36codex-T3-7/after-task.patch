+/**
+ * GET /api/v3/me/data-export — personal data export for the authenticated user.
+ * Returns name, email, locale, notification settings, and organization memberships.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { prisma } from "@formbricks/database";
+import { getUser } from "@/lib/user/service";
+import { TAuditAction, TAuditTarget } from "@/modules/ee/audit-logs/types/audit-log";
+import { queueV3AuditLog } from "@/app/api/v3/lib/audit";
+
+export const GET = withV3ApiWrapper({
+  auth: "session",
+  rateLimit: true,
+  action: "dataExport" as TAuditAction,
+  targetType: "user" as TAuditTarget,
+  handler: async ({ authentication, auditLog }) => {
+    if (!authentication?.session?.user) {
+      return new Response("Unauthorized", { status: 401 });
+    }
+
+    const user = await getUser(authentication.session.user.id);
+    if (!user) {
+      return new Response("Not found", { status: 404 });
+    }
+
+    const memberships = await prisma.membership.findMany({
+      where: {
+        userId: user.id,
+        accepted: true,
+      },
+      select: {
+        organization: {
+          select: {
+            name: true,
+          },
+        },
+        role: true,
+      },
+    });
+
+    const data = {
+      name: user.name,
+      email: user.email,
+      locale: user.locale,
+      notificationSettings: user.notificationSettings,
+      organizationMemberships: memberships.map((m) => ({
+        organization: m.organization.name,
+        role: m.role,
+      })),
+    };
+
+    queueV3AuditLog({
+      auditLog,
+      action: "dataExport",
+      targetType: "user",
+      userId: user.id,
+      oldObject: null,
+      newObject: data,
+    });
+
+    return new Response(JSON.stringify(data, null, 2), {
+      status: 200,
+      headers: {
+        "Content-Type": "application/json",
+      },
+    });
+  },
+});
