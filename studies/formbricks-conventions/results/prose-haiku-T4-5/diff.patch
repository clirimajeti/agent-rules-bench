@@ -0,0 +1,66 @@
+post:
+  operationId: deleteUnusedTagsV3
+  # Session-only by design, so an API-key caller reading the published reference would only ever get a
+  # 401. Excluded from the generated docs pages until ENG-2533 decides between dropping the paths
+  # and opening them to API keys; the operation stays in the bundle for the contract tests.
+  x-excluded: true
+  summary: Delete unused tags
+  description: |
+    Deletes every tag in the workspace that no response carries. "Unused" is judged across the whole
+    workspace, not only the responses the caller can see, so a tag still applied to a response the caller
+    cannot read is kept. Requires organization owner/manager, or a workspace team membership with
+    read-write permission.
+
+    Answers how many tags were deleted. Zero is a normal answer when every tag is in use.
+  tags:
+    - V3 Tags
+  parameters:
+    - in: query
+      name: workspaceId
+      required: true
+      schema:
+        type: string
+        format: cuid2
+      description: |
+        Workspace identifier. This is the canonical container ID for v3 APIs.
+  responses:
+    "200":
+      description: Unused tags deleted
+      headers:
+        X-Request-Id:
+          schema:
+            type: string
+          description: Request correlation ID
+        Cache-Control:
+          schema:
+            type: string
+          example: private, no-store
+      content:
+        application/json:
+          schema:
+            type: object
+            required:
+              - data
+            properties:
+              data:
+                type: object
+                required:
+                  - deleted
+                additionalProperties: false
+                properties:
+                  deleted:
+                    type: integer
+                    minimum: 0
+                    description: Number of tags deleted.
+    "400":
+      $ref: ../components/responses/V3BadRequest.yml
+    "401":
+      $ref: ../components/responses/V3UnauthorizedSession.yml
+    "403":
+      $ref: ../components/responses/V3Forbidden.yml
+    "429":
+      $ref: ../components/responses/V3TooManyRequests.yml
+    "500":
+      $ref: ../components/responses/V3InternalServerError.yml
+  security:
+    - sessionAuth: []
