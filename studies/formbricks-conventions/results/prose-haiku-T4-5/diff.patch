+/**
+ * POST /api/v3/tags/delete-unused - delete every tag in a workspace that no response carries.
+ *
+ * A POST custom method rather than a `DELETE` on the collection: a collection-level delete that loses its
+ * `workspaceId` must not be able to erase every tag by accident, and a distinct path cannot be reached by
+ * accident. Session-only, matching the tag routes it sits beside.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { deleteUnusedV3Tags } from "../lib/operations";
+import { ZV3TagListQuery } from "../lib/schemas";
+
+export const POST = withV3ApiWrapper({
+  auth: "session",
+  action: "deleted",
+  targetType: "tag",
+  schemas: { query: ZV3TagListQuery },
+  handler: async ({ authentication, parsedInput, auditLog, requestId, instance }) =>
+    deleteUnusedV3Tags({
+      authentication,
+      workspaceId: parsedInput.query.workspaceId,
+      auditLog,
+      requestId,
+      instance,
+    }),
+});
