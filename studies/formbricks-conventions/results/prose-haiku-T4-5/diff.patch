+/**
+ * Deletes every tag in the workspace that no response carries. The "unused" check is part of the single
+ * `DELETE` statement, so a tag applied between a read and the delete cannot be removed by mistake. It
+ * counts links across the whole workspace, not the caller's visible subset: a response the caller cannot
+ * see still uses its tags, and deleting them would silently strip that response.
+ */
+export const deleteUnusedTags = async (
+  workspaceId: string
+): Promise<Result<{ count: number }, { code: TagError; message: string }>> => {
+  validateInputs([workspaceId, ZId]);
+
+  try {
+    const result = await prisma.tag.deleteMany({
+      where: {
+        workspaceId,
+        responses: { none: {} },
+      },
+    });
+
+    return ok({ count: result.count });
+  } catch (error) {
+    return err({
+      code: TagError.UNEXPECTED_ERROR,
+      message: error instanceof Error ? error.message : "Unknown error occurred",
+    });
+  }
+};
