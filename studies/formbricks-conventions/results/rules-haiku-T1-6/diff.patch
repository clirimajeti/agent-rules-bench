+/**
+ * POST /api/v3/api-keys/{apiKeyId}/rotate - replace a key's secret. The label, organization access and
+ * workspace permissions are kept. The previous secret stops working immediately, and the new one is
+ * returned once in `actualKey`. Session-only.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { rotateV3ApiKey } from "../../lib/operations";
+import { ZV3ApiKeyIdParams } from "../../lib/schemas";
+
+export const POST = withV3ApiWrapper({
+  auth: "session",
+  action: "updated",
+  targetType: "apiKey",
+  schemas: { params: ZV3ApiKeyIdParams },
+  handler: async ({ authentication, parsedInput, auditLog, requestId, instance }) =>
+    rotateV3ApiKey({
+      authentication,
+      apiKeyId: parsedInput.params.apiKeyId,
+      auditLog,
+      requestId,
+      instance,
+    }),
+});
diff --git a/apps/web/app/api/v3/api-keys/lib/operations.ts b/apps/web/app/api/v3/api-keys/lib/operations.ts
new file mode 100644
index 000000000..908b1235e
--- /dev/null
+++ b/apps/web/app/api/v3/api-keys/lib/operations.ts
@@ -0,0 +1,62 @@
+import "server-only";
+import { problemForbidden, problemUnauthorized, successResponse } from "@/app/api/v3/lib/response";
+import type { TV3AuditLog, TV3Authentication } from "@/app/api/v3/lib/types";
+import { assertCan } from "@/lib/authorization";
+import {
+  getApiKeyAuthorizationTarget,
+  rotateApiKey,
+} from "@/modules/organization/settings/api-keys/lib/api-key";
+import { assertCanGrantOrganizationAccess } from "@/modules/organization/settings/api-keys/lib/organization-access";
+
+type TBaseParams = {
+  authentication: TV3Authentication;
+  requestId: string;
+  instance?: string;
+};
+
+function getSessionUserId(authentication: TV3Authentication): string | null {
+  if (authentication && "user" in authentication && authentication.user?.id) {
+    return authentication.user.id;
+  }
+  return null;
+}
+
+/**
+ * Rotation mints a new secret for an existing key, so it needs the same authority as creating a key
+ * (`organization.manage_api_keys`) plus per-key management (`apiKey.manage`). It also keeps the key's
+ * organization access, so it is refused to anyone who could not have granted that access in the first
+ * place. Without the last check, a manager could take a write-capable key that an owner created and
+ * obtain its secret.
+ *
+ * An unknown key answers 403, not 404, so a signed-in user cannot probe key ids across the instance.
+ */
+export async function rotateV3ApiKey(
+  params: TBaseParams & { apiKeyId: string; auditLog?: TV3AuditLog }
+): Promise<Response> {
+  const { authentication, apiKeyId, auditLog, requestId, instance } = params;
+
+  const actorId = getSessionUserId(authentication);
+  if (!actorId) return problemUnauthorized(requestId, "Session required", instance);
+
+  const target = await getApiKeyAuthorizationTarget(apiKeyId);
+  if (!target) {
+    return problemForbidden(requestId, "You are not authorized to access this resource", instance);
+  }
+
+  await assertCan({ type: "user", id: actorId }, "organization.manage_api_keys", {
+    type: "organization",
+    id: target.organizationId,
+  });
+  await assertCan({ type: "user", id: actorId }, "apiKey.manage", { type: "apiKey", id: apiKeyId });
+  await assertCanGrantOrganizationAccess(actorId, target.organizationId, target.organizationAccess);
+
+  if (auditLog) {
+    auditLog.organizationId = target.organizationId;
+    auditLog.targetId = apiKeyId;
+  }
+
+  // The audit entry records the key's id only. It never carries the secret or either hash.
+  const rotated = await rotateApiKey(apiKeyId);
+
+  return successResponse(rotated, { requestId });
+}
