@@ -0,0 +1,30 @@
+import { parseV3ApiError } from "@/modules/api/lib/v3-client";
+import type { TApiKeyRotated } from "@/modules/organization/settings/api-keys/types/api-keys";
+
+/**
+ * Client fetchers for the API key v3 routes. Every call throws a parsed `V3ApiError` on a non-2xx
+ * response, so the caller can surface the server's own message.
+ */
+
+/** The rotate response as it arrives over JSON, before its dates are revived. */
+type TRotatedApiKeyResponse = Omit<TApiKeyRotated, "createdAt" | "lastUsedAt"> & {
+  createdAt: string;
+  lastUsedAt: string | null;
+};
+
+export async function rotateApiKey(params: { apiKeyId: string }): Promise<TApiKeyRotated> {
+  const response = await fetch(`/api/v3/api-keys/${params.apiKeyId}/rotate`, {
+    method: "POST",
+    cache: "no-store",
+  });
+  if (!response.ok) {
+    throw await parseV3ApiError(response);
+  }
+
+  const { data } = (await response.json()) as { data: TRotatedApiKeyResponse };
+  return {
+    ...data,
+    createdAt: new Date(data.createdAt),
+    lastUsedAt: data.lastUsedAt ? new Date(data.lastUsedAt) : null,
+  };
+}
