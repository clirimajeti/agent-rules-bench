+import { useMutation } from "@tanstack/react-query";
+import { rotateApiKey } from "@/modules/organization/settings/api-keys/lib/api-client";
+
+/**
+ * Rotate a key's secret. The list is server-rendered, so the caller patches its own row from the result
+ * rather than invalidating a query.
