+post:
+  operationId: duplicateWebhookV3
+  # Session-only: it backs the Duplicate button on the workspace webhooks settings page. Excluded from the
+  # generated docs pages for the same reason as the `/tags` operations (ENG-2533): an API-key caller
+  # reading the published reference would only ever get a 401. The operation stays in the bundle for the
+  # contract tests.
+  x-excluded: true
+  summary: Duplicate a webhook
+  description: |
+    Creates a copy of a webhook in the same workspace, with the same URL, triggers and surveys. The copy
+    is named `Copy of ` followed by the original's name (or its URL, when it has none), gets a new signing
+    secret and the `user` source. The secret is not returned.
+
+    The workspace is resolved from the webhook itself. Requires organization owner/manager, or a
+    workspace team membership with read-write permission. An unknown `webhookId` answers `403`, not
+    `404`, so webhook ids cannot be probed for existence.
+
+    The copy attaches its surveys anew, so a survey that is no longer visible to the whole workspace
+    answers `422`, as does a URL that no longer passes webhook URL validation.
+  tags:
+    - V3 Webhooks
+  parameters:
+    - in: path
+      name: webhookId
+      required: true
+      schema:
+        type: string
+        format: cuid2
+      description: The webhook to copy.
+  responses:
+    "201":
+      description: The copy
+      headers:
+        X-Request-Id:
+          schema:
+            type: string
+          description: Request correlation ID
+        Cache-Control:
+          schema:
+            type: string
+          example: private, no-store
+      content:
+        application/json:
+          schema:
+            type: object
+            required:
+              - data
+            properties:
+              data:
+                $ref: ../components/schemas/WebhookResource.yml
+    "400":
+      $ref: ../components/responses/V3BadRequest.yml
+    "401":
+      $ref: ../components/responses/V3UnauthorizedSession.yml
+    "403":
+      $ref: ../components/responses/V3Forbidden.yml
+    "422":
+      $ref: ../components/responses/V3UnprocessableContent.yml
+    "429":
+      $ref: ../components/responses/V3TooManyRequests.yml
+    "500":
+      $ref: ../components/responses/V3InternalServerError.yml
+  security:
+    - sessionAuth: []
