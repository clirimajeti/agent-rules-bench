+import type { Webhook } from "@formbricks/database/prisma";
+
+/**
+ * The webhook as the v3 API returns it. The signing `secret` is deliberately absent: it is shown once,
+ * when a webhook is created in the app, and never travels in a response body after that.
+ */
+export type TV3Webhook = {
+  id: string;
+  name: string | null;
+  url: string;
+  source: Webhook["source"];
+  workspaceId: string;
+  triggers: Webhook["triggers"];
+  /** Empty means every survey in the workspace. */
+  surveyIds: string[];
+  createdAt: string;
+  updatedAt: string;
+};
+
+export const serializeV3Webhook = (webhook: Webhook): TV3Webhook => ({
+  id: webhook.id,
+  name: webhook.name,
+  url: webhook.url,
+  source: webhook.source,
+  workspaceId: webhook.workspaceId,
+  triggers: webhook.triggers,
+  surveyIds: webhook.surveyIds,
+  createdAt: webhook.createdAt.toISOString(),
+  updatedAt: webhook.updatedAt.toISOString(),
+});
