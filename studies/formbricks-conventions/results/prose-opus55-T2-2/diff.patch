+"use client";
+
+import { CopyIcon } from "lucide-react";
+import { toast } from "react-hot-toast";
+import { useTranslation } from "react-i18next";
+import { getV3ApiErrorMessage } from "@/modules/api/lib/v3-client";
+import { useDuplicateWebhook } from "@/modules/integrations/webhooks/hooks/use-duplicate-webhook";
+import { isSurveyNotWorkspaceVisibleMessage } from "@/modules/survey/visibility/lib/outbound";
+import { Button } from "@/modules/ui/components/button";
+
+interface DuplicateWebhookButtonProps {
+  webhookId: string;
+}
+
+export const DuplicateWebhookButton = ({ webhookId }: Readonly<DuplicateWebhookButtonProps>) => {
+  const { t } = useTranslation();
+  const duplicateWebhook = useDuplicateWebhook();
+
+  const handleDuplicate = () => {
+    duplicateWebhook.mutate(
+      { webhookId },
+      {
+        onSuccess: () => {
+          toast.success(t("workspace.integrations.webhooks.webhook_duplicated_successfully"));
+        },
+        onError: (error) => {
+          const message = getV3ApiErrorMessage(error, t("common.something_went_wrong_please_try_again"));
+          toast.error(
+            isSurveyNotWorkspaceVisibleMessage(message)
+              ? t("workspace.integrations.webhooks.webhook_duplicate_restricted_surveys")
+              : message
+          );
+        },
+      }
+    );
+  };
+
+  return (
+    <Button
+      type="button"
+      variant="secondary"
+      size="sm"
+      onClick={handleDuplicate}
+      loading={duplicateWebhook.isPending}
+      disabled={duplicateWebhook.isPending}>
+      <CopyIcon />
+      {t("common.duplicate")}
+    </Button>
+  );
+};
