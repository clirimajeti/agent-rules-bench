@@ -0,0 +1,100 @@
+"use client";
+
+import { CopyIcon } from "lucide-react";
+import toast from "react-hot-toast";
+import { useTranslation } from "react-i18next";
+import { Button } from "@/modules/ui/components/button";
+import {
+  Dialog,
+  DialogBody,
+  DialogContent,
+  DialogDescription,
+  DialogFooter,
+  DialogHeader,
+  DialogTitle,
+} from "@/modules/ui/components/dialog";
+
+interface RotateApiKeyDialogProps {
+  open: boolean;
+  onOpenChange: (open: boolean) => void;
+  apiKeyLabel: string;
+  isRotating: boolean;
+  onConfirm: () => void;
+  /** Set once the rotation has succeeded. The dialog then shows this value and nothing else secret. */
+  rotatedKey: string | null;
+}
+
+/**
+ * Two steps in one dialog: confirm the rotation, then show the new key once. The parent clears
+ * `rotatedKey` when the dialog closes, so the secret is not kept in state after it is dismissed.
+ */
+export const RotateApiKeyDialog = ({
+  open,
+  onOpenChange,
+  apiKeyLabel,
+  isRotating,
+  onConfirm,
+  rotatedKey,
+}: Readonly<RotateApiKeyDialogProps>) => {
+  const { t } = useTranslation();
+
+  const copyToClipboard = async (value: string) => {
+    try {
+      await navigator.clipboard.writeText(value);
+      toast.success(t("workspace.api_keys.api_key_copied_to_clipboard"));
+    } catch {
+      toast.error(t("workspace.api_keys.unable_to_copy_api_key"));
+    }
+  };
+
+  if (rotatedKey) {
+    return (
+      <Dialog open={open} onOpenChange={onOpenChange}>
+        <DialogContent>
+          <DialogHeader>
+            <DialogTitle>{t("workspace.api_keys.rotated_api_key_title", { label: apiKeyLabel })}</DialogTitle>
+            <DialogDescription>{t("workspace.api_keys.rotated_api_key_security_warning")}</DialogDescription>
+          </DialogHeader>
+          <DialogBody className="space-y-4 px-1 py-4">
+            <div className="flex items-center justify-between gap-2 rounded-md border border-slate-200 bg-slate-50 p-3">
+              <span className="break-all font-mono text-sm" data-testid="rotated-api-key">
+                {rotatedKey}
+              </span>
+              <Button
+                size="icon"
+                variant="ghost"
+                aria-label={t("common.copy")}
+                onClick={() => void copyToClipboard(rotatedKey)}>
+                <CopyIcon />
+              </Button>
+            </div>
+          </DialogBody>
+          <DialogFooter>
+            <Button type="button" onClick={() => onOpenChange(false)}>
+              {t("common.done")}
+            </Button>
+          </DialogFooter>
+        </DialogContent>
+      </Dialog>
+    );
+  }
+
+  return (
+    <Dialog open={open} onOpenChange={onOpenChange}>
+      <DialogContent>
+        <DialogHeader>
+          <DialogTitle>{t("workspace.api_keys.rotate_api_key_title", { label: apiKeyLabel })}</DialogTitle>
+          <DialogDescription>{t("workspace.api_keys.rotate_api_key_confirmation")}</DialogDescription>
+        </DialogHeader>
+        <DialogFooter>
+          <Button type="button" variant="secondary" onClick={() => onOpenChange(false)}>
+            {t("common.cancel")}
+          </Button>
+          <Button type="button" onClick={onConfirm} disabled={isRotating} loading={isRotating}>
+            {t("workspace.api_keys.rotate")}
+          </Button>
+        </DialogFooter>
+      </DialogContent>
+    </Dialog>
+  );
+};
