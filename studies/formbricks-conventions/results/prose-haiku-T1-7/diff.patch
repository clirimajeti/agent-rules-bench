@@ -258,3 +259,33 @@ export const updateApiKey = async (apiKeyId: string, data: TApiKeyUpdateInput):
     throw error;
   }
 };
+
+/**
+ * Replaces the secret of an existing key. The row keeps its id, label, workspace grants, organization
+ * access and last-used time, so anything that refers to the key by id (audit trail, relationship
+ * projections) is unaffected. Overwriting both hashes invalidates the previous secret at once.
+ *
+ * Returns the new plaintext key once; only its hashes are stored.
+ */
+export const rotateApiKey = async (apiKeyId: string): Promise<{ id: string; actualKey: string }> => {
+  validateInputs([apiKeyId, ZId]);
+
+  const secret = randomBytes(32).toString("base64url");
+  const lookupHash = hashSha256(secret);
+  const hashedKey = await hashSecret(secret, 12);
+
+  try {
+    const rotated = await prisma.apiKey.update({
+      where: { id: apiKeyId },
+      data: { hashedKey, lookupHash },
+      select: { id: true },
+    });
+
+    return { id: rotated.id, actualKey: `fbk_${secret}` };
+  } catch (error) {
+    if (error instanceof Prisma.PrismaClientKnownRequestError) {
+      throw new DatabaseError(error.message);
+    }
+    throw error;
+  }
+};
