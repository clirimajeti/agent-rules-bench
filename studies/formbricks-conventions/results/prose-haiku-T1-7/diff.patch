+/**
+ * POST /api/v3/api-keys/{apiKeyId}/rotate - replace a key's secret, keeping its label and access.
+ *
+ * Session-only and deliberately undocumented in the public v3 contract: it serves the organization
+ * settings page, and an API key must not be able to mint a replacement for itself.
+ */
+import { z } from "zod";
+import { ZId } from "@formbricks/types/common";
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { rotateV3ApiKey } from "../../lib/operations";
+
+const ZRotateApiKeyParams = z.strictObject({
+  apiKeyId: ZId,
+});
+
+export const POST = withV3ApiWrapper({
+  auth: "session",
+  action: "updated",
+  targetType: "apiKey",
+  schemas: { params: ZRotateApiKeyParams },
+  handler: async ({ authentication, parsedInput, auditLog, requestId, instance }) =>
+    rotateV3ApiKey({
+      authentication,
+      apiKeyId: parsedInput.params.apiKeyId,
+      auditLog,
+      requestId,
+      instance,
+    }),
+});
diff --git a/apps/web/app/api/v3/api-keys/lib/operations.ts b/apps/web/app/api/v3/api-keys/lib/operations.ts
