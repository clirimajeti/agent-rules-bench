index 000000000..06693cbd0
--- /dev/null
+++ b/apps/web/app/api/v3/api-keys/lib/operations.ts
@@ -0,0 +1,44 @@
+import { assertCan } from "@/lib/authorization";
+import { getOrganizationIdFromApiKeyId } from "@/lib/utils/helper";
+import { rotateApiKey } from "@/modules/organization/settings/api-keys/lib/api-key";
+import { problemForbidden, successResponse } from "../../lib/response";
+import type { TV3AuditLog, TV3Authentication } from "../../lib/types";
+
+/**
+ * Replaces an API key's secret. Session-only (the route refuses API keys), so a key cannot rotate
+ * itself. The authorization question is the same one the organization settings action asks:
+ * `apiKey.manage` on the key. The response carries the new secret once; the audit entry records the
+ * key and its organization, never the secret.
+ */
+export const rotateV3ApiKey = async ({
+  authentication,
+  apiKeyId,
+  auditLog,
+  requestId,
+  instance,
+}: {
+  authentication: TV3Authentication;
+  apiKeyId: string;
+  auditLog?: TV3AuditLog;
+  requestId: string;
+  instance: string;
+}): Promise<Response> => {
+  if (!authentication || !("user" in authentication)) {
+    return problemForbidden(requestId, "A signed-in user session is required to rotate an API key", instance);
+  }
+
+  const organizationId = await getOrganizationIdFromApiKeyId(apiKeyId);
+  await assertCan({ type: "user", id: authentication.user.id }, "apiKey.manage", {
+    type: "apiKey",
+    id: apiKeyId,
+  });
+
+  if (auditLog) {
+    auditLog.organizationId = organizationId;
+    auditLog.targetId = apiKeyId;
+  }
+
+  const rotated = await rotateApiKey(apiKeyId);
+
+  return successResponse(rotated, { requestId });
+};
