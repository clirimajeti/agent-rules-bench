+export async function bulkDeleteUnusedTags(params: { workspaceId: string }): Promise<{ count: number }> {
+  const query = new URLSearchParams({ workspaceId: params.workspaceId });
+  return request<{ count: number }>(`${BASE_PATH}/bulk-delete-unused?${query.toString()}`, {
+    method: "POST",
+    headers: { "Content-Type": "application/json" },
+  });
+}
