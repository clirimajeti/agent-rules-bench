+import "server-only";
+import { prisma } from "@formbricks/database";
+import { requireV3WorkspaceAccess } from "@/app/api/v3/lib/auth";
+import { problemForbidden, successResponse } from "@/app/api/v3/lib/response";
+import type { TV3Authentication } from "@/app/api/v3/lib/types";
+import { deleteTag } from "@/modules/workspaces/settings/lib/tag";
+
+/**
+ * Find all tags in the workspace that have zero `responses` rows, delete them,
+ * and return the count of deleted tags.
+ */
+export const deleteUnusedTags = async (params: {
+  authentication: TV3Authentication;
+  workspaceId: string;
+  requestId: string;
+  instance?: string;
+}): Promise<Response> => {
+  const { authentication, workspaceId, requestId, instance } = params;
+
+  const access = await requireV3WorkspaceAccess(
+    authentication,
+    workspaceId,
+    "readWrite",
+    requestId,
+    instance
+  );
+  if (access instanceof Response) return access;
+
+  // Find tags with zero responses. The Tag model has a `responses` relation
+  // pointing to the TagsOnResponses join table.
+  const unusedTagIds = await prisma.tag.findMany({
+    where: {
+      workspaceId: access.workspaceId,
+      responses: {
+        none: {},
+      },
+    },
+    select: { id: true },
+  });
+
+  // Delete them sequentially. Each delete is a simple Prisma call.
+  let count = 0;
+  for (const tag of unusedTagIds) {
+    const result = await deleteTag(tag.id);
+    if (result.ok) {
+      count++;
+    }
+  }
+
+  return successResponse({ count }, { requestId });
+};
