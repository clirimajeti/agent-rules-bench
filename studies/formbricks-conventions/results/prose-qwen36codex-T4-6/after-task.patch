+/**
+ * POST /api/v3/tags/bulk-delete-unused — delete all tags that are not used on any response.
+ *
+ * Session-only, matching the other tag mutation endpoints.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { deleteUnusedTags } from "./lib/operations";
+
+export const POST = withV3ApiWrapper({
+  auth: "session",
+  handler: async ({ authentication, parsedInput, requestId, instance }) =>
+    deleteUnusedTags({
+      authentication,
+      workspaceId: parsedInput.query.workspaceId,
+      requestId,
+      instance,
+    }),
+});
