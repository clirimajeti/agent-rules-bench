@@ -0,0 +1,75 @@
+post:
+  operationId: rotateApiKeyV3
+  # Session-only by design: an API key cannot rotate keys, so an API-key caller reading the published
+  # reference would only ever get a 401. Excluded from the generated docs pages like the session-only tag
+  # operations (ENG-2533); the operation stays in the bundle for the contract tests.
+  x-excluded: true
+  summary: Rotate an API key
+  description: |
+    Replaces the key's secret with a new one and returns the new secret in `key`. This is the only
+    time the secret is returned; only its hashes are stored. The old secret stops working at once.
+
+    The key keeps its id, label, organization access and workspace permissions. `lastUsedAt` is reset
+    to `null`, because it describes the secret and the new secret has not been used.
+
+    Requires organization owner or manager. A key with organization `accessControl.write` can only be
+    rotated by a member who may grant that access. An unknown `apiKeyId` answers `403`, not `404`, so key
+    ids cannot be probed for existence.
+  tags:
+    - V3 API Keys
+  parameters:
+    - in: path
+      name: apiKeyId
+      required: true
+      schema:
+        type: string
+        format: cuid2
+  responses:
+    "200":
+      description: API key rotated successfully
+      content:
+        application/json:
+          schema:
+            type: object
+            required:
+              - data
+            properties:
+              data:
+                type: object
+                additionalProperties: false
+                required:
+                  - id
+                  - label
+                  - createdAt
+                  - lastUsedAt
+                  - key
+                properties:
+                  id:
+                    type: string
+                    format: cuid2
+                  label:
+                    type: string
+                  createdAt:
+                    type: string
+                    format: date-time
+                  lastUsedAt:
+                    type:
+                      - string
+                      - "null"
+                    format: date-time
+                    description: Always `null` after a rotation.
+                  key:
+                    type: string
+                    description: The new secret, in the `fbk_` format. Returned only once.
+    "400":
+      $ref: ../components/responses/V3BadRequest.yml
+    "401":
+      $ref: ../components/responses/V3UnauthorizedSession.yml
+    "403":
+      $ref: ../components/responses/V3Forbidden.yml
+    "429":
+      $ref: ../components/responses/V3TooManyRequests.yml
+    "500":
+      $ref: ../components/responses/V3InternalServerError.yml
+  security:
+    - sessionAuth: []
