+/**
+ * Replace a key's secret in place. The row keeps its id, so its label, organization access, workspace
+ * permissions and authorization relationships (keyed by id) carry over untouched, and nothing needs
+ * reconciling. The old secret stops working the moment this commits: both of its hashes are overwritten,
+ * and a legacy key loses its legacy hash the same way, moving it to the v2 `fbk_` format.
+ *
+ * `lastUsedAt` is cleared because it describes the secret, not the row: the new secret has not been used.
+ */
+export const rotateApiKey = async (
+  apiKeyId: string
+): Promise<TApiKeyWithEnvironmentPermission & { actualKey: string }> => {
+  validateInputs([apiKeyId, ZId]);
+
+  try {
+    const { secret, lookupHash, hashedKey } = await generateApiKeySecret();
+
+    const rotated = await prisma.apiKey.update({
+      where: { id: apiKeyId },
+      data: { hashedKey, lookupHash, lastUsedAt: null },
+      select: {
+        id: true,
+        label: true,
+        createdAt: true,
+        lastUsedAt: true,
+        organizationAccess: true,
+        apiKeyWorkspaces: {
+          select: {
+            permission: true,
+            workspaceId: true,
+          },
+        },
+      },
+    });
+
+    return { ...rotated, actualKey: `fbk_${secret}` };
+  } catch (error) {
+    if (error instanceof Prisma.PrismaClientKnownRequestError) {
+      if (error.code === "P2025") {
+        throw new ResourceNotFoundError("apiKey", apiKeyId);
+      }
+      throw new DatabaseError(error.message);
+    }
+    throw error;
+  }
+};
