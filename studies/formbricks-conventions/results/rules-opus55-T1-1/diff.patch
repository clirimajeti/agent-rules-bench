new file mode 100644
index 000000000..686a55550
--- /dev/null
+++ b/apps/web/app/api/v3/api-keys/serializers.ts
@@ -0,0 +1,25 @@
+import type { TApiKeyWithEnvironmentPermission } from "@/modules/organization/settings/api-keys/types/api-keys";
+
+/**
+ * The answer to a rotation. `key` is the new plaintext secret: the only time the server ever returns it,
+ * since only its hashes are stored. Permissions are left out on purpose, because rotation cannot change
+ * them and the caller already holds them.
+ */
+export type TV3RotatedApiKey = {
+  id: string;
+  label: string;
+  createdAt: string;
+  lastUsedAt: string | null;
+  key: string;
+};
+
+export const serializeV3RotatedApiKey = (
+  apiKey: Pick<TApiKeyWithEnvironmentPermission, "id" | "label" | "createdAt" | "lastUsedAt">,
+  key: string
+): TV3RotatedApiKey => ({
+  id: apiKey.id,
+  label: apiKey.label,
+  createdAt: apiKey.createdAt.toISOString(),
+  lastUsedAt: apiKey.lastUsedAt?.toISOString() ?? null,
+  key,
+});
