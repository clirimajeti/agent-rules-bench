+/**
+ * POST /api/v3/api-keys/{apiKeyId}/rotate — replace the key's secret, keeping its label and access, and
+ * return the new secret once. Session-only: a key cannot rotate keys.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { rotateV3ApiKey } from "../../lib/operations";
+import { ZV3ApiKeyIdParams } from "../../lib/schemas";
+
+export const POST = withV3ApiWrapper({
+  auth: "session",
+  action: "rotated",
+  targetType: "apiKey",
+  schemas: { params: ZV3ApiKeyIdParams },
+  handler: async ({ authentication, parsedInput, auditLog, requestId, instance }) =>
+    rotateV3ApiKey({
+      authentication,
+      apiKeyId: parsedInput.params.apiKeyId,
+      auditLog,
+      requestId,
+      instance,
+    }),
+});
diff --git a/apps/web/app/api/v3/api-keys/lib/operations.test.ts b/apps/web/app/api/v3/api-keys/lib/operations.test.ts
