+"use client";
+
+import { useMutation } from "@tanstack/react-query";
+import { rotateApiKey } from "../lib/api-client";
+
+/**
+ * Rotate an API key. The list is server-rendered rather than a query, so there is nothing to invalidate:
+ * the caller merges the result into its rows, which is also the only way the new secret can be shown,
+ * since no read ever returns it.
+ */
+export const useRotateApiKey = () =>
+  useMutation({
+    mutationFn: (variables: { apiKeyId: string }) => rotateApiKey(variables),
+  });
