@@ -0,0 +1,125 @@
+import { beforeEach, describe, expect, test, vi } from "vitest";
+import { ResourceNotFoundError } from "@formbricks/types/errors";
+import type { TV3AuditLog, TV3Authentication } from "@/app/api/v3/lib/types";
+import { can } from "@/lib/authorization";
+import { getApiKeyMetadata, rotateApiKey } from "@/modules/organization/settings/api-keys/lib/api-key";
+import { canGrantOrganizationWriteAccess } from "@/modules/organization/settings/api-keys/lib/organization-access";
+import { rotateV3ApiKey } from "./operations";
+
+vi.mock("server-only", () => ({}));
+
+vi.mock("@/lib/authorization", () => ({ can: vi.fn() }));
+vi.mock("@/lib/posthog", () => ({ capturePostHogEvent: vi.fn() }));
+vi.mock("@/modules/organization/settings/api-keys/lib/api-key", () => ({
+  getApiKeyMetadata: vi.fn(),
+  rotateApiKey: vi.fn(),
+}));
+vi.mock("@/modules/organization/settings/api-keys/lib/organization-access", () => ({
+  canGrantOrganizationWriteAccess: vi.fn(),
+}));
+
+const apiKeyId = "clkk1234567890123456789012";
+const organizationId = "clzz1234567890123456789012";
+const userId = "cluu1234567890123456789012";
+
+const session = { user: { id: userId } } as unknown as TV3Authentication;
+const base = { authentication: session, apiKeyId, requestId: "req_1", instance: "/api/v3/api-keys" };
+
+const metadata = (write = false) => ({
+  id: apiKeyId,
+  label: "CI",
+  organizationId,
+  organizationAccess: { accessControl: { read: true, write } },
+});
+
+const rotated = {
+  id: apiKeyId,
+  label: "CI",
+  createdAt: new Date("2026-04-21T10:00:00.000Z"),
+  lastUsedAt: null,
+  organizationAccess: { accessControl: { read: true, write: false } },
+  apiKeyWorkspaces: [],
+  actualKey: "fbk_newSecret",
+};
+
+beforeEach(() => {
+  vi.resetAllMocks();
+});
+
+describe("rotateV3ApiKey", () => {
+  test("returns the new secret once and keeps it out of the audit log", async () => {
+    vi.mocked(getApiKeyMetadata).mockResolvedValue(metadata());
+    vi.mocked(can).mockResolvedValue(true);
+    vi.mocked(rotateApiKey).mockResolvedValue(rotated);
+    const auditLog = {} as TV3AuditLog;
+
+    const response = await rotateV3ApiKey({ ...base, auditLog });
+    const body = await response.json();
+
+    expect(response.status).toBe(200);
+    expect(body.data).toEqual({
+      id: apiKeyId,
+      label: "CI",
+      createdAt: "2026-04-21T10:00:00.000Z",
+      lastUsedAt: null,
+      key: "fbk_newSecret",
+    });
+    expect(can).toHaveBeenCalledWith({ type: "user", id: userId }, "apiKey.manage", {
+      type: "apiKey",
+      id: apiKeyId,
+    });
+    expect(auditLog.organizationId).toBe(organizationId);
+    expect(JSON.stringify(auditLog)).not.toContain("fbk_newSecret");
+  });
+
+  test("answers 401 to an API key caller", async () => {
+    const response = await rotateV3ApiKey({
+      ...base,
+      authentication: { apiKeyId: "other" } as unknown as TV3Authentication,
+    });
+
+    expect(response.status).toBe(401);
+    expect(rotateApiKey).not.toHaveBeenCalled();
+  });
+
+  test("answers 403 for an unknown key, so ids cannot be probed", async () => {
+    vi.mocked(getApiKeyMetadata).mockResolvedValue(null);
+
+    const response = await rotateV3ApiKey(base);
+
+    expect(response.status).toBe(403);
+    expect(rotateApiKey).not.toHaveBeenCalled();
+  });
+
+  test("answers 403 when the caller may not manage the key", async () => {
+    vi.mocked(getApiKeyMetadata).mockResolvedValue(metadata());
+    vi.mocked(can).mockResolvedValue(false);
+
+    const response = await rotateV3ApiKey(base);
+
+    expect(response.status).toBe(403);
+    expect(rotateApiKey).not.toHaveBeenCalled();
+  });
+
+  test("refuses to rotate a key with organization write access below the user-management floor (ENG-3075)", async () => {
+    vi.mocked(getApiKeyMetadata).mockResolvedValue(metadata(true));
+    vi.mocked(can).mockResolvedValue(true);
+    vi.mocked(canGrantOrganizationWriteAccess).mockResolvedValue(false);
+
+    const response = await rotateV3ApiKey(base);
+
+    expect(response.status).toBe(403);
+    expect(canGrantOrganizationWriteAccess).toHaveBeenCalledWith(userId, organizationId);
+    expect(rotateApiKey).not.toHaveBeenCalled();
+  });
+
+  test("answers 403 when the key is deleted between the read and the rotation", async () => {
+    vi.mocked(getApiKeyMetadata).mockResolvedValue(metadata());
+    vi.mocked(can).mockResolvedValue(true);
+    vi.mocked(rotateApiKey).mockRejectedValue(new ResourceNotFoundError("apiKey", apiKeyId));
+
+    const response = await rotateV3ApiKey(base);
+
+    expect(response.status).toBe(403);
+  });
+});
diff --git a/apps/web/app/api/v3/api-keys/lib/operations.ts b/apps/web/app/api/v3/api-keys/lib/operations.ts
new file mode 100644
index 000000000..c9002561a
--- /dev/null
+++ b/apps/web/app/api/v3/api-keys/lib/operations.ts
@@ -0,0 +1,88 @@
+import "server-only";
+import { ResourceNotFoundError } from "@formbricks/types/errors";
+import { getV3SessionUserId } from "@/app/api/v3/lib/auth";
+import { problemForbidden, problemUnauthorized, successResponse } from "@/app/api/v3/lib/response";
+import type { TV3AuditLog, TV3Authentication } from "@/app/api/v3/lib/types";
+import { can } from "@/lib/authorization";
+import { capturePostHogEvent } from "@/lib/posthog";
+import { getApiKeyMetadata, rotateApiKey } from "@/modules/organization/settings/api-keys/lib/api-key";
+import { canGrantOrganizationWriteAccess } from "@/modules/organization/settings/api-keys/lib/organization-access";
+import { serializeV3RotatedApiKey } from "../serializers";
+
+type TRotateParams = {
+  authentication: TV3Authentication;
+  apiKeyId: string;
+  auditLog?: TV3AuditLog;
+  requestId: string;
+  instance?: string;
+};
+
+/**
+ * Replace an API key's secret, keeping its label and access, and return the new secret once.
+ *
+ * Authorized like delete and rename (`apiKey.manage`, organization owners and managers), plus one rule
+ * from create: a key carrying organization `accessControl.write` can only be rotated by someone who may
+ * grant that access (ENG-3075). Rotation hands the caller a working secret, so it is a mint in all but
+ * name, and the floor create applies has to hold here too.
+ *
+ * An unknown key answers 403, not 404, so key ids cannot be probed for existence.
+ */
+export async function rotateV3ApiKey(params: TRotateParams): Promise<Response> {
+  const { authentication, apiKeyId, auditLog, requestId, instance } = params;
+
+  const userId = getV3SessionUserId(authentication);
+  if (!userId) {
+    return problemUnauthorized(requestId, "Session required", instance);
+  }
+
+  const apiKey = await getApiKeyMetadata(apiKeyId);
+  if (!apiKey) {
+    return problemForbidden(requestId, "You are not authorized to access this resource", instance);
+  }
+
+  const canManage = await can({ type: "user", id: userId }, "apiKey.manage", {
+    type: "apiKey",
+    id: apiKeyId,
+  });
+  if (!canManage) {
+    return problemForbidden(requestId, "You are not authorized to access this resource", instance);
+  }
+
+  if (auditLog) {
+    auditLog.organizationId = apiKey.organizationId;
+    auditLog.targetId = apiKeyId;
+    // Metadata only: the audit trail must never hold a secret or a hash of one.
+    auditLog.oldObject = { id: apiKey.id, label: apiKey.label };
+  }
+
+  if (
+    apiKey.organizationAccess?.accessControl?.write === true &&
+    !(await canGrantOrganizationWriteAccess(userId, apiKey.organizationId))
+  ) {
+    return problemForbidden(requestId, "User management is not allowed for your role", instance);
+  }
+
+  let rotated: Awaited<ReturnType<typeof rotateApiKey>>;
+  try {
+    rotated = await rotateApiKey(apiKeyId);
+  } catch (error) {
+    // Deleted between the read above and the write: the same answer an unknown id gets.
+    if (error instanceof ResourceNotFoundError) {
+      return problemForbidden(requestId, "You are not authorized to access this resource", instance);
+    }
+    throw error;
+  }
+
+  if (auditLog) {
+    auditLog.newObject = { id: rotated.id, label: rotated.label };
+  }
+
+  capturePostHogEvent(
+    userId,
+    "api_key_rotated",
+    { api_key_id: apiKeyId },
+    { organizationId: apiKey.organizationId }
+  );
+
+  return successResponse(serializeV3RotatedApiKey(rotated, rotated.actualKey), { requestId });
+}
