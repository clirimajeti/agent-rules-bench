+/**
+ * A fresh secret with both of its stored hashes. Shared by create and rotate so a rotated key is
+ * indistinguishable from a newly created one.
+ *
+ * Hybrid approach for security + performance: the SHA-256 `lookupHash` finds the row through its unique
+ * index, and the bcrypt `hashedKey` is what the secret is verified against.
+ */
+const generateApiKeySecret = async (): Promise<{ secret: string; lookupHash: string; hashedKey: string }> => {
+  // A secure random secret (32 bytes base64url)
+  const secret = randomBytes(32).toString("base64url");
+  const lookupHash = hashSha256(secret);
+  const hashedKey = await hashSecret(secret, 12);
+  return { secret, lookupHash, hashedKey };
+};
