+export async function deleteUnusedTagsV3(
+  params: TBaseParams & { workspaceId: string; auditLog?: TV3AuditLog }
+): Promise<Response> {
+  const { workspaceId, authentication, requestId, instance } = params;
+
+  const access = await requireV3WorkspaceAccess(authentication, workspaceId, "readWrite", requestId, instance);
+  if (access instanceof Response) return access;
+
+  // Find tags that are not used on any response the caller can see.
+  // `getTagsOnResponsesCount` returns only tags that have at least one visible response link.
+  // Tags not in that map have never been applied (or only applied to responses the caller cannot read).
+  const counts = await getVisibleTagCounts(
+    params.authentication,
+    access.workspaceId,
+    access.organizationId
+  );
+  const usedTagIds = new Set(counts.map((entry) => entry.tagId));
+
+  const allTags = await getTagsByWorkspaceId(access.workspaceId);
+  const unusedTagIds = allTags.filter((tag) => !usedTagIds.has(tag.id)).map((tag) => tag.id);
+
+  if (unusedTagIds.length === 0) {
+    return successResponse({ deletedCount: 0 }, { requestId });
+  }
+
+  // Delete the unused tags in a transaction. Prisma cascades the tagsOnResponses rows.
+  const result = await prisma.$transaction(
+    unusedTagIds.map((tagId) => prisma.tag.delete({ where: { id: tagId } }))
+  );
+
+  if (params.auditLog) {
+    params.auditLog.organizationId = access.organizationId;
+    params.auditLog.targetId = unusedTagIds.join(",");
+    params.auditLog.oldObject = result;
+  }
+
+  return successResponse({ deletedCount: result.length }, { requestId });
+}
