+/**
+ * POST /api/v3/api-keys/{apiKeyId}/rotate — rotate an API key.
+ *
+ * Generates a new secret, updates the stored hashes, and returns the new plaintext key
+ * (which the caller must show once). Thin adapter over the service layer.
+ */
+import { ZId } from "@formbricks/types/common";
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { getOrganizationIdFromApiKeyId } from "@/lib/utils/helper";
+import { assertCan } from "@/lib/authorization";
+import { rotateApiKey } from "@/modules/organization/settings/api-keys/lib/api-key";
+import { TApiKeyWithEnvironmentPermission } from "@/modules/organization/settings/api-keys/types/api-keys";
+import { successResponse } from "@/app/api/v3/lib/response";
+
+export const POST = withV3ApiWrapper({
+  auth: "both",
+  action: "updated",
+  targetType: "apiKey",
+  schemas: { params: ZId },
+  handler: async ({ parsedInput, authentication, auditLog, requestId }) => {
+    const apiKeyId = parsedInput.params.id;
+
+    const organizationId = await getOrganizationIdFromApiKeyId(apiKeyId);
+    await assertCan({ type: "user", id: authentication.userId! }, "apiKey.manage", {
+      type: "apiKey",
+      id: apiKeyId,
+    });
+
+    const result = await rotateApiKey(apiKeyId, authentication.userId!);
+
+    // Carry the organization into the audit log so the event is attributable to the org.
+    auditLog.organizationId = organizationId;
+    auditLog.objectId = apiKeyId;
+    auditLog.newObject = { id: result.id };
+
+    return successResponse(result as TApiKeyWithEnvironmentPermission & { actualKey: string }, {
+      requestId,
+    });
+  },
+});
