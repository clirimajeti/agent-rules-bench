@@ -34,6 +34,7 @@ export const getApiKeysWithEnvironmentPermissions = reactCache(
           id: true,
           label: true,
           createdAt: true,
+          lastUsedAt: true,
           organizationAccess: true,
           apiKeyWorkspaces: {
             select: {
@@ -258,3 +259,43 @@ export const updateApiKey = async (apiKeyId: string, data: TApiKeyUpdateInput):
     throw error;
   }
 };
+
+export const rotateApiKey = async (apiKeyId: string, userId: string): Promise<TApiKeyWithEnvironmentPermission & { actualKey: string }> => {
+  validateInputs([apiKeyId, ZId]);
+  try {
+    // Generate a new secure random secret (32 bytes base64url)
+    const secret = randomBytes(32).toString("base64url");
+
+    // Hybrid approach for security + performance:
+    // 1. SHA-256 lookup hash
+    const lookupHash = hashSha256(secret);
+
+    // 2. bcrypt hash
+    const hashedKey = await hashSecret(secret, 12);
+
+    // Update the API key with the new secret
+    const result = await prisma.apiKey.update({
+      where: { id: apiKeyId },
+      data: {
+        hashedKey,
+        lookupHash,
+        createdBy: userId,
+      },
+      include: {
+        apiKeyWorkspaces: true,
+      },
+    });
+
+    await runPostCommitProjection("api_key_rotate_relationship_reconciliation", () =>
+      reconcileApiKeyRelationships({ apiKeyIds: [result.id] })
+    );
+
+    // Return the new v2 format: fbk_{secret}
+    return { ...result, actualKey: `fbk_${secret}` };
+  } catch (error) {
+    if (error instanceof Prisma.PrismaClientKnownRequestError) {
+      throw new DatabaseError(error.message);
+    }
+    throw error;
+  }
+};
