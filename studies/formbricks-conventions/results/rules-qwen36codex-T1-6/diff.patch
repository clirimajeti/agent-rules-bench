@@ -0,0 +1,30 @@
+/**
+ * Client-side API functions for the API keys v3 routes.
+ *
+ * These are the network calls that TanStack Query hooks in this module use.
+ * Every function throws a parsed `V3ApiError` on a non-2xx response.
+ */
+import { parseV3ApiError } from "@/modules/api/lib/v3-client";
+import type { TApiKeyWithEnvironmentPermission } from "../types/api-keys";
+
+const JSON_HEADERS = { "Content-Type": "application/json" };
+
+/** Timeout for mutations so a stalled request does not leave spinners stuck indefinitely. */
+const MUTATION_TIMEOUT_MS = 15_000;
+
+export type TRotateApiKeyResponse = TApiKeyWithEnvironmentPermission & { actualKey: string };
+
+export async function rotateApiKey(apiKeyId: string): Promise<TRotateApiKeyResponse> {
+  const response = await fetch(`/api/v3/api-keys/${apiKeyId}/rotate`, {
+    method: "POST",
+    cache: "no-store",
+    signal: AbortSignal.timeout(MUTATION_TIMEOUT_MS),
+  });
+
+  if (!response.ok) {
+    throw await parseV3ApiError(response);
+  }
+
+  const body = (await response.json()) as { data: TRotateApiKeyResponse };
+  return body.data;
+}
