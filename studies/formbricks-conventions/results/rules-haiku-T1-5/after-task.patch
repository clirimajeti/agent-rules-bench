+/**
+ * Replaces a key's secret in place. The row keeps its id, label, organization access and workspace
+ * grants, so integrations only need the new value. The old secret stops authenticating as soon as the
+ * hashes are written, because both lookup paths read only these two columns.
+ */
+export const rotateApiKey = async (apiKeyId: string): Promise<{ id: string; actualKey: string }> => {
+  validateInputs([apiKeyId, ZId]);
+
+  // Same secret format and hashing as createApiKey, so the rotated key is a standard v2 key.
+  const secret = randomBytes(32).toString("base64url");
+  const lookupHash = hashSha256(secret);
+  const hashedKey = await hashSecret(secret, 12);
+
+  try {
+    const rotatedApiKey = await prisma.apiKey.update({
+      where: { id: apiKeyId },
+      data: { hashedKey, lookupHash },
+      select: { id: true },
+    });
+
+    return { id: rotatedApiKey.id, actualKey: `fbk_${secret}` };
+  } catch (error) {
+    if (error instanceof Prisma.PrismaClientKnownRequestError) {
+      throw new DatabaseError(error.message);
+    }
+    throw error;
+  }
+};
