@@ -0,0 +1,24 @@
+/**
+ * POST /api/v3/webhooks/{webhookId}/duplicate — copy a webhook with a new signing secret.
+ *
+ * Session-only, like /api/v3/tags: the webhook settings page is the only caller. The workspace is
+ * resolved from the webhook, never from the request.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { duplicateV3Webhook } from "../../lib/operations";
+import { ZV3WebhookIdParams } from "../../lib/schemas";
+
+export const POST = withV3ApiWrapper({
+  auth: "session",
+  action: "created",
+  targetType: "webhook",
+  schemas: { params: ZV3WebhookIdParams },
+  handler: async ({ authentication, parsedInput, auditLog, requestId, instance }) =>
+    duplicateV3Webhook({
+      authentication,
+      webhookId: parsedInput.params.webhookId,
+      auditLog,
+      requestId,
+      instance,
+    }),
+});
diff --git a/apps/web/app/api/v3/webhooks/lib/operations.ts b/apps/web/app/api/v3/webhooks/lib/operations.ts
new file mode 100644
index 000000000..957c3fa3b
--- /dev/null
+++ b/apps/web/app/api/v3/webhooks/lib/operations.ts
@@ -0,0 +1,83 @@
+import "server-only";
+import { prisma } from "@formbricks/database";
+import { InvalidInputError, OperationNotAllowedError } from "@formbricks/types/errors";
+import { requireV3WorkspaceAccess } from "@/app/api/v3/lib/auth";
+import {
+  problemForbidden,
+  problemInternalError,
+  problemUnprocessableContent,
+  successResponse,
+} from "@/app/api/v3/lib/response";
+import type { TV3AuditLog, TV3Authentication } from "@/app/api/v3/lib/types";
+import { assertNewlyAttachedSurveysWorkspaceVisible } from "@/lib/survey/visibility/outbound";
+import { createWebhook } from "@/modules/integrations/webhooks/lib/webhook";
+import { serializeV3Webhook } from "../serializers";
+
+type TBaseParams = {
+  authentication: TV3Authentication;
+  requestId: string;
+  instance?: string;
+};
+
+const COPY_PREFIX = "Copy of";
+
+/**
+ * Creates a webhook with the source's URL, triggers and surveys, named "Copy of <name>". The copy gets its
+ * own signing secret from `createWebhook`; the source's secret is never read.
+ *
+ * The workspace is resolved from the source webhook, never from the request. An unknown webhook answers
+ * 403, not 404, so a signed-in user cannot probe webhook ids across the instance.
+ */
+export async function duplicateV3Webhook(
+  params: TBaseParams & { webhookId: string; auditLog?: TV3AuditLog }
+): Promise<Response> {
+  const { webhookId, auditLog, authentication, requestId, instance } = params;
+
+  const source = await prisma.webhook.findUnique({ where: { id: webhookId }, omit: { secret: true } });
+  if (!source) {
+    return problemForbidden(requestId, "You are not authorized to access this resource", instance);
+  }
+
+  const access = await requireV3WorkspaceAccess(
+    authentication,
+    source.workspaceId,
+    "readWrite",
+    requestId,
+    instance
+  );
+  if (access instanceof Response) return access;
+
+  if (auditLog) {
+    auditLog.organizationId = access.organizationId;
+    auditLog.targetId = webhookId;
+    auditLog.oldObject = source;
+  }
+
+  try {
+    await assertNewlyAttachedSurveysWorkspaceVisible(source.surveyIds);
+
+    const copy = await createWebhook(source.workspaceId, {
+      name: source.name ? `${COPY_PREFIX} ${source.name}` : null,
+      url: source.url,
+      source: source.source,
+      triggers: source.triggers,
+      surveyIds: source.surveyIds,
+    });
+
+    const resource = serializeV3Webhook(copy);
+    if (auditLog) {
+      auditLog.targetId = copy.id;
+      auditLog.newObject = resource;
+    }
+
+    return successResponse(resource, { requestId });
+  } catch (error) {
+    if (error instanceof OperationNotAllowedError) {
+      return problemForbidden(requestId, error.message, instance);
+    }
+    if (error instanceof InvalidInputError) {
+      return problemUnprocessableContent(requestId, error.message, { instance });
+    }
+    return problemInternalError(requestId, "Unable to duplicate webhook", instance);
+  }
+}
