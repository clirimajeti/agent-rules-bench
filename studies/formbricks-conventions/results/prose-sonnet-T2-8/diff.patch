@@ -0,0 +1,19 @@
+"use client";
+
+import { useMutation } from "@tanstack/react-query";
+import { useRouter } from "next/navigation";
+import { duplicateWebhook } from "@/modules/integrations/webhooks/lib/v3-webhooks-client";
+
+/**
+ * The webhook list is rendered by the server page, so the copy shows up once the route is refreshed.
+ */
+export const useDuplicateWebhook = () => {
+  const router = useRouter();
+
+  return useMutation({
+    mutationFn: (webhookId: string) => duplicateWebhook(webhookId),
+    onSuccess: () => {
+      router.refresh();
+    },
+  });
+};
diff --git a/apps/web/modules/integrations/webhooks/lib/v3-webhooks-client.ts b/apps/web/modules/integrations/webhooks/lib/v3-webhooks-client.ts
