index 000000000..3cf8f30be
--- /dev/null
+++ b/docs/api-v3-reference/src/paths/api_v3_webhooks_{webhookId}_duplicate.yml
@@ -0,0 +1,49 @@
+post:
+  operationId: duplicateWebhookV3
+  # Session-only by design (the webhook settings page is the only caller), so an API-key caller reading the
+  # published reference would only ever get a 401. Excluded from the generated docs pages like the tag
+  # paths; the operation stays in the bundle for the contract tests.
+  x-excluded: true
+  summary: Duplicate a webhook
+  description: |
+    Creates a webhook in the same workspace with the source webhook's URL, triggers, surveys and source.
+    The copy is named `Copy of ` plus the original name, and receives its own newly generated signing
+    secret. The secret is never returned; the source webhook is unchanged.
+
+    Same authorization as editing a webhook. An unknown webhook answers `403`.
+  tags:
+    - V3 Webhooks
+  parameters:
+    - in: path
+      name: webhookId
+      required: true
+      schema:
+        type: string
+        format: cuid2
+      description: The webhook to copy.
+  responses:
+    "200":
+      description: Webhook duplicated successfully
+      content:
+        application/json:
+          schema:
+            type: object
+            required:
+              - data
+            properties:
+              data:
+                $ref: ../components/schemas/WebhookResource.yml
+    "400":
+      $ref: ../components/responses/V3BadRequest.yml
+    "401":
+      $ref: ../components/responses/V3UnauthorizedSession.yml
+    "403":
+      $ref: ../components/responses/V3Forbidden.yml
