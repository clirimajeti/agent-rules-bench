--- /dev/null
+++ b/apps/web/modules/integrations/webhooks/lib/v3-webhooks-client.ts
@@ -0,0 +1,18 @@
+import { parseV3ApiError } from "@/modules/api/lib/v3-client";
+
+type TV3DuplicateWebhookResponse = {
+  data: { id: string; name: string | null };
+};
+
+export async function duplicateWebhook(webhookId: string): Promise<TV3DuplicateWebhookResponse["data"]> {
+  const response = await fetch(`/api/v3/webhooks/${webhookId}/duplicate`, {
+    method: "POST",
+    cache: "no-store",
+  });
+
+  if (!response.ok) {
+    throw await parseV3ApiError(response);
+  }
+
+  return ((await response.json()) as TV3DuplicateWebhookResponse).data;
+}
