+/**
+ * Deletes every tag of the workspace that no response carries. The "unused" test runs inside the delete
+ * itself, so a tag applied between a read and the delete is never removed, and the whole workspace is one
+ * query instead of one per tag. It deliberately ignores survey visibility: a tag used only on a response
+ * the caller cannot see is still in use.
+ */
+export const deleteUnusedTags = async (
+  workspaceId: string
+): Promise<Result<{ count: number }, { code: TagError; message: string }>> => {
+  validateInputs([workspaceId, ZId]);
+
+  try {
+    const { count } = await prisma.tag.deleteMany({
+      where: { workspaceId, responses: { none: {} } },
+    });
+
+    return ok({ count });
+  } catch (error) {
+    return err({
+      code: TagError.UNEXPECTED_ERROR,
+      message: error instanceof Error ? error.message : "Unknown error occurred",
+    });
+  }
+};
