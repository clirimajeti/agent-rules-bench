@@ -0,0 +1,50 @@
+"use client";
+
+import { useState } from "react";
+import { useTranslation } from "react-i18next";
+import { TUser } from "@formbricks/types/user";
+import { Button } from "@/modules/ui/components/button";
+import { downloadMyDataAction } from "../actions/download-my-data";
+
+interface DownloadMyDataProps {
+  user: TUser;
+}
+
+export const DownloadMyData = ({ user }: DownloadMyDataProps) => {
+  const { t } = useTranslation();
+  const [isDownloading, setIsDownloading] = useState(false);
+
+  const handleDownload = async () => {
+    setIsDownloading(true);
+    try {
+      const result = await downloadMyDataAction({ userId: user.id });
+      if (result?.data) {
+        const jsonString = JSON.stringify(result.data, null, 2);
+        const blob = new Blob([jsonString], { type: "application/json" });
+        const url = URL.createObjectURL(blob);
+        const link = document.createElement("a");
+        link.href = url;
+        link.download = "formbricks-data.json";
+        document.body.appendChild(link);
+        link.click();
+        document.body.removeChild(link);
+        URL.revokeObjectURL(url);
+      }
+    } catch {
+      // Error is handled by the action client; nothing to do here.
+    } finally {
+      setIsDownloading(false);
+    }
+  };
+
+  return (
+    <Button
+      variant="secondary"
+      size="sm"
+      onClick={handleDownload}
+      loading={isDownloading}
+      disabled={isDownloading}>
+      {t("workspace.settings.profile.download_my_data")}
+    </Button>
+  );
+};
