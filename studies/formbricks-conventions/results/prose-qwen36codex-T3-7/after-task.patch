@@ -0,0 +1,53 @@
+"use server";
+
+import { prisma } from "@formbricks/database";
+import { z } from "zod";
+import { ZId } from "@formbricks/types/common";
+import { validateInputs } from "@/lib/utils/validate";
+import { authenticatedActionClient } from "@/lib/utils/action-client";
+
+export const ZDownloadMyDataInput = z.object({
+  userId: ZId,
+});
+
+export type TDownloadMyDataInput = z.infer<typeof ZDownloadMyDataInput>;
+
+export const downloadMyDataAction = authenticatedActionClient
+  .inputSchema(ZDownloadMyDataInput)
+  .action(async ({ ctx, parsedInput }) => {
+    validateInputs([parsedInput.userId, ZId]);
+
+    // Fetch user's memberships with organization names and roles
+    const memberships = await prisma.membership.findMany({
+      where: {
+        userId: parsedInput.userId,
+        accepted: true,
+      },
+      select: {
+        organization: {
+          select: {
+            id: true,
+            name: true,
+          },
+        },
+        role: true,
+      },
+      orderBy: {
+        organization: {
+          name: "asc",
+        },
+      },
+    });
+
+    return {
+      name: ctx.user.name,
+      email: ctx.user.email,
+      locale: ctx.user.locale,
+      notificationSettings: ctx.user.notificationSettings,
+      organizations: memberships.map((m) => ({
+        organizationId: m.organization.id,
+        organizationName: m.organization.name,
+        role: m.role,
+      })),
+    };
+  });
