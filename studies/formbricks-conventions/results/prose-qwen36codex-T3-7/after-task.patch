+"use client";
+
+import { useTranslation } from "react-i18next";
+import { TUser } from "@formbricks/types/user";
+
+interface AccountActivityProps {
+  user: TUser;
+}
+
+export const AccountActivity = ({ user }: AccountActivityProps) => {
+  const { t } = useTranslation();
+
+  const formatDate = (date: Date | null): string => {
+    if (!date) return t("workspace.settings.profile.no_login_yet");
+    return new Intl.DateTimeFormat(undefined, {
+      year: "numeric",
+      month: "long",
+      day: "numeric",
+      hour: "2-digit",
+      minute: "2-digit",
+    }).format(new Date(date));
+  };
+
+  return (
+    <div className="grid grid-cols-1 gap-4 sm:grid-cols-2">
+      <div>
+        <p className="text-sm font-medium text-slate-600">{t("workspace.settings.profile.account_created")}</p>
+        <p className="mt-1 text-sm text-slate-900">{formatDate(user.createdAt)}</p>
+      </div>
+      <div>
+        <p className="text-sm font-medium text-slate-600">{t("workspace.settings.profile.last_login")}</p>
+        <p className="mt-1 text-sm text-slate-900">{formatDate(user.lastLoginAt)}</p>
+      </div>
+    </div>
+  );
+};
diff --git a/apps/web/app/(app)/workspaces/[workspaceId]/settings/account/profile/components/DownloadMyData.tsx b/apps/web/app/(app)/workspaces/[workspaceId]/settings/account/profile/components/DownloadMyData.tsx
