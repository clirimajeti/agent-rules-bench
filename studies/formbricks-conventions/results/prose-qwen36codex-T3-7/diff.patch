+/**
+ * POST /api/v3/download-my-data — stream the user's profile data and organization memberships as
+ * a JSON download.
+ *
+ * Replaces the legacy server action (`../settings/account/profile/actions/download-my-data.ts`)
+ * so new backend work follows the `/api/v3` + TanStack Query path.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { ZV3DownloadMyDataQuery } from "./lib/schemas";
+import { downloadMyData } from "./lib/operations";
+
+export const POST = withV3ApiWrapper({
+  auth: "session",
+  query: ZV3DownloadMyDataQuery,
+  handler: async ({ authentication, parsedInput, requestId }) =>
+    downloadMyData({
+      userId: parsedInput.query.userId,
+      authentication,
+      requestId,
+    }),
+});
