@@ -0,0 +1,69 @@
+import { NextResponse } from "next/server";
+import { prisma } from "@formbricks/database";
+import type { Session, TAuthenticationApiKey } from "@formbricks/types/auth";
+import type { TV3HandlerParams } from "@/app/api/v3/lib/api-wrapper";
+
+export type TDownloadMyDataResult = {
+  name: string | null;
+  email: string;
+  locale: string | null;
+  notificationSettings: unknown;
+  organizations: Array<{
+    organizationId: string;
+    organizationName: string;
+    role: string;
+  }>;
+};
+
+export async function downloadMyData({
+  userId,
+  authentication,
+  requestId,
+}: {
+  userId: string;
+  authentication: Session | TAuthenticationApiKey;
+  requestId: string;
+}): Promise<Response> {
+  if (!authentication || "type" in authentication) {
+    return NextResponse.json(
+      { status: 401, detail: "Session required" },
+      { status: 401, headers: { "X-Request-Id": requestId } }
+    );
+  }
+
+  // Fetch user's memberships with organization names and roles
+  const memberships = await prisma.membership.findMany({
+    where: {
+      userId,
+      accepted: true,
+    },
+    select: {
+      organization: {
+        select: {
+          id: true,
+          name: true,
+        },
+      },
+      role: true,
+    },
+    orderBy: {
+      organization: {
+        name: "asc",
+      },
+    },
+  });
+
+  const body: TDownloadMyDataResult = {
+    name: authentication.user.name,
+    email: authentication.user.email,
+    locale: authentication.user.locale,
+    notificationSettings: authentication.user.notificationSettings,
+    organizations: memberships.map((m) => ({
+      organizationId: m.organization.id,
+      organizationName: m.organization.name,
+      role: m.role,
+    })),
+  };
+
+  return NextResponse.json(body, { headers: { "X-Request-Id": requestId } });
+}
