@@ -0,0 +1,53 @@
+"use client";
+
+import { useState } from "react";
+import { useTranslation } from "react-i18next";
+import { TUser } from "@formbricks/types/user";
+import { Button } from "@/modules/ui/components/button";
+import { parseV3ApiError } from "@/modules/api/lib/v3-client";
+
+interface DownloadMyDataProps {
+  user: TUser;
+}
+
+export const DownloadMyData = ({ user }: Readonly<DownloadMyDataProps>) => {
+  const { t } = useTranslation();
+  const [isDownloading, setIsDownloading] = useState(false);
+
+  const handleDownload = async () => {
+    setIsDownloading(true);
+    try {
+      const response = await fetch(`/api/v3/download-my-data?userId=${encodeURIComponent(user.id)}`, {
+        method: "POST",
+        cache: "no-store",
+      });
+      if (!response.ok) throw await parseV3ApiError(response);
+      const data = await response.json();
+      const jsonString = JSON.stringify(data, null, 2);
+      const blob = new Blob([jsonString], { type: "application/json" });
+      const url = URL.createObjectURL(blob);
+      const link = document.createElement("a");
+      link.href = url;
+      link.download = "formbricks-data.json";
+      document.body.appendChild(link);
+      link.click();
+      document.body.removeChild(link);
+      URL.revokeObjectURL(url);
+    } catch {
+      // Error is handled by the action client; nothing to do here.
+    } finally {
+      setIsDownloading(false);
+    }
+  };
+
+  return (
+    <Button
+      variant="secondary"
+      size="sm"
+      onClick={handleDownload}
+      loading={isDownloading}
+      disabled={isDownloading}>
+      {t("workspace.settings.profile.download_my_data")}
+    </Button>
+  );
+};
diff --git a/apps/web/app/api/v3/download-my-data/lib/operations.ts b/apps/web/app/api/v3/download-my-data/lib/operations.ts
