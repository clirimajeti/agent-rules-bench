+"use client";
+
+import { useMutation } from "@tanstack/react-query";
+import { rotateApiKey } from "../lib/api-client";
+
+/**
+ * Rotates one key's secret. The rotated key is not refetched: the caller patches its own row with the
+ * returned secret, because the list is server-rendered and the secret is only shown once.
+ */
+export const useRotateApiKey = () =>
+  useMutation({
+    mutationFn: (apiKeyId: string) => rotateApiKey({ apiKeyId }),
+  });
diff --git a/apps/web/modules/organization/settings/api-keys/lib/api-client.ts b/apps/web/modules/organization/settings/api-keys/lib/api-client.ts
new file mode 100644
