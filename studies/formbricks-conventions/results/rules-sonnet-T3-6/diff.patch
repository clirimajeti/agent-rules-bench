+/**
+ * GET /api/v3/account/data-export - the signed-in user's own account data (name, email, locale,
+ * notification settings, organization memberships).
+ *
+ * Session-only, deliberately: an export of one person's data is for that person, so accepting
+ * `x-api-key` here would widen the surface rather than serve a need.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { exportV3AccountData } from "../lib/operations";
+
+export const GET = withV3ApiWrapper({
+  auth: "session",
+  handler: async ({ authentication, requestId, instance }) =>
+    exportV3AccountData({ authentication, requestId, instance }),
+});
