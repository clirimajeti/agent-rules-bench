+get:
+  operationId: exportAccountDataV3
+  # Session-only by design, like the tag operations: an export of a person's own data is for that person.
+  x-excluded: true
+  summary: Export my account data
+  description: |
+    Returns the signed-in user's name, email, locale, notification settings and organization memberships
+    (organization name and role). Pending invitations are not included.
+
+    Session cookie only. The Formbricks app uses this for "Download my data" on the profile page, so it
+    does not accept `x-api-key`.
+  tags:
+    - V3 Account
+  responses:
+    "200":
+      description: Account data retrieved successfully
+      headers:
+        X-Request-Id:
+          schema:
+            type: string
+          description: Request correlation ID
+        Cache-Control:
+          schema:
+            type: string
+          example: private, no-store
+      content:
+        application/json:
+          schema:
+            type: object
+            required:
+              - data
+            properties:
+              data:
+                $ref: ../components/schemas/AccountDataExport.yml
+    "401":
+      $ref: ../components/responses/V3UnauthorizedSession.yml
+    "429":
+      $ref: ../components/responses/V3TooManyRequests.yml
+    "500":
+      $ref: ../components/responses/V3InternalServerError.yml
+  security:
+    - sessionAuth: []
