+import { beforeEach, describe, expect, test, vi } from "vitest";
+import { prisma } from "@formbricks/database";
+import { exportV3AccountData } from "./operations";
+
+vi.mock("server-only", () => ({}));
+vi.mock("@formbricks/database", () => ({ prisma: { user: { findUnique: vi.fn() } } }));
+
+const base = { requestId: "req_1", instance: "/api/v3/account/data-export" };
+
+describe("exportV3AccountData", () => {
+  beforeEach(() => vi.clearAllMocks());
+
+  test("answers 401 without a session user", async () => {
+    const response = await exportV3AccountData({ ...base, authentication: null });
+    expect(response.status).toBe(401);
+    expect(prisma.user.findUnique).not.toHaveBeenCalled();
+  });
+
+  test("returns only the signed-in user's own data, memberships as organization name and role", async () => {
+    vi.mocked(prisma.user.findUnique).mockResolvedValue({
+      name: "Ada",
+      email: "ada@example.com",
+      locale: "en-US",
+      notificationSettings: { alert: { weeklySummary: true } },
+      memberships: [{ role: "owner", organization: { name: "Acme" } }],
+    } as never);
+
+    const response = await exportV3AccountData({
+      ...base,
+      authentication: { user: { id: "user_1" }, expires: "" },
+    });
+
+    expect(prisma.user.findUnique).toHaveBeenCalledWith(expect.objectContaining({ where: { id: "user_1" } }));
+    expect(await response.json()).toEqual({
+      data: {
+        name: "Ada",
+        email: "ada@example.com",
+        locale: "en-US",
+        notificationSettings: { alert: { weeklySummary: true } },
+        organizationMemberships: [{ organizationName: "Acme", role: "owner" }],
+      },
+    });
+  });
+});
