@@ -0,0 +1,44 @@
+import "server-only";
+import { prisma } from "@formbricks/database";
+import { getV3SessionUserId } from "@/app/api/v3/lib/auth";
+import { problemUnauthorized, successResponse } from "@/app/api/v3/lib/response";
+import type { TV3Authentication } from "@/app/api/v3/lib/types";
+import { serializeV3AccountDataExport } from "./serializers";
+
+type TBaseParams = {
+  authentication: TV3Authentication;
+  requestId: string;
+  instance?: string;
+};
+
+/**
+ * Only the signed-in user's own row is read, keyed by the session's user id, so there is no caller-supplied
+ * id to forge. Pending invitations (`accepted: false`) are not memberships yet and stay out. Ordered so the
+ * file is stable between downloads.
+ */
+export async function exportV3AccountData({
+  authentication,
+  requestId,
+  instance,
+}: TBaseParams): Promise<Response> {
+  const userId = getV3SessionUserId(authentication);
+  if (!userId) return problemUnauthorized(requestId, undefined, instance);
+
+  const user = await prisma.user.findUnique({
+    where: { id: userId },
+    select: {
+      name: true,
+      email: true,
+      locale: true,
+      notificationSettings: true,
+      memberships: {
+        where: { accepted: true },
+        orderBy: { organization: { name: "asc" } },
+        select: { role: true, organization: { select: { name: true } } },
+      },
+    },
+  });
+  if (!user) return problemUnauthorized(requestId, undefined, instance);
+
+  return successResponse(serializeV3AccountDataExport(user), { requestId });
+}
