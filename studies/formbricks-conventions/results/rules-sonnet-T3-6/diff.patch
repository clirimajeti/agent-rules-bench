index 000000000..171ae7921
--- /dev/null
+++ b/apps/web/app/(app)/workspaces/[workspaceId]/settings/account/profile/lib/download-account-data.ts
@@ -0,0 +1,25 @@
+import { parseV3ApiError } from "@/modules/api/lib/v3-client";
+
+const ACCOUNT_DATA_FILE_NAME = "formbricks-account-data.json";
+
+/** Fetch the signed-in user's account data and hand it to the browser as a JSON file download. */
+export async function downloadAccountData(): Promise<void> {
+  const response = await fetch("/api/v3/account/data-export", {
+    cache: "no-store",
+    signal: AbortSignal.timeout(15_000),
+  });
+  if (!response.ok) throw await parseV3ApiError(response);
+
+  const { data } = (await response.json()) as { data: unknown };
+  const url = URL.createObjectURL(new Blob([JSON.stringify(data, null, 2)], { type: "application/json" }));
+  try {
+    const link = document.createElement("a");
+    link.href = url;
+    link.download = ACCOUNT_DATA_FILE_NAME;
+    document.body.appendChild(link);
+    link.click();
+    link.remove();
+  } finally {
+    URL.revokeObjectURL(url);
+  }
+}
