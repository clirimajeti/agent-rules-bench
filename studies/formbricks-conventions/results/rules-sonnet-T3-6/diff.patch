+"use client";
+
+import { QueryClient, QueryClientProvider, useMutation } from "@tanstack/react-query";
+import { useState } from "react";
+import toast from "react-hot-toast";
+import { useTranslation } from "react-i18next";
+import { downloadAccountData } from "@/app/(app)/workspaces/[workspaceId]/settings/account/profile/lib/download-account-data";
+import { V3ApiError } from "@/modules/api/lib/v3-client";
+import { Button } from "@/modules/ui/components/button";
+
+const DownloadMyDataButtonContent = () => {
+  const { t } = useTranslation();
+  const download = useMutation({ mutationFn: downloadAccountData });
+
+  const onClick = () =>
+    download.mutate(undefined, {
+      onError: (error) =>
+        toast.error(
+          error instanceof V3ApiError && error.code === "too_many_requests"
+            ? t("common.error_rate_limit_description")
+            : t("workspace.settings.profile.download_my_data_failed")
+        ),
+    });
+
+  return (
+    <Button type="button" variant="secondary" size="sm" loading={download.isPending} onClick={onClick}>
+      {t("workspace.settings.profile.download_my_data")}
+    </Button>
+  );
+};
+
+/**
+ * There is no app-wide `QueryClientProvider`, and the profile page has no other query consumer, so the
+ * button mounts its own rather than adding a provider to the whole route.
+ */
+export const DownloadMyDataButton = () => {
+  const [queryClient] = useState(() => new QueryClient());
+
+  return (
+    <QueryClientProvider client={queryClient}>
+      <DownloadMyDataButtonContent />
+    </QueryClientProvider>
+  );
+};
diff --git a/apps/web/app/(app)/workspaces/[workspaceId]/settings/account/profile/lib/download-account-data.ts b/apps/web/app/(app)/workspaces/[workspaceId]/settings/account/profile/lib/download-account-data.ts
