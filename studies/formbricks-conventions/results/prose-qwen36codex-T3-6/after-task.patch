diff --git a/apps/web/lib/membership/service.ts b/apps/web/lib/membership/service.ts
index ef1310838..5a7823c7b 100644
--- a/apps/web/lib/membership/service.ts
+++ b/apps/web/lib/membership/service.ts
@@ -126,3 +126,47 @@ export const createMembership = async (
 
   return membership;
 };
+
+/**
+ * Returns every organization the user belongs to, with the role they hold in each.
+ */
+export const getOrganizationMembershipsByUserId = reactCache(
+  async (userId: string): Promise<
+    { organizationId: string; organizationName: string; role: TMembership["role"] }[]
+  > => {
+    validateInputs([userId, ZString]);
+
+    try {
+      const organizationIds = await lookupAuthorizedOrganizationIds({ type: "user", id: userId });
+      if (organizationIds.length === 0) return [];
+
+      const memberships = await prisma.membership.findMany({
+        where: {
+          userId,
+          organizationId: { in: [...organizationIds] },
+        },
+        select: {
+          organizationId: true,
+          organization: {
+            select: {
+              name: true,
+            },
+          },
+          role: true,
+        },
+      });
+
+      return memberships.map((m) => ({
+        organizationId: m.organizationId,
+        organizationName: m.organization.name,
+        role: m.role,
+      }));
+    } catch (error) {
+      if (error instanceof Prisma.PrismaClientKnownRequestError) {
+        logger.error(error, "Error getting organization memberships by user id");
+        throw new DatabaseError(error.message);
+      }
+      throw error;
+    }
+  }
+);
