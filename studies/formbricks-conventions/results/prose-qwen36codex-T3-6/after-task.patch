@@ -0,0 +1,76 @@
+"use client";
+
+import { useCallback } from "react";
+import { useTranslation } from "react-i18next";
+import { TOrganizationRole } from "@formbricks/types/memberships";
+import { Button } from "@/modules/ui/components/button";
+
+interface OrganizationMembership {
+  organizationId: string;
+  name: string;
+  role: TOrganizationRole;
+}
+
+interface DownloadMyDataProps {
+  userName: string;
+  userEmail: string;
+  userLocale: string;
+  notificationSettings: Record<string, unknown>;
+  organizationMemberships: OrganizationMembership[];
+}
+
+const formatNotificationSettings = (
+  settings: Record<string, unknown>
+): { alert: Record<string, boolean>; unsubscribedOrganizationIds: string[] | null } => {
+  const alert =
+    typeof settings?.alert === "object" && settings.alert !== null
+      ? (settings.alert as Record<string, boolean>)
+      : {};
+  const unsubscribedOrganizationIds =
+    Array.isArray(settings?.unsubscribedOrganizationIds)
+      ? (settings.unsubscribedOrganizationIds as string[])
+      : null;
+
+  return { alert, unsubscribedOrganizationIds };
+};
+
+export const DownloadMyData = ({
+  userName,
+  userEmail,
+  userLocale,
+  notificationSettings,
+  organizationMemberships,
+}: DownloadMyDataProps) => {
+  const { t } = useTranslation();
+
+  const handleDownload = useCallback(() => {
+    const data = {
+      name: userName,
+      email: userEmail,
+      locale: userLocale,
+      notificationSettings: formatNotificationSettings(notificationSettings),
+      organizationMemberships: organizationMemberships.map(({ organizationId, name, role }) => ({
+        organizationId,
+        organizationName: name,
+        role,
+      })),
+    };
+
+    const json = JSON.stringify(data, null, 2);
+    const blob = new Blob([json], { type: "application/json" });
+    const url = URL.createObjectURL(blob);
+    const link = document.createElement("a");
+    link.href = url;
+    link.download = "formbricks-account-data.json";
+    document.body.appendChild(link);
+    link.click();
+    document.body.removeChild(link);
+    URL.revokeObjectURL(url);
+  }, [userName, userEmail, userLocale, notificationSettings, organizationMemberships]);
+
+  return (
+    <Button variant="secondary" size="sm" onClick={handleDownload}>
+      {t("workspace.settings.profile.download_my_data")}
+    </Button>
+  );
+};
