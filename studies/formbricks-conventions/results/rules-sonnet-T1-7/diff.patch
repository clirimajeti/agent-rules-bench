+/** The owning organization and organization access of one key, or `null` when it does not exist. */
+export const getApiKeyOwnership = async (
+  apiKeyId: string
+): Promise<{ organizationId: string; organizationAccess: TOrganizationAccess } | null> => {
+  validateInputs([apiKeyId, ZId]);
+
+  try {
+    const apiKey = await prisma.apiKey.findUnique({
+      where: { id: apiKeyId },
+      select: { organizationId: true, organizationAccess: true },
+    });
+    return apiKey as { organizationId: string; organizationAccess: TOrganizationAccess } | null;
+  } catch (error) {
+    if (error instanceof Prisma.PrismaClientKnownRequestError) {
+      throw new DatabaseError(error.message);
+    }
+    throw error;
+  }
+};
+
+/**
+ * Replace the secret of an existing key. Label, organization access and workspace permissions are left
+ * untouched, and `lastUsedAt` is cleared because the new secret has not been used yet. The old secret stops
+ * working as soon as the update commits, since both lookup columns are overwritten.
+ */
+export const rotateApiKey = async (
+  apiKeyId: string
+): Promise<TApiKeyWithEnvironmentPermission & { actualKey: string }> => {
+  validateInputs([apiKeyId, ZId]);
+
+  try {
+    const secret = randomBytes(32).toString("base64url");
+    const lookupHash = hashSha256(secret);
+    const hashedKey = await hashSecret(secret, 12);
+
+    const result = await prisma.apiKey.update({
+      where: { id: apiKeyId },
+      data: { hashedKey, lookupHash, lastUsedAt: null },
+      select: {
+        id: true,
+        label: true,
+        createdAt: true,
+        lastUsedAt: true,
+        organizationAccess: true,
+        apiKeyWorkspaces: { select: { permission: true, workspaceId: true } },
+      },
+    });
+
+    return { ...result, actualKey: `fbk_${secret}` };
+  } catch (error) {
+    if (error instanceof Prisma.PrismaClientKnownRequestError) {
+      throw new DatabaseError(error.message);
+    }
+    throw error;
+  }
+};
