@@ -0,0 +1,26 @@
+import type { TOrganizationAccess } from "@formbricks/types/api-key";
+import { parseV3ApiError } from "@/modules/api/lib/v3-client";
+import type { TApiKeyWorkspacePermission } from "@/modules/organization/settings/api-keys/types/api-keys";
+
+/** A rotated key as the v3 route serializes it: dates arrive as ISO strings, the secret only here. */
+export type TRotatedApiKey = {
+  id: string;
+  label: string;
+  createdAt: string;
+  lastUsedAt: string | null;
+  organizationAccess: TOrganizationAccess;
+  apiKeyWorkspaces: TApiKeyWorkspacePermission[];
+  actualKey: string;
+};
+
+/** Throws a parsed `V3ApiError` on a non-2xx response, so the caller can surface the server's message. */
+export async function rotateApiKey(params: { apiKeyId: string }): Promise<TRotatedApiKey> {
+  const response = await fetch(`/api/v3/api-keys/${params.apiKeyId}/rotate`, {
+    cache: "no-store",
+    method: "POST",
+  });
+  if (!response.ok) {
+    throw await parseV3ApiError(response);
+  }
+  return ((await response.json()) as { data: TRotatedApiKey }).data;
+}
