index 000000000..2a6dc2ef9
--- /dev/null
+++ b/apps/web/app/api/v3/api-keys/lib/operations.ts
@@ -0,0 +1,62 @@
+import "server-only";
+import { OperationNotAllowedError } from "@formbricks/types/errors";
+import { getV3SessionUserId } from "@/app/api/v3/lib/auth";
+import { problemForbidden, problemUnauthorized, successResponse } from "@/app/api/v3/lib/response";
+import type { TV3AuditLog, TV3Authentication } from "@/app/api/v3/lib/types";
+import { can } from "@/lib/authorization";
+import { getApiKeyOwnership, rotateApiKey } from "@/modules/organization/settings/api-keys/lib/api-key";
+import { assertCanGrantOrganizationAccess } from "@/modules/organization/settings/api-keys/lib/organization-access";
+
+type TRotateParams = {
+  authentication: TV3Authentication;
+  apiKeyId: string;
+  auditLog?: TV3AuditLog;
+  requestId: string;
+  instance?: string;
+};
+
+/**
+ * Replace the secret of an API key and answer with the new plaintext once.
+ *
+ * The organization is resolved from the key, never from the request. An unknown key answers 403, not 404,
+ * so a signed-in user cannot probe key ids across the instance. Session-only: a key must not be able to
+ * mint a replacement for itself or for another key.
+ *
+ * Rotation hands out a fresh secret that carries the key's existing organization access, so it applies the
+ * same user-management floor as creation (ENG-3075): someone below the floor cannot rotate a key that can
+ * manage organization users, because they would walk away holding that authority.
+ */
+export async function rotateV3ApiKey(params: TRotateParams): Promise<Response> {
+  const { authentication, apiKeyId, auditLog, requestId, instance } = params;
+  const forbidden = () =>
+    problemForbidden(requestId, "You are not authorized to access this resource", instance);
+
+  const userId = getV3SessionUserId(authentication);
+  if (!userId) return problemUnauthorized(requestId, "Session required", instance);
+
+  const ownership = await getApiKeyOwnership(apiKeyId);
+  if (!ownership) return forbidden();
+
+  const allowed = await can({ type: "user", id: userId }, "apiKey.manage", { type: "apiKey", id: apiKeyId });
+  if (!allowed) return forbidden();
+
+  try {
+    await assertCanGrantOrganizationAccess(userId, ownership.organizationId, ownership.organizationAccess);
+  } catch (error) {
+    if (error instanceof OperationNotAllowedError) {
+      return problemForbidden(requestId, error.message, instance);
+    }
+    throw error;
+  }
+
+  if (auditLog) {
+    auditLog.organizationId = ownership.organizationId;
+    auditLog.targetId = apiKeyId;
+  }
+
+  // `actualKey` is the secret. It goes in the response only; the audit log gets the metadata alone.
+  const { actualKey, ...rotated } = await rotateApiKey(apiKeyId);
+  if (auditLog) auditLog.newObject = rotated;
+
+  return successResponse({ ...rotated, actualKey }, { requestId });
+}
