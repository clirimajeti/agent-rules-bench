+  description: |
+    Creates a new webhook in the same workspace with the same URL, triggers and surveys as `{webhookId}`.
+    The copy is named "Copy of " followed by the original name, or by the URL when the original has no
+    name.
+
+    The copy gets its own new signing secret; the original's secret is never copied or returned.
+    Its source is `user`, whatever the original's source was.
+
+    Read/write access to the webhook's workspace is required. An unknown or inaccessible `webhookId`
+    answers `403`. A URL that no longer passes webhook URL validation answers `422`, and a survey that is
+    no longer visible to the whole workspace answers `403`.
+  tags:
+    - V3 Webhooks
+  parameters:
+    - in: path
+      name: webhookId
+      required: true
+      schema:
+        type: string
+        format: cuid2
+      description: The webhook to copy.
+  responses:
+    "201":
+      description: Copy created
+      headers:
+        X-Request-Id:
+          schema:
+            type: string
+          description: Request correlation ID
+        Cache-Control:
+          schema:
+            type: string
+          example: private, no-store
+      content:
+        application/json:
+          schema:
+            type: object
+            required:
+              - data
+            properties:
+              data:
+                type: object
+                additionalProperties: false
+                required:
+                  - id
+                  - workspaceId
+                  - name
+                  - url
+                  - source
+                  - triggers
+                  - surveyIds
+                  - createdAt
+                  - updatedAt
+                properties:
+                  id:
+                    type: string
+                    format: cuid2
+                    description: The copy's id.
+                  workspaceId:
+                    type: string
+                    format: cuid2
+                  name:
+                    type: string
+                  url:
+                    type: string
+                  source:
+                    type: string
+                    enum:
+                      - user
+                  triggers:
+                    type: array
+                    items:
+                      type: string
+                      enum:
+                        - responseCreated
+                        - responseUpdated
+                        - responseFinished
+                  surveyIds:
+                    type: array
+                    description: Empty means every current and future survey in the workspace.
+                    items:
+                      type: string
+                      format: cuid2
+                  createdAt:
+                    type: string
+                    format: date-time
+                  updatedAt:
+                    type: string
+                    format: date-time
+    "400":
+      $ref: ../components/responses/V3BadRequest.yml
+    "401":
+      $ref: ../components/responses/V3UnauthorizedSession.yml
+    "403":
+      $ref: ../components/responses/V3Forbidden.yml
+    "422":
+      $ref: ../components/responses/V3UnprocessableContent.yml
+    "429":
+      $ref: ../components/responses/V3TooManyRequests.yml
+    "500":
+      $ref: ../components/responses/V3InternalServerError.yml
+  security:
+    - sessionAuth: []
