+export type TWebhookCopySource = Pick<Webhook, "workspaceId" | "name" | "url" | "triggers" | "surveyIds">;
+
+/** The webhook a duplicate is made from, without its secret, or `null` when it does not exist. */
+export const getWebhookCopySource = async (webhookId: string): Promise<TWebhookCopySource | null> => {
+  validateInputs([webhookId, ZId]);
+
+  try {
+    return await prisma.webhook.findUnique({
+      where: { id: webhookId },
+      select: { workspaceId: true, name: true, url: true, triggers: true, surveyIds: true },
+    });
+  } catch (error) {
+    if (error instanceof Prisma.PrismaClientKnownRequestError) {
+      throw new DatabaseError(error.message);
+    }
+
+    throw error;
+  }
+};
+
+/** A copy's name: "Copy of " and the original's name, or its URL when it has none. */
+export const getWebhookCopyName = (source: Pick<Webhook, "name" | "url">): string =>
+  `Copy of ${source.name?.trim() || source.url}`;
+
+/**
+ * Create a copy of a webhook in the same workspace: same URL, triggers and surveys, a "Copy of" name and a
+ * new signing secret. The source is always `user`, because a person made the copy.
