+/**
+ * POST /api/v3/webhooks/{webhookId}/duplicate — copy a webhook (URL, triggers, surveys) into a new one
+ * named "Copy of <name>", with its own signing secret. Session-only: the webhooks settings page is its
+ * only caller.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { ZV3EmptyQuery } from "@/app/api/v3/lib/schemas";
+import { duplicateV3Webhook } from "../../lib/operations";
+import { ZV3WebhookIdParams } from "../../lib/schemas";
+
+export const POST = withV3ApiWrapper({
+  auth: "session",
+  action: "created",
+  targetType: "webhook",
+  schemas: { params: ZV3WebhookIdParams, query: ZV3EmptyQuery },
+  handler: async ({ authentication, parsedInput, auditLog, requestId, instance }) =>
+    duplicateV3Webhook({
+      authentication,
+      webhookId: parsedInput.params.webhookId,
+      auditLog,
+      requestId,
+      instance,
+    }),
+});
diff --git a/apps/web/app/api/v3/webhooks/lib/operations.ts b/apps/web/app/api/v3/webhooks/lib/operations.ts
new file mode 100644
index 000000000..d3a0e98de
--- /dev/null
+++ b/apps/web/app/api/v3/webhooks/lib/operations.ts
@@ -0,0 +1,100 @@
+import "server-only";
+import { logger } from "@formbricks/logger";
+import { InvalidInputError } from "@formbricks/types/errors";
+import { getV3SessionUserId, requireV3WorkspaceAccess } from "@/app/api/v3/lib/auth";
+import { mapV3ThrownError } from "@/app/api/v3/lib/errors";
+import { problemForbidden, problemUnprocessableContent, successResponse } from "@/app/api/v3/lib/response";
+import type { TV3AuditLog, TV3Authentication } from "@/app/api/v3/lib/types";
+import { capturePostHogEvent } from "@/lib/posthog";
+import {
+  SURVEY_NOT_WORKSPACE_VISIBLE_MESSAGE,
+  findNotWorkspaceVisibleSurveyIds,
+} from "@/lib/survey/visibility/outbound";
+import { duplicateWebhook, getWebhookCopySource } from "@/modules/integrations/webhooks/lib/webhook";
+import { serializeV3Webhook } from "../serializers";
+
+type TDuplicateWebhookParams = {
+  authentication: TV3Authentication;
+  webhookId: string;
+  auditLog?: TV3AuditLog;
+  requestId: string;
+  instance: string;
+};
+
+/**
+ * Copy a webhook into a new one in the same workspace, with its own signing secret.
+ *
+ * The workspace comes from the webhook itself, never from the caller, so a caller cannot pair someone
+ * else's webhook id with a workspace they can write to. An unknown webhook answers 403, not 404, so the
+ * route cannot be used to probe which webhook ids exist. The permission is the one the webhook server
+ * actions require: `readWrite` on the workspace.
+ */
+export async function duplicateV3Webhook(params: TDuplicateWebhookParams): Promise<Response> {
+  const { authentication, webhookId, auditLog, requestId, instance } = params;
+  const log = logger.withContext({ requestId, webhookId });
+
+  try {
+    const source = await getWebhookCopySource(webhookId);
+    if (!source) {
+      return problemForbidden(requestId, "You are not authorized to access this resource", instance);
+    }
+
+    const access = await requireV3WorkspaceAccess(
+      authentication,
+      source.workspaceId,
+      "readWrite",
+      requestId,
+      instance
+    );
+    if (access instanceof Response) return access;
+
+    // The copy attaches its surveys to a new outbound connection, so every one of them must be visible to
+    // the whole workspace now, the same rule `createWebhookAction` applies (ENG-3283).
+    const blockedSurveyIds = await findNotWorkspaceVisibleSurveyIds(source.surveyIds);
+    if (blockedSurveyIds.length > 0) {
+      return problemForbidden(requestId, SURVEY_NOT_WORKSPACE_VISIBLE_MESSAGE, instance);
+    }
+
+    if (auditLog) auditLog.organizationId = access.organizationId;
+
+    let copy: Awaited<ReturnType<typeof duplicateWebhook>>;
+    try {
+      copy = await duplicateWebhook(source);
+    } catch (error) {
+      // The URL is validated again on create. It passed when the original was saved, but the rules (for
+      // example internal URLs) can have changed since, which is not a server fault.
+      if (error instanceof InvalidInputError) {
+        return problemUnprocessableContent(requestId, error.message, {
+          instance,
+          invalid_params: [{ name: "url", reason: error.message }],
+        });
+      }
+      throw error;
+    }
+
+    const resource = serializeV3Webhook(copy);
+    if (auditLog) {
+      auditLog.targetId = copy.id;
+      auditLog.newObject = resource;
+    }
+
+    // A copy connects a new webhook, so it is counted like one added through the form.
+    const userId = getV3SessionUserId(authentication);
+    if (userId) {
+      capturePostHogEvent(
+        userId,
+        "integration_connected",
+        {
+          integration_type: "webhook",
+          organization_id: access.organizationId,
+          workspace_id: access.workspaceId,
+        },
+        { organizationId: access.organizationId, workspaceId: access.workspaceId }
+      );
+    }
+
+    return successResponse(resource, { requestId, status: 201 });
+  } catch (error) {
+    return mapV3ThrownError(error, { log, requestId, instance, operation: "webhooks.duplicate" });
+  }
+}
