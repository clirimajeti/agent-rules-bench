--- /dev/null
+++ b/apps/web/modules/organization/settings/api-keys/lib/rotate-api-key-client.ts
@@ -0,0 +1,28 @@
+import { parseV3ApiError } from "@/modules/api/lib/v3-client";
+import type { TApiKeyWithEnvironmentPermission } from "@/modules/organization/settings/api-keys/types/api-keys";
+
+/** The wire shape of a rotated key: dates arrive as ISO strings, and `actualKey` is the new secret. */
+type TRotatedApiKeyResponse = Omit<TApiKeyWithEnvironmentPermission, "createdAt" | "lastUsedAt"> & {
+  createdAt: string;
+  lastUsedAt: string | null;
+  actualKey: string;
+};
+
+/** Replace an API key's secret, keeping its label and access. The new secret is in the response only. */
+export async function rotateApiKeyRequest(
+  apiKeyId: string
+): Promise<TApiKeyWithEnvironmentPermission & { actualKey: string }> {
+  const response = await fetch(`/api/v3/api-keys/${encodeURIComponent(apiKeyId)}/rotate`, {
+    method: "POST",
+    cache: "no-store",
+    signal: AbortSignal.timeout(15_000),
+  });
+  if (!response.ok) throw await parseV3ApiError(response);
+
+  const { data } = (await response.json()) as { data: TRotatedApiKeyResponse };
+  return {
+    ...data,
+    createdAt: new Date(data.createdAt),
+    lastUsedAt: data.lastUsedAt ? new Date(data.lastUsedAt) : null,
+  };
+}
