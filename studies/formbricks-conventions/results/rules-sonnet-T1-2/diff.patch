@@ -0,0 +1,58 @@
+import "server-only";
+import { ResourceNotFoundError } from "@formbricks/types/errors";
+import { getV3AuthorizationActor } from "@/app/api/v3/lib/auth";
+import { problemForbidden, successResponse } from "@/app/api/v3/lib/response";
+import type { TV3AuditLog, TV3Authentication } from "@/app/api/v3/lib/types";
+import { assertCan } from "@/lib/authorization";
+import { getOrganizationIdFromApiKeyId } from "@/lib/utils/helper";
+import {
+  getApiKeyOrganizationAccess,
+  rotateApiKey,
+} from "@/modules/organization/settings/api-keys/lib/api-key";
+import { assertCanGrantOrganizationAccess } from "@/modules/organization/settings/api-keys/lib/organization-access";
+import { serializeV3RotatedApiKey } from "../serializers";
+
+/**
+ * Replace a key's secret and answer with the new one, once.
+ *
+ * The organization is resolved from the key, never from the request, so the caller cannot choose the scope
+ * it is authorized against. An unknown key answers 403 like an unauthorized one (thrown
+ * `ResourceNotFoundError` is mapped by the wrapper), so key ids cannot be probed.
+ *
+ * Session-only: a key must not be able to mint a replacement for itself or another key.
+ */
+export async function rotateV3ApiKey(params: {
+  authentication: TV3Authentication;
+  apiKeyId: string;
+  auditLog?: TV3AuditLog;
+  requestId: string;
+  instance?: string;
+}): Promise<Response> {
+  const { authentication, apiKeyId, auditLog, requestId, instance } = params;
+
+  const actor = getV3AuthorizationActor(authentication);
+  if (actor?.type !== "user") {
+    return problemForbidden(requestId, undefined, instance);
+  }
+
+  const organizationId = await getOrganizationIdFromApiKeyId(apiKeyId);
+  await assertCan(actor, "apiKey.manage", { type: "apiKey", id: apiKeyId });
+
+  if (auditLog) {
+    auditLog.organizationId = organizationId;
+    auditLog.targetId = apiKeyId;
+  }
+
+  // The rotated key keeps its organization access, so a new secret carrying `accessControl.write` is only
+  // minted for someone who could grant that today (ENG-3075). Checked before the secret is replaced, so a
+  // refusal leaves the old secret working.
+  const organizationAccess = await getApiKeyOrganizationAccess(apiKeyId);
+  if (!organizationAccess) {
+    throw new ResourceNotFoundError("apiKey", apiKeyId);
+  }
+  await assertCanGrantOrganizationAccess(actor.id, organizationId, organizationAccess);
+
+  const rotated = await rotateApiKey(apiKeyId);
+
+  return successResponse(serializeV3RotatedApiKey(rotated), { requestId });
+}
