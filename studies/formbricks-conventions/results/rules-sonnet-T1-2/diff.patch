--- /dev/null
+++ b/docs/api-v3-reference/src/paths/api_v3_api-keys_{apiKeyId}_rotate.yml
@@ -0,0 +1,94 @@
+post:
+  operationId: rotateApiKeyV3
+  # Session-only by design, like the tags operations: an API-key caller would only ever get a 401, so it is
+  # kept out of the generated docs pages and stays in the bundle for the contract tests.
+  x-excluded: true
+  summary: Rotate an API key
+  description: |
+    Replaces the secret of `{apiKeyId}` with a new one. The key keeps its id, label and access settings.
+    The old secret stops working at once, and `lastUsedAt` is cleared.
+
+    The new secret is in `actualKey` and is returned by this response only.
+
+    Same authorization as deleting the key. A key that carries organization write access can only be
+    rotated by someone who may grant that access.
+  tags:
+    - V3 API Keys
+  parameters:
+    - in: path
+      name: apiKeyId
+      required: true
+      schema:
+        type: string
+        format: cuid2
+      description: The API key to rotate.
+  responses:
+    "200":
+      description: API key rotated successfully
+      content:
+        application/json:
+          schema:
+            type: object
+            required:
+              - data
+            properties:
+              data:
+                type: object
+                required:
+                  - id
+                  - label
+                  - createdAt
+                  - lastUsedAt
+                  - organizationAccess
+                  - apiKeyWorkspaces
+                  - actualKey
+                properties:
+                  id:
+                    type: string
+                    format: cuid2
+                  label:
+                    type: string
+                  createdAt:
+                    type: string
+                    format: date-time
+                  lastUsedAt:
+                    type: string
+                    format: date-time
+                    nullable: true
+                    description: Always `null` right after a rotation.
+                  organizationAccess:
+                    type: object
+                    additionalProperties: true
+                    description: The key's organization access, unchanged.
+                  apiKeyWorkspaces:
+                    type: array
+                    description: The key's workspace permissions, unchanged.
+                    items:
+                      type: object
+                      required:
+                        - workspaceId
+                        - permission
+                      properties:
+                        workspaceId:
+                          type: string
+                        permission:
+                          type: string
+                          enum:
+                            - read
+                            - write
+                            - manage
+                  actualKey:
+                    type: string
+                    description: The new secret. Shown once.
+    "400":
+      $ref: ../components/responses/V3BadRequest.yml
+    "401":
+      $ref: ../components/responses/V3UnauthorizedSession.yml
+    "403":
+      $ref: ../components/responses/V3Forbidden.yml
+    "429":
+      $ref: ../components/responses/V3TooManyRequests.yml
+    "500":
+      $ref: ../components/responses/V3InternalServerError.yml
+  security:
+    - sessionAuth: []
