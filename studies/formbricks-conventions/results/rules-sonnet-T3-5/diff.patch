diff --git a/docs/api-v3-reference/src/paths/api_v3_account_data-export.yml b/docs/api-v3-reference/src/paths/api_v3_account_data-export.yml
new file mode 100644
index 000000000..6160a8711
--- /dev/null
+++ b/docs/api-v3-reference/src/paths/api_v3_account_data-export.yml
@@ -0,0 +1,78 @@
+get:
+  operationId: exportAccountDataV3
+  # Session-only by design: it exports the personal data of the signed-in user, so an API key has no
+  # account to export. Excluded from the generated docs pages like the other session-only operations;
+  # the operation stays in the bundle for the contract tests.
+  x-excluded: true
+  summary: Export my account data
+  description: |
+    Returns the signed-in user's own account data: name, email, locale, notification settings and
+    organization memberships (organization name and role).
+
+    Session cookie only. It backs the "Download my data" button on the profile settings page, so it does
+    not accept `x-api-key`.
+  tags:
+    - V3 Account
+  responses:
+    "200":
+      description: Account data retrieved successfully
+      headers:
+        X-Request-Id:
+          schema:
+            type: string
+          description: Request correlation ID
+        Cache-Control:
+          schema:
+            type: string
+          example: private, no-store
+      content:
+        application/json:
+          schema:
+            type: object
+            required:
+              - data
+            properties:
+              data:
+                type: object
+                required:
+                  - name
+                  - email
+                  - locale
+                  - notificationSettings
+                  - organizationMemberships
+                properties:
+                  name:
+                    type: string
+                  email:
+                    type: string
+                  locale:
+                    type: string
+                    example: en-US
+                  notificationSettings:
+                    type: object
+                    additionalProperties: true
+                  organizationMemberships:
+                    type: array
+                    items:
+                      type: object
+                      required:
+                        - organizationName
+                        - role
+                      properties:
+                        organizationName:
+                          type: string
+                        role:
+                          type: string
+                          enum:
+                            - owner
+                            - manager
+                            - member
+                            - billing
+    "401":
+      $ref: ../components/responses/V3UnauthorizedSession.yml
+    "429":
+      $ref: ../components/responses/V3TooManyRequests.yml
+    "500":
+      $ref: ../components/responses/V3InternalServerError.yml
+  security:
+    - sessionAuth: []
