+  return <QueryClientProvider client={queryClient}>{children}</QueryClientProvider>;
+};
diff --git a/apps/web/app/api/v3/account/data-export/lib/operations.ts b/apps/web/app/api/v3/account/data-export/lib/operations.ts
new file mode 100644
index 000000000..8aa2e75b7
--- /dev/null
+++ b/apps/web/app/api/v3/account/data-export/lib/operations.ts
@@ -0,0 +1,70 @@
+import "server-only";
+import { prisma } from "@formbricks/database";
+import { getV3SessionUserId } from "@/app/api/v3/lib/auth";
+import {
+  problemInternalError,
+  problemUnauthorized,
+  successResponse,
+} from "@/app/api/v3/lib/response";
+import type { TV3Authentication } from "@/app/api/v3/lib/types";
+
+export type TV3AccountDataExport = {
+  name: string;
+  email: string;
+  locale: string;
+  notificationSettings: unknown;
+  organizationMemberships: { organizationName: string; role: string }[];
+};
+
+/**
+ * Only the fields the user sees on their own profile. Secrets (password hash, 2FA secret, backup codes) and
+ * identifiers of other tenants are never selected, so they cannot leak through a later serializer change.
+ */
+export async function exportV3AccountData(params: {
+  authentication: TV3Authentication;
+  requestId: string;
+  instance?: string;
+}): Promise<Response> {
+  const { authentication, requestId, instance } = params;
+
+  const userId = getV3SessionUserId(authentication);
+  if (!userId) {
+    return problemUnauthorized(requestId, "Session required", instance);
+  }
+
+  try {
+    const user = await prisma.user.findUnique({
+      where: { id: userId },
+      select: {
+        name: true,
+        email: true,
+        locale: true,
+        notificationSettings: true,
+        memberships: {
+          select: { role: true, organization: { select: { name: true } } },
+          orderBy: { organization: { name: "asc" } },
+        },
+      },
+    });
+
+    if (!user) {
+      // A valid session whose user row is gone (deleted account) is no longer authenticated.
+      return problemUnauthorized(requestId, "Session required", instance);
+    }
+
+    const data: TV3AccountDataExport = {
+      name: user.name,
+      email: user.email,
+      locale: user.locale,
+      notificationSettings: user.notificationSettings,
+      organizationMemberships: user.memberships.map((membership) => ({
+        organizationName: membership.organization.name,
+        role: membership.role,
+      })),
+    };
+
+    return successResponse(data, { requestId });
+  } catch {
+    return problemInternalError(requestId, undefined, instance);
+  }
+}
diff --git a/apps/web/app/api/v3/account/data-export/route.ts b/apps/web/app/api/v3/account/data-export/route.ts
