@@ -0,0 +1,14 @@
+/**
+ * GET /api/v3/account/data-export - the signed-in user's own account data, for the "Download my data" button.
+ *
+ * Session-only, deliberately: it exports the personal data of the user behind the session, so an API key
+ * (which has no user) has nothing to export.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { exportV3AccountData } from "./lib/operations";
+
+export const GET = withV3ApiWrapper({
+  auth: "session",
+  handler: async ({ authentication, requestId, instance }) =>
+    exportV3AccountData({ authentication, requestId, instance }),
+});
