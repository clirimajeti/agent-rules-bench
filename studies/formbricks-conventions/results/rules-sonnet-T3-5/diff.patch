diff --git a/apps/web/modules/account/components/AccountActivity/api-client.ts b/apps/web/modules/account/components/AccountActivity/api-client.ts
new file mode 100644
index 000000000..2f46010a7
--- /dev/null
+++ b/apps/web/modules/account/components/AccountActivity/api-client.ts
@@ -0,0 +1,11 @@
+import type { TV3AccountDataExport } from "@/app/api/v3/account/data-export/lib/operations";
+import { parseV3ApiError } from "@/modules/api/lib/v3-client";
+
+/** Fetch the signed-in user's account data. Throws a parsed `V3ApiError` on a non-2xx response. */
+export async function getAccountDataExport(): Promise<TV3AccountDataExport> {
+  const response = await fetch("/api/v3/account/data-export", { cache: "no-store" });
+  if (!response.ok) {
+    throw await parseV3ApiError(response);
+  }
+  return ((await response.json()) as { data: TV3AccountDataExport }).data;
+}
diff --git a/apps/web/modules/account/components/AccountActivity/index.tsx b/apps/web/modules/account/components/AccountActivity/index.tsx
new file mode 100644
index 000000000..45af59612
--- /dev/null
+++ b/apps/web/modules/account/components/AccountActivity/index.tsx
@@ -0,0 +1,73 @@
+"use client";
+
+import { useMutation } from "@tanstack/react-query";
+import { DownloadIcon } from "lucide-react";
+import { useTranslation } from "react-i18next";
+import toast from "react-hot-toast";
+import { formatDateTimeForDisplay } from "@/lib/utils/datetime";
+import { getV3ApiErrorMessage } from "@/modules/api/lib/v3-client";
+import { Button } from "@/modules/ui/components/button";
+import { getAccountDataExport } from "./api-client";
+
+interface AccountActivityProps {
+  createdAt: Date;
+  lastLoginAt: Date | null;
+  locale: string;
+}
+
+// Pinned to UTC so the server and browser render the same moment; locale only controls the format.
+const formatTimestamp = (date: Date, locale: string): string =>
+  formatDateTimeForDisplay(date, locale, {
+    year: "numeric",
+    month: "long",
+    day: "numeric",
+    hour: "numeric",
+    minute: "2-digit",
+    timeZone: "UTC",
+    timeZoneName: "short",
+  });
+
+const downloadJson = (data: unknown, filename: string) => {
+  const blob = new Blob([JSON.stringify(data, null, 2)], { type: "application/json" });
+  const url = URL.createObjectURL(blob);
+  const link = document.createElement("a");
+  link.href = url;
+  link.download = filename;
+  link.click();
+  URL.revokeObjectURL(url);
+};
+
+export const AccountActivity = ({ createdAt, lastLoginAt, locale }: Readonly<AccountActivityProps>) => {
+  const { t } = useTranslation();
+
+  const downloadMutation = useMutation({
+    mutationFn: getAccountDataExport,
+    onSuccess: (data) => downloadJson(data, "formbricks-account-data.json"),
+    onError: (error) => toast.error(getV3ApiErrorMessage(error, t("workspace.settings.profile.download_my_data_failed"))),
+  });
+
+  return (
+    <div className="space-y-4">
+      <dl className="space-y-2 text-sm">
+        <div className="flex gap-2">
+          <dt className="font-medium text-slate-700">{t("workspace.settings.profile.account_created")}:</dt>
+          <dd className="text-slate-600">{formatTimestamp(createdAt, locale)}</dd>
+        </div>
+        <div className="flex gap-2">
+          <dt className="font-medium text-slate-700">{t("workspace.settings.profile.last_login")}:</dt>
+          <dd className="text-slate-600">
+            {lastLoginAt ? formatTimestamp(lastLoginAt, locale) : t("workspace.settings.profile.never_logged_in")}
+          </dd>
+        </div>
+      </dl>
+      <Button
+        variant="secondary"
+        size="sm"
+        loading={downloadMutation.isPending}
+        onClick={() => downloadMutation.mutate()}>
+        <DownloadIcon className="h-4 w-4" />
+        {t("workspace.settings.profile.download_my_data")}
+      </Button>
+    </div>
+  );
+};
