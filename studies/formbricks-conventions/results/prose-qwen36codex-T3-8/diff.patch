@@ -0,0 +1,60 @@
+"use client";
+
+import { useCallback } from "react";
+import { useTranslation } from "react-i18next";
+import { TUserNotificationSettings } from "@formbricks/types/user";
+import { Button } from "@/modules/ui/components/button";
+
+interface TOrganizationMembership {
+  organizationId: string;
+  name: string;
+  role: string;
+}
+
+interface DownloadMyDataProps {
+  userName: string;
+  userEmail: string;
+  userLocale: string;
+  notificationSettings: TUserNotificationSettings;
+  organizationMemberships: TOrganizationMembership[];
+}
+
+export const DownloadMyData = ({
+  userName,
+  userEmail,
+  userLocale,
+  notificationSettings,
+  organizationMemberships,
+}: Readonly<DownloadMyDataProps>) => {
+  const { t } = useTranslation();
+
+  const handleDownload = useCallback(() => {
+    const data = {
+      name: userName,
+      email: userEmail,
+      locale: userLocale,
+      notificationSettings,
+      organizationMemberships: organizationMemberships.map(({ organizationId, name, role }) => ({
+        organizationId,
+        name,
+        role,
+      })),
+    };
+
+    const blob = new Blob([JSON.stringify(data, null, 2)], { type: "application/json" });
+    const url = URL.createObjectURL(blob);
+    const link = document.createElement("a");
+    link.href = url;
+    link.download = "formbricks-account-data.json";
+    document.body.appendChild(link);
+    link.click();
+    document.body.removeChild(link);
+    URL.revokeObjectURL(url);
+  }, [userName, userEmail, userLocale, notificationSettings, organizationMemberships]);
+
+  return (
+    <Button variant="secondary" size="sm" onClick={handleDownload}>
+      {t("workspace.settings.profile.download_my_data")}
+    </Button>
+  );
+};
