@@ -0,0 +1,34 @@
+"use client";
+
+import { useTranslation } from "react-i18next";
+import { TUser } from "@formbricks/types/user";
+import { formatDateWithOrdinal } from "@/lib/utils/datetime";
+import { Badge } from "@/modules/ui/components/badge";
+import { Small } from "@/modules/ui/components/typography";
+
+interface AccountActivityProps {
+  user: TUser;
+}
+
+export const AccountActivity = ({ user }: Readonly<AccountActivityProps>) => {
+  const { t } = useTranslation();
+
+  const createdDate = formatDateWithOrdinal(user.createdAt, user.locale);
+  const lastLoginDate = user.lastLoginAt ? formatDateWithOrdinal(user.lastLoginAt, user.locale) : null;
+
+  return (
+    <div className="space-y-4">
+      <div className="flex items-center gap-x-3">
+        <Badge size="normal" type="success" text="Active" />
+        <Small color="muted">
+          {t("workspace.settings.profile.account_created_on")}: {createdDate}
+        </Small>
+      </div>
+      {lastLoginDate && (
+        <Small color="muted">
+          {t("workspace.settings.profile.last_login_on")}: {lastLoginDate}
+        </Small>
+      )}
+    </div>
+  );
+};
