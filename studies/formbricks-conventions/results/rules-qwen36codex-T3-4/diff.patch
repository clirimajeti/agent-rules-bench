@@ -0,0 +1,80 @@
+"use client";
+
+import { useState } from "react";
+import { useTranslation } from "react-i18next";
+import { Loader2 } from "lucide-react";
+import { Button } from "@/modules/ui/components/button";
+
+interface OrganizationMembership {
+  organizationId: string;
+  organizationName: string;
+  role: string;
+}
+
+interface DownloadMyDataProps {
+  userName: string;
+  userEmail: string;
+  userLocale: string;
+  notificationSettings: {
+    alert: Record<string, boolean>;
+    unsubscribedOrganizationIds?: string[];
+  };
+  memberships: OrganizationMembership[];
+}
+
+const DownloadMyData = ({
+  userName,
+  userEmail,
+  userLocale,
+  notificationSettings,
+  memberships,
+}: Readonly<DownloadMyDataProps>) => {
+  const { t } = useTranslation();
+  const [isDownloading, setIsDownloading] = useState(false);
+
+  const handleDownload = async () => {
+    setIsDownloading(true);
+    try {
+      const data = {
+        name: userName,
+        email: userEmail,
+        locale: userLocale,
+        notificationSettings,
+        organizationMemberships: memberships.map((m) => ({
+          organizationName: m.organizationName,
+          role: m.role,
+        })),
+      };
+
+      const jsonString = JSON.stringify(data, null, 2);
+      const blob = new Blob([jsonString], { type: "application/json" });
+      const url = URL.createObjectURL(blob);
+      const link = document.createElement("a");
+      link.href = url;
+      link.download = "formbricks-account-data.json";
+      document.body.appendChild(link);
+      link.click();
+      document.body.removeChild(link);
+      URL.revokeObjectURL(url);
+    } catch {
+      // Silently fail — the user can retry.
+    } finally {
+      setIsDownloading(false);
+    }
+  };
+
+  return (
+    <Button variant="outline" size="sm" onClick={handleDownload} disabled={isDownloading}>
+      {isDownloading ? (
+        <>
+          <Loader2 className="animate-spin" />
+          {t("workspace.settings.profile.downloading")}
+        </>
+      ) : (
+        t("workspace.settings.profile.download_my_data")
+      )}
+    </Button>
+  );
+};
+
+export default DownloadMyData;
