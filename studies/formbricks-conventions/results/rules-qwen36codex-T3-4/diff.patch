diff --git a/apps/web/lib/user/service.ts b/apps/web/lib/user/service.ts
index 787b8f160..5320709a4 100644
--- a/apps/web/lib/user/service.ts
+++ b/apps/web/lib/user/service.ts
@@ -194,3 +194,60 @@ export const getUserLocale = reactCache(async (id: string): Promise<TUserLocale
     throw error;
   }
 });
+
+export interface TUserWithOrganizationMemberships {
+  user: TUser;
+  organizationMemberships: Array<{
+    organizationId: string;
+    organizationName: string;
+    role: string;
+  }>;
+}
+
+export const getUserWithOrganizationMemberships = reactCache(
+  async (userId: string): Promise<TUserWithOrganizationMemberships | null> => {
+    validateInputs([userId, ZId]);
+
+    try {
+      const user = await prisma.user.findUnique({
+        where: {
+          id: userId,
+        },
+        select: publicUserSelect,
+      });
+
+      if (!user) {
+        return null;
+      }
+
+      const memberships = await prisma.membership.findMany({
+        where: {
+          userId,
+        },
+        select: {
+          organizationId: true,
+          role: true,
+          organization: {
+            select: {
+              name: true,
+            },
+          },
+        },
+      });
+
+      return {
+        user,
+        organizationMemberships: memberships.map((m) => ({
+          organizationId: m.organizationId,
+          organizationName: m.organization.name,
+          role: m.role,
+        })),
+      };
+    } catch (error) {
+      if (error instanceof Prisma.PrismaClientKnownRequestError) {
+        throw new DatabaseError(error.message);
+      }
+      throw error;
+    }
+  }
+);
