@@ -0,0 +1,63 @@
+"use client";
+
+import { QueryClient, QueryClientProvider, useMutation } from "@tanstack/react-query";
+import { useState } from "react";
+import toast from "react-hot-toast";
+import { useTranslation } from "react-i18next";
+import { parseV3ApiError } from "@/modules/api/lib/v3-client";
+import { Button } from "@/modules/ui/components/button";
+
+const EXPORT_FILE_NAME = "formbricks-account-data.json";
+
+const fetchAccountExport = async (): Promise<unknown> => {
+  const response = await fetch("/api/v3/account/export", { credentials: "same-origin" });
+  if (!response.ok) {
+    throw await parseV3ApiError(response);
+  }
+
+  const body = (await response.json()) as { data: unknown };
+  return body.data;
+};
+
+const saveAsJsonFile = (data: unknown) => {
+  const blob = new Blob([JSON.stringify(data, null, 2)], { type: "application/json" });
+  const url = URL.createObjectURL(blob);
+  const link = document.createElement("a");
+  link.href = url;
+  link.download = EXPORT_FILE_NAME;
+  document.body.appendChild(link);
+  link.click();
+  link.remove();
+  URL.revokeObjectURL(url);
+};
+
+const DownloadMyDataButton = () => {
+  const { t } = useTranslation();
+  const { mutate, isPending } = useMutation({
+    mutationFn: fetchAccountExport,
+    onSuccess: saveAsJsonFile,
+    onError: () => {
+      toast.error(t("workspace.settings.profile.download_my_data_failed"));
+    },
+  });
+
+  return (
+    <Button variant="secondary" onClick={() => mutate()} loading={isPending}>
+      {t("workspace.settings.profile.download_my_data")}
+    </Button>
+  );
+};
+
+/**
+ * There is no app-wide `QueryClientProvider` (see the tags settings layout), and this is the only query
+ * consumer on the profile page, so it mounts its own.
+ */
+export const DownloadMyData = () => {
+  const [queryClient] = useState(() => new QueryClient());
+
+  return (
+    <QueryClientProvider client={queryClient}>
+      <DownloadMyDataButton />
+    </QueryClientProvider>
+  );
+};
