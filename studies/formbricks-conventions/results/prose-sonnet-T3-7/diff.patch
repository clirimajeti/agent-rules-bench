@@ -0,0 +1,15 @@
+/**
+ * GET /api/v3/account/export - the signed-in user's own personal data, for the "Download my data" button
+ * on the profile settings page.
+ *
+ * Session-only, deliberately: the data belongs to the person at the keyboard, so an API key (which is
+ * scoped to an organization, not to a person) has no business reading it.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { exportV3AccountData } from "./lib/operations";
+
+export const GET = withV3ApiWrapper({
+  auth: "session",
+  handler: async ({ authentication, requestId, instance }) =>
+    exportV3AccountData({ authentication, requestId, instance }),
+});
