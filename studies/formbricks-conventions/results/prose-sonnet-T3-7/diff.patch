@@ -0,0 +1,48 @@
+import "server-only";
+import { prisma } from "@formbricks/database";
+import { getV3SessionUserId } from "@/app/api/v3/lib/auth";
+import { problemUnauthorized, successResponse } from "@/app/api/v3/lib/response";
+import type { TV3Authentication } from "@/app/api/v3/lib/types";
+import { serializeV3AccountExport } from "../serializers";
+
+type TParams = {
+  authentication: TV3Authentication;
+  requestId: string;
+  instance?: string;
+};
+
+/**
+ * The user is always the session's own, never a client-supplied id, so there is nothing to forge.
+ * Only memberships the user has accepted are listed: a pending invite is not a membership yet.
+ */
+export async function exportV3AccountData({
+  authentication,
+  requestId,
+  instance,
+}: TParams): Promise<Response> {
+  const userId = getV3SessionUserId(authentication);
+  if (!userId) {
+    return problemUnauthorized(requestId, "Session required", instance);
+  }
+
+  const user = await prisma.user.findUnique({
+    where: { id: userId },
+    select: {
+      name: true,
+      email: true,
+      locale: true,
+      notificationSettings: true,
+      memberships: {
+        where: { accepted: true },
+        select: { role: true, organization: { select: { name: true } } },
+        orderBy: { organization: { name: "asc" } },
+      },
+    },
+  });
+
+  if (!user) {
+    return problemUnauthorized(requestId, "Session required", instance);
+  }
+
+  return successResponse(serializeV3AccountExport(user), { requestId });
+}
