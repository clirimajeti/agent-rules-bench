+get:
+  operationId: exportAccountV3
+  # Session-only by design: the data belongs to the signed-in person, and an API key is scoped to an
+  # organization, so it would only ever get a 401. Kept out of the generated docs pages like the other
+  # session-only operations (ENG-2533); the operation stays in the bundle for the contract tests.
+  x-excluded: true
+  summary: Export my account data
+  description: |
+    Returns the signed-in user's own name, email, locale, notification settings and accepted organization
+    memberships. Backs the "Download my data" button on the profile settings page.
+
+    Session cookie only. It does not accept `x-api-key`.
+  tags:
+    - V3 Account
+  responses:
+    "200":
+      description: Account data retrieved successfully
+      headers:
+        X-Request-Id:
+          schema:
+            type: string
+          description: Request correlation ID
+        Cache-Control:
+          schema:
+            type: string
+          example: private, no-store
+      content:
+        application/json:
+          schema:
+            type: object
+            required:
+              - data
+            properties:
+              data:
+                $ref: ../components/schemas/AccountExport.yml
+    "401":
+      $ref: ../components/responses/V3UnauthorizedSession.yml
+    "429":
+      $ref: ../components/responses/V3TooManyRequests.yml
+    "500":
+      $ref: ../components/responses/V3InternalServerError.yml
+  security:
+    - sessionAuth: []
