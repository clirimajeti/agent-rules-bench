@@ -0,0 +1,33 @@
+import type { TUserNotificationSettings } from "@formbricks/types/user";
+
+export type TV3AccountExportMembership = {
+  organizationName: string;
+  role: string;
+};
+
+export type TV3AccountExport = {
+  name: string;
+  email: string;
+  locale: string;
+  notificationSettings: TUserNotificationSettings;
+  memberships: TV3AccountExportMembership[];
+};
+
+type TAccountExportSource = {
+  name: string;
+  email: string;
+  locale: string;
+  notificationSettings: unknown;
+  memberships: { role: string; organization: { name: string } }[];
+};
+
+export const serializeV3AccountExport = (user: TAccountExportSource): TV3AccountExport => ({
+  name: user.name,
+  email: user.email,
+  locale: user.locale,
+  notificationSettings: user.notificationSettings as TUserNotificationSettings,
+  memberships: user.memberships.map((membership) => ({
+    organizationName: membership.organization.name,
+    role: membership.role,
+  })),
+});
