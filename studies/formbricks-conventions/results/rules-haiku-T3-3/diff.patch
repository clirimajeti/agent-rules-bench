diff --git a/apps/web/modules/account/lib/account-data-export.ts b/apps/web/modules/account/lib/account-data-export.ts
new file mode 100644
index 000000000..c04365342
--- /dev/null
+++ b/apps/web/modules/account/lib/account-data-export.ts
@@ -0,0 +1,72 @@
+import "server-only";
+import { cache as reactCache } from "react";
+import { prisma } from "@formbricks/database";
+import { Prisma } from "@formbricks/database/prisma";
+import { ZId } from "@formbricks/types/common";
+import { DatabaseError } from "@formbricks/types/errors";
+import type { TOrganizationRole } from "@formbricks/types/memberships";
+import type { TUserNotificationSettings } from "@formbricks/types/user";
+import { validateInputs } from "@/lib/utils/validate";
+
+export interface TAccountDataExportMembership {
+  organizationName: string;
+  role: TOrganizationRole;
+}
+
+export interface TAccountDataExport {
+  name: string;
+  email: string;
+  locale: string;
+  notificationSettings: TUserNotificationSettings;
+  organizationMemberships: TAccountDataExportMembership[];
+}
+
+/**
+ * Accepted organization memberships of a user, with the organization name, for the account data export.
+ * Pending invitations are left out: they are not memberships the user holds yet.
+ */
+export const getAccountOrganizationMemberships = reactCache(async (userId: string) => {
+  validateInputs([userId, ZId]);
+
+  try {
+    return await prisma.membership.findMany({
+      where: {
+        userId,
+        accepted: true,
+      },
+      select: {
+        role: true,
+        organization: {
+          select: {
+            name: true,
+          },
+        },
+      },
+      orderBy: {
+        organization: {
+          name: "asc",
+        },
+      },
+    });
+  } catch (error) {
+    if (error instanceof Prisma.PrismaClientKnownRequestError) {
+      throw new DatabaseError(error.message);
+    }
+
+    throw error;
+  }
+});
+
+export const buildAccountDataExport = (
+  user: { name: string; email: string; locale: string; notificationSettings: TUserNotificationSettings },
+  memberships: { role: TOrganizationRole; organization: { name: string } }[]
+): TAccountDataExport => ({
+  name: user.name,
+  email: user.email,
+  locale: user.locale,
+  notificationSettings: user.notificationSettings,
+  organizationMemberships: memberships.map((membership) => ({
+    organizationName: membership.organization.name,
+    role: membership.role,
+  })),
+});
