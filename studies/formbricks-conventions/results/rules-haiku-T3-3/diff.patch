+"use client";
+
+import { DownloadIcon } from "lucide-react";
+import { useTranslation } from "react-i18next";
+import type { TAccountDataExport } from "@/modules/account/lib/account-data-export";
+import { Button } from "@/modules/ui/components/button";
+
+const EXPORT_FILE_NAME = "formbricks-my-data.json";
+
+interface DownloadMyDataButtonProps {
+  data: TAccountDataExport;
+}
+
+export const DownloadMyDataButton = ({ data }: Readonly<DownloadMyDataButtonProps>) => {
+  const { t } = useTranslation();
+
+  const handleDownload = () => {
+    const blob = new Blob([JSON.stringify(data, null, 2)], { type: "application/json" });
+    const url = URL.createObjectURL(blob);
+
+    const link = document.createElement("a");
+    link.href = url;
+    link.download = EXPORT_FILE_NAME;
+    document.body.appendChild(link);
+    link.click();
+    link.remove();
+
+    // Give the browser a moment to start the download before the object URL is released.
+    setTimeout(() => URL.revokeObjectURL(url), 0);
+  };
+
+  return (
+    <Button variant="secondary" onClick={handleDownload}>
+      <DownloadIcon />
+      {t("workspace.settings.profile.download_my_data")}
+    </Button>
+  );
+};
