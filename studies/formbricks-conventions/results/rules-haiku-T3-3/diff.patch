+import { SettingsCard } from "@/app/(app)/workspaces/[workspaceId]/settings/components/SettingsCard";
+import { getTranslate } from "@/lingodotdev/server";
+import { formatDateTimeForDisplay } from "@/lib/utils/datetime";
+import type { TAccountDataExport } from "@/modules/account/lib/account-data-export";
+import { DownloadMyDataButton } from "./DownloadMyDataButton";
+
+interface AccountActivityCardProps {
+  createdAt: Date;
+  lastLoginAt: Date | null;
+  locale: string;
+  exportData: TAccountDataExport;
+}
+
+// Dates are formatted on the server with the user's locale so the server render and the hydrated
+// client render always agree, regardless of the time zone of the browser.
+export const AccountActivityCard = async ({
+  createdAt,
+  lastLoginAt,
+  locale,
+  exportData,
+}: Readonly<AccountActivityCardProps>) => {
+  const t = await getTranslate();
+
+  return (
+    <SettingsCard
+      title={t("workspace.settings.profile.account_activity")}
+      description={t("workspace.settings.profile.account_activity_description")}>
+      <dl className="grid grid-cols-[auto_1fr] gap-x-6 gap-y-2 text-sm">
+        <dt className="text-slate-600">{t("workspace.settings.profile.account_created")}</dt>
+        <dd className="text-slate-900">{formatDateTimeForDisplay(createdAt, locale)}</dd>
+        <dt className="text-slate-600">{t("workspace.settings.profile.last_login")}</dt>
+        <dd className="text-slate-900">
+          {lastLoginAt
+            ? formatDateTimeForDisplay(lastLoginAt, locale)
+            : t("workspace.settings.profile.last_login_never")}
+        </dd>
+      </dl>
+
+      <div className="mt-6 flex flex-col gap-2 border-t border-slate-200 pt-4">
+        <p className="text-xs text-slate-600">{t("workspace.settings.profile.download_my_data_description")}</p>
+        <div>
+          <DownloadMyDataButton data={exportData} />
+        </div>
+      </div>
+    </SettingsCard>
+  );
+};
