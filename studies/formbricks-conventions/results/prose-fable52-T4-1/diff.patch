+/**
+ * `POST /api/v3/tags/delete-unused` → 200 `{ data: { deleted } }`.
+ *
+ * Unlike the single-tag mutations, the scope is supplied rather than derived: there is no one tag to
+ * resolve the workspace from. That is safe because the value authorized against and the value the delete
+ * is filtered by are the same `workspaceId`, so they cannot diverge.
+ *
+ * `deleted` may be zero. A workspace with no unused tags is a success, not an error.
+ */
+export async function deleteUnusedV3Tags(
+  params: TBaseParams & { workspaceId: string; auditLog?: TV3AuditLog }
+): Promise<Response> {
+  const { authentication, workspaceId, auditLog, requestId, instance } = params;
+
+  const access = await requireV3WorkspaceAccess(
+    authentication,
+    workspaceId,
+    "readWrite",
+    requestId,
+    instance
+  );
+  if (access instanceof Response) return access;
+
+  if (auditLog) {
+    auditLog.organizationId = access.organizationId;
+    auditLog.targetId = access.workspaceId;
+  }
+
+  const result = await deleteUnusedTags(access.workspaceId);
+  if (!result.ok) {
+    return problemInternalError(requestId, "Unable to delete unused tags", instance);
+  }
+
+  // The names go into the audit trail because a deleted tag cannot be looked up afterwards: an id alone
+  // would not tell a reviewer what was removed.
+  if (auditLog) {
+    auditLog.oldObject = {
+      workspaceId: access.workspaceId,
+      deleted: result.data.length,
+      tags: result.data,
+    };
+  }
+
+  return successResponse({ deleted: result.data.length }, { requestId });
+}
