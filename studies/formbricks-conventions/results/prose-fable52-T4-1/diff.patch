+/**
+ * Deletes every tag of the workspace that no response carries, and returns the removed tags.
+ *
+ * "Unused" is decided by the database inside the delete statement itself (`responses: { none: {} }`),
+ * never from a list read beforehand: a tag applied to a response between a read and a delete would
+ * otherwise be removed together with that new link, because `TagsOnResponses` cascades.
+ *
+ * It also deliberately ignores survey visibility. The count the settings table shows only covers responses
+ * the caller may read (ENG-3282), so a tag can display `0` and still be in use on a restricted survey.
+ * Such a tag is in use and stays.
+ */
+export const deleteUnusedTags = async (
+  workspaceId: string
+): Promise<Result<Pick<TTag, "id" | "name">[], { code: TagError; message: string }>> => {
+  validateInputs([workspaceId, ZId]);
+
+  try {
+    const deletedTags = await prisma.tag.deleteManyAndReturn({
+      where: { workspaceId, responses: { none: {} } },
+      select: { id: true, name: true },
+    });
+
+    return ok(deletedTags);
+  } catch (error) {
+    return err({
+      code: TagError.UNEXPECTED_ERROR,
+      message: error instanceof Error ? error.message : "Unknown error occurred",
+    });
+  }
+};
