diff --git a/docs/api-v3-reference/src/paths/api_v3_tags_delete-unused.yml b/docs/api-v3-reference/src/paths/api_v3_tags_delete-unused.yml
new file mode 100644
index 000000000..c7a0cc3f4
--- /dev/null
+++ b/docs/api-v3-reference/src/paths/api_v3_tags_delete-unused.yml
@@ -0,0 +1,64 @@
+post:
+  operationId: deleteUnusedTagsV3
+  # Session-only by design, so an API-key caller reading the published reference would only ever get a
+  # 401. Excluded from the generated docs pages until ENG-2533 decides between dropping the paths
+  # and opening them to API keys; the operation stays in the bundle for the contract tests.
+  x-excluded: true
+  summary: Delete unused tags
+  description: |
+    Deletes every tag of the workspace that no response carries, and reports how many were deleted.
+    Requires organization owner/manager, or a workspace team membership with read-write permission.
+
+    A tag is unused only when it is on no response at all. The `count` that `GET /api/v3/tags` returns
+    covers only the responses the caller may read, so a tag can show `0` there and still be in use on a
+    survey the caller cannot see. Such a tag is kept.
+
+    `deleted` is `0` when the workspace has no unused tags. That is a success, so the call is safe to
+    repeat.
+
+    A POST custom method rather than a `DELETE` on the collection, for the same reason as
+    `POST /api/v3/responses/batch-delete`: a distinct path cannot be reached by accident.
+  tags:
+    - V3 Tags
+  parameters:
+    - $ref: ../components/parameters/WorkspaceIdQuery.yml
+  responses:
+    "200":
+      description: Unused tags deleted. `deleted` counts the tags removed and may be zero.
+      headers:
+        X-Request-Id:
+          schema:
+            type: string
+          description: Request correlation ID
+        Cache-Control:
+          schema:
+            type: string
+          example: private, no-store
+      content:
+        application/json:
+          schema:
+            type: object
+            required:
+              - data
+            properties:
+              data:
+                type: object
+                required:
+                  - deleted
+                properties:
+                  deleted:
+                    type: integer
+                    minimum: 0
+                    description: How many tags were deleted.
+    "400":
+      $ref: ../components/responses/V3BadRequest.yml
+    "401":
+      $ref: ../components/responses/V3UnauthorizedSession.yml
+    "403":
+      $ref: ../components/responses/V3Forbidden.yml
+    "429":
+      $ref: ../components/responses/V3TooManyRequests.yml
+    "500":
+      $ref: ../components/responses/V3InternalServerError.yml
+  security:
+    - sessionAuth: []
