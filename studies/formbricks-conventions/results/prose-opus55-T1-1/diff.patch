+/**
+ * Replace a key's secret in place. The row keeps its id, label, organization access and workspace
+ * permissions, so nothing in the authorization graph changes and no projection reconciliation is needed.
+ *
+ * The old secret stops working the moment this commits: both hashes it could be found by are
+ * overwritten, and `getApiKeyWithPermissions` caches only per request. `lastUsedAt` is cleared because it
+ * described the old secret; the new one has not been used yet.
+ *
+ * Returns the new v2 plaintext (`fbk_{secret}`) once. Only the hashes are stored, so it cannot be read
+ * again.
+ */
+export const rotateApiKey = async (
+  apiKeyId: string
+): Promise<TApiKeyWithEnvironmentPermission & { actualKey: string }> => {
+  validateInputs([apiKeyId, ZId]);
+
+  try {
+    const { secret, lookupHash, hashedKey } = await generateApiKeySecret();
+
+    const rotated = await prisma.apiKey.update({
+      where: { id: apiKeyId },
+      data: { hashedKey, lookupHash, lastUsedAt: null },
+      select: {
+        id: true,
+        label: true,
+        createdAt: true,
+        lastUsedAt: true,
+        organizationAccess: true,
+        apiKeyWorkspaces: {
+          select: {
+            permission: true,
+            workspaceId: true,
+          },
+        },
+      },
+    });
+
+    return { ...rotated, actualKey: `fbk_${secret}` };
+  } catch (error) {
+    if (error instanceof Prisma.PrismaClientKnownRequestError) {
+      throw new DatabaseError(error.message);
+    }
+    throw error;
+  }
+};
