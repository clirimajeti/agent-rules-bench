+++ b/apps/web/app/api/v3/api-keys/serializers.ts
@@ -0,0 +1,23 @@
+import type { TApiKeyWithEnvironmentPermission } from "@/modules/organization/settings/api-keys/types/api-keys";
+
+/** A key straight after rotation: the stored metadata plus the new plaintext, which is returned only here. */
+export type TV3RotatedApiKey = {
+  id: string;
+  label: string;
+  createdAt: string;
+  /** Always `null`: it described the old secret, and the new one has not been used yet. */
+  lastUsedAt: string | null;
+  /** The new `fbk_` key. Only its hashes are stored, so this is the one time it can be read. */
+  key: string;
+};
+
+export const serializeV3RotatedApiKey = (
+  apiKey: TApiKeyWithEnvironmentPermission,
+  key: string
+): TV3RotatedApiKey => ({
+  id: apiKey.id,
+  label: apiKey.label,
+  createdAt: apiKey.createdAt.toISOString(),
+  lastUsedAt: apiKey.lastUsedAt ? apiKey.lastUsedAt.toISOString() : null,
+  key,
+});
