@@ -0,0 +1,76 @@
+post:
+  operationId: rotateApiKeyV3
+  # Session-only by design, like the /tags operations: an API-key caller reading the published
+  # reference would only ever get a 401. Excluded from the generated docs pages under the same
+  # ENG-2533 decision; the operation stays in the bundle for the contract tests.
+  x-excluded: true
+  summary: Rotate an API key
+  description: |
+    Replaces the key's secret with a new one and returns the new key in `data.key`. This is the only
+    time the new key can be read: only its hashes are stored.
+
+    The key keeps its id, label, organization access and workspace permissions. The old secret stops
+    working immediately, and `lastUsedAt` is reset to `null` because it described the old secret.
+
+    Requires permission to manage the key. A key that carries organization access-control `write`
+    can only be rotated by someone who may also grant that access; anyone else gets `403`. An unknown
+    key also answers `403`, so key ids cannot be probed.
+  tags:
+    - V3 API Keys
+  parameters:
+    - in: path
+      name: apiKeyId
+      required: true
+      schema:
+        type: string
+        format: cuid2
+      description: The key to rotate.
+  responses:
+    "200":
+      description: API key rotated successfully
+      content:
+        application/json:
+          schema:
+            type: object
+            required:
+              - data
+            properties:
+              data:
+                type: object
+                additionalProperties: false
+                required:
+                  - id
+                  - label
+                  - createdAt
+                  - lastUsedAt
+                  - key
+                properties:
+                  id:
+                    type: string
+                    format: cuid2
+                  label:
+                    type: string
+                  createdAt:
+                    type: string
+                    format: date-time
+                  lastUsedAt:
+                    type:
+                      - string
+                      - "null"
+                    format: date-time
+                    description: Always `null` straight after rotation.
+                  key:
+                    type: string
+                    description: The new API key (`fbk_…`). Shown once; it cannot be retrieved again.
+    "400":
+      $ref: ../components/responses/V3BadRequest.yml
+    "401":
+      $ref: ../components/responses/V3UnauthorizedSession.yml
+    "403":
+      $ref: ../components/responses/V3Forbidden.yml
+    "429":
+      $ref: ../components/responses/V3TooManyRequests.yml
+    "500":
+      $ref: ../components/responses/V3InternalServerError.yml
+  security:
+    - sessionAuth: []
