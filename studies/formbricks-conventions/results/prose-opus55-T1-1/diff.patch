@@ -0,0 +1,126 @@
+import { beforeEach, describe, expect, test, vi } from "vitest";
+import type { TV3AuditLog, TV3Authentication } from "@/app/api/v3/lib/types";
+import { can } from "@/lib/authorization";
+import {
+  getApiKeyRotationContext,
+  rotateApiKey,
+} from "@/modules/organization/settings/api-keys/lib/api-key";
+import { canGrantOrganizationWriteAccess } from "@/modules/organization/settings/api-keys/lib/organization-access";
+import { rotateV3ApiKey } from "./operations";
+
+vi.mock("server-only", () => ({}));
+
+vi.mock("@formbricks/logger", () => ({
+  logger: { withContext: vi.fn(() => ({ error: vi.fn(), warn: vi.fn() })) },
+}));
+vi.mock("@/lib/authorization", () => ({ can: vi.fn() }));
+vi.mock("@/lib/posthog", () => ({ capturePostHogEvent: vi.fn() }));
+vi.mock("@/modules/organization/settings/api-keys/lib/api-key", () => ({
+  getApiKeyRotationContext: vi.fn(),
+  rotateApiKey: vi.fn(),
+}));
+vi.mock("@/modules/organization/settings/api-keys/lib/organization-access", () => ({
+  canGrantOrganizationWriteAccess: vi.fn(),
+}));
+
+const apiKeyId = "clkk1234567890123456789012";
+const organizationId = "clzz1234567890123456789012";
+const userId = "cluu1234567890123456789012";
+
+const session = { user: { id: userId } } as unknown as TV3Authentication;
+const base = { authentication: session, apiKeyId, requestId: "req_1", instance: "/api/v3/api-keys" };
+
+const readOnlyAccess = { accessControl: { read: true, write: false } };
+const writeAccess = { accessControl: { read: true, write: true } };
+
+const rotated = {
+  id: apiKeyId,
+  label: "CI",
+  createdAt: new Date("2026-01-01T00:00:00.000Z"),
+  lastUsedAt: null,
+  organizationAccess: readOnlyAccess,
+  apiKeyWorkspaces: [],
+  actualKey: "fbk_newSecret",
+};
+
+beforeEach(() => {
+  vi.resetAllMocks();
+});
+
+describe("rotateV3ApiKey", () => {
+  test("rotates a key the caller may manage and returns the new key once", async () => {
+    vi.mocked(getApiKeyRotationContext).mockResolvedValue({
+      id: apiKeyId,
+      organizationId,
+      organizationAccess: readOnlyAccess,
+    });
+    vi.mocked(can).mockResolvedValue(true);
+    vi.mocked(rotateApiKey).mockResolvedValue(rotated as Awaited<ReturnType<typeof rotateApiKey>>);
+    const auditLog = {} as TV3AuditLog;
+
+    const response = await rotateV3ApiKey({ ...base, auditLog });
+    const body = await response.json();
+
+    expect(response.status).toBe(200);
+    expect(body.data).toEqual({
+      id: apiKeyId,
+      label: "CI",
+      createdAt: "2026-01-01T00:00:00.000Z",
+      lastUsedAt: null,
+      key: "fbk_newSecret",
+    });
+    expect(can).toHaveBeenCalledWith({ type: "user", id: userId }, "apiKey.manage", {
+      type: "apiKey",
+      id: apiKeyId,
+    });
+    // The audit trail names the key but must never carry the secret.
+    expect(auditLog).toMatchObject({ organizationId, targetId: apiKeyId });
+    expect(JSON.stringify(auditLog)).not.toContain("fbk_newSecret");
+  });
+
+  test("answers 403 for an unknown key without rotating", async () => {
+    vi.mocked(getApiKeyRotationContext).mockResolvedValue(null);
+
+    const response = await rotateV3ApiKey(base);
+
+    expect(response.status).toBe(403);
+    expect(rotateApiKey).not.toHaveBeenCalled();
+  });
+
+  test("answers 403 when the caller may not manage the key", async () => {
+    vi.mocked(getApiKeyRotationContext).mockResolvedValue({
+      id: apiKeyId,
+      organizationId,
+      organizationAccess: readOnlyAccess,
+    });
+    vi.mocked(can).mockResolvedValue(false);
+
+    const response = await rotateV3ApiKey(base);
+
+    expect(response.status).toBe(403);
+    expect(rotateApiKey).not.toHaveBeenCalled();
+  });
+
+  test("refuses to hand out a user-management key below the organization's floor (ENG-3075)", async () => {
+    vi.mocked(getApiKeyRotationContext).mockResolvedValue({
+      id: apiKeyId,
+      organizationId,
+      organizationAccess: writeAccess,
+    });
+    vi.mocked(can).mockResolvedValue(true);
+    vi.mocked(canGrantOrganizationWriteAccess).mockResolvedValue(false);
+
+    const response = await rotateV3ApiKey(base);
+
+    expect(response.status).toBe(403);
+    expect(canGrantOrganizationWriteAccess).toHaveBeenCalledWith(userId, organizationId);
+    expect(rotateApiKey).not.toHaveBeenCalled();
+  });
+
+  test("answers 401 without a session user", async () => {
+    const response = await rotateV3ApiKey({ ...base, authentication: null });
+
+    expect(response.status).toBe(401);
+    expect(getApiKeyRotationContext).not.toHaveBeenCalled();
+  });
+});
diff --git a/apps/web/app/api/v3/api-keys/lib/operations.ts b/apps/web/app/api/v3/api-keys/lib/operations.ts
new file mode 100644
index 000000000..d42f85c5c
--- /dev/null
+++ b/apps/web/app/api/v3/api-keys/lib/operations.ts
@@ -0,0 +1,81 @@
+import "server-only";
+import { getV3SessionUserId } from "@/app/api/v3/lib/auth";
+import { problemForbidden, problemUnauthorized, successResponse } from "@/app/api/v3/lib/response";
+import type { TV3AuditLog, TV3Authentication } from "@/app/api/v3/lib/types";
+import { can } from "@/lib/authorization";
+import { capturePostHogEvent } from "@/lib/posthog";
+import {
+  getApiKeyRotationContext,
+  rotateApiKey,
+} from "@/modules/organization/settings/api-keys/lib/api-key";
+import { canGrantOrganizationWriteAccess } from "@/modules/organization/settings/api-keys/lib/organization-access";
+import { serializeV3RotatedApiKey } from "../serializers";
+
+type TRotateParams = {
+  authentication: TV3Authentication;
+  apiKeyId: string;
+  auditLog?: TV3AuditLog;
+  requestId: string;
+  instance?: string;
+};
+
+/**
+ * Replace an API key's secret, keeping its label, organization access and workspace permissions.
+ *
+ * Session-only: a key never rotates itself or another key, so the caller is always a person.
+ *
+ * Authorization is the delete action's (`apiKey.manage` on the key) plus the ENG-3075 floor that
+ * `createApiKeyAction` applies. Rotation hands the caller a working secret with the key's full
+ * authority, so for a key carrying `accessControl.write` it is minting, and someone below the
+ * organization's user-management floor must not be able to obtain one this way.
+ *
+ * An unknown key answers 403, not 404, as the tag and survey routes do: a 404 would let any signed-in
+ * user probe which key ids exist across the instance.
+ */
+export async function rotateV3ApiKey(params: TRotateParams): Promise<Response> {
+  const { authentication, apiKeyId, auditLog, requestId, instance } = params;
+
+  const userId = getV3SessionUserId(authentication);
+  if (!userId) {
+    return problemUnauthorized(requestId, "Session required", instance);
+  }
+
+  const forbidden = () =>
+    problemForbidden(requestId, "You are not authorized to access this resource", instance);
+
+  const apiKey = await getApiKeyRotationContext(apiKeyId);
+  if (!apiKey) return forbidden();
+
+  const actor = { type: "user", id: userId } as const;
+  if (!(await can(actor, "apiKey.manage", { type: "apiKey", id: apiKey.id }))) {
+    return forbidden();
+  }
+
+  if (
+    apiKey.organizationAccess?.accessControl?.write === true &&
+    !(await canGrantOrganizationWriteAccess(userId, apiKey.organizationId))
+  ) {
+    return problemForbidden(requestId, "User management is not allowed for your role", instance);
+  }
+
+  if (auditLog) {
+    auditLog.organizationId = apiKey.organizationId;
+    auditLog.targetId = apiKey.id;
+  }
+
+  const rotated = await rotateApiKey(apiKey.id);
+
+  // The audit entry records which key rotated, never the secret or its hashes.
+  if (auditLog) {
+    auditLog.newObject = { id: rotated.id, label: rotated.label };
+  }
+
+  capturePostHogEvent(
+    userId,
+    "api_key_rotated",
+    { api_key_id: rotated.id },
+    { organizationId: apiKey.organizationId }
+  );
+
+  return successResponse(serializeV3RotatedApiKey(rotated, rotated.actualKey), { requestId });
+}
