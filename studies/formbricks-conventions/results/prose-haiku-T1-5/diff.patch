@@ -0,0 +1,68 @@
+import "server-only";
+import { AuthorizationError, OperationNotAllowedError, ResourceNotFoundError } from "@formbricks/types/errors";
+import { assertCan } from "@/lib/authorization";
+import { getV3SessionUserId } from "@/app/api/v3/lib/auth";
+import { problemForbidden, problemUnauthorized, successResponse } from "@/app/api/v3/lib/response";
+import type { TV3AuditLog, TV3Authentication } from "@/app/api/v3/lib/types";
+import {
+  getApiKeyOrganizationScope,
+  rotateApiKey,
+} from "@/modules/organization/settings/api-keys/lib/api-key";
+import { assertCanGrantOrganizationAccess } from "@/modules/organization/settings/api-keys/lib/organization-access";
+
+type TBaseParams = {
+  authentication: TV3Authentication;
+  requestId: string;
+  instance?: string;
+};
+
+/**
+ * Replaces an organization API key's secret. Session-only: it replaces the `apiKey.manage` server action
+ * and never accepts an API key as the caller.
+ *
+ * Two checks run before the secret changes. `apiKey.manage` is the same permission the update and delete
+ * actions require. The grant floor is applied to the key's existing organization access, because a
+ * rotated key is a fresh working credential with that authority: a caller who could not mint such a key
+ * must not be able to obtain one by rotating an existing key.
+ *
+ * An unknown key answers 403, not 404, so the endpoint cannot be used to probe key ids.
+ */
+export async function rotateV3ApiKey(
+  params: TBaseParams & { apiKeyId: string; auditLog?: TV3AuditLog }
+): Promise<Response> {
+  const { authentication, apiKeyId, auditLog, requestId, instance } = params;
+
+  const userId = getV3SessionUserId(authentication);
+  if (!userId) {
+    return problemUnauthorized(requestId, "Session required", instance);
+  }
+
+  const forbidden = () =>
+    problemForbidden(requestId, "You are not authorized to access this resource", instance);
+
+  const scope = await getApiKeyOrganizationScope(apiKeyId);
+  if (!scope) return forbidden();
+
+  try {
+    await assertCan({ type: "user", id: userId }, "apiKey.manage", { type: "apiKey", id: apiKeyId });
+    await assertCanGrantOrganizationAccess(userId, scope.organizationId, scope.organizationAccess);
+  } catch (error) {
+    if (
+      error instanceof AuthorizationError ||
+      error instanceof OperationNotAllowedError ||
+      error instanceof ResourceNotFoundError
+    ) {
+      return forbidden();
+    }
+    throw error;
+  }
+
+  if (auditLog) {
+    auditLog.organizationId = scope.organizationId;
+    auditLog.targetId = apiKeyId;
+  }
+
+  const result = await rotateApiKey(apiKeyId);
+
+  return successResponse(result, { requestId });
+}
