diff --git a/apps/web/modules/organization/settings/api-keys/lib/api-client.ts b/apps/web/modules/organization/settings/api-keys/lib/api-client.ts
new file mode 100644
index 000000000..d10ab6a6c
--- /dev/null
+++ b/apps/web/modules/organization/settings/api-keys/lib/api-client.ts
@@ -0,0 +1,23 @@
+import { parseV3ApiError } from "@/modules/api/lib/v3-client";
+
+/**
+ * Client fetchers for the API key v3 routes. Every call throws a parsed `V3ApiError` on a non-2xx
+ * response, so the hooks can surface the server's own message.
+ */
+
+const BASE_PATH = "/api/v3/api-keys";
+
+async function request<T>(url: string, init: RequestInit): Promise<T> {
+  const response = await fetch(url, { cache: "no-store", ...init });
+  if (!response.ok) {
+    throw await parseV3ApiError(response);
+  }
+  return ((await response.json()) as { data: T }).data;
+}
+
+/** Replaces the key's secret. The returned `actualKey` is the only time the new value is available. */
+export async function rotateApiKey(params: { apiKeyId: string }): Promise<{ id: string; actualKey: string }> {
+  return request<{ id: string; actualKey: string }>(`${BASE_PATH}/${params.apiKeyId}/rotate`, {
+    method: "POST",
+  });
+}
