+"use client";
+
+import { FilesIcon, RefreshCwIcon } from "lucide-react";
+import toast from "react-hot-toast";
+import { useTranslation } from "react-i18next";
+import { Button } from "@/modules/ui/components/button";
+import {
+  Dialog,
+  DialogBody,
+  DialogContent,
+  DialogDescription,
+  DialogFooter,
+  DialogHeader,
+  DialogTitle,
+} from "@/modules/ui/components/dialog";
+
+interface RotateApiKeyDialogProps {
+  open: boolean;
+  setOpen: (open: boolean) => void;
+  onRotate: () => void;
+  isRotating: boolean;
+}
+
+/** Asks for confirmation first, because the current secret stops working as soon as it is rotated. */
+export const RotateApiKeyDialog = ({
+  open,
+  setOpen,
+  onRotate,
+  isRotating,
+}: Readonly<RotateApiKeyDialogProps>) => {
+  const { t } = useTranslation();
+  return (
+    <Dialog open={open} onOpenChange={setOpen}>
+      <DialogContent width="narrow" disableCloseOnOutsideClick={true}>
+        <DialogHeader>
+          <DialogTitle>{t("workspace.api_keys.rotate_api_key")}</DialogTitle>
+          <DialogDescription>{t("workspace.api_keys.rotate_api_key_confirmation")}</DialogDescription>
+        </DialogHeader>
+        <DialogFooter>
+          <Button variant="secondary" onClick={() => setOpen(false)} disabled={isRotating}>
+            {t("common.cancel")}
+          </Button>
+          <Button onClick={onRotate} loading={isRotating} disabled={isRotating}>
+            <RefreshCwIcon />
+            {t("workspace.api_keys.rotate_api_key")}
+          </Button>
+        </DialogFooter>
+      </DialogContent>
+    </Dialog>
+  );
+};
+
+interface RotatedApiKeyDialogProps {
+  open: boolean;
+  setOpen: (open: boolean) => void;
+  /** The new plaintext key. Held only while the dialog is open; the server does not return it again. */
+  apiKey: string | null;
+}
+
+/**
+ * Shows the new key exactly once. There is no way to re-open it, so closing the dialog discards the value
+ * from the client as well.
+ */
+export const RotatedApiKeyDialog = ({ open, setOpen, apiKey }: Readonly<RotatedApiKeyDialogProps>) => {
+  const { t } = useTranslation();
+
+  const copyToClipboard = async () => {
+    if (!apiKey) return;
+    try {
+      await navigator.clipboard.writeText(apiKey);
+      toast.success(t("workspace.api_keys.api_key_copied_to_clipboard"));
+    } catch {
+      toast.error(t("workspace.api_keys.unable_to_copy_api_key"));
+    }
+  };
+
+  return (
+    <Dialog open={open} onOpenChange={setOpen}>
+      <DialogContent width="narrow" disableCloseOnOutsideClick={true}>
+        <DialogHeader>
+          <DialogTitle>{t("workspace.api_keys.rotated_api_key_title")}</DialogTitle>
+          <DialogDescription>{t("workspace.api_keys.rotated_api_key_description")}</DialogDescription>
+        </DialogHeader>
+        <DialogBody>
+          <div className="flex items-center justify-between gap-2 rounded-md border border-slate-200 bg-slate-50 p-3">
+            <span className="font-mono text-sm break-all" data-testid="rotated-api-key">
+              {apiKey}
+            </span>
+            <Button
+              size="icon"
+              variant="ghost"
+              aria-label={t("common.copy")}
+              onClick={() => void copyToClipboard()}>
+              <FilesIcon />
+            </Button>
+          </div>
+        </DialogBody>
+        <DialogFooter>
+          <Button onClick={() => setOpen(false)}>{t("common.close")}</Button>
+        </DialogFooter>
+      </DialogContent>
+    </Dialog>
+  );
+};
