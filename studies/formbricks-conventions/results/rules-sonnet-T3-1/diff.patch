--- /dev/null
+++ b/docs/api-v3-reference/src/paths/api_v3_account_data-export.yml
@@ -0,0 +1,80 @@
+get:
+  operationId: getAccountDataExportV3
+  # Session-only by design: it exports the signed-in user's own account, so an API key has no user to
+  # export and would only ever get a 401.
+  x-excluded: true
+  summary: Export my account data
+  description: |
+    Returns the signed-in user's own data: name, email, locale, notification settings and the
+    organizations they belong to (organization name and role). Credentials are never included.
+
+    Session cookie only. It backs the "Download my data" button on the profile page, so it does not accept
+    `x-api-key`.
+  tags:
+    - V3 Account
+  responses:
+    "200":
+      description: Account data retrieved successfully
+      headers:
+        X-Request-Id:
+          schema:
+            type: string
+          description: Request correlation ID
+        Cache-Control:
+          schema:
+            type: string
+          example: private, no-store
+      content:
+        application/json:
+          schema:
+            type: object
+            required:
+              - data
+            properties:
+              data:
+                type: object
+                required:
+                  - name
+                  - email
+                  - locale
+                  - notificationSettings
+                  - organizationMemberships
+                properties:
+                  name:
+                    type: string
+                  email:
+                    type: string
+                  locale:
+                    type: string
+                    example: en-US
+                  notificationSettings:
+                    type: object
+                    additionalProperties: true
+                    description: The user's notification preferences, as stored.
+                  organizationMemberships:
+                    type: array
+                    items:
+                      type: object
+                      required:
+                        - organizationName
+                        - role
+                      properties:
+                        organizationName:
+                          type: string
+                        role:
+                          type: string
+                          enum:
+                            - owner
+                            - manager
+                            - member
+                            - billing
+    "400":
+      $ref: ../components/responses/V3BadRequest.yml
+    "401":
+      $ref: ../components/responses/V3UnauthorizedSession.yml
+    "429":
+      $ref: ../components/responses/V3TooManyRequests.yml
+    "500":
+      $ref: ../components/responses/V3InternalServerError.yml
+  security:
+    - sessionAuth: []
