+/**
+ * GET /api/v3/account/data-export - the signed-in user's own data (name, email, locale, notification
+ * settings, organization memberships) for the profile page's "Download my data" button.
+ *
+ * Session-only: it is the caller's own account, so an API key has no user to export.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { ZV3EmptyQuery } from "@/app/api/v3/lib/schemas";
+import { getV3AccountDataExport } from "../lib/data-export";
+
+export const GET = withV3ApiWrapper({
+  auth: "session",
+  schemas: { query: ZV3EmptyQuery },
+  handler: async ({ authentication, requestId, instance }) =>
+    getV3AccountDataExport({ authentication, requestId, instance }),
+});
diff --git a/apps/web/app/api/v3/account/lib/data-export.test.ts b/apps/web/app/api/v3/account/lib/data-export.test.ts
new file mode 100644
index 000000000..fe439e2d8
--- /dev/null
+++ b/apps/web/app/api/v3/account/lib/data-export.test.ts
@@ -0,0 +1,70 @@
+import { beforeEach, describe, expect, test, vi } from "vitest";
+import { prisma } from "@formbricks/database";
+import { getV3AccountDataExport } from "./data-export";
+
+vi.mock("server-only", () => ({}));
+vi.mock("@formbricks/database", () => ({ prisma: { user: { findUnique: vi.fn() } } }));
+vi.mock("@formbricks/logger", () => ({
+  logger: { withContext: vi.fn(() => ({ error: vi.fn(), warn: vi.fn() })) },
+}));
+
+const session = { user: { id: "user_1" }, expires: "2099-01-01T00:00:00.000Z" };
+const base = { authentication: session, requestId: "req_1", instance: "/api/v3/account/data-export" };
+
+beforeEach(() => {
+  vi.resetAllMocks();
+});
+
+describe("getV3AccountDataExport", () => {
+  test("returns the session user's profile, settings and memberships, scoped to their id", async () => {
+    vi.mocked(prisma.user.findUnique).mockResolvedValue({
+      name: "Ada",
+      email: "ada@example.com",
+      locale: "de-DE",
+      notificationSettings: { alert: {}, weeklySummary: {} },
+      memberships: [{ role: "owner", organization: { name: "Acme" } }],
+    } as never);
+
+    const response = await getV3AccountDataExport(base);
+
+    expect(response.status).toBe(200);
+    expect(await response.json()).toEqual({
+      data: {
+        name: "Ada",
+        email: "ada@example.com",
+        locale: "de-DE",
+        notificationSettings: { alert: {}, weeklySummary: {} },
+        organizationMemberships: [{ organizationName: "Acme", role: "owner" }],
+      },
+    });
+    expect(vi.mocked(prisma.user.findUnique).mock.calls[0][0]).toMatchObject({ where: { id: "user_1" } });
+  });
+
+  test("never selects credentials", async () => {
+    vi.mocked(prisma.user.findUnique).mockResolvedValue({ memberships: [] } as never);
+
+    await getV3AccountDataExport(base);
+
+    const select = vi.mocked(prisma.user.findUnique).mock.calls[0][0]?.select as Record<string, unknown>;
+    expect(Object.keys(select).sort()).toEqual(["email", "locale", "memberships", "name", "notificationSettings"]);
+  });
+
+  test("answers 401 without a session user and does not query", async () => {
+    const response = await getV3AccountDataExport({ ...base, authentication: null });
+
+    expect(response.status).toBe(401);
+    expect(prisma.user.findUnique).not.toHaveBeenCalled();
+  });
+
+  test("answers 401 when the user row no longer exists", async () => {
+    vi.mocked(prisma.user.findUnique).mockResolvedValue(null);
+
+    expect((await getV3AccountDataExport(base)).status).toBe(401);
+  });
+
+  test("answers 500 when the query fails", async () => {
+    vi.mocked(prisma.user.findUnique).mockRejectedValue(new Error("db down"));
+
+    expect((await getV3AccountDataExport(base)).status).toBe(500);
+  });
+});
diff --git a/apps/web/app/api/v3/account/lib/data-export.ts b/apps/web/app/api/v3/account/lib/data-export.ts
new file mode 100644
index 000000000..9e5f728d4
--- /dev/null
+++ b/apps/web/app/api/v3/account/lib/data-export.ts
@@ -0,0 +1,63 @@
+import "server-only";
+import { prisma } from "@formbricks/database";
+import { logger } from "@formbricks/logger";
+import { getV3SessionUserId } from "@/app/api/v3/lib/auth";
+import { problemInternalError, problemUnauthorized, successResponse } from "@/app/api/v3/lib/response";
+import type { TV3Authentication } from "@/app/api/v3/lib/types";
+
+/**
+ * The signed-in user's own personal data ("Download my data"): profile fields, notification settings and
+ * the organizations they belong to. Scoped to the session user's id, never to a client-supplied one.
+ * Credentials (password hash, 2FA secret, backup codes) are never selected.
+ */
+export async function getV3AccountDataExport(params: {
+  authentication: TV3Authentication;
+  requestId: string;
+  instance?: string;
+}): Promise<Response> {
+  const { authentication, requestId, instance } = params;
+
+  const userId = getV3SessionUserId(authentication);
+  if (!userId) {
+    return problemUnauthorized(requestId, "Session required", instance);
+  }
+
+  try {
+    const user = await prisma.user.findUnique({
+      where: { id: userId },
+      select: {
+        name: true,
+        email: true,
+        locale: true,
+        notificationSettings: true,
+        memberships: {
+          where: { accepted: true },
+          select: { role: true, organization: { select: { name: true } } },
+          orderBy: { organization: { name: "asc" } },
+        },
+      },
+    });
+
+    // A valid session whose user row is gone (deleted mid-session) is no longer authenticated.
+    if (!user) {
+      return problemUnauthorized(requestId, "Session required", instance);
+    }
+
+    return successResponse(
+      {
+        name: user.name,
+        email: user.email,
+        locale: user.locale,
+        notificationSettings: user.notificationSettings,
+        organizationMemberships: user.memberships.map((membership) => ({
+          organizationName: membership.organization.name,
+          role: membership.role,
+        })),
+      },
+      { requestId }
+    );
+  } catch (error) {
+    logger.withContext({ requestId }).error({ error }, "Failed to export account data");
+    return problemInternalError(requestId, "Failed to export account data", instance);
+  }
+}
