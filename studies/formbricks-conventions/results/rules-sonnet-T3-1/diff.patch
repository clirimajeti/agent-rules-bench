+"use client";
+
+import { useMutation } from "@tanstack/react-query";
+import { DownloadIcon } from "lucide-react";
+import toast from "react-hot-toast";
+import { useTranslation } from "react-i18next";
+import { Button } from "@/modules/ui/components/button";
+import { DOWNLOAD_MY_DATA_FILENAME, fetchMyData, saveJsonFile } from "../lib/download-my-data";
+
+export const DownloadMyDataButton = () => {
+  const { t } = useTranslation();
+  const download = useMutation({
+    mutationFn: async () => saveJsonFile(await fetchMyData(), DOWNLOAD_MY_DATA_FILENAME),
+    onError: () => toast.error(t("workspace.settings.profile.download_my_data_failed")),
+  });
+
+  return (
+    <Button type="button" variant="secondary" loading={download.isPending} onClick={() => download.mutate()}>
+      <DownloadIcon />
+      {t("workspace.settings.profile.download_my_data")}
+    </Button>
+  );
+};
diff --git a/apps/web/app/(app)/workspaces/[workspaceId]/settings/account/profile/lib/download-my-data.ts b/apps/web/app/(app)/workspaces/[workspaceId]/settings/account/profile/lib/download-my-data.ts
