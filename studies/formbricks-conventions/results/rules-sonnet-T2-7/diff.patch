@@ -0,0 +1,41 @@
+"use client";
+
+import { useMutation } from "@tanstack/react-query";
+import { CopyIcon } from "lucide-react";
+import { useRouter } from "next/navigation";
+import toast from "react-hot-toast";
+import { useTranslation } from "react-i18next";
+import { V3ApiError } from "@/modules/api/lib/v3-client";
+import { duplicateWebhook } from "@/modules/integrations/webhooks/lib/api-client";
+import { Button } from "@/modules/ui/components/button";
+
+export const DuplicateWebhookButton = ({ webhookId }: Readonly<{ webhookId: string }>) => {
+  const { t } = useTranslation();
+  const router = useRouter();
+
+  const duplicateMutation = useMutation({
+    mutationFn: () => duplicateWebhook({ webhookId }),
+    onSuccess: () => {
+      toast.success(t("workspace.integrations.webhooks.webhook_duplicated_successfully"));
+      // The list is server-rendered, so refetch it to show the copy.
+      router.refresh();
+    },
+    onError: (error) =>
+      toast.error(
+        error instanceof V3ApiError ? error.message : t("workspace.integrations.webhooks.duplicate_failed")
+      ),
+  });
+
+  return (
+    <Button
+      type="button"
+      variant="outline"
+      size="sm"
+      loading={duplicateMutation.isPending}
+      disabled={duplicateMutation.isPending}
+      onClick={() => duplicateMutation.mutate()}>
+      <CopyIcon className="size-4" aria-hidden="true" />
+      {t("common.duplicate")}
+    </Button>
+  );
+};
