@@ -0,0 +1,79 @@
+post:
+  operationId: duplicateWebhookV3
+  # Session-only, like the tag operations: an API-key caller would only ever get a 401.
+  x-excluded: true
+  summary: Duplicate a webhook
+  description: |
+    Creates a copy of the webhook in the same workspace with the same URL, triggers and surveys.
+    The copy is named `Copy of` plus the original name and gets its own newly generated signing secret.
+
+    The response includes the new signing secret. It is shown once, as when a webhook is created.
+    An unknown webhook answers `403`.
+  tags:
+    - V3 Webhooks
+  parameters:
+    - in: path
+      name: webhookId
+      required: true
+      schema:
+        type: string
+      description: The webhook to copy.
+  responses:
+    "201":
+      description: Webhook duplicated successfully
+      content:
+        application/json:
+          schema:
+            type: object
+            required:
+              - data
+            properties:
+              data:
+                type: object
+                description: The new webhook, including its signing secret.
+                required:
+                  - id
+                  - workspaceId
+                  - url
+                  - triggers
+                  - surveyIds
+                  - secret
+                properties:
+                  id:
+                    type: string
+                  workspaceId:
+                    type: string
+                  name:
+                    type: string
+                    nullable: true
+                  url:
+                    type: string
+                  source:
+                    type: string
+                  triggers:
+                    type: array
+                    items:
+                      type: string
+                  surveyIds:
+                    type: array
+                    items:
+                      type: string
+                  secret:
+                    type: string
+                    nullable: true
+                  createdAt:
+                    type: string
+                    format: date-time
+                  updatedAt:
+                    type: string
+                    format: date-time
+    "401":
+      $ref: ../components/responses/V3UnauthorizedSession.yml
+    "403":
+      $ref: ../components/responses/V3Forbidden.yml
+    "429":
+      $ref: ../components/responses/V3TooManyRequests.yml
+    "500":
+      $ref: ../components/responses/V3InternalServerError.yml
+  security:
+    - sessionAuth: []
