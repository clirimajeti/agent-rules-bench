+/**
+ * POST /api/v3/webhooks/{webhookId}/duplicate — clone a webhook with a new signing secret.
+ * Session-only, matching the webhook actions it sits beside.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { duplicateV3Webhook } from "../../lib/operations";
+import { ZV3WebhookIdParams } from "../../lib/schemas";
+
+export const POST = withV3ApiWrapper({
+  auth: "session",
+  action: "created",
+  targetType: "webhook",
+  schemas: { params: ZV3WebhookIdParams },
+  handler: async ({ authentication, parsedInput, auditLog, requestId, instance }) =>
+    duplicateV3Webhook({
+      authentication,
+      webhookId: parsedInput.params.webhookId,
+      auditLog,
+      requestId,
+      instance,
+    }),
+});
diff --git a/apps/web/app/api/v3/webhooks/lib/operations.ts b/apps/web/app/api/v3/webhooks/lib/operations.ts
new file mode 100644
index 000000000..d106c237d
--- /dev/null
+++ b/apps/web/app/api/v3/webhooks/lib/operations.ts
@@ -0,0 +1,67 @@
+import "server-only";
+import { OperationNotAllowedError } from "@formbricks/types/errors";
+import { requireV3WorkspaceAccess } from "@/app/api/v3/lib/auth";
+import { createdResponse, problemForbidden, problemInternalError } from "@/app/api/v3/lib/response";
+import type { TV3AuditLog, TV3Authentication } from "@/app/api/v3/lib/types";
+import { assertNewlyAttachedSurveysWorkspaceVisible } from "@/lib/survey/visibility/outbound";
+import { getWebhookWithSecret } from "@/modules/api/v2/management/webhooks/[webhookId]/lib/webhook";
+import { createWebhook } from "@/modules/integrations/webhooks/lib/webhook";
+
+type TBaseParams = {
+  authentication: TV3Authentication;
+  requestId: string;
+  instance?: string;
+};
+
+/**
+ * Clones a webhook into the same workspace: same URL, triggers and surveys, named "Copy of <name>", with a
+ * freshly generated signing secret (`createWebhook` generates one when none is passed, so the original's
+ * secret is never reused).
+ *
+ * The workspace is resolved from the webhook itself, never from the request. An unknown webhook answers
+ * 403, not 404, so a signed-in user cannot probe webhook ids across the instance.
+ *
+ * The response carries the new secret: it is shown once on creation, exactly like the create flow.
+ */
+export async function duplicateV3Webhook(
+  params: TBaseParams & { webhookId: string; auditLog?: TV3AuditLog }
+): Promise<Response> {
+  const { authentication, webhookId, auditLog, requestId, instance } = params;
+
+  const original = await getWebhookWithSecret(webhookId);
+  if (!original.ok) {
+    return problemForbidden(requestId, "You are not authorized to access this resource", instance);
+  }
+  const { workspaceId, name, url, triggers, surveyIds, source } = original.data;
+
+  const access = await requireV3WorkspaceAccess(authentication, workspaceId, "readWrite", requestId, instance);
+  if (access instanceof Response) return access;
+
+  if (auditLog) {
+    auditLog.organizationId = access.organizationId;
+    auditLog.targetId = webhookId;
+  }
+
+  try {
+    // The copy attaches the same surveys again, so the caller must be allowed to attach them.
+    await assertNewlyAttachedSurveysWorkspaceVisible(surveyIds);
+  } catch (error) {
+    if (error instanceof OperationNotAllowedError) {
+      return problemForbidden(requestId, error.message, instance);
+    }
+    throw error;
+  }
+
+  const input = { name: `Copy of ${name ?? ""}`.trim(), url, triggers, surveyIds, source };
+
+  let copy;
+  try {
+    copy = await createWebhook(workspaceId, input);
+  } catch {
+    return problemInternalError(requestId, "Unable to duplicate webhook", instance);
+  }
+
+  if (auditLog) auditLog.newObject = input;
+
+  return createdResponse(copy, { location: `/api/v3/webhooks/${copy.id}`, requestId });
+}
