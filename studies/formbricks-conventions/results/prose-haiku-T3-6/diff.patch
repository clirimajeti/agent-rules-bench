@@ -0,0 +1,42 @@
+/**
+ * GET /api/v3/users/me/data — downloads the signed-in user's own account data as a JSON file.
+ * Session-only: an API key identifies an organization, not a person, so it cannot export one user's data.
+ */
+import { logger } from "@formbricks/logger";
+import { AuthenticationError } from "@formbricks/types/errors";
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { getV3SessionUserId } from "@/app/api/v3/lib/auth";
+import { mapV3ThrownError } from "@/app/api/v3/lib/errors";
+import { ZV3EmptyQuery } from "@/app/api/v3/lib/schemas";
+import { getUserDataExport } from "@/modules/account/lib/user-data-export";
+
+export const GET = withV3ApiWrapper({
+  auth: "session",
+  schemas: {
+    query: ZV3EmptyQuery,
+  },
+  handler: async ({ authentication, requestId, instance }) => {
+    const log = logger.withContext({ requestId });
+
+    try {
+      const userId = getV3SessionUserId(authentication);
+      if (!userId) {
+        throw new AuthenticationError("Not authenticated");
+      }
+
+      const data = await getUserDataExport(userId);
+
+      return new Response(JSON.stringify(data, null, 2), {
+        status: 200,
+        headers: {
+          "Content-Type": "application/json; charset=utf-8",
+          "Content-Disposition": 'attachment; filename="formbricks-my-data.json"',
+          "Cache-Control": "private, no-store",
+          "X-Request-Id": requestId,
+        },
+      });
+    } catch (error) {
+      return mapV3ThrownError(error, { log, requestId, instance, operation: "users.me.data.get" });
+    }
+  },
+});
