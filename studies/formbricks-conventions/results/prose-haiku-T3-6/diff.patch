@@ -0,0 +1,49 @@
+"use client";
+
+import { DownloadIcon } from "lucide-react";
+import { useState } from "react";
+import toast from "react-hot-toast";
+import { useTranslation } from "react-i18next";
+import { Button } from "@/modules/ui/components/button";
+
+const DOWNLOAD_FILE_NAME = "formbricks-my-data.json";
+
+export const DownloadMyDataButton = () => {
+  const { t } = useTranslation();
+  const [isDownloading, setIsDownloading] = useState(false);
+
+  const handleDownload = async () => {
+    setIsDownloading(true);
+    try {
+      const response = await fetch("/api/v3/users/me/data", { credentials: "same-origin" });
+      if (!response.ok) {
+        throw new Error(`Download failed with status ${response.status}`);
+      }
+
+      const blob = await response.blob();
+      const url = URL.createObjectURL(blob);
+      const link = document.createElement("a");
+      link.href = url;
+      link.download = DOWNLOAD_FILE_NAME;
+      document.body.appendChild(link);
+      link.click();
+      link.remove();
+      URL.revokeObjectURL(url);
+    } catch {
+      toast.error(t("workspace.settings.profile.download_my_data_failed"));
+    } finally {
+      setIsDownloading(false);
+    }
+  };
+
+  return (
+    <Button
+      variant="secondary"
+      onClick={handleDownload}
+      loading={isDownloading}
+      disabled={isDownloading}>
+      <DownloadIcon />
+      {t("workspace.settings.profile.download_my_data")}
+    </Button>
+  );
+};
diff --git a/apps/web/app/api/v3/users/me/data/route.ts b/apps/web/app/api/v3/users/me/data/route.ts
