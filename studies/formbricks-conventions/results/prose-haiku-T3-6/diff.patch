diff --git a/apps/web/modules/account/lib/user-data-export.ts b/apps/web/modules/account/lib/user-data-export.ts
new file mode 100644
index 000000000..710276118
--- /dev/null
+++ b/apps/web/modules/account/lib/user-data-export.ts
@@ -0,0 +1,60 @@
+import "server-only";
+import { prisma } from "@formbricks/database";
+import { ZId } from "@formbricks/types/common";
+import { ResourceNotFoundError } from "@formbricks/types/errors";
+import type { TUserLocale, TUserNotificationSettings } from "@formbricks/types/user";
+import { validateInputs } from "@/lib/utils/validate";
+
+export type TUserDataExport = {
+  exportedAt: string;
+  name: string;
+  email: string;
+  locale: TUserLocale;
+  notificationSettings: TUserNotificationSettings;
+  organizationMemberships: {
+    organizationName: string;
+    role: string;
+  }[];
+};
+
+/**
+ * Collects the personal data a user may download about their own account. Only accepted memberships
+ * are included: a pending invite is not yet a membership of the organization.
+ */
+export const getUserDataExport = async (userId: string): Promise<TUserDataExport> => {
+  validateInputs([userId, ZId]);
+
+  const user = await prisma.user.findUnique({
+    where: { id: userId },
+    select: {
+      name: true,
+      email: true,
+      locale: true,
+      notificationSettings: true,
+      memberships: {
+        where: { accepted: true },
+        select: {
+          role: true,
+          organization: { select: { name: true } },
+        },
+        orderBy: { organization: { name: "asc" } },
+      },
+    },
+  });
+
+  if (!user) {
+    throw new ResourceNotFoundError("User", userId);
+  }
+
+  return {
+    exportedAt: new Date().toISOString(),
+    name: user.name,
+    email: user.email,
+    locale: user.locale as TUserLocale,
+    notificationSettings: user.notificationSettings as TUserNotificationSettings,
+    organizationMemberships: user.memberships.map((membership) => ({
+      organizationName: membership.organization.name,
+      role: membership.role,
+    })),
+  };
+};
