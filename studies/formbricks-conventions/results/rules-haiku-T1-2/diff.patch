+++ b/apps/web/modules/organization/settings/api-keys/lib/api-client.ts
@@ -0,0 +1,22 @@
+import { parseV3ApiError } from "@/modules/api/lib/v3-client";
+
+/**
+ * Client fetchers for the API key v3 routes. Every call throws a parsed `V3ApiError` on a non-2xx response,
+ * so the caller can surface the server's own message.
+ */
+
+const BASE_PATH = "/api/v3/api-keys";
+
+export type TRotatedApiKey = { id: string; key: string };
+
+/** Replaces the key's secret. The returned `key` is the only copy the server will ever give out. */
+export async function rotateApiKey(params: { apiKeyId: string }): Promise<TRotatedApiKey> {
+  const response = await fetch(`${BASE_PATH}/${encodeURIComponent(params.apiKeyId)}/rotate`, {
+    method: "POST",
+    cache: "no-store",
+  });
+  if (!response.ok) {
+    throw await parseV3ApiError(response);
+  }
+  return ((await response.json()) as { data: TRotatedApiKey }).data;
+}
