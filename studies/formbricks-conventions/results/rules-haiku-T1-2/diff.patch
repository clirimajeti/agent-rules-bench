+/**
+ * POST /api/v3/api-keys/{apiKeyId}/rotate - replace an API key's secret, keeping its label and access.
+ *
+ * Session-only, matching the server actions this replaces. The new key is returned once, in the body.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { rotateV3ApiKey } from "../../lib/operations";
+import { ZV3ApiKeyIdParams } from "../../lib/schemas";
+
+export const POST = withV3ApiWrapper({
+  auth: "session",
+  action: "updated",
+  targetType: "apiKey",
+  schemas: { params: ZV3ApiKeyIdParams },
+  handler: async ({ authentication, parsedInput, auditLog, requestId, instance }) =>
+    rotateV3ApiKey({
+      authentication,
+      apiKeyId: parsedInput.params.apiKeyId,
+      auditLog,
+      requestId,
+      instance,
+    }),
+});
diff --git a/apps/web/app/api/v3/api-keys/lib/operations.ts b/apps/web/app/api/v3/api-keys/lib/operations.ts
new file mode 100644
index 000000000..f31c757c8
--- /dev/null
+++ b/apps/web/app/api/v3/api-keys/lib/operations.ts
@@ -0,0 +1,56 @@
+import "server-only";
+import { getV3SessionUserId } from "@/app/api/v3/lib/auth";
+import { problemForbidden, problemUnauthorized, successResponse } from "@/app/api/v3/lib/response";
+import type { TV3AuditLog, TV3Authentication } from "@/app/api/v3/lib/types";
+import { assertCan } from "@/lib/authorization";
+import { getApiKeyForRotation, rotateApiKey } from "@/modules/organization/settings/api-keys/lib/api-key";
+import { assertCanGrantOrganizationAccess } from "@/modules/organization/settings/api-keys/lib/organization-access";
+
+type TBaseParams = {
+  authentication: TV3Authentication;
+  requestId: string;
+  instance?: string;
+};
+
+/**
+ * Rotates the secret of an API key. The key is looked up before anything is written, and an unknown id
+ * answers 403 rather than 404, so key ids cannot be probed for existence.
+ *
+ * Authorization matches the server actions this replaces: `apiKey.manage` on the key, plus the
+ * user-management floor when the key carries organization write access. Both are checked against the
+ * key's stored access, because rotation keeps that access rather than choosing a new one.
+ *
+ * The response carries the new secret and is served `no-store`. The audit entry records the key id only.
+ */
+export async function rotateV3ApiKey(
+  params: TBaseParams & { apiKeyId: string; auditLog?: TV3AuditLog }
+): Promise<Response> {
+  const { apiKeyId, auditLog, authentication, requestId, instance } = params;
+
+  const userId = getV3SessionUserId(authentication);
+  if (!userId) {
+    return problemUnauthorized(requestId, "Session required", instance);
+  }
+
+  const apiKey = await getApiKeyForRotation(apiKeyId);
+  if (!apiKey) {
+    return problemForbidden(requestId, "You are not authorized to access this resource", instance);
+  }
+
+  await assertCan({ type: "user", id: userId }, "apiKey.manage", { type: "apiKey", id: apiKeyId });
+  await assertCanGrantOrganizationAccess(userId, apiKey.organizationId, apiKey.organizationAccess);
+
+  if (auditLog) {
+    auditLog.organizationId = apiKey.organizationId;
+    auditLog.targetId = apiKeyId;
+    auditLog.oldObject = { id: apiKey.id, label: apiKey.label };
+  }
+
+  const rotated = await rotateApiKey(apiKeyId);
+
+  if (auditLog) {
+    auditLog.newObject = { id: rotated.id, label: apiKey.label };
+  }
+
+  return successResponse({ id: rotated.id, key: rotated.actualKey }, { requestId });
+}
