index 000000000..0685d26d0
--- /dev/null
+++ b/docs/api-v3-reference/src/paths/api_v3_api-keys_{apiKeyId}_rotate.yml
@@ -0,0 +1,63 @@
+post:
+  operationId: rotateApiKeyV3
+  # Session-only by design, so an API-key caller reading the published reference would only ever get a
+  # 401. Excluded from the generated docs pages until ENG-2533 decides between dropping the paths
+  # and opening them to API keys; the operation stays in the bundle for the contract tests.
+  x-excluded: true
+  summary: Rotate an API key
+  description: |
+    Replaces the key's secret with a new one. The key keeps its id, label, organization access and
+    workspace permissions. The previous secret stops working as soon as the rotation completes.
+
+    The new secret is returned once, in `data.key`, and cannot be read again. It is served with
+    `Cache-Control: private, no-store`.
+
+    Requires the permission to manage the key. A key with organization write access can only be rotated by
+    a user who may grant that access, the same check creating such a key makes.
+
+    An unknown `apiKeyId` answers `403`, not `404`, so key ids cannot be probed for existence.
+  tags:
+    - V3 API Keys
+  parameters:
+    - in: path
+      name: apiKeyId
+      required: true
+      schema:
+        type: string
+        format: cuid2
+      description: The API key to rotate.
+  responses:
+    "200":
+      description: API key rotated. The new secret is in `data.key`.
+      content:
+        application/json:
+          schema:
+            type: object
+            required:
+              - data
+            properties:
+              data:
+                type: object
+                required:
+                  - id
+                  - key
+                properties:
+                  id:
+                    type: string
+                    format: cuid2
+                    description: The rotated API key's id, unchanged by the rotation.
+                  key:
+                    type: string
+                    description: The new secret in the `fbk_` format. Shown once; store it now.
+    "400":
+      $ref: ../components/responses/V3BadRequest.yml
+    "401":
+      $ref: ../components/responses/V3UnauthorizedSession.yml
+    "403":
+      $ref: ../components/responses/V3Forbidden.yml
+    "429":
+      $ref: ../components/responses/V3TooManyRequests.yml
+    "500":
+      $ref: ../components/responses/V3InternalServerError.yml
+  security:
+    - sessionAuth: []
