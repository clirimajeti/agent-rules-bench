+import { GoBackButton } from "@/modules/ui/components/go-back-button";
+import { PageContentWrapper } from "@/modules/ui/components/page-content-wrapper";
+import { PageHeader } from "@/modules/ui/components/page-header";
+import { getWorkspaceAuth } from "@/modules/workspaces/lib/utils";
+import { Webhook } from "@formbricks/database/prisma-browser";
+import { TSurvey } from "@formbricks/types/surveys/types";
+import { DANGEROUSLY_ALLOW_WEBHOOK_INTERNAL_URLS } from "@/lib/constants";
 
 export const generateMetadata = () => getSettingsPageMetadata("common.webhooks");
 
 export default WebhooksPage;
+
+import { getSettingsPageMetadata } from "@/modules/settings/lib/metadata";
+
+interface WebhooksPageClientProps {
+  workspaceId: string;
+  initialWebhooks: Webhook[];
+  surveys: TSurvey[];
+  isReadOnly: boolean;
+  allowInternalUrls: boolean;
+  surveyVisibilityEnabled: boolean;
+}
+
+const WebhooksPageClient = ({
+  workspaceId,
+  initialWebhooks,
+  surveys,
+  isReadOnly,
+  allowInternalUrls,
+  surveyVisibilityEnabled,
+}: Readonly<WebhooksPageClientProps>) => {
+  const router = useRouter();
+  const [webhooks, setWebhooks] = useState<Webhook[]>(initialWebhooks);
+
+  const handleDuplicate = async (webhookId: string) => {
+    const result = await duplicateWebhookAction({ webhookId, workspaceId });
+    if (result?.data) {
+      setWebhooks((prev) => [result.data as Webhook, ...prev]);
+      router.refresh();
+    } else {
+      toast.error("Failed to duplicate webhook");
+    }
+  };
+
+  const renderAddWebhookButton = () => (
+    <AddWebhookButton
+      workspaceId={workspaceId}
+      surveys={surveys}
+      allowInternalUrls={allowInternalUrls}
+      surveyVisibilityEnabled={surveyVisibilityEnabled}
+    />
+  );
+
+  return (
+    <PageContentWrapper>
+      <GoBackButton />
+      <PageHeader pageTitle="Webhooks" cta={!isReadOnly ? renderAddWebhookButton() : <></>} />
+      <WebhookTable
+        workspaceId={workspaceId}
+        webhooks={webhooks}
+        surveys={surveys}
+        isReadOnly={isReadOnly}
+        allowInternalUrls={allowInternalUrls}
+        surveyVisibilityEnabled={surveyVisibilityEnabled}>
+        <WebhookTableHeading />
+        {webhooks.map((webhook) => (
+          <WebhookRowData
+            key={webhook.id}
+            webhook={webhook}
+            surveys={surveys}
+            surveyVisibilityEnabled={surveyVisibilityEnabled}
+            isReadOnly={isReadOnly}
+            onDuplicate={() => handleDuplicate(webhook.id)}
+          />
+        ))}
+      </WebhookTable>
+    </PageContentWrapper>
+  );
+};
+
+const WebhooksPage = async (props: Readonly<{ params: Promise<{ workspaceId: string }> }>) => {
+  const params = await props.params;
+  const t = await getTranslate();
+
+  const { isReadOnly, organization, session, workspace } = await getWorkspaceAuth(params.workspaceId);
+
+  const [webhooks, surveys, surveyVisibilityEnabled] = await Promise.all([
+    getWebhooks(workspace.id),
+    getWebhookSurveys(workspace.id, session.user.id, organization.id),
+    isSurveyVisibilityEnforced(),
+  ]);
+
+  return (
+    <WebhooksPageClient
+      workspaceId={workspace.id}
+      initialWebhooks={webhooks}
+      surveys={surveys}
+      isReadOnly={isReadOnly}
+      allowInternalUrls={DANGEROUSLY_ALLOW_WEBHOOK_INTERNAL_URLS}
+      surveyVisibilityEnabled={surveyVisibilityEnabled}
+    />
+  );
+};
