index 000000000..73370241d
--- /dev/null
+++ b/apps/web/app/api/v3/user/data-export/route.ts
@@ -0,0 +1,27 @@
+/**
+ * GET /api/v3/user/data-export - the signed-in user's own personal data (name, email, locale,
+ * notification settings, organization memberships).
+ *
+ * Session-only, deliberately: the data is the caller's own, so an API key has no user to export.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { getV3SessionUserId } from "@/app/api/v3/lib/auth";
+import { problemInternalError, problemUnauthorized, successResponse } from "@/app/api/v3/lib/response";
+import { getUserDataExport } from "./lib/export";
+
+export const GET = withV3ApiWrapper({
+  auth: "session",
+  handler: async ({ authentication, requestId, instance }) => {
+    const userId = getV3SessionUserId(authentication);
+    if (!userId) {
+      return problemUnauthorized(requestId, "Session required", instance);
+    }
+
+    const data = await getUserDataExport(userId);
+    if (!data) {
+      return problemInternalError(requestId, "Unable to export user data", instance);
+    }
+
+    return successResponse(data, { requestId });
+  },
+});
