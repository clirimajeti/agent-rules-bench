+"use client";
+
+import { QueryClient, QueryClientProvider, useMutation } from "@tanstack/react-query";
+import { DownloadIcon } from "lucide-react";
+import { useState } from "react";
+import toast from "react-hot-toast";
+import { useTranslation } from "react-i18next";
+import { getUserDataExport } from "@/app/(app)/workspaces/[workspaceId]/settings/account/profile/lib/data-export-client";
+import { saveBlobAsFile } from "@/modules/ee/data-retention/lib/file-download";
+import { getV3ApiErrorMessage } from "@/modules/api/lib/v3-client";
+import { Button } from "@/modules/ui/components/button";
+
+const DOWNLOAD_FILE_NAME = "my-formbricks-data.json";
+
+const DownloadMyDataButton = () => {
+  const { t } = useTranslation();
+
+  const { mutate, isPending } = useMutation({
+    mutationFn: async () => {
+      const data = await getUserDataExport();
+      saveBlobAsFile(new Blob([JSON.stringify(data, null, 2)], { type: "application/json" }), DOWNLOAD_FILE_NAME);
+    },
+    onError: (error) => {
+      toast.error(getV3ApiErrorMessage(error, t("common.something_went_wrong_please_try_again")));
+    },
+  });
+
+  return (
+    <Button variant="secondary" size="sm" onClick={() => mutate()} loading={isPending}>
+      <DownloadIcon className="h-4 w-4" />
+      {t("workspace.settings.profile.download_my_data")}
+    </Button>
+  );
+};
+
+export const DownloadMyData = () => {
+  const [queryClient] = useState(() => new QueryClient());
+
+  return (
+    <QueryClientProvider client={queryClient}>
+      <DownloadMyDataButton />
+    </QueryClientProvider>
+  );
+};
