+import type { TV3UserDataExport } from "@/app/api/v3/user/data-export/lib/export";
+import { parseV3ApiError } from "@/modules/api/lib/v3-client";
+
+/** Fetch the signed-in user's personal data. Throws a parsed `V3ApiError` on a non-2xx response. */
+export async function getUserDataExport(): Promise<TV3UserDataExport> {
+  const response = await fetch("/api/v3/user/data-export", { method: "GET", cache: "no-store" });
+  if (!response.ok) {
+    throw await parseV3ApiError(response);
+  }
+  return ((await response.json()) as { data: TV3UserDataExport }).data;
+}
