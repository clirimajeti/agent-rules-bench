+import "server-only";
+import { prisma } from "@formbricks/database";
+import type { TUserNotificationSettings } from "@formbricks/types/user";
+
+/** Upper bound on memberships read, so a pathological account cannot make this an unbounded query. */
+const MAX_EXPORTED_MEMBERSHIPS = 1000;
+
+export type TV3UserDataExport = {
+  name: string;
+  email: string;
+  locale: string;
+  notificationSettings: TUserNotificationSettings;
+  organizations: { name: string; role: string }[];
+};
+
+/**
+ * The personal data a user can download about themselves. Scoped by the caller's own user id, never by
+ * client input, and limited to accepted memberships (a pending invite is not a membership yet).
+ * The two reads are independent, so they run in parallel.
+ */
+export const getUserDataExport = async (userId: string): Promise<TV3UserDataExport | null> => {
+  const [user, memberships] = await Promise.all([
+    prisma.user.findUnique({
+      where: { id: userId },
+      select: { name: true, email: true, locale: true, notificationSettings: true },
+    }),
+    prisma.membership.findMany({
+      where: { userId, accepted: true },
+      select: { role: true, organization: { select: { name: true } } },
+      orderBy: { organizationId: "asc" },
+      take: MAX_EXPORTED_MEMBERSHIPS,
+    }),
+  ]);
+
+  if (!user) return null;
+
+  return {
+    name: user.name,
+    email: user.email,
+    locale: user.locale,
+    notificationSettings: user.notificationSettings as TUserNotificationSettings,
+    organizations: memberships.map((membership) => ({
+      name: membership.organization.name,
+      role: membership.role,
+    })),
+  };
+};
diff --git a/apps/web/app/api/v3/user/data-export/route.ts b/apps/web/app/api/v3/user/data-export/route.ts
