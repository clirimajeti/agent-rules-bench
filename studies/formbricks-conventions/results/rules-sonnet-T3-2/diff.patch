+import { TUser } from "@formbricks/types/user";
+import { getTranslate } from "@/lingodotdev/server";
+import { formatDateTimeForDisplay } from "@/lib/utils/datetime";
+import { DownloadMyData } from "./DownloadMyData";
+
+interface AccountActivityProps {
+  user: Pick<TUser, "createdAt" | "lastLoginAt" | "locale">;
+}
+
+export const AccountActivity = async ({ user }: Readonly<AccountActivityProps>) => {
+  const t = await getTranslate();
+
+  return (
+    <div className="space-y-4">
+      <dl className="grid grid-cols-1 gap-4 text-sm sm:grid-cols-2">
+        <div>
+          <dt className="font-medium text-slate-700">{t("workspace.settings.profile.account_created")}</dt>
+          <dd className="text-slate-600">{formatDateTimeForDisplay(user.createdAt, user.locale)}</dd>
+        </div>
+        <div>
+          <dt className="font-medium text-slate-700">{t("workspace.settings.profile.last_login")}</dt>
+          <dd className="text-slate-600">
+            {user.lastLoginAt
+              ? formatDateTimeForDisplay(user.lastLoginAt, user.locale)
+              : t("workspace.settings.profile.last_login_unknown")}
+          </dd>
+        </div>
+      </dl>
+      <div>
+        <p className="mb-2 text-sm text-slate-600">{t("workspace.settings.profile.download_my_data_description")}</p>
+        <DownloadMyData />
+      </div>
+    </div>
+  );
+};
