+/**
+ * Deletes every tag in the workspace that no response carries. The `responses: { none: {} }` filter is
+ * evaluated by the database against all responses, not the caller's visible subset: a tag used only on
+ * a response the caller cannot read is still in use, and deleting it would strip that response's link.
+ */
+export const deleteUnusedTags = async (
+  workspaceId: string
+): Promise<Result<{ count: number }, { code: TagError; message: string }>> => {
+  validateInputs([workspaceId, ZId]);
+
+  try {
+    const { count } = await prisma.tag.deleteMany({
+      where: {
+        workspaceId,
+        responses: { none: {} },
+      },
+    });
+
+    return ok({ count });
+  } catch (error) {
+    return err({
+      code: TagError.UNEXPECTED_ERROR,
+      message: error instanceof Error ? error.message : "Unknown error occurred",
+    });
+  }
+};
