@@ -0,0 +1,55 @@
+"use client";
+
+import { useTransition } from "react";
+import { useTranslation } from "react-i18next";
+import { Loader2 } from "lucide-react";
+import { Badge } from "@/modules/ui/components/badge";
+import { Button } from "@/modules/ui/components/button";
+import { Small } from "@/modules/ui/components/typography";
+
+const DOWNLOAD_ROUTE = "/api/v3/account/download";
+
+export const DownloadMyData = () => {
+  const { t } = useTranslation();
+  const [isPending, startTransition] = useTransition();
+
+  const handleDownload = () => {
+    startTransition(async () => {
+      const response = await fetch(DOWNLOAD_ROUTE, { method: "GET" });
+      if (response.ok) {
+        const blob = await response.blob();
+        const url = URL.createObjectURL(blob);
+        const a = document.createElement("a");
+        a.href = url;
+        a.download = "formbricks-account-data.json";
+        document.body.appendChild(a);
+        a.click();
+        document.body.removeChild(a);
+        URL.revokeObjectURL(url);
+      }
+    });
+  };
+
+  return (
+    <div className="flex flex-col gap-4">
+      <div className="flex items-center gap-x-4">
+        <div className="flex flex-col">
+          <Small color="muted">{t("workspace.settings.profile.download_my_data_description")}</Small>
+          <div className="mt-2 flex items-center gap-x-2">
+            <Badge size="normal" type="warning" text="Beta" />
+          </div>
+        </div>
+      </div>
+      <Button onClick={handleDownload} disabled={isPending} variant="secondary">
+        {isPending ? (
+          <>
+            <Loader2 className="h-4 w-4 animate-spin" />
+            {t("workspace.settings.profile.download_my_data_button")}
+          </>
+        ) : (
+          t("workspace.settings.profile.download_my_data_button")
+        )}
+      </Button>
+    </div>
+  );
+};
