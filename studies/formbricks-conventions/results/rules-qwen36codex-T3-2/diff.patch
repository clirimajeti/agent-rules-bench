+"use client";
+
+import { useTranslation } from "react-i18next";
+import { formatDateForDisplay } from "@/lib/utils/datetime";
+import { Small } from "@/modules/ui/components/typography";
+
+interface AccountActivityProps {
+  createdAt: Date | null;
+  lastLoginAt: Date | null;
+  locale: string | null;
+}
+
+const DATE_DISPLAY_OPTIONS: Intl.DateTimeFormatOptions = {
+  year: "numeric",
+  month: "short",
+  day: "numeric",
+};
+
+export const AccountActivity = ({ createdAt, lastLoginAt, locale }: Readonly<AccountActivityProps>) => {
+  const { t } = useTranslation();
+
+  const displayLocale = locale ?? "en-US";
+
+  const formatDate = (date: Date | null): string => {
+    if (!date) return t("common.unknown");
+    return formatDateForDisplay(new Date(date), displayLocale, DATE_DISPLAY_OPTIONS);
+  };
+
+  return (
+    <div className="flex flex-col gap-4">
+      <div className="flex items-center gap-x-4">
+        <div className="flex flex-col">
+          <Small color="muted">{t("workspace.settings.profile.account_created")}</Small>
+          <span className="text-sm text-slate-800">{formatDate(createdAt)}</span>
+        </div>
+      </div>
+      <div className="flex items-center gap-x-4">
+        <div className="flex flex-col">
+          <Small color="muted">{t("workspace.settings.profile.last_logged_in")}</Small>
+          <span className="text-sm text-slate-800">{formatDate(lastLoginAt)}</span>
+        </div>
+      </div>
+    </div>
+  );
+};
