+/**
+ * `POST /api/v3/tags/delete-unused` → 200 `{ data: { deleted } }`.
+ *
+ * Like the responses batch-delete, the scope is supplied rather than derived: there is no single tag to
+ * resolve it from. That is safe because the workspace authorized against and the workspace the delete is
+ * filtered by are the same value. Same permission as deleting one tag (`readWrite`).
+ *
+ * "Unused" is decided over every response, not the caller's visible ones; see `deleteUnusedTags`.
+ */
+export async function deleteUnusedV3Tags(
+  params: TBaseParams & { workspaceId: string; auditLog?: TV3AuditLog }
+): Promise<Response> {
+  const { authentication, workspaceId, auditLog, requestId, instance } = params;
+
+  const access = await requireV3WorkspaceAccess(authentication, workspaceId, "readWrite", requestId, instance);
+  if (access instanceof Response) return access;
+
+  const result = await deleteUnusedTags(access.workspaceId);
+  if (!result.ok) {
+    return problemInternalError(requestId, "Unable to delete unused tags", instance);
+  }
+
+  if (auditLog) {
+    auditLog.organizationId = access.organizationId;
+    auditLog.targetId = access.workspaceId;
+    // Identity only, like the responses batch-delete: the ids make the action reviewable without an
+    // unbounded blob of rows in one log entry.
+    auditLog.oldObject = {
+      workspaceId: access.workspaceId,
+      deleted: result.data.deleted,
+      tagIds: result.data.tagIds,
+    };
+  }
+
+  return successResponse({ deleted: result.data.deleted }, { requestId });
+}
