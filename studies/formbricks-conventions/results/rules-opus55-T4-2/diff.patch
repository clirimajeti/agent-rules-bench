+/**
+ * Delete every tag of a workspace that is not linked to any response.
+ *
+ * "Unused" means no `TagsOnResponses` row at all, deliberately not the caller's visibility-filtered count
+ * (ENG-3282): a tag that only appears on responses the caller cannot read shows a count of 0 in the list,
+ * but deleting it would strip it from those responses.
+ *
+ * The delete is bounded to the ids the lookup found, so a tag created after the user confirmed is never
+ * removed. The `responses: { none: {} }` guard is repeated on the delete itself, so a tag applied to a
+ * response between the two statements survives. `deleted` is what was actually removed and can be lower
+ * than `tagIds.length` in that case.
+ */
+export const deleteUnusedTags = async (
+  workspaceId: string
+): Promise<
+  Result<
+    { deleted: number; tagIds: string[] },
+    { code: TagError; message: string; meta?: Record<string, string> }
+  >
+> => {
+  validateInputs([workspaceId, ZId]);
+
+  try {
+    const candidates = await prisma.tag.findMany({
+      where: { workspaceId, responses: { none: {} } },
+      select: { id: true },
+    });
+    const tagIds = candidates.map((tag) => tag.id);
+
+    if (tagIds.length === 0) {
+      return ok({ deleted: 0, tagIds });
+    }
+
+    const { count } = await prisma.tag.deleteMany({
+      where: { id: { in: tagIds }, workspaceId, responses: { none: {} } },
+    });
+
+    return ok({ deleted: count, tagIds });
+  } catch (error) {
+    return err({
+      code: TagError.UNEXPECTED_ERROR,
+      message: error instanceof Error ? error.message : "Unknown error occurred",
+    });
+  }
+};
