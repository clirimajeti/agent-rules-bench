+/**
+ * Deletes every tag in the workspace that no response carries. The "unused" check is workspace-wide on
+ * purpose: a caller's survey-visibility scope must never decide which tags are safe to remove.
+ */
+export const deleteUnusedTags = async (
+  workspaceId: string
+): Promise<Result<{ count: number }, { code: TagError; message: string }>> => {
+  validateInputs([workspaceId, ZId]);
+
+  try {
+    const { count } = await prisma.tag.deleteMany({
+      where: {
+        workspaceId,
+        responses: { none: {} },
+      },
+    });
+
+    return ok({ count });
+  } catch (error) {
+    return err({
+      code: TagError.UNEXPECTED_ERROR,
+      message: error instanceof Error ? error.message : "Unknown error occurred",
+    });
+  }
+};
