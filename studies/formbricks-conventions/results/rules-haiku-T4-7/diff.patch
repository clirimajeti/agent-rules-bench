+/**
+ * DELETE /api/v3/tags/unused?workspaceId= - delete every tag in the workspace that no response carries.
+ *
+ * Session-only, matching the list and single-tag routes. The workspace comes from the query because there
+ * is no tag to resolve it from; the operation checks read-write access on that workspace.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { deleteUnusedV3Tags } from "../lib/operations";
+import { ZV3TagListQuery } from "../lib/schemas";
+
+export const DELETE = withV3ApiWrapper({
+  auth: "session",
+  action: "deleted",
+  targetType: "tag",
+  schemas: { query: ZV3TagListQuery },
+  handler: async ({ authentication, parsedInput, auditLog, requestId, instance }) =>
+    deleteUnusedV3Tags({
+      authentication,
+      workspaceId: parsedInput.query.workspaceId,
+      auditLog,
+      requestId,
+      instance,
+    }),
+});
