@@ -0,0 +1,54 @@
+delete:
+  operationId: deleteUnusedTagsV3
+  # Session-only by design, so an API-key caller reading the published reference would only ever get a
+  # 401. Excluded from the generated docs pages until ENG-2533 decides between dropping the paths
+  # and opening them to API keys; the operation stays in the bundle for the contract tests.
+  x-excluded: true
+  summary: Delete unused tags
+  description: |
+    Deletes every tag in the workspace that is not applied to any response, and returns how many were
+    deleted. Tags that are applied to at least one response are kept, including responses the caller
+    cannot read. Requires organization owner/manager, or a workspace team membership with read-write
+    permission.
+  tags:
+    - V3 Tags
+  parameters:
+    - in: query
+      name: workspaceId
+      required: true
+      schema:
+        type: string
+        format: cuid2
+      description: |
+        Workspace identifier. This is the canonical container ID for v3 APIs.
+  responses:
+    "200":
+      description: Unused tags deleted successfully
+      content:
+        application/json:
+          schema:
+            type: object
+            required:
+              - data
+            properties:
+              data:
+                type: object
+                required:
+                  - deletedCount
+                properties:
+                  deletedCount:
+                    type: integer
+                    minimum: 0
+                    description: Number of unused tags that were deleted. `0` when every tag is in use.
+    "400":
+      $ref: ../components/responses/V3BadRequest.yml
+    "401":
+      $ref: ../components/responses/V3UnauthorizedSession.yml
+    "403":
+      $ref: ../components/responses/V3Forbidden.yml
+    "429":
+      $ref: ../components/responses/V3TooManyRequests.yml
+    "500":
+      $ref: ../components/responses/V3InternalServerError.yml
+  security:
+    - sessionAuth: []
