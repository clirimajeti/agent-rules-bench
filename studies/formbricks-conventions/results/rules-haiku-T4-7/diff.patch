+"use client";
+
+import { useState } from "react";
+import { toast } from "react-hot-toast";
+import { useTranslation } from "react-i18next";
+import { getV3ApiErrorMessage } from "@/modules/api/lib/v3-client";
+import { Button } from "@/modules/ui/components/button";
+import { DeleteDialog } from "@/modules/ui/components/delete-dialog";
+import { useDeleteUnusedTags } from "@/modules/workspaces/settings/tags/hooks/use-delete-unused-tags";
+
+interface DeleteUnusedTagsButtonProps {
+  workspaceId: string;
+  disabled?: boolean;
+}
+
+/**
+ * Deletes every tag the workspace no response carries. The confirmation shows before the request, and the
+ * toast reports how many tags the server actually removed.
+ */
+export const DeleteUnusedTagsButton = ({ workspaceId, disabled }: Readonly<DeleteUnusedTagsButtonProps>) => {
+  const { t } = useTranslation();
+  const [openDialog, setOpenDialog] = useState(false);
+  const deleteUnusedTags = useDeleteUnusedTags(workspaceId);
+  const title = t("workspace.tags.delete_unused_tags");
+
+  const confirmDeleteUnusedTags = async () => {
+    try {
+      const { deletedCount } = await deleteUnusedTags.mutateAsync();
+      toast.success(t("workspace.tags.unused_tags_deleted", { deletedCount }));
+    } catch (error) {
+      toast.error(getV3ApiErrorMessage(error, t("common.something_went_wrong_please_try_again")));
+    } finally {
+      setOpenDialog(false);
+    }
+  };
+
+  return (
+    <>
+      <Button
+        variant="secondary"
+        size="sm"
+        disabled={disabled || deleteUnusedTags.isPending}
+        onClick={() => setOpenDialog(true)}>
+        {title}
+      </Button>
+      <DeleteDialog
+        open={openDialog}
+        setOpen={setOpenDialog}
+        deleteWhat={title}
+        title={title}
+        text={t("workspace.tags.delete_unused_tags_confirmation")}
+        onDelete={confirmDeleteUnusedTags}
+        isDeleting={deleteUnusedTags.isPending}
+      />
+    </>
+  );
+};
