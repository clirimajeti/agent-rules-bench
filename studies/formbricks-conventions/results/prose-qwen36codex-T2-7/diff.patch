diff --git a/apps/web/modules/integrations/webhooks/lib/v3-webhooks-client.ts b/apps/web/modules/integrations/webhooks/lib/v3-webhooks-client.ts
new file mode 100644
index 000000000..43ac94db5
--- /dev/null
+++ b/apps/web/modules/integrations/webhooks/lib/v3-webhooks-client.ts
@@ -0,0 +1,35 @@
+import { parseV3ApiError } from "@/modules/api/lib/v3-client";
+
+/**
+ * Client-facing webhook shape returned by v3 routes (no secret).
+ */
+export type TV3Webhook = {
+  id: string;
+  name: string | null;
+  url: string;
+  source: string;
+  workspaceId: string;
+  triggers: string[];
+  surveyIds: string[];
+  createdAt: string;
+  updatedAt: string;
+};
+
+/**
+ * Duplicate an existing webhook via the v3 API.
+ *
+ * Called from client components; the caller handles refresh/invalidation.
+ */
+export const duplicateWebhook = async (webhookId: string): Promise<TV3Webhook> => {
+  const response = await fetch(`/api/v3/webhooks/${webhookId}/duplicate`, {
+    method: "POST",
+    cache: "no-store",
+  });
+
+  if (!response.ok) {
+    throw await parseV3ApiError(response);
+  }
+
+  const body = (await response.json()) as { data: TV3Webhook };
+  return body.data;
+};
