@@ -0,0 +1,30 @@
+import type { Webhook } from "@formbricks/database/prisma-browser";
+
+/**
+ * Public v3 webhook shape. Excludes `secret` — it is only returned on create.
+ */
+export type TV3WebhookResource = {
+  id: string;
+  name: string | null;
+  url: string;
+  source: string;
+  workspaceId: string;
+  triggers: string[];
+  surveyIds: string[];
+  createdAt: string;
+  updatedAt: string;
+};
+
+export function serializeV3Webhook(webhook: Webhook): TV3WebhookResource {
+  return {
+    id: webhook.id,
+    name: webhook.name,
+    url: webhook.url,
+    source: webhook.source,
+    workspaceId: webhook.workspaceId,
+    triggers: webhook.triggers,
+    surveyIds: webhook.surveyIds,
+    createdAt: webhook.createdAt.toISOString(),
+    updatedAt: webhook.updatedAt.toISOString(),
+  };
+}
