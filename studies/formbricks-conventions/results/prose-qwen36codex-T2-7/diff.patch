@@ -0,0 +1,72 @@
+import "server-only";
+import { logger } from "@formbricks/logger";
+import { ResourceNotFoundError } from "@formbricks/types/errors";
+import { getOrganizationIdFromWebhookId, getWorkspaceIdFromWebhookId } from "@/lib/utils/helper";
+import { getWebhook } from "@/modules/api/v2/management/webhooks/[webhookId]/lib/webhook";
+import { applyRateLimit } from "@/modules/core/rate-limit/helpers";
+import { rateLimitConfigs } from "@/modules/core/rate-limit/rate-limit-configs";
+import { createWebhook } from "@/modules/integrations/webhooks/lib/webhook";
+import { createdResponse, problemNotFound } from "@/app/api/v3/lib/response";
+import type { TV3Authentication, TV3AuditLog } from "@/app/api/v3/lib/types";
+import { requireV3WorkspaceAccess } from "@/app/api/v3/lib/auth";
+import { serializeV3Webhook } from "../../serializers";
+
+export async function duplicateWebhook({
+  webhookId,
+  authentication,
+  auditLog,
+  requestId,
+  instance,
+}: {
+  webhookId: string;
+  authentication: TV3Authentication;
+  auditLog?: TV3AuditLog;
+  requestId: string;
+  instance?: string;
+}): Promise<Response> {
+  const log = logger.withContext({ requestId, webhookId });
+
+  const existingResult = await getWebhook(webhookId);
+  if (!existingResult.ok || !existingResult.data) {
+    return problemNotFound(requestId, "Webhook", webhookId, instance);
+  }
+
+  const existing = existingResult.data;
+  const organizationId = await getOrganizationIdFromWebhookId(webhookId);
+  const workspaceId = await getWorkspaceIdFromWebhookId(webhookId);
+
+  const access = await requireV3WorkspaceAccess(
+    authentication,
+    workspaceId,
+    "write",
+    requestId,
+    instance
+  );
+
+  if (access instanceof Response) {
+    return access;
+  }
+
+  await applyRateLimit(rateLimitConfigs.actions.stateMutation, workspaceId);
+
+  const newWebhook = await createWebhook(workspaceId, {
+    name: `Copy of ${existing.name ?? ""}`,
+    url: existing.url,
+    source: "user" as const,
+    triggers: existing.triggers,
+    surveyIds: existing.surveyIds,
+  });
+
+  if (auditLog) {
+    auditLog.targetId = newWebhook.id;
+    auditLog.organizationId = organizationId;
+    auditLog.newObject = { ...newWebhook };
+  }
+
+  const resource = serializeV3Webhook(newWebhook);
+
+  return createdResponse(resource, {
+    location: `/api/v3/webhooks/${newWebhook.id}`,
+    requestId,
+  });
+}
