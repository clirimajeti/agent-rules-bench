@@ -0,0 +1,25 @@
+/**
+ * POST /api/v3/webhooks/{webhookId}/duplicate — create a copy of an existing webhook.
+ *
+ * Server-only operation: resolves workspace access from the existing webhook, authorizes the caller,
+ * and delegates to the service layer. Returns the new webhook as the success `data`.
+ */
+import { z } from "zod";
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { ZV3EmptyQuery } from "@/app/api/v3/lib/schemas";
+import { duplicateWebhook } from "./lib/operations";
+
+export const POST = withV3ApiWrapper({
+  auth: "both",
+  action: "created",
+  targetType: "webhook",
+  schemas: { params: z.object({ webhookId: z.string().cuid2() }), query: ZV3EmptyQuery },
+  handler: async ({ parsedInput, authentication, auditLog, requestId, instance }) =>
+    duplicateWebhook({
+      webhookId: parsedInput.params.webhookId,
+      authentication,
+      auditLog,
+      requestId,
+      instance,
+    }),
+});
