+import { z } from "zod";
+import { ZWebhook } from "@formbricks/database/zod/webhooks";
+
+/**
+ * Path parameters for webhook sub-resource routes.
+ */
+export const ZV3WebhookIdParams = z.strictObject({
+  webhookId: z.string().min(1),
+});
+
+export type TV3WebhookIdParams = z.infer<typeof ZV3WebhookIdParams>;
+
+/**
+ * `POST /api/v3/webhooks/{webhookId}/duplicate`.
+ *
+ * Optional `name` overrides the "Copy of …" default; the URL, triggers and surveyIds are always
+ * copied from the source webhook.
+ */
+export const ZV3DuplicateWebhookBody = z.strictObject({
+  name: ZWebhook.shape.name.optional(),
+}).optional()
+  .or(z.literal(null))
+  .or(z.literal(undefined))
+  .transform((val) => val ?? {});
+
+export type TV3DuplicateWebhookBody = z.infer<typeof ZV3DuplicateWebhookBody>;
