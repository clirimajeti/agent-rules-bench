@@ -0,0 +1,129 @@
+import "server-only";
+import { prisma } from "@formbricks/database";
+import { Webhook } from "@formbricks/database/prisma";
+import { ResourceNotFoundError } from "@formbricks/types/errors";
+import { requireV3WorkspaceAccess } from "@/app/api/v3/lib/auth";
+import {
+  successResponse,
+  problemForbidden,
+  problemUnprocessableContent,
+} from "@/app/api/v3/lib/response";
+import type { TV3Authentication } from "@/app/api/v3/lib/types";
+import { assertCan } from "@/lib/authorization";
+import { generateWebhookSecret } from "@/lib/crypto";
+import { capturePostHogEvent } from "@/lib/posthog";
+import { assertNewlyAttachedSurveysWorkspaceVisible } from "@/lib/survey/visibility/outbound";
+import { getOrganizationIdFromWebhookId } from "@/lib/utils/helper";
+import { validateWebhookUrl } from "@/lib/utils/validate-webhook-url";
+import { applyRateLimit } from "@/modules/core/rate-limit/helpers";
+import { rateLimitConfigs } from "@/modules/core/rate-limit/rate-limit-configs";
+import type { TAuditAction, TAuditTarget } from "@/modules/ee/audit-logs/types/audit-log";
+import { buildV3AuditLog } from "@/app/api/v3/lib/audit";
+import type { TV3DuplicateWebhookBody } from "./schemas";
+
+/**
+ * `POST /api/v3/webhooks/{webhookId}/duplicate`.
+ *
+ * Duplicates a webhook within the same workspace. Authorization is checked against the source
+ * webhook's workspace (resolved from the path), and the new webhook is scoped to that workspace.
+ */
+export async function duplicateV3Webhook({
+  webhookId,
+  authentication,
+  requestBody,
+  requestId,
+  instance,
+  auditLog,
+}: {
+  webhookId: string;
+  authentication: TV3Authentication;
+  requestBody: TV3DuplicateWebhookBody;
+  requestId: string;
+  instance?: string;
+  auditLog?: ReturnType<typeof buildV3AuditLog>;
+}): Promise<Response> {
+  // 1. Read the source webhook (unscoped — we'll scope below).
+  const sourceWebhook = await prisma.webhook.findUnique({
+    where: { id: webhookId },
+    omit: { secret: true },
+  });
+
+  if (!sourceWebhook) {
+    return problemForbidden(requestId, undefined, instance);
+  }
+
+  const workspaceId = sourceWebhook.workspaceId;
+
+  // 2. Authorize against the workspace.
+  const access = await requireV3WorkspaceAccess(
+    authentication,
+    workspaceId,
+    "readWrite",
+    requestId,
+    instance
+  );
+
+  if (access instanceof Response) {
+    return access;
+  }
+
+  // 3. Session-user authorization check (same as the old action).
+  await assertCan({ type: "user", id: authentication.userId }, "workspace.write", {
+    type: "workspace",
+    id: workspaceId,
+  });
+
+  // 4. Rate limit.
+  await applyRateLimit(rateLimitConfigs.actions.stateMutation, workspaceId);
+
+  // 5. Validate attached surveys are visible.
+  await assertNewlyAttachedSurveysWorkspaceVisible(sourceWebhook.surveyIds ?? []);
+
+  // 6. Validate URL.
+  try {
+    await validateWebhookUrl(sourceWebhook.url);
+  } catch (error) {
+    if (error instanceof Error && error.message) {
+      return problemUnprocessableContent(requestId, "Webhook URL validation failed", {
+        invalid_params: [{ field: "url", issue: error.message }],
+        instance,
+      });
+    }
+    throw error;
+  }
+
+  // 7. Create the duplicate.
+  const organizationId = await getOrganizationIdFromWebhookId(webhookId);
+  const newWebhook = await prisma.webhook.create({
+    data: {
+      name: requestBody.name ?? `Copy of ${sourceWebhook.name ?? "Webhook"}`,
+      url: sourceWebhook.url,
+      source: "user",
+      triggers: sourceWebhook.triggers,
+      surveyIds: sourceWebhook.surveyIds,
+      secret: generateWebhookSecret(),
+      workspace: { connect: { id: workspaceId } },
+    },
+  });
+
+  // 8. Audit logging.
+  if (auditLog) {
+    auditLog.targetId = newWebhook.id;
+    auditLog.organizationId = organizationId;
+    auditLog.newObject = newWebhook;
+  }
+
+  // 9. PostHog event.
+  capturePostHogEvent(
+    authentication.userId,
+    "integration_connected",
+    {
+      integration_type: "webhook",
+      organization_id: organizationId,
+      workspace_id: workspaceId,
+    },
+    { organizationId, workspaceId }
+  );
+
+  return successResponse(newWebhook, { requestId, cache: "private, no-store" });
+}
