@@ -0,0 +1,28 @@
+import type { Webhook } from "@formbricks/database/prisma-browser";
+import { parseV3ApiError } from "@/modules/api/lib/v3-client";
+
+const JSON_HEADERS = { "Content-Type": "application/json" };
+
+/**
+ * `POST /api/v3/webhooks/{webhookId}/duplicate`.
+ *
+ * Mirrors the old `duplicateWebhookAction` contract: returns the created webhook on success.
+ */
+export async function duplicateWebhook(
+  webhookId: string,
+  name?: string
+): Promise<Webhook> {
+  const response = await fetch(`/api/v3/webhooks/${webhookId}/duplicate`, {
+    method: "POST",
+    cache: "no-store",
+    headers: JSON_HEADERS,
+    body: JSON.stringify(name ? { name } : {}),
+  });
+
+  if (!response.ok) {
+    throw await parseV3ApiError(response);
+  }
+
+  const body = (await response.json()) as { data: Webhook };
+  return body.data;
+}
