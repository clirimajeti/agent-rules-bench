+/**
+ * POST /api/v3/webhooks/{webhookId}/duplicate — duplicate a webhook within its workspace.
+ *
+ * Mirrors the old `duplicateWebhookAction` server action: copies name (with "Copy of" prefix
+ * fallback), URL, triggers and surveyIds; generates a new secret; scopes to the source workspace.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { duplicateV3Webhook } from "./lib/operations";
+import { ZV3DuplicateWebhookBody, ZV3WebhookIdParams } from "./lib/schemas";
+
+export const POST = withV3ApiWrapper({
+  auth: "both",
+  action: "created",
+  targetType: "webhook",
+  schemas: {
+    params: ZV3WebhookIdParams,
+    body: ZV3DuplicateWebhookBody,
+    query: undefined,
+  },
+  handler: async ({ authentication, parsedInput, auditLog, requestId, instance }) =>
+    duplicateV3Webhook({
+      webhookId: parsedInput.params.webhookId,
+      authentication,
+      requestBody: parsedInput.body,
+      requestId,
+      instance,
+      auditLog,
+    }),
+});
