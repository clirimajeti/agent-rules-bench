+import { getTranslate } from "@/lingodotdev/server";
+import { formatDateForDisplay } from "@/lib/utils/datetime";
+
+// Rendered in UTC so the server and the browser produce the same text, and the label says so.
+const ACTIVITY_DATE_OPTIONS: Intl.DateTimeFormatOptions = {
+  year: "numeric",
+  month: "short",
+  day: "numeric",
+  hour: "2-digit",
+  minute: "2-digit",
+  timeZone: "UTC",
+  timeZoneName: "short",
+};
+
+interface AccountActivityProps {
+  createdAt: Date;
+  lastLoginAt: Date | null;
+  locale: string;
+}
+
+export const AccountActivity = async ({ createdAt, lastLoginAt, locale }: Readonly<AccountActivityProps>) => {
+  const t = await getTranslate();
+
+  return (
+    <dl className="grid grid-cols-[auto_1fr] gap-x-6 gap-y-2 text-sm">
+      <dt className="text-slate-500">{t("common.created_at")}</dt>
+      <dd className="text-slate-800">{formatDateForDisplay(createdAt, locale, ACTIVITY_DATE_OPTIONS)}</dd>
+
+      <dt className="text-slate-500">{t("workspace.settings.profile.last_login")}</dt>
+      <dd className="text-slate-800">
+        {lastLoginAt
+          ? formatDateForDisplay(lastLoginAt, locale, ACTIVITY_DATE_OPTIONS)
+          : t("common.no_sign_in_recorded")}
+      </dd>
+    </dl>
+  );
+};
