+/**
+ * The organizations a user has accepted a membership in, with the role held in each. Pending
+ * memberships are left out: the user has not joined those organizations yet.
+ */
+export const getAcceptedMembershipsWithOrganizationByUserId = async (userId: string) => {
+  validateInputs([userId, ZString]);
+
+  try {
+    return await prisma.membership.findMany({
+      where: {
+        userId,
+        accepted: true,
+      },
+      select: {
+        role: true,
+        organization: {
+          select: { name: true },
+        },
+      },
+      orderBy: {
+        organization: { name: "asc" },
+      },
+    });
+  } catch (error) {
+    if (error instanceof Prisma.PrismaClientKnownRequestError) {
+      logger.error(error, "Error getting accepted memberships by user id");
+      throw new DatabaseError(error.message);
+    }
+
+    throw error;
+  }
+};
