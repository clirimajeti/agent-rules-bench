@@ -0,0 +1,47 @@
+"use client";
+
+import { DownloadIcon } from "lucide-react";
+import { useTranslation } from "react-i18next";
+import { TMembership } from "@formbricks/types/memberships";
+import { TUserNotificationSettings } from "@formbricks/types/user";
+import { Button } from "@/modules/ui/components/button";
+
+// Machine-facing export: keys and enum values stay stable and are not localized.
+export interface TAccountData {
+  name: string;
+  email: string;
+  locale: string;
+  notificationSettings: TUserNotificationSettings;
+  organizationMemberships: {
+    organizationName: string;
+    role: TMembership["role"];
+  }[];
+}
+
+interface DownloadAccountDataButtonProps {
+  accountData: TAccountData;
+}
+
+export const DownloadAccountDataButton = ({ accountData }: Readonly<DownloadAccountDataButtonProps>) => {
+  const { t } = useTranslation();
+
+  const handleDownload = () => {
+    const json = JSON.stringify(accountData, null, 2);
+    const url = URL.createObjectURL(new Blob([json], { type: "application/json" }));
+    const link = document.createElement("a");
+    link.href = url;
+    link.download = `formbricks-account-data-${new Date().toISOString().slice(0, 10)}.json`;
+    document.body.appendChild(link);
+    link.click();
+    link.remove();
+    // Revoke after the browser has had a chance to start the download.
+    setTimeout(() => URL.revokeObjectURL(url), 0);
+  };
+
+  return (
+    <Button type="button" variant="secondary" size="sm" onClick={handleDownload}>
+      <DownloadIcon />
+      {t("workspace.settings.profile.download_my_data")}
+    </Button>
+  );
+};
