@@ -0,0 +1,36 @@
+"use client";
+
+import { useTranslation } from "react-i18next";
+
+interface AccountActivityProps {
+  createdAt: Date;
+  lastLoginAt: Date | null;
+}
+
+export const AccountActivity = ({ createdAt, lastLoginAt }: Readonly<AccountActivityProps>) => {
+  const { t } = useTranslation();
+
+  const formatDate = (date: Date | null) => {
+    if (!date) return t("common.not_available");
+    return new Intl.DateTimeFormat(undefined, {
+      dateStyle: "long",
+    }).format(new Date(date));
+  };
+
+  return (
+    <div className="space-y-3">
+      <div className="flex items-center justify-between">
+        <span className="text-sm text-slate-700">
+          {t("workspace.settings.profile.account_created")}
+        </span>
+        <span className="text-sm font-medium text-slate-900">{formatDate(createdAt)}</span>
+      </div>
+      <div className="flex items-center justify-between">
+        <span className="text-sm text-slate-700">
+          {t("workspace.settings.profile.last_login")}
+        </span>
+        <span className="text-sm font-medium text-slate-900">{formatDate(lastLoginAt)}</span>
+      </div>
+    </div>
+  );
+};
diff --git a/apps/web/app/(app)/workspaces/[workspaceId]/settings/account/profile/components/DownloadMyData.tsx b/apps/web/app/(app)/workspaces/[workspaceId]/settings/account/profile/components/DownloadMyData.tsx
new file mode 100644
index 000000000..4b79e8057
--- /dev/null
+++ b/apps/web/app/(app)/workspaces/[workspaceId]/settings/account/profile/components/DownloadMyData.tsx
@@ -0,0 +1,58 @@
+"use client";
+
+import { useTranslation } from "react-i18next";
+import { TUserNotificationSettings } from "@formbricks/types/user";
+import { Button } from "@/modules/ui/components/button";
+
+interface DownloadMyDataProps {
+  userName: string;
+  userEmail: string;
+  userLocale: string;
+  notificationSettings: TUserNotificationSettings;
+  organizationMemberships: { name: string; role: string }[];
+}
+
+export const DownloadMyData = ({
+  userName,
+  userEmail,
+  userLocale,
+  notificationSettings,
+  organizationMemberships,
+}: Readonly<DownloadMyDataProps>) => {
+  const { t } = useTranslation();
+
+  const handleDownload = () => {
+    const data = {
+      name: userName,
+      email: userEmail,
+      locale: userLocale,
+      notificationSettings,
+      organizationMemberships: organizationMemberships.map((org) => ({
+        organizationName: org.name,
+        role: org.role,
+      })),
+    };
+
+    const jsonString = JSON.stringify(data, null, 2);
+    const blob = new Blob([jsonString], { type: "application/json" });
+    const url = URL.createObjectURL(blob);
+    const a = document.createElement("a");
+    a.href = url;
+    a.download = "formbricks-account-data.json";
+    document.body.appendChild(a);
+    a.click();
+    document.body.removeChild(a);
+    URL.revokeObjectURL(url);
+  };
+
+  return (
+    <div>
+      <p className="text-sm text-slate-700">
+        {t("workspace.settings.profile.download_my_data_description")}
+      </p>
+      <Button className="mt-4" variant="secondary" size="sm" onClick={handleDownload}>
+        {t("workspace.settings.profile.download_my_data")}
+      </Button>
+    </div>
+  );
+};
