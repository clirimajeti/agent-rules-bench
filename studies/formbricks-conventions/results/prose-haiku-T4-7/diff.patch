+/**
+ * Deletes every tag of the workspace that no response carries.
+ *
+ * The "unused" test is a relation filter over all responses, deliberately not the visibility-scoped count
+ * the list shows (ENG-3282). A tag applied only to responses the caller cannot read is still in use, and
+ * deleting it would strip it from those responses.
+ */
+export const deleteUnusedTags = async (
+  workspaceId: string
+): Promise<Result<{ deletedCount: number }, { code: TagError; message: string }>> => {
+  validateInputs([workspaceId, ZId]);
+
+  try {
+    const { count } = await prisma.tag.deleteMany({
+      where: {
+        workspaceId,
+        responses: { none: {} },
+      },
+    });
+
+    return ok({ deletedCount: count });
+  } catch (error) {
+    return err({
+      code: TagError.UNEXPECTED_ERROR,
+      message: error instanceof Error ? error.message : "Unknown error occurred",
+    });
+  }
+};
