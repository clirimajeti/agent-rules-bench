+"use client";
+
+import { useTranslation } from "react-i18next";
+import { formatDateForDisplay } from "@/lib/utils/datetime";
+import { H4, Small } from "@/modules/ui/components/typography";
+
+interface AccountActivityProps {
+  createdAt: Date;
+  lastLoginAt: Date | null;
+  locale: string;
+}
+
+export const AccountActivity = ({ createdAt, lastLoginAt, locale }: Readonly<AccountActivityProps>) => {
+  const { t } = useTranslation();
+
+  const formatDate = (date: Date | null) => {
+    if (!date) return t("common.never");
+    return formatDateForDisplay(date, locale);
+  };
+
+  return (
+    <div className="space-y-3">
+      <div className="flex items-center justify-between">
+        <div>
+          <H4 className="font-medium tracking-normal">{t("workspace.settings.profile.account_created")}</H4>
+          <Small color="muted" margin="headerDescription">
+            {formatDate(createdAt)}
+          </Small>
+        </div>
+      </div>
+      <div className="flex items-center justify-between">
+        <div>
+          <H4 className="font-medium tracking-normal">{t("workspace.settings.profile.last_login")}</H4>
+          <Small color="muted" margin="headerDescription">
+            {formatDate(lastLoginAt)}
+          </Small>
+        </div>
+      </div>
+    </div>
+  );
+};
