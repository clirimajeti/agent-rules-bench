+/**
+ * POST /api/v3/webhooks/{webhookId}/duplicate - copy a webhook's URL, triggers and surveys into a new webhook.
+ * Session-only, matching the server action this replaces.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { duplicateV3Webhook } from "../../lib/operations";
+import { ZV3WebhookIdParams } from "../../lib/schemas";
+
+export const POST = withV3ApiWrapper({
+  auth: "session",
+  action: "created",
+  targetType: "webhook",
+  schemas: { params: ZV3WebhookIdParams },
+  handler: async ({ authentication, parsedInput, auditLog, requestId, instance }) =>
+    duplicateV3Webhook({
+      authentication,
+      webhookId: parsedInput.params.webhookId,
+      auditLog,
+      requestId,
+      instance,
+    }),
+});
diff --git a/apps/web/app/api/v3/webhooks/lib/operations.ts b/apps/web/app/api/v3/webhooks/lib/operations.ts
new file mode 100644
index 000000000..a091492d4
--- /dev/null
+++ b/apps/web/app/api/v3/webhooks/lib/operations.ts
@@ -0,0 +1,79 @@
+import "server-only";
+import { getV3AuthorizationActor, requireV3WorkspaceAccess } from "@/app/api/v3/lib/auth";
+import { problemForbidden, successResponse } from "@/app/api/v3/lib/response";
+import type { TV3AuditLog, TV3Authentication } from "@/app/api/v3/lib/types";
+import { capturePostHogEvent } from "@/lib/posthog";
+import { assertNewlyAttachedSurveysWorkspaceVisible } from "@/lib/survey/visibility/outbound";
+import { getWebhook } from "@/modules/api/v2/management/webhooks/[webhookId]/lib/webhook";
+import { applyRateLimit } from "@/modules/core/rate-limit/helpers";
+import { rateLimitConfigs } from "@/modules/core/rate-limit/rate-limit-configs";
+import { createWebhook } from "@/modules/integrations/webhooks/lib/webhook";
+import type { TWebhookInput } from "@/modules/integrations/webhooks/types/webhooks";
+
+type TBaseParams = {
+  authentication: TV3Authentication;
+  requestId: string;
+  instance?: string;
+};
+
+/**
+ * Creates a copy with the same URL, triggers and surveys. The copy gets its own signing secret, generated
+ * by `createWebhook`, so the original secret is never read here and nothing secret is returned to the client.
+ *
+ * The workspace is resolved from the source webhook, never from the request. An unknown webhook answers 403,
+ * not 404, so a signed-in user cannot probe webhook ids across the instance.
+ */
+export async function duplicateV3Webhook(
+  params: TBaseParams & { webhookId: string; auditLog?: TV3AuditLog }
+): Promise<Response> {
+  const { webhookId, auditLog, authentication, requestId, instance } = params;
+
+  const existing = await getWebhook(webhookId);
+  if (!existing.ok) {
+    return problemForbidden(requestId, "You are not authorized to access this resource", instance);
+  }
+
+  const access = await requireV3WorkspaceAccess(
+    authentication,
+    existing.data.workspaceId,
+    "readWrite",
+    requestId,
+    instance
+  );
+  if (access instanceof Response) return access;
+
+  await applyRateLimit(rateLimitConfigs.actions.stateMutation, access.workspaceId);
+
+  const webhookInput: TWebhookInput = {
+    name: `Copy of ${existing.data.name || existing.data.url}`,
+    url: existing.data.url,
+    source: "user",
+    triggers: existing.data.triggers,
+    surveyIds: existing.data.surveyIds,
+  };
+
+  await assertNewlyAttachedSurveysWorkspaceVisible(webhookInput.surveyIds ?? []);
+  const webhook = await createWebhook(access.workspaceId, webhookInput);
+
+  if (auditLog) {
+    auditLog.organizationId = access.organizationId;
+    auditLog.targetId = webhook.id;
+    auditLog.newObject = webhookInput;
+  }
+
+  const actor = getV3AuthorizationActor(authentication);
+  if (actor) {
+    capturePostHogEvent(
+      actor.id,
+      "integration_connected",
+      {
+        integration_type: "webhook",
+        organization_id: access.organizationId,
+        workspace_id: access.workspaceId,
+      },
+      { organizationId: access.organizationId, workspaceId: access.workspaceId }
+    );
+  }
+
+  return successResponse({ id: webhook.id }, { requestId, status: 201 });
+}
