diff --git a/apps/web/modules/integrations/webhooks/hooks/use-duplicate-webhook.ts b/apps/web/modules/integrations/webhooks/hooks/use-duplicate-webhook.ts
new file mode 100644
index 000000000..2f3a0bdba
--- /dev/null
+++ b/apps/web/modules/integrations/webhooks/hooks/use-duplicate-webhook.ts
@@ -0,0 +1,17 @@
+"use client";
+
+import { useMutation } from "@tanstack/react-query";
+import { useRouter } from "next/navigation";
+import { duplicateWebhook } from "../lib/api-client";
+
+/**
+ * Duplicate a webhook through the v3 route. The webhook list is rendered by the server page, so a
+ * successful copy refreshes the route to show the new row.
+ */
+export const useDuplicateWebhook = () => {
+  const router = useRouter();
+  return useMutation({
+    mutationFn: (variables: { webhookId: string }) => duplicateWebhook(variables),
+    onSuccess: () => router.refresh(),
+  });
+};
