+"use client";
+
+import { CopyIcon } from "lucide-react";
+import toast from "react-hot-toast";
+import { useTranslation } from "react-i18next";
+import { V3ApiError } from "@/modules/api/lib/v3-client";
+import { Button } from "@/modules/ui/components/button";
+import { useDuplicateWebhook } from "../hooks/use-duplicate-webhook";
+
+interface DuplicateWebhookButtonProps {
+  webhookId: string;
+}
+
+export const DuplicateWebhookButton = ({ webhookId }: Readonly<DuplicateWebhookButtonProps>) => {
+  const { t } = useTranslation();
+  const { mutate, isPending } = useDuplicateWebhook();
+
+  const handleDuplicate = () => {
+    mutate(
+      { webhookId },
+      {
+        onSuccess: () => {
+          toast.success(t("workspace.integrations.webhooks.webhook_duplicated_successfully"));
+        },
+        onError: (error) => {
+          toast.error(
+            error instanceof V3ApiError ? error.detail : t("common.something_went_wrong_please_try_again")
+          );
+        },
+      }
+    );
+  };
+
+  return (
+    <Button type="button" variant="secondary" size="sm" loading={isPending} onClick={handleDuplicate}>
+      <CopyIcon className="mr-2 size-4" />
+      {t("common.duplicate")}
+    </Button>
+  );
+};
