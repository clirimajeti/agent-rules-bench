+/**
+ * POST /api/v3/webhooks/{webhookId}/duplicate — duplicate an existing webhook.
+ *
+ * Copies the webhook's url, triggers, and surveyIds under a "Copy of …" name.
+ * Session cookie or x-api-key; scope by workspaceId in the body.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { ZV3EmptyQuery } from "@/app/api/v3/lib/schemas";
+import { duplicateV3Webhook } from "./lib/operations";
+import { ZV3DuplicateWebhookParams, ZV3DuplicateWebhookBody } from "./lib/schemas";
+
+export const POST = withV3ApiWrapper({
+  auth: "both",
+  action: "created",
+  targetType: "webhook",
+  schemas: {
+    params: ZV3DuplicateWebhookParams,
+    body: ZV3DuplicateWebhookBody,
+    // Duplicate is scoped by the body's workspaceId, not by query; reject stray query params.
+    query: ZV3EmptyQuery,
+  },
+  handler: async ({ parsedInput, authentication, auditLog, requestId }) => {
+    return await duplicateV3Webhook({
+      webhookId: parsedInput.params.webhookId,
+      body: parsedInput.body,
+      authentication,
+      auditLog,
+      requestId,
+    });
+  },
+});
