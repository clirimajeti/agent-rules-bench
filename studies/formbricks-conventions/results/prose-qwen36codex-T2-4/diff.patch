@@ -0,0 +1,90 @@
+import "server-only";
+import { z } from "zod";
+import { ResourceNotFoundError } from "@formbricks/types/errors";
+import { getOrganizationIdFromWebhookId, getWorkspaceIdFromWebhookId } from "@/lib/utils/helper";
+import { assertCan } from "@/lib/authorization";
+import { capturePostHogEvent } from "@/lib/posthog";
+import { getWebhook } from "@/modules/api/v2/management/webhooks/[webhookId]/lib/webhook";
+import { applyRateLimit } from "@/modules/core/rate-limit/helpers";
+import { rateLimitConfigs } from "@/modules/core/rate-limit/rate-limit-configs";
+import { createWebhook } from "@/modules/integrations/webhooks/lib/webhook";
+import type { TV3Authentication, TV3AuditLog } from "@/app/api/v3/lib/types";
+import { createdResponse, problemNotFound } from "@/app/api/v3/lib/response";
+import { requireV3WorkspaceAccess } from "@/app/api/v3/lib/auth";
+
+const ZDuplicateWebhookBody = z.object({
+  workspaceId: z.cuid2(),
+});
+export type TDuplicateWebhookBody = z.infer<typeof ZDuplicateWebhookBody>;
+
+export async function duplicateV3Webhook({
+  webhookId,
+  body,
+  authentication,
+  auditLog,
+  requestId,
+}: {
+  webhookId: string;
+  body: TDuplicateWebhookBody;
+  authentication: TV3Authentication;
+  auditLog?: TV3AuditLog;
+  requestId: string;
+}): Promise<Response> {
+  // Authenticate and authorize
+  const workspaceId = await requireV3WorkspaceAccess({ authentication, auditLog, requestId });
+
+  const organizationId = await getOrganizationIdFromWebhookId(webhookId);
+  const sourceWorkspaceId = await getWorkspaceIdFromWebhookId(webhookId);
+
+  await assertCan({ type: "user", id: authentication.user.id }, "workspace.write", {
+    type: "workspace",
+    id: sourceWorkspaceId,
+  });
+
+  await applyRateLimit(rateLimitConfigs.actions.stateMutation, sourceWorkspaceId);
+
+  // Fetch existing webhook
+  const existingResult = await getWebhook(webhookId);
+  if (!existingResult.ok) {
+    return problemNotFound("Webhook", webhookId);
+  }
+  const existing = existingResult.data;
+
+  // Validate triggers and surveyIds are arrays before destructuring
+  const triggers = Array.isArray(existing.triggers) ? existing.triggers : [];
+  const surveyIds = Array.isArray(existing.surveyIds) ? existing.surveyIds : [];
+
+  // Create the duplicate
+  const newName = `Copy of ${existing.name}`;
+
+  const webhook = await createWebhook(sourceWorkspaceId, {
+    name: newName,
+    url: existing.url,
+    source: "user" as const,
+    triggers,
+    surveyIds,
+  });
+
+  // Audit logging
+  if (auditLog) {
+    auditLog.organizationId = organizationId;
+    auditLog.newObject = { name: newName };
+  }
+
+  // PostHog event
+  capturePostHogEvent(
+    authentication.user.id,
+    "integration_connected",
+    {
+      integration_type: "webhook",
+      organization_id: organizationId,
+      workspace_id: sourceWorkspaceId,
+    },
+    { organizationId, workspaceId: sourceWorkspaceId }
+  );
+
+  return createdResponse(webhook, {
+    location: `/api/v3/webhooks/${webhook.id}`,
+    requestId,
+  });
+}
