+});
+export type TV3DuplicateWebhookParams = z.infer<typeof ZV3DuplicateWebhookParams>;
+
+/** Request body for the webhook duplicate endpoint. */
+export const ZV3DuplicateWebhookBody = z.object({
+  workspaceId: z.cuid2(),
+});
+export type TV3DuplicateWebhookBody = z.infer<typeof ZV3DuplicateWebhookBody>;
