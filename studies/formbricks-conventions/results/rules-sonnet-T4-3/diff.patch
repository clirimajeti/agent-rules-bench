+/**
+ * Deletes every tag of the workspace that no response carries, in one statement.
+ *
+ * "Unused" is judged against all responses, deliberately not through the survey-visibility clause that
+ * the list counts use: a tag that is only applied to a survey the caller cannot see shows a count of 0,
+ * but it is still in use and must survive.
+ */
+export const deleteUnusedTags = async (
+  workspaceId: string
+): Promise<Result<{ deletedCount: number }, { code: TagError; message: string }>> => {
+  validateInputs([workspaceId, ZId]);
+
+  try {
+    const { count } = await prisma.tag.deleteMany({
+      where: { workspaceId, responses: { none: {} } },
+    });
+
+    return ok({ deletedCount: count });
+  } catch (error) {
+    return err({
+      code: TagError.UNEXPECTED_ERROR,
+      message: error instanceof Error ? error.message : "Unknown error occurred",
+    });
+  }
+};
