+/**
+ * POST /api/v3/tags/delete-unused — delete every tag of the workspace that no response carries.
+ *
+ * A POST custom method rather than a `DELETE` on the collection, for the same reason as
+ * `/api/v3/responses/batch-delete`: a bulk delete that loses its query string must not be reachable by
+ * accident. Session-only, matching the other tag routes.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { deleteUnusedV3Tags } from "../lib/operations";
+import { ZV3TagListQuery } from "../lib/schemas";
+
+export const POST = withV3ApiWrapper({
+  auth: "session",
+  action: "deleted",
+  targetType: "tag",
+  schemas: { query: ZV3TagListQuery },
+  handler: async ({ authentication, parsedInput, auditLog, requestId, instance }) =>
+    deleteUnusedV3Tags({
+      authentication,
+      workspaceId: parsedInput.query.workspaceId,
+      auditLog,
+      requestId,
+      instance,
+    }),
+});
