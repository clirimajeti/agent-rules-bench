diff --git a/apps/web/modules/account/lib/user-data-export.ts b/apps/web/modules/account/lib/user-data-export.ts
new file mode 100644
index 000000000..18a1668e0
--- /dev/null
+++ b/apps/web/modules/account/lib/user-data-export.ts
@@ -0,0 +1,54 @@
+import "server-only";
+import { prisma } from "@formbricks/database";
+import { Prisma } from "@formbricks/database/prisma";
+import { DatabaseError, ResourceNotFoundError } from "@formbricks/types/errors";
+import { getUser } from "@/lib/user/service";
+
+export type TUserDataExport = {
+  exportedAt: string;
+  name: string;
+  email: string;
+  locale: string;
+  notificationSettings: unknown;
+  organizations: { name: string; role: string }[];
+};
+
+/**
+ * The profile data a user may download about themselves: identity, locale, notification settings and
+ * the organizations they belong to, with their role there. Only accepted memberships count as
+ * organizations the user belongs to; pending invitations are not part of their account yet.
+ */
+export const getUserDataExport = async (userId: string): Promise<TUserDataExport> => {
+  const user = await getUser(userId);
+  if (!user) {
+    throw new ResourceNotFoundError("User", userId);
+  }
+
+  try {
+    const memberships = await prisma.membership.findMany({
+      where: { userId, accepted: true },
+      select: {
+        role: true,
+        organization: { select: { name: true } },
+      },
+      orderBy: { organization: { name: "asc" } },
+    });
+
+    return {
+      exportedAt: new Date().toISOString(),
+      name: user.name,
+      email: user.email,
+      locale: user.locale,
+      notificationSettings: user.notificationSettings,
+      organizations: memberships.map((membership) => ({
+        name: membership.organization.name,
+        role: membership.role,
+      })),
+    };
+  } catch (error) {
+    if (error instanceof Prisma.PrismaClientKnownRequestError) {
+      throw new DatabaseError(error.message);
+    }
+    throw error;
+  }
+};
