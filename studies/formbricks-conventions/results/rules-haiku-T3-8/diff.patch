@@ -0,0 +1,30 @@
+import { AuthenticationError } from "@formbricks/types/errors";
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { getUserDataExport } from "@/modules/account/lib/user-data-export";
+
+export const runtime = "nodejs";
+export const dynamic = "force-dynamic";
+
+/**
+ * `GET /api/internal/user-data-export`: the signed-in user's own profile data as a JSON file.
+ * Internal (session-only, no OpenAPI entry). It only ever reads the caller's own account.
+ */
+export const GET = withV3ApiWrapper({
+  auth: "session",
+  handler: async ({ authentication }) => {
+    if (!authentication || !("user" in authentication) || !authentication.user?.id) {
+      throw new AuthenticationError("Session required");
+    }
+    const data = await getUserDataExport(authentication.user.id);
+    const fileName = `formbricks-account-data-${data.exportedAt.slice(0, 10)}.json`;
+
+    return new Response(JSON.stringify(data, null, 2), {
+      status: 200,
+      headers: {
+        "Content-Type": "application/json",
+        "Content-Disposition": `attachment; filename="${fileName}"`,
+        "Cache-Control": "no-store",
+      },
+    });
+  },
+});
