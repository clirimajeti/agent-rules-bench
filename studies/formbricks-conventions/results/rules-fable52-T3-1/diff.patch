@@ -0,0 +1,20 @@
+import type { TV3AccountDataExport } from "@/app/api/v3/account/serializers";
+import { parseV3ApiError } from "@/modules/api/lib/v3-client";
+
+export const ACCOUNT_DATA_EXPORT_FILE_NAME = "formbricks-account-data.json";
+
+/**
+ * Fetch the signed-in user's account data. Throws a parsed `V3ApiError` on a non-2xx response, so the
+ * caller can surface the server's own message.
+ */
+export async function getAccountDataExport(): Promise<TV3AccountDataExport> {
+  const response = await fetch("/api/v3/account/data-export", { method: "GET", cache: "no-store" });
+  if (!response.ok) {
+    throw await parseV3ApiError(response);
+  }
+  return ((await response.json()) as { data: TV3AccountDataExport }).data;
+}
+
+/** The export as the file the user receives: the data itself, without the API's `data` envelope. */
+export const toAccountDataExportBlob = (data: TV3AccountDataExport): Blob =>
+  new Blob([JSON.stringify(data, null, 2)], { type: "application/json" });
diff --git a/apps/web/modules/account/lib/account-data-export.ts b/apps/web/modules/account/lib/account-data-export.ts
new file mode 100644
index 000000000..66f58326b
--- /dev/null
+++ b/apps/web/modules/account/lib/account-data-export.ts
@@ -0,0 +1,34 @@
+import "server-only";
+import { prisma } from "@formbricks/database";
+import { Prisma } from "@formbricks/database/prisma";
+
+const accountDataExportSelect = {
+  name: true,
+  email: true,
+  locale: true,
+  notificationSettings: true,
+  memberships: {
+    select: {
+      role: true,
+      organization: { select: { name: true } },
+    },
+    // A stable order, so two exports of an unchanged account are byte-identical.
+    orderBy: { organizationId: "asc" },
+  },
+} as const satisfies Prisma.UserSelect;
+
+export type TAccountDataExportRecord = Prisma.UserGetPayload<{ select: typeof accountDataExportSelect }>;
+
+/**
+ * The personal data the "Download my data" export hands a user, read in one query.
+ *
+ * Scoped by the user's own id and nothing else: the memberships come through the relation, so an
+ * organization the user does not belong to can never appear. The membership list is not capped on
+ * purpose - an export that silently drops organizations would be an incomplete answer to "what do you
+ * hold about me", and the list is bounded by the organizations one person has joined.
+ */
+export const getAccountDataExportRecord = async (userId: string): Promise<TAccountDataExportRecord | null> =>
+  prisma.user.findUnique({
+    where: { id: userId },
+    select: accountDataExportSelect,
+  });
