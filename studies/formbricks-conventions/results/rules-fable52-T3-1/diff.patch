@@ -0,0 +1,40 @@
+"use client";
+
+import { useMutation } from "@tanstack/react-query";
+import { DownloadIcon } from "lucide-react";
+import { toast } from "react-hot-toast";
+import { useTranslation } from "react-i18next";
+import {
+  ACCOUNT_DATA_EXPORT_FILE_NAME,
+  getAccountDataExport,
+  toAccountDataExportBlob,
+} from "@/modules/account/lib/account-data-export-client";
+import { getV3ApiErrorMessage } from "@/modules/api/lib/v3-client";
+import { saveBlobAsFile } from "@/modules/ee/data-retention/lib/file-download";
+import { Button } from "@/modules/ui/components/button";
+
+export const DownloadAccountDataButton = () => {
+  const { t } = useTranslation();
+
+  // A mutation rather than a query: the data is fetched on click and handed straight to the browser as
+  // a file, so every download reflects the account as it is at that moment and nothing is cached.
+  const { mutate: downloadAccountData, isPending } = useMutation({
+    mutationFn: getAccountDataExport,
+    onSuccess: (data) => saveBlobAsFile(toAccountDataExportBlob(data), ACCOUNT_DATA_EXPORT_FILE_NAME),
+    onError: (error) =>
+      toast.error(getV3ApiErrorMessage(error, t("common.something_went_wrong_please_try_again"))),
+  });
+
+  return (
+    <Button
+      type="button"
+      variant="secondary"
+      size="sm"
+      loading={isPending}
+      disabled={isPending}
+      onClick={() => downloadAccountData()}>
+      <DownloadIcon />
+      {t("workspace.settings.profile.download_my_data")}
+    </Button>
+  );
+};
