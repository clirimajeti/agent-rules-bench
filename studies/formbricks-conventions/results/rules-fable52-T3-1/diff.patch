+/**
+ * GET /api/v3/account/data-export - the signed-in user's own account data, for the "Download my data"
+ * button on the profile settings page.
+ *
+ * Session-only, deliberately. The export is about the person behind the session; an API key belongs to
+ * an organization and has no account of its own to export.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { exportV3AccountData } from "../lib/operations";
+
+export const GET = withV3ApiWrapper({
+  auth: "session",
+  handler: async ({ authentication, requestId, instance }) =>
+    exportV3AccountData({ authentication, requestId, instance }),
+});
