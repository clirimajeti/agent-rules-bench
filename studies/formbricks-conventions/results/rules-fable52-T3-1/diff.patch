@@ -0,0 +1,87 @@
+import { beforeEach, describe, expect, test, vi } from "vitest";
+import type { TV3Authentication } from "@/app/api/v3/lib/types";
+import { getAccountDataExportRecord } from "@/modules/account/lib/account-data-export";
+import { exportV3AccountData } from "./operations";
+
+vi.mock("server-only", () => ({}));
+vi.mock("@/modules/account/lib/account-data-export", () => ({ getAccountDataExportRecord: vi.fn() }));
+
+const userId = "clxx1234567890123456789012";
+const session = { user: { id: userId }, expires: "2099-01-01T00:00:00.000Z" } as TV3Authentication;
+const base = { requestId: "req_1", instance: "/api/v3/account/data-export" };
+
+const record = {
+  name: "Ada Lovelace",
+  email: "ada@example.com",
+  locale: "en-US",
+  notificationSettings: {
+    alert: { clss1234567890123456789012: true },
+    unsubscribedOrganizationIds: ["cloo1234567890123456789012"],
+  },
+  memberships: [
+    { role: "owner", organization: { name: "Analytical Engines" } },
+    { role: "member", organization: { name: "Royal Society" } },
+  ],
+} as Awaited<ReturnType<typeof getAccountDataExportRecord>>;
+
+beforeEach(() => {
+  vi.resetAllMocks();
+});
+
+describe("exportV3AccountData", () => {
+  test("returns the session user's account data and nothing else", async () => {
+    vi.mocked(getAccountDataExportRecord).mockResolvedValue(record);
+
+    const response = await exportV3AccountData({ ...base, authentication: session });
+    const body = await response.json();
+
+    expect(response.status).toBe(200);
+    expect(response.headers.get("Cache-Control")).toBe("private, no-store");
+    expect(getAccountDataExportRecord).toHaveBeenCalledWith(userId);
+    // Exact equality: a field that leaks into the export (an id, a password hash) has to fail here.
+    expect(body.data).toEqual({
+      name: "Ada Lovelace",
+      email: "ada@example.com",
+      locale: "en-US",
+      notificationSettings: {
+        alert: { clss1234567890123456789012: true },
+        unsubscribedOrganizationIds: ["cloo1234567890123456789012"],
+      },
+      organizations: [
+        { name: "Analytical Engines", role: "owner" },
+        { name: "Royal Society", role: "member" },
+      ],
+    });
+  });
+
+  test("fills in empty notification settings for an account that never set any", async () => {
+    vi.mocked(getAccountDataExportRecord).mockResolvedValue({
+      ...record,
+      notificationSettings: {},
+      memberships: [],
+    } as unknown as typeof record);
+
+    const response = await exportV3AccountData({ ...base, authentication: session });
+    const body = await response.json();
+
+    expect(body.data.notificationSettings).toEqual({ alert: {}, unsubscribedOrganizationIds: [] });
+    expect(body.data.organizations).toEqual([]);
+  });
+
+  test("refuses an API key, which has no account of its own, without reading anything", async () => {
+    const apiKey = { type: "apiKey", apiKeyId: "key_1" } as unknown as TV3Authentication;
+
+    const response = await exportV3AccountData({ ...base, authentication: apiKey });
+
+    expect(response.status).toBe(401);
+    expect(getAccountDataExportRecord).not.toHaveBeenCalled();
+  });
+
+  test("answers 401 when the session's user no longer exists", async () => {
+    vi.mocked(getAccountDataExportRecord).mockResolvedValue(null);
+
+    const response = await exportV3AccountData({ ...base, authentication: session });
+
+    expect(response.status).toBe(401);
+  });
+});
