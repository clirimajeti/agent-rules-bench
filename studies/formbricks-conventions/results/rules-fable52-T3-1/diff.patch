+  - notificationSettings
+  - organizations
+properties:
+  name:
+    type: string
+    description: Display name of the user.
+  email:
+    type: string
+    format: email
+  locale:
+    type: string
+    description: The app language the user selected, as a BCP 47 tag.
+    example: en-US
+  notificationSettings:
+    type: object
+    required:
+      - alert
+      - unsubscribedOrganizationIds
+    properties:
+      alert:
+        type: object
+        description: Response alert preference per survey, keyed by survey ID.
+        additionalProperties:
+          type: boolean
+      unsubscribedOrganizationIds:
+        type: array
+        description: Organizations whose notification emails the user unsubscribed from.
+        items:
