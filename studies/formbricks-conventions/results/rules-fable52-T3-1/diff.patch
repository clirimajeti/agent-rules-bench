@@ -0,0 +1,31 @@
+import type { TAccountDataExportRecord } from "@/modules/account/lib/account-data-export";
+
+export type TV3AccountDataExport = {
+  name: string;
+  email: string;
+  locale: string;
+  notificationSettings: {
+    /** Response alerts, keyed by survey id. */
+    alert: Record<string, boolean>;
+    /** Organizations whose notification emails the user has unsubscribed from. */
+    unsubscribedOrganizationIds: string[];
+  };
+  organizations: { name: string; role: string }[];
+};
+
+export const serializeV3AccountDataExport = (record: TAccountDataExportRecord): TV3AccountDataExport => ({
+  name: record.name,
+  email: record.email,
+  locale: record.locale,
+  // The column defaults to `{}`, so an account that never touched its notification settings has
+  // neither key, whatever the type says about `alert`. Named explicitly rather than spread, so a key
+  // added to the column later is a deliberate addition to the export and not an accidental one.
+  notificationSettings: {
+    alert: record.notificationSettings.alert ?? {},
+    unsubscribedOrganizationIds: record.notificationSettings.unsubscribedOrganizationIds ?? [],
+  },
+  organizations: record.memberships.map((membership) => ({
+    name: membership.organization.name,
+    role: membership.role,
+  })),
+});
