+import { TUser } from "@formbricks/types/user";
+import { formatDateTimeForDisplay } from "@/lib/utils/datetime";
+import { getTranslate } from "@/lingodotdev/server";
+import { DownloadAccountDataButton } from "./DownloadAccountDataButton";
+
+// Rendered on the server, so the clock shown is the server's, not the viewer's. The zone name is part
+// of the output so the moment stays unambiguous whichever zone that is.
+const ACTIVITY_DATE_TIME_OPTIONS: Intl.DateTimeFormatOptions = {
+  year: "numeric",
+  month: "long",
+  day: "numeric",
+  hour: "numeric",
+  minute: "2-digit",
+  timeZoneName: "short",
+};
+
+interface AccountActivityProps {
+  user: Pick<TUser, "createdAt" | "lastLoginAt" | "locale">;
+}
+
+export const AccountActivity = async ({ user }: Readonly<AccountActivityProps>) => {
+  const t = await getTranslate();
+
+  const entries = [
+    {
+      label: t("workspace.settings.profile.account_created"),
+      date: user.createdAt,
+    },
+    {
+      label: t("workspace.settings.profile.last_login"),
+      date: user.lastLoginAt,
+    },
+  ];
+
+  return (
+    <div className="space-y-4">
+      <dl className="space-y-3">
+        {entries.map(({ label, date }) => (
+          <div key={label}>
+            <dt className="text-sm font-medium text-slate-900">{label}</dt>
+            <dd className="text-sm text-slate-700">
+              {date ? (
+                <time dateTime={date.toISOString()}>
+                  {formatDateTimeForDisplay(date, user.locale, ACTIVITY_DATE_TIME_OPTIONS)}
+                </time>
+              ) : (
+                t("workspace.settings.profile.no_login_recorded")
+              )}
+            </dd>
+          </div>
+        ))}
+      </dl>
+      <div>
+        <p className="text-sm text-slate-700">{t("workspace.settings.profile.download_my_data_description")}</p>
+        <div className="mt-4">
+          <DownloadAccountDataButton />
+        </div>
+      </div>
+    </div>
+  );
+};
diff --git a/apps/web/app/(app)/workspaces/[workspaceId]/settings/account/profile/components/DownloadAccountDataButton.tsx b/apps/web/app/(app)/workspaces/[workspaceId]/settings/account/profile/components/DownloadAccountDataButton.tsx
