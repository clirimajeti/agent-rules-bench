@@ -0,0 +1,33 @@
+import "server-only";
+import { getV3SessionUserId } from "@/app/api/v3/lib/auth";
+import { problemUnauthorized, successResponse } from "@/app/api/v3/lib/response";
+import type { TV3Authentication } from "@/app/api/v3/lib/types";
+import { getAccountDataExportRecord } from "@/modules/account/lib/account-data-export";
+import { serializeV3AccountDataExport } from "../serializers";
+
+/**
+ * The signed-in user's own account data.
+ *
+ * The subject is always the session's user id; the request carries no identifier, so there is nothing
+ * a caller could point at someone else's account. A session whose user row is gone (deleted while the
+ * session was still live) answers 401, the same as no session at all.
+ */
+export async function exportV3AccountData(params: {
+  authentication: TV3Authentication;
+  requestId: string;
+  instance?: string;
+}): Promise<Response> {
+  const { authentication, requestId, instance } = params;
+
+  const userId = getV3SessionUserId(authentication);
+  if (!userId) {
+    return problemUnauthorized(requestId, "Session required", instance);
+  }
+
+  const record = await getAccountDataExportRecord(userId);
+  if (!record) {
+    return problemUnauthorized(requestId, "Session required", instance);
+  }
+
+  return successResponse(serializeV3AccountDataExport(record), { requestId });
+}
