+import type { Webhook } from "@formbricks/database/prisma-browser";
+
+export const webhookKeys = {
+  all: ["webhooks"] as const,
+  lists: (workspaceId: string) => [...webhookKeys.all, "list", workspaceId] as const,
+  details: () => [...webhookKeys.all, "detail"] as const,
+  detail: (webhookId: string) => [...webhookKeys.details(), webhookId] as const,
+};
+
+export function removeWebhookFromList(
+  data: Webhook[] | undefined,
+  webhookId: string
+): Webhook[] | undefined {
+  if (!data) return data;
+  return data.filter((w) => w.id !== webhookId);
+}
