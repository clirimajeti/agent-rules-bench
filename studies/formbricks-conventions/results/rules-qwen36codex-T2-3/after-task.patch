+export const duplicateWebhook = async (
+  sourceWebhookId: string,
+  sourceWebhook: Webhook
+): Promise<Webhook> => {
+  await validateWebhookUrl(sourceWebhook.url);
+
+  if (isDiscordWebhook(sourceWebhook.url)) {
+    throw new UnknownError("Discord webhooks are currently not supported.");
+  }
+
+  const signingSecret = generateWebhookSecret();
+
+  try {
+    const webhook = await prisma.webhook.create({
+      data: {
+        name: `Copy of ${sourceWebhook.name ?? ""}`,
+        url: sourceWebhook.url,
+        source: "user" as const,
+        triggers: sourceWebhook.triggers,
+        surveyIds: sourceWebhook.surveyIds || [],
+        secret: signingSecret,
+        workspace: {
+          connect: {
+            id: sourceWebhook.workspaceId,
+          },
+        },
+      },
+    });
+
+    return webhook;
+  } catch (error) {
+    if (error instanceof Prisma.PrismaClientKnownRequestError) {
+      throw new DatabaseError(error.message);
+    }
+
+    throw error;
+  }
+};
