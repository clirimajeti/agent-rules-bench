+post:
+  operationId: duplicateWebhookV3
+  # Session-only by design, like the tag endpoints.
+  x-excluded: true
+  summary: Duplicate a webhook
+  description: |
+    Creates a new webhook in the same workspace with the same URL, triggers, surveys and source.
+    The copy is named `Copy of <name>` (or `Copy of <url>` when the original has no name) and gets
+    its own newly generated signing secret.
+
+    Requires write access to the workspace. An unknown id answers `403`.
+  tags:
+    - V3 Webhooks
+  parameters:
+    - in: path
+      name: webhookId
+      required: true
+      schema:
+        type: string
+        format: cuid2
+      description: The webhook to copy.
+  responses:
+    "200":
+      description: Webhook duplicated successfully
+      content:
+        application/json:
+          schema:
+            type: object
+            required:
+              - data
+            properties:
+              data:
+                $ref: ../components/schemas/WebhookResource.yml
+    "400":
+      $ref: ../components/responses/V3BadRequest.yml
+    "401":
+      $ref: ../components/responses/V3UnauthorizedSession.yml
+    "403":
+      $ref: ../components/responses/V3Forbidden.yml
+    "422":
+      $ref: ../components/responses/V3UnprocessableContent.yml
+    "429":
+      $ref: ../components/responses/V3TooManyRequests.yml
+    "500":
+      $ref: ../components/responses/V3InternalServerError.yml
+  security:
+    - sessionAuth: []
