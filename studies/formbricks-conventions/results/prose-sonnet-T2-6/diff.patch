+import { useQuery } from "@tanstack/react-query";
+import { getWebhooks } from "../lib/api-client";
+import { webhookKeys } from "../lib/query";
+
+/** A workspace's webhooks - the table's only data source. */
+export const useWebhooks = (workspaceId: string) =>
+  useQuery({
+    queryKey: webhookKeys.list(workspaceId),
+    queryFn: ({ signal }) => getWebhooks({ workspaceId, signal }),
+  });
diff --git a/apps/web/modules/integrations/webhooks/lib/api-client.ts b/apps/web/modules/integrations/webhooks/lib/api-client.ts
new file mode 100644
index 000000000..dcdcecbbc
--- /dev/null
+++ b/apps/web/modules/integrations/webhooks/lib/api-client.ts
@@ -0,0 +1,41 @@
+import type { Webhook } from "@formbricks/database/prisma-browser";
+import type { TV3Webhook } from "@/app/api/v3/webhooks/serializers";
+import { parseV3ApiError } from "@/modules/api/lib/v3-client";
+
+/**
+ * Client fetchers for the webhooks v3 routes. Reads forward the TanStack `signal`; every call throws a
+ * parsed `V3ApiError` on a non-2xx response. Timestamps come back as ISO strings and are turned into
+ * `Date`s here, so the components keep working with the `Webhook` shape they already use.
+ */
+
+const BASE_PATH = "/api/v3/webhooks";
+
+const toWebhook = (webhook: TV3Webhook): Webhook => ({
+  ...webhook,
+  createdAt: new Date(webhook.createdAt),
+  updatedAt: new Date(webhook.updatedAt),
+});
+
+async function request<T>(url: string, init: RequestInit): Promise<T> {
+  const response = await fetch(url, { cache: "no-store", ...init });
+  if (!response.ok) {
+    throw await parseV3ApiError(response);
+  }
+  return ((await response.json()) as { data: T }).data;
+}
+
+export async function getWebhooks(params: { workspaceId: string; signal?: AbortSignal }): Promise<Webhook[]> {
+  const query = new URLSearchParams({ workspaceId: params.workspaceId });
+  const webhooks = await request<TV3Webhook[]>(`${BASE_PATH}?${query.toString()}`, {
+    method: "GET",
+    signal: params.signal,
+  });
+  return webhooks.map(toWebhook);
+}
+
+export async function duplicateWebhook(params: { webhookId: string }): Promise<Webhook> {
+  const webhook = await request<TV3Webhook>(`${BASE_PATH}/${params.webhookId}/duplicate`, {
+    method: "POST",
+  });
+  return toWebhook(webhook);
+}
