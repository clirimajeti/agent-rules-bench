new file mode 100644
index 000000000..a4a73ee1e
--- /dev/null
+++ b/apps/web/app/api/v3/webhooks/lib/operations.ts
@@ -0,0 +1,69 @@
+import "server-only";
+import { InvalidInputError } from "@formbricks/types/errors";
+import { requireV3WorkspaceAccess } from "@/app/api/v3/lib/auth";
+import {
+  problemForbidden,
+  problemInternalError,
+  problemUnprocessableContent,
+  successResponse,
+} from "@/app/api/v3/lib/response";
+import type { TV3AuditLog, TV3Authentication } from "@/app/api/v3/lib/types";
+import { duplicateWebhook, getWebhookById, getWebhooks } from "@/modules/integrations/webhooks/lib/webhook";
+import { serializeV3Webhook } from "../serializers";
+
+type TBaseParams = {
+  authentication: TV3Authentication;
+  requestId: string;
+  instance?: string;
+};
+
+export async function listV3Webhooks(params: TBaseParams & { workspaceId: string }): Promise<Response> {
+  const { authentication, workspaceId, requestId, instance } = params;
+
+  const access = await requireV3WorkspaceAccess(authentication, workspaceId, "read", requestId, instance);
+  if (access instanceof Response) return access;
+
+  const webhooks = await getWebhooks(access.workspaceId);
+  return successResponse(webhooks.map(serializeV3Webhook), { requestId });
+}
+
+export async function duplicateV3Webhook(
+  params: TBaseParams & { webhookId: string; auditLog?: TV3AuditLog }
+): Promise<Response> {
+  const { authentication, webhookId, auditLog, requestId, instance } = params;
+
+  // The workspace is resolved from the webhook itself, never from the client. An unknown id answers 403,
+  // not 404, so a signed-in user cannot probe webhook ids across the instance.
+  const original = await getWebhookById(webhookId);
+  if (!original) {
+    return problemForbidden(requestId, "You are not authorized to access this resource", instance);
+  }
+
+  const access = await requireV3WorkspaceAccess(
+    authentication,
+    original.workspaceId,
+    "readWrite",
+    requestId,
+    instance
+  );
+  if (access instanceof Response) return access;
+
+  try {
+    const copy = await duplicateWebhook(original);
+
+    if (auditLog) {
+      auditLog.organizationId = access.organizationId;
+      auditLog.targetId = copy.id;
+      auditLog.newObject = { ...copy, secret: undefined };
+    }
+
+    return successResponse(serializeV3Webhook(copy), { requestId });
+  } catch (error) {
+    // The copied URL is validated again, so one that is no longer allowed (for example an internal URL
+    // after the instance setting changed) is the caller's data problem, not a server fault.
+    if (error instanceof InvalidInputError) {
+      return problemUnprocessableContent(requestId, error.message, { instance });
+    }
+    return problemInternalError(requestId, "Unable to duplicate webhook", instance);
+  }
+}
