+export const rotateApiKey = async (
+  apiKeyId: string,
+  userId: string,
+): Promise<TApiKeyRotateOutput> => {
+  validateInputs([apiKeyId, ZId]);
+
+  try {
+    // Generate a new secret
+    const secret = randomBytes(32).toString("base64url");
+
+    // Hybrid approach for security + performance:
+    // 1. SHA-256 lookup hash
+    const lookupHash = hashSha256(secret);
+
+    // 2. bcrypt hash
+    const hashedKey = await hashSecret(secret, 12);
+
+    // Update the API key with the new secret
+    const result = await prisma.apiKey.update({
+      where: {
+        id: apiKeyId,
+      },
+      data: {
+        hashedKey,
+        lookupHash,
+      },
+      include: {
+        apiKeyWorkspaces: true,
+      },
+    });
+
+    await runPostCommitProjection("api_key_create_relationship_reconciliation", () =>
+      reconcileApiKeyRelationships({ apiKeyIds: [result.id] })
+    );
+
+    return { ...result, actualKey: `fbk_${secret}` } as TApiKeyRotateOutput;
+  } catch (error) {
+    if (error instanceof Prisma.PrismaClientKnownRequestError) {
+      throw new DatabaseError(error.message);
+    }
+    throw error;
+  }
+};
