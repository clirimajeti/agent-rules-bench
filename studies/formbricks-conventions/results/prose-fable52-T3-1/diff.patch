+import { ZUserNotificationSettings } from "@formbricks/types/user";
+import type { TAccountExportRecord } from "@/modules/account/lib/account-export";
+
+export type TV3AccountExport = {
+  name: string;
+  email: string;
+  locale: string;
+  notificationSettings: {
+    /** Per-survey response alerts, keyed by survey id. */
+    alert: Record<string, boolean>;
+    /** Organizations whose weekly emails the user has opted out of. */
+    unsubscribedOrganizationIds: string[];
+  };
+  organizationMemberships: {
+    organizationName: string;
+    role: string;
+  }[];
+};
+
+/**
+ * `notificationSettings` is a free-form JSON column that defaults to `{}`, so it is normalized to the
+ * documented shape here: a user who never touched the settings still gets both keys.
+ */
+const serializeNotificationSettings = (value: unknown): TV3AccountExport["notificationSettings"] => {
+  const parsed = ZUserNotificationSettings.partial().safeParse(value);
+  const settings = parsed.success ? parsed.data : {};
+
+  return {
+    alert: settings.alert ?? {},
+    unsubscribedOrganizationIds: settings.unsubscribedOrganizationIds ?? [],
+  };
+};
+
+export const serializeV3AccountExport = (record: TAccountExportRecord): TV3AccountExport => ({
+  name: record.name,
+  email: record.email,
+  locale: record.locale,
+  notificationSettings: serializeNotificationSettings(record.notificationSettings),
+  organizationMemberships: record.memberships.map((membership) => ({
+    organizationName: membership.organization.name,
+    role: membership.role,
+  })),
+});
