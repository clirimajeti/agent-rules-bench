@@ -0,0 +1,30 @@
+"use client";
+
+import { useMutation } from "@tanstack/react-query";
+import { useEffect, useRef } from "react";
+import { saveBlobAsFile } from "@/modules/ee/data-retention/lib/file-download";
+import { getAccountExport } from "../lib/api-client";
+
+export const ACCOUNT_DATA_FILE_NAME = "formbricks-account-data.json";
+
+/**
+ * Fetch the account export and hand it to the browser as a JSON file. A mutation, not a query: every
+ * click must read the account as it is now, and the result goes to a file, not to the screen. A second
+ * click replaces the request in flight, and leaving the page cancels it.
+ */
+export const useDownloadAccountData = () => {
+  const inFlight = useRef<AbortController | null>(null);
+  useEffect(() => () => inFlight.current?.abort(), []);
+
+  return useMutation({
+    mutationFn: async () => {
+      inFlight.current?.abort();
+      const controller = new AbortController();
+      inFlight.current = controller;
+      const data = await getAccountExport({ signal: controller.signal });
+      if (controller.signal.aborted) return;
+      const blob = new Blob([JSON.stringify(data, null, 2)], { type: "application/json" });
+      saveBlobAsFile(blob, ACCOUNT_DATA_FILE_NAME);
+    },
+  });
+};
