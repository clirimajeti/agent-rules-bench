+import { formatDateTimeForDisplay } from "@/lib/utils/datetime";
+import { getTranslate } from "@/lingodotdev/server";
+import { DownloadAccountDataButton } from "../DownloadAccountDataButton";
+
+/**
+ * Shown in UTC with the zone written out. An account has no time zone of its own (an organization's
+ * `displayTimeZone` is for its response data, and an account can span several organizations), and the
+ * server's or browser's zone would make the same moment read differently from one place to the next.
+ */
+const ACTIVITY_DATE_TIME_OPTIONS: Intl.DateTimeFormatOptions = {
+  year: "numeric",
+  month: "long",
+  day: "numeric",
+  hour: "numeric",
+  minute: "2-digit",
+  timeZone: "UTC",
+  timeZoneName: "short",
+};
+
+type TAccountActivityProps = {
+  createdAt: Date;
+  lastLoginAt: Date | null;
+  locale: string;
+};
+
+export const AccountActivity = async ({ createdAt, lastLoginAt, locale }: Readonly<TAccountActivityProps>) => {
+  const t = await getTranslate();
+  const formatDateTime = (date: Date) => formatDateTimeForDisplay(date, locale, ACTIVITY_DATE_TIME_OPTIONS);
+
+  const rows = [
+    {
+      label: t("workspace.settings.profile.account_created"),
+      value: formatDateTime(createdAt),
+      dateTime: createdAt.toISOString(),
+    },
+    {
+      label: t("workspace.settings.profile.last_login"),
+      value: lastLoginAt ? formatDateTime(lastLoginAt) : t("workspace.settings.profile.no_login_recorded"),
+      dateTime: lastLoginAt?.toISOString(),
+    },
+  ];
+
+  return (
+    <div className="flex flex-col gap-4">
+      <dl className="grid grid-cols-1 gap-4 sm:grid-cols-2">
+        {rows.map((row) => (
+          <div key={row.label} className="flex flex-col gap-1">
+            <dt className="text-xs text-slate-600">{row.label}</dt>
+            <dd className="text-sm font-semibold text-slate-800">
+              {row.dateTime ? <time dateTime={row.dateTime}>{row.value}</time> : row.value}
+            </dd>
+          </div>
+        ))}
+      </dl>
+      <div className="flex flex-col gap-2 border-t border-slate-200 pt-4">
+        <p className="text-xs text-slate-600">{t("workspace.settings.profile.download_my_data_description")}</p>
+        <div>
+          <DownloadAccountDataButton />
+        </div>
+      </div>
+    </div>
+  );
+};
