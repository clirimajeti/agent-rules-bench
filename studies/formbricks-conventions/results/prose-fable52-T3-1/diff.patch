@@ -0,0 +1,71 @@
+import { beforeEach, describe, expect, test, vi } from "vitest";
+import { getAccountExportRecord } from "@/modules/account/lib/account-export";
+import { exportV3Account } from "./operations";
+
+vi.mock("server-only", () => ({}));
+vi.mock("@/modules/account/lib/account-export", () => ({ getAccountExportRecord: vi.fn() }));
+
+const userId = "clxx1234567890123456789012";
+const session = { user: { id: userId }, expires: "2099-01-01T00:00:00.000Z" };
+const base = { requestId: "req_1", instance: "/api/v3/account/export" };
+
+const record = {
+  name: "Ada Lovelace",
+  email: "ada@example.com",
+  locale: "en-US",
+  notificationSettings: { alert: { survey_1: true }, unsubscribedOrganizationIds: ["org_1"] },
+  memberships: [
+    { role: "owner" as const, organization: { name: "Analytical Engines" } },
+    { role: "member" as const, organization: { name: "Royal Society" } },
+  ],
+};
+
+beforeEach(() => {
+  vi.resetAllMocks();
+});
+
+describe("exportV3Account", () => {
+  test("exports the session user's own data and nothing else", async () => {
+    vi.mocked(getAccountExportRecord).mockResolvedValue(record);
+
+    const response = await exportV3Account({ ...base, authentication: session as never });
+    const body = await response.json();
+
+    expect(response.status).toBe(200);
+    expect(getAccountExportRecord).toHaveBeenCalledWith(userId);
+    expect(body.data).toEqual({
+      name: "Ada Lovelace",
+      email: "ada@example.com",
+      locale: "en-US",
+      notificationSettings: { alert: { survey_1: true }, unsubscribedOrganizationIds: ["org_1"] },
+      organizationMemberships: [
+        { organizationName: "Analytical Engines", role: "owner" },
+        { organizationName: "Royal Society", role: "member" },
+      ],
+    });
+  });
+
+  test("fills the documented notification settings shape for a user who never set any", async () => {
+    vi.mocked(getAccountExportRecord).mockResolvedValue({ ...record, notificationSettings: {} });
+
+    const response = await exportV3Account({ ...base, authentication: session as never });
+    const body = await response.json();
+
+    expect(body.data.notificationSettings).toEqual({ alert: {}, unsubscribedOrganizationIds: [] });
+  });
+
+  test("answers 401 without a session user, before any read", async () => {
+    const response = await exportV3Account({ ...base, authentication: null });
+
+    expect(response.status).toBe(401);
+    expect(getAccountExportRecord).not.toHaveBeenCalled();
+  });
+
+  test("answers 401 when the session's user no longer exists", async () => {
+    vi.mocked(getAccountExportRecord).mockResolvedValue(null);
+
+    const response = await exportV3Account({ ...base, authentication: session as never });
+
+    expect(response.status).toBe(401);
+  });
+});
