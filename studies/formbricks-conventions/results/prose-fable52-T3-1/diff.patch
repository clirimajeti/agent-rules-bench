+/**
+ * GET /api/v3/account/export - the signed-in user's own account data: name, email, locale,
+ * notification settings and organization memberships.
+ *
+ * Session-only, deliberately. It backs the "Download my data" button on the account profile page, and
+ * an API key belongs to an organization, not to a user, so there is no account for it to export.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { exportV3Account } from "./lib/operations";
+import { ZV3AccountExportQuery } from "./lib/schemas";
+
+export const GET = withV3ApiWrapper({
+  auth: "session",
+  schemas: { query: ZV3AccountExportQuery },
+  handler: async ({ authentication, requestId, instance }) =>
+    exportV3Account({ authentication, requestId, instance }),
+});
