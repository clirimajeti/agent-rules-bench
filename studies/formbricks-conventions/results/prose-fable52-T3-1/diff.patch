@@ -0,0 +1,30 @@
+import "server-only";
+import { getV3SessionUserId } from "@/app/api/v3/lib/auth";
+import { problemUnauthorized, successResponse } from "@/app/api/v3/lib/response";
+import type { TV3Authentication } from "@/app/api/v3/lib/types";
+import { getAccountExportRecord } from "@/modules/account/lib/account-export";
+import { serializeV3AccountExport } from "../serializers";
+
+type TParams = {
+  authentication: TV3Authentication;
+  requestId: string;
+  instance?: string;
+};
+
+/**
+ * The export is always the caller's own account: the user id comes from the session and nothing in the
+ * request can name another one. A session whose user row is gone answers 401, the same as no session.
+ */
+export async function exportV3Account({ authentication, requestId, instance }: TParams): Promise<Response> {
+  const userId = getV3SessionUserId(authentication);
+  if (!userId) {
+    return problemUnauthorized(requestId, undefined, instance);
+  }
+
+  const record = await getAccountExportRecord(userId);
+  if (!record) {
+    return problemUnauthorized(requestId, undefined, instance);
+  }
+
+  return successResponse(serializeV3AccountExport(record), { requestId });
+}
