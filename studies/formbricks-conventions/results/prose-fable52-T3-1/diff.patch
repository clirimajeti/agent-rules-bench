@@ -0,0 +1,43 @@
+import "server-only";
+import { prisma } from "@formbricks/database";
+import { Prisma } from "@formbricks/database/prisma";
+import { ZId } from "@formbricks/types/common";
+import { DatabaseError } from "@formbricks/types/errors";
+import { validateInputs } from "@/lib/utils/validate";
+
+const accountExportSelect = {
+  name: true,
+  email: true,
+  locale: true,
+  notificationSettings: true,
+  memberships: {
+    select: {
+      role: true,
+      organization: { select: { name: true } },
+    },
+    // A stable order, so two exports of an unchanged account are identical files.
+    orderBy: { organizationId: "asc" },
+  },
+} as const satisfies Prisma.UserSelect;
+
+export type TAccountExportRecord = Prisma.UserGetPayload<{ select: typeof accountExportSelect }>;
+
+/**
+ * Everything the "Download my data" export contains, in one query. Scoped by the user id alone: the
+ * memberships come through the user's own relation, so no other account's rows can be reached.
+ */
+export const getAccountExportRecord = async (userId: string): Promise<TAccountExportRecord | null> => {
+  validateInputs([userId, ZId]);
+
+  try {
+    return await prisma.user.findUnique({
+      where: { id: userId },
+      select: accountExportSelect,
+    });
+  } catch (error) {
+    if (error instanceof Prisma.PrismaClientKnownRequestError) {
+      throw new DatabaseError(error.message);
+    }
+    throw error;
+  }
+};
diff --git a/apps/web/modules/account/lib/api-client.ts b/apps/web/modules/account/lib/api-client.ts
