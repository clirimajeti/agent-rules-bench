+import type { TV3AccountExport } from "@/app/api/v3/account/export/serializers";
+import { parseV3ApiError } from "@/modules/api/lib/v3-client";
+
+/**
+ * Client fetcher for the account export v3 route. Throws a parsed `V3ApiError` on a non-2xx response,
+ * so the caller can show the server's own message.
+ */
+export async function getAccountExport(params?: { signal?: AbortSignal }): Promise<TV3AccountExport> {
+  const response = await fetch("/api/v3/account/export", {
+    method: "GET",
+    cache: "no-store",
+    signal: params?.signal,
+  });
+  if (!response.ok) {
+    throw await parseV3ApiError(response);
+  }
+  return ((await response.json()) as { data: TV3AccountExport }).data;
+}
