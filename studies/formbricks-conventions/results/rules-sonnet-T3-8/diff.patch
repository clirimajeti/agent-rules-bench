+export type TV3AccountDataExport = {
+  name: string;
+  email: string;
+  locale: string;
+  notificationSettings: unknown;
+  organizations: { name: string; role: string }[];
+};
+
+type TAccountDataExportSource = {
+  name: string;
+  email: string;
+  locale: string;
+  notificationSettings: unknown;
+  memberships: { role: string; organization: { name: string } }[];
+};
+
+export const serializeV3AccountDataExport = (user: TAccountDataExportSource): TV3AccountDataExport => ({
+  name: user.name,
+  email: user.email,
+  locale: user.locale,
+  notificationSettings: user.notificationSettings,
+  organizations: user.memberships.map((membership) => ({
+    name: membership.organization.name,
+    role: membership.role,
+  })),
+});
