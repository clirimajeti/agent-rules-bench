+import { describe, expect, test } from "vitest";
+import { serializeV3AccountDataExport } from "./serializers";
+
+describe("serializeV3AccountDataExport", () => {
+  test("flattens memberships to organization name and role", () => {
+    const result = serializeV3AccountDataExport({
+      name: "Ada",
+      email: "ada@example.com",
+      locale: "en-US",
+      notificationSettings: { alert: { survey1: true } },
+      memberships: [
+        { role: "owner", organization: { name: "Acme" } },
+        { role: "member", organization: { name: "Globex" } },
+      ],
+    });
+
+    expect(result).toEqual({
+      name: "Ada",
+      email: "ada@example.com",
+      locale: "en-US",
+      notificationSettings: { alert: { survey1: true } },
+      organizations: [
+        { name: "Acme", role: "owner" },
+        { name: "Globex", role: "member" },
+      ],
+    });
+  });
+});
