@@ -0,0 +1,72 @@
+get:
+  operationId: getAccountDataExportV3
+  # Session-only by design: it answers for the signed-in user, so an API key has no user to export.
+  # Excluded from the generated docs pages like the other session-only paths.
+  x-excluded: true
+  summary: Export my account data
+  description: |
+    Returns the signed-in user's own name, email, locale, notification settings and the organizations
+    they belong to, each with the user's role. Pending invitations are not included.
+
+    Session cookie only. This backs the "Download my data" button on the profile page, so it does not
+    accept `x-api-key`.
+  tags:
+    - V3 Account
+  responses:
+    "200":
+      description: Account data retrieved successfully
+      headers:
+        X-Request-Id:
+          schema:
+            type: string
+          description: Request correlation ID
+        Cache-Control:
+          schema:
+            type: string
+          example: private, no-store
+      content:
+        application/json:
+          schema:
+            type: object
+            required:
+              - data
+            properties:
+              data:
+                type: object
+                required:
+                  - name
+                  - email
+                  - locale
+                  - notificationSettings
+                  - organizations
+                properties:
+                  name:
+                    type: string
+                  email:
+                    type: string
+                  locale:
+                    type: string
+                    example: en-US
+                  notificationSettings:
+                    type: object
+                    additionalProperties: true
+                  organizations:
+                    type: array
+                    items:
+                      type: object
+                      required:
+                        - name
+                        - role
+                      properties:
+                        name:
+                          type: string
+                        role:
+                          type: string
+    "401":
+      $ref: ../components/responses/V3UnauthorizedSession.yml
+    "429":
+      $ref: ../components/responses/V3TooManyRequests.yml
+    "500":
+      $ref: ../components/responses/V3InternalServerError.yml
+  security:
+    - sessionAuth: []
