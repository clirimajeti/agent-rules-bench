+"use client";
+
+import { useMutation } from "@tanstack/react-query";
+import { DownloadIcon } from "lucide-react";
+import toast from "react-hot-toast";
+import { useTranslation } from "react-i18next";
+import { getAccountDataExport } from "@/app/(app)/workspaces/[workspaceId]/settings/account/profile/lib/api-client";
+import { Button } from "@/modules/ui/components/button";
+
+const EXPORT_FILE_NAME = "formbricks-account-data.json";
+
+const downloadJson = (data: unknown, fileName: string) => {
+  const blob = new Blob([JSON.stringify(data, null, 2)], { type: "application/json" });
+  const url = URL.createObjectURL(blob);
+  const link = document.createElement("a");
+  link.href = url;
+  link.download = fileName;
+  document.body.appendChild(link);
+  link.click();
+  link.remove();
+  URL.revokeObjectURL(url);
+};
+
+export const DownloadMyData = () => {
+  const { t } = useTranslation();
+
+  const { mutate, isPending } = useMutation({
+    mutationFn: getAccountDataExport,
+    onSuccess: (data) => downloadJson(data, EXPORT_FILE_NAME),
+    onError: () => toast.error(t("common.something_went_wrong_please_try_again")),
+  });
+
+  return (
+    <Button type="button" variant="secondary" loading={isPending} onClick={() => mutate()}>
+      <DownloadIcon />
+      {t("workspace.settings.profile.download_my_data")}
+    </Button>
+  );
+};
diff --git a/apps/web/app/(app)/workspaces/[workspaceId]/settings/account/profile/lib/api-client.ts b/apps/web/app/(app)/workspaces/[workspaceId]/settings/account/profile/lib/api-client.ts
