+import "server-only";
+import { prisma } from "@formbricks/database";
+import { getV3SessionUserId } from "@/app/api/v3/lib/auth";
+import { problemInternalError, problemUnauthorized, successResponse } from "@/app/api/v3/lib/response";
+import type { TV3Authentication } from "@/app/api/v3/lib/types";
+import { serializeV3AccountDataExport } from "./serializers";
+
+/**
+ * The signed-in user's own personal data: profile, notification settings and organization memberships.
+ *
+ * Scoped by the session's user id and nothing else - there is no id in the request to forge. Pending
+ * invitations (`accepted: false`) are left out: the user is not a member of those organizations yet.
+ */
+export async function getV3AccountDataExport(params: {
+  authentication: TV3Authentication;
+  requestId: string;
+  instance?: string;
+}): Promise<Response> {
+  const { authentication, requestId, instance } = params;
+
+  const userId = getV3SessionUserId(authentication);
+  if (!userId) {
+    return problemUnauthorized(requestId, "Session required", instance);
+  }
+
+  const user = await prisma.user.findUnique({
+    where: { id: userId },
+    select: {
+      name: true,
+      email: true,
+      locale: true,
+      notificationSettings: true,
+      memberships: {
+        where: { accepted: true },
+        select: { role: true, organization: { select: { name: true } } },
+        orderBy: { organization: { name: "asc" } },
+      },
+    },
+  });
+
+  if (!user) {
+    return problemInternalError(requestId, "The account could not be loaded.", instance);
+  }
+
+  return successResponse(serializeV3AccountDataExport(user), { requestId });
+}
