+/**
+ * GET /api/v3/account/data-export - the signed-in user's own name, email, locale, notification settings
+ * and organization memberships.
+ *
+ * Session-only, deliberately: it backs the "Download my data" button on the profile page and answers for
+ * the session's user alone, so an API key has no user to export.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { getV3AccountDataExport } from "./lib/operations";
+
+export const GET = withV3ApiWrapper({
+  auth: "session",
+  handler: async ({ authentication, requestId, instance }) =>
+    getV3AccountDataExport({ authentication, requestId, instance }),
+});
