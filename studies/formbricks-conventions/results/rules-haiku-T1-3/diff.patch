+// Replaces the secret of an existing key. The row keeps its id, label, organization access and workspace
+// permissions, so existing relationships stay valid; only the stored hashes change, which makes the old
+// secret fail lookup and verification immediately.
+export const rotateApiKey = async (
+  apiKeyId: string
+): Promise<TApiKeyWithEnvironmentPermission & { actualKey: string }> => {
+  validateInputs([apiKeyId, ZId]);
+  try {
+    const { secret, lookupHash, hashedKey } = await generateApiKeySecret();
+
+    const result = await prisma.apiKey.update({
+      where: { id: apiKeyId },
+      data: { hashedKey, lookupHash },
+      select: {
+        id: true,
+        label: true,
+        createdAt: true,
+        lastUsedAt: true,
+        organizationAccess: true,
+        apiKeyWorkspaces: {
+          select: {
+            permission: true,
+            workspaceId: true,
+          },
+        },
+      },
+    });
+
+    return { ...result, actualKey: `fbk_${secret}` };
+  } catch (error) {
+    if (error instanceof Prisma.PrismaClientKnownRequestError) {
+      throw new DatabaseError(error.message);
+    }
+    throw error;
+  }
+};
