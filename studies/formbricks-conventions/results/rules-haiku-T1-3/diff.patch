+// Generates a fresh secret and its two stored hashes. Shared by create and rotate so both produce keys
+// in the same format and with the same hashing.
+const generateApiKeySecret = async (): Promise<{ secret: string; lookupHash: string; hashedKey: string }> => {
+  // Generate a secure random secret (32 bytes base64url)
+  const secret = randomBytes(32).toString("base64url");
+
+  // Hybrid approach for security + performance:
+  // 1. SHA-256 lookup hash
+  const lookupHash = hashSha256(secret);
+
+  // 2. bcrypt hash
+  const hashedKey = await hashSecret(secret, 12);
+
+  return { secret, lookupHash, hashedKey };
+};
