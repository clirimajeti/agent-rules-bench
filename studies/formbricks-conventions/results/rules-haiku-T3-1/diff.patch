@@ -0,0 +1,21 @@
+import { NextResponse } from "next/server";
+import { getUserDataExport } from "@/lib/user/data-export";
+import { getSession } from "@/modules/auth/lib/session";
+
+export const GET = async () => {
+  const session = await getSession();
+  if (!session?.user) {
+    return NextResponse.json({ error: "Not authenticated" }, { status: 401 });
+  }
+
+  const data = await getUserDataExport(session.user.id);
+
+  return new NextResponse(JSON.stringify(data, null, 2), {
+    status: 200,
+    headers: {
+      "Content-Type": "application/json; charset=utf-8",
+      "Content-Disposition": 'attachment; filename="formbricks-my-data.json"',
+      "Cache-Control": "no-store",
+    },
+  });
+};
diff --git a/apps/web/lib/user/data-export.ts b/apps/web/lib/user/data-export.ts
new file mode 100644
index 000000000..e4e2a791a
--- /dev/null
+++ b/apps/web/lib/user/data-export.ts
@@ -0,0 +1,52 @@
+import "server-only";
+import { prisma } from "@formbricks/database";
+import { ResourceNotFoundError } from "@formbricks/types/errors";
+import { TOrganizationRole } from "@formbricks/types/memberships";
+import { TUserLocale, TUserNotificationSettings } from "@formbricks/types/user";
+import { getUser } from "./service";
+
+export type TUserDataExportMembership = {
+  organizationName: string;
+  role: TOrganizationRole;
+};
+
+export type TUserDataExport = {
+  name: string;
+  email: string;
+  locale: TUserLocale;
+  notificationSettings: TUserNotificationSettings;
+  organizationMemberships: TUserDataExportMembership[];
+};
+
+/**
+ * The personal data a user can download from their profile page. Only the user's own record and their
+ * accepted organization memberships are read, so the export cannot reach another user's data.
+ */
+export const getUserDataExport = async (userId: string): Promise<TUserDataExport> => {
+  const [user, memberships] = await Promise.all([
+    getUser(userId),
+    prisma.membership.findMany({
+      where: { userId, accepted: true },
+      select: {
+        role: true,
+        organization: { select: { name: true } },
+      },
+      orderBy: { organization: { name: "asc" } },
+    }),
+  ]);
+
+  if (!user) {
+    throw new ResourceNotFoundError("User", userId);
+  }
+
+  return {
+    name: user.name,
+    email: user.email,
+    locale: user.locale,
+    notificationSettings: user.notificationSettings,
+    organizationMemberships: memberships.map((membership) => ({
+      organizationName: membership.organization.name,
+      role: membership.role,
+    })),
+  };
+};
