+"use client";
+
+import { useState } from "react";
+import toast from "react-hot-toast";
+import { useTranslation } from "react-i18next";
+import { formatDateTimeForDisplay } from "@/lib/utils/datetime";
+import { Button } from "@/modules/ui/components/button";
+
+const DATA_EXPORT_FILE_NAME = "formbricks-my-data.json";
+
+// The profile has no time zone source of truth, so dates are shown in UTC instead of the browser's zone.
+const ACTIVITY_DATE_OPTIONS: Intl.DateTimeFormatOptions = {
+  year: "numeric",
+  month: "short",
+  day: "numeric",
+  hour: "2-digit",
+  minute: "2-digit",
+  timeZone: "UTC",
+  timeZoneName: "short",
+};
+
+interface AccountActivityProps {
+  createdAt: Date;
+  lastLoginAt: Date | null;
+  locale: string;
+}
+
+const saveFile = (blob: Blob, fileName: string) => {
+  const url = URL.createObjectURL(blob);
+  const link = document.createElement("a");
+  link.href = url;
+  link.download = fileName;
+  link.style.display = "none";
+  document.body.appendChild(link);
+  try {
+    link.click();
+  } finally {
+    link.remove();
+    // Revoked on the next task: some browsers read the URL only after `click()` has returned.
+    setTimeout(() => URL.revokeObjectURL(url), 0);
+  }
+};
+
+export const AccountActivity = ({ createdAt, lastLoginAt, locale }: Readonly<AccountActivityProps>) => {
+  const { t } = useTranslation();
+  const [isDownloading, setIsDownloading] = useState(false);
+
+  const formatActivityDate = (date: Date) => formatDateTimeForDisplay(date, locale, ACTIVITY_DATE_OPTIONS);
+
+  const handleDownloadMyData = async () => {
+    setIsDownloading(true);
+    try {
+      const response = await fetch("/api/account/data-export", { method: "GET", cache: "no-store" });
+      if (!response.ok) {
+        throw new Error(`Data export failed with status ${response.status}`);
+      }
+      const blob = await response.blob();
+      saveFile(blob, DATA_EXPORT_FILE_NAME);
+    } catch {
+      toast.error(t("workspace.settings.profile.download_my_data_failed"));
+    } finally {
+      setIsDownloading(false);
+    }
+  };
+
+  return (
+    <div className="flex flex-col gap-4">
+      <dl className="grid grid-cols-1 gap-4 sm:grid-cols-2">
+        <div className="flex flex-col">
+          <dt className="text-sm font-semibold text-slate-800">
+            {t("workspace.settings.profile.account_created")}
+          </dt>
+          <dd className="text-sm text-slate-600">{formatActivityDate(createdAt)}</dd>
+        </div>
+        <div className="flex flex-col">
+          <dt className="text-sm font-semibold text-slate-800">{t("workspace.settings.profile.last_login")}</dt>
+          <dd className="text-sm text-slate-600">
+            {lastLoginAt ? formatActivityDate(lastLoginAt) : t("workspace.settings.profile.last_login_never")}
+          </dd>
+        </div>
+      </dl>
+
+      <div className="flex items-center justify-between gap-4 border-t border-slate-200 pt-4">
+        <p className="text-xs text-slate-600">{t("workspace.settings.profile.download_my_data_description")}</p>
+        <Button
+          type="button"
+          variant="secondary"
+          loading={isDownloading}
+          onClick={handleDownloadMyData}
+          className="shrink-0">
+          {t("workspace.settings.profile.download_my_data")}
+        </Button>
+      </div>
+    </div>
+  );
+};
