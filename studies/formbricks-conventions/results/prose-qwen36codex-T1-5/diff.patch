+/**
+ * POST /api/v3/api-keys/{apiKeyId}/rotate — rotate (revoke + re-issue) an API key.
+ * Session-only. Requires `apiKey.manage` on the key.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { successResponse } from "@/app/api/v3/lib/response";
+import { rotateApiKey } from "@/modules/organization/settings/api-keys/lib/api-key";
+import { assertCan } from "@/lib/authorization";
+import { getOrganizationIdFromApiKeyId } from "@/lib/utils/helper";
+import { ZId } from "@formbricks/types/common";
+import { z } from "zod";
+
+export const POST = withV3ApiWrapper({
+  auth: "session",
+  schemas: {
+    params: z.object({ apiKeyId: ZId }).strict(),
+  },
+  handler: async ({ authentication, parsedInput, requestId, instance }) => {
+    const { apiKeyId } = parsedInput.params;
+
+    await assertCan({ type: "user", id: authentication.user!.id }, "apiKey.manage", {
+      type: "apiKey",
+      id: apiKeyId,
+    });
+
+    const result = await rotateApiKey(apiKeyId, authentication.user!.id);
+
+    return successResponse({
+      id: result.id,
+      actualKey: result.actualKey,
+    });
+  },
+});
