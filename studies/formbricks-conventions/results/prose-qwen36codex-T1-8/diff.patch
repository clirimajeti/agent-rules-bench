+/**
+ * POST /api/v3/api-keys/[apiKeyId]/rotate — rotate an API key's secret.
+ * Session-only. Requires `apiKey.manage` on the key.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { ZApiKeyRotateParams } from "./lib/schemas";
+import { rotateV3ApiKey } from "./lib/operations";
+
+export const POST = withV3ApiWrapper({
+  auth: "session",
+  schemas: {
+    params: ZApiKeyRotateParams,
+  },
+  handler: async ({ authentication, parsedInput, requestId, instance }) =>
+    rotateV3ApiKey({
+      authentication,
+      apiKeyId: parsedInput.params.apiKeyId,
+      requestId,
+      instance,
+    }),
+});
