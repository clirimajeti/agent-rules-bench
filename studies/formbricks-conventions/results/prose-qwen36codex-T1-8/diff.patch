@@ -0,0 +1,25 @@
+import "server-only";
+import { assertCan } from "@/lib/authorization";
+import { successResponse } from "@/app/api/v3/lib/response";
+import type { TV3Authentication } from "@/app/api/v3/lib/types";
+import { rotateApiKey } from "@/modules/organization/settings/api-keys/lib/api-key";
+
+export async function rotateV3ApiKey(params: {
+  authentication: TV3Authentication;
+  apiKeyId: string;
+  requestId: string;
+  instance: string;
+}): Promise<Response> {
+  const { authentication, apiKeyId, requestId, instance } = params;
+
+  // Authorize: caller must have `apiKey.manage` on this specific key
+  await assertCan({ type: "user", id: authentication.userId }, "apiKey.manage", {
+    type: "apiKey",
+    id: apiKeyId,
+  });
+
+  // Rotate the key (generates new secret, updates hashes)
+  const result = await rotateApiKey(apiKeyId);
+
+  return successResponse(result, { requestId });
+}
