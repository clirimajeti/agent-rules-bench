@@ -0,0 +1,18 @@
+"use client";
+
+import { useMutation, useQueryClient } from "@tanstack/react-query";
+import { rotateApiKey } from "../lib/api-client";
+
+/**
+ * Rotate an API key, then invalidate the api-keys list so the table picks up the change.
+ */
+export const useRotateApiKey = () => {
+  const queryClient = useQueryClient();
+
+  return useMutation({
+    mutationFn: ({ apiKeyId }: { apiKeyId: string }) => rotateApiKey(apiKeyId),
+    onSuccess: () => {
+      queryClient.invalidateQueries({ queryKey: ["api-keys"] });
+    },
+  });
+};
