@@ -0,0 +1,38 @@
+/**
+ * Client fetchers for the organization API-key v3 routes. Every call throws a parsed `V3ApiError`
+ * on a non-2xx response.
+ */
+import { parseV3ApiError } from "@/modules/api/lib/v3-client";
+
+const BASE_PATH = "/api/v3/organization/api-keys";
+
+/**
+ * Rotate an API key. Returns the new secret (shown once) and the updated key metadata.
+ */
+export async function rotateApiKey(apiKeyId: string): Promise<{
+  id: string;
+  label: string;
+  createdAt: string;
+  lastUsedAt: string | null;
+  organizationAccess: unknown;
+  apiKeyWorkspaces: Array<{ workspaceId: string; permission: string }>;
+  actualKey: string;
+}> {
+  const url = `${BASE_PATH}/${apiKeyId}`;
+  const response = await fetch(url, { method: "PATCH" });
+
+  if (!response.ok) {
+    throw await parseV3ApiError(response);
+  }
+
+  const body = (await response.json()) as { data: unknown };
+  return body.data as {
+    id: string;
+    label: string;
+    createdAt: string;
+    lastUsedAt: string | null;
+    organizationAccess: unknown;
+    apiKeyWorkspaces: Array<{ workspaceId: string; permission: string }>;
+    actualKey: string;
+  };
+}
