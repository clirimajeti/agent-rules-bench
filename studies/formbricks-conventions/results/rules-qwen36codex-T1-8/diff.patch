+/**
+ * PATCH  /api/v3/organization/api-keys/{apiKeyId} — rotate an API key.
+ *
+ * Session-only: matches the server action it replaces. Resolves the organization from the key
+ * itself so the caller cannot forge a scope.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { rotateV3ApiKey } from "./lib/operations";
+import { ZV3ApiKeyRotateParams } from "./lib/schemas";
+
+export const PATCH = withV3ApiWrapper({
+  auth: "session",
+  action: "updated",
+  targetType: "apiKey",
+  schemas: { params: ZV3ApiKeyRotateParams },
+  handler: async ({ authentication, parsedInput, auditLog, requestId, instance }) =>
+    rotateV3ApiKey({
+      authentication,
+      apiKeyId: parsedInput.params.apiKeyId,
+      auditLog,
+      requestId,
+      instance,
+    }),
+});
