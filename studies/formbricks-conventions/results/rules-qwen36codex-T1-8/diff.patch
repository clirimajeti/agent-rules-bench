@@ -0,0 +1,84 @@
+import "server-only";
+import { assertCan } from "@/lib/authorization";
+import { getOrganizationIdFromApiKeyId } from "@/lib/utils/helper";
+import { rotateApiKey } from "@/modules/organization/settings/api-keys/lib/api-key";
+import { problemForbidden, problemInternalError, problemUnauthorized, successResponse } from "@/app/api/v3/lib/response";
+import type { TV3AuditLog, TV3Authentication } from "@/app/api/v3/lib/types";
+
+type TBaseParams = {
+  authentication: TV3Authentication;
+  requestId: string;
+  instance?: string;
+};
+
+/**
+ * PATCH  /api/v3/organization/api-keys/{apiKeyId} — rotate an API key.
+ *
+ * Resolves the organization from the key itself so the caller cannot forge a scope.
+ * Session-only: matches the server action it replaces.
+ */
+export async function rotateV3ApiKey(
+  params: TBaseParams & { apiKeyId: string; auditLog?: TV3AuditLog }
+): Promise<Response> {
+  const { apiKeyId, auditLog, requestId, instance, authentication } = params;
+
+  // --- Auth checks ---
+  if (!authentication) {
+    return problemUnauthorized(requestId, "Not authenticated", instance);
+  }
+
+  if (!("user" in authentication) || !authentication.user?.id) {
+    return problemUnauthorized(requestId, "Session required", instance);
+  }
+
+  const userId = authentication.user.id;
+
+  // Resolve organization from the key (defense-in-depth).
+  const organizationId = await getOrganizationIdFromApiKeyId(apiKeyId);
+  if (!organizationId) {
+    return problemForbidden(requestId, "You are not authorized to access this resource", instance);
+  }
+
+  if (auditLog) {
+    auditLog.organizationId = organizationId;
+    auditLog.targetId = apiKeyId;
+  }
+
+  // Check that the user can manage this API key.
+  try {
+    await assertCan({ type: "user", id: userId }, "apiKey.manage", {
+      type: "apiKey",
+      id: apiKeyId,
+    });
+  } catch {
+    return problemForbidden(requestId, "You are not authorized to access this resource", instance);
+  }
+
+  // --- Mutation ---
+  const result = await rotateApiKey(apiKeyId, userId);
+  if (!result) {
+    return problemInternalError(requestId, "Unable to rotate API key", instance);
+  }
+
+  if (auditLog) {
+    auditLog.newObject = { apiKeyId: result.id };
+  }
+
+  return successResponse(
+    {
+      data: {
+        id: result.id,
+        label: result.label,
+        createdAt: result.createdAt.toISOString(),
+        lastUsedAt: result.lastUsedAt?.toISOString() ?? null,
+        organizationAccess: result.organizationAccess,
+        apiKeyWorkspaces: result.apiKeyWorkspaces.map((ws) => ({
+          workspaceId: ws.workspaceId,
+          permission: ws.permission,
+        })),
+        actualKey: result.actualKey,
+      },
+    },
+    { requestId }
+  );
+}
