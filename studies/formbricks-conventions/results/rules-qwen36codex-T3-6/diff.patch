@@ -0,0 +1,46 @@
+"use client";
+
+import { useCallback, useState } from "react";
+import { useTranslation } from "react-i18next";
+import { Button } from "@/modules/ui/components/button";
+
+interface DownloadMyDataProps {
+  userId: string;
+}
+
+export const DownloadMyData = ({ userId }: Readonly<DownloadMyDataProps>) => {
+  const { t } = useTranslation();
+  const [loading, setLoading] = useState(false);
+
+  const handleDownload = useCallback(async () => {
+    setLoading(true);
+    try {
+      const response = await fetch(`/api/users/${userId}/download-my-data`, {
+        method: "POST",
+      });
+      if (!response.ok) {
+        throw new Error("Failed to download data");
+      }
+      const blob = await response.blob();
+      if (typeof window !== "undefined" && typeof document !== "undefined") {
+        const link = document.createElement("a");
+        link.href = URL.createObjectURL(blob);
+        link.download = "formbricks-data.json";
+        document.body.appendChild(link);
+        link.click();
+        document.body.removeChild(link);
+        URL.revokeObjectURL(link.href);
+      }
+    } catch (error) {
+      console.error("Error downloading data:", error);
+    } finally {
+      setLoading(false);
+    }
+  }, [userId]);
+
+  return (
+    <Button variant="secondary" size="sm" onClick={handleDownload} disabled={loading}>
+      {loading ? t("common.downloading") : t("workspace.settings.profile.download_my_data")}
+    </Button>
+  );
+};
