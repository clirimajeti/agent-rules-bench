diff --git a/apps/web/app/api/users/[userId]/download-my-data/route.ts b/apps/web/app/api/users/[userId]/download-my-data/route.ts
new file mode 100644
index 000000000..19a10c0d5
--- /dev/null
+++ b/apps/web/app/api/users/[userId]/download-my-data/route.ts
@@ -0,0 +1,68 @@
+import { NextResponse } from "next/server";
+import { prisma } from "@formbricks/database";
+import { AuthenticationError, AuthorizationError } from "@formbricks/types/errors";
+import { getSession } from "@/modules/auth/lib/session";
+
+export async function POST(
+  _request: Request,
+  { params }: { params: Promise<{ userId: string }> }
+) {
+  const session = await getSession();
+  if (!session?.user) {
+    return NextResponse.json({ error: "Not authenticated" }, { status: 401 });
+  }
+
+  const { userId } = await params;
+  if (session.user.id !== userId) {
+    return NextResponse.json({ error: "Forbidden" }, { status: 403 });
+  }
+
+  const user = await prisma.user.findUnique({
+    where: { id: session.user.id },
+    select: {
+      name: true,
+      email: true,
+      locale: true,
+      notificationSettings: true,
+    },
+  });
+
+  if (!user) {
+    throw new AuthorizationError("User not found");
+  }
+
+  const memberships = await prisma.membership.findMany({
+    where: { userId: session.user.id },
+    select: {
+      organization: {
+        select: {
+          name: true,
+        },
+      },
+      role: true,
+    },
+  });
+
+  const organizations = memberships.map((m) => ({
+    name: m.organization.name,
+    role: m.role,
+  }));
+
+  const data = {
+    name: user.name,
+    email: user.email,
+    locale: user.locale,
+    notificationSettings: user.notificationSettings,
+    organizations,
+  };
+
+  const json = JSON.stringify(data, null, 2);
+  const blob = new Blob([json], { type: "application/json" });
+
+  return new NextResponse(blob, {
+    headers: {
+      "Content-Type": "application/json",
+      "Content-Disposition": 'attachment; filename="formbricks-data.json"',
+    },
+  });
+}
