@@ -0,0 +1,57 @@
+"use server";
+
+import { prisma } from "@formbricks/database";
+import { AuthenticationError, AuthorizationError } from "@formbricks/types/errors";
+import { getUser } from "@/lib/user/service";
+import { authenticatedActionClient } from "@/lib/utils/action-client";
+
+export interface TOrganizationMembership {
+  name: string;
+  role: string;
+}
+
+interface DownloadMyDataResult {
+  name: string;
+  email: string;
+  locale: string;
+  notificationSettings: Record<string, unknown> | null;
+  organizationMemberships: TOrganizationMembership[];
+}
+
+export const downloadMyDataAction = authenticatedActionClient.action(
+  async ({ ctx }) => {
+    const user = await getUser(ctx.user.id);
+    if (!user) {
+      throw new AuthorizationError("User not found");
+    }
+
+    const memberships = await prisma.membership.findMany({
+      where: {
+        userId: ctx.user.id,
+      },
+      select: {
+        role: true,
+        organization: {
+          select: {
+            name: true,
+          },
+        },
+      },
+    });
+
+    const organizationMemberships: TOrganizationMembership[] = memberships.map((m) => ({
+      name: m.organization.name,
+      role: m.role,
+    }));
+
+    const result: DownloadMyDataResult = {
+      name: user.name,
+      email: user.email,
+      locale: user.locale,
+      notificationSettings: user.notificationSettings,
+      organizationMemberships,
+    };
+
+    return { data: result };
+  }
+);
