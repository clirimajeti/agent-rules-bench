diff --git a/apps/web/app/(app)/account/settings/profile/components/DownloadMyDataButton.tsx b/apps/web/app/(app)/account/settings/profile/components/DownloadMyDataButton.tsx
new file mode 100644
index 000000000..635cbf0d1
--- /dev/null
+++ b/apps/web/app/(app)/account/settings/profile/components/DownloadMyDataButton.tsx
@@ -0,0 +1,58 @@
+"use client";
+
+import { DownloadIcon, Loader2 } from "lucide-react";
+import { useState } from "react";
+import toast from "react-hot-toast";
+import { useTranslation } from "react-i18next";
+import { Button } from "@/modules/ui/components/button";
+import { downloadMyDataAction } from "@/app/(app)/account/settings/profile/actions";
+
+export const DownloadMyDataButton = () => {
+  const { t } = useTranslation();
+  const [isDownloading, setIsDownloading] = useState(false);
+
+  const handleDownload = async () => {
+    setIsDownloading(true);
+    try {
+      const result = await downloadMyDataAction();
+      if (result?.data) {
+        const { name, email, locale, notificationSettings, organizationMemberships } = result.data;
+        const data = {
+          name,
+          email,
+          locale,
+          notificationSettings,
+          organizationMemberships,
+        };
+        const jsonString = JSON.stringify(data, null, 2);
+        const blob = new Blob([jsonString], { type: "application/json" });
+        const url = URL.createObjectURL(blob);
+        const link = document.createElement("a");
+        link.href = url;
+        link.download = `formbricks-account-data-${new Date().toISOString().slice(0, 10)}.json`;
+        document.body.appendChild(link);
+        link.click();
+        document.body.removeChild(link);
+        URL.revokeObjectURL(url);
+        toast.success(t("workspace.settings.profile.download_success"));
+      } else {
+        toast.error(t("workspace.settings.profile.download_error"));
+      }
+    } catch {
+      toast.error(t("workspace.settings.profile.download_error"));
+    } finally {
+      setIsDownloading(false);
+    }
+  };
+
+  return (
+    <Button variant="secondary" size="sm" onClick={handleDownload} disabled={isDownloading}>
+      {isDownloading ? (
+        <Loader2 className="size-4 animate-spin" />
+      ) : (
+        <DownloadIcon className="size-4" />
+      )}
+      {t("workspace.settings.profile.download_my_data")}
+    </Button>
+  );
+};
