+/**
+ * POST /api/v3/api-keys/{apiKeyId}/rotate — rotate an API key's secret.
+ *
+ * Thin adapter over the `rotateApiKey` service function, with authorization and audit logging.
+ */
+import { z } from "zod";
+import { assertCan } from "@/lib/authorization";
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { successResponse } from "@/app/api/v3/lib/response";
+import { rotateApiKey } from "@/modules/organization/settings/api-keys/lib/api-key";
+import { getOrganizationIdFromApiKeyId } from "@/lib/utils/helper";
+
+const ZRotateApiKeyParams = z.object({
+  apiKeyId: z.string().cuid2(),
+});
+
+export const POST = withV3ApiWrapper({
+  auth: "both",
+  action: "updated",
+  targetType: "apiKey",
+  schemas: { params: ZRotateApiKeyParams },
+  handler: async ({ parsedInput, authentication, auditLog, requestId }) => {
+    const apiKeyId = parsedInput.params.apiKeyId;
+
+    // Resolve organization for audit logging
+    const organizationId = await getOrganizationIdFromApiKeyId(apiKeyId);
+
+    // Build the actor for authorization checks
+    const actor =
+      authentication && "user" in authentication && authentication.user?.id
+        ? { type: "user" as const, id: authentication.user.id }
+        : { type: "apiKey" as const, id: apiKeyId };
+
+    // Authorization check
+    await assertCan(actor, "apiKey.manage", {
+      type: "apiKey",
+      id: apiKeyId,
+    });
+
+    // Audit logging
+    if (auditLog) {
+      auditLog.organizationId = organizationId;
+      auditLog.targetId = apiKeyId;
+    }
+
+    // For the userId parameter: use the authenticated user's ID when available,
+    // otherwise fall back to the apiKeyId (the function validates but does not
+    // use this value in the DB write — it is retained for audit trail).
+    const userId =
+      authentication && "user" in authentication && authentication.user?.id
+        ? authentication.user.id
+        : apiKeyId;
+
+    // Rotate the key
+    const result = await rotateApiKey(apiKeyId, userId);
+
+    if (auditLog) {
+      auditLog.newObject = { apiKeyId: result.id };
+    }
+
+    return successResponse(result, { requestId });
+  },
+});
