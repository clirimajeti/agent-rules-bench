diff --git a/apps/web/modules/account/lib/user-data-export.ts b/apps/web/modules/account/lib/user-data-export.ts
new file mode 100644
index 000000000..34fb460fc
--- /dev/null
+++ b/apps/web/modules/account/lib/user-data-export.ts
@@ -0,0 +1,51 @@
+import "server-only";
+import { prisma } from "@formbricks/database";
+import type { TOrganizationRole } from "@formbricks/types/memberships";
+import type { TUser, TUserLocale, TUserNotificationSettings } from "@formbricks/types/user";
+
+export interface TUserDataExportOrganization {
+  name: string;
+  role: TOrganizationRole;
+}
+
+export interface TUserDataExport {
+  name: string;
+  email: string;
+  locale: TUserLocale;
+  notificationSettings: TUserNotificationSettings;
+  organizations: TUserDataExportOrganization[];
+}
+
+const getOrganizationMemberships = async (userId: string): Promise<TUserDataExportOrganization[]> => {
+  const memberships = await prisma.membership.findMany({
+    where: { userId },
+    select: {
+      role: true,
+      organization: { select: { name: true } },
+    },
+    orderBy: { organization: { name: "asc" } },
+  });
+
+  return memberships.map((membership) => ({
+    name: membership.organization.name,
+    role: membership.role,
+  }));
+};
+
+/**
+ * Builds the "download my data" export for the signed-in user.
+ *
+ * Only the fields the user is shown in the profile settings are included: no ids, password or
+ * session data, and no organization content beyond the organization name and the user's role.
+ */
+export const getUserDataExport = async (user: TUser): Promise<TUserDataExport> => {
+  const organizations = await getOrganizationMemberships(user.id);
+
+  return {
+    name: user.name,
+    email: user.email,
+    locale: user.locale,
+    notificationSettings: user.notificationSettings,
+    organizations,
+  };
+};
