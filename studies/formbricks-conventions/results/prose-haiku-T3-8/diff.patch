@@ -0,0 +1,35 @@
+"use client";
+
+import { DownloadIcon } from "lucide-react";
+import { useTranslation } from "react-i18next";
+import type { TUserDataExport } from "@/modules/account/lib/user-data-export";
+import { Button } from "@/modules/ui/components/button";
+
+interface DownloadMyDataButtonProps {
+  data: TUserDataExport;
+}
+
+export const DownloadMyDataButton = ({ data }: Readonly<DownloadMyDataButtonProps>) => {
+  const { t } = useTranslation();
+
+  const handleDownload = () => {
+    const blob = new Blob([JSON.stringify(data, null, 2)], { type: "application/json" });
+    const url = URL.createObjectURL(blob);
+
+    const link = document.createElement("a");
+    link.href = url;
+    link.download = "formbricks-my-data.json";
+    document.body.appendChild(link);
+    link.click();
+    link.remove();
+
+    URL.revokeObjectURL(url);
+  };
+
+  return (
+    <Button type="button" variant="secondary" size="sm" onClick={handleDownload}>
+      <DownloadIcon className="mr-2 size-4" />
+      {t("workspace.settings.profile.download_my_data")}
+    </Button>
+  );
+};
