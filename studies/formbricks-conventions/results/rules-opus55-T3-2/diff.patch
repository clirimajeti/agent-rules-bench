+import type { TUser } from "@formbricks/types/user";
+import { formatDateTimeForDisplay } from "@/lib/utils/datetime";
+import { getTranslate } from "@/lingodotdev/server";
+import { DownloadAccountDataButton } from "@/modules/account/data-export/components/download-account-data-button";
+
+// A user has no time zone of their own, so the moments are shown in UTC and say so, rather than in
+// whatever zone the server happens to run in.
+const ACTIVITY_DATE_TIME_OPTIONS: Intl.DateTimeFormatOptions = {
+  year: "numeric",
+  month: "long",
+  day: "numeric",
+  hour: "numeric",
+  minute: "2-digit",
+  timeZone: "UTC",
+  timeZoneName: "short",
+};
+
+export const AccountActivity = async ({ user }: Readonly<{ user: TUser }>) => {
+  const t = await getTranslate();
+
+  const formatMoment = (date: Date) => formatDateTimeForDisplay(date, user.locale, ACTIVITY_DATE_TIME_OPTIONS);
+
+  return (
+    <div className="space-y-4">
+      <dl className="grid grid-cols-1 gap-4 text-sm sm:grid-cols-2">
+        <div>
+          <dt className="font-medium text-slate-700">{t("workspace.settings.profile.account_created")}</dt>
+          <dd className="mt-1 text-slate-600">
+            <time dateTime={user.createdAt.toISOString()}>{formatMoment(user.createdAt)}</time>
+          </dd>
+        </div>
+        <div>
+          <dt className="font-medium text-slate-700">{t("workspace.settings.profile.last_login")}</dt>
+          <dd className="mt-1 text-slate-600">
+            {user.lastLoginAt ? (
+              <time dateTime={user.lastLoginAt.toISOString()}>{formatMoment(user.lastLoginAt)}</time>
+            ) : (
+              t("common.no_sign_in_recorded")
+            )}
+          </dd>
+        </div>
+      </dl>
+      <div className="space-y-2 border-t border-slate-200 pt-4">
+        <p className="text-sm text-slate-600">{t("workspace.settings.profile.download_my_data_description")}</p>
+        <DownloadAccountDataButton />
+      </div>
+    </div>
+  );
+};
