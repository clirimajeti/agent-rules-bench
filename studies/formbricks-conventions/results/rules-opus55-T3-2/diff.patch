@@ -0,0 +1,14 @@
+/**
+ * GET /api/v3/account/export - the signed-in user's own personal data as JSON.
+ *
+ * Session-only, deliberately. It backs the "Download my data" button on the profile settings page and
+ * always answers for the session user, so there is nothing an API key could meaningfully export.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { exportV3Account } from "./lib/operations";
+
+export const GET = withV3ApiWrapper({
+  auth: "session",
+  handler: async ({ authentication, requestId, instance }) =>
+    exportV3Account({ authentication, requestId, instance }),
+});
