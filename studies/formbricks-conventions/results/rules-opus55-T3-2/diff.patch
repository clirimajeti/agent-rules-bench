+"use client";
+
+import { DownloadIcon } from "lucide-react";
+import { toast } from "react-hot-toast";
+import { useTranslation } from "react-i18next";
+import { getV3ApiErrorMessage } from "@/modules/api/lib/v3-client";
+import { Button } from "@/modules/ui/components/button";
+import { useDownloadAccountData } from "../hooks/use-download-account-data";
+
+export const DownloadAccountDataButton = () => {
+  const { t } = useTranslation();
+  const downloadAccountData = useDownloadAccountData();
+
+  const handleClick = () => {
+    downloadAccountData.mutate(undefined, {
+      onError: (error) => {
+        toast.error(getV3ApiErrorMessage(error, t("common.something_went_wrong_please_try_again")));
+      },
+    });
+  };
+
+  return (
+    <Button variant="secondary" size="sm" onClick={handleClick} loading={downloadAccountData.isPending}>
+      <DownloadIcon />
+      {t("workspace.settings.profile.download_my_data")}
+    </Button>
+  );
+};
diff --git a/apps/web/modules/account/data-export/hooks/use-download-account-data.ts b/apps/web/modules/account/data-export/hooks/use-download-account-data.ts
