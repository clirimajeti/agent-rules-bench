+type: object
+additionalProperties: false
+description: >-
+  The signed-in user's own personal data, as downloaded from the profile settings page.
+required:
+  - name
+  - email
+  - locale
+  - notificationSettings
+  - memberships
+properties:
+  name:
+    type: string
+  email:
+    type: string
+    format: email
+  locale:
+    type: string
+    description: The language the app is shown in, for example `en-US`.
+  notificationSettings:
+    type: object
+    description: >-
+      The user's email notification preferences, as stored. `alert` maps a survey id to whether a
+      response to it sends an email; `unsubscribedOrganizationIds` lists the organizations whose new
+      surveys the user is not subscribed to automatically.
+    properties:
+      alert:
+        type: object
+        additionalProperties:
+          type: boolean
+      unsubscribedOrganizationIds:
+        type: array
+        items:
+          type: string
+  memberships:
+    type: array
+    description: Every organization the user belongs to, ordered by organization name.
+    items:
+      type: object
+      additionalProperties: false
+      required:
+        - organizationName
+        - role
+      properties:
+        organizationName:
+          type: string
+        role:
+          type: string
+          enum:
+            - owner
+            - manager
+            - member
+            - billing
