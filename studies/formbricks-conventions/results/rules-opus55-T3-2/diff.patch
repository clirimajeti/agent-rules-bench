@@ -0,0 +1,11 @@
+import type { TV3AccountExport } from "@/app/api/v3/account/export/types";
+import { parseV3ApiError } from "@/modules/api/lib/v3-client";
+
+/** Fetch the signed-in user's own data. Throws a parsed `V3ApiError` on a non-2xx response. */
+export async function getAccountExport(): Promise<TV3AccountExport> {
+  const response = await fetch("/api/v3/account/export", { method: "GET", cache: "no-store" });
+  if (!response.ok) {
+    throw await parseV3ApiError(response);
+  }
+  return ((await response.json()) as { data: TV3AccountExport }).data;
+}
