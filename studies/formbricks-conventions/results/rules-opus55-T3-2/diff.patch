+import type { TOrganizationRole } from "@formbricks/types/memberships";
+import type { TUserLocale, TUserNotificationSettings } from "@formbricks/types/user";
+
+/** The body of `GET /api/v3/account/export` (`AccountExport` in the v3 spec). */
+export type TV3AccountExport = {
+  name: string;
+  email: string;
+  locale: TUserLocale;
+  notificationSettings: TUserNotificationSettings;
+  memberships: { organizationName: string; role: TOrganizationRole }[];
+};
