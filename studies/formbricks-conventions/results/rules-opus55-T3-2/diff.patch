+import { describe, expect, test } from "vitest";
+import type { TV3AccountExport } from "@/app/api/v3/account/export/types";
+import { getAccountExportFileName, toAccountExportBlob } from "./export-file";
+
+describe("getAccountExportFileName", () => {
+  test("dates the file by the UTC day", () => {
+    expect(getAccountExportFileName(new Date("2026-11-17T23:30:00.000-05:00"))).toBe(
+      "formbricks-account-data-2026-11-18.json"
+    );
+  });
+});
+
+describe("toAccountExportBlob", () => {
+  test("writes the export as JSON that parses back to the same data", async () => {
+    const data: TV3AccountExport = {
+      name: "Ada Lovelace",
+      email: "ada@example.com",
+      locale: "en-US",
+      notificationSettings: { alert: {} },
+      memberships: [{ organizationName: "Analytical Engines", role: "owner" }],
+    };
+
+    const blob = toAccountExportBlob(data);
+
+    expect(blob.type).toBe("application/json");
+    expect(JSON.parse(await blob.text())).toEqual(data);
+  });
+});
