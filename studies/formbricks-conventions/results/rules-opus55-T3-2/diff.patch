@@ -0,0 +1,69 @@
+import { beforeEach, describe, expect, test, vi } from "vitest";
+import { prisma } from "@formbricks/database";
+import type { Session, TAuthenticationApiKey } from "@formbricks/types/auth";
+import { exportV3Account } from "./operations";
+
+vi.mock("server-only", () => ({}));
+vi.mock("@formbricks/database", () => ({
+  prisma: { user: { findUnique: vi.fn() } },
+}));
+
+const requestId = "req-1";
+const session = { user: { id: "user_1" }, expires: "2099-01-01T00:00:00.000Z" } as Session;
+
+const storedUser = {
+  name: "Ada Lovelace",
+  email: "ada@example.com",
+  locale: "en-US",
+  notificationSettings: { alert: { survey_1: true }, unsubscribedOrganizationIds: ["org_2"] },
+  memberships: [
+    { role: "owner", organization: { name: "Analytical Engines" } },
+    { role: "member", organization: { name: "Royal Society" } },
+  ],
+};
+
+describe("exportV3Account", () => {
+  beforeEach(() => {
+    vi.clearAllMocks();
+  });
+
+  test("exports the session user's personal data and memberships", async () => {
+    vi.mocked(prisma.user.findUnique).mockResolvedValue(storedUser as never);
+
+    const response = await exportV3Account({ authentication: session, requestId });
+
+    expect(response.status).toBe(200);
+    expect(prisma.user.findUnique).toHaveBeenCalledWith(
+      expect.objectContaining({ where: { id: "user_1" } })
+    );
+    expect(await response.json()).toEqual({
+      data: {
+        name: "Ada Lovelace",
+        email: "ada@example.com",
+        locale: "en-US",
+        notificationSettings: { alert: { survey_1: true }, unsubscribedOrganizationIds: ["org_2"] },
+        memberships: [
+          { organizationName: "Analytical Engines", role: "owner" },
+          { organizationName: "Royal Society", role: "member" },
+        ],
+      },
+    });
+  });
+
+  test("never reads a user for an API key caller", async () => {
+    const apiKey = { type: "apiKey", apiKeyId: "key_1" } as unknown as TAuthenticationApiKey;
+
+    const response = await exportV3Account({ authentication: apiKey, requestId });
+
+    expect(response.status).toBe(401);
+    expect(prisma.user.findUnique).not.toHaveBeenCalled();
+  });
+
+  test("answers 401 when the session's user no longer exists", async () => {
+    vi.mocked(prisma.user.findUnique).mockResolvedValue(null);
+
+    const response = await exportV3Account({ authentication: session, requestId });
+
+    expect(response.status).toBe(401);
+  });
+});
diff --git a/apps/web/app/api/v3/account/export/lib/operations.ts b/apps/web/app/api/v3/account/export/lib/operations.ts
new file mode 100644
index 000000000..4e7e83ce7
--- /dev/null
+++ b/apps/web/app/api/v3/account/export/lib/operations.ts
@@ -0,0 +1,61 @@
+import "server-only";
+import { prisma } from "@formbricks/database";
+import { problemUnauthorized, successResponse } from "@/app/api/v3/lib/response";
+import type { TV3Authentication } from "@/app/api/v3/lib/types";
+import type { TV3AccountExport } from "../types";
+
+type TExportParams = {
+  authentication: TV3Authentication;
+  requestId: string;
+  instance?: string;
+};
+
+/**
+ * The signed-in user's own personal data, for the "Download my data" button on the profile page.
+ *
+ * Scoped to the session user only: there is no id parameter, so a caller can never export anyone else.
+ * One query reads the user with their memberships; a user belongs to a handful of organizations, so the
+ * relation is not paginated.
+ */
+export async function exportV3Account({
+  authentication,
+  requestId,
+  instance,
+}: TExportParams): Promise<Response> {
+  const userId = authentication && "user" in authentication ? authentication.user?.id : undefined;
+  if (!userId) {
+    return problemUnauthorized(requestId, "Session required", instance);
+  }
+
+  const user = await prisma.user.findUnique({
+    where: { id: userId },
+    select: {
+      name: true,
+      email: true,
+      locale: true,
+      notificationSettings: true,
+      memberships: {
+        select: { role: true, organization: { select: { name: true } } },
+        orderBy: { organization: { name: "asc" } },
+      },
+    },
+  });
+
+  // The session outlived the account (deleted in another tab): treat it as signed out.
+  if (!user) {
+    return problemUnauthorized(requestId, "Session required", instance);
+  }
+
+  const data: TV3AccountExport = {
+    name: user.name,
+    email: user.email,
+    locale: user.locale,
+    notificationSettings: user.notificationSettings,
+    memberships: user.memberships.map((membership) => ({
+      organizationName: membership.organization.name,
+      role: membership.role,
+    })),
+  };
+
+  return successResponse(data, { requestId });
+}
