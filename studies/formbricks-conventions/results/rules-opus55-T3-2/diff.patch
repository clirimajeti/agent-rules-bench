@@ -0,0 +1,9 @@
+import type { TV3AccountExport } from "@/app/api/v3/account/export/types";
+
+/** `formbricks-account-data-2026-11-17.json`, dated in UTC so the name never depends on the browser zone. */
+export const getAccountExportFileName = (now: Date): string =>
+  `formbricks-account-data-${now.toISOString().slice(0, 10)}.json`;
+
+/** The export as a pretty-printed JSON file body, so it is readable when opened directly. */
+export const toAccountExportBlob = (data: TV3AccountExport): Blob =>
+  new Blob([JSON.stringify(data, null, 2)], { type: "application/json" });
