@@ -0,0 +1,20 @@
+"use client";
+
+import { useMutation } from "@tanstack/react-query";
+import { saveBlobAsFile } from "@/modules/ee/data-retention/lib/file-download";
+import { getAccountExport } from "../lib/api-client";
+import { getAccountExportFileName, toAccountExportBlob } from "../lib/export-file";
+
+/**
+ * Fetch the signed-in user's data and save it as a JSON file.
+ *
+ * A mutation rather than a query: the download is a one-off action the user triggers, and keeping the
+ * personal data out of the query cache means nothing holds it after the file is saved.
+ */
+export const useDownloadAccountData = () =>
+  useMutation({
+    mutationFn: async () => {
+      const data = await getAccountExport();
+      saveBlobAsFile(toAccountExportBlob(data), getAccountExportFileName(new Date()));
+    },
+  });
diff --git a/apps/web/modules/account/data-export/lib/api-client.ts b/apps/web/modules/account/data-export/lib/api-client.ts
