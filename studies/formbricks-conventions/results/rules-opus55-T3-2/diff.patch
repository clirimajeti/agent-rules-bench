@@ -0,0 +1,43 @@
+get:
+  operationId: exportAccountV3
+  # Session-only by design: it always answers for the signed-in user and backs the profile page's
+  # "Download my data" button, so an API-key caller would only ever get a 401. Excluded from the
+  # generated docs pages like the tags operations; it stays in the bundle for the contract tests.
+  x-excluded: true
+  summary: Export my account data
+  description: |
+    Returns the signed-in user's own personal data: name, email, locale, notification settings and
+    organization memberships (organization name and role).
+
+    Session cookie only. It takes no parameters and can only ever export the caller's own account.
+  tags:
+    - V3 Account
+  responses:
+    "200":
+      description: Account data retrieved successfully
+      headers:
+        X-Request-Id:
+          schema:
+            type: string
+          description: Request correlation ID
+        Cache-Control:
+          schema:
+            type: string
+          example: private, no-store
+      content:
+        application/json:
+          schema:
+            type: object
+            required:
+              - data
+            properties:
+              data:
+                $ref: ../components/schemas/AccountExport.yml
+    "401":
+      $ref: ../components/responses/V3UnauthorizedSession.yml
+    "429":
+      $ref: ../components/responses/V3TooManyRequests.yml
+    "500":
+      $ref: ../components/responses/V3InternalServerError.yml
+  security:
+    - sessionAuth: []
