+/**
+ * /api/v3/api-keys/{apiKeyId}/rotate - replace a key's secret, keeping its label and access. Session only:
+ * a key cannot rotate itself or another key.
+ */
+import { z } from "zod";
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { ZV3EmptyQuery } from "@/app/api/v3/lib/schemas";
+import { rotateV3ApiKey } from "../../lib/operations";
+
+const ZV3RotateApiKeyParams = z.object({ apiKeyId: z.cuid2() });
+
+export const POST = withV3ApiWrapper({
+  auth: "session",
+  action: "updated",
+  targetType: "apiKey",
+  schemas: { params: ZV3RotateApiKeyParams, query: ZV3EmptyQuery },
+  handler: async ({ parsedInput, authentication, auditLog, requestId, instance }) =>
+    rotateV3ApiKey({
+      apiKeyId: parsedInput.params.apiKeyId,
+      authentication,
+      auditLog,
+      requestId,
+      instance,
+    }),
+});
diff --git a/apps/web/app/api/v3/api-keys/lib/operations.ts b/apps/web/app/api/v3/api-keys/lib/operations.ts
