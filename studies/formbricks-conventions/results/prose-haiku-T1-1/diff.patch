--- /dev/null
+++ b/apps/web/app/api/v3/api-keys/lib/operations.ts
@@ -0,0 +1,68 @@
+import "server-only";
+import { logger } from "@formbricks/logger";
+import { getV3SessionUserId } from "@/app/api/v3/lib/auth";
+import { mapV3ThrownError } from "@/app/api/v3/lib/errors";
+import { problemForbidden, problemUnauthorized, successResponse } from "@/app/api/v3/lib/response";
+import type { TV3AuditLog, TV3Authentication } from "@/app/api/v3/lib/types";
+import { assertCan } from "@/lib/authorization";
+import {
+  getApiKeyRotationScope,
+  rotateApiKey,
+} from "@/modules/organization/settings/api-keys/lib/api-key";
+import { assertCanGrantOrganizationAccess } from "@/modules/organization/settings/api-keys/lib/organization-access";
+
+type TRotateV3ApiKeyParams = {
+  apiKeyId: string;
+  authentication: TV3Authentication;
+  auditLog?: TV3AuditLog;
+  requestId: string;
+  instance: string;
+};
+
+/**
+ * Rotate an API key's secret (session users only). The response carries the new plaintext once; it is
+ * never written to logs or the audit trail.
+ *
+ * Rotating is a write to the key, so it needs `apiKey.manage` on that key. It also re-runs the grant
+ * check that creating the key ran: a key whose access includes user management can only be re-minted by
+ * someone allowed to grant that access, otherwise rotation would hand out a more capable secret than the
+ * caller could create.
+ */
+export async function rotateV3ApiKey(params: TRotateV3ApiKeyParams): Promise<Response> {
+  const { apiKeyId, authentication, auditLog, requestId, instance } = params;
+  const log = logger.withContext({ requestId, apiKeyId });
+  const userId = getV3SessionUserId(authentication);
+
+  if (!userId) {
+    return problemUnauthorized(requestId, "Session required", instance);
+  }
+
+  try {
+    const scope = await getApiKeyRotationScope(apiKeyId);
+    if (!scope) {
+      // Unknown ids answer 403, not 404, so the response does not reveal which keys exist.
+      return problemForbidden(requestId, "You are not authorized to access this resource", instance);
+    }
+
+    await assertCan({ type: "user", id: userId }, "apiKey.manage", { type: "apiKey", id: apiKeyId });
+    await assertCanGrantOrganizationAccess(userId, scope.organizationId, scope.organizationAccess);
+
+    if (auditLog) {
+      auditLog.organizationId = scope.organizationId;
+      auditLog.targetId = apiKeyId;
+    }
+
+    const rotated = await rotateApiKey(apiKeyId);
+
+    if (auditLog) {
+      auditLog.status = "success";
+    }
+
+    return successResponse(
+      { id: rotated.id, key: rotated.actualKey },
+      { requestId, cache: "private, no-store" }
+    );
+  } catch (error) {
+    return mapV3ThrownError(error, { instance, log, operation: "apiKeys.rotate", requestId });
+  }
+}
