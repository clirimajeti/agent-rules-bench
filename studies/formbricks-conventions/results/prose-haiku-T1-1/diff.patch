+} from "@/modules/ui/components/dialog";
+
+interface RotatedApiKeyModalProps {
+  open: boolean;
+  setOpen: (open: boolean) => void;
+  apiKey: string;
+}
+
+/**
+ * Shows a rotated secret exactly once. Closing the modal discards the plaintext; the key cannot be
+ * recovered afterwards, only rotated again.
+ */
+export const RotatedApiKeyModal = ({ open, setOpen, apiKey }: Readonly<RotatedApiKeyModalProps>) => {
+  const { t } = useTranslation();
+
+  const copyToClipboard = async () => {
+    try {
+      await navigator.clipboard.writeText(apiKey);
+      toast.success(t("workspace.api_keys.api_key_copied_to_clipboard"));
+    } catch {
+      toast.error(t("workspace.api_keys.unable_to_copy_api_key"));
+    }
+  };
+
+  return (
+    <Dialog open={open} onOpenChange={setOpen}>
+      <DialogContent width="narrow" disableCloseOnOutsideClick={true}>
+        <DialogHeader>
+          <div className="flex items-center gap-2">
+            <CircleAlert className="size-4" />
+            <div>
+              <DialogTitle>{t("workspace.api_keys.rotated_api_key_title")}</DialogTitle>
+              <DialogDescription>{t("workspace.api_keys.api_key_security_warning")}</DialogDescription>
+            </div>
+          </div>
+        </DialogHeader>
+
+        <DialogBody>
+          <div className="flex items-center justify-between gap-2 rounded-md bg-slate-100 p-3">
+            <code className="break-all font-mono text-sm" data-testid="rotated-api-key">
+              {apiKey}
+            </code>
+            <Button
+              size="icon"
+              variant="ghost"
+              aria-label={t("common.copy")}
+              onClick={() => void copyToClipboard()}>
+              <CopyIcon />
+            </Button>
+          </div>
+          <DialogDescription className="mt-3">
+            {t("workspace.api_keys.rotated_api_key_description")}
+          </DialogDescription>
+        </DialogBody>
+
+        <DialogFooter>
+          <Button variant="secondary" onClick={() => setOpen(false)}>
+            {t("common.close")}
+          </Button>
+        </DialogFooter>
+      </DialogContent>
+    </Dialog>
+  );
+};
