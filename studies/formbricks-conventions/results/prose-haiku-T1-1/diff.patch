@@ -0,0 +1,18 @@
+import { parseV3ApiError } from "@/modules/api/lib/v3-client";
+
+export type TRotatedApiKey = { id: string; key: string };
+
+/** Replace an API key's secret. The returned `key` is the only time the new plaintext is available. */
+export async function rotateApiKey(apiKeyId: string): Promise<TRotatedApiKey> {
+  const response = await fetch(`/api/v3/api-keys/${apiKeyId}/rotate`, {
+    method: "POST",
+    cache: "no-store",
+  });
+
+  if (!response.ok) {
+    throw await parseV3ApiError(response);
+  }
+
+  const responseBody = (await response.json()) as { data: TRotatedApiKey };
+  return responseBody.data;
+}
