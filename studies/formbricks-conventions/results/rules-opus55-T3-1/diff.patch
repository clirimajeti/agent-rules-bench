@@ -13,3 +18,37 @@ export const getIsEmailUnique = reactCache(async (email: string): Promise<boolea
 
   return !user;
 });
+
+/**
+ * The organizations the user belongs to, with their role in each, for the "Download my data" export.
+ *
+ * Scoped by `userId`, which the caller takes from the session, so a user only ever reads their own
+ * memberships. One query: the organization name is joined in rather than fetched per membership.
+ */
+export const getUserOrganizationMemberships = reactCache(
+  async (userId: string): Promise<TAccountOrganizationMembership[]> => {
+    validateInputs([userId, ZId]);
+
+    try {
+      const memberships = await prisma.membership.findMany({
+        where: { userId },
+        select: {
+          role: true,
+          organization: { select: { name: true } },
+        },
+        orderBy: { organization: { name: "asc" } },
+      });
+
+      return memberships.map((membership) => ({
+        organizationName: membership.organization.name,
+        role: membership.role,
+      }));
+    } catch (error) {
+      if (error instanceof Prisma.PrismaClientKnownRequestError) {
+        throw new DatabaseError(error.message);
+      }
+
+      throw error;
+    }
+  }
+);
