@@ -0,0 +1,40 @@
+import type { TOrganizationRole } from "@formbricks/types/memberships";
+import type { TUser, TUserLocale, TUserNotificationSettings } from "@formbricks/types/user";
+
+export type TAccountOrganizationMembership = {
+  organizationName: string;
+  role: TOrganizationRole;
+};
+
+export type TAccountDataExport = {
+  name: string;
+  email: string;
+  locale: TUserLocale;
+  notificationSettings: TUserNotificationSettings;
+  organizationMemberships: TAccountOrganizationMembership[];
+};
+
+/**
+ * The personal data a user can download from their profile. An explicit allowlist, so a field later
+ * added to `TUser` (or to a membership) never ends up in the file by accident.
+ */
+export const buildAccountDataExport = (
+  user: Pick<TUser, "name" | "email" | "locale" | "notificationSettings">,
+  memberships: TAccountOrganizationMembership[]
+): TAccountDataExport => ({
+  name: user.name,
+  email: user.email,
+  locale: user.locale,
+  notificationSettings: {
+    alert: { ...user.notificationSettings.alert },
+    ...(user.notificationSettings.unsubscribedOrganizationIds && {
+      unsubscribedOrganizationIds: [...user.notificationSettings.unsubscribedOrganizationIds],
+    }),
+  },
+  organizationMemberships: memberships.map(({ organizationName, role }) => ({ organizationName, role })),
+});
+
+export const ACCOUNT_DATA_EXPORT_FILE_NAME = "formbricks-my-data.json";
+
+export const serializeAccountDataExport = (data: TAccountDataExport): string =>
+  JSON.stringify(data, null, 2);
