+import { describe, expect, test } from "vitest";
+import type { TUser } from "@formbricks/types/user";
+import { buildAccountDataExport, serializeAccountDataExport } from "./account-data-export";
+
+const user = {
+  id: "clzt5rl8w0000mc08v7n0ff2p",
+  name: "Ada Lovelace",
+  email: "ada@example.com",
+  emailVerified: true,
+  twoFactorEnabled: true,
+  identityProvider: "email",
+  createdAt: new Date("2024-01-02T03:04:05.000Z"),
+  updatedAt: new Date("2024-02-02T03:04:05.000Z"),
+  notificationSettings: { alert: { survey1: true }, unsubscribedOrganizationIds: ["org1"] },
+  locale: "de-DE",
+  lastLoginAt: new Date("2024-03-02T03:04:05.000Z"),
+  isActive: true,
+} as TUser;
+
+describe("buildAccountDataExport", () => {
+  test("exports only the allowlisted personal fields and memberships", () => {
+    const result = buildAccountDataExport(user, [
+      { organizationName: "Acme", role: "owner" },
+      { organizationName: "Globex", role: "member" },
+    ]);
+
+    expect(result).toEqual({
+      name: "Ada Lovelace",
+      email: "ada@example.com",
+      locale: "de-DE",
+      notificationSettings: { alert: { survey1: true }, unsubscribedOrganizationIds: ["org1"] },
+      organizationMemberships: [
+        { organizationName: "Acme", role: "owner" },
+        { organizationName: "Globex", role: "member" },
+      ],
+    });
+  });
+
+  test("drops fields that are not part of the export, even when present at runtime", () => {
+    const membership = { organizationName: "Acme", role: "owner", organizationId: "org1" } as never;
+
+    const serialized = serializeAccountDataExport(buildAccountDataExport(user, [membership]));
+
+    for (const leaked of ["clzt5rl8w0000mc08v7n0ff2p", "twoFactorEnabled", "identityProvider", "organizationId"]) {
+      expect(serialized).not.toContain(leaked);
+    }
+    expect(JSON.parse(serialized).organizationMemberships).toEqual([
+      { organizationName: "Acme", role: "owner" },
+    ]);
+  });
+
+  test("omits unsubscribedOrganizationIds when the user has none", () => {
+    const result = buildAccountDataExport({ ...user, notificationSettings: { alert: {} } }, []);
+
+    expect(result.notificationSettings).toEqual({ alert: {} });
+    expect(result.organizationMemberships).toEqual([]);
+  });
+});
diff --git a/apps/web/app/(app)/workspaces/[workspaceId]/settings/account/profile/lib/account-data-export.ts b/apps/web/app/(app)/workspaces/[workspaceId]/settings/account/profile/lib/account-data-export.ts
