+"use client";
+
+import { DownloadIcon } from "lucide-react";
+import { useTranslation } from "react-i18next";
+import {
+  ACCOUNT_DATA_EXPORT_FILE_NAME,
+  type TAccountDataExport,
+  serializeAccountDataExport,
+} from "@/app/(app)/workspaces/[workspaceId]/settings/account/profile/lib/account-data-export";
+import { saveBlobAsFile } from "@/modules/ee/data-retention/lib/file-download";
+import { Button } from "@/modules/ui/components/button";
+
+interface AccountActivityProps {
+  /** Already formatted for display on the server, in the user's locale. */
+  createdAt: string;
+  /** Already formatted for display on the server; null when no sign-in has been recorded. */
+  lastLoginAt: string | null;
+  dataExport: TAccountDataExport;
+}
+
+export const AccountActivity = ({ createdAt, lastLoginAt, dataExport }: Readonly<AccountActivityProps>) => {
+  const { t } = useTranslation();
+
+  const handleDownload = () => {
+    const blob = new Blob([serializeAccountDataExport(dataExport)], { type: "application/json" });
+    saveBlobAsFile(blob, ACCOUNT_DATA_EXPORT_FILE_NAME);
+  };
+
+  return (
+    <div className="space-y-4">
+      <dl className="grid grid-cols-1 gap-4 text-sm sm:grid-cols-2">
+        <div>
+          <dt className="font-medium text-slate-700">{t("workspace.settings.profile.account_created")}</dt>
+          <dd className="mt-1 text-slate-600">{createdAt}</dd>
+        </div>
+        <div>
+          <dt className="font-medium text-slate-700">{t("workspace.settings.profile.last_login")}</dt>
+          <dd className="mt-1 text-slate-600">
+            {lastLoginAt ?? t("workspace.settings.profile.last_login_not_recorded")}
+          </dd>
+        </div>
+      </dl>
+      <Button type="button" variant="secondary" size="sm" onClick={handleDownload}>
+        <DownloadIcon aria-hidden="true" />
+        {t("workspace.settings.profile.download_my_data")}
+      </Button>
+    </div>
+  );
+};
