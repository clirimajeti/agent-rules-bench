@@ -0,0 +1,59 @@
+post:
+  operationId: deleteUnusedTagsV3
+  # Session-only by design, like the other tag operations: excluded from the published pages, kept in the
+  # bundle for the contract tests (see ENG-2533).
+  x-excluded: true
+  summary: Delete unused tags
+  description: |
+    Deletes every tag of the workspace that is not carried by any response, and returns how many were
+    deleted.
+
+    A tag counts as used when any response carries it, including responses the caller cannot read. Same
+    authorization as deleting a single tag.
+  tags:
+    - V3 Tags
+  requestBody:
+    required: true
+    content:
+      application/json:
+        schema:
+          type: object
+          additionalProperties: false
+          required:
+            - workspaceId
+          properties:
+            workspaceId:
+              type: string
+              format: cuid2
+              description: Workspace whose unused tags are deleted.
+  responses:
+    "200":
+      description: Unused tags deleted successfully
+      content:
+        application/json:
+          schema:
+            type: object
+            required:
+              - data
+            properties:
+              data:
+                type: object
+                required:
+                  - deletedCount
+                properties:
+                  deletedCount:
+                    type: integer
+                    minimum: 0
+                    description: Number of tags deleted. `0` when every tag is in use.
+    "400":
+      $ref: ../components/responses/V3BadRequest.yml
+    "401":
+      $ref: ../components/responses/V3UnauthorizedSession.yml
+    "403":
+      $ref: ../components/responses/V3Forbidden.yml
+    "429":
+      $ref: ../components/responses/V3TooManyRequests.yml
+    "500":
+      $ref: ../components/responses/V3InternalServerError.yml
+  security:
+    - sessionAuth: []
