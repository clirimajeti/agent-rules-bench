+/**
+ * Deletes every tag of the workspace that no response carries, and reports how many went. The "unused"
+ * check reads the junction table directly, not the caller-visible counts shown in the list: a tag used
+ * only on responses the caller cannot see is still in use. One statement, so a tag applied while this
+ * runs is either kept or was already unused - never deleted out from under a response.
+ */
+export const deleteUnusedTags = async (
+  workspaceId: string
+): Promise<Result<{ deletedCount: number }, { code: TagError; message: string }>> => {
+  validateInputs([workspaceId, ZId]);
+
+  try {
+    const { count } = await prisma.tag.deleteMany({
+      where: { workspaceId, responses: { none: {} } },
+    });
+
+    return ok({ deletedCount: count });
+  } catch (error) {
+    return err({
+      code: TagError.UNEXPECTED_ERROR,
+      message: error instanceof Error ? error.message : "Unknown error occurred",
+    });
+  }
+};
