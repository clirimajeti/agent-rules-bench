+/**
+ * POST /api/v3/tags/delete-unused - delete every tag of the workspace that no response carries.
+ *
+ * Session-only, like the other tag routes. The workspace comes from the body because there is no tag to
+ * resolve it from; access is checked against it with `readWrite`, the same bar as deleting a single tag.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { deleteUnusedV3Tags } from "../lib/operations";
+import { ZV3DeleteUnusedTagsBody } from "../lib/schemas";
+
+export const POST = withV3ApiWrapper({
+  auth: "session",
+  action: "deleted",
+  targetType: "tag",
+  schemas: { body: ZV3DeleteUnusedTagsBody },
+  handler: async ({ authentication, parsedInput, auditLog, requestId, instance }) =>
+    deleteUnusedV3Tags({
+      authentication,
+      workspaceId: parsedInput.body.workspaceId,
+      auditLog,
+      requestId,
+      instance,
+    }),
+});
