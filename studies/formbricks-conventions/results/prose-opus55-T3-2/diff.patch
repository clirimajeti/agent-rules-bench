+import "server-only";
+import { prisma } from "@formbricks/database";
+
+/**
+ * Everything the account data export carries, read in one query. A user belongs to a handful of
+ * organizations at most, so the nested membership list needs no pagination.
+ */
+export const getAccountDataExportSource = (userId: string) =>
+  prisma.user.findUnique({
+    where: { id: userId },
+    select: {
+      name: true,
+      email: true,
+      locale: true,
+      notificationSettings: true,
+      memberships: {
+        select: {
+          role: true,
+          organization: { select: { name: true } },
+        },
+        orderBy: { organization: { name: "asc" } },
+      },
+    },
+  });
+
+export type TAccountDataExportSource = NonNullable<Awaited<ReturnType<typeof getAccountDataExportSource>>>;
