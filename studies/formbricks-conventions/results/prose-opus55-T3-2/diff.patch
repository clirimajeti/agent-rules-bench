+/**
+ * GET /api/v3/me/data-export - the signed-in user's account data, for the "Download my data" button on
+ * the profile settings page.
+ *
+ * Session-only, deliberately: the export is personal data about the person signed in, and an API key
+ * belongs to an organization, not to a person.
+ */
+import { z } from "zod";
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { getV3AccountDataExport } from "./lib/operations";
+
+export const GET = withV3ApiWrapper({
+  auth: "session",
+  // No query parameters: an unknown one answers 400 rather than being silently ignored.
+  schemas: { query: z.object({}).strict() },
+  handler: async ({ authentication, requestId, instance }) =>
+    getV3AccountDataExport({ authentication, requestId, instance }),
+});
