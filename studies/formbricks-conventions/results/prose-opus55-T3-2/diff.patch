+"use client";
+
+import { useMutation } from "@tanstack/react-query";
+import { saveBlobAsFile } from "@/modules/ee/data-retention/lib/file-download";
+import { getAccountDataExport, getAccountDataExportFileName } from "../lib/api-client";
+
+/**
+ * Fetch the account data and hand it to the browser as a JSON file. A mutation rather than a query:
+ * the export is a one-off download the user asks for, not server state the page reads or caches.
+ */
+export const useDownloadAccountData = () =>
+  useMutation({
+    mutationFn: getAccountDataExport,
+    onSuccess: (data) => {
+      const blob = new Blob([JSON.stringify(data, null, 2)], { type: "application/json" });
+      saveBlobAsFile(blob, getAccountDataExportFileName(new Date()));
+    },
+  });
