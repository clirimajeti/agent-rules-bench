@@ -0,0 +1,15 @@
+import type { TV3AccountDataExport } from "@/app/api/v3/me/data-export/serializers";
+import { parseV3ApiError } from "@/modules/api/lib/v3-client";
+
+/** Fetch the signed-in user's account data. Throws a parsed `V3ApiError` on a non-2xx response. */
+export async function getAccountDataExport(): Promise<TV3AccountDataExport> {
+  const response = await fetch("/api/v3/me/data-export", { method: "GET", cache: "no-store" });
+  if (!response.ok) {
+    throw await parseV3ApiError(response);
+  }
+  return ((await response.json()) as { data: TV3AccountDataExport }).data;
+}
+
+/** The download's file name, dated in UTC so it does not depend on the browser's time zone. */
+export const getAccountDataExportFileName = (now: Date): string =>
+  `formbricks-account-data-${now.toISOString().slice(0, 10)}.json`;
