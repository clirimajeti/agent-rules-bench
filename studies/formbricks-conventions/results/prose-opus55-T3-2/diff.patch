@@ -0,0 +1,31 @@
+import "server-only";
+import { getV3SessionUserId } from "@/app/api/v3/lib/auth";
+import { problemUnauthorized, successResponse } from "@/app/api/v3/lib/response";
+import type { TV3Authentication } from "@/app/api/v3/lib/types";
+import { serializeV3AccountDataExport } from "../serializers";
+import { getAccountDataExportSource } from "./service";
+
+/**
+ * The signed-in user's own account data. The user id comes from the session alone and the route takes
+ * no identifier, so a caller can only ever export themselves.
+ */
+export async function getV3AccountDataExport(params: {
+  authentication: TV3Authentication;
+  requestId: string;
+  instance?: string;
+}): Promise<Response> {
+  const { authentication, requestId, instance } = params;
+
+  const userId = getV3SessionUserId(authentication);
+  if (!userId) {
+    return problemUnauthorized(requestId, "Session required", instance);
+  }
+
+  const source = await getAccountDataExportSource(userId);
+  // A session whose user has since been deleted is no longer an authenticated caller.
+  if (!source) {
+    return problemUnauthorized(requestId, "Not authenticated", instance);
+  }
+
+  return successResponse(serializeV3AccountDataExport(source), { requestId });
+}
