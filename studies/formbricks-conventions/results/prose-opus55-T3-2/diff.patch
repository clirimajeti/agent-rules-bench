+get:
+  operationId: getAccountDataExportV3
+  # Session-only by design, so an API-key caller reading the published reference would only ever get a
+  # 401. Excluded from the generated docs pages like the session-only tag operations (ENG-2533); the
+  # operation stays in the bundle for the contract tests.
+  x-excluded: true
+  summary: Export my account data
+  description: |
+    Returns the signed-in user's own account data: name, email, locale, notification settings and
+    organization memberships (organization name and role).
+
+    Session cookie only. The export backs the "Download my data" button on the profile settings page
+    and always describes the user behind the session, so it takes no identifier and does not accept
+    `x-api-key`.
+  tags:
+    - V3 Account
+  responses:
+    "200":
+      description: Account data retrieved successfully
+      headers:
+        X-Request-Id:
+          schema:
+            type: string
+          description: Request correlation ID
+        Cache-Control:
+          schema:
+            type: string
+          example: private, no-store
+      content:
+        application/json:
+          schema:
+            type: object
+            required:
+              - data
+            properties:
+              data:
+                $ref: ../components/schemas/AccountDataExport.yml
+    "400":
+      $ref: ../components/responses/V3BadRequest.yml
+    "401":
+      $ref: ../components/responses/V3UnauthorizedSession.yml
+    "429":
+      $ref: ../components/responses/V3TooManyRequests.yml
+    "500":
+      $ref: ../components/responses/V3InternalServerError.yml
+  security:
+    - sessionAuth: []
