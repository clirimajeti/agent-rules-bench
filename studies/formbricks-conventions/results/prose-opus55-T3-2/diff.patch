+import { beforeEach, describe, expect, test, vi } from "vitest";
+import type { TV3Authentication } from "@/app/api/v3/lib/types";
+import { getV3AccountDataExport } from "./operations";
+import { getAccountDataExportSource } from "./service";
+
+vi.mock("server-only", () => ({}));
+vi.mock("./service", () => ({ getAccountDataExportSource: vi.fn() }));
+
+const userId = "clus1234567890123456789012";
+const session = { user: { id: userId } } as unknown as TV3Authentication;
+const base = { requestId: "req_1", instance: "/api/v3/me/data-export" };
+
+const source = {
+  name: "Ada Lovelace",
+  email: "ada@example.com",
+  locale: "en-US" as const,
+  notificationSettings: {
+    alert: { survey1: true },
+    unsubscribedOrganizationIds: ["org1"],
+    // A key the app no longer reads must not reach the export.
+    weeklySummary: { workspace1: true },
+  },
+  memberships: [
+    { role: "owner" as const, organization: { name: "Acme" } },
+    { role: "member" as const, organization: { name: "Globex" } },
+  ],
+};
+
+beforeEach(() => {
+  vi.resetAllMocks();
+});
+
+describe("getV3AccountDataExport", () => {
+  test("exports the session user's profile, notification settings and memberships", async () => {
+    vi.mocked(getAccountDataExportSource).mockResolvedValue(source);
+
+    const response = await getV3AccountDataExport({ ...base, authentication: session });
+
+    expect(response.status).toBe(200);
+    expect(getAccountDataExportSource).toHaveBeenCalledWith(userId);
+    expect((await response.json()).data).toEqual({
+      name: "Ada Lovelace",
+      email: "ada@example.com",
+      locale: "en-US",
+      notificationSettings: { alert: { survey1: true }, unsubscribedOrganizationIds: ["org1"] },
+      organizationMemberships: [
+        { organizationName: "Acme", role: "owner" },
+        { organizationName: "Globex", role: "member" },
+      ],
+    });
+  });
+
+  test("answers 401 to an API key without reading any user", async () => {
+    const apiKey = { apiKeyId: "key_1" } as unknown as TV3Authentication;
+
+    const response = await getV3AccountDataExport({ ...base, authentication: apiKey });
+
+    expect(response.status).toBe(401);
+    expect(getAccountDataExportSource).not.toHaveBeenCalled();
+  });
+
+  test("answers 401 when the session's user no longer exists", async () => {
+    vi.mocked(getAccountDataExportSource).mockResolvedValue(null);
+
+    const response = await getV3AccountDataExport({ ...base, authentication: session });
+
+    expect(response.status).toBe(401);
+  });
+});
