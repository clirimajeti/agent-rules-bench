@@ -0,0 +1,39 @@
+import type { TOrganizationRole } from "@formbricks/types/memberships";
+import {
+  type TUserLocale,
+  type TUserNotificationSettings,
+  ZUserNotificationSettings,
+} from "@formbricks/types/user";
+import type { TAccountDataExportSource } from "./lib/service";
+
+export type TV3AccountDataExport = {
+  name: string;
+  email: string;
+  locale: TUserLocale;
+  notificationSettings: TUserNotificationSettings;
+  organizationMemberships: {
+    organizationName: string;
+    role: TOrganizationRole;
+  }[];
+};
+
+/**
+ * `notificationSettings` is an untyped JSON column. Parsing it keeps the export to the documented shape:
+ * keys the app no longer reads are dropped, and a row that predates the current shape exports as "no
+ * alerts" rather than leaking whatever the column happens to hold.
+ */
+const toNotificationSettings = (value: unknown): TUserNotificationSettings => {
+  const parsed = ZUserNotificationSettings.safeParse(value);
+  return parsed.success ? parsed.data : { alert: {} };
+};
+
+export const serializeV3AccountDataExport = (source: TAccountDataExportSource): TV3AccountDataExport => ({
+  name: source.name,
+  email: source.email,
+  locale: source.locale,
+  notificationSettings: toNotificationSettings(source.notificationSettings),
+  organizationMemberships: source.memberships.map((membership) => ({
+    organizationName: membership.organization.name,
+    role: membership.role,
+  })),
+});
