+import type { TUser } from "@formbricks/types/user";
+import { formatDateTimeForDisplay } from "@/lib/utils/datetime";
+import { getTranslate } from "@/lingodotdev/server";
+
+// A user has no time zone of their own and the account spans organizations, so there is no product-level
+// zone to read in. Times are shown in UTC and say so, rather than in whatever zone the server runs in.
+const ACTIVITY_DATE_TIME_OPTIONS: Intl.DateTimeFormatOptions = {
+  year: "numeric",
+  month: "long",
+  day: "numeric",
+  hour: "numeric",
+  minute: "2-digit",
+  timeZone: "UTC",
+  timeZoneName: "short",
+};
+
+interface AccountActivityProps {
+  user: Pick<TUser, "createdAt" | "lastLoginAt" | "locale">;
+}
+
+export const AccountActivity = async ({ user }: Readonly<AccountActivityProps>) => {
+  const t = await getTranslate();
+  const formatDateTime = (date: Date) =>
+    formatDateTimeForDisplay(date, user.locale, ACTIVITY_DATE_TIME_OPTIONS);
+
+  return (
+    <dl className="grid gap-4 text-sm sm:grid-cols-2">
+      <div>
+        <dt className="font-medium text-slate-900">{t("workspace.settings.profile.account_created")}</dt>
+        <dd className="mt-1 text-slate-700">{formatDateTime(user.createdAt)}</dd>
+      </div>
+      <div>
+        <dt className="font-medium text-slate-900">{t("workspace.settings.profile.last_login")}</dt>
+        <dd className="mt-1 text-slate-700">
+          {user.lastLoginAt ? (
+            formatDateTime(user.lastLoginAt)
+          ) : (
+            <span className="text-slate-500">{t("common.no_sign_in_recorded")}</span>
+          )}
+        </dd>
+      </div>
+    </dl>
+  );
+};
