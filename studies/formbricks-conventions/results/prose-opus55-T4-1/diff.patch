+/**
+ * POST /api/v3/tags/delete-unused — delete every tag of a workspace that no response carries, and report
+ * how many were deleted. Session-only, like the other tag operations.
+ *
+ * A static segment, so it takes precedence over `/api/v3/tags/{tagId}`; `delete-unused` is not a cuid2
+ * and could never name a tag.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { ZV3EmptyQuery } from "@/app/api/v3/lib/schemas";
+import { deleteUnusedV3Tags } from "../lib/operations";
+import { ZV3DeleteUnusedTagsBody } from "../lib/schemas";
+
+export const POST = withV3ApiWrapper({
+  auth: "session",
+  action: "deleted",
+  targetType: "tag",
+  schemas: { query: ZV3EmptyQuery, body: ZV3DeleteUnusedTagsBody },
+  handler: async ({ authentication, parsedInput, auditLog, requestId, instance }) =>
+    deleteUnusedV3Tags({
+      authentication,
+      workspaceId: parsedInput.body.workspaceId,
+      auditLog,
+      requestId,
+      instance,
+    }),
+});
