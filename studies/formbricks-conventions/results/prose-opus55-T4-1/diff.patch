+/**
+ * Delete every tag of a workspace that no response carries, and return the deleted rows.
+ *
+ * "Unused" means unused on any response at all, not only on the responses the caller may read: the
+ * visibility-filtered counts on the tags list are not a safe basis for a delete, since a tag that only
+ * appears on hidden responses would show a zero there.
+ *
+ * The delete repeats the `none` condition, so a tag applied to a response between the read and the
+ * delete survives instead of being cascaded off that response. The returned rows are the ones actually
+ * deleted, re-read inside the same transaction.
+ */
+export const deleteUnusedTags = async (
+  workspaceId: string
+): Promise<Result<TTag[], { code: TagError; message: string; meta?: Record<string, string> }>> => {
+  validateInputs([workspaceId, ZId]);
+
+  try {
+    const deletedTags = await prisma.$transaction(async (tx) => {
+      const candidates = await tx.tag.findMany({
+        where: { workspaceId, responses: { none: {} } },
+      });
+
+      if (candidates.length === 0) return [];
+
+      const candidateIds = candidates.map((tag) => tag.id);
+      await tx.tag.deleteMany({
+        where: { id: { in: candidateIds }, workspaceId, responses: { none: {} } },
+      });
+
+      // A candidate that is still present was applied to a response after the read and kept.
+      const survivors = await tx.tag.findMany({
+        where: { id: { in: candidateIds } },
+        select: { id: true },
+      });
+      const survivorIds = new Set(survivors.map((tag) => tag.id));
+
+      return candidates.filter((tag) => !survivorIds.has(tag.id));
+    });
+
+    return ok(deletedTags);
+  } catch (error) {
+    return err({
+      code: TagError.UNEXPECTED_ERROR,
+      message: error instanceof Error ? error.message : "Unknown error occurred",
+    });
+  }
+};
