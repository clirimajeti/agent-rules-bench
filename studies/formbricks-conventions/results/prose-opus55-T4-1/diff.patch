+/**
+ * Delete every tag of the workspace that no response carries. Same authorization as the per-tag
+ * mutations, checked against the workspace named in the body; the delete itself is scoped to that
+ * workspace, so the id cannot reach another tenant's tags.
+ *
+ * Each deleted tag gets its own audit entry, as a single `DELETE /api/v3/tags/{tagId}` would, so the
+ * trail reads the same whichever way a tag was removed. A run that deletes nothing is not audited.
+ */
+export async function deleteUnusedV3Tags(
+  params: TBaseParams & { workspaceId: string; auditLog?: TV3AuditLog }
+): Promise<Response> {
+  const { authentication, workspaceId, auditLog, requestId, instance } = params;
+
+  const access = await requireV3WorkspaceAccess(
+    authentication,
+    workspaceId,
+    "readWrite",
+    requestId,
+    instance
+  );
+  if (access instanceof Response) return access;
+
+  if (auditLog) auditLog.organizationId = access.organizationId;
+
+  const result = await deleteUnusedTags(access.workspaceId);
+  if (!result.ok) {
+    return problemInternalError(requestId, "Unable to delete unused tags", instance);
+  }
+
+  if (auditLog) {
+    const log = logger.withContext({ requestId, workspaceId: access.workspaceId });
+    await Promise.all(
+      result.data.map((tag) =>
+        queueV3AuditLog(
+          {
+            ...auditLog,
+            organizationId: access.organizationId,
+            targetId: tag.id,
+            status: "success",
+            oldObject: tag,
+          },
+          requestId,
+          log
+        )
+      )
+    );
+    skipV3AuditLog(auditLog);
+  }
+
+  return successResponse({ deleted: result.data.length }, { requestId });
+}
