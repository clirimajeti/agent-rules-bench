+/**
+ * Replaces an API key's secret in place. The id, label, organization access and workspace permissions
+ * stay as they are, so anything that refers to the key (audit logs, relationship projection) keeps
+ * working; only the old secret stops authenticating. `lastUsedAt` is cleared because the new secret has
+ * not been used yet. The plaintext is returned once and is not stored.
+ */
+export const rotateApiKey = async (
+  apiKeyId: string
+): Promise<TApiKeyWithEnvironmentPermission & { actualKey: string }> => {
+  validateInputs([apiKeyId, ZId]);
+
+  try {
+    const secret = randomBytes(32).toString("base64url");
+    const lookupHash = hashSha256(secret);
+    const hashedKey = await hashSecret(secret, 12);
+
+    const result = await prisma.apiKey.update({
+      where: { id: apiKeyId },
+      data: { hashedKey, lookupHash, lastUsedAt: null },
+      select: {
+        id: true,
+        label: true,
+        createdAt: true,
+        lastUsedAt: true,
+        organizationAccess: true,
+        apiKeyWorkspaces: {
+          select: {
+            permission: true,
+            workspaceId: true,
+          },
+        },
+      },
+    });
+
+    return { ...result, actualKey: `fbk_${secret}` };
+  } catch (error) {
+    if (error instanceof Prisma.PrismaClientKnownRequestError) {
+      throw new DatabaseError(error.message);
+    }
+    throw error;
+  }
+};
