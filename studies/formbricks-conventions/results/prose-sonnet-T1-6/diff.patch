@@ -0,0 +1,93 @@
+post:
+  operationId: rotateApiKeyV3
+  # Session-only by design: an API key must not be able to replace API keys, so a caller reading the
+  # published reference would only ever get a 401. Kept out of the generated docs pages like the tag
+  # operations; the operation stays in the bundle for the contract tests.
+  x-excluded: true
+  summary: Rotate an API key
+  description: |
+    Replaces the secret of `{apiKeyId}` with a new one. The key keeps its id, label, organization access
+    and workspace permissions. The old secret stops working immediately, and `lastUsedAt` is cleared.
+
+    The new secret is returned in `actualKey` once and cannot be read again.
+
+    Requires permission to manage the organization's API keys. An unknown key answers `403`.
+  tags:
+    - V3 API Keys
+  parameters:
+    - in: path
+      name: apiKeyId
+      required: true
+      schema:
+        type: string
+        format: cuid2
+      description: The API key to rotate.
+  responses:
+    "200":
+      description: API key rotated successfully
+      content:
+        application/json:
+          schema:
+            type: object
+            required:
+              - data
+            properties:
+              data:
+                type: object
+                required:
+                  - id
+                  - label
+                  - createdAt
+                  - lastUsedAt
+                  - organizationAccess
+                  - apiKeyWorkspaces
+                  - actualKey
+                properties:
+                  id:
+                    type: string
+                    format: cuid2
+                  label:
+                    type: string
+                  createdAt:
+                    type: string
+                    format: date-time
+                  lastUsedAt:
+                    type: string
+                    format: date-time
+                    nullable: true
+                    description: Always null directly after a rotation.
+                  organizationAccess:
+                    type: object
+                    description: The key's organization-level access, unchanged by the rotation.
+                  apiKeyWorkspaces:
+                    type: array
+                    description: The key's workspace permissions, unchanged by the rotation.
+                    items:
+                      type: object
+                      required:
+                        - workspaceId
+                        - permission
+                      properties:
+                        workspaceId:
+                          type: string
+                        permission:
+                          type: string
+                          enum:
+                            - read
+                            - write
+                            - manage
+                  actualKey:
+                    type: string
