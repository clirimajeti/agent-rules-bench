+/**
+ * POST /api/v3/api-keys/{apiKeyId}/rotate — replace an API key's secret, keeping its label and access.
+ *
+ * Session-only. The new secret is in the response body once and cannot be read again.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { ZV3EmptyQuery } from "@/app/api/v3/lib/schemas";
+import { rotateV3ApiKey } from "../../lib/operations";
+import { ZV3ApiKeyIdParams } from "../../lib/schemas";
+
+export const POST = withV3ApiWrapper({
+  auth: "session",
+  action: "updated",
+  targetType: "apiKey",
+  schemas: { params: ZV3ApiKeyIdParams, query: ZV3EmptyQuery },
+  handler: async ({ authentication, parsedInput, auditLog, requestId, instance }) =>
+    rotateV3ApiKey({
+      authentication,
+      apiKeyId: parsedInput.params.apiKeyId,
+      auditLog,
+      requestId,
+      instance,
+    }),
+});
diff --git a/apps/web/app/api/v3/api-keys/lib/operations.ts b/apps/web/app/api/v3/api-keys/lib/operations.ts
new file mode 100644
index 000000000..80070a51e
--- /dev/null
+++ b/apps/web/app/api/v3/api-keys/lib/operations.ts
@@ -0,0 +1,65 @@
+import "server-only";
+import { AuthorizationError, ResourceNotFoundError } from "@formbricks/types/errors";
+import { getV3SessionUserId } from "@/app/api/v3/lib/auth";
+import { problemForbidden, problemUnauthorized, successResponse } from "@/app/api/v3/lib/response";
+import type { TV3AuditLog, TV3Authentication } from "@/app/api/v3/lib/types";
+import { assertCan } from "@/lib/authorization";
+import { getOrganizationIdFromApiKeyId } from "@/lib/utils/helper";
+import { rotateApiKey } from "@/modules/organization/settings/api-keys/lib/api-key";
+
+type TBaseParams = {
+  authentication: TV3Authentication;
+  requestId: string;
+  instance?: string;
+};
+
+/**
+ * Replace the secret of an API key and return the new one, once.
+ *
+ * Session-only: an API key must not be able to replace API keys. The organization is resolved from the
+ * key itself, never from the request, and authorization is the same `apiKey.manage` check the delete and
+ * update actions make. An unknown key answers 403, not 404, so key ids cannot be probed.
+ */
+export async function rotateV3ApiKey(
+  params: TBaseParams & { apiKeyId: string; auditLog?: TV3AuditLog }
+): Promise<Response> {
+  const { authentication, apiKeyId, auditLog, requestId, instance } = params;
+
+  const userId = getV3SessionUserId(authentication);
+  if (!userId) {
+    return problemUnauthorized(requestId, "Session required", instance);
+  }
+
+  try {
+    const organizationId = await getOrganizationIdFromApiKeyId(apiKeyId);
+    await assertCan({ type: "user", id: userId }, "apiKey.manage", { type: "apiKey", id: apiKeyId });
+
+    if (auditLog) {
+      auditLog.organizationId = organizationId;
+      auditLog.targetId = apiKeyId;
+    }
+
+    const rotated = await rotateApiKey(apiKeyId);
+
+    // The audit log records that the key changed, never the secret or its hashes.
+    if (auditLog) auditLog.newObject = { id: rotated.id, label: rotated.label };
+
+    return successResponse(
+      {
+        id: rotated.id,
+        label: rotated.label,
+        createdAt: rotated.createdAt.toISOString(),
+        lastUsedAt: rotated.lastUsedAt ? rotated.lastUsedAt.toISOString() : null,
+        organizationAccess: rotated.organizationAccess,
+        apiKeyWorkspaces: rotated.apiKeyWorkspaces,
+        actualKey: rotated.actualKey,
+      },
+      { requestId }
+    );
+  } catch (error) {
+    if (error instanceof ResourceNotFoundError || error instanceof AuthorizationError) {
+      return problemForbidden(requestId, "You are not authorized to access this resource", instance);
+    }
+    throw error;
+  }
+}
