+/**
+ * POST /api/v3/tags/delete-unused — bulk-delete every tag in the caller's workspace that has zero
+ * response associations.
+ *
+ * Session-only, deliberately. These endpoints replace `authenticatedActionClient` server actions that
+ * only ever ran for a signed-in user, so accepting `x-api-key` here would widen the surface rather than
+ * migrate it.
+ */
+import "server-only";
+
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { successResponse } from "@/app/api/v3/lib/response";
+import type { TV3Authentication } from "@/app/api/v3/lib/types";
+import { requireV3WorkspaceAccess } from "@/app/api/v3/lib/auth";
+import { prisma } from "@formbricks/database";
+import { buildVisibleSurveyWhere } from "@/lib/survey/visibility/predicate";
+import { resolveV3ResponsesActorContext } from "@/app/api/v3/responses/lib/visibility";
+import { andVisibleSurveys } from "@/lib/survey/visibility/predicate";
+import { z } from "zod";
+
+const ZDeleteUnusedQuery = z.object({ workspaceId: z.cuid2() }).strict();
+type TDeleteUnusedQuery = z.infer<typeof ZDeleteUnusedQuery>;
+
+type TBaseParams = {
+  authentication: TV3Authentication;
+  requestId: string;
+  instance?: string;
+};
+
+/**
+ * Find all tags in the workspace that have no response associations (within the caller's visible
+ * survey scope). Returns the count of such tags.
+ */
+const getUnusedTagIds = async (
+  workspaceId: string,
+  authentication: TV3Authentication,
+  organizationId: string,
+  requestId: string,
+  instance: string | undefined
+): Promise<string[]> => {
+  // First, verify workspace access
+  const access = await requireV3WorkspaceAccess(
+    authentication,
+    workspaceId,
+    "read",
+    requestId,
+    instance
+  );
+  if (access instanceof Response) return [];
+
+  const visibleSurveyWhere = await buildVisibleSurveyWhere(
+    await resolveV3ResponsesActorContext(authentication, organizationId)
+  );
+
+  // Find tag IDs that have no tagsOnResponses entries within visible surveys
+  const tagsWithResponses = await prisma.tagsOnResponses.groupBy({
+    by: ["tagId"],
+    where: {
+      response: {
+        survey: {
+          workspaceId,
+          ...andVisibleSurveys(visibleSurveyWhere),
+        },
+      },
+    },
+  });
+
+  const responseTagIds = new Set(tagsWithResponses.map((entry) => entry.tagId));
+
+  // Get all tags in the workspace
+  const allTags = await prisma.tag.findMany({
+    where: { workspaceId },
+    select: { id: true },
+  });
+
+  return allTags
+    .filter((tag) => !responseTagIds.has(tag.id))
+    .map((tag) => tag.id);
+};
+
+export async function deleteUnusedTags(
+  params: TBaseParams & { workspaceId: string }
+): Promise<Response> {
+  const { authentication, workspaceId, requestId, instance } = params;
+
+  const access = await requireV3WorkspaceAccess(
+    authentication,
+    workspaceId,
+    "read",
+    requestId,
+    instance
+  );
+  if (access instanceof Response) return access;
+
+  const unusedTagIds = await getUnusedTagIds(
+    workspaceId,
+    authentication,
+    access.organizationId,
+    requestId,
+    instance
+  );
+
+  // Delete all unused tags in a transaction
+  if (unusedTagIds.length > 0) {
+    await prisma.$transaction(
+      unusedTagIds.map((tagId) => prisma.tag.delete({ where: { id: tagId } }))
+    );
+  }
+
+  return successResponse({ deletedCount: unusedTagIds.length }, { requestId });
+}
+
+export const POST = withV3ApiWrapper({
+  auth: "session",
+  schemas: { query: ZDeleteUnusedQuery },
+  handler: async ({ authentication, parsedInput, requestId, instance }) =>
+    deleteUnusedTags({
+      authentication,
+      workspaceId: parsedInput.query.workspaceId,
+      requestId,
+      instance,
+    }),
+});
