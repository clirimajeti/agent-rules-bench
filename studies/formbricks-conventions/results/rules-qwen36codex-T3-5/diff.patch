diff --git a/apps/web/app/api/v3/account/download-my-data/route.ts b/apps/web/app/api/v3/account/download-my-data/route.ts
new file mode 100644
index 000000000..654f6eb39
--- /dev/null
+++ b/apps/web/app/api/v3/account/download-my-data/route.ts
@@ -0,0 +1,109 @@
+/**
+ * POST /api/v3/account/download-my-data
+ *
+ * Session cookie only. Returns a JSON object with the authenticated user's personal
+ * information and organization memberships for a "Download my data" export.
+ *
+ * Mirrors the logic previously in the `downloadMyDataAction` server action,
+ * but follows the v3 API pattern (session-only auth, no audit log since this
+ * is a read-only data export).
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { getSession } from "@/modules/auth/lib/session";
+import { getUser } from "@/lib/user/service";
+import { lookupAuthorizedOrganizationIds } from "@/lib/authzed/organization-membership";
+import { prisma } from "@formbricks/database";
+
+interface OrganizationMembership {
+  organizationName: string;
+  role: string;
+}
+
+interface DownloadMyDataResult {
+  name: string;
+  email: string;
+  locale: string;
+  notificationSettings: Record<string, unknown>;
+  organizationMemberships: OrganizationMembership[];
+}
+
+export const POST = withV3ApiWrapper({
+  auth: "session",
+  handler: async ({ authentication, requestId, instance }) => {
+    const session = await getSession();
+    if (!session?.user) {
+      return new Response(
+        JSON.stringify({
+          status: 401,
+          detail: "Not authenticated",
+          code: "not_authenticated",
+        }),
+        { status: 401, headers: { "Content-Type": "application/json" } }
+      );
+    }
+
+    const user = await getUser(session.user.id);
+    if (!user) {
+      return new Response(
+        JSON.stringify({
+          status: 404,
+          detail: "User not found",
+          code: "not_found",
+        }),
+        { status: 404, headers: { "Content-Type": "application/json" } }
+      );
+    }
+
+    const organizationIds = await lookupAuthorizedOrganizationIds({
+      type: "user",
+      id: session.user.id,
+    });
+
+    const memberships: OrganizationMembership[] = [];
+
+    if (organizationIds.length > 0) {
+      const organizations = await prisma.organization.findMany({
+        where: {
+          id: { in: organizationIds },
+        },
+        select: {
+          id: true,
+          name: true,
+        },
+      });
+
+      const orgMap = new Map(organizations.map((org) => [org.id, org.name]));
+
+      const membershipsRaw = await prisma.membership.findMany({
+        where: {
+          userId: session.user.id,
+          organizationId: { in: organizationIds },
+        },
+        select: {
+          organizationId: true,
+          role: true,
+        },
+      });
+
+      for (const m of membershipsRaw) {
+        memberships.push({
+          organizationName: orgMap.get(m.organizationId) ?? "",
+          role: m.role,
+        });
+      }
+    }
+
+    const data: DownloadMyDataResult = {
+      name: user.name,
+      email: user.email,
+      locale: user.locale,
+      notificationSettings: user.notificationSettings,
+      organizationMemberships: memberships,
+    };
+
+    return new Response(JSON.stringify({ data }), {
+      status: 200,
+      headers: { "Content-Type": "application/json" },
+    });
+  },
+});
