@@ -1,4 +1,5 @@
 "use server";
+import { revalidatePath } from "next/cache";
 
 import { z } from "zod";
 import { ZId } from "@formbricks/types/common";
@@ -160,3 +161,56 @@ export const testEndpointAction = authenticatedActionClient
     await testEndpoint(parsedInput.url, secret);
     return { success: true, secret };
   });
+
+const ZDuplicateWebhookAction = z.object({
+  webhookId: ZId,
+  workspaceId: ZId,
+});
+
+export const duplicateWebhookAction = authenticatedActionClient
+  .inputSchema(ZDuplicateWebhookAction)
+  .action(async ({ ctx, parsedInput }) => {
+    const organizationId = await getOrganizationIdFromWebhookId(parsedInput.webhookId);
+    const workspaceId = await getWorkspaceIdFromWebhookId(parsedInput.webhookId);
+    await assertCan({ type: "user", id: ctx.user.id }, "workspace.write", {
+      type: "workspace",
+      id: workspaceId,
+    });
+    await applyRateLimit(rateLimitConfigs.actions.stateMutation, workspaceId);
+
+    const existingWebhookResult = await getWebhook(parsedInput.webhookId);
+    if (!existingWebhookResult.ok) {
+      throw new ResourceNotFoundError("Webhook", parsedInput.webhookId);
+    }
+
+    const existingWebhook = existingWebhookResult.data;
+
+    const newWebhook = await createWebhook(parsedInput.workspaceId, {
+      name: `Copy of ${existingWebhook.name ?? ""}`,
+      url: existingWebhook.url,
+      triggers: [...existingWebhook.triggers],
+      surveyIds: [...(existingWebhook.surveyIds ?? [])],
+    });
+
+    ctx.auditLoggingCtx.organizationId = organizationId;
+    ctx.auditLoggingCtx.newObject = {
+      name: newWebhook.name,
+      url: newWebhook.url,
+      triggers: newWebhook.triggers,
+      surveyIds: newWebhook.surveyIds,
+    };
+
+    capturePostHogEvent(
+      ctx.user.id,
+      "integration_connected",
+      {
+        integration_type: "webhook",
+        organization_id: organizationId,
+        workspace_id: workspaceId,
+      },
+      { organizationId, workspaceId }
+    );
+
+    revalidatePath("/workspaces/" + parsedInput.workspaceId + "/settings/workspace/integrations/webhooks");
+    return newWebhook;
+  });
