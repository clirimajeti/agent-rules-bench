@@ -43,3 +43,10 @@ export async function mergeTags(params: { tagId: string; newTagId: string }): Pr
     body: JSON.stringify({ newTagId: params.newTagId }),
   });
 }
+
+export async function deleteUnusedTags(params: { workspaceId: string }): Promise<{ deletedCount: number }> {
+  const query = new URLSearchParams({ workspaceId: params.workspaceId });
+  return request<{ deletedCount: number }>(`${BASE_PATH}/unused?${query.toString()}`, {
+    method: "DELETE",
+  });
+}
