+/**
+ * DELETE /api/v3/tags/unused — delete all tags of a workspace that are not applied to any response.
+ *
+ * Session-only, matching the other tag endpoints.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { successResponse } from "@/app/api/v3/lib/response";
+import { prisma } from "@formbricks/database";
+import { ZV3TagListQuery } from "../lib/schemas";
+
+export const DELETE = withV3ApiWrapper({
+  auth: "session",
+  schemas: { query: ZV3TagListQuery },
+  handler: async ({ authentication, parsedInput, requestId, instance }) => {
+    const { workspaceId } = parsedInput.query;
+
+    // Find tags that have no TagsOnResponses entries and delete them.
+    const result = await prisma.tag.deleteMany({
+      where: {
+        workspaceId,
+        responses: {
+          none: {},
+        },
+      },
+    });
+
+    return successResponse({ deletedCount: result.count }, { requestId });
+  },
+});
