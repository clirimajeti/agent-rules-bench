+export const AccountActivity = ({ createdAt, lastLoginAt, locale }: IAccountActivityProps) => {
+  const { t } = useTranslation();
+
+  return (
+    <dl className="grid grid-cols-[max-content_1fr] gap-x-6 gap-y-2 text-sm">
+      <dt className="text-slate-500">{t("workspace.settings.profile.account_created")}</dt>
+      <dd className="text-slate-900">{formatDateTimeForDisplay(createdAt, locale)}</dd>
+      <dt className="text-slate-500">{t("workspace.settings.profile.last_login")}</dt>
+      <dd className="text-slate-900">
