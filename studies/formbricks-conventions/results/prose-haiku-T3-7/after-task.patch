+import { AuthenticationError } from "@formbricks/types/errors";
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { getAccountDataExport } from "@/modules/account/lib/account-data-export";
+
+export const runtime = "nodejs";
+export const dynamic = "force-dynamic";
+
+/**
+ * `GET /api/internal/account/data-export`: the signed-in user's own profile, notification settings and
+ * organization memberships, as a JSON file. Internal and session-only, with no OpenAPI entry. It only
+ * reads, so it is not written to the audit log.
+ */
+export const GET = withV3ApiWrapper({
+  auth: "session",
+  handler: async ({ authentication, requestId }) => {
+    const userId = authentication && "user" in authentication ? authentication.user?.id : undefined;
+    if (!userId) {
+      throw new AuthenticationError("Not authenticated");
+    }
+
+    const data = await getAccountDataExport(userId);
+
+    return new Response(JSON.stringify(data, null, 2), {
+      status: 200,
+      headers: {
+        "Content-Type": "application/json; charset=utf-8",
+        "Content-Disposition": 'attachment; filename="formbricks-account-data.json"',
+        "Cache-Control": "no-store",
+        "X-Request-Id": requestId,
+      },
+    });
+  },
+});
