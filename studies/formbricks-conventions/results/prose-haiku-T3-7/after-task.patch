diff --git a/apps/web/modules/account/lib/account-data-export.ts b/apps/web/modules/account/lib/account-data-export.ts
new file mode 100644
index 000000000..f34d67e94
--- /dev/null
+++ b/apps/web/modules/account/lib/account-data-export.ts
@@ -0,0 +1,49 @@
+import "server-only";
+import { prisma } from "@formbricks/database";
+import { ResourceNotFoundError } from "@formbricks/types/errors";
+import { TOrganizationRole } from "@formbricks/types/memberships";
+import { TUserNotificationSettings } from "@formbricks/types/user";
+import { getUser } from "@/lib/user/service";
+
+export type TAccountDataExport = {
+  name: string;
+  email: string;
+  locale: string;
+  notificationSettings: TUserNotificationSettings;
+  organizations: {
+    name: string;
+    role: TOrganizationRole;
+  }[];
+};
+
+/**
+ * The personal data a user can take with them: profile fields, notification settings and the
+ * organizations they belong to. Only accepted memberships are included, because a pending membership
+ * is an invite the user has not joined yet.
+ */
+export const getAccountDataExport = async (userId: string): Promise<TAccountDataExport> => {
+  const user = await getUser(userId);
+  if (!user) {
+    throw new ResourceNotFoundError("User", userId);
+  }
+
+  const memberships = await prisma.membership.findMany({
+    where: { userId, accepted: true },
+    select: {
+      role: true,
+      organization: { select: { name: true } },
+    },
+    orderBy: { organization: { name: "asc" } },
+  });
+
+  return {
+    name: user.name,
+    email: user.email,
+    locale: user.locale,
+    notificationSettings: user.notificationSettings,
+    organizations: memberships.map((membership) => ({
+      name: membership.organization.name,
+      role: membership.role,
+    })),
+  };
+};
