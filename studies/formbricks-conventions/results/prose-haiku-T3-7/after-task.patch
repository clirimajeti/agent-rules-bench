@@ -0,0 +1,52 @@
+"use client";
+
+import { useState } from "react";
+import toast from "react-hot-toast";
+import { useTranslation } from "react-i18next";
+import { Button } from "@/modules/ui/components/button";
+
+const DATA_EXPORT_URL = "/api/internal/account/data-export";
+const DOWNLOAD_FILE_NAME = "formbricks-account-data.json";
+
+export const DownloadAccountData = () => {
+  const { t } = useTranslation();
+  const [isDownloading, setIsDownloading] = useState(false);
+
+  const handleDownload = async () => {
+    setIsDownloading(true);
+    try {
+      // Fetched rather than linked: a failure comes back as an error response, which a plain link would
+      // save to disk as if it were the export.
+      const response = await fetch(DATA_EXPORT_URL, { method: "GET", cache: "no-store" });
+      if (!response.ok) {
+        throw new Error(`Data export failed with status ${response.status}`);
+      }
+
+      const blob = await response.blob();
+      const url = URL.createObjectURL(blob);
+      const link = document.createElement("a");
+      link.href = url;
+      link.download = DOWNLOAD_FILE_NAME;
+      document.body.appendChild(link);
+      link.click();
+      link.remove();
+      setTimeout(() => URL.revokeObjectURL(url), 0);
+    } catch {
+      toast.error(t("workspace.settings.profile.download_my_data_error"));
+    } finally {
+      setIsDownloading(false);
+    }
+  };
+
+  return (
+    <Button
+      type="button"
+      variant="secondary"
+      size="sm"
+      onClick={handleDownload}
+      loading={isDownloading}
+      disabled={isDownloading}>
+      {t("workspace.settings.profile.download_my_data")}
+    </Button>
+  );
+};
