@@ -0,0 +1,93 @@
+post:
+  operationId: rotateApiKeyV3
+  # Session-only by design: an API key must not mint a replacement secret for itself or another key.
+  # Excluded from the generated docs pages like the other session-only operations (ENG-2533); the
+  # operation stays in the bundle for the contract tests.
+  x-excluded: true
+  summary: Rotate an API key
+  description: |
+    Replaces the secret of an organization API key. The key keeps its id, label, organization access
+    and workspace permissions. The previous secret stops working at once, and `lastUsedAt` resets to
+    `null`.
+
+    The new plaintext key is in `actualKey` of this response only. It cannot be read again.
+
+    Requires the same permission as updating or deleting the key. An unknown key answers `403`.
+  tags:
+    - V3 API Keys
+  parameters:
+    - in: path
+      name: apiKeyId
+      required: true
+      schema:
+        type: string
+        format: cuid2
+      description: The API key to rotate.
+  responses:
+    "200":
+      description: API key rotated successfully
+      content:
+        application/json:
+          schema:
+            type: object
+            required:
+              - data
+            properties:
+              data:
+                type: object
+                required:
+                  - id
+                  - label
+                  - createdAt
+                  - lastUsedAt
+                  - organizationAccess
+                  - apiKeyWorkspaces
+                  - actualKey
+                properties:
+                  id:
+                    type: string
+                    format: cuid2
+                  label:
+                    type: string
+                  createdAt:
+                    type: string
+                    format: date-time
+                  lastUsedAt:
+                    type: string
+                    format: date-time
+                    nullable: true
+                  organizationAccess:
+                    type: object
+                    description: The key's organization-level access, unchanged by rotation.
+                    additionalProperties: true
+                  apiKeyWorkspaces:
+                    type: array
+                    items:
+                      type: object
+                      required:
+                        - workspaceId
+                        - permission
+                      properties:
+                        workspaceId:
+                          type: string
+                        permission:
+                          type: string
+                          enum:
+                            - read
+                            - write
+                            - manage
+                  actualKey:
+                    type: string
+                    description: The new plaintext key. Shown once.
+    "400":
+      $ref: ../components/responses/V3BadRequest.yml
+    "401":
+      $ref: ../components/responses/V3UnauthorizedSession.yml
+    "403":
+      $ref: ../components/responses/V3Forbidden.yml
+    "429":
+      $ref: ../components/responses/V3TooManyRequests.yml
+    "500":
+      $ref: ../components/responses/V3InternalServerError.yml
+  security:
+    - sessionAuth: []
