diff --git a/apps/web/modules/integrations/webhooks/components/webhook-duplicate-button.tsx b/apps/web/modules/integrations/webhooks/components/webhook-duplicate-button.tsx
new file mode 100644
index 000000000..3e7730291
--- /dev/null
+++ b/apps/web/modules/integrations/webhooks/components/webhook-duplicate-button.tsx
@@ -0,0 +1,54 @@
+"use client";
+
+import { useRouter } from "next/navigation";
+import { useState } from "react";
+import toast from "react-hot-toast";
+import { useTranslation } from "react-i18next";
+import { Webhook } from "@formbricks/database/prisma-browser";
+import { getFormattedErrorMessage } from "@/lib/utils/error-message";
+import { createWebhookAction } from "@/modules/integrations/webhooks/actions";
+import { Button } from "@/modules/ui/components/button";
+
+interface WebhookDuplicateButtonProps {
+  webhook: Webhook;
+}
+
+export const WebhookDuplicateButton = ({ webhook }: Readonly<WebhookDuplicateButtonProps>) => {
+  const { t } = useTranslation();
+  const router = useRouter();
+  const [isDuplicating, setIsDuplicating] = useState(false);
+
+  const handleDuplicate = async () => {
+    setIsDuplicating(true);
+    try {
+      // No secret is passed, so the server generates a new one for the copy.
+      const result = await createWebhookAction({
+        workspaceId: webhook.workspaceId,
+        webhookInput: {
+          name: t("workspace.integrations.webhooks.copy_of_name", { name: webhook.name || webhook.url }),
+          url: webhook.url,
+          source: "user",
+          triggers: webhook.triggers,
+          surveyIds: webhook.surveyIds,
+        },
+      });
+
+      if (result?.data) {
+        toast.success(t("workspace.integrations.webhooks.webhook_duplicated_successfully"));
+        router.refresh();
+      } else {
+        toast.error(getFormattedErrorMessage(result));
+      }
+    } catch (error) {
+      toast.error(error instanceof Error ? error.message : t("common.something_went_wrong_please_try_again"));
+    } finally {
+      setIsDuplicating(false);
+    }
+  };
+
+  return (
+    <Button type="button" variant="secondary" size="sm" loading={isDuplicating} onClick={handleDuplicate}>
+      {t("common.duplicate")}
+    </Button>
+  );
+};
