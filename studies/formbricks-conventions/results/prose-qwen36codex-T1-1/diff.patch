@@ -0,0 +1,24 @@
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { ZRotateApiKeyPathParams } from "./schemas";
+import { rotateApiKeyOperation } from "./operations";
+
+/**
+ * `POST /api/internal/api-keys/{apiKeyId}/rotate`: rotate an API key's secret.
+ * Internal and session-only. The caller must have `apiKey.manage` on the key.
+ */
+export const POST = withV3ApiWrapper({
+  auth: "session",
+  schemas: {
+    params: ZRotateApiKeyPathParams,
+  },
+  action: "updated",
+  targetType: "apiKey",
+  handler: async ({ authentication, parsedInput, requestId, instance, auditLog }) => {
+    const result = await rotateApiKeyOperation({
+      authentication,
+      apiKeyId: parsedInput.params.apiKeyId,
+    });
+    auditLog!.newObject = { id: result.data.id };
+    return new Response(JSON.stringify(result), { status: 200, headers: { "Content-Type": "application/json" } });
+  },
+});
