+import type { TV3Authentication } from "@/app/api/v3/lib/types";
+import { rotateApiKey } from "@/modules/organization/settings/api-keys/lib/api-key";
+
+export type TRotateApiKeyResult = { id: string; actualKey: string };
+
+export const rotateApiKeyOperation = async ({
+  authentication,
+  apiKeyId,
+}: {
+  authentication: TV3Authentication;
+  apiKeyId: string;
+}): Promise<{ data: TRotateApiKeyResult }> => {
+  // Authorization: the caller must have apiKey.manage on this key
+  const { assertCan } = await import("@/lib/authorization");
+  await assertCan({ type: authentication.type, id: authentication.id }, "apiKey.manage", {
+    type: "apiKey",
+    id: apiKeyId,
+  });
+
+  const result = await rotateApiKey(apiKeyId);
+  return { data: result };
+};
