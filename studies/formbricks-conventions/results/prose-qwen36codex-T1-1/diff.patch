diff --git a/apps/web/modules/organization/settings/api-keys/lib/api-key-client.ts b/apps/web/modules/organization/settings/api-keys/lib/api-key-client.ts
new file mode 100644
index 000000000..0f2e25591
--- /dev/null
+++ b/apps/web/modules/organization/settings/api-keys/lib/api-key-client.ts
@@ -0,0 +1,14 @@
+import { parseV3ApiError } from "@/modules/api/lib/v3-client";
+
+export type TRotateApiKeyResult = { id: string; actualKey: string };
+
+/** Rotate an API key's secret; the caller must have `apiKey.manage` on the key. */
+export async function rotateApiKeyClient({ apiKeyId }: { apiKeyId: string }): Promise<TRotateApiKeyResult> {
+  const response = await fetch(`/api/internal/api-keys/${encodeURIComponent(apiKeyId)}/rotate`, {
+    method: "POST",
+    cache: "no-store",
+    signal: AbortSignal.timeout(15_000),
+  });
+  if (!response.ok) throw await parseV3ApiError(response);
+  return (await response.json()) as { data: TRotateApiKeyResult };
+}
