--- /dev/null
+++ b/apps/web/app/api/v3/api-keys/[apiKeyId]/rotate/route.ts
@@ -0,0 +1,23 @@
+/**
+ * POST /api/v3/api-keys/{apiKeyId}/rotate - replace an API key's secret, keeping its label and access.
+ *
+ * Session-only. The new key is in this response and nowhere else.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { getV3SessionUserId } from "@/app/api/v3/lib/auth";
+import { problemUnauthorized } from "@/app/api/v3/lib/response";
+import { rotateV3ApiKey } from "../../lib/operations";
+import { ZV3ApiKeyIdParams } from "../../lib/schemas";
+
+export const POST = withV3ApiWrapper({
+  auth: "session",
+  action: "updated",
+  targetType: "apiKey",
+  schemas: { params: ZV3ApiKeyIdParams },
+  handler: async ({ authentication, parsedInput, auditLog, requestId, instance }) => {
+    const userId = getV3SessionUserId(authentication);
+    if (!userId) return problemUnauthorized(requestId, "Session required", instance);
+
+    return rotateV3ApiKey({ userId, apiKeyId: parsedInput.params.apiKeyId, requestId, auditLog });
+  },
+});
diff --git a/apps/web/app/api/v3/api-keys/lib/operations.ts b/apps/web/app/api/v3/api-keys/lib/operations.ts
new file mode 100644
index 000000000..8fe0fbc3d
--- /dev/null
+++ b/apps/web/app/api/v3/api-keys/lib/operations.ts
@@ -0,0 +1,50 @@
+import "server-only";
+import { successResponse } from "@/app/api/v3/lib/response";
+import type { TV3AuditLog } from "@/app/api/v3/lib/types";
+import { assertCan } from "@/lib/authorization";
+import { getOrganizationIdFromApiKeyId } from "@/lib/utils/helper";
+import { rotateApiKey } from "@/modules/organization/settings/api-keys/lib/api-key";
+
+/**
+ * Replaces an API key's secret and returns the new plaintext key, once.
+ *
+ * The organization is resolved from the key itself, never from the request, so a caller cannot pair
+ * someone else's key id with an organization they manage. Authorization is the `apiKey.manage` check the
+ * update and delete actions use. An unknown key and a key the caller may not manage both answer 403 (the
+ * thrown `ResourceNotFoundError` / `AuthorizationError` are mapped by the wrapper), so key ids cannot be
+ * probed for existence.
+ *
+ * Session-only: an API key must not be able to mint a replacement for itself or for another key.
+ */
+export async function rotateV3ApiKey(params: {
+  userId: string;
+  apiKeyId: string;
+  requestId: string;
+  auditLog?: TV3AuditLog;
+}): Promise<Response> {
+  const { userId, apiKeyId, requestId, auditLog } = params;
+
+  const organizationId = await getOrganizationIdFromApiKeyId(apiKeyId);
+  await assertCan({ type: "user", id: userId }, "apiKey.manage", { type: "apiKey", id: apiKeyId });
+
+  if (auditLog) {
+    auditLog.organizationId = organizationId;
+    auditLog.targetId = apiKeyId;
+  }
+
+  const { actualKey, ...rotated } = await rotateApiKey(apiKeyId);
+
+  // The audit log records which key was rotated, never a secret or hash.
+  if (auditLog) auditLog.newObject = { id: rotated.id, label: rotated.label };
+
+  return successResponse(
+    {
+      id: rotated.id,
+      label: rotated.label,
+      createdAt: rotated.createdAt.toISOString(),
+      lastUsedAt: rotated.lastUsedAt ? rotated.lastUsedAt.toISOString() : null,
+      apiKey: actualKey,
+    },
+    { requestId }
+  );
+}
