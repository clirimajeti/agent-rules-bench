+++ b/docs/api-v3-reference/src/paths/api_v3_api-keys_{apiKeyId}_rotate.yml
@@ -0,0 +1,72 @@
+post:
+  operationId: rotateApiKeyV3
+  # Session-only by design: an API key must not be able to replace its own secret or another key's.
+  # Excluded from the generated docs pages like the other session-only operations (ENG-2533).
+  x-excluded: true
+  summary: Rotate an API key
+  description: |
+    Replaces the key's secret with a new one. The label, organization access and workspace permissions
+    are unchanged, and the old secret stops working immediately. `lastUsedAt` is reset to `null`.
+
+    The new key is returned in `apiKey` and cannot be read again.
+
+    Requires permission to manage the key. An unknown `apiKeyId` answers `403`, not `404`, so key ids
+    cannot be probed for existence.
+  tags:
+    - V3 API Keys
+  parameters:
+    - in: path
+      name: apiKeyId
+      required: true
+      schema:
+        type: string
+        format: cuid2
+      description: The key whose secret is replaced.
+  responses:
+    "200":
+      description: API key rotated successfully
+      content:
+        application/json:
+          schema:
+            type: object
+            required:
+              - data
+            properties:
+              data:
+                type: object
+                required:
+                  - id
+                  - label
+                  - createdAt
+                  - lastUsedAt
+                  - apiKey
+                properties:
+                  id:
+                    type: string
+                    format: cuid2
+                  label:
+                    type: string
+                  createdAt:
+                    type: string
+                    format: date-time
+                  lastUsedAt:
+                    type:
+                      - string
+                      - "null"
+                    format: date-time
+                    description: Always `null` straight after a rotation.
+                  apiKey:
+                    type: string
+                    description: The new key, shown once.
+    "400":
+      $ref: ../components/responses/V3BadRequest.yml
+    "401":
+      $ref: ../components/responses/V3UnauthorizedSession.yml
+    "403":
+      $ref: ../components/responses/V3Forbidden.yml
+    "429":
+      $ref: ../components/responses/V3TooManyRequests.yml
+    "500":
+      $ref: ../components/responses/V3InternalServerError.yml
+  security:
+    - sessionAuth: []
