+"use client";
+
+import { useMutation } from "@tanstack/react-query";
+import { useRouter } from "next/navigation";
+import { duplicateWebhook } from "../lib/api-client";
+
+/**
+ * Duplicate a webhook. The webhook list is rendered by the server page, so the new copy shows up once the
+ * route is refreshed.
+ */
+export const useDuplicateWebhook = () => {
+  const router = useRouter();
+  return useMutation({
+    mutationFn: (variables: { webhookId: string }) => duplicateWebhook(variables),
+    onSuccess: () => router.refresh(),
+  });
+};
diff --git a/apps/web/modules/integrations/webhooks/lib/api-client.ts b/apps/web/modules/integrations/webhooks/lib/api-client.ts
new file mode 100644
index 000000000..ab9f5fe2d
--- /dev/null
+++ b/apps/web/modules/integrations/webhooks/lib/api-client.ts
@@ -0,0 +1,16 @@
+import type { TV3Webhook } from "@/app/api/v3/webhooks/serializers";
+import { parseV3ApiError } from "@/modules/api/lib/v3-client";
+
+/** Client fetcher for the webhooks v3 routes. Throws a parsed `V3ApiError` on a non-2xx response. */
+const BASE_PATH = "/api/v3/webhooks";
+
+export async function duplicateWebhook(params: { webhookId: string }): Promise<TV3Webhook> {
+  const response = await fetch(`${BASE_PATH}/${params.webhookId}/duplicate`, {
+    method: "POST",
+    cache: "no-store",
+  });
+  if (!response.ok) {
+    throw await parseV3ApiError(response);
+  }
+  return ((await response.json()) as { data: TV3Webhook }).data;
+}
