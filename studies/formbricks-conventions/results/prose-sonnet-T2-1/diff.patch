@@ -0,0 +1,23 @@
+/**
+ * POST /api/v3/webhooks/{webhookId}/duplicate — copy a webhook (URL, triggers, surveys) under the name
+ * "Copy of <name>" with a freshly generated signing secret.
+ * Session-only, matching the webhook settings page that calls it.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { duplicateV3Webhook } from "../../lib/operations";
+import { ZV3WebhookIdParams } from "../../lib/schemas";
+
+export const POST = withV3ApiWrapper({
+  auth: "session",
+  action: "created",
+  targetType: "webhook",
+  schemas: { params: ZV3WebhookIdParams },
+  handler: async ({ authentication, parsedInput, auditLog, requestId, instance }) =>
+    duplicateV3Webhook({
+      authentication,
+      webhookId: parsedInput.params.webhookId,
+      auditLog,
+      requestId,
+      instance,
+    }),
+});
diff --git a/apps/web/app/api/v3/webhooks/lib/operations.ts b/apps/web/app/api/v3/webhooks/lib/operations.ts
new file mode 100644
index 000000000..f473d9f8a
--- /dev/null
+++ b/apps/web/app/api/v3/webhooks/lib/operations.ts
@@ -0,0 +1,71 @@
+import "server-only";
+import { InvalidInputError, OperationNotAllowedError, UnknownError } from "@formbricks/types/errors";
+import { requireV3WorkspaceAccess } from "@/app/api/v3/lib/auth";
+import { createdResponse, problemForbidden, problemUnprocessableContent } from "@/app/api/v3/lib/response";
+import type { TV3AuditLog, TV3Authentication } from "@/app/api/v3/lib/types";
+import { assertNewlyAttachedSurveysWorkspaceVisible } from "@/lib/survey/visibility/outbound";
+import { duplicateWebhook, getWebhookById } from "@/modules/integrations/webhooks/lib/webhook";
+import { serializeV3Webhook } from "../serializers";
+
+/**
+ * POST /api/v3/webhooks/{webhookId}/duplicate.
+ *
+ * The workspace is resolved from the webhook itself, never from the request, so the caller cannot pair
+ * someone else's webhook id with a workspace they can write to. An unknown id answers 403, not 404, so
+ * webhook ids cannot be probed. Writing needs the same `readWrite` access as creating a webhook.
+ */
+export async function duplicateV3Webhook(params: {
+  authentication: TV3Authentication;
+  webhookId: string;
+  auditLog?: TV3AuditLog;
+  requestId: string;
+  instance?: string;
+}): Promise<Response> {
+  const { authentication, webhookId, auditLog, requestId, instance } = params;
+
+  const source = await getWebhookById(webhookId);
+  if (!source) {
+    return problemForbidden(requestId, "You are not authorized to access this resource", instance);
+  }
+
+  const access = await requireV3WorkspaceAccess(
+    authentication,
+    source.workspaceId,
+    "readWrite",
+    requestId,
+    instance
+  );
+  if (access instanceof Response) return access;
+
+  if (auditLog) {
+    auditLog.organizationId = access.organizationId;
+    auditLog.targetId = webhookId;
+  }
+
+  try {
+    // The copy attaches the same surveys a new connection would, so the outbound visibility guard applies.
+    await assertNewlyAttachedSurveysWorkspaceVisible(source.surveyIds);
+    const copy = await duplicateWebhook(source);
+    const serialized = serializeV3Webhook(copy);
+
+    if (auditLog) {
+      auditLog.targetId = copy.id;
+      auditLog.newObject = serialized;
+    }
+
+    return createdResponse(serialized, {
+      location: `/api/v3/webhooks/${copy.id}`,
+      requestId,
+    });
+  } catch (error) {
+    // A refused URL or survey is the caller's to fix; a database fault stays a 500.
+    if (
+      error instanceof InvalidInputError ||
+      error instanceof OperationNotAllowedError ||
+      (error instanceof UnknownError && error.message.includes("not supported"))
+    ) {
+      return problemUnprocessableContent(requestId, error.message, { instance });
+    }
+    throw error;
+  }
+}
