+post:
+  operationId: duplicateWebhookV3
+  # Session-only, like the tag operations: excluded from the published pages, kept in the bundle for the
+  # contract tests.
+  x-excluded: true
+  summary: Duplicate a webhook
+  description: |
+    Creates a new webhook in the same workspace with the source webhook's URL, triggers and surveys.
+    The copy is named `Copy of <name>` (or `Copy of <url>` when the source has no name) and receives its
+    own newly generated signing secret, which is not returned here; read it in the webhook's settings.
+    The copy is always a `user` webhook. Requires read-write access to the workspace.
+
+    An unknown `webhookId` answers `403`, not `404`, so webhook ids cannot be probed.
+  tags:
+    - V3 Webhooks
+  parameters:
+    - in: path
+      name: webhookId
+      required: true
+      schema:
+        type: string
+        format: cuid2
+  responses:
+    "201":
+      description: Webhook duplicated successfully
+      headers:
+        X-Request-Id:
+          schema:
+            type: string
+          description: Request correlation ID
+        Cache-Control:
+          schema:
+            type: string
+          example: private, no-store
+        Location:
+          schema:
+            type: string
+          example: /api/v3/webhooks/clwebhookcopy0000000000
+      content:
+        application/json:
+          schema:
+            type: object
+            required:
+              - data
+            properties:
+              data:
+                $ref: ../components/schemas/WebhookResource.yml
+    "400":
+      $ref: ../components/responses/V3BadRequest.yml
+    "401":
+      $ref: ../components/responses/V3UnauthorizedSession.yml
+    "403":
