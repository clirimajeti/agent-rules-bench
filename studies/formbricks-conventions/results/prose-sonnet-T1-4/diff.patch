diff --git a/apps/web/modules/organization/settings/api-keys/lib/api-client.ts b/apps/web/modules/organization/settings/api-keys/lib/api-client.ts
new file mode 100644
index 000000000..8421939f7
--- /dev/null
+++ b/apps/web/modules/organization/settings/api-keys/lib/api-client.ts
@@ -0,0 +1,27 @@
+import { parseV3ApiError } from "@/modules/api/lib/v3-client";
+
+const MUTATION_TIMEOUT_MS = 15_000;
+
+export interface TRotatedApiKey {
+  id: string;
+  label: string;
+  createdAt: string;
+  lastUsedAt: string | null;
+  /** The new secret. The server returns it once and does not store it. */
+  apiKey: string;
+}
+
+export async function rotateApiKey(apiKeyId: string): Promise<TRotatedApiKey> {
+  const response = await fetch(`/api/v3/api-keys/${encodeURIComponent(apiKeyId)}/rotate`, {
+    method: "POST",
+    cache: "no-store",
+    signal: AbortSignal.timeout(MUTATION_TIMEOUT_MS),
+  });
+
+  if (!response.ok) {
+    throw await parseV3ApiError(response);
+  }
+
+  const body = (await response.json()) as { data: TRotatedApiKey };
+  return body.data;
+}
