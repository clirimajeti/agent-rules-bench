@@ -0,0 +1,71 @@
+post:
+  operationId: rotateApiKeyV3
+  # Session-only by design, like the tag operations: an API key cannot rotate keys. Excluded from the
+  # generated docs pages, but kept in the bundle for the contract tests.
+  x-excluded: true
+  summary: Rotate an API key
+  description: |
+    Replaces the secret of an API key. The label, organization access and workspace permissions stay
+    unchanged, and the previous secret stops working at once.
+
+    The new secret is returned in `apiKey` and is not stored in plaintext, so it cannot be read again.
+    `lastUsedAt` is reset to `null` because the new secret has not been used.
+
+    An unknown key answers `403`, so key ids cannot be probed.
+  tags:
+    - V3 API Keys
+  parameters:
+    - in: path
+      name: apiKeyId
+      required: true
+      schema:
+        type: string
+        format: cuid2
+      description: The API key to rotate.
+  responses:
+    "200":
+      description: API key rotated successfully
+      content:
+        application/json:
+          schema:
+            type: object
+            required:
+              - data
+            properties:
+              data:
+                type: object
+                required:
+                  - id
+                  - label
+                  - createdAt
+                  - lastUsedAt
+                  - apiKey
+                properties:
+                  id:
+                    type: string
+                    format: cuid2
+                  label:
+                    type: string
+                  createdAt:
+                    type: string
+                    format: date-time
+                  lastUsedAt:
+                    type:
+                      - string
+                      - "null"
+                    format: date-time
+                  apiKey:
+                    type: string
+                    description: The new secret. Shown once.
+    "400":
+      $ref: ../components/responses/V3BadRequest.yml
+    "401":
+      $ref: ../components/responses/V3UnauthorizedSession.yml
+    "403":
+      $ref: ../components/responses/V3Forbidden.yml
+    "429":
+      $ref: ../components/responses/V3TooManyRequests.yml
+    "500":
+      $ref: ../components/responses/V3InternalServerError.yml
+  security:
+    - sessionAuth: []
