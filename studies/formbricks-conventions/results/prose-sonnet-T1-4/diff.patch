+/**
+ * Replaces the secret of an existing key. The row, its label, organization access and workspace
+ * permissions stay as they are, so only the credential changes. `lastUsedAt` is cleared because the new
+ * secret has never been used. The old secret stops working at once: its `lookupHash` no longer matches.
+ * The plaintext is returned once; it is not stored.
+ */
+export const rotateApiKey = async (
+  apiKeyId: string
+): Promise<{ before: ApiKey; after: TApiKeyWithEnvironmentPermission & { actualKey: string } }> => {
+  validateInputs([apiKeyId, ZId]);
+  try {
+    const existing = await prisma.apiKey.findUnique({ where: { id: apiKeyId } });
+    if (!existing) {
+      throw new ResourceNotFoundError("apiKey", apiKeyId);
+    }
+
+    const secret = randomBytes(32).toString("base64url");
+    const lookupHash = hashSha256(secret);
+    const hashedKey = await hashSecret(secret, 12);
+
+    const updated = await prisma.apiKey.update({
+      where: { id: apiKeyId },
+      data: { hashedKey, lookupHash, lastUsedAt: null },
+      select: {
+        id: true,
+        label: true,
+        createdAt: true,
+        lastUsedAt: true,
+        organizationAccess: true,
+        apiKeyWorkspaces: { select: { permission: true, workspaceId: true } },
+      },
+    });
+
+    return { before: existing, after: { ...updated, actualKey: `fbk_${secret}` } };
+  } catch (error) {
+    if (error instanceof Prisma.PrismaClientKnownRequestError) {
+      throw new DatabaseError(error.message);
+    }
+    throw error;
+  }
+};
