+"use client";
+
+import { useTranslation } from "react-i18next";
+import { formatDateForDisplay } from "@/lib/utils/datetime";
+
+interface AccountActivityProps {
+  createdAt: Date;
+  lastLoginAt: Date | null;
+}
+
+export const AccountActivity = ({
+  createdAt,
+  lastLoginAt,
+}: Readonly<AccountActivityProps>) => {
+  const { t } = useTranslation();
+
+  const formatDate = (date: Date | null) => {
+    if (!date) return t("common.no_sign_in_recorded");
+    return formatDateForDisplay(date);
+  };
+
+  return (
+    <div className="flex flex-col gap-4">
+      <div className="flex items-center gap-x-4">
+        <div className="flex flex-col">
+          <h1 className="text-sm font-semibold text-slate-800">
+            {t("workspace.settings.profile.account_created")}
+          </h1>
+          <p className="text-xs text-slate-600">{formatDate(createdAt)}</p>
+        </div>
+      </div>
+      <div className="flex items-center gap-x-4">
+        <div className="flex flex-col">
+          <h1 className="text-sm font-semibold text-slate-800">{t("workspace.settings.profile.last_login")}</h1>
+          <p className="text-xs text-slate-600">{formatDate(lastLoginAt)}</p>
+        </div>
+      </div>
+    </div>
+  );
+};
