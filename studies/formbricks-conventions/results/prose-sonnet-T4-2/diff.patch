+/**
+ * POST /api/v3/tags/delete-unused - delete every tag of a workspace that is on no response.
+ *
+ * A POST with a body rather than a DELETE on the collection: the scope is a body field, and a bulk delete
+ * keyed by a query string is too easy to fire by accident. Session-only, like the rest of `/api/v3/tags`.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { deleteUnusedV3Tags } from "../lib/operations";
+import { ZV3DeleteUnusedTagsBody } from "../lib/schemas";
+
+export const POST = withV3ApiWrapper({
+  auth: "session",
+  action: "deleted",
+  targetType: "tag",
+  schemas: { body: ZV3DeleteUnusedTagsBody },
+  handler: async ({ authentication, parsedInput, auditLog, requestId, instance }) =>
+    deleteUnusedV3Tags({
+      authentication,
+      workspaceId: parsedInput.body.workspaceId,
+      auditLog,
+      requestId,
+      instance,
+    }),
+});
