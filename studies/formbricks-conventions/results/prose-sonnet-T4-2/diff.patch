+/**
+ * Deletes every tag of a workspace that is on no response.
+ *
+ * "Used" is decided on the junction table itself, not on the visibility-filtered counts the list shows:
+ * a tag that only sits on a response of a survey the caller cannot see is still in use and must survive.
+ * One `deleteMany` keeps the check and the delete in the same statement.
+ */
+export const deleteUnusedTags = async (
+  workspaceId: string
+): Promise<Result<{ deletedCount: number }, { code: TagError; message: string }>> => {
+  validateInputs([workspaceId, ZId]);
+
+  try {
+    const { count } = await prisma.tag.deleteMany({
+      where: { workspaceId, responses: { none: {} } },
+    });
+
+    return ok({ deletedCount: count });
+  } catch (error) {
+    return err({
+      code: TagError.UNEXPECTED_ERROR,
+      message: error instanceof Error ? error.message : "Unknown error occurred",
+    });
+  }
+};
