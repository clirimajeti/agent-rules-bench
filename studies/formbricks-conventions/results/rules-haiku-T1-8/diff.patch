+"use client";
+
+import { useMutation } from "@tanstack/react-query";
+import { rotateApiKeyRequest } from "../lib/api-client";
+
+/**
+ * Rotate a key's secret. Nothing is invalidated on success: the list keeps the key's id, label and access
+ * settings, so the caller updates its own row from the response.
+ */
+export const useRotateApiKey = () =>
+  useMutation({
+    mutationFn: (apiKeyId: string) => rotateApiKeyRequest({ apiKeyId }),
+  });
diff --git a/apps/web/modules/organization/settings/api-keys/lib/api-client.ts b/apps/web/modules/organization/settings/api-keys/lib/api-client.ts
new file mode 100644
index 000000000..b806d9a56
--- /dev/null
+++ b/apps/web/modules/organization/settings/api-keys/lib/api-client.ts
@@ -0,0 +1,23 @@
+import { parseV3ApiError } from "@/modules/api/lib/v3-client";
+
+/**
+ * Client fetchers for the API key v3 routes. Every call throws a parsed `V3ApiError` on a non-2xx response,
+ * so callers can surface the server's own message.
+ */
+
+export type TRotatedApiKey = {
+  id: string;
+  /** The new secret, returned once. It is not stored in plaintext and cannot be retrieved again. */
+  actualKey: string;
+};
+
+export async function rotateApiKeyRequest(params: { apiKeyId: string }): Promise<TRotatedApiKey> {
+  const response = await fetch(`/api/v3/api-keys/${params.apiKeyId}/rotate`, {
+    method: "POST",
+    cache: "no-store",
+  });
+  if (!response.ok) {
+    throw await parseV3ApiError(response);
+  }
+  return ((await response.json()) as { data: TRotatedApiKey }).data;
+}
