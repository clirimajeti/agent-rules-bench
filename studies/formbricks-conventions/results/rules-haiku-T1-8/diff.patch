+"use client";
+
+import { FilesIcon } from "lucide-react";
+import toast from "react-hot-toast";
+import { useTranslation } from "react-i18next";
+import { Button } from "@/modules/ui/components/button";
+import {
+  Dialog,
+  DialogBody,
+  DialogContent,
+  DialogDescription,
+  DialogFooter,
+  DialogHeader,
+  DialogTitle,
+} from "@/modules/ui/components/dialog";
+
+interface RotatedApiKeyModalProps {
+  /** The rotated key and its label while the dialog is open, `null` once it has been dismissed. */
+  rotatedKey: { label: string; secret: string } | null;
+  onClose: () => void;
+}
+
+/**
+ * Shows a rotated secret once. The parent clears its copy on close, so the plaintext does not outlive
+ * this dialog. Outside clicks do not dismiss it, so the key is not lost to a stray click.
+ */
+export const RotatedApiKeyModal = ({ rotatedKey, onClose }: Readonly<RotatedApiKeyModalProps>) => {
+  const { t } = useTranslation();
+
+  const copyToClipboard = async () => {
+    if (!rotatedKey) return;
+    try {
+      await navigator.clipboard.writeText(rotatedKey.secret);
+      toast.success(t("workspace.api_keys.api_key_copied_to_clipboard"));
+    } catch {
+      toast.error(t("workspace.api_keys.unable_to_copy_api_key"));
+    }
+  };
+
+  return (
+    <Dialog
+      open={rotatedKey !== null}
+      onOpenChange={(open) => {
+        if (!open) onClose();
+      }}>
+      <DialogContent disableCloseOnOutsideClick={true}>
+        <DialogHeader>
+          <DialogTitle>{t("workspace.api_keys.api_key_rotated")}</DialogTitle>
+          <DialogDescription>
+            {t("workspace.api_keys.rotated_api_key_description", { label: rotatedKey?.label ?? "" })}
+          </DialogDescription>
+        </DialogHeader>
+        <DialogBody className="space-y-4">
+          <div className="flex items-center justify-between gap-2 rounded-md bg-slate-100 p-3">
+            <span className="font-mono text-sm break-all" data-testid="rotated-api-key">
+              {rotatedKey?.secret}
+            </span>
+            <Button
+              type="button"
+              size="icon"
+              variant="ghost"
+              aria-label={t("workspace.api_keys.copy_api_key")}
+              onClick={() => void copyToClipboard()}>
+              <FilesIcon className="size-4" />
+            </Button>
+          </div>
+        </DialogBody>
+        <DialogFooter>
+          <Button type="button" onClick={onClose}>
+            {t("common.done")}
+          </Button>
+        </DialogFooter>
+      </DialogContent>
+    </Dialog>
+  );
+};
