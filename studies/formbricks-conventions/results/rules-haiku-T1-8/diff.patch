index 000000000..b054c7a6f
--- /dev/null
+++ b/apps/web/app/api/v3/api-keys/lib/operations.ts
@@ -0,0 +1,63 @@
+import "server-only";
+import { ZOrganizationAccess } from "@formbricks/types/api-key";
+import { getV3SessionUserId } from "@/app/api/v3/lib/auth";
+import { problemForbidden, problemUnauthorized, successResponse } from "@/app/api/v3/lib/response";
+import type { TV3AuditLog, TV3Authentication } from "@/app/api/v3/lib/types";
+import { can } from "@/lib/authorization";
+import { getApiKey } from "@/lib/utils/services";
+import { rotateApiKey } from "@/modules/organization/settings/api-keys/lib/api-key";
+import { canGrantOrganizationWriteAccess } from "@/modules/organization/settings/api-keys/lib/organization-access";
+
+type TBaseParams = {
+  authentication: TV3Authentication;
+  requestId: string;
+  instance?: string;
+};
+
+/**
+ * Replace a key's secret and answer the new one. Session-only: a key cannot rotate itself, and the
+ * response carries a secret, so it goes only to a signed-in user who may manage the key.
+ *
+ * Authorization matches update and delete (`apiKey.manage` on the key). Rotation keeps the key's access
+ * settings, but it hands out a fresh credential that carries them, so a key with organization write
+ * access also needs the user to clear the user-management floor, as `createApiKeyAction` requires.
+ *
+ * An unknown key answers 403, not 404, so the endpoint does not reveal which key ids exist.
+ */
+export async function rotateV3ApiKey(
+  params: TBaseParams & { apiKeyId: string; auditLog?: TV3AuditLog }
+): Promise<Response> {
+  const { authentication, apiKeyId, auditLog, requestId, instance } = params;
+
+  const userId = getV3SessionUserId(authentication);
+  if (!userId) {
+    return problemUnauthorized(requestId, "Not authenticated", instance);
+  }
+
+  const apiKey = await getApiKey(apiKeyId);
+  if (!apiKey) {
+    return problemForbidden(requestId, "You are not authorized to access this resource", instance);
+  }
+
+  const actor = { type: "user" as const, id: userId };
+  if (!(await can(actor, "apiKey.manage", { type: "apiKey", id: apiKeyId }))) {
+    return problemForbidden(requestId, "You are not authorized to access this resource", instance);
+  }
+
+  // Fail closed: an access value that does not parse is treated as one that needs the grant.
+  const access = ZOrganizationAccess.safeParse(apiKey.organizationAccess);
+  const needsWriteGrant = !access.success || access.data.accessControl.write;
+  if (needsWriteGrant && !(await canGrantOrganizationWriteAccess(userId, apiKey.organizationId))) {
+    return problemForbidden(requestId, "User management is not allowed for your role", instance);
+  }
+
+  if (auditLog) {
+    auditLog.organizationId = apiKey.organizationId;
+    auditLog.targetId = apiKeyId;
+  }
+
+  const rotated = await rotateApiKey(apiKeyId);
+
+  // The audit entry records which key rotated, never the secret or its hashes.
+  return successResponse({ id: rotated.id, actualKey: rotated.actualKey }, { requestId });
+}
