@@ -0,0 +1,15 @@
+import { parseV3ApiError } from "@/modules/api/lib/v3-client";
+
+/**
+ * Client fetcher for rotating an API key via the v3 API.
+ */
+export async function rotateApiKey({ apiKeyId }: { apiKeyId: string }): Promise<{ apiKey: string; actualKey: string }> {
+  const response = await fetch(`/api/v3/api-keys/${encodeURIComponent(apiKeyId)}/rotate`, {
+    method: "POST",
+    cache: "no-store",
+  });
+  if (!response.ok) {
+    throw await parseV3ApiError(response);
+  }
+  return ((await response.json()) as { data: { apiKey: string; actualKey: string } }).data;
+}
