+/**
+ * POST /api/v3/api-keys/{apiKeyId}/rotate — rotate an API key.
+ *
+ * Generates a new secret, hashes it, clears `lastUsedAt`, and returns the new plaintext key
+ * (only ever returned once). Session cookie or x-api-key; the caller must have `apiKey.manage`
+ * on the key being rotated.
+ */
+import { ZId } from "@formbricks/types/common";
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { successResponse } from "@/app/api/v3/lib/response";
+import { rotateApiKeyService } from "./lib/operations";
+
+export const POST = withV3ApiWrapper({
+  auth: "both",
+  action: "updated",
+  targetType: "apiKey",
+  schemas: { params: ZId },
+  handler: async ({ authentication, parsedInput, auditLog, requestId, instance }) => {
+    const result = await rotateApiKeyService({
+      apiKeyId: parsedInput.params.apiKeyId,
+      authentication,
+      auditLog,
+      requestId,
+      instance,
+    });
+    return successResponse(result, { requestId });
+  },
+});
