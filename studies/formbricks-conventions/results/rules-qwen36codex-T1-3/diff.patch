@@ -0,0 +1,40 @@
+"use client";
+
+import { useMutation, useQueryClient } from "@tanstack/react-query";
+import { rotateApiKey } from "./api-client";
+import { organizationApiKeysKeys } from "./query";
+
+/**
+ * Hook for rotating an API key via the v3 API.
+ *
+ * Invalidates the affected api-key detail key so the next read picks up the updated state.
+ */
+export const useRotateApiKey = () => {
+  const queryClient = useQueryClient();
+
+  return useMutation({
+    mutationFn: ({ apiKeyId }: { apiKeyId: string }) => rotateApiKey({ apiKeyId }),
+    onMutate: async ({ apiKeyId }) => {
+      // Cancel outgoing refetches to avoid overwriting the optimistic update
+      await queryClient.cancelQueries({ queryKey: organizationApiKeysKeys.detail(apiKeyId) });
+      const previous = queryClient.getQueryData(organizationApiKeysKeys.detail(apiKeyId));
+      // Optimistically clear the key so the UI shows "secret" immediately
+      queryClient.setQueryData(organizationApiKeysKeys.detail(apiKeyId), (old: unknown) =>
+        old ? { ...old, actualKey: undefined } : old
+      );
+      return { previous };
+    },
+    onError: (_err, _vars, context) => {
+      // Restore the previous data on error
+      if (context?.previous) {
+        queryClient.setQueryData(organizationApiKeysKeys.detail(_vars.apiKeyId), context.previous);
+      }
+    },
+    onSettled: (data, error, { apiKeyId }) => {
+      // Invalidate the detail key so the next read fetches fresh data
+      queryClient.invalidateQueries({ queryKey: organizationApiKeysKeys.detail(apiKeyId) });
+      // Also invalidate the list so the table refreshes
+      queryClient.invalidateQueries({ queryKey: organizationApiKeysKeys.lists() });
+    },
+  });
+};
