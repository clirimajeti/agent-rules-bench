+import "server-only";
+import { assertCan } from "@/lib/authorization";
+import { getOrganizationIdFromApiKeyId } from "@/lib/utils/helper";
+import { rotateApiKey } from "@/modules/organization/settings/api-keys/lib/api-key";
+import type { TV3Authentication, TV3AuditLog } from "@/app/api/v3/lib/types";
+
+export type TRotateApiKeyParams = {
+  apiKeyId: string;
+  authentication: TV3Authentication;
+  auditLog?: TV3AuditLog;
+};
+
+/**
+ * Rotate an API key: validate access, call the service, and return the new plaintext key.
+ *
+ * This is the v3 operation layer — it owns auth, audit context, and error mapping.
+ * The actual rotation logic lives in `@/modules/organization/settings/api-keys/lib/api-key`.
+ */
+export async function rotateApiKeyService(params: TRotateApiKeyParams): Promise<{ apiKey: string; actualKey: string }> {
+  const { apiKeyId, authentication, auditLog } = params;
+
+  // Resolve the organization for audit logging
+  const organizationId = await getOrganizationIdFromApiKeyId(apiKeyId);
+
+  // Verify the caller has permission to manage this key
+  if (authentication?.type === "session") {
+    await assertCan({ type: "user", id: authentication.user.id }, "apiKey.manage", {
+      type: "apiKey",
+      id: apiKeyId,
+    });
+  }
+
+  // Set audit logging context
+  if (auditLog) {
+    auditLog.organizationId = organizationId;
+    auditLog.apiKeyId = apiKeyId;
+    auditLog.newObject = { apiKeyId };
+  }
+
+  // Perform the rotation via the service layer
+  const result = await rotateApiKey(apiKeyId, authentication?.type === "session" ? authentication.user.id : "");
+
+  return {
+    apiKey: result.apiKey.id,
+    actualKey: result.actualKey,
+  };
+}
