@@ -0,0 +1,18 @@
+"use client";
+
+import { useQuery } from "@tanstack/react-query";
+import { accountDataExportKeys, getAccountDataExport } from "../lib/account-data-export-client";
+
+/**
+ * The signed-in user's data export, fetched only on demand: the query is disabled and the button calls
+ * `refetch()`. `gcTime: 0` drops the personal data from the cache once nothing observes it, and
+ * `retry: false` lets a failure reach the user at once instead of after silent retries.
+ */
+export const useAccountDataExport = () =>
+  useQuery({
+    queryKey: accountDataExportKeys.all,
+    queryFn: ({ signal }) => getAccountDataExport({ signal }),
+    enabled: false,
+    gcTime: 0,
+    retry: false,
+  });
diff --git a/apps/web/modules/account/lib/account-data-export-client.ts b/apps/web/modules/account/lib/account-data-export-client.ts
new file mode 100644
index 000000000..e6e9a8d0e
--- /dev/null
+++ b/apps/web/modules/account/lib/account-data-export-client.ts
@@ -0,0 +1,39 @@
+import type { TV3AccountDataExport } from "@/app/api/v3/me/data-export/serializers";
+import { parseV3ApiError } from "@/modules/api/lib/v3-client";
+
+/** Typed query-key factory. Never inline string keys. */
+const accountDataExportKeyBase = ["account-data-export"] as const;
+
+export const accountDataExportKeys = {
+  all: accountDataExportKeyBase,
+};
+
+/** Fetches the signed-in user's data export. Throws a parsed `V3ApiError` on a non-2xx response. */
+export async function getAccountDataExport(params: { signal?: AbortSignal }): Promise<TV3AccountDataExport> {
+  const response = await fetch("/api/v3/me/data-export", {
+    method: "GET",
+    cache: "no-store",
+    signal: params.signal,
+  });
+  if (!response.ok) {
+    throw await parseV3ApiError(response);
+  }
+  return ((await response.json()) as { data: TV3AccountDataExport }).data;
+}
+
+/** Saves the export as a pretty-printed JSON file named after the export date. */
+export const saveAccountDataExportFile = (data: TV3AccountDataExport): void => {
+  const fileName = `formbricks-account-data-${data.exportedAt.slice(0, 10)}.json`;
+  const file = new File([JSON.stringify(data, null, 2)], fileName, {
+    type: "application/json;charset=utf-8",
+  });
+
+  const url = URL.createObjectURL(file);
+  const link = document.createElement("a");
+  link.href = url;
+  link.download = fileName;
+  document.body.appendChild(link);
+  link.click();
+  link.remove();
+  URL.revokeObjectURL(url);
+};
diff --git a/apps/web/modules/account/lib/account-data-export.ts b/apps/web/modules/account/lib/account-data-export.ts
new file mode 100644
index 000000000..ef8c9bac2
--- /dev/null
+++ b/apps/web/modules/account/lib/account-data-export.ts
@@ -0,0 +1,68 @@
+import "server-only";
+import { prisma } from "@formbricks/database";
+import { Prisma } from "@formbricks/database/prisma";
+import { ZId } from "@formbricks/types/common";
+import { DatabaseError } from "@formbricks/types/errors";
+import type { TOrganizationRole } from "@formbricks/types/memberships";
+import type { TUserLocale, TUserNotificationSettings } from "@formbricks/types/user";
+import { validateInputs } from "@/lib/utils/validate";
+
+export type TAccountDataExport = {
+  name: string;
+  email: string;
+  locale: TUserLocale;
+  notificationSettings: TUserNotificationSettings;
+  organizationMemberships: {
+    organizationName: string;
+    role: TOrganizationRole;
+  }[];
+};
+
+/**
+ * The personal data a signed-in user can download from their profile page.
+ *
+ * One query: the user row and their memberships with each organization's name. Memberships are scoped by
+ * `userId` only, so the export never reaches another user's data. Returns `null` when the user no longer
+ * exists.
+ */
+export const getAccountDataExport = async (userId: string): Promise<TAccountDataExport | null> => {
+  validateInputs([userId, ZId]);
+
+  try {
+    const user = await prisma.user.findUnique({
+      where: { id: userId },
+      select: {
+        name: true,
+        email: true,
+        locale: true,
+        notificationSettings: true,
+        memberships: {
+          select: {
+            role: true,
+            organization: { select: { name: true } },
+          },
+          orderBy: { organization: { name: "asc" } },
+        },
+      },
+    });
+
+    if (!user) return null;
+
+    return {
+      name: user.name,
+      email: user.email,
+      locale: user.locale,
+      notificationSettings: user.notificationSettings,
+      organizationMemberships: user.memberships.map((membership) => ({
+        organizationName: membership.organization.name,
+        role: membership.role,
+      })),
+    };
+  } catch (error) {
+    if (error instanceof Prisma.PrismaClientKnownRequestError) {
+      throw new DatabaseError(error.message);
+    }
+
+    throw error;
+  }
+};
