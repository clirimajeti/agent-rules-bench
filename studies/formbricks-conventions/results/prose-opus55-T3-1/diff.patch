+import "server-only";
+import { getV3SessionUserId } from "@/app/api/v3/lib/auth";
+import { problemUnauthorized, successResponse } from "@/app/api/v3/lib/response";
+import type { TV3Authentication } from "@/app/api/v3/lib/types";
+import { getAccountDataExport } from "@/modules/account/lib/account-data-export";
+import { serializeV3AccountDataExport } from "../serializers";
+
+type TExportParams = {
+  authentication: TV3Authentication;
+  requestId: string;
+  instance?: string;
+};
+
+/**
+ * The user is always the one behind the session; the operation takes no identifier, so a caller can
+ * only ever export their own data. A session whose user no longer exists answers 401, like any other
+ * session that no longer identifies anyone.
+ */
+export async function exportV3AccountData({
+  authentication,
+  requestId,
+  instance,
+}: TExportParams): Promise<Response> {
+  const userId = getV3SessionUserId(authentication);
+  if (!userId) {
+    return problemUnauthorized(requestId, "Not authenticated", instance);
+  }
+
+  const data = await getAccountDataExport(userId);
+  if (!data) {
+    return problemUnauthorized(requestId, "Not authenticated", instance);
+  }
+
+  return successResponse(serializeV3AccountDataExport(data, new Date()), { requestId });
+}
