+import type { TUser } from "@formbricks/types/user";
+import { formatDateTimeForDisplay } from "@/lib/utils/datetime";
+import { getTranslate } from "@/lingodotdev/server";
+
+/**
+ * Rendered on the server, so the times cannot follow the browser's zone. There is no per-user time zone
+ * to use instead, so they are shown in UTC and labelled as such rather than in whatever zone the server
+ * happens to run in.
+ */
+const ACTIVITY_DATE_TIME_OPTIONS: Intl.DateTimeFormatOptions = {
+  year: "numeric",
+  month: "long",
+  day: "numeric",
+  hour: "numeric",
+  minute: "2-digit",
+  timeZone: "UTC",
+  timeZoneName: "short",
+};
+
+interface AccountActivityProps {
+  user: Pick<TUser, "createdAt" | "lastLoginAt" | "locale">;
+}
+
+export const AccountActivity = async ({ user }: Readonly<AccountActivityProps>) => {
+  const t = await getTranslate();
+
+  const rows = [
+    {
+      label: t("workspace.settings.profile.account_created"),
+      date: user.createdAt,
+    },
+    {
+      label: t("workspace.settings.profile.last_login"),
+      date: user.lastLoginAt,
+    },
+  ];
+
+  return (
+    <dl className="grid gap-4 text-sm sm:grid-cols-2">
+      {rows.map((row) => (
+        <div key={row.label}>
+          <dt className="font-medium text-slate-900">{row.label}</dt>
+          <dd className="mt-1 text-slate-700">
+            {row.date ? (
+              <time dateTime={row.date.toISOString()}>
+                {formatDateTimeForDisplay(row.date, user.locale, ACTIVITY_DATE_TIME_OPTIONS)}
+              </time>
+            ) : (
+              t("workspace.settings.profile.last_login_never")
+            )}
+          </dd>
+        </div>
+      ))}
+    </dl>
+  );
+};
