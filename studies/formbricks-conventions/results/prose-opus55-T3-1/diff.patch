+get:
+  operationId: exportAccountDataV3
+  # Session-only by design: the export is about the person behind the session, and an API key has no
+  # person. Excluded from the generated docs pages like the other session-only operations; it stays in
+  # the bundle for the contract tests, which check it against its documented 401.
+  x-excluded: true
+  summary: Export my account data
+  description: |
+    Returns the signed-in user's personal data: name, email, language, notification settings and
+    organization memberships with each organization's name and the user's role in it.
+
+    Session cookie only. This backs the **Download my data** button on the account profile page, so it
+    does not accept `x-api-key`.
+  tags:
+    - V3 Account
+  responses:
+    "200":
+      description: Account data exported successfully
+      headers:
+        X-Request-Id:
+          schema:
+            type: string
+          description: Request correlation ID
+        Cache-Control:
+          schema:
+            type: string
+          example: private, no-store
+      content:
+        application/json:
+          schema:
+            type: object
+            required:
+              - data
+            properties:
+              data:
+                $ref: ../components/schemas/AccountDataExport.yml
+    "400":
+      $ref: ../components/responses/V3BadRequest.yml
+    "401":
+      $ref: ../components/responses/V3UnauthorizedSession.yml
+    "429":
+      $ref: ../components/responses/V3TooManyRequests.yml
+    "500":
+      $ref: ../components/responses/V3InternalServerError.yml
+  security:
+    - sessionAuth: []
