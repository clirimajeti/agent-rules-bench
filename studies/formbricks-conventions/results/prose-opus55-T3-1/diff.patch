@@ -0,0 +1,55 @@
+import { beforeEach, describe, expect, test, vi } from "vitest";
+import type { Session } from "@formbricks/types/auth";
+import type { TV3Authentication } from "@/app/api/v3/lib/types";
+import { getAccountDataExport } from "@/modules/account/lib/account-data-export";
+import { exportV3AccountData } from "./operations";
+
+vi.mock("server-only", () => ({}));
+vi.mock("@/modules/account/lib/account-data-export", () => ({ getAccountDataExport: vi.fn() }));
+
+const userId = "clxx1234567890123456789012";
+const session = { user: { id: userId }, expires: "2099-01-01T00:00:00.000Z" } as unknown as Session;
+const base = { requestId: "req_1", instance: "/api/v3/me/data-export" };
+
+const accountData = {
+  name: "Ada Lovelace",
+  email: "ada@example.com",
+  locale: "en-US" as const,
+  notificationSettings: { alert: { survey_1: true }, unsubscribedOrganizationIds: [] },
+  organizationMemberships: [{ organizationName: "Acme", role: "owner" as const }],
+};
+
+beforeEach(() => {
+  vi.resetAllMocks();
+});
+
+describe("exportV3AccountData", () => {
+  test("exports the data of the user behind the session, stamped with the export time", async () => {
+    vi.mocked(getAccountDataExport).mockResolvedValue(accountData);
+
+    const response = await exportV3AccountData({ ...base, authentication: session });
+
+    expect(response.status).toBe(200);
+    expect(getAccountDataExport).toHaveBeenCalledWith(userId);
+    const body = await response.json();
+    expect(body.data).toMatchObject(accountData);
+    expect(new Date(body.data.exportedAt).toISOString()).toBe(body.data.exportedAt);
+  });
+
+  test("answers 401 when the authentication carries no user", async () => {
+    const apiKey = { type: "apiKey", apiKeyId: "key_1" } as unknown as TV3Authentication;
+
+    const response = await exportV3AccountData({ ...base, authentication: apiKey });
+
+    expect(response.status).toBe(401);
+    expect(getAccountDataExport).not.toHaveBeenCalled();
+  });
+
+  test("answers 401 when the session's user no longer exists", async () => {
+    vi.mocked(getAccountDataExport).mockResolvedValue(null);
+
+    const response = await exportV3AccountData({ ...base, authentication: session });
+
+    expect(response.status).toBe(401);
+  });
+});
