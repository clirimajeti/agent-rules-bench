+/**
+ * GET /api/v3/me/data-export - the signed-in user's personal data as a downloadable JSON document.
+ *
+ * Session-only, deliberately. The export is about the person behind the session, and an API key belongs
+ * to an organization, not a person, so accepting `x-api-key` would have no user to export.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { exportV3AccountData } from "./lib/operations";
+import { ZV3AccountDataExportQuery } from "./lib/schemas";
+
+export const GET = withV3ApiWrapper({
+  auth: "session",
+  schemas: { query: ZV3AccountDataExportQuery },
+  handler: async ({ authentication, requestId, instance }) =>
+    exportV3AccountData({ authentication, requestId, instance }),
+});
