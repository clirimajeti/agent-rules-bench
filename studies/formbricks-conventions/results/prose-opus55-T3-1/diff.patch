+import type { TAccountDataExport } from "@/modules/account/lib/account-data-export";
+
+export type TV3AccountDataExport = TAccountDataExport & {
+  /** When the export was produced, ISO 8601 in UTC. */
+  exportedAt: string;
+};
+
+export const serializeV3AccountDataExport = (
+  data: TAccountDataExport,
+  exportedAt: Date
+): TV3AccountDataExport => ({
+  exportedAt: exportedAt.toISOString(),
+  name: data.name,
+  email: data.email,
+  locale: data.locale,
+  notificationSettings: data.notificationSettings,
+  organizationMemberships: data.organizationMemberships.map((membership) => ({
+    organizationName: membership.organizationName,
+    role: membership.role,
+  })),
+});
