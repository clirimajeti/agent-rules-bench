+/**
+ * POST /api/v3/api-keys/[apiKeyId]/rotate — rotate an API key's secret.
+ *
+ * The old secret is immediately invalidated and replaced with a new one. The caller must hold
+ * `apiKey.manage` on the key; the route enforces that via `assertCan`.
+ */
+import { z } from "zod";
+import { NextResponse } from "next/server";
+import { ZId } from "@formbricks/types/common";
+import { getOrganizationIdFromApiKeyId } from "@/lib/utils/helper";
+import { assertCan } from "@/lib/authorization";
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { ZV3EmptyQuery } from "@/app/api/v3/lib/schemas";
+import { rotateApiKey } from "@/modules/organization/settings/api-keys/lib/api-key";
+
+const ZApiKeyIdParam = z.object({
+  apiKeyId: ZId,
+});
+
+type TApiKeyIdParams = z.infer<typeof ZApiKeyIdParam>;
+
+export const POST = withV3ApiWrapper({
+  auth: "both",
+  action: "rotated",
+  targetType: "apiKey",
+  schemas: {
+    params: ZApiKeyIdParam,
+    query: ZV3EmptyQuery,
+  },
+  handler: async ({ authentication, parsedInput, auditLog, requestId, instance }) => {
+    const organizationId = await getOrganizationIdFromApiKeyId(parsedInput.params.apiKeyId);
+
+    await assertCan({ type: "user", id: authentication.userId! }, "apiKey.manage", {
+      type: "apiKey",
+      id: parsedInput.params.apiKeyId,
+    });
+
+    auditLog!.organizationId = organizationId;
+    auditLog!.apiKeyId = parsedInput.params.apiKeyId;
+
+    const result = await rotateApiKey(parsedInput.params.apiKeyId);
+
+    auditLog!.newObject = { apiKeyId: result.id };
+
+    return NextResponse.json({ data: { id: result.id, actualKey: result.actualKey } });
+  },
+});
