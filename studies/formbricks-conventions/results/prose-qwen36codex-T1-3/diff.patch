@@ -258,3 +259,49 @@ export const updateApiKey = async (apiKeyId: string, data: TApiKeyUpdateInput):
     throw error;
   }
 };
+
+export const rotateApiKey = async (apiKeyId: string): Promise<{ id: string; actualKey: string }> => {
+  validateInputs([apiKeyId, ZId]);
+
+  try {
+    // Generate a new secret
+    const secret = randomBytes(32).toString("base64url");
+    const lookupHash = hashSha256(secret);
+    const hashedKey = await hashSecret(secret, 12);
+
+    // Update the key in place
+    const result = await prisma.apiKey.update({
+      where: { id: apiKeyId },
+      data: { hashedKey, lookupHash, lastUsedAt: null },
+    });
+
+    await runPostCommitProjection("api_key_rotate_relationship_reconciliation", () =>
+      reconcileApiKeyRelationships({ apiKeyIds: [apiKeyId] })
+    );
+
+    return { id: result.id, actualKey: `fbk_${secret}` };
+  } catch (error) {
+    if (error instanceof Prisma.PrismaClientKnownRequestError) {
+      throw new DatabaseError(error.message);
+    }
+    throw error;
+  }
+};
+
+/**
+ * Client-side wrapper for rotating an API key via the v3 API.
+ *
+ * Used by the edit-api-keys component with TanStack Query's `useMutation`.
+ */
+export async function rotateApiKeyClient(apiKeyId: string): Promise<{ id: string; actualKey: string }> {
+  const response = await fetch(`/api/v3/api-keys/${encodeURIComponent(apiKeyId)}/rotate`, {
+    method: "POST",
+    cache: "no-store",
+  });
+  if (!response.ok) {
+    const { parseV3ApiError } = await import("@/modules/api/lib/v3-client");
+    throw await parseV3ApiError(response);
+  }
+  const json = await response.json();
+  return json.data;
+}
