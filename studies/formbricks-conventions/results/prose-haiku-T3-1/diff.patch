@@ -0,0 +1,35 @@
+"use client";
+
+import { useTranslation } from "react-i18next";
+import { TUser } from "@formbricks/types/user";
+import { saveBlobAsFile } from "@/modules/ee/data-retention/lib/file-download";
+import { Button } from "@/modules/ui/components/button";
+
+export interface TAccountData {
+  name: string;
+  email: string;
+  locale: string;
+  notificationSettings: TUser["notificationSettings"];
+  organizationMemberships: { organizationName: string; role: string }[];
+}
+
+interface DownloadAccountDataButtonProps {
+  accountData: TAccountData;
+}
+
+export const DownloadAccountDataButton = ({ accountData }: Readonly<DownloadAccountDataButtonProps>) => {
+  const { t } = useTranslation();
+
+  const handleDownload = () => {
+    const exportedAt = new Date();
+    const json = JSON.stringify({ exportedAt: exportedAt.toISOString(), ...accountData }, null, 2);
+    const blob = new Blob([json], { type: "application/json;charset=utf-8" });
+    saveBlobAsFile(blob, `formbricks-account-data-${exportedAt.toISOString().slice(0, 10)}.json`);
+  };
+
+  return (
+    <Button variant="secondary" onClick={handleDownload}>
+      {t("workspace.settings.profile.download_my_data")}
+    </Button>
+  );
+};
