 });
+
+// Only accepted memberships: a pending row is an invitation the user has not joined yet.
+export const getUserOrganizationMemberships = reactCache(async (userId: string) =>
+  prisma.membership.findMany({
+    where: { userId, accepted: true },
+    select: {
+      role: true,
+      organization: { select: { name: true } },
+    },
+    orderBy: { organization: { name: "asc" } },
+  })
+);
