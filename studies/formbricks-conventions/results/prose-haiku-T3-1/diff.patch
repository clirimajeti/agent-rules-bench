@@ -0,0 +1,37 @@
+import { getTranslate } from "@/lingodotdev/server";
+import { formatDateTimeForDisplay } from "@/lib/utils/datetime";
+
+// Explicit UTC with the zone name shown: the stored timestamps are UTC, and a browser or server default
+// zone would make the same sign-in read differently on different machines.
+const ACCOUNT_DATE_TIME_OPTIONS: Intl.DateTimeFormatOptions = {
+  year: "numeric",
+  month: "short",
+  day: "numeric",
+  hour: "numeric",
+  minute: "2-digit",
+  timeZone: "UTC",
+  timeZoneName: "short",
+};
+
+interface AccountActivityProps {
+  createdAt: Date;
+  lastLoginAt: Date | null;
+  locale: string;
+}
+
+export const AccountActivity = async ({ createdAt, lastLoginAt, locale }: Readonly<AccountActivityProps>) => {
+  const t = await getTranslate();
+
+  return (
+    <dl className="grid grid-cols-[max-content_1fr] gap-x-6 gap-y-2 text-sm">
+      <dt className="font-medium text-slate-700">{t("workspace.settings.profile.account_created")}</dt>
+      <dd className="text-slate-600">{formatDateTimeForDisplay(createdAt, locale, ACCOUNT_DATE_TIME_OPTIONS)}</dd>
+      <dt className="font-medium text-slate-700">{t("workspace.settings.profile.last_login")}</dt>
+      <dd className="text-slate-600">
+        {lastLoginAt
+          ? formatDateTimeForDisplay(lastLoginAt, locale, ACCOUNT_DATE_TIME_OPTIONS)
+          : t("workspace.settings.profile.last_login_not_recorded")}
+      </dd>
+    </dl>
+  );
+};
diff --git a/apps/web/app/(app)/workspaces/[workspaceId]/settings/account/profile/components/DownloadAccountDataButton.tsx b/apps/web/app/(app)/workspaces/[workspaceId]/settings/account/profile/components/DownloadAccountDataButton.tsx
