+get:
+  operationId: getAccountDataV3
+  # Session-only by design: it exports the personal data of the signed-in user, so an API key has no
+  # user to export. Excluded from the generated docs pages like the other session-only operations.
+  x-excluded: true
+  summary: Download my data
+  description: |
+    Returns the signed-in user's own data: name, email, locale, notification settings and the
+    organizations they belong to with their role. The response is sent as a JSON attachment
+    (`Content-Disposition: attachment`).
+
+    Session cookie only. This backs the "Download my data" button on the account profile page, so it
+    does not accept `x-api-key`.
+  tags:
+    - V3 Account
+  responses:
+    "200":
+      description: Account data retrieved successfully
+      headers:
+        X-Request-Id:
+          schema:
+            type: string
+          description: Request correlation ID
+        Cache-Control:
+          schema:
+            type: string
+          example: private, no-store
+        Content-Disposition:
+          schema:
+            type: string
+          example: attachment; filename="formbricks-account-data.json"
+      content:
+        application/json:
+          schema:
+            type: object
+            required:
+              - data
+            properties:
+              data:
+                $ref: ../components/schemas/AccountDataResource.yml
+    "401":
+      $ref: ../components/responses/V3UnauthorizedSession.yml
+    "403":
+      $ref: ../components/responses/V3Forbidden.yml
+    "429":
+      $ref: ../components/responses/V3TooManyRequests.yml
+    "500":
+      $ref: ../components/responses/V3InternalServerError.yml
+  security:
+    - sessionAuth: []
