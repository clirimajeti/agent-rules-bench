diff --git a/apps/web/modules/account/lib/account-data-client.ts b/apps/web/modules/account/lib/account-data-client.ts
new file mode 100644
index 000000000..25d11c6a8
--- /dev/null
+++ b/apps/web/modules/account/lib/account-data-client.ts
@@ -0,0 +1,31 @@
+import { parseV3ApiError } from "@/modules/api/lib/v3-client";
+
+const ACCOUNT_DATA_PATH = "/api/v3/account/data";
+const ACCOUNT_DATA_FILE_NAME = "formbricks-account-data.json";
+
+/**
+ * The signed-in user's data as a JSON file. Fetched rather than linked, so a refusal (a rate limit, an
+ * expired session) is problem JSON that surfaces as an error instead of being saved as the "export".
+ */
+export async function fetchAccountData(signal?: AbortSignal): Promise<{ blob: Blob; fileName: string }> {
+  const response = await fetch(ACCOUNT_DATA_PATH, { method: "GET", cache: "no-store", signal });
+  if (!response.ok) throw await parseV3ApiError(response);
+  return { blob: await response.blob(), fileName: ACCOUNT_DATA_FILE_NAME };
+}
+
+/** Hand a blob to the browser as a file download. */
+export const saveBlobAsFile = (blob: Blob, fileName: string): void => {
+  const url = URL.createObjectURL(blob);
+  const link = document.createElement("a");
+  link.href = url;
+  link.download = fileName;
+  link.style.display = "none";
+  document.body.appendChild(link);
+  try {
+    link.click();
+  } finally {
+    link.remove();
+    // Revoked on the next task: some browsers read the URL only after `click()` has returned.
+    setTimeout(() => URL.revokeObjectURL(url), 0);
+  }
+};
diff --git a/apps/web/modules/account/lib/account-data-export.ts b/apps/web/modules/account/lib/account-data-export.ts
new file mode 100644
index 000000000..b9beec968
--- /dev/null
+++ b/apps/web/modules/account/lib/account-data-export.ts
@@ -0,0 +1,46 @@
+import "server-only";
+import { prisma } from "@formbricks/database";
+import type { OrganizationRole } from "@formbricks/database/prisma";
+import type { TUserNotificationSettings } from "@formbricks/types/user";
+
+export type TAccountDataExport = {
+  name: string;
+  email: string;
+  locale: string;
+  notificationSettings: TUserNotificationSettings;
+  organizations: { name: string; role: OrganizationRole }[];
+};
+
+/**
+ * The personal data held on a user, for the "Download my data" export. Pending invitations are not
+ * memberships, so only accepted ones are listed. Returns null when the user no longer exists.
+ */
+export const getAccountDataExport = async (userId: string): Promise<TAccountDataExport | null> => {
+  const user = await prisma.user.findUnique({
+    where: { id: userId },
+    select: {
+      name: true,
+      email: true,
+      locale: true,
+      notificationSettings: true,
+      memberships: {
+        where: { accepted: true },
+        select: { role: true, organization: { select: { name: true } } },
+        orderBy: { organization: { name: "asc" } },
+      },
+    },
+  });
+
+  if (!user) return null;
+
+  return {
+    name: user.name,
+    email: user.email,
+    locale: user.locale,
+    notificationSettings: user.notificationSettings as TUserNotificationSettings,
+    organizations: user.memberships.map((membership) => ({
+      name: membership.organization.name,
+      role: membership.role,
+    })),
+  };
+};
