diff --git a/apps/web/app/api/v3/account/data/lib/operations.ts b/apps/web/app/api/v3/account/data/lib/operations.ts
new file mode 100644
index 000000000..1d90db559
--- /dev/null
+++ b/apps/web/app/api/v3/account/data/lib/operations.ts
@@ -0,0 +1,33 @@
+import "server-only";
+import { getV3SessionUserId } from "@/app/api/v3/lib/auth";
+import { problemForbidden, problemInternalError, successResponse } from "@/app/api/v3/lib/response";
+import type { TV3Authentication } from "@/app/api/v3/lib/types";
+import { getAccountDataExport } from "@/modules/account/lib/account-data-export";
+
+export const ACCOUNT_DATA_FILE_NAME = "formbricks-account-data.json";
+
+/**
+ * The signed-in user's own data. The user is always the session's, never a client-supplied id, so
+ * nobody can export another account.
+ */
+export async function getV3AccountData(params: {
+  authentication: TV3Authentication;
+  requestId: string;
+  instance?: string;
+}): Promise<Response> {
+  const { authentication, requestId, instance } = params;
+
+  const userId = getV3SessionUserId(authentication);
+  if (!userId) {
+    return problemForbidden(requestId, "You are not authorized to access this resource", instance);
+  }
+
+  const data = await getAccountDataExport(userId);
+  if (!data) {
+    return problemInternalError(requestId, "Unable to export account data", instance);
+  }
+
+  const response = successResponse(data, { requestId });
+  response.headers.set("Content-Disposition", `attachment; filename="${ACCOUNT_DATA_FILE_NAME}"`);
+  return response;
+}
