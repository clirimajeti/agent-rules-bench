+"use client";
+
+import { useMutation } from "@tanstack/react-query";
+import { useEffect, useRef } from "react";
+import { useTranslation } from "react-i18next";
+import toast from "react-hot-toast";
+import { fetchAccountData, saveBlobAsFile } from "@/modules/account/lib/account-data-client";
+import { getV3ApiErrorMessage } from "@/modules/api/lib/v3-client";
+import { Button } from "@/modules/ui/components/button";
+
+export const DownloadMyData = () => {
+  const { t } = useTranslation();
+  const inFlight = useRef<AbortController | null>(null);
+  useEffect(() => () => inFlight.current?.abort(), []);
+
+  const download = useMutation({
+    mutationFn: async () => {
+      inFlight.current?.abort();
+      const controller = new AbortController();
+      inFlight.current = controller;
+      const { blob, fileName } = await fetchAccountData(controller.signal);
+      if (!controller.signal.aborted) saveBlobAsFile(blob, fileName);
+    },
+    onError: (error) => {
+      toast.error(getV3ApiErrorMessage(error, t("common.something_went_wrong_please_try_again")));
+    },
+  });
+
+  return (
+    <Button variant="secondary" loading={download.isPending} onClick={() => download.mutate()}>
+      {t("workspace.settings.profile.download_my_data")}
+    </Button>
+  );
+};
