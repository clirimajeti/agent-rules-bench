+post:
+  operationId: rotateApiKeyV3
+  # Session-only by design: API keys are managed from the Formbricks app (Organization settings → API
+  # Keys), and a key must not be able to mint a replacement for itself. Excluded from the generated docs
+  # pages like the other session-only operations (ENG-2533); the operation stays in the bundle for the
+  # contract tests.
+  x-excluded: true
+  summary: Rotate an API key
+  description: |
+    Replaces the secret of an API key. The key keeps its id, label, workspace access and organization
+    access; the previous secret stops working immediately, and `lastUsedAt` is cleared.
+
+    The new key is in the response and is never retrievable again.
+
+    Requires organization owner/manager. Rotating a key with organization write access additionally
+    requires the organization's user-management role. An unknown `apiKeyId` answers `403`, not `404`, so
+    key ids cannot be probed for existence.
+  tags:
+    - V3 API Keys
+  parameters:
+    - in: path
+      name: apiKeyId
+      required: true
+      schema:
+        type: string
+        format: cuid2
+      description: The API key to rotate.
+  responses:
+    "200":
+      description: API key rotated successfully
+      content:
+        application/json:
+          schema:
+            type: object
+            required:
+              - data
+            properties:
+              data:
+                type: object
+                required:
+                  - id
+                  - label
+                  - createdAt
+                  - lastUsedAt
+                  - organizationAccess
+                  - apiKeyWorkspaces
+                  - actualKey
+                properties:
+                  id:
+                    type: string
+                    format: cuid2
+                  label:
+                    type: string
+                  createdAt:
+                    type: string
+                    format: date-time
+                  lastUsedAt:
+                    type:
+                      - string
+                      - "null"
+                    format: date-time
+                    description: Always `null` right after a rotation.
+                  organizationAccess:
+                    type: object
+                    description: The key's organization access, unchanged by the rotation.
+                    additionalProperties: true
+                  apiKeyWorkspaces:
+                    type: array
+                    description: The key's workspace permissions, unchanged by the rotation.
+                    items:
+                      type: object
+                      required:
+                        - workspaceId
+                        - permission
+                      properties:
+                        workspaceId:
+                          type: string
+                        permission:
+                          type: string
+                          enum:
+                            - read
+                            - write
+                            - manage
+                  actualKey:
+                    type: string
+                    description: The new plaintext key (`fbk_...`). Shown once.
+    "400":
+      $ref: ../components/responses/V3BadRequest.yml
+    "401":
+      $ref: ../components/responses/V3UnauthorizedSession.yml
+    "403":
+      $ref: ../components/responses/V3Forbidden.yml
+    "429":
+      $ref: ../components/responses/V3TooManyRequests.yml
+    "500":
+      $ref: ../components/responses/V3InternalServerError.yml
+  security:
+    - sessionAuth: []
