+/**
+ * POST /api/v3/api-keys/{apiKeyId}/rotate - replace the key's secret, keeping its label and access.
+ * The new plaintext key is in this response only.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { rotateV3ApiKey } from "../../lib/operations";
+import { ZV3ApiKeyIdParams } from "../../lib/schemas";
+
+export const POST = withV3ApiWrapper({
+  auth: "session",
+  action: "updated",
+  targetType: "apiKey",
+  schemas: { params: ZV3ApiKeyIdParams },
+  handler: async ({ authentication, parsedInput, auditLog, requestId, instance }) =>
+    rotateV3ApiKey({
+      authentication,
+      apiKeyId: parsedInput.params.apiKeyId,
+      auditLog,
+      requestId,
+      instance,
+    }),
+});
diff --git a/apps/web/app/api/v3/api-keys/lib/operations.ts b/apps/web/app/api/v3/api-keys/lib/operations.ts
new file mode 100644
index 000000000..a5be82bca
--- /dev/null
+++ b/apps/web/app/api/v3/api-keys/lib/operations.ts
@@ -0,0 +1,60 @@
+import "server-only";
+import { OperationNotAllowedError } from "@formbricks/types/errors";
+import { getV3SessionUserId } from "@/app/api/v3/lib/auth";
+import { problemForbidden, problemUnauthorized, successResponse } from "@/app/api/v3/lib/response";
+import type { TV3AuditLog, TV3Authentication } from "@/app/api/v3/lib/types";
+import { can } from "@/lib/authorization";
+import { getApiKeyAccess, rotateApiKey } from "@/modules/organization/settings/api-keys/lib/api-key";
+import { assertCanGrantOrganizationAccess } from "@/modules/organization/settings/api-keys/lib/organization-access";
+
+/**
+ * Rotating is the same authority as the old update and delete actions: `apiKey.manage` on the key. An
+ * unknown key answers 403, not 404, so key ids cannot be probed for existence.
+ *
+ * A key that carries organization write access can manage the organization's users, so re-minting its
+ * secret is held to the same user-management floor as creating it (ENG-3075): without the check a caller
+ * below the floor could obtain a working secret for a key above it.
+ */
+export async function rotateV3ApiKey(params: {
+  authentication: TV3Authentication;
+  apiKeyId: string;
+  auditLog?: TV3AuditLog;
+  requestId: string;
+  instance?: string;
+}): Promise<Response> {
+  const { authentication, apiKeyId, auditLog, requestId, instance } = params;
+
+  const userId = getV3SessionUserId(authentication);
+  if (!userId) {
+    return problemUnauthorized(requestId, "Session required", instance);
+  }
+
+  const forbidden = () =>
+    problemForbidden(requestId, "You are not authorized to access this resource", instance);
+
+  const access = await getApiKeyAccess(apiKeyId);
+  if (!access) return forbidden();
+
+  const allowed = await can({ type: "user", id: userId }, "apiKey.manage", {
+    type: "apiKey",
+    id: apiKeyId,
+  });
+  if (!allowed) return forbidden();
+
+  try {
+    await assertCanGrantOrganizationAccess(userId, access.organizationId, access.organizationAccess);
+  } catch (error) {
+    if (error instanceof OperationNotAllowedError) return forbidden();
+    throw error;
+  }
+
+  if (auditLog) {
+    auditLog.organizationId = access.organizationId;
+    auditLog.targetId = apiKeyId;
+  }
+
+  const rotated = await rotateApiKey(apiKeyId);
+
+  // The audit entry records that a rotation happened, never the secret or its hashes.
+  return successResponse(rotated, { requestId });
+}
