+/** The tenant and access a key carries, which is what authorizing a change to it depends on. */
+export const getApiKeyAccess = async (
+  apiKeyId: string
+): Promise<{ organizationId: string; organizationAccess: TOrganizationAccess } | null> => {
+  validateInputs([apiKeyId, ZId]);
+
+  try {
+    return await prisma.apiKey.findUnique({
+      where: { id: apiKeyId },
+      select: { organizationId: true, organizationAccess: true },
+    });
+  } catch (error) {
+    if (error instanceof Prisma.PrismaClientKnownRequestError) {
+      throw new DatabaseError(error.message);
+    }
+    throw error;
+  }
+};
+
+/**
+ * Replace a key's secret in place. The row keeps its id, label, creator and workspace/organization
+ * access, so nothing that references the key (permissions, the authorization projection) changes; only the
+ * two hashes move, which makes the old secret stop authenticating at once. `lastUsedAt` is cleared because
+ * the new secret has never been used.
+ *
+ * Returns the new plaintext key, which exists only in this return value.
+ */
+export const rotateApiKey = async (
+  apiKeyId: string
+): Promise<TApiKeyWithEnvironmentPermission & { actualKey: string }> => {
+  validateInputs([apiKeyId, ZId]);
+
+  try {
+    const secret = randomBytes(32).toString("base64url");
+    const lookupHash = hashSha256(secret);
+    const hashedKey = await hashSecret(secret, 12);
+
+    const result = await prisma.apiKey.update({
+      where: { id: apiKeyId },
+      data: { hashedKey, lookupHash, lastUsedAt: null },
+      select: {
+        id: true,
+        label: true,
+        createdAt: true,
+        lastUsedAt: true,
+        organizationAccess: true,
+        apiKeyWorkspaces: {
+          select: {
+            permission: true,
+            workspaceId: true,
+          },
+        },
+      },
+    });
+
+    return { ...result, actualKey: `fbk_${secret}` };
+  } catch (error) {
+    if (error instanceof Prisma.PrismaClientKnownRequestError) {
+      throw new DatabaseError(error.message);
+    }
+    throw error;
+  }
+};
