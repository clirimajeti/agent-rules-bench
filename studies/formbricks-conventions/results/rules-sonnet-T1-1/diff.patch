+"use client";
+
+import { useMutation } from "@tanstack/react-query";
+import { rotateApiKey } from "../lib/api-client";
+
+/**
+ * Rotate an API key. The result carries the new plaintext key, so the caller puts it into local state
+ * rather than invalidating a query: the list is server-rendered and never returns the secret.
+ */
+export const useRotateApiKey = () =>
+  useMutation({
+    mutationFn: (variables: { apiKeyId: string }) => rotateApiKey(variables),
+  });
