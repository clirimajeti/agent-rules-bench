+/**
+ * Deletes every tag of the workspace that no response carries. The "unused" check runs inside the delete
+ * statement itself, so a tag applied to a response while this runs is kept rather than deleted.
+ * This looks at real links, not the caller-visible counts the list shows: a tag used only on a response
+ * the caller cannot see is still used.
+ */
+export const deleteUnusedTags = async (
+  workspaceId: string
+): Promise<Result<{ deleted: number }, { code: TagError; message: string }>> => {
+  validateInputs([workspaceId, ZId]);
+
+  try {
+    const { count } = await prisma.tag.deleteMany({
+      where: { workspaceId, responses: { none: {} } },
+    });
+
+    return ok({ deleted: count });
+  } catch (error) {
+    return err({
+      code: TagError.UNEXPECTED_ERROR,
+      message: error instanceof Error ? error.message : "Unknown error occurred",
+    });
+  }
+};
