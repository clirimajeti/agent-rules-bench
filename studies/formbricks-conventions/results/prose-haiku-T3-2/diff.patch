@@ -0,0 +1,34 @@
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { problemUnauthorized } from "@/app/api/v3/lib/response";
+import { rateLimitConfigs } from "@/modules/core/rate-limit/rate-limit-configs";
+import { getPersonalDataExport } from "@/modules/account/lib/personal-data-export";
+
+export const runtime = "nodejs";
+export const dynamic = "force-dynamic";
+
+/**
+ * `GET /api/internal/account/data-export`: the signed-in user's own personal data as a JSON file.
+ * Internal (session-only, no OpenAPI entry); the profile page's "Download my data" button is the only caller.
+ */
+export const GET = withV3ApiWrapper({
+  auth: "session",
+  customRateLimitConfig: rateLimitConfigs.api.internalAccountDataExport,
+  handler: async ({ authentication, requestId, instance }) => {
+    const userId = authentication && "user" in authentication ? authentication.user?.id : undefined;
+    if (!userId) {
+      return problemUnauthorized(requestId, "Not authenticated", instance);
+    }
+
+    const data = await getPersonalDataExport(userId);
+
+    return new Response(JSON.stringify(data, null, 2), {
+      status: 200,
+      headers: {
+        "Content-Type": "application/json; charset=utf-8",
+        "Content-Disposition": 'attachment; filename="formbricks-personal-data.json"',
+        "Cache-Control": "no-store",
+        "X-Request-Id": requestId,
+      },
+    });
+  },
+});
