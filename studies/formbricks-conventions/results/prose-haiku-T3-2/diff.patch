@@ -0,0 +1,14 @@
+"use client";
+
+import { QueryClient, QueryClientProvider } from "@tanstack/react-query";
+import { type ReactNode, useState } from "react";
+
+/**
+ * There is no app-wide `QueryClientProvider`, so the profile page mounts its own for the personal data
+ * download, which is a TanStack Query mutation. Without it the button throws on render.
+ */
+export const ProfileQueryClientProvider = ({ children }: Readonly<{ children: ReactNode }>) => {
+  const [queryClient] = useState(() => new QueryClient());
+
+  return <QueryClientProvider client={queryClient}>{children}</QueryClientProvider>;
+};
diff --git a/apps/web/app/api/internal/account/data-export/route.ts b/apps/web/app/api/internal/account/data-export/route.ts
