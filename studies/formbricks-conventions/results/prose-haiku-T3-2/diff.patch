diff --git a/apps/web/modules/account/components/download-personal-data-button.tsx b/apps/web/modules/account/components/download-personal-data-button.tsx
new file mode 100644
index 000000000..61c0fc796
--- /dev/null
+++ b/apps/web/modules/account/components/download-personal-data-button.tsx
@@ -0,0 +1,33 @@
+"use client";
+
+import { useMutation } from "@tanstack/react-query";
+import toast from "react-hot-toast";
+import { useTranslation } from "react-i18next";
+import { saveBlobAsFile } from "@/lib/utils/file-download";
+import { fetchPersonalDataExport } from "@/modules/account/lib/personal-data-api-client";
+import { Button } from "@/modules/ui/components/button";
+
+const PERSONAL_DATA_FILE_NAME = "formbricks-personal-data.json";
+
+export const DownloadPersonalDataButton = () => {
+  const { t } = useTranslation();
+
+  const downloadMutation = useMutation({
+    mutationFn: async () => {
+      const blob = await fetchPersonalDataExport();
+      saveBlobAsFile(blob, PERSONAL_DATA_FILE_NAME);
+    },
+    onError: () => {
+      toast.error(t("common.something_went_wrong_please_try_again"));
+    },
+  });
+
+  return (
+    <Button
+      variant="secondary"
+      loading={downloadMutation.isPending}
+      onClick={() => downloadMutation.mutate()}>
+      {t("workspace.settings.profile.download_my_data")}
+    </Button>
+  );
+};
diff --git a/apps/web/modules/account/lib/personal-data-api-client.ts b/apps/web/modules/account/lib/personal-data-api-client.ts
new file mode 100644
index 000000000..3ce385a43
--- /dev/null
+++ b/apps/web/modules/account/lib/personal-data-api-client.ts
@@ -0,0 +1,13 @@
+import { parseV3ApiError } from "@/modules/api/lib/v3-client";
+
+const PERSONAL_DATA_EXPORT_URL = "/api/internal/account/data-export";
+
+/**
+ * The personal data JSON, fetched rather than linked: a failure is problem JSON, which a plain download
+ * link would save as the "file". Throws a `V3ApiError` on a refusal.
+ */
+export async function fetchPersonalDataExport(): Promise<Blob> {
+  const response = await fetch(PERSONAL_DATA_EXPORT_URL, { method: "GET", cache: "no-store" });
+  if (!response.ok) throw await parseV3ApiError(response);
+  return response.blob();
+}
diff --git a/apps/web/modules/account/lib/personal-data-export.ts b/apps/web/modules/account/lib/personal-data-export.ts
