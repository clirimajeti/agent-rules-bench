@@ -0,0 +1,45 @@
+import "server-only";
+import { prisma } from "@formbricks/database";
+import { ResourceNotFoundError } from "@formbricks/types/errors";
+import { TUserNotificationSettings, TUserLocale } from "@formbricks/types/user";
+import { getUser } from "@/lib/user/service";
+
+export type TPersonalDataExport = {
+  name: string;
+  email: string;
+  locale: TUserLocale;
+  notificationSettings: TUserNotificationSettings;
+  organizations: { name: string; role: string }[];
+};
+
+/**
+ * The personal data a user can download as JSON: their name, email, locale, notification settings and
+ * the organizations they belong to with their role in each. Only accepted memberships are included; a
+ * pending invitation is not yet a membership of the user.
+ */
+export const getPersonalDataExport = async (userId: string): Promise<TPersonalDataExport> => {
+  const user = await getUser(userId);
+  if (!user) {
+    throw new ResourceNotFoundError("User", userId);
+  }
+
+  const memberships = await prisma.membership.findMany({
+    where: { userId, accepted: true },
+    select: {
+      role: true,
+      organization: { select: { name: true } },
+    },
+    orderBy: { organization: { name: "asc" } },
+  });
+
+  return {
+    name: user.name,
+    email: user.email,
+    locale: user.locale,
+    notificationSettings: user.notificationSettings,
+    organizations: memberships.map((membership) => ({
+      name: membership.organization.name,
+      role: membership.role,
+    })),
+  };
+};
