diff --git a/apps/web/modules/organization/settings/api-keys/lib/rotate-api-key-client.ts b/apps/web/modules/organization/settings/api-keys/lib/rotate-api-key-client.ts
new file mode 100644
index 000000000..7c571c29f
--- /dev/null
+++ b/apps/web/modules/organization/settings/api-keys/lib/rotate-api-key-client.ts
@@ -0,0 +1,22 @@
+import { parseV3ApiError } from "@/modules/api/lib/v3-client";
+
+/** What `POST /api/v3/api-keys/{apiKeyId}/rotate` answers: the key's settings, unchanged, and the new secret. */
+export type TRotatedApiKey = {
+  id: string;
+  label: string;
+  lastUsedAt: string | null;
+  /** The new secret, returned once. */
+  actualKey: string;
+};
+
+/** Replace an API key's secret. The old one stops working at once; the label and access settings stay. */
+export async function rotateApiKey(apiKeyId: string): Promise<TRotatedApiKey> {
+  const response = await fetch(`/api/v3/api-keys/${encodeURIComponent(apiKeyId)}/rotate`, {
+    method: "POST",
+    cache: "no-store",
+    signal: AbortSignal.timeout(15_000),
+  });
+  if (!response.ok) throw await parseV3ApiError(response);
+  const body = (await response.json()) as { data: TRotatedApiKey };
+  return body.data;
+}
