index 000000000..967919232
--- /dev/null
+++ b/apps/web/app/api/v3/api-keys/lib/operations.ts
@@ -0,0 +1,59 @@
+import "server-only";
+import { getV3SessionUserId } from "@/app/api/v3/lib/auth";
+import { problemUnauthorized, successResponse } from "@/app/api/v3/lib/response";
+import type { TV3AuditLog, TV3Authentication } from "@/app/api/v3/lib/types";
+import { assertCan } from "@/lib/authorization";
+import { capturePostHogEvent } from "@/lib/posthog";
+import { getOrganizationIdFromApiKeyId } from "@/lib/utils/helper";
+import { getApiKeyOrganizationAccess, rotateApiKey } from "@/modules/organization/settings/api-keys/lib/api-key";
+import { assertCanGrantOrganizationAccess } from "@/modules/organization/settings/api-keys/lib/organization-access";
+import { serializeV3RotatedApiKey } from "../serializers";
+
+/**
+ * Replace the secret of an API key and answer with the new one, once.
+ *
+ * Authorized like `updateApiKeyAction` was: `apiKey.manage` on the key, with the organization resolved
+ * from the key itself rather than from client input. An unknown key and a key the caller may not manage
+ * both answer 403 (a thrown `ResourceNotFoundError` / `AuthorizationError` is mapped by the wrapper), so
+ * key ids cannot be probed.
+ *
+ * A key that carries `accessControl.write` is also gated on the organization's user-management floor, as
+ * minting one is (ENG-3075). Without it, a role that may not mint such a key could still rotate one and
+ * walk away with a working secret for it.
+ */
+export async function rotateV3ApiKey(params: {
+  authentication: TV3Authentication;
+  apiKeyId: string;
+  auditLog?: TV3AuditLog;
+  requestId: string;
+  instance?: string;
+}): Promise<Response> {
+  const { authentication, apiKeyId, auditLog, requestId, instance } = params;
+
+  const userId = getV3SessionUserId(authentication);
+  if (!userId) return problemUnauthorized(requestId, "Session required", instance);
+
+  const organizationId = await getOrganizationIdFromApiKeyId(apiKeyId);
+  await assertCan({ type: "user", id: userId }, "apiKey.manage", { type: "apiKey", id: apiKeyId });
+
+  if (auditLog) {
+    auditLog.organizationId = organizationId;
+    auditLog.targetId = apiKeyId;
+  }
+
+  // The access settings are read from the stored key, never from the request: rotating must not change them.
+  await assertCanGrantOrganizationAccess(
+    userId,
+    organizationId,
+    await getApiKeyOrganizationAccess(apiKeyId)
+  );
+
+  const rotated = await rotateApiKey(apiKeyId);
+
+  // The secret is deliberately kept out of the audit log.
+  if (auditLog) auditLog.newObject = { id: rotated.id, label: rotated.label };
+
+  capturePostHogEvent(userId, "api_key_rotated", { api_key_id: apiKeyId }, { organizationId });
+
+  return successResponse(serializeV3RotatedApiKey(rotated), { requestId });
+}
