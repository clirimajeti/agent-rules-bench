new file mode 100644
index 000000000..85afbfed4
--- /dev/null
+++ b/docs/api-v3-reference/src/paths/api_v3_api-keys_{apiKeyId}_rotate.yml
@@ -0,0 +1,96 @@
+post:
+  operationId: rotateApiKeyV3
+  # Session-only by design: an API key cannot mint or rotate keys, so a caller reading the published
+  # reference with one would only ever get a 401. Kept out of the generated docs pages; the operation stays
+  # in the bundle for the contract tests.
+  x-excluded: true
+  summary: Rotate an API key
+  description: |
+    Replaces the secret of the API key `{apiKeyId}`. The key keeps its id, label, organization access and
+    workspace permissions, and its `lastUsedAt` is cleared because the new secret has not been used yet.
+
+    The old secret stops working as soon as the call succeeds.
+
+    The new secret is returned in `actualKey` by this response only. It is stored hashed and cannot be
+    read again.
+
+    The caller needs the permission to manage API keys. An unknown key answers `403`, the same as a key
+    the caller may not manage.
+  tags:
+    - V3 API Keys
+  parameters:
+    - in: path
+      name: apiKeyId
+      required: true
+      schema:
+        type: string
+        format: cuid2
+      description: The API key whose secret is replaced.
+  responses:
+    "200":
+      description: API key rotated successfully
+      content:
+        application/json:
+          schema:
+            type: object
+            required:
+              - data
+            properties:
+              data:
+                type: object
+                required:
+                  - id
+                  - label
+                  - createdAt
+                  - lastUsedAt
+                  - organizationAccess
+                  - workspacePermissions
+                  - actualKey
+                properties:
+                  id:
+                    type: string
+                    format: cuid2
+                  label:
+                    type: string
+                  createdAt:
+                    type: string
+                    format: date-time
+                  lastUsedAt:
+                    type: string
+                    format: date-time
+                    nullable: true
+                    description: Always `null` right after a rotation.
+                  organizationAccess:
+                    type: object
+                    additionalProperties: true
+                    description: The key's organization access settings, unchanged.
+                  workspacePermissions:
+                    type: array
+                    description: The key's workspace permissions, unchanged.
+                    items:
+                      type: object
+                      required:
+                        - workspaceId
+                        - permission
+                      properties:
+                        workspaceId:
+                          type: string
+                        permission:
+                          type: string
+                          enum:
+                            - read
+                            - write
+                            - manage
+                  actualKey:
+                    type: string
+                    description: The new secret, shown once.
+    "401":
+      $ref: ../components/responses/V3UnauthorizedSession.yml
+    "403":
+      $ref: ../components/responses/V3Forbidden.yml
+    "429":
+      $ref: ../components/responses/V3TooManyRequests.yml
+    "500":
+      $ref: ../components/responses/V3InternalServerError.yml
+  security:
+    - sessionAuth: []
