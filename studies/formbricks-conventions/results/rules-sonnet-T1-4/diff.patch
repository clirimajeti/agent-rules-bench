+import type { TOrganizationAccess } from "@formbricks/types/api-key";
+import type { TApiKeyWithEnvironmentPermission } from "@/modules/organization/settings/api-keys/types/api-keys";
+
+export type TV3RotatedApiKey = {
+  id: string;
+  label: string;
+  createdAt: string;
+  lastUsedAt: string | null;
+  organizationAccess: TOrganizationAccess;
+  workspacePermissions: Array<{ workspaceId: string; permission: string }>;
+  /** The new secret. Returned by this response only; it is stored hashed and cannot be read again. */
+  actualKey: string;
+};
+
+export const serializeV3RotatedApiKey = (
+  apiKey: TApiKeyWithEnvironmentPermission & { actualKey: string }
+): TV3RotatedApiKey => ({
+  id: apiKey.id,
+  label: apiKey.label,
+  createdAt: apiKey.createdAt.toISOString(),
+  lastUsedAt: apiKey.lastUsedAt?.toISOString() ?? null,
+  organizationAccess: apiKey.organizationAccess as TOrganizationAccess,
+  workspacePermissions: apiKey.apiKeyWorkspaces.map(({ workspaceId, permission }) => ({
+    workspaceId,
+    permission,
+  })),
+  actualKey: apiKey.actualKey,
+});
