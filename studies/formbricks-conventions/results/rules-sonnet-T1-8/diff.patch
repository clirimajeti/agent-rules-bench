@@ -0,0 +1,55 @@
+import "server-only";
+import { getV3AuthorizationActor } from "@/app/api/v3/lib/auth";
+import { problemForbidden, problemUnauthorized, successResponse } from "@/app/api/v3/lib/response";
+import type { TV3AuditLog, TV3Authentication } from "@/app/api/v3/lib/types";
+import { can } from "@/lib/authorization";
+import { getApiKeyOwnership, rotateApiKey } from "@/modules/organization/settings/api-keys/lib/api-key";
+import { canGrantOrganizationWriteAccess } from "@/modules/organization/settings/api-keys/lib/organization-access";
+import { serializeRotatedApiKey } from "../serializers";
+
+/**
+ * Replace the secret of an API key. Needs the same `apiKey.manage` as delete and edit. A key that carries
+ * `accessControl.write` also needs the caller to clear the organization's user-management floor: rotating
+ * hands the caller a working secret with that authority, which is what minting is gated on (ENG-3075).
+ *
+ * A missing key and one the caller may not manage get the same 403, so the route can't probe key ids. The
+ * audit log never carries the secret.
+ */
+export async function rotateApiKeyOperation({
+  authentication,
+  apiKeyId,
+  requestId,
+  instance,
+  auditLog,
+}: {
+  authentication: TV3Authentication;
+  apiKeyId: string;
+  requestId: string;
+  instance?: string;
+  auditLog?: TV3AuditLog;
+}): Promise<Response> {
+  if (auditLog) auditLog.targetId = apiKeyId;
+
+  const actor = getV3AuthorizationActor(authentication);
+  if (actor?.type !== "user") {
+    return problemUnauthorized(requestId, "Session required", instance);
+  }
+
+  const ownership = await getApiKeyOwnership(apiKeyId);
+  if (!ownership || !(await can(actor, "apiKey.manage", { type: "apiKey", id: apiKeyId }))) {
+    return problemForbidden(requestId, undefined, instance);
+  }
+  if (auditLog) auditLog.organizationId = ownership.organizationId;
+
+  if (
+    ownership.organizationAccess?.accessControl?.write === true &&
+    !(await canGrantOrganizationWriteAccess(actor.id, ownership.organizationId))
+  ) {
+    return problemForbidden(requestId, "User management is not allowed for your role", instance);
+  }
+
+  const rotated = await rotateApiKey(apiKeyId);
+  if (auditLog) auditLog.newObject = { rotated: true };
+
+  return successResponse(serializeRotatedApiKey(rotated), { requestId });
+}
