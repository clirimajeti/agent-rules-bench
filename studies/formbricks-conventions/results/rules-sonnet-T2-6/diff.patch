+import type { Webhook } from "@formbricks/database/prisma";
+
+export type TV3Webhook = {
+  id: string;
+  name: string | null;
+  url: string;
+  source: string;
+  triggers: string[];
+  surveyIds: string[];
+  workspaceId: string;
+  createdAt: string;
+  updatedAt: string;
+};
+
+/** Deliberately leaves out `secret`: a signing secret is shown in the webhook's own detail view only. */
+export const serializeV3Webhook = (webhook: Webhook): TV3Webhook => ({
+  id: webhook.id,
+  name: webhook.name,
+  url: webhook.url,
+  source: webhook.source,
+  triggers: webhook.triggers,
+  surveyIds: webhook.surveyIds,
+  workspaceId: webhook.workspaceId,
+  createdAt: webhook.createdAt.toISOString(),
+  updatedAt: webhook.updatedAt.toISOString(),
+});
