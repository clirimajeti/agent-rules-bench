+post:
+  operationId: duplicateWebhookV3
+  # Session-only, like the tags operations: the settings page is the only caller. Kept out of the
+  # generated docs pages; the operation stays in the bundle for the contract tests.
+  x-excluded: true
+  summary: Duplicate a webhook
+  description: |
+    Creates a copy of the webhook in the same workspace with the same URL, source, triggers and surveys.
+    The copy is named `Copy of <name>` (the URL stands in for an unnamed webhook) and gets its own newly
+    generated signing secret. The response never includes a secret.
+
+    An unknown `webhookId` answers `403`, not `404`, so webhook ids cannot be probed for existence.
+  tags:
+    - V3 Webhooks
+  parameters:
+    - in: path
+      name: webhookId
+      required: true
+      schema:
+        type: string
+        format: cuid2
+      description: The webhook to copy.
+  responses:
+    "201":
+      description: Webhook duplicated successfully
+      content:
+        application/json:
+          schema:
+            type: object
+            required:
+              - data
+            properties:
+              data:
+                type: object
+                required:
+                  - id
+                  - name
+                  - url
+                  - source
+                  - triggers
+                  - surveyIds
+                  - workspaceId
+                  - createdAt
+                  - updatedAt
+                properties:
+                  id:
+                    type: string
+                    format: cuid2
+                  name:
+                    type: string
+                    nullable: true
+                  url:
+                    type: string
+                  source:
+                    type: string
+                  triggers:
+                    type: array
+                    items:
+                      type: string
+                  surveyIds:
+                    type: array
+                    items:
+                      type: string
+                      format: cuid2
+                  workspaceId:
+                    type: string
+                    format: cuid2
+                  createdAt:
+                    type: string
+                    format: date-time
+                  updatedAt:
+                    type: string
+                    format: date-time
+    "400":
+      $ref: ../components/responses/V3BadRequest.yml
+    "401":
+      $ref: ../components/responses/V3UnauthorizedSession.yml
+    "403":
+      $ref: ../components/responses/V3Forbidden.yml
+    "429":
+      $ref: ../components/responses/V3TooManyRequests.yml
+    "500":
+      $ref: ../components/responses/V3InternalServerError.yml
+  security:
+    - sessionAuth: []
