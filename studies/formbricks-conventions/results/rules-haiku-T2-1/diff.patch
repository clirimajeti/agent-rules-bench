diff --git a/apps/web/modules/integrations/webhooks/components/duplicate-webhook-button.tsx b/apps/web/modules/integrations/webhooks/components/duplicate-webhook-button.tsx
new file mode 100644
index 000000000..4be9920ef
--- /dev/null
+++ b/apps/web/modules/integrations/webhooks/components/duplicate-webhook-button.tsx
@@ -0,0 +1,75 @@
+"use client";
+
+import { CopyIcon } from "lucide-react";
+import { useRouter } from "next/navigation";
+import { useState } from "react";
+import toast from "react-hot-toast";
+import { useTranslation } from "react-i18next";
+import { Webhook } from "@formbricks/database/prisma-browser";
+import { getFormattedErrorMessage } from "@/lib/utils/error-message";
+import { WebhookCreatedModal } from "@/modules/integrations/webhooks/components/webhook-created-modal";
+import { Button } from "@/modules/ui/components/button";
+import { createWebhookAction } from "../actions";
+
+interface DuplicateWebhookButtonProps {
+  workspaceId: string;
+  webhook: Webhook;
+}
+
+export const DuplicateWebhookButton = ({ workspaceId, webhook }: Readonly<DuplicateWebhookButtonProps>) => {
+  const { t } = useTranslation();
+  const router = useRouter();
+  const [isDuplicating, setIsDuplicating] = useState(false);
+  const [duplicatedWebhook, setDuplicatedWebhook] = useState<Webhook | null>(null);
+
+  const handleDuplicate = async () => {
+    setIsDuplicating(true);
+    try {
+      // No secret is passed, so the server generates a new signing secret for the copy.
+      const result = await createWebhookAction({
+        workspaceId,
+        webhookInput: {
+          name: t("workspace.integrations.webhooks.copy_of_name", { name: webhook.name || webhook.url }),
+          url: webhook.url,
+          source: "user",
+          triggers: webhook.triggers,
+          surveyIds: webhook.surveyIds,
+        },
+      });
+
+      if (result?.data) {
+        router.refresh();
+        setDuplicatedWebhook(result.data);
+        toast.success(t("workspace.integrations.webhooks.webhook_added_successfully"));
+      } else {
+        toast.error(getFormattedErrorMessage(result));
+      }
+    } catch (e) {
+      toast.error(e instanceof Error ? e.message : t("common.something_went_wrong_please_try_again"));
+    } finally {
+      setIsDuplicating(false);
+    }
+  };
+
+  return (
+    <>
+      <Button
+        type="button"
+        variant="secondary"
+        size="sm"
+        loading={isDuplicating}
+        onClick={handleDuplicate}
+        className="whitespace-nowrap">
+        <CopyIcon className="mr-1 size-4" />
+        {t("common.duplicate")}
+      </Button>
+      {duplicatedWebhook && (
+        <WebhookCreatedModal
+          open
+          webhook={duplicatedWebhook}
+          onClose={() => setDuplicatedWebhook(null)}
+        />
+      )}
+    </>
+  );
+};
