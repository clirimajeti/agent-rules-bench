+"use client";
+
+import { useState } from "react";
+import toast from "react-hot-toast";
+import { useTranslation } from "react-i18next";
+import type { TUserLocale } from "@formbricks/types/user";
+import { formatDateTimeForDisplay } from "@/lib/utils/datetime";
+import { saveBlobAsFile } from "@/modules/ee/data-retention/lib/file-download";
+import { Button } from "@/modules/ui/components/button";
+
+interface AccountActivityProps {
+  createdAt: Date;
+  lastLoginAt: Date | null;
+  locale: TUserLocale;
+}
+
+export const AccountActivity = ({ createdAt, lastLoginAt, locale }: Readonly<AccountActivityProps>) => {
+  const { t } = useTranslation();
+  const [isDownloading, setIsDownloading] = useState(false);
+
+  const handleDownload = async () => {
+    setIsDownloading(true);
+    try {
+      const response = await fetch("/api/account/data-export");
+      if (!response.ok) {
+        throw new Error(`Data export failed with status ${response.status}`);
+      }
+      saveBlobAsFile(await response.blob(), "formbricks-account-data.json");
+    } catch {
+      toast.error(t("workspace.settings.profile.download_my_data_failed"));
+    } finally {
+      setIsDownloading(false);
+    }
+  };
+
+  return (
+    <div className="space-y-6">
+      <dl className="grid grid-cols-1 gap-x-8 gap-y-4 sm:grid-cols-2">
+        <div className="flex flex-col">
+          <dt className="text-xs text-slate-500">{t("workspace.settings.profile.account_created")}</dt>
+          <dd className="text-sm text-slate-800">{formatDateTimeForDisplay(createdAt, locale)}</dd>
+        </div>
+        <div className="flex flex-col">
+          <dt className="text-xs text-slate-500">{t("workspace.settings.profile.last_login")}</dt>
+          <dd className="text-sm text-slate-800">
+            {lastLoginAt
+              ? formatDateTimeForDisplay(lastLoginAt, locale)
+              : t("workspace.settings.profile.never_logged_in")}
+          </dd>
+        </div>
+      </dl>
+
+      <div className="flex flex-col">
+        <p className="text-xs text-slate-600">{t("workspace.settings.profile.download_my_data_description")}</p>
+        <div>
+          <Button className="mt-2" variant="secondary" size="sm" loading={isDownloading} onClick={handleDownload}>
+            {t("workspace.settings.profile.download_my_data")}
+          </Button>
+        </div>
+      </div>
+    </div>
+  );
+};
diff --git a/apps/web/app/api/(internal)/account/data-export/route.ts b/apps/web/app/api/(internal)/account/data-export/route.ts
new file mode 100644
index 000000000..703a6b97d
--- /dev/null
+++ b/apps/web/app/api/(internal)/account/data-export/route.ts
@@ -0,0 +1,46 @@
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { problemNotFound, problemUnauthorized } from "@/app/api/v3/lib/response";
+import { getSessionUserId } from "@/app/api/v3/surveys/lib/operations";
+import { getAccountDataExport } from "@/modules/account/lib/account-data-export";
+import { UNKNOWN_DATA } from "@/modules/ee/audit-logs/types/audit-log";
+
+/**
+ * `GET /api/account/data-export` - the signed-in user's own account data as a JSON file.
+ *
+ * Lives under `(internal)` rather than `/api/v3` because it is a browser download with no OpenAPI entry
+ * and no compatibility promise. Session-only: the cookie is the credential, and the file only ever
+ * describes the user the session belongs to.
+ *
+ * The user has no organization of their own, so the audit entry records `UNKNOWN_DATA` for the
+ * organization, the same way account deletion does.
+ */
+export const GET = withV3ApiWrapper({
+  auth: "session",
+  action: "exported",
+  targetType: "user",
+  handler: async ({ authentication, requestId, instance, auditLog }) => {
+    const userId = getSessionUserId(authentication);
+    if (!userId) {
+      return problemUnauthorized(requestId, undefined, instance);
+    }
+
+    const accountData = await getAccountDataExport(userId);
+    if (!accountData) {
+      return problemNotFound(requestId, "User", userId, instance);
+    }
+
+    if (auditLog) {
+      auditLog.organizationId = UNKNOWN_DATA;
+      auditLog.targetId = userId;
+    }
+
+    return new Response(JSON.stringify(accountData, null, 2), {
+      status: 200,
+      headers: {
+        "Content-Type": "application/json; charset=utf-8",
+        "Content-Disposition": 'attachment; filename="formbricks-account-data.json"',
+        "Cache-Control": "no-store",
+      },
+    });
+  },
+});
