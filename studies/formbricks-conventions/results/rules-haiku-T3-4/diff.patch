diff --git a/apps/web/modules/account/lib/account-data-export.ts b/apps/web/modules/account/lib/account-data-export.ts
new file mode 100644
index 000000000..7fcb0a1a0
--- /dev/null
+++ b/apps/web/modules/account/lib/account-data-export.ts
@@ -0,0 +1,68 @@
+import "server-only";
+import { prisma } from "@formbricks/database";
+import { Prisma } from "@formbricks/database/prisma";
+import { ZId } from "@formbricks/types/common";
+import { DatabaseError } from "@formbricks/types/errors";
+import { TUserLocale, TUserNotificationSettings } from "@formbricks/types/user";
+import { getUser } from "@/lib/user/service";
+import { validateInputs } from "@/lib/utils/validate";
+
+const accountDataMembershipSelect = {
+  role: true,
+  organization: {
+    select: {
+      name: true,
+    },
+  },
+} as const satisfies Prisma.MembershipSelect;
+
+export type TAccountDataExport = {
+  name: string;
+  email: string;
+  locale: TUserLocale;
+  notificationSettings: TUserNotificationSettings;
+  organizationMemberships: {
+    organizationName: string;
+    role: string;
+  }[];
+};
+
+/**
+ * The personal data a user can download about their own account. Only accepted memberships are
+ * included: pending invitations are not yet memberships the user holds.
+ */
+export const getAccountDataExport = async (userId: string): Promise<TAccountDataExport | null> => {
+  validateInputs([userId, ZId]);
+
+  const user = await getUser(userId);
+  if (!user) {
+    return null;
+  }
+
+  try {
+    const memberships = await prisma.membership.findMany({
+      where: {
+        userId,
+        accepted: true,
+      },
+      select: accountDataMembershipSelect,
+    });
+
+    return {
+      name: user.name,
+      email: user.email,
+      locale: user.locale,
+      notificationSettings: user.notificationSettings,
+      organizationMemberships: memberships.map((membership) => ({
+        organizationName: membership.organization.name,
+        role: membership.role,
+      })),
+    };
+  } catch (error) {
+    if (error instanceof Prisma.PrismaClientKnownRequestError) {
+      throw new DatabaseError(error.message);
+    }
+
+    throw error;
+  }
+};
