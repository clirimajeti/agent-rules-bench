@@ -0,0 +1,24 @@
+import type { Webhook } from "@formbricks/database/prisma-browser";
+
+/** A webhook as the v3 API serializes it: dates arrive as ISO strings. */
+type TWebhookResponse = Omit<Webhook, "createdAt" | "updatedAt"> & { createdAt: string; updatedAt: string };
+
+export const duplicateWebhook = async (webhookId: string): Promise<Webhook> => {
+  const response = await fetch(`/api/v3/webhooks/${webhookId}/duplicate`, {
+    method: "POST",
+    cache: "no-store",
+  });
+
+  const body = await response.json().catch(() => null);
+
+  if (!response.ok) {
+    throw new Error(body?.detail ?? body?.title ?? "Unable to duplicate webhook");
+  }
+
+  const webhook = body.data as TWebhookResponse;
+  return {
+    ...webhook,
+    createdAt: new Date(webhook.createdAt),
+    updatedAt: new Date(webhook.updatedAt),
+  };
+};
