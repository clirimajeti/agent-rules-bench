@@ -0,0 +1,22 @@
+/**
+ * POST /api/v3/webhooks/{webhookId}/duplicate - create a copy of a webhook with its own signing secret.
+ * Thin adapter over `duplicateV3Webhook`; the webhooks settings page calls it from the browser.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { duplicateV3Webhook } from "../../lib/operations";
+import { ZV3WebhookIdParams } from "../../lib/schemas";
+
+export const POST = withV3ApiWrapper({
+  auth: "session",
+  action: "created",
+  targetType: "webhook",
+  schemas: { params: ZV3WebhookIdParams },
+  handler: async ({ authentication, parsedInput, auditLog, requestId, instance }) =>
+    duplicateV3Webhook({
+      authentication,
+      webhookId: parsedInput.params.webhookId,
+      auditLog,
+      requestId,
+      instance,
+    }),
+});
diff --git a/apps/web/app/api/v3/webhooks/lib/operations.ts b/apps/web/app/api/v3/webhooks/lib/operations.ts
new file mode 100644
index 000000000..60358cb30
--- /dev/null
+++ b/apps/web/app/api/v3/webhooks/lib/operations.ts
@@ -0,0 +1,65 @@
+import "server-only";
+import { requireSessionWorkspaceAccess } from "@/app/api/v3/lib/auth";
+import { problemForbidden, successResponse } from "@/app/api/v3/lib/response";
+import type { TV3AuditLog, TV3Authentication } from "@/app/api/v3/lib/types";
+import { assertNewlyAttachedSurveysWorkspaceVisible } from "@/lib/survey/visibility/outbound";
+import { getWebhook } from "@/modules/api/v2/management/webhooks/[webhookId]/lib/webhook";
+import { createWebhook } from "@/modules/integrations/webhooks/lib/webhook";
+
+/**
+ * Creates a copy of a webhook: same URL, triggers and surveys, a name prefixed with "Copy of", and a
+ * newly generated signing secret. The copy is always a user-created webhook, whatever the original's
+ * source was, because the caller is the one creating it.
+ *
+ * An unknown webhook answers 403, not 404, so a signed-in user cannot probe webhook ids across workspaces.
+ */
+export async function duplicateV3Webhook(params: {
+  authentication: TV3Authentication;
+  webhookId: string;
+  auditLog?: TV3AuditLog;
+  requestId: string;
+  instance?: string;
+}): Promise<Response> {
+  const { authentication, webhookId, auditLog, requestId, instance } = params;
+
+  const existing = await getWebhook(webhookId);
+  if (!existing.ok) {
+    return problemForbidden(requestId, "You are not authorized to access this resource", instance);
+  }
+  const original = existing.data;
+
+  const access = await requireSessionWorkspaceAccess(
+    authentication,
+    original.workspaceId,
+    "readWrite",
+    requestId,
+    instance
+  );
+  if (access instanceof Response) return access;
+
+  // The copy attaches every survey the original does, so each one must be visible to the workspace.
+  await assertNewlyAttachedSurveysWorkspaceVisible(original.surveyIds);
+
+  if (auditLog) {
+    auditLog.organizationId = access.organizationId;
+    auditLog.targetId = webhookId;
+    auditLog.oldObject = original;
+  }
+
+  // A webhook without a name would otherwise copy to a bare "Copy of", so fall back to its URL,
+  // which is what the list shows for unnamed webhooks.
+  const copy = await createWebhook(access.workspaceId, {
+    name: `Copy of ${original.name || original.url}`,
+    url: original.url,
+    source: "user",
+    triggers: original.triggers,
+    surveyIds: original.surveyIds,
+  });
+
+  if (auditLog) {
+    // The signing secret is returned to the caller once and kept out of the audit trail.
+    auditLog.newObject = { ...copy, secret: null };
+  }
+
+  return successResponse(copy, { requestId });
+}
