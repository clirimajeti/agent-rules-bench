+          allowInternalUrls={DANGEROUSLY_ALLOW_WEBHOOK_INTERNAL_URLS}
+          surveyVisibilityEnabled={surveyVisibilityEnabled}>
+          <WebhookTableHeading />
+        </WebhookTable>
+      </WebhooksQueryClientProvider>
     </PageContentWrapper>
   );
 };
