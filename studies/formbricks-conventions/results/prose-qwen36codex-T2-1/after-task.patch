+const ZDuplicateWebhookAction = z.object({
+  id: ZId,
+  workspaceId: ZId,
+  name: z.string(),
+});
+
+export const duplicateWebhookAction = authenticatedActionClient
+  .inputSchema(ZDuplicateWebhookAction)
+  .action(
+    withAuditLogging("duplicated", "webhook", async ({ ctx, parsedInput }) => {
+      const organizationId = await getOrganizationIdFromWorkspaceId(parsedInput.workspaceId);
+      await assertCan({ type: "user", id: ctx.user.id }, "workspace.write", {
+        type: "workspace",
+        id: parsedInput.workspaceId,
+      });
+      await applyRateLimit(rateLimitConfigs.actions.stateMutation, parsedInput.workspaceId);
+
+      ctx.auditLoggingCtx.organizationId = organizationId;
+      ctx.auditLoggingCtx.webhookId = parsedInput.id;
+
+      const webhookResult = await getWebhook(parsedInput.id);
+      if (!webhookResult.ok) {
+        throw new ResourceNotFoundError("Webhook", parsedInput.id);
+      }
+
+      const originalWebhook = webhookResult.data;
+      const newWebhook = await createWebhook(
+        parsedInput.workspaceId,
+        {
+          name: parsedInput.name,
+          url: originalWebhook.data.url,
+          source: "user",
+          triggers: originalWebhook.data.triggers,
+          surveyIds: originalWebhook.data.surveyIds,
+        },
+        undefined // generate a new secret
+      );
+
+      return newWebhook;
+    })
+  );
+
+
 const ZDeleteWebhookAction = z.object({
