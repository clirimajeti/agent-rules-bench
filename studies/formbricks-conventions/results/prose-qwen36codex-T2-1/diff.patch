diff --git a/apps/web/modules/integrations/webhooks/hooks/use-duplicate-webhook.ts b/apps/web/modules/integrations/webhooks/hooks/use-duplicate-webhook.ts
new file mode 100644
index 000000000..e9cc89425
--- /dev/null
+++ b/apps/web/modules/integrations/webhooks/hooks/use-duplicate-webhook.ts
@@ -0,0 +1,23 @@
+"use client";
+
+import { useMutation, useQueryClient } from "@tanstack/react-query";
+import { duplicateWebhook } from "@/modules/integrations/webhooks/lib/api-client";
+
+/**
+ * Mutation hook for duplicating a webhook via the v3 API.
+ *
+ * Invalidates the workspace's webhook list after a successful mutation so the
+ * server component's data stays in sync without a full page reload.
+ */
+export const useDuplicateWebhook = () => {
+  const queryClient = useQueryClient();
+
+  return useMutation({
+    mutationFn: ({ webhookId, name }: { webhookId: string; name?: string }) =>
+      duplicateWebhook(webhookId, name),
+    onSettled: () => {
+      // Invalidate all webhook-related queries so the next render picks up the new row.
+      queryClient.invalidateQueries({ queryKey: ["webhooks"] });
+    },
+  });
+};
diff --git a/apps/web/modules/integrations/webhooks/lib/api-client.ts b/apps/web/modules/integrations/webhooks/lib/api-client.ts
new file mode 100644
index 000000000..06e811f35
--- /dev/null
+++ b/apps/web/modules/integrations/webhooks/lib/api-client.ts
@@ -0,0 +1,34 @@
+import { parseV3ApiError } from "@/modules/api/lib/v3-client";
+import { ZWebhookWithoutSecret } from "@formbricks/database/zod/webhooks";
+import type { z } from "zod";
+
+export type TWebhookResource = z.infer<typeof ZWebhookWithoutSecret>;
+
+const MUTATION_TIMEOUT_MS = 15_000;
+
+/**
+ * Duplicate an existing webhook, creating a new one with the same configuration.
+ *
+ * @param webhookId - ID of the webhook to duplicate
+ * @param name - Optional custom name for the duplicate; defaults to "<original name> (Copy)"
+ * @returns The newly created webhook resource
+ */
+export async function duplicateWebhook(
+  webhookId: string,
+  name?: string
+): Promise<TWebhookResource> {
+  const response = await fetch(`/api/v3/webhooks/${encodeURIComponent(webhookId)}/duplicate`, {
+    method: "POST",
+    cache: "no-store",
+    headers: { "Content-Type": "application/json" },
+    body: JSON.stringify(name ? { name } : {}),
+    signal: AbortSignal.timeout(MUTATION_TIMEOUT_MS),
+  });
+
+  if (!response.ok) {
+    throw await parseV3ApiError(response);
+  }
+
+  const body = (await response.json()) as { data: TWebhookResource };
+  return body.data;
+}
