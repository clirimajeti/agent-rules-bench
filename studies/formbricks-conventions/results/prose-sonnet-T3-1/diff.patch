@@ -0,0 +1,63 @@
+import "server-only";
+import { prisma } from "@formbricks/database";
+import { getV3SessionUserId } from "@/app/api/v3/lib/auth";
+import { problemInternalError, problemUnauthorized, successResponse } from "@/app/api/v3/lib/response";
+import type { TV3Authentication } from "@/app/api/v3/lib/types";
+
+export type TV3AccountDataExport = {
+  name: string;
+  email: string;
+  locale: string;
+  notificationSettings: unknown;
+  organizationMemberships: { organizationName: string; role: string }[];
+};
+
+/**
+ * The signed-in user's own data, and nothing else: the user id comes from the session, never from the
+ * request, so there is no identifier a caller could swap for someone else's. Secrets on the user row
+ * (password hash, 2FA secret, backup codes) are not selected.
+ */
+export async function getV3AccountDataExport(params: {
+  authentication: TV3Authentication;
+  requestId: string;
+  instance?: string;
+}): Promise<Response> {
+  const { authentication, requestId, instance } = params;
+
+  const userId = getV3SessionUserId(authentication);
+  if (!userId) {
+    return problemUnauthorized(requestId, "Session required", instance);
+  }
+
+  const user = await prisma.user.findUnique({
+    where: { id: userId },
+    select: {
+      name: true,
+      email: true,
+      locale: true,
+      notificationSettings: true,
+      memberships: {
+        where: { accepted: true },
+        select: { role: true, organization: { select: { name: true } } },
+        orderBy: { organization: { name: "asc" } },
+      },
+    },
+  });
+
+  if (!user) {
+    return problemInternalError(requestId, "Unable to load account data", instance);
+  }
+
+  const data: TV3AccountDataExport = {
+    name: user.name,
+    email: user.email,
+    locale: user.locale,
+    notificationSettings: user.notificationSettings,
+    organizationMemberships: user.memberships.map((membership) => ({
+      organizationName: membership.organization.name,
+      role: membership.role,
+    })),
+  };
+
+  return successResponse(data, { requestId });
+}
diff --git a/apps/web/app/api/v3/account/data-export/route.ts b/apps/web/app/api/v3/account/data-export/route.ts
