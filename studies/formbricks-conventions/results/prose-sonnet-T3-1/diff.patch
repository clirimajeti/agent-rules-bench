+"use client";
+
+import { QueryClient, QueryClientProvider, useMutation } from "@tanstack/react-query";
+import { DownloadIcon } from "lucide-react";
+import { useState } from "react";
+import toast from "react-hot-toast";
+import { useTranslation } from "react-i18next";
+import {
+  fetchAccountDataExport,
+  saveJsonFile,
+} from "@/app/(app)/workspaces/[workspaceId]/settings/account/profile/lib/data-export-client";
+import { getV3ApiErrorMessage } from "@/modules/api/lib/v3-client";
+import { Button } from "@/modules/ui/components/button";
+
+const DownloadMyDataButton = () => {
+  const { t } = useTranslation();
+
+  const exportMutation = useMutation({
+    mutationFn: fetchAccountDataExport,
+    onSuccess: (data) => saveJsonFile(data, "formbricks-account-data.json"),
+    onError: (error) =>
+      toast.error(getV3ApiErrorMessage(error, t("workspace.settings.profile.download_my_data_failed"))),
+  });
+
+  return (
+    <Button
+      variant="secondary"
+      size="sm"
+      loading={exportMutation.isPending}
+      onClick={() => exportMutation.mutate()}>
+      <DownloadIcon />
+      {t("workspace.settings.profile.download_my_data")}
+    </Button>
+  );
+};
+
+export const DownloadMyData = () => {
+  const [queryClient] = useState(() => new QueryClient());
+
+  return (
+    <QueryClientProvider client={queryClient}>
+      <DownloadMyDataButton />
+    </QueryClientProvider>
+  );
+};
diff --git a/apps/web/app/(app)/workspaces/[workspaceId]/settings/account/profile/lib/data-export-client.ts b/apps/web/app/(app)/workspaces/[workspaceId]/settings/account/profile/lib/data-export-client.ts
