@@ -0,0 +1,15 @@
+/**
+ * GET /api/v3/account/data-export - the signed-in user's name, email, locale, notification settings and
+ * organization memberships.
+ *
+ * Session-only, deliberately: it exports the personal data of the person behind the session, so an API
+ * key (which has no user) has no business here.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { getV3AccountDataExport } from "./lib/operations";
+
+export const GET = withV3ApiWrapper({
+  auth: "session",
+  handler: async ({ authentication, requestId, instance }) =>
+    getV3AccountDataExport({ authentication, requestId, instance }),
+});
