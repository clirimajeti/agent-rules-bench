@@ -0,0 +1,21 @@
+import type { TV3AccountDataExport } from "@/app/api/v3/account/data-export/lib/operations";
+import { parseV3ApiError } from "@/modules/api/lib/v3-client";
+
+export async function fetchAccountDataExport(): Promise<TV3AccountDataExport> {
+  const response = await fetch("/api/v3/account/data-export", { cache: "no-store" });
+  if (!response.ok) {
+    throw await parseV3ApiError(response);
+  }
+  return ((await response.json()) as { data: TV3AccountDataExport }).data;
+}
+
+export function saveJsonFile(data: unknown, fileName: string): void {
+  const url = URL.createObjectURL(new Blob([JSON.stringify(data, null, 2)], { type: "application/json" }));
+  const link = document.createElement("a");
+  link.href = url;
+  link.download = fileName;
+  document.body.appendChild(link);
+  link.click();
+  link.remove();
+  URL.revokeObjectURL(url);
+}
