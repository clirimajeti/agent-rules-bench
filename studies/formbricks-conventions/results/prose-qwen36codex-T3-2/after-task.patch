@@ -0,0 +1,65 @@
+/**
+ * GET /api/account/download
+ *
+ * Downloads the authenticated user's personal data as a JSON file.
+ * Includes: name, email, locale, notification settings, and organization memberships
+ * (organization name and role).
+ */
+import "server-only";
+import { NextResponse } from "next/server";
+import { getSession } from "@/modules/auth/lib/session";
+import { getUser } from "@/lib/user/service";
+import { getOrganizationsByUserId } from "@/lib/organization/service";
+import { TMembership } from "@formbricks/types/memberships";
+
+export async function GET() {
+  const session = await getSession();
+  if (!session?.user) {
+    return NextResponse.json({ error: "Not authenticated" }, { status: 401 });
+  }
+
+  const user = await getUser(session.user.id);
+  if (!user) {
+    return NextResponse.json({ error: "User not found" }, { status: 404 });
+  }
+
+  const organizations = await getOrganizationsByUserId(session.user.id);
+
+  // Get actual membership roles
+  const membershipsWithRole = await getMembershipsWithRoles(session.user.id);
+
+  const data = {
+    name: user.name,
+    email: user.email,
+    locale: user.locale,
+    notificationSettings: user.notificationSettings,
+    organizationMemberships: membershipsWithRole,
+  };
+
+  const json = JSON.stringify(data, null, 2);
+  const filename = `formbricks-data-${new Date().toISOString().split("T")[0]}.json`;
+
+  return new NextResponse(json, {
+    status: 200,
+    headers: {
+      "Content-Type": "application/json",
+      "Content-Disposition": `attachment; filename="${filename}"`,
+    },
+  });
+}
+
+async function getMembershipsWithRoles(userId: string): Promise<Array<{ organizationName: string; role: string }>> {
+  const { prisma } = await import("@formbricks/database");
+  const memberships = await prisma.membership.findMany({
+    where: { userId },
+    select: {
+      organization: { select: { name: true } },
+      role: true,
+    },
+  });
+
+  return memberships.map((m) => ({
+    organizationName: m.organization.name,
+    role: m.role,
+  }));
+}
