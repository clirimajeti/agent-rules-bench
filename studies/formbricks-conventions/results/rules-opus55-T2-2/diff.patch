+import type { PipelineTriggers, Webhook, WebhookSource } from "@formbricks/database/prisma";
+
+/**
+ * The v3 webhook resource. The signing secret is never part of it: it is shown once in the app and read
+ * back only through the webhook settings, so an API response can never leak it into a client's logs.
+ */
+export type TV3Webhook = {
+  id: string;
+  name: string | null;
+  url: string;
+  source: WebhookSource;
+  triggers: PipelineTriggers[];
+  /** Empty means every current and future survey in the workspace. */
+  surveyIds: string[];
+  workspaceId: string;
+  createdAt: string;
+  updatedAt: string;
+};
+
+export const serializeV3Webhook = (webhook: Omit<Webhook, "secret">): TV3Webhook => ({
+  id: webhook.id,
+  name: webhook.name,
+  url: webhook.url,
+  source: webhook.source,
+  triggers: webhook.triggers,
+  surveyIds: webhook.surveyIds,
+  workspaceId: webhook.workspaceId,
+  createdAt: webhook.createdAt.toISOString(),
+  updatedAt: webhook.updatedAt.toISOString(),
+});
