+post:
+  operationId: duplicateWebhookV3
+  summary: Duplicate a webhook
+  description: >-
+    Creates a new webhook in the same workspace with the same `url`, `triggers` and `surveyIds`, named
+    "Copy of <name>" (or "Copy of <url>" when the webhook has no name). The copy gets its own signing
+    secret, so a receiver that verifies signatures needs the new one; it is not returned here. The copy's
+    `source` is always `user`. Write access to the webhook's workspace; an unknown or inaccessible
+    `webhookId` answers **403**.
+
+
+    The copy is held to the rules for a new webhook: a `url` the current URL policy rejects, or a survey
+    that is no longer visible to the whole workspace, answers **422** and creates nothing.
+  tags:
+    - V3 Webhooks
+  parameters:
+    - $ref: ../components/parameters/WebhookIdPath.yml
+  responses:
+    "201":
+      description: Copy created
+      headers:
+        X-Request-Id:
+          schema:
+            type: string
+          description: Request correlation ID
+        Cache-Control:
+          schema:
+            type: string
+          example: private, no-store
+      content:
+        application/json:
+          schema:
+            type: object
+            required:
+              - data
+            properties:
+              data:
+                $ref: ../components/schemas/WebhookResource.yml
+    "400":
+      $ref: ../components/responses/V3BadRequest.yml
+    "401":
+      $ref: ../components/responses/V3Unauthorized.yml
+    "403":
+      $ref: ../components/responses/V3Forbidden.yml
+    "422":
+      $ref: ../components/responses/V3UnprocessableContent.yml
+    "429":
+      $ref: ../components/responses/V3TooManyRequests.yml
+    "500":
+      $ref: ../components/responses/V3InternalServerError.yml
+  security:
+    - sessionAuth: []
+    - apiKeyAuth: []
+    - bearerAuth: []
