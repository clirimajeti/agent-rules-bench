+/**
+ * The name a duplicate gets. It is stored data that the v3 contract documents and API clients read, so it
+ * stays the same in every locale. An unnamed webhook is shown by its URL in the list, so its copy takes the
+ * URL as the name it was known by.
+ */
+export const getWebhookCopyName = (source: Pick<Webhook, "name" | "url">): string =>
+  `Copy of ${source.name?.trim() || source.url}`;
+
+/**
+ * Create a new webhook in the source's workspace with the same URL, triggers and surveys. The copy gets its
+ * own signing secret, so a receiver that verifies signatures must be given the new one. It is always
+ * `source: "user"`: a third-party integration only tracks the webhooks it created itself, so a copy marked
+ * as theirs would be orphaned.
+ *
+ * Callers must authorize the source's workspace and check its surveys are still workspace-visible first.
+ */
+export const duplicateWebhook = async (
+  source: Pick<Webhook, "name" | "url" | "triggers" | "surveyIds" | "workspaceId">
+): Promise<Webhook> =>
+  createWebhook(source.workspaceId, {
+    name: getWebhookCopyName(source),
+    url: source.url,
+    source: "user",
+    triggers: source.triggers,
+    surveyIds: source.surveyIds,
+  });
+
