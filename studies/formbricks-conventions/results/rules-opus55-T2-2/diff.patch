+type: object
+description: >-
+  A webhook that sends a workspace's response events to an endpoint. The signing secret is never part of
+  this resource; read it in the webhook settings in the app.
+required:
+  - id
+  - name
+  - url
+  - source
+  - triggers
+  - surveyIds
+  - workspaceId
+  - createdAt
+  - updatedAt
+properties:
+  id:
+    type: string
+    format: cuid2
+  name:
+    type:
+      - string
+      - "null"
+  url:
+    type: string
+    description: The endpoint that receives the signed event payloads.
+  source:
+    type: string
+    enum:
+      - user
+      - zapier
+      - make
+      - n8n
+      - activepieces
+    description: What created the webhook. `user` when it was created in the app or through this API.
+  triggers:
+    type: array
+    items:
+      type: string
+      enum:
+        - responseCreated
+        - responseUpdated
+        - responseFinished
+  surveyIds:
+    type: array
+    items:
+      type: string
+    description: The surveys whose responses are sent. Empty means every current and future survey in the workspace.
+  workspaceId:
+    type: string
+    format: cuid2
+  createdAt:
+    type: string
+    format: date-time
+  updatedAt:
+    type: string
+    format: date-time
+additionalProperties: false
