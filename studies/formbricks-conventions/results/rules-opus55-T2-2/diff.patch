+import { beforeEach, describe, expect, test, vi } from "vitest";
+import { InvalidInputError } from "@formbricks/types/errors";
+import { requireV3WorkspaceAccess } from "@/app/api/v3/lib/auth";
+import type { TV3AuditLog } from "@/app/api/v3/lib/types";
+import { findNewlyAttachedNotWorkspaceVisibleSurveyIds } from "@/lib/survey/visibility/outbound";
+import { getWebhook } from "@/modules/api/v2/management/webhooks/[webhookId]/lib/webhook";
+import { duplicateWebhook } from "@/modules/integrations/webhooks/lib/webhook";
+import { duplicateV3Webhook } from "./operations";
+
+vi.mock("server-only", () => ({}));
+
+vi.mock("@/app/api/v3/lib/auth", () => ({ requireV3WorkspaceAccess: vi.fn() }));
+vi.mock("@/lib/survey/visibility/outbound", () => ({
+  SURVEY_NOT_WORKSPACE_VISIBLE_MESSAGE: "not workspace visible",
+  findNewlyAttachedNotWorkspaceVisibleSurveyIds: vi.fn(),
+}));
+vi.mock("@/modules/api/v2/management/webhooks/[webhookId]/lib/webhook", () => ({ getWebhook: vi.fn() }));
+vi.mock("@/modules/integrations/webhooks/lib/webhook", () => ({ duplicateWebhook: vi.fn() }));
+vi.mock("@formbricks/logger", () => ({
+  logger: { withContext: vi.fn(() => ({ error: vi.fn(), warn: vi.fn() })) },
+}));
+
+const workspaceId = "clxx1234567890123456789012";
+const organizationId = "clzz1234567890123456789012";
+const webhookId = "clww1234567890123456789012";
+const copyId = "clcc1234567890123456789012";
+
+const source = {
+  id: webhookId,
+  name: "Slack alerts",
+  url: "https://example.com/hook",
+  source: "zapier" as const,
+  triggers: ["responseFinished" as const],
+  surveyIds: ["clss1234567890123456789012"],
+  workspaceId,
+  createdAt: new Date("2026-04-21T10:00:00.000Z"),
+  updatedAt: new Date("2026-04-21T10:00:00.000Z"),
+};
+
+const copy = {
+  ...source,
+  id: copyId,
+  name: "Copy of Slack alerts",
+  source: "user" as const,
+  secret: "new-secret",
+  createdAt: new Date("2026-11-17T09:00:00.000Z"),
+  updatedAt: new Date("2026-11-17T09:00:00.000Z"),
+};
+
+const base = { authentication: null, requestId: "req_1", instance: "/api/v3/webhooks" };
+
+const grantAccess = () =>
+  vi
+    .mocked(requireV3WorkspaceAccess)
+    .mockResolvedValue({ workspaceId, organizationId } as Awaited<
+      ReturnType<typeof requireV3WorkspaceAccess>
+    >);
+
+beforeEach(() => {
+  vi.resetAllMocks();
+  vi.mocked(getWebhook).mockResolvedValue({ ok: true, data: source });
+  vi.mocked(findNewlyAttachedNotWorkspaceVisibleSurveyIds).mockResolvedValue([]);
+  vi.mocked(duplicateWebhook).mockResolvedValue(copy);
+});
+
+describe("duplicateV3Webhook", () => {
+  test("creates the copy in the webhook's own workspace and never returns its secret", async () => {
+    grantAccess();
+    const auditLog = {} as TV3AuditLog;
+
+    const response = await duplicateV3Webhook({ ...base, webhookId, auditLog });
+    const body = await response.json();
+
+    expect(response.status).toBe(201);
+    expect(requireV3WorkspaceAccess).toHaveBeenCalledWith(null, workspaceId, "readWrite", "req_1", base.instance);
+    expect(duplicateWebhook).toHaveBeenCalledWith(source);
+    expect(body.data).toEqual({
+      id: copyId,
+      name: "Copy of Slack alerts",
+      url: "https://example.com/hook",
+      source: "user",
+      triggers: ["responseFinished"],
+      surveyIds: ["clss1234567890123456789012"],
+      workspaceId,
+      createdAt: "2026-11-17T09:00:00.000Z",
+      updatedAt: "2026-11-17T09:00:00.000Z",
+    });
+    expect(auditLog).toMatchObject({ organizationId, targetId: copyId });
+  });
+
+  test("answers an unknown webhook with the same 403 as an inaccessible one", async () => {
+    vi.mocked(getWebhook).mockResolvedValue({
+      ok: false,
+      error: { type: "not_found", details: [{ field: "webhook", issue: "not found" }] },
+    });
+
+    const response = await duplicateV3Webhook({ ...base, webhookId });
+
+    expect(response.status).toBe(403);
+    expect(requireV3WorkspaceAccess).not.toHaveBeenCalled();
+    expect(duplicateWebhook).not.toHaveBeenCalled();
+  });
+
+  test("propagates the authorization failure instead of copying", async () => {
+    vi.mocked(requireV3WorkspaceAccess).mockResolvedValue(new Response(null, { status: 403 }));
+
+    const response = await duplicateV3Webhook({ ...base, webhookId });
+
+    expect(response.status).toBe(403);
+    expect(duplicateWebhook).not.toHaveBeenCalled();
+  });
+
+  test("refuses a copy that would attach a survey no longer visible to the whole workspace", async () => {
+    grantAccess();
+    vi.mocked(findNewlyAttachedNotWorkspaceVisibleSurveyIds).mockResolvedValue(["clss1234567890123456789012"]);
+
+    const response = await duplicateV3Webhook({ ...base, webhookId });
+
+    expect(response.status).toBe(422);
+    expect(findNewlyAttachedNotWorkspaceVisibleSurveyIds).toHaveBeenCalledWith(source.surveyIds, []);
+    expect(duplicateWebhook).not.toHaveBeenCalled();
+  });
+
+  test("reports a URL the current policy rejects as 422, not a server fault", async () => {
+    grantAccess();
+    vi.mocked(duplicateWebhook).mockRejectedValue(new InvalidInputError("URL not allowed"));
+
+    const response = await duplicateV3Webhook({ ...base, webhookId });
+    const body = await response.json();
+
+    expect(response.status).toBe(422);
+    expect(body.invalid_params).toEqual([{ name: "url", reason: "URL not allowed" }]);
+  });
+});
