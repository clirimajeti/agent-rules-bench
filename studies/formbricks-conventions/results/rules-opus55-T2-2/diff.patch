index 000000000..e0dc67a5a
--- /dev/null
+++ b/apps/web/app/api/v3/webhooks/lib/operations.ts
@@ -0,0 +1,92 @@
+import "server-only";
+import { logger } from "@formbricks/logger";
+import { InvalidInputError } from "@formbricks/types/errors";
+import { requireV3WorkspaceAccess } from "@/app/api/v3/lib/auth";
+import { mapV3ThrownError } from "@/app/api/v3/lib/errors";
+import {
+  problemForbidden,
+  problemInternalError,
+  problemUnprocessableContent,
+  successResponse,
+} from "@/app/api/v3/lib/response";
+import type { TV3AuditLog, TV3Authentication } from "@/app/api/v3/lib/types";
+import {
+  SURVEY_NOT_WORKSPACE_VISIBLE_MESSAGE,
+  findNewlyAttachedNotWorkspaceVisibleSurveyIds,
+} from "@/lib/survey/visibility/outbound";
+import { getWebhook } from "@/modules/api/v2/management/webhooks/[webhookId]/lib/webhook";
+import { duplicateWebhook } from "@/modules/integrations/webhooks/lib/webhook";
+import { serializeV3Webhook } from "./serializers";
+
+type TDuplicateV3WebhookParams = {
+  webhookId: string;
+  authentication: TV3Authentication;
+  auditLog?: TV3AuditLog;
+  requestId: string;
+  instance: string;
+};
+
+/**
+ * Copy a webhook into a new one in the same workspace: same URL, triggers and surveys, a new signing
+ * secret, named "Copy of <name>".
+ *
+ * The workspace is resolved from the webhook itself rather than taken from the caller, so a caller cannot
+ * pair someone else's webhook id with a workspace they can write to. An unknown webhook answers 403, not
+ * 404, so webhook ids cannot be probed across the instance. Authorization matches creating a webhook in the
+ * app: write access to the workspace.
+ */
+export async function duplicateV3Webhook(params: TDuplicateV3WebhookParams): Promise<Response> {
+  const { webhookId, authentication, auditLog, requestId, instance } = params;
+  const log = logger.withContext({ requestId, webhookId });
+
+  try {
+    const sourceResult = await getWebhook(webhookId);
+    if (!sourceResult.ok) {
+      if (sourceResult.error.type === "not_found") {
+        return problemForbidden(requestId, "You are not authorized to access this resource", instance);
+      }
+      log.error({ statusCode: 500, details: sourceResult.error.details }, "V3 webhook lookup failed");
+      return problemInternalError(requestId, undefined, instance);
+    }
+    const source = sourceResult.data;
+
+    const access = await requireV3WorkspaceAccess(
+      authentication,
+      source.workspaceId,
+      "readWrite",
+      requestId,
+      instance
+    );
+    if (access instanceof Response) return access;
+
+    // Every survey on the copy is newly attached, so the copy is held to the same rule as a new webhook:
+    // a survey restricted since the source was set up cannot be sent to a new outbound connection.
+    const blockedSurveyIds = await findNewlyAttachedNotWorkspaceVisibleSurveyIds(source.surveyIds, []);
+    if (blockedSurveyIds.length > 0) {
+      return problemUnprocessableContent(requestId, SURVEY_NOT_WORKSPACE_VISIBLE_MESSAGE, {
+        instance,
+        invalid_params: [{ name: "surveyIds", reason: SURVEY_NOT_WORKSPACE_VISIBLE_MESSAGE }],
+      });
+    }
+
+    const copy = await duplicateWebhook(source);
+    const resource = serializeV3Webhook(copy);
+
+    if (auditLog) {
+      auditLog.organizationId = access.organizationId;
+      auditLog.targetId = copy.id;
+      auditLog.newObject = resource;
+    }
+
+    return successResponse(resource, { requestId, status: 201 });
+  } catch (error) {
+    // The URL is re-validated on copy, and the URL policy may have tightened since the source was saved.
+    if (error instanceof InvalidInputError) {
+      return problemUnprocessableContent(requestId, error.message, {
+        instance,
+        invalid_params: [{ name: "url", reason: error.message }],
+      });
+    }
+    return mapV3ThrownError(error, { log, requestId, instance, operation: "webhooks.duplicate" });
+  }
+}
