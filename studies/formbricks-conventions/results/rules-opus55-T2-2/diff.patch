+
+export const DuplicateWebhookButton = ({ webhookId }: Readonly<{ webhookId: string }>) => {
+  const { t } = useTranslation();
+  const duplicateWebhook = useDuplicateWebhook();
+
+  const handleDuplicate = async () => {
+    try {
+      await duplicateWebhook.mutateAsync({ webhookId });
