+/**
+ * DELETE /api/v3/tags/unused - delete every tag of a workspace that no response carries.
+ *
+ * Session-only, like the other tag routes. Answers the number of tags deleted.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { deleteV3UnusedTags } from "../lib/operations";
+import { ZV3DeleteUnusedTagsQuery } from "../lib/schemas";
+
+export const DELETE = withV3ApiWrapper({
+  auth: "session",
+  action: "deleted",
+  targetType: "tag",
+  schemas: { query: ZV3DeleteUnusedTagsQuery },
+  handler: async ({ authentication, parsedInput, auditLog, requestId, instance }) =>
+    deleteV3UnusedTags({
+      authentication,
+      workspaceId: parsedInput.query.workspaceId,
+      auditLog,
+      requestId,
+      instance,
+    }),
+});
