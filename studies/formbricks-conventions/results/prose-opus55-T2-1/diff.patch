+"use client";
+
+import { CopyIcon } from "lucide-react";
+import { toast } from "react-hot-toast";
+import { useTranslation } from "react-i18next";
+import { useDuplicateWebhook } from "@/modules/integrations/webhooks/hooks/use-duplicate-webhook";
+import { Button } from "@/modules/ui/components/button";
+
+/**
+ * Copies a webhook: same URL, triggers and surveys, named "Copy of <name>", with its own new secret. Rendered
+ * beside the row's clickable area rather than inside it, since a button cannot be nested in a button.
+ */
+export const DuplicateWebhookButton = ({ webhookId }: Readonly<{ webhookId: string }>) => {
+  const { t } = useTranslation();
+  const duplicateWebhook = useDuplicateWebhook();
+
+  const handleClick = () => {
+    duplicateWebhook.mutate(
+      { webhookId },
+      {
+        onSuccess: () => {
+          toast.success(t("workspace.integrations.webhooks.webhook_duplicated_successfully"));
+        },
+        // The v3 route answers with a problem detail written for people, e.g. a URL that no longer passes
+        // validation, so its message is shown as is.
+        onError: (error) => {
+          toast.error(error.message);
+        },
+      }
+    );
+  };
+
+  return (
+    <Button type="button" variant="ghost" size="sm" loading={duplicateWebhook.isPending} onClick={handleClick}>
+      <CopyIcon />
+      {t("common.duplicate")}
+    </Button>
+  );
+};
