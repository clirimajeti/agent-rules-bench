@@ -0,0 +1,63 @@
+post:
+  operationId: duplicateWebhookV3
+  # Session-only by design: it backs the Duplicate button on the workspace webhooks settings page, so an
+  # API-key caller reading the published reference would only ever get a 401. Excluded from the generated
+  # docs pages like the `/tags` operations; the operation stays in the bundle for the contract tests.
+  x-excluded: true
+  summary: Duplicate a webhook
+  description: |
+    Creates a new webhook with the same URL, triggers and surveys as `{webhookId}`, named
+    "Copy of <name>" (or "Copy of <url>" when the original has no name). The copy gets its own new
+    signing secret, which is not returned.
+
+    The workspace is resolved from the webhook itself. Requires organization owner/manager, or a
+    workspace team membership with read-write permission. An unknown `webhookId` answers `403`, not
+    `404`, so webhook ids cannot be probed for existence. A copy attaches its surveys anew, so it answers
+    `403` when one of them is no longer visible to the whole workspace.
+
+    The URL is validated again, as on any create; a URL that no longer passes answers `422`.
+  tags:
+    - V3 Webhooks
+  parameters:
+    - in: path
+      name: webhookId
+      required: true
+      schema:
+        type: string
+        format: cuid2
+      description: The webhook to copy.
+  responses:
+    "201":
+      description: Copy created
+      headers:
+        X-Request-Id:
+          schema:
+            type: string
+          description: Request correlation ID
+        Cache-Control:
+          schema:
+            type: string
+          example: private, no-store
+      content:
+        application/json:
+          schema:
+            type: object
+            required:
+              - data
+            properties:
+              data:
+                $ref: ../components/schemas/WebhookResource.yml
+    "400":
+      $ref: ../components/responses/V3BadRequest.yml
+    "401":
+      $ref: ../components/responses/V3UnauthorizedSession.yml
+    "403":
+      $ref: ../components/responses/V3Forbidden.yml
+    "422":
+      $ref: ../components/responses/V3UnprocessableContent.yml
+    "429":
+      $ref: ../components/responses/V3TooManyRequests.yml
+    "500":
+      $ref: ../components/responses/V3InternalServerError.yml
+  security:
+    - sessionAuth: []
