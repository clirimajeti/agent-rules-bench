+/**
+ * POST /api/v3/webhooks/{webhookId}/duplicate — copy a webhook: same URL, triggers and surveys, named
+ * "Copy of <name>", with its own new signing secret. Session-only, like the other settings-page routes.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { ZV3EmptyQuery } from "@/app/api/v3/lib/schemas";
+import { duplicateV3Webhook } from "../../lib/operations";
+import { ZV3WebhookIdParams } from "../../lib/schemas";
+
+export const POST = withV3ApiWrapper({
+  auth: "session",
+  action: "created",
+  targetType: "webhook",
+  schemas: { params: ZV3WebhookIdParams, query: ZV3EmptyQuery },
+  handler: async ({ authentication, parsedInput, auditLog, requestId, instance }) =>
+    duplicateV3Webhook({
+      authentication,
+      webhookId: parsedInput.params.webhookId,
+      auditLog,
+      requestId,
+      instance,
+    }),
+});
diff --git a/apps/web/app/api/v3/webhooks/lib/operations.ts b/apps/web/app/api/v3/webhooks/lib/operations.ts
new file mode 100644
index 000000000..7c4edd70a
--- /dev/null
+++ b/apps/web/app/api/v3/webhooks/lib/operations.ts
@@ -0,0 +1,118 @@
+import "server-only";
+import { prisma } from "@formbricks/database";
+import { logger } from "@formbricks/logger";
+import { InvalidInputError } from "@formbricks/types/errors";
+import { getSessionUserId } from "@/app/api/v3/charts/lib/access";
+import { requireV3WorkspaceAccess } from "@/app/api/v3/lib/auth";
+import { mapV3ThrownError } from "@/app/api/v3/lib/errors";
+import { problemForbidden, problemUnprocessableContent, successResponse } from "@/app/api/v3/lib/response";
+import type { TV3AuditLog, TV3Authentication } from "@/app/api/v3/lib/types";
+import { capturePostHogEvent } from "@/lib/posthog";
+import {
+  SURVEY_NOT_WORKSPACE_VISIBLE_MESSAGE,
+  findNotWorkspaceVisibleSurveyIds,
+} from "@/lib/survey/visibility/outbound";
+import { createWebhook } from "@/modules/integrations/webhooks/lib/webhook";
+import { isDiscordWebhook } from "@/modules/integrations/webhooks/lib/utils";
+import { serializeV3Webhook } from "../serializers";
+
+type TBaseParams = {
+  authentication: TV3Authentication;
+  requestId: string;
+  instance?: string;
+};
+
+/** The name a duplicate gets. A webhook without a name is labelled by its URL in the app, so the copy is too. */
+export const getWebhookCopyName = (webhook: { name: string | null; url: string }): string =>
+  `Copy of ${webhook.name?.trim() || webhook.url}`;
+
+/**
+ * `POST /api/v3/webhooks/{webhookId}/duplicate` → 201 with the copy. The copy keeps the original's URL,
+ * triggers and surveys, is named "Copy of <name>", and gets its own new signing secret, so the two
+ * webhooks never share one.
+ *
+ * The workspace is resolved from the webhook itself, never from the client, and an unknown webhook
+ * answers 403 rather than 404 so webhook ids cannot be probed for existence. Authorization matches
+ * `createWebhookAction`: organization owners and managers, or a workspace team member with `readWrite`.
+ */
+export async function duplicateV3Webhook(
+  params: TBaseParams & { webhookId: string; auditLog?: TV3AuditLog }
+): Promise<Response> {
+  const { authentication, webhookId, auditLog, requestId, instance } = params;
+  const log = logger.withContext({ requestId, webhookId });
+
+  try {
+    const source = await prisma.webhook.findUnique({ where: { id: webhookId } });
+    if (!source) {
+      return problemForbidden(requestId, undefined, instance);
+    }
+
+    const access = await requireV3WorkspaceAccess(
+      authentication,
+      source.workspaceId,
+      "readWrite",
+      requestId,
+      instance
+    );
+    if (access instanceof Response) return access;
+
+    // A copy attaches every survey of the original anew, so the attach-time outbound guard applies to all
+    // of them: a survey restricted after the original was saved must not be served by a fresh webhook.
+    const blockedSurveyIds = await findNotWorkspaceVisibleSurveyIds(source.surveyIds);
+    if (blockedSurveyIds.length > 0) {
+      return problemForbidden(requestId, SURVEY_NOT_WORKSPACE_VISIBLE_MESSAGE, instance);
+    }
+
+    // Checked here so the caller gets a clear 422; `createWebhook` refuses it with an error that would map
+    // to a 500.
+    if (isDiscordWebhook(source.url)) {
+      return problemUnprocessableContent(requestId, "Discord webhooks are currently not supported.", {
+        instance,
+      });
+    }
+
+    // No secret is passed, so `createWebhook` generates a new one. The URL is validated again, as on any
+    // create: what was a public address when the original was saved may not be one now.
+    let copy;
+    try {
+      copy = await createWebhook(access.workspaceId, {
+        name: getWebhookCopyName(source),
+        url: source.url,
+        source: "user",
+        triggers: source.triggers,
+        surveyIds: source.surveyIds,
+      });
+    } catch (error) {
+      if (error instanceof InvalidInputError) {
+        // `validateWebhookUrl` throws fixed, user-facing messages that name no internals.
+        return problemUnprocessableContent(requestId, error.message, { instance });
+      }
+      throw error;
+    }
+
+    const webhook = serializeV3Webhook(copy);
+    if (auditLog) {
+      auditLog.organizationId = access.organizationId;
+      auditLog.targetId = webhook.id;
+      auditLog.newObject = { ...webhook, duplicatedFrom: webhookId };
+    }
+
+    const sessionUserId = getSessionUserId(authentication);
+    if (sessionUserId) {
+      capturePostHogEvent(
+        sessionUserId,
+        "integration_connected",
+        {
+          integration_type: "webhook",
+          organization_id: access.organizationId,
+          workspace_id: access.workspaceId,
+        },
+        { organizationId: access.organizationId, workspaceId: access.workspaceId }
+      );
+    }
+
+    return successResponse(webhook, { requestId, status: 201 });
+  } catch (error) {
+    return mapV3ThrownError(error, { log, requestId, instance, operation: "webhooks.duplicate" });
+  }
+}
