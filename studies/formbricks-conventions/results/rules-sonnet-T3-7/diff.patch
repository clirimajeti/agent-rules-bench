@@ -0,0 +1,62 @@
+import "server-only";
+import { prisma } from "@formbricks/database";
+import { logger } from "@formbricks/logger";
+import { getV3SessionUserId } from "@/app/api/v3/lib/auth";
+import { problemInternalError, problemUnauthorized, successResponse } from "@/app/api/v3/lib/response";
+import type { TV3Authentication } from "@/app/api/v3/lib/types";
+
+type TBaseParams = {
+  authentication: TV3Authentication;
+  requestId: string;
+  instance?: string;
+};
+
+/**
+ * Exports the signed-in user's own data. The user id comes from the session, never from the request,
+ * so a caller can only ever export their own record.
+ */
+export async function exportV3AccountData({ authentication, requestId, instance }: TBaseParams) {
+  const userId = getV3SessionUserId(authentication);
+  if (!userId) {
+    return problemUnauthorized(requestId, "Not authenticated", instance);
+  }
+
+  try {
+    // One query: the user with its memberships. A user belongs to a handful of organizations, so the
+    // relation needs no pagination.
+    const user = await prisma.user.findUnique({
+      where: { id: userId },
+      select: {
+        name: true,
+        email: true,
+        locale: true,
+        notificationSettings: true,
+        memberships: {
+          select: { role: true, organization: { select: { name: true } } },
+          orderBy: { organization: { name: "asc" } },
+        },
+      },
+    });
+
+    if (!user) {
+      return problemUnauthorized(requestId, "Not authenticated", instance);
+    }
+
+    return successResponse(
+      {
+        name: user.name,
+        email: user.email,
+        locale: user.locale,
+        notificationSettings: user.notificationSettings,
+        organizationMemberships: user.memberships.map((membership) => ({
+          organizationName: membership.organization.name,
+          role: membership.role,
+        })),
+      },
+      { requestId }
+    );
+  } catch (error) {
+    logger.error({ error, requestId }, "Failed to export account data");
+    return problemInternalError(requestId, "Unable to export account data", instance);
+  }
+}
diff --git a/apps/web/app/api/v3/account/export/route.ts b/apps/web/app/api/v3/account/export/route.ts
