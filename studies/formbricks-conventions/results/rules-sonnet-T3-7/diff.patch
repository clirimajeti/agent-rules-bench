@@ -0,0 +1,15 @@
+/**
+ * GET /api/v3/account/export - the signed-in user's own data: name, email, locale, notification
+ * settings and organization memberships.
+ *
+ * Session-only, deliberately: the export is about the person behind the session, so an API key has no
+ * meaning here. The user is resolved from the session, never from the request.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { exportV3AccountData } from "./lib/operations";
+
+export const GET = withV3ApiWrapper({
+  auth: "session",
+  handler: async ({ authentication, requestId, instance }) =>
+    exportV3AccountData({ authentication, requestId, instance }),
+});
