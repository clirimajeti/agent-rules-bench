@@ -0,0 +1,18 @@
+import { parseV3ApiError } from "@/modules/api/lib/v3-client";
+
+export type TAccountExport = {
+  name: string;
+  email: string;
+  locale: string;
+  notificationSettings: unknown;
+  organizationMemberships: { organizationName: string; role: string }[];
+};
+
+/** Fetch the signed-in user's data. Throws a parsed `V3ApiError` on a non-2xx response. */
+export async function getAccountExport(): Promise<TAccountExport> {
+  const response = await fetch("/api/v3/account/export", { method: "GET", cache: "no-store" });
+  if (!response.ok) {
+    throw await parseV3ApiError(response);
+  }
+  return ((await response.json()) as { data: TAccountExport }).data;
+}
