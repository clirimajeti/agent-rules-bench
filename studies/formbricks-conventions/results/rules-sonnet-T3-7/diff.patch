@@ -0,0 +1,47 @@
+"use client";
+
+import { QueryClient, QueryClientProvider, useMutation } from "@tanstack/react-query";
+import { useState } from "react";
+import { toast } from "react-hot-toast";
+import { useTranslation } from "react-i18next";
+import { getAccountExport } from "@/app/(app)/workspaces/[workspaceId]/settings/account/profile/lib/api-client";
+import { getV3ApiErrorMessage } from "@/modules/api/lib/v3-client";
+import { Button } from "@/modules/ui/components/button";
+
+const downloadJson = (data: unknown, fileName: string) => {
+  const url = URL.createObjectURL(new Blob([JSON.stringify(data, null, 2)], { type: "application/json" }));
+  const link = document.createElement("a");
+  link.href = url;
+  link.download = fileName;
+  link.click();
+  URL.revokeObjectURL(url);
+};
+
+const DownloadMyDataContent = () => {
+  const { t } = useTranslation();
+  const { mutate, isPending } = useMutation({
+    mutationFn: getAccountExport,
+    onSuccess: (data) => downloadJson(data, "formbricks-my-data.json"),
+    onError: (error) =>
+      toast.error(getV3ApiErrorMessage(error, t("common.something_went_wrong_please_try_again"))),
+  });
+
+  return (
+    <div className="flex items-center justify-between gap-x-4">
+      <p className="text-sm text-slate-600">{t("workspace.settings.profile.download_my_data_description")}</p>
+      <Button variant="secondary" size="sm" loading={isPending} onClick={() => mutate()}>
+        {t("workspace.settings.profile.download_my_data")}
+      </Button>
+    </div>
+  );
+};
+
+export const DownloadMyData = () => {
+  const [queryClient] = useState(() => new QueryClient());
+
+  return (
+    <QueryClientProvider client={queryClient}>
+      <DownloadMyDataContent />
+    </QueryClientProvider>
+  );
+};
diff --git a/apps/web/app/(app)/workspaces/[workspaceId]/settings/account/profile/lib/api-client.ts b/apps/web/app/(app)/workspaces/[workspaceId]/settings/account/profile/lib/api-client.ts
