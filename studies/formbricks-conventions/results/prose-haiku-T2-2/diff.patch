diff --git a/apps/web/modules/integrations/webhooks/components/webhook-duplicate-button.tsx b/apps/web/modules/integrations/webhooks/components/webhook-duplicate-button.tsx
new file mode 100644
index 000000000..778a9ccb1
--- /dev/null
+++ b/apps/web/modules/integrations/webhooks/components/webhook-duplicate-button.tsx
@@ -0,0 +1,66 @@
+"use client";
+
+import { CopyIcon } from "lucide-react";
+import { useRouter } from "next/navigation";
+import { useState } from "react";
+import toast from "react-hot-toast";
+import { useTranslation } from "react-i18next";
+import { Webhook } from "@formbricks/database/prisma-browser";
+import { getFormattedErrorMessage } from "@/lib/utils/error-message";
+import { createWebhookAction } from "@/modules/integrations/webhooks/actions";
+import { Button } from "@/modules/ui/components/button";
+
+interface WebhookDuplicateButtonProps {
+  workspaceId: string;
+  webhook: Webhook;
+}
+
+export const WebhookDuplicateButton = ({ workspaceId, webhook }: Readonly<WebhookDuplicateButtonProps>) => {
+  const router = useRouter();
+  const { t } = useTranslation();
+  const [duplicating, setDuplicating] = useState(false);
+
+  const handleDuplicate = async () => {
+    setDuplicating(true);
+    try {
+      // No webhookSecret is passed, so the server generates a new signing secret for the copy.
+      const result = await createWebhookAction({
+        workspaceId,
+        webhookInput: {
+          name: t("workspace.integrations.webhooks.copy_of", { name: webhook.name || webhook.url }),
+          url: webhook.url,
+          source: "user",
+          triggers: webhook.triggers,
+          surveyIds: webhook.surveyIds,
+        },
+      });
+
+      if (!result?.data) {
+        toast.error(getFormattedErrorMessage(result));
+        return;
+      }
+
+      toast.success(t("workspace.integrations.webhooks.webhook_duplicated"));
+      router.refresh();
+    } catch (err) {
+      toast.error(err instanceof Error ? err.message : t("common.something_went_wrong_please_try_again"));
+    } finally {
+      setDuplicating(false);
+    }
+  };
+
+  return (
+    <Button
+      type="button"
+      variant="ghost"
+      size="sm"
+      loading={duplicating}
+      className="relative z-10"
+      aria-label={t("common.duplicate")}
+      title={t("common.duplicate")}
+      onClick={handleDuplicate}>
+      <CopyIcon />
+      {t("common.duplicate")}
+    </Button>
+  );
+};
