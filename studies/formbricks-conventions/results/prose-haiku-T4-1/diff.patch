+export async function deleteUnusedV3Tags(
+  params: TBaseParams & { workspaceId: string; auditLog?: TV3AuditLog }
+): Promise<Response> {
+  const { workspaceId, auditLog, requestId, instance } = params;
+
+  // Workspace-scoped, so the caller's access is checked against the workspace named in the body. Same
+  // `readWrite` floor as deleting a single tag.
+  const access = await requireV3WorkspaceAccess(
+    params.authentication,
+    workspaceId,
+    "readWrite",
+    requestId,
+    instance
+  );
+  if (access instanceof Response) return access;
+
+  if (auditLog) {
+    auditLog.organizationId = access.organizationId;
+    auditLog.targetId = workspaceId;
+  }
+
+  const result = await deleteUnusedTags(workspaceId);
+  if (!result.ok) {
+    return problemInternalError(requestId, "Unable to delete unused tags", instance);
+  }
+
+  return successResponse({ deletedCount: result.data.count }, { requestId });
+}
