+/**
+ * POST /api/v3/tags/delete-unused — delete every tag of a workspace that no response carries.
+ *
+ * The workspace comes from the body and is checked against the caller's `readWrite` access. Session-only,
+ * matching the single-tag routes it sits beside.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { deleteUnusedV3Tags } from "../lib/operations";
+import { ZV3DeleteUnusedTagsBody } from "../lib/schemas";
+
+export const POST = withV3ApiWrapper({
+  auth: "session",
+  action: "deleted",
+  targetType: "tag",
+  schemas: { body: ZV3DeleteUnusedTagsBody },
+  handler: async ({ authentication, parsedInput, auditLog, requestId, instance }) =>
+    deleteUnusedV3Tags({
+      authentication,
+      workspaceId: parsedInput.body.workspaceId,
+      auditLog,
+      requestId,
+      instance,
+    }),
+});
