+/**
+ * Deletes every tag of the workspace that no response carries. The `none` filter runs inside the single
+ * DELETE statement, so a tag applied concurrently is either kept or deleted, never removed while in use.
+ * Responses are checked unscoped on purpose: a tag used only on a response the caller cannot read is
+ * still in use.
+ */
+export const deleteUnusedTags = async (
+  workspaceId: string
+): Promise<Result<{ count: number }, { code: TagError; message: string }>> => {
+  validateInputs([workspaceId, ZId]);
+
+  try {
+    const { count } = await prisma.tag.deleteMany({
+      where: {
+        workspaceId,
+        responses: { none: {} },
+      },
+    });
+
+    return ok({ count });
+  } catch (error) {
+    return err({
+      code: TagError.UNEXPECTED_ERROR,
+      message: error instanceof Error ? error.message : "Unknown error occurred",
+    });
+  }
+};
