+/**
+ * POST /api/v3/webhooks/{webhookId}/duplicate — clone a webhook into a new one.
+ */
+import { z } from "zod";
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import {
+  getOrganizationIdFromWebhookId,
+  getWorkspaceIdFromWebhookId,
+} from "@/lib/utils/helper";
+import {
+  getWebhookWithSecret,
+} from "@/modules/api/v2/management/webhooks/[webhookId]/lib/webhook";
+import { applyRateLimit } from "@/modules/core/rate-limit/helpers";
+import { rateLimitConfigs } from "@/modules/core/rate-limit/rate-limit-configs";
+import { ResourceNotFoundError } from "@formbricks/types/errors";
+import { assertCan } from "@/lib/authorization";
+import { createWebhook } from "@/modules/integrations/webhooks/lib/webhook";
+import { successResponse } from "@/app/api/v3/lib/response";
+
+const ZWebhookIdInput = z.object({
+  webhookId: z.string(),
+});
+
+export const POST = withV3ApiWrapper({
+  auth: "both",
+  schemas: {
+    params: ZWebhookIdInput,
+  },
+  action: "created",
+  targetType: "webhook",
+  handler: async ({ req, parsedInput, authentication, auditLog, requestId, instance }) => {
+    const webhookId = parsedInput.params.webhookId;
+    const workspaceId = await getWorkspaceIdFromWebhookId(webhookId);
+
+    await assertCan({ type: "user", id: authentication.userId }, "workspace.write", {
+      type: "workspace",
+      id: workspaceId,
+    });
+
+    await applyRateLimit(rateLimitConfigs.actions.stateMutation, workspaceId);
+
+    const existing = await getWebhookWithSecret(webhookId);
+    if (!existing.ok) {
+      return new Response(
+        JSON.stringify({
+          code: "not_found",
+          message: "Webhook not found",
+        }),
+        { status: 404, headers: { "Content-Type": "application/json" } }
+      );
+    }
+
+    const organizationId = await getOrganizationIdFromWebhookId(webhookId);
+    const originalName = existing.data.name;
+    const newName = originalName ? `Copy of ${originalName}` : "Copy of Webhook";
+
+    const newWebhook = await createWebhook(workspaceId, {
+      name: newName,
+      url: existing.data.url,
+      source: "user" as const,
+      triggers: existing.data.triggers,
+      surveyIds: existing.data.surveyIds,
+    });
+
+    // Set audit log context
+    if (auditLog) {
+      auditLog.eventId = requestId;
+      auditLog.status = "success";
+    }
+
+    return successResponse(newWebhook, { requestId });
+  },
+});
