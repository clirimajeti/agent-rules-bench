+/**
+ * Replaces the secret of an existing key. The key keeps its id, label, organization access and
+ * workspace permissions, so no relationship reconciliation is needed. The previous secret stops
+ * working as soon as the row is updated, because its lookup hash is overwritten.
+ */
+export const rotateApiKey = async (
+  apiKeyId: string
+): Promise<{ id: string; lastUsedAt: Date | null; actualKey: string }> => {
+  validateInputs([apiKeyId, ZId]);
+  const { secret, hashedKey, lookupHash } = await generateApiKeySecret();
+
+  try {
+    const rotatedApiKey = await prisma.apiKey.update({
+      where: { id: apiKeyId },
+      // The new secret has never been used, so the previous secret's last-use time no longer applies.
+      data: { hashedKey, lookupHash, lastUsedAt: null },
+      select: { id: true, lastUsedAt: true },
+    });
+
+    // Return the new v2 format: fbk_{secret}. The hashes stay on the server.
+    return { ...rotatedApiKey, actualKey: `fbk_${secret}` };
+  } catch (error) {
+    if (error instanceof Prisma.PrismaClientKnownRequestError) {
+      throw new DatabaseError(error.message);
+    }
+    throw error;
+  }
+};
