@@ -0,0 +1,64 @@
+"use client";
+
+import toast from "react-hot-toast";
+import { useTranslation } from "react-i18next";
+import { Button } from "@/modules/ui/components/button";
+import {
+  Dialog,
+  DialogBody,
+  DialogContent,
+  DialogFooter,
+  DialogHeader,
+  DialogTitle,
+} from "@/modules/ui/components/dialog";
+
+interface RotatedApiKeyModalProps {
+  /** The new plaintext key, or null when no rotation result is being shown. */
+  apiKey: string | null;
+  onClose: () => void;
+}
+
+/**
+ * Shows the secret produced by a rotation exactly once. The plaintext is only held by the caller
+ * while this dialog is open, and closing it discards it. Outside clicks are disabled so an accidental
+ * click cannot dismiss the dialog before the key has been copied.
+ */
+export const RotatedApiKeyModal = ({ apiKey, onClose }: Readonly<RotatedApiKeyModalProps>) => {
+  const { t } = useTranslation();
+
+  const copyToClipboard = async () => {
+    if (!apiKey) return;
+    try {
+      await navigator.clipboard.writeText(apiKey);
+      toast.success(t("workspace.api_keys.api_key_copied_to_clipboard"));
+    } catch {
+      toast.error(t("workspace.api_keys.unable_to_copy_api_key"));
+    }
+  };
+
+  return (
+    <Dialog
+      open={apiKey !== null}
+      onOpenChange={(open) => {
+        if (!open) onClose();
+      }}>
+      <DialogContent disableCloseOnOutsideClick>
+        <DialogHeader>
+          <DialogTitle className="px-1">{t("workspace.api_keys.rotated_api_key_title")}</DialogTitle>
+        </DialogHeader>
+        <DialogBody className="space-y-4 overflow-y-auto px-1 py-4">
+          <p className="text-sm text-slate-500">{t("workspace.api_keys.rotated_api_key_description")}</p>
+          <div className="rounded-md bg-slate-100 p-3 font-mono text-sm break-all" data-testid="rotated-api-key">
+            {apiKey}
+          </div>
+        </DialogBody>
+        <DialogFooter>
+          <Button variant="secondary" onClick={() => void copyToClipboard()}>
+            {t("common.copy")}
+          </Button>
+          <Button onClick={onClose}>{t("common.close")}</Button>
+        </DialogFooter>
+      </DialogContent>
+    </Dialog>
+  );
+};
