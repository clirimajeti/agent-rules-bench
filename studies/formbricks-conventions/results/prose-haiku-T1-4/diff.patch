diff --git a/apps/web/modules/organization/settings/api-keys/lib/api-client.ts b/apps/web/modules/organization/settings/api-keys/lib/api-client.ts
new file mode 100644
index 000000000..f006cedd3
--- /dev/null
+++ b/apps/web/modules/organization/settings/api-keys/lib/api-client.ts
@@ -0,0 +1,25 @@
+import { parseV3ApiError } from "@/modules/api/lib/v3-client";
+
+/**
+ * Client fetchers for the API key v3 routes. Every call throws a parsed `V3ApiError` on a non-2xx response,
+ * so the hooks can surface the server's own message.
+ */
+
+const BASE_PATH = "/api/v3/api-keys";
+
+export type TRotatedApiKey = {
+  id: string;
+  /** The new plaintext key. The server returns it once; it is never stored on the client after the dialog closes. */
+  actualKey: string;
+};
+
+export async function rotateApiKey(params: { apiKeyId: string }): Promise<TRotatedApiKey> {
+  const response = await fetch(`${BASE_PATH}/${params.apiKeyId}/rotate`, {
+    method: "POST",
+    cache: "no-store",
+  });
+  if (!response.ok) {
+    throw await parseV3ApiError(response);
+  }
+  return ((await response.json()) as { data: TRotatedApiKey }).data;
+}
