@@ -0,0 +1,29 @@
+/**
+ * POST /api/v3/api-keys/{apiKeyId}/rotate - replace the secret of an existing API key. The response is the
+ * only place the new plaintext key is ever returned.
+ *
+ * Session-only, deliberately. This replaces the `authenticatedActionClient` server action that only ever
+ * ran for a signed-in user, so accepting `x-api-key` here would widen the surface rather than migrate it.
+ */
+import { z } from "zod";
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { rotateV3ApiKey } from "../../lib/operations";
+
+const apiKeyParamsSchema = z.object({
+  apiKeyId: z.cuid2(),
+});
+
+export const POST = withV3ApiWrapper({
+  auth: "session",
+  action: "updated",
+  targetType: "apiKey",
+  schemas: { params: apiKeyParamsSchema },
+  handler: async ({ authentication, parsedInput, auditLog, requestId, instance }) =>
+    rotateV3ApiKey({
+      authentication,
+      apiKeyId: parsedInput.params.apiKeyId,
+      auditLog,
+      requestId,
+      instance,
+    }),
+});
diff --git a/apps/web/app/api/v3/api-keys/lib/operations.ts b/apps/web/app/api/v3/api-keys/lib/operations.ts
new file mode 100644
index 000000000..37c824d77
--- /dev/null
+++ b/apps/web/app/api/v3/api-keys/lib/operations.ts
@@ -0,0 +1,54 @@
+import "server-only";
+import { logger } from "@formbricks/logger";
+import { mapV3ThrownError } from "@/app/api/v3/lib/errors";
+import { problemForbidden, successResponse } from "@/app/api/v3/lib/response";
+import type { TV3AuditLog, TV3Authentication } from "@/app/api/v3/lib/types";
+import { assertCan } from "@/lib/authorization";
+import { getOrganizationIdFromApiKeyId } from "@/lib/utils/helper";
+import { rotateApiKey } from "@/modules/organization/settings/api-keys/lib/api-key";
+
+type TRotateParams = {
+  authentication: TV3Authentication;
+  apiKeyId: string;
+  requestId: string;
+  instance?: string;
+  auditLog?: TV3AuditLog;
+};
+
+/**
+ * `POST /api/v3/api-keys/{apiKeyId}/rotate`. The `apiKey.manage` check runs here, not in the route wrapper,
+ * so the authorization matches the server action this replaces. The audit entry records that the secret
+ * was replaced and never carries the secret or its hashes.
+ */
+export async function rotateV3ApiKey({
+  authentication,
+  apiKeyId,
+  requestId,
+  instance,
+  auditLog,
+}: TRotateParams): Promise<Response> {
+  const log = logger.withContext({ requestId, apiKeyId });
+
+  try {
+    if (!authentication || !("user" in authentication) || !authentication.user) {
+      return problemForbidden(requestId, undefined, instance);
+    }
+
+    const organizationId = await getOrganizationIdFromApiKeyId(apiKeyId);
+    await assertCan({ type: "user", id: authentication.user.id }, "apiKey.manage", {
+      type: "apiKey",
+      id: apiKeyId,
+    });
+
+    if (auditLog) {
+      auditLog.organizationId = organizationId;
+      auditLog.targetId = apiKeyId;
+      auditLog.newObject = { secretRotated: true };
+    }
+
+    const rotated = await rotateApiKey(apiKeyId);
+    return successResponse(rotated, { requestId });
+  } catch (error) {
+    return mapV3ThrownError(error, { log, requestId, instance, operation: "apiKeys.rotate" });
+  }
+}
