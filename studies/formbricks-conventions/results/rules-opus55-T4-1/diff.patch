+/**
+ * Delete every tag of the workspace that no response carries.
+ *
+ * "Unused" is judged against all responses of the workspace, never against the responses the caller may
+ * read: a tag that only appears on surveys hidden from the caller is still in use, and deleting it would
+ * strip it from responses the caller cannot even see.
+ *
+ * The delete repeats the `responses: { none: {} }` filter instead of trusting the candidate list, so a
+ * tag applied to a response between the read and the delete is kept. The ids that were really deleted
+ * are only re-read when that race happened, so the common path stays two queries.
+ */
+export const deleteUnusedTags = async (
+  workspaceId: string
+): Promise<Result<{ deletedTagIds: string[] }, { code: TagError; message: string }>> => {
+  validateInputs([workspaceId, ZId]);
+
+  try {
+    const deletedTagIds = await prisma.$transaction(async (tx) => {
+      const unusedTagWhere = { workspaceId, responses: { none: {} } };
+      const candidates = await tx.tag.findMany({ where: unusedTagWhere, select: { id: true } });
+      if (candidates.length === 0) return [];
+
+      const candidateIds = candidates.map((tag) => tag.id);
+      const { count } = await tx.tag.deleteMany({ where: { ...unusedTagWhere, id: { in: candidateIds } } });
+      if (count === candidateIds.length) return candidateIds;
+
+      const kept = await tx.tag.findMany({ where: { id: { in: candidateIds } }, select: { id: true } });
+      const keptIds = new Set(kept.map((tag) => tag.id));
+      return candidateIds.filter((id) => !keptIds.has(id));
+    });
+
+    return ok({ deletedTagIds });
+  } catch (error) {
+    return err({
+      code: TagError.UNEXPECTED_ERROR,
+      message: error instanceof Error ? error.message : "Unknown error occurred",
+    });
+  }
+};
