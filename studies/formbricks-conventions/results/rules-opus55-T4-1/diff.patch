+/**
+ * Delete every tag of the workspace that is not on any response. The caller supplies the workspace,
+ * which is safe here for the same reason as `batchDeleteV3Responses`: the value access is checked
+ * against is the value the delete is filtered by, so the two cannot diverge.
+ *
+ * Same `readWrite` requirement as deleting a single tag. Usage is counted across every response of the
+ * workspace, not only the ones visible to the caller (see `deleteUnusedTags`).
+ */
+export async function deleteUnusedV3Tags(
+  params: TBaseParams & { workspaceId: string; auditLog?: TV3AuditLog }
+): Promise<Response> {
+  const { authentication, workspaceId, auditLog, requestId, instance } = params;
+
+  const access = await requireV3WorkspaceAccess(authentication, workspaceId, "readWrite", requestId, instance);
+  if (access instanceof Response) return access;
+
+  const result = await deleteUnusedTags(access.workspaceId);
+  if (!result.ok) {
+    return problemInternalError(requestId, "Unable to delete unused tags", instance);
+  }
+
+  const { deletedTagIds } = result.data;
+
+  if (auditLog) {
+    auditLog.organizationId = access.organizationId;
+    // No single target, so like the responses batch delete this records identity only: the ids are
+    // what makes the action reviewable.
+    auditLog.oldObject = {
+      workspaceId: access.workspaceId,
+      deleted: deletedTagIds.length,
+      tagIds: deletedTagIds,
+    };
+  }
+
+  return successResponse({ deleted: deletedTagIds.length }, { requestId });
+}
