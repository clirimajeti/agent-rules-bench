+/**
+ * Replaces a key's secret in place. The row keeps its id, label, organization access and workspace
+ * permissions, so no relationship needs reconciling. Both lookup columns move to the new secret in one
+ * update, so the old secret stops verifying as soon as it commits. `lastUsedAt` is cleared because it
+ * described the retired secret.
+ *
+ * The plaintext is returned once, as `fbk_{secret}`, and is never stored.
+ */
+export const rotateApiKey = async (
+  apiKeyId: string
+): Promise<{ id: string; label: string; actualKey: string }> => {
+  validateInputs([apiKeyId, ZId]);
+
+  const secret = randomBytes(32).toString("base64url");
+  const lookupHash = hashSha256(secret);
+  const hashedKey = await hashSecret(secret, 12);
+
+  try {
+    const rotatedApiKey = await prisma.apiKey.update({
+      where: { id: apiKeyId },
+      data: { hashedKey, lookupHash, lastUsedAt: null },
+      select: { id: true, label: true },
+    });
+
+    return { ...rotatedApiKey, actualKey: `fbk_${secret}` };
+  } catch (error) {
+    if (error instanceof Prisma.PrismaClientKnownRequestError) {
+      throw new DatabaseError(error.message);
+    }
+    throw error;
+  }
+};
