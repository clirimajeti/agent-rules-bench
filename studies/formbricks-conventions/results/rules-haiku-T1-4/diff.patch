+/**
+ * POST /api/v3/api-keys/{apiKeyId}/rotate - replace the key's secret, keeping its label and access settings.
+ * The response carries the new key in `apiKey`, once; the old key stops working when this commits.
+ *
+ * Session-only, deliberately. It replaces the `authenticatedActionClient` server-action path that only ever
+ * ran for a signed-in user, so accepting `x-api-key` here would widen the surface rather than migrate it.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { rotateV3ApiKey } from "../../lib/operations";
+import { ZV3ApiKeyIdParams } from "../../lib/schemas";
+
+export const POST = withV3ApiWrapper({
+  auth: "session",
+  action: "updated",
+  targetType: "apiKey",
+  schemas: { params: ZV3ApiKeyIdParams },
+  handler: async ({ authentication, parsedInput, auditLog, requestId, instance }) =>
+    rotateV3ApiKey({
+      authentication,
+      apiKeyId: parsedInput.params.apiKeyId,
+      auditLog,
+      requestId,
+      instance,
+    }),
+});
diff --git a/apps/web/app/api/v3/api-keys/lib/operations.ts b/apps/web/app/api/v3/api-keys/lib/operations.ts
new file mode 100644
index 000000000..d020ba64c
--- /dev/null
+++ b/apps/web/app/api/v3/api-keys/lib/operations.ts
@@ -0,0 +1,53 @@
+import "server-only";
+import { problemUnauthorized, successResponse } from "@/app/api/v3/lib/response";
+import type { TV3AuditLog, TV3Authentication } from "@/app/api/v3/lib/types";
+import { assertCan } from "@/lib/authorization";
+import { getOrganizationIdFromApiKeyId } from "@/lib/utils/helper";
+import { rotateApiKey } from "@/modules/organization/settings/api-keys/lib/api-key";
+import type { TV3RotatedApiKey } from "../serializers";
+
+type TBaseParams = {
+  authentication: TV3Authentication;
+  requestId: string;
+  instance?: string;
+};
+
+/**
+ * Replaces the key's secret and returns the new one once. Authorization is the same question the
+ * `deleteApiKeyAction` and `updateApiKeyAction` server actions ask: `apiKey.manage` on the key. A key the
+ * caller cannot see answers 403 through `assertCan` or the not-found mapping, so the response does not
+ * reveal which ids exist.
+ */
+export async function rotateV3ApiKey(
+  params: TBaseParams & { apiKeyId: string; auditLog?: TV3AuditLog }
+): Promise<Response> {
+  const { authentication, apiKeyId, auditLog, requestId, instance } = params;
+
+  if (!authentication || !("user" in authentication) || !authentication.user?.id) {
+    return problemUnauthorized(requestId, "Session required", instance);
+  }
+
+  await assertCan({ type: "user", id: authentication.user.id }, "apiKey.manage", {
+    type: "apiKey",
+    id: apiKeyId,
+  });
+
+  const organizationId = await getOrganizationIdFromApiKeyId(apiKeyId);
+
+  if (auditLog) {
+    auditLog.organizationId = organizationId;
+    auditLog.targetId = apiKeyId;
+  }
+
+  // Audit entries record which key was rotated, never its secret, so neither object is attached.
+  const rotated = await rotateApiKey(apiKeyId);
+
+  const result: TV3RotatedApiKey = {
+    id: rotated.id,
+    label: rotated.label,
+    lastUsedAt: null,
+    apiKey: rotated.actualKey,
+  };
+
+  return successResponse(result, { requestId });
+}
