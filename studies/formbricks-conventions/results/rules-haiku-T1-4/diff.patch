+"use client";
+
+import { CopyIcon, RotateCwIcon } from "lucide-react";
+import toast from "react-hot-toast";
+import { useTranslation } from "react-i18next";
+import { Alert, AlertTitle } from "@/modules/ui/components/alert";
+import { Button } from "@/modules/ui/components/button";
+import {
+  Dialog,
+  DialogBody,
+  DialogContent,
+  DialogDescription,
+  DialogFooter,
+  DialogHeader,
+  DialogTitle,
+} from "@/modules/ui/components/dialog";
+
+interface RotateApiKeyDialogProps {
+  open: boolean;
+  setOpen: (open: boolean) => void;
+  apiKeyLabel: string;
+  onRotate: () => void;
+  isRotating: boolean;
+}
+
+/** Confirms the rotation first, because the current secret stops working the moment it commits. */
+export const RotateApiKeyDialog = ({
+  open,
+  setOpen,
+  apiKeyLabel,
+  onRotate,
+  isRotating,
+}: Readonly<RotateApiKeyDialogProps>) => {
+  const { t } = useTranslation();
+
+  return (
+    <Dialog open={open} onOpenChange={setOpen}>
+      <DialogContent width="narrow" disableCloseOnOutsideClick={true}>
+        <DialogHeader>
+          <DialogTitle>{t("workspace.api_keys.rotate_api_key")}</DialogTitle>
+          <DialogDescription>{apiKeyLabel}</DialogDescription>
+        </DialogHeader>
+        <DialogBody>
+          <p>{t("workspace.api_keys.rotate_api_key_confirmation")}</p>
+        </DialogBody>
+        <DialogFooter>
+          <Button variant="secondary" onClick={() => setOpen(false)} disabled={isRotating}>
+            {t("common.cancel")}
+          </Button>
+          <Button onClick={onRotate} loading={isRotating} disabled={isRotating}>
+            <RotateCwIcon />
+            {t("workspace.api_keys.rotate_api_key")}
+          </Button>
+        </DialogFooter>
+      </DialogContent>
+    </Dialog>
+  );
+};
+
+interface RevealedApiKeyDialogProps {
+  revealedKey: { label: string; secret: string } | null;
+  onClose: () => void;
+}
+
+/**
+ * Shows a rotated secret exactly once. The secret lives only in the parent's state while this dialog is
+ * open; closing it discards the state, and the server never returns the plaintext again.
+ */
+export const RevealedApiKeyDialog = ({ revealedKey, onClose }: Readonly<RevealedApiKeyDialogProps>) => {
+  const { t } = useTranslation();
+
+  const copyToClipboard = async () => {
+    if (!revealedKey) return;
+    try {
+      await navigator.clipboard.writeText(revealedKey.secret);
+      toast.success(t("workspace.api_keys.api_key_copied_to_clipboard"));
+    } catch {
+      toast.error(t("workspace.api_keys.unable_to_copy_api_key"));
+    }
+  };
+
+  return (
+    <Dialog
+      open={revealedKey !== null}
+      onOpenChange={(open) => {
+        if (!open) onClose();
+      }}>
+      <DialogContent width="narrow" disableCloseOnOutsideClick={true}>
+        <DialogHeader>
+          <DialogTitle>{t("workspace.api_keys.rotated_api_key_title")}</DialogTitle>
+          <DialogDescription>{revealedKey?.label}</DialogDescription>
+        </DialogHeader>
+        <DialogBody className="space-y-4">
+          <Alert variant="warning" role="status">
+            <AlertTitle>{t("workspace.api_keys.rotated_api_key_warning")}</AlertTitle>
+          </Alert>
+          <div className="flex items-center justify-between gap-2 rounded-md border border-slate-200 bg-slate-50 p-3">
+            <span className="font-mono text-sm break-all" data-testid="rotated-api-key">
+              {revealedKey?.secret}
+            </span>
+            <Button variant="secondary" size="sm" className="shrink-0" onClick={copyToClipboard}>
+              <CopyIcon />
+              {t("common.copy")}
+            </Button>
+          </div>
+        </DialogBody>
+        <DialogFooter>
+          <Button onClick={onClose}>{t("common.done")}</Button>
+        </DialogFooter>
+      </DialogContent>
+    </Dialog>
+  );
+};
