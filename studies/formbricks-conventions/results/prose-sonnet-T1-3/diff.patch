+/** The owning organization and organization-level access of a key, for authorizing a change to it. */
+export const getApiKeyOrganizationAccess = async (
+  apiKeyId: string
+): Promise<Pick<ApiKey, "organizationId" | "organizationAccess"> | null> => {
+  validateInputs([apiKeyId, ZId]);
+
+  try {
+    return await prisma.apiKey.findUnique({
+      where: { id: apiKeyId },
+      select: { organizationId: true, organizationAccess: true },
+    });
+  } catch (error) {
+    if (error instanceof Prisma.PrismaClientKnownRequestError) {
+      throw new DatabaseError(error.message);
+    }
+    throw error;
+  }
+};
+
+/**
+ * Replaces the secret of an existing key in place. The row keeps its id, label, creator and every
+ * permission, so nothing that references the key (audit trail, authorization relationships) moves.
+ * `lastUsedAt` resets because the new secret has not been used yet, and the old one stops working as
+ * soon as the update commits.
+ *
+ * The plaintext is returned once and never stored.
+ */
+export const rotateApiKey = async (
+  apiKeyId: string
+): Promise<TApiKeyWithEnvironmentPermission & { actualKey: string }> => {
+  validateInputs([apiKeyId, ZId]);
+
+  try {
+    const secret = randomBytes(32).toString("base64url");
+    const lookupHash = hashSha256(secret);
+    const hashedKey = await hashSecret(secret, 12);
+
+    const result = await prisma.apiKey.update({
+      where: { id: apiKeyId },
+      data: { hashedKey, lookupHash, lastUsedAt: null },
+      select: {
+        id: true,
+        label: true,
+        createdAt: true,
+        lastUsedAt: true,
+        organizationAccess: true,
+        apiKeyWorkspaces: {
+          select: {
+            permission: true,
+            workspaceId: true,
+          },
+        },
+      },
+    });
+
+    return { ...result, actualKey: `fbk_${secret}` };
+  } catch (error) {
+    if (error instanceof Prisma.PrismaClientKnownRequestError) {
+      throw new DatabaseError(error.message);
+    }
+    throw error;
+  }
+};
