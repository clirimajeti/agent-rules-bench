@@ -0,0 +1,63 @@
+import "server-only";
+import { AuthorizationError, OperationNotAllowedError } from "@formbricks/types/errors";
+import { getV3SessionUserId } from "@/app/api/v3/lib/auth";
+import { problemForbidden, problemUnauthorized, successResponse } from "@/app/api/v3/lib/response";
+import type { TV3AuditLog, TV3Authentication } from "@/app/api/v3/lib/types";
+import { assertCan } from "@/lib/authorization";
+import {
+  getApiKeyOrganizationAccess,
+  rotateApiKey,
+} from "@/modules/organization/settings/api-keys/lib/api-key";
+import { assertCanGrantOrganizationAccess } from "@/modules/organization/settings/api-keys/lib/organization-access";
+
+const FORBIDDEN_DETAIL = "You are not authorized to access this resource";
+
+/**
+ * The organization is resolved from the key itself, never from the caller, and an unknown key answers
+ * 403 rather than 404 so key ids cannot be probed. The authorization matches the update and delete
+ * actions (`apiKey.manage`), plus the organization-access floor: rotating hands the caller the secret
+ * of a key that may carry `accessControl.write`, which is the same authority creating one would grant.
+ */
+export async function rotateV3ApiKey(params: {
+  authentication: TV3Authentication;
+  apiKeyId: string;
+  auditLog?: TV3AuditLog;
+  requestId: string;
+  instance?: string;
+}): Promise<Response> {
+  const { authentication, apiKeyId, auditLog, requestId, instance } = params;
+
+  const userId = getV3SessionUserId(authentication);
+  if (!userId) return problemUnauthorized(requestId, "Session required", instance);
+
+  const existing = await getApiKeyOrganizationAccess(apiKeyId);
+  if (!existing) return problemForbidden(requestId, FORBIDDEN_DETAIL, instance);
+
+  try {
+    await assertCan({ type: "user", id: userId }, "apiKey.manage", { type: "apiKey", id: apiKeyId });
+    await assertCanGrantOrganizationAccess(userId, existing.organizationId, existing.organizationAccess);
+  } catch (error) {
+    if (error instanceof AuthorizationError || error instanceof OperationNotAllowedError) {
+      return problemForbidden(requestId, FORBIDDEN_DETAIL, instance);
+    }
+    throw error;
+  }
+
+  if (auditLog) {
+    auditLog.organizationId = existing.organizationId;
+    auditLog.targetId = apiKeyId;
+  }
+
+  const rotated = await rotateApiKey(apiKeyId);
+
+  return successResponse(
+    {
+      id: rotated.id,
+      label: rotated.label,
+      createdAt: rotated.createdAt.toISOString(),
+      lastUsedAt: null,
+      key: rotated.actualKey,
+    },
+    { requestId }
+  );
+}
