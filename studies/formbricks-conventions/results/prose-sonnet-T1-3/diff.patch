@@ -0,0 +1,111 @@
+"use client";
+
+import { FilesIcon, RefreshCwIcon } from "lucide-react";
+import toast from "react-hot-toast";
+import { useTranslation } from "react-i18next";
+import { useRotateApiKey } from "@/modules/organization/settings/api-keys/hooks/use-rotate-api-key";
+import { Button } from "@/modules/ui/components/button";
+import {
+  Dialog,
+  DialogBody,
+  DialogContent,
+  DialogDescription,
+  DialogFooter,
+  DialogHeader,
+  DialogTitle,
+} from "@/modules/ui/components/dialog";
+
+interface RotateApiKeyDialogProps {
+  /** The key being rotated, or `null` when the dialog is closed. */
+  apiKey: { id: string; label: string } | null;
+  onClose: () => void;
+  /** Called once the server has replaced the secret, so the row can drop its stale `lastUsedAt`. */
+  onRotated: (apiKeyId: string) => void;
+}
+
+export const RotateApiKeyDialog = ({ apiKey, onClose, onRotated }: Readonly<RotateApiKeyDialogProps>) => {
+  const { t } = useTranslation();
+  const rotateMutation = useRotateApiKey();
+
+  // The new secret lives only in the mutation result. Once the dialog closes it is reset, and the secret
+  // is gone for good, which is exactly the "shown once" contract.
+  const newKey = rotateMutation.data?.key;
+
+  const close = () => {
+    rotateMutation.reset();
+    onClose();
+  };
+
+  const handleRotate = () => {
+    if (!apiKey) return;
+    rotateMutation.mutate(apiKey.id, {
+      onSuccess: () => {
+        onRotated(apiKey.id);
+        toast.success(t("workspace.api_keys.api_key_rotated"));
+      },
+      onError: () => {
+        toast.error(t("workspace.api_keys.unable_to_rotate_api_key"));
+      },
+    });
+  };
+
+  const copyToClipboard = async () => {
+    if (!newKey) return;
+    try {
+      await navigator.clipboard.writeText(newKey);
+      toast.success(t("workspace.api_keys.api_key_copied_to_clipboard"));
+    } catch {
+      toast.error(t("workspace.api_keys.unable_to_copy_api_key"));
+    }
+  };
+
+  return (
+    <Dialog open={apiKey !== null} onOpenChange={(open) => !open && !rotateMutation.isPending && close()}>
+      <DialogContent width="narrow" hideCloseButton={true} disableCloseOnOutsideClick={true}>
+        {newKey ? (
+          <>
+            <DialogHeader>
+              <DialogTitle>{t("workspace.api_keys.new_api_key_title")}</DialogTitle>
+              <DialogDescription>{t("workspace.api_keys.new_api_key_warning")}</DialogDescription>
+            </DialogHeader>
+            <DialogBody>
+              <div className="flex items-center justify-between gap-2">
+                <span className="break-all">{newKey}</span>
+                <Button
+                  size="icon"
+                  variant="ghost"
+                  aria-label={t("common.copy")}
+                  data-testid="copy-rotated-key-button"
+                  onClick={() => void copyToClipboard()}>
+                  <FilesIcon />
+                </Button>
+              </div>
+            </DialogBody>
+            <DialogFooter>
+              <Button onClick={close}>{t("common.done")}</Button>
+            </DialogFooter>
+          </>
+        ) : (
+          <>
+            <DialogHeader>
+              <DialogTitle>{t("workspace.api_keys.rotate_api_key_title")}</DialogTitle>
+              <DialogDescription>{apiKey?.label}</DialogDescription>
+            </DialogHeader>
+            <DialogBody>
+              <p>{t("workspace.api_keys.rotate_api_key_confirmation")}</p>
+            </DialogBody>
+            <DialogFooter>
+              <Button variant="secondary" onClick={close} disabled={rotateMutation.isPending}>
+                {t("common.cancel")}
+              </Button>
+              <Button onClick={handleRotate} loading={rotateMutation.isPending}>
+                <RefreshCwIcon />
+                {t("workspace.api_keys.rotate_api_key")}
+              </Button>
+            </DialogFooter>
+          </>
+        )}
+      </DialogContent>
+    </Dialog>
+  );
+};
