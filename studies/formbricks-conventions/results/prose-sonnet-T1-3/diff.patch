index 000000000..6e4eb89d2
--- /dev/null
+++ b/apps/web/modules/organization/settings/api-keys/lib/v3-api-keys-client.ts
@@ -0,0 +1,26 @@
+import { parseV3ApiError } from "@/modules/api/lib/v3-client";
+
+type TV3RotateApiKeyResponse = {
+  data: {
+    id: string;
+    label: string;
+    createdAt: string;
+    lastUsedAt: string | null;
+    /** The new plaintext key. The server returns it once and never stores it. */
+    key: string;
+  };
+};
+
+export async function rotateApiKey(apiKeyId: string): Promise<TV3RotateApiKeyResponse["data"]> {
+  const response = await fetch(`/api/v3/api-keys/${apiKeyId}/rotate`, {
+    method: "POST",
+    cache: "no-store",
+  });
+
+  if (!response.ok) {
+    throw await parseV3ApiError(response);
+  }
+
+  const responseBody = (await response.json()) as TV3RotateApiKeyResponse;
+  return responseBody.data;
+}
