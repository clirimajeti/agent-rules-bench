diff --git a/docs/api-v3-reference/src/paths/api_v3_api-keys_{apiKeyId}_rotate.yml b/docs/api-v3-reference/src/paths/api_v3_api-keys_{apiKeyId}_rotate.yml
new file mode 100644
index 000000000..452fedf90
--- /dev/null
+++ b/docs/api-v3-reference/src/paths/api_v3_api-keys_{apiKeyId}_rotate.yml
@@ -0,0 +1,73 @@
+post:
+  operationId: rotateApiKeyV3
+  # Session-only by design: an API key must not mint or replace API key secrets, so a key caller would
+  # only ever get a 401. Excluded from the generated docs pages; the operation stays in the bundle for
+  # the contract tests.
+  x-excluded: true
+  summary: Rotate an API key
+  description: |
+    Replaces the secret of an API key. The key keeps its id, label and access settings, its `lastUsedAt`
+    resets to `null`, and the previous secret stops working immediately.
+
+    The new secret is returned in `key` once and is never stored in plain text, so it cannot be read again.
+
+    Requires the same permission as updating or deleting the key. Rotating a key that carries organization
+    user-management write access also requires a role that may grant that access. An unknown `apiKeyId`
+    answers `403`, not `404`, so key ids cannot be probed for existence.
+  tags:
+    - V3 API Keys
+  parameters:
+    - in: path
+      name: apiKeyId
+      required: true
+      schema:
+        type: string
+        format: cuid2
+  responses:
+    "200":
+      description: API key rotated successfully
+      content:
+        application/json:
+          schema:
+            type: object
+            required:
+              - data
+            properties:
+              data:
+                type: object
+                required:
+                  - id
+                  - label
+                  - createdAt
+                  - lastUsedAt
+                  - key
+                properties:
+                  id:
+                    type: string
+                    format: cuid2
+                  label:
+                    type: string
+                  createdAt:
+                    type: string
+                    format: date-time
+                  lastUsedAt:
+                    type:
+                      - string
+                      - "null"
+                    format: date-time
+                    description: Always `null` right after a rotation.
+                  key:
+                    type: string
+                    description: The new API key. Shown once.
+    "400":
+      $ref: ../components/responses/V3BadRequest.yml
+    "401":
+      $ref: ../components/responses/V3UnauthorizedSession.yml
+    "403":
+      $ref: ../components/responses/V3Forbidden.yml
+    "429":
+      $ref: ../components/responses/V3TooManyRequests.yml
+    "500":
+      $ref: ../components/responses/V3InternalServerError.yml
+  security:
+    - sessionAuth: []
