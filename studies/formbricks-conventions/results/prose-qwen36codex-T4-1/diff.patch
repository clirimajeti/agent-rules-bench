+/**
+ * DELETE /api/v3/tags/bulk-delete-unused — delete every tag of a workspace that is not used on any
+ * response.
+ *
+ * A dedicated collection-level endpoint rather than a client-side loop because the caller needs to
+ * know how many tags were actually deleted, and the operation must run as a single transaction so that
+ * concurrent mutations do not leave the workspace in a partially-deleted state.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { bulkDeleteUnusedV3Tags } from "../lib/operations";
+import { ZV3BulkDeleteUnusedTagsQuery } from "../lib/schemas";
+
+export const DELETE = withV3ApiWrapper({
+  auth: "session",
+  action: "deleted",
+  targetType: "tag",
+  schemas: { query: ZV3BulkDeleteUnusedTagsQuery },
+  handler: async ({ authentication, parsedInput, auditLog, requestId, instance }) =>
+    bulkDeleteUnusedV3Tags({
+      authentication,
+      workspaceId: parsedInput.query.workspaceId,
+      auditLog,
+      requestId,
+      instance,
+    }),
+});
