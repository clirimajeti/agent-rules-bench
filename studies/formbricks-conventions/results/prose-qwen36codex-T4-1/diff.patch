diff --git a/apps/web/modules/workspaces/settings/tags/hooks/use-bulk-delete-unused-tags.ts b/apps/web/modules/workspaces/settings/tags/hooks/use-bulk-delete-unused-tags.ts
new file mode 100644
index 000000000..8b8e42a9d
--- /dev/null
+++ b/apps/web/modules/workspaces/settings/tags/hooks/use-bulk-delete-unused-tags.ts
@@ -0,0 +1,14 @@
+"use client";
+
+import { useMutation, useQueryClient } from "@tanstack/react-query";
+import { bulkDeleteUnusedTags } from "../lib/api-client";
+import { tagKeys } from "../lib/query";
+
+/** Bulk-delete every unused tag of a workspace, then invalidate the list. */
+export const useBulkDeleteUnusedTags = (workspaceId: string) => {
+  const queryClient = useQueryClient();
+  return useMutation({
+    mutationFn: (variables: { workspaceId: string }) => bulkDeleteUnusedTags(variables),
+    onSuccess: () => queryClient.invalidateQueries({ queryKey: tagKeys.list(workspaceId) }),
+  });
+};
