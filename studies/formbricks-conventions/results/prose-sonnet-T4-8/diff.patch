@@ -8,6 +8,41 @@ import { isPrismaKnownRequestError, isUniqueConstraintError } from "@/lib/utils/
 import { validateInputs } from "@/lib/utils/validate";
 import { TagError } from "@/modules/workspaces/settings/types/tag";
 
+/**
+ * Deletes every tag of the workspace that no response carries. "Unused" is judged on the database, not on
+ * the visibility-filtered counts the list shows: a tag applied only to a restricted survey's responses
+ * still counts as used. The `responses: none` guard is repeated on the delete, so a tag applied between
+ * the read and the delete survives.
+ */
+export const deleteUnusedTags = async (
+  workspaceId: string
+): Promise<Result<{ deletedTagIds: string[] }, { code: TagError; message: string }>> => {
+  validateInputs([workspaceId, ZId]);
+
+  try {
+    const unusedWhere = { workspaceId, responses: { none: {} } };
+    const candidates = await prisma.tag.findMany({ where: unusedWhere, select: { id: true } });
+    if (candidates.length === 0) return ok({ deletedTagIds: [] });
+
+    const candidateIds = candidates.map((tag) => tag.id);
+    await prisma.tag.deleteMany({ where: { ...unusedWhere, id: { in: candidateIds } } });
+
+    // `deleteMany` only reports a count, so re-read to learn which candidates are really gone.
+    const survivors = await prisma.tag.findMany({
+      where: { id: { in: candidateIds } },
+      select: { id: true },
+    });
+    const survivorIds = new Set(survivors.map((tag) => tag.id));
+
+    return ok({ deletedTagIds: candidateIds.filter((id) => !survivorIds.has(id)) });
+  } catch (error) {
+    return err({
+      code: TagError.UNEXPECTED_ERROR,
+      message: error instanceof Error ? error.message : "Unknown error occurred",
+    });
+  }
+};
