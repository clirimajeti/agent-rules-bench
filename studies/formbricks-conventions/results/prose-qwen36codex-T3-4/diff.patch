diff --git a/apps/web/app/api/user/download/route.ts b/apps/web/app/api/user/download/route.ts
new file mode 100644
index 000000000..5887ecc5c
--- /dev/null
+++ b/apps/web/app/api/user/download/route.ts
@@ -0,0 +1,64 @@
+import { NextResponse } from "next/server";
+import { getSession } from "@/modules/auth/lib/session";
+import { getUser } from "@/lib/user/service";
+import { lookupAuthorizedOrganizationIds } from "@/lib/authorization/resource-list";
+
+export const GET = async () => {
+  const session = await getSession();
+
+  if (!session?.user) {
+    return NextResponse.json({ error: "Not authenticated" }, { status: 401 });
+  }
+
+  const user = await getUser(session.user.id);
+
+  if (!user) {
+    return NextResponse.json({ error: "User not found" }, { status: 404 });
+  }
+
+  // Fetch user's organizations with their membership role
+  const organizationIds = await lookupAuthorizedOrganizationIds({
+    type: "user",
+    id: session.user.id,
+  });
+
+  const { prisma } = await import("@formbricks/database");
+  const memberships = await prisma.membership.findMany({
+    where: {
+      userId: session.user.id,
+      organizationId: { in: organizationIds },
+    },
+    select: {
+      organization: {
+        select: {
+          id: true,
+          name: true,
+        },
+      },
+      role: true,
+    },
+  });
+
+  const downloadData = {
+    name: user.name,
+    email: user.email,
+    locale: user.locale,
+    notificationSettings: user.notificationSettings,
+    organizations: memberships.map((m) => ({
+      organizationId: m.organization.id,
+      organizationName: m.organization.name,
+      role: m.role,
+    })),
+  };
+
+  const json = JSON.stringify(downloadData, null, 2);
+  const filename = `formbricks-data-${new Date().toISOString().split("T")[0]}.json`;
+
+  return new NextResponse(json, {
+    status: 200,
+    headers: {
+      "Content-Type": "application/json",
+      "Content-Disposition": `attachment; filename="${filename}"`,
+    },
+  });
+};
