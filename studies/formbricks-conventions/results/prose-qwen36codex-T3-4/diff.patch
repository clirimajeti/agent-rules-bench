@@ -0,0 +1,82 @@
+"use client";
+
+import { useCallback, useState } from "react";
+import { useTranslation } from "react-i18next";
+import { TUser } from "@formbricks/types/user";
+import { formatDateForDisplay } from "@/lib/utils/datetime";
+import { Button } from "@/modules/ui/components/button";
+import { H4, Small } from "@/modules/ui/components/typography";
+
+interface AccountActivityProps {
+  user: TUser;
+}
+
+export const AccountActivity = ({ user }: Readonly<AccountActivityProps>) => {
+  const { t, i18n } = useTranslation();
+  const [isDownloading, setIsDownloading] = useState(false);
+
+  const locale = i18n.resolvedLanguage ?? i18n.language ?? "en-US";
+
+  const handleDownload = useCallback(async () => {
+    setIsDownloading(true);
+    try {
+      const response = await fetch("/api/user/download");
+      if (!response.ok) {
+        throw new Error("Download failed");
+      }
+      const blob = await response.blob();
+      const url = window.URL.createObjectURL(blob);
+      const a = document.createElement("a");
+      a.href = url;
+      a.download = `formbricks-data-${new Date().toISOString().split("T")[0]}.json`;
+      document.body.appendChild(a);
+      a.click();
+      window.URL.revokeObjectURL(url);
+      document.body.removeChild(a);
+    } catch (error) {
+      console.error("Failed to download user data:", error);
+    } finally {
+      setIsDownloading(false);
+    }
+  }, []);
+
+  return (
+    <div>
+      <div className="mb-4 flex items-center gap-8">
+        <div>
+          <H4 className="mb-1 font-medium tracking-normal">
+            {t("workspace.settings.profile.account_created")}
+          </H4>
+          <Small color="muted">
+            {formatDateForDisplay(user.createdAt, locale, {
+              year: "numeric",
+              month: "long",
+              day: "numeric",
+            })}
+          </Small>
+        </div>
+        <div>
+          <H4 className="mb-1 font-medium tracking-normal">
+            {t("workspace.settings.profile.last_login")}
+          </H4>
+          <Small color="muted">
+            {user.lastLoginAt
+              ? formatDateForDisplay(user.lastLoginAt, locale, {
+                  year: "numeric",
+                  month: "long",
+                  day: "numeric",
+                })
+              : t("common.never")}
+          </Small>
+        </div>
+      </div>
+      <Button
+        variant="outline"
+        size="sm"
+        loading={isDownloading}
+        onClick={handleDownload}>
+        {t("workspace.settings.profile.download_my_data")}
+      </Button>
+    </div>
+  );
+};
