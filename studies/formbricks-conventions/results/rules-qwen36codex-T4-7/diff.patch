@@ -43,3 +43,11 @@ export async function mergeTags(params: { tagId: string; newTagId: string }): Pr
     body: JSON.stringify({ newTagId: params.newTagId }),
   });
 }
+
+export async function deleteUnusedTags(params: { workspaceId: string; signal?: AbortSignal }): Promise<{ deletedCount: number }> {
+  const query = new URLSearchParams({ workspaceId: params.workspaceId });
+  return request<{ deletedCount: number }>(`${BASE_PATH}/delete-unused?${query.toString()}`, {
+    method: "POST",
+    signal: params.signal,
+  });
+}
