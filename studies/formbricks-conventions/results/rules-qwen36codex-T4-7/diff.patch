+/**
+ * POST /api/v3/tags/delete-unused — bulk-delete tags that are not used on any response.
+ *
+ * Session-only (same rationale as the parent tags route).
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { deleteUnusedTags } from "./lib/operations";
+
+export const POST = withV3ApiWrapper({
+  auth: "session",
+  schemas: {},
+  handler: async ({ authentication, workspaceId, requestId, instance }) =>
+    deleteUnusedTags({
+      authentication,
+      workspaceId,
+      requestId,
+      instance,
+    }),
+});
