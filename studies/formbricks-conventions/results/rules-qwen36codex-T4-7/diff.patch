+import "server-only";
+import { requireV3WorkspaceAccess } from "@/app/api/v3/lib/auth";
+import { problemForbidden, successResponse } from "@/app/api/v3/lib/response";
+import type { TV3Authentication } from "@/app/api/v3/lib/types";
+import { getTagsByWorkspaceId } from "@/lib/tag/service";
+import { prisma } from "@formbricks/database";
+
+interface DeleteUnusedTagsParams {
+  authentication: TV3Authentication;
+  workspaceId: string;
+  requestId: string;
+  instance?: string;
+}
+
+/**
+ * Delete every tag in the workspace that has zero entries in the
+ * `tagsOnResponses` junction table.  Returns the count of deleted tags.
+ *
+ * Authorization is workspace-level (readWrite) because we are removing data.
+ */
+export async function deleteUnusedTags(
+  params: DeleteUnusedTagsParams
+): Promise<Response> {
+  const { authentication, workspaceId, requestId, instance } = params;
+
+  const access = await requireV3WorkspaceAccess(
+    authentication,
+    workspaceId,
+    "readWrite",
+    requestId,
+    instance
+  );
+  if (access instanceof Response) return access;
+
+  const tags = await getTagsByWorkspaceId(access.workspaceId);
+  if (!tags || tags.length === 0) {
+    return successResponse({ deletedCount: 0 }, { requestId });
+  }
+
+  const tagIds = tags.map((t) => t.id);
+
+  // Tags that have at least one response association.
+  const usedTagIds = await prisma.tagsOnResponses
+    .findMany({
+      where: { tagId: { in: tagIds } },
+      select: { tagId: true },
+      distinct: ["tagId"],
+    })
+    .then((rows) => new Set(rows.map((r) => r.tagId)));
+
+  const unusedTagIds = tagIds.filter((id) => !usedTagIds.has(id));
+
+  if (unusedTagIds.length === 0) {
+    return successResponse({ deletedCount: 0 }, { requestId });
+  }
+
+  // Delete the unused tags in one transaction.
+  const result = await prisma.$transaction([
+    // Remove all junction rows first (defensive; they should be empty).
+    prisma.tagsOnResponses.deleteMany({
+      where: { tagId: { in: unusedTagIds } },
+    }),
+    // Delete the tags themselves.
+    prisma.tag.deleteMany({
+      where: { id: { in: unusedTagIds } },
+    }),
+  ]);
+
+  return successResponse(
+    { deletedCount: result[1].count },
+    { requestId }
+  );
+}
