@@ -0,0 +1,78 @@
+get:
+  operationId: getAccountDataV3
+  # Session-only by design: the data belongs to the signed-in user, so an API key cannot read it.
+  x-excluded: true
+  summary: Get account data
+  description: |
+    Returns the signed-in user's account activity (creation and last login time) and personal data
+    (name, email, locale, notification settings and organization memberships).
+
+    Session cookie only. This endpoint backs the Account activity card on the profile settings page.
+  tags:
+    - V3 Account
+  responses:
+    "200":
+      description: Account data retrieved successfully
+      headers:
+        X-Request-Id:
+          schema:
+            type: string
+          description: Request correlation ID
+        Cache-Control:
+          schema:
+            type: string
+          example: private, no-store
+      content:
+        application/json:
+          schema:
+            type: object
+            required:
+              - data
+            properties:
+              data:
+                type: object
+                required:
+                  - name
+                  - email
+                  - locale
+                  - notificationSettings
+                  - createdAt
+                  - lastLoginAt
+                  - organizationMemberships
+                properties:
+                  name:
+                    type: string
+                  email:
+                    type: string
+                  locale:
+                    type: string
+                  notificationSettings:
+                    type: object
+                    additionalProperties: true
+                  createdAt:
+                    type: string
+                    format: date-time
+                  lastLoginAt:
+                    type: string
+                    format: date-time
+                    nullable: true
+                  organizationMemberships:
+                    type: array
+                    items:
+                      type: object
+                      required:
+                        - organizationName
+                        - role
+                      properties:
+                        organizationName:
+                          type: string
+                        role:
+                          type: string
+    "401":
+      $ref: ../components/responses/V3UnauthorizedSession.yml
+    "429":
+      $ref: ../components/responses/V3TooManyRequests.yml
+    "500":
+      $ref: ../components/responses/V3InternalServerError.yml
+  security:
+    - sessionAuth: []
