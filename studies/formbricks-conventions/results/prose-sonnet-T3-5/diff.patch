@@ -0,0 +1,72 @@
+"use client";
+
+import { useQuery } from "@tanstack/react-query";
+import { DownloadIcon } from "lucide-react";
+import { useTranslation } from "react-i18next";
+import { formatDateTimeForDisplay } from "@/lib/utils/datetime";
+import { getV3ApiErrorMessage } from "@/modules/api/lib/v3-client";
+import { Button } from "@/modules/ui/components/button";
+import { Skeleton } from "@/modules/ui/components/skeleton";
+import { accountDataKeys, buildAccountDataExport, getAccountData } from "../lib/account-data-client";
+
+const formatDateTime = (iso: string, locale: string) => formatDateTimeForDisplay(new Date(iso), locale);
+
+export const AccountActivity = () => {
+  const { t, i18n } = useTranslation();
+  const { data, isPending, isError, error } = useQuery({
+    queryKey: accountDataKeys.all,
+    queryFn: getAccountData,
+  });
+
+  const handleDownload = () => {
+    if (!data) return;
+    const blob = new Blob([JSON.stringify(buildAccountDataExport(data), null, 2)], {
+      type: "application/json",
+    });
+    const url = URL.createObjectURL(blob);
+    const link = document.createElement("a");
+    link.href = url;
+    link.download = "formbricks-account-data.json";
+    document.body.appendChild(link);
+    link.click();
+    link.remove();
+    URL.revokeObjectURL(url);
+  };
+
+  if (isError) {
+    return (
+      <p className="text-sm text-red-600">
+        {getV3ApiErrorMessage(error, t("workspace.settings.profile.account_activity_load_failed"))}
+      </p>
+    );
+  }
+
+  return (
+    <div className="space-y-4">
+      <dl className="grid grid-cols-1 gap-4 sm:grid-cols-2">
+        <div>
+          <dt className="text-sm text-slate-500">{t("workspace.settings.profile.account_created")}</dt>
+          <dd className="text-sm font-medium text-slate-900">
+            {isPending ? <Skeleton className="h-5 w-40" /> : formatDateTime(data.createdAt, i18n.language)}
+          </dd>
+        </div>
+        <div>
+          <dt className="text-sm text-slate-500">{t("workspace.settings.profile.last_login")}</dt>
+          <dd className="text-sm font-medium text-slate-900">
+            {isPending ? (
+              <Skeleton className="h-5 w-40" />
+            ) : data.lastLoginAt ? (
+              formatDateTime(data.lastLoginAt, i18n.language)
+            ) : (
+              t("workspace.settings.profile.never_logged_in")
+            )}
+          </dd>
+        </div>
+      </dl>
+      <Button variant="secondary" onClick={handleDownload} disabled={isPending}>
+        <DownloadIcon className="size-4" />
+        {t("workspace.settings.profile.download_my_data")}
+      </Button>
+    </div>
+  );
+};
diff --git a/apps/web/app/(app)/workspaces/[workspaceId]/settings/account/profile/lib/account-data-client.ts b/apps/web/app/(app)/workspaces/[workspaceId]/settings/account/profile/lib/account-data-client.ts
