@@ -0,0 +1,14 @@
+/**
+ * GET /api/v3/account-data - the signed-in user's account activity and personal data.
+ *
+ * Session-only, deliberately: the data belongs to the session user and nobody else, so an API key
+ * (which is workspace-scoped) has no business reading it.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { getV3AccountData } from "./lib/operations";
+
+export const GET = withV3ApiWrapper({
+  auth: "session",
+  handler: async ({ authentication, requestId, instance }) =>
+    getV3AccountData({ authentication, requestId, instance }),
+});
