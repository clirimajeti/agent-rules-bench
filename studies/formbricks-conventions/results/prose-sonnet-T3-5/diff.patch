@@ -0,0 +1,56 @@
+import "server-only";
+import { prisma } from "@formbricks/database";
+import { problemInternalError, problemUnauthorized, successResponse } from "@/app/api/v3/lib/response";
+import type { TV3Authentication } from "@/app/api/v3/lib/types";
+
+type TParams = {
+  authentication: TV3Authentication;
+  requestId: string;
+  instance?: string;
+};
+
+/**
+ * The user id always comes from the session, never from the request, so a caller can only ever read
+ * their own data. Only accepted memberships are listed: a pending invite is not a membership yet.
+ */
+export async function getV3AccountData({ authentication, requestId, instance }: TParams): Promise<Response> {
+  if (!authentication || !("user" in authentication) || !authentication.user?.id) {
+    return problemUnauthorized(requestId, "Session required", instance);
+  }
+
+  const user = await prisma.user.findUnique({
+    where: { id: authentication.user.id },
+    select: {
+      name: true,
+      email: true,
+      locale: true,
+      notificationSettings: true,
+      createdAt: true,
+      lastLoginAt: true,
+      memberships: {
+        where: { accepted: true },
+        select: { role: true, organization: { select: { name: true } } },
+      },
+    },
+  });
+
+  if (!user) {
+    return problemInternalError(requestId, "Unable to load account data", instance);
+  }
+
+  return successResponse(
+    {
+      name: user.name,
+      email: user.email,
+      locale: user.locale,
+      notificationSettings: user.notificationSettings,
+      createdAt: user.createdAt.toISOString(),
+      lastLoginAt: user.lastLoginAt?.toISOString() ?? null,
+      organizationMemberships: user.memberships.map((membership) => ({
+        organizationName: membership.organization.name,
+        role: membership.role,
+      })),
+    },
+    { requestId }
+  );
+}
