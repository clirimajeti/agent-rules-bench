@@ -0,0 +1,35 @@
+import { parseV3ApiError } from "@/modules/api/lib/v3-client";
+
+export type TAccountData = {
+  name: string;
+  email: string;
+  locale: string;
+  notificationSettings: unknown;
+  createdAt: string;
+  lastLoginAt: string | null;
+  organizationMemberships: { organizationName: string; role: string }[];
+};
+
+export const accountDataKeys = {
+  all: ["account-data"] as const,
+};
+
+export async function getAccountData(): Promise<TAccountData> {
+  const response = await fetch("/api/v3/account-data");
+  if (!response.ok) {
+    throw await parseV3ApiError(response);
+  }
+  const body = (await response.json()) as { data: TAccountData };
+  return body.data;
+}
+
+/** The downloaded file holds the personal data only, not the activity timestamps shown in the card. */
+export function buildAccountDataExport(data: TAccountData) {
+  return {
+    name: data.name,
+    email: data.email,
+    locale: data.locale,
+    notificationSettings: data.notificationSettings,
+    organizationMemberships: data.organizationMemberships,
+  };
+}
