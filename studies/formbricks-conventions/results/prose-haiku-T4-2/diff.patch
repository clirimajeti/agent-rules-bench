@@ -0,0 +1,59 @@
+post:
+  operationId: deleteUnusedTagsV3
+  # Session-only by design, so an API-key caller reading the published reference would only ever get a
+  # 401. Excluded from the generated docs pages until ENG-2533 decides between dropping the paths
+  # and opening them to API keys; the operation stays in the bundle for the contract tests.
+  x-excluded: true
+  summary: Delete unused tags
+  description: |
+    Deletes every tag of the workspace that no response carries, and answers how many were deleted.
+
+    The check covers all responses in the workspace, not only the ones the caller can read, so a tag used
+    on a response the caller cannot see is kept. Requires write access to the workspace.
+  tags:
+    - V3 Tags
+  requestBody:
+    required: true
+    content:
+      application/json:
+        schema:
+          type: object
+          additionalProperties: false
+          required:
+            - workspaceId
+          properties:
+            workspaceId:
+              type: string
+              format: cuid2
+              description: Workspace identifier. This is the canonical container ID for v3 APIs.
+  responses:
+    "200":
+      description: Unused tags deleted
+      content:
+        application/json:
+          schema:
+            type: object
+            required:
+              - data
+            properties:
+              data:
+                type: object
+                required:
+                  - count
+                properties:
+                  count:
+                    type: integer
+                    minimum: 0
+                    description: Number of tags deleted.
+    "400":
+      $ref: ../components/responses/V3BadRequest.yml
+    "401":
+      $ref: ../components/responses/V3UnauthorizedSession.yml
+    "403":
+      $ref: ../components/responses/V3Forbidden.yml
+    "429":
+      $ref: ../components/responses/V3TooManyRequests.yml
+    "500":
+      $ref: ../components/responses/V3InternalServerError.yml
+  security:
+    - sessionAuth: []
