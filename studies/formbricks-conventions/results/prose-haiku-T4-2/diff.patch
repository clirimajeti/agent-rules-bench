+/**
+ * Deletes every tag of the workspace that no response carries. The check runs against all responses in
+ * the workspace, not the caller's visible subset, so a tag used on a response the caller cannot read is
+ * kept. The filter and the delete are one statement, so a tag applied concurrently is not removed.
+ */
+export const deleteUnusedTags = async (
+  workspaceId: string
+): Promise<Result<{ count: number }, { code: TagError; message: string }>> => {
+  validateInputs([workspaceId, ZId]);
+
+  try {
+    const result = await prisma.tag.deleteMany({
+      where: {
+        workspaceId,
+        responses: { none: {} },
+      },
+    });
+
+    return ok({ count: result.count });
+  } catch (error) {
+    return err({
+      code: TagError.UNEXPECTED_ERROR,
+      message: error instanceof Error ? error.message : "Unknown error occurred",
+    });
+  }
+};
