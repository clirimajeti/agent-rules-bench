+import type { TApiKeyWithEnvironmentPermission } from "@/modules/organization/settings/api-keys/types/api-keys";
+
+/**
+ * A rotated key as the API returns it. `actualKey` is the new plaintext secret, returned once and stored
+ * nowhere, so the client has to show it straight away. Dates are ISO strings: this is JSON.
+ */
+export type TRotatedApiKey = {
+  id: string;
+  label: string;
+  createdAt: string;
+  lastUsedAt: string | null;
+  organizationAccess: TApiKeyWithEnvironmentPermission["organizationAccess"];
+  apiKeyWorkspaces: TApiKeyWithEnvironmentPermission["apiKeyWorkspaces"];
+  actualKey: string;
+};
+
+export const serializeRotatedApiKey = (
+  apiKey: TApiKeyWithEnvironmentPermission & { actualKey: string }
+): TRotatedApiKey => ({
+  id: apiKey.id,
+  label: apiKey.label,
+  createdAt: apiKey.createdAt.toISOString(),
+  lastUsedAt: apiKey.lastUsedAt?.toISOString() ?? null,
+  organizationAccess: apiKey.organizationAccess,
+  apiKeyWorkspaces: apiKey.apiKeyWorkspaces,
+  actualKey: apiKey.actualKey,
+});
