@@ -0,0 +1,54 @@
+import "server-only";
+import { ResourceNotFoundError } from "@formbricks/types/errors";
+import { getV3AuthorizationActor } from "@/app/api/v3/lib/auth";
+import { problemForbidden, problemUnauthorized, successResponse } from "@/app/api/v3/lib/response";
+import type { TV3AuditLog, TV3Authentication } from "@/app/api/v3/lib/types";
+import { can } from "@/lib/authorization";
+import { getOrganizationIdFromApiKeyId } from "@/lib/utils/helper";
+import { rotateApiKey } from "@/modules/organization/settings/api-keys/lib/api-key";
+import { serializeRotatedApiKey } from "../serializers";
+
+/**
+ * Replace the secret of `apiKeyId`, keeping its label and access. Asks the question `updateApiKeyAction`
+ * asks (`apiKey.manage` on the key), so whoever may edit a key may rotate it and nobody else can. A
+ * missing key and one the caller may not manage get the same 403, so the route cannot probe which keys
+ * exist. Rotating hands out no new access, which is why the organization-access floor that creating a
+ * key needs is not asked again here. The audit entry never carries the secret.
+ */
+export async function rotateApiKeyOperation({
+  authentication,
+  apiKeyId,
+  requestId,
+  instance,
+  auditLog,
+}: {
+  authentication: TV3Authentication;
+  apiKeyId: string;
+  requestId: string;
+  instance?: string;
+  auditLog?: TV3AuditLog;
+}): Promise<Response> {
+  const actor = getV3AuthorizationActor(authentication);
+  if (actor?.type !== "user") {
+    return problemUnauthorized(requestId, "Session required", instance);
+  }
+  if (auditLog) auditLog.targetId = apiKeyId;
+
+  let organizationId: string;
+  try {
+    organizationId = await getOrganizationIdFromApiKeyId(apiKeyId);
+  } catch (error) {
+    if (error instanceof ResourceNotFoundError) return problemForbidden(requestId, undefined, instance);
+    throw error;
+  }
+
+  if (!(await can(actor, "apiKey.manage", { type: "apiKey", id: apiKeyId }))) {
+    return problemForbidden(requestId, undefined, instance);
+  }
+  if (auditLog) auditLog.organizationId = organizationId;
+
+  const rotated = await rotateApiKey(apiKeyId);
+  if (auditLog) auditLog.newObject = { apiKeyId, rotated: true };
+
+  return successResponse(serializeRotatedApiKey(rotated), { requestId });
+}
