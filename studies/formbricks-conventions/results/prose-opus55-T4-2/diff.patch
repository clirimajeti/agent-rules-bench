+/**
+ * Deletes every tag of the workspace that no response carries.
+ *
+ * "Unused" is checked against all responses, not the ones a caller may see: a tag that only sits on
+ * responses hidden from the caller is still in use and must survive.
+ *
+ * The delete repeats the `none` filter instead of trusting the ids read before it, so a tag applied to
+ * a response between the read and the delete is kept.
+ */
+export const deleteUnusedTags = async (
+  workspaceId: string
+): Promise<
+  Result<
+    { deleted: number; tags: Pick<TTag, "id" | "name">[] },
+    { code: TagError; message: string; meta?: Record<string, string> }
+  >
+> => {
+  validateInputs([workspaceId, ZId]);
+
+  const unusedTagWhere = { workspaceId, responses: { none: {} } };
+
+  try {
+    const result = await prisma.$transaction(async (tx) => {
+      const tags = await tx.tag.findMany({
+        where: unusedTagWhere,
+        select: { id: true, name: true },
+      });
+
+      if (tags.length === 0) {
+        return { deleted: 0, tags };
+      }
+
+      const { count } = await tx.tag.deleteMany({
+        where: { ...unusedTagWhere, id: { in: tags.map((tag) => tag.id) } },
+      });
+
+      return { deleted: count, tags };
+    });
+
+    return ok(result);
+  } catch (error) {
+    return err({
+      code: TagError.UNEXPECTED_ERROR,
+      message: error instanceof Error ? error.message : "Unknown error occurred",
+    });
+  }
+};
