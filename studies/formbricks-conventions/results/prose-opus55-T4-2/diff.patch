+/**
+ * Unlike the single-tag mutations there is no tag to resolve the workspace from, so `workspaceId` is the
+ * scope. That is safe because the same value is what `readWrite` is checked against and what the delete
+ * is filtered by: the two cannot diverge.
+ */
+export async function deleteUnusedV3Tags(
+  params: TBaseParams & { workspaceId: string; auditLog?: TV3AuditLog }
+): Promise<Response> {
+  const { authentication, workspaceId, auditLog, requestId, instance } = params;
+
+  const access = await requireV3WorkspaceAccess(
+    authentication,
+    workspaceId,
+    "readWrite",
+    requestId,
+    instance
+  );
+  if (access instanceof Response) return access;
+
+  if (auditLog) {
+    auditLog.organizationId = access.organizationId;
+    auditLog.targetId = access.workspaceId;
+  }
+
+  const result = await deleteUnusedTags(access.workspaceId);
+  if (!result.ok) {
+    return problemInternalError(requestId, "Unable to delete unused tags", instance);
+  }
+
+  if (auditLog) {
+    // Identity only, like the responses batch delete: the ids and names make the purge reviewable
+    // without putting full rows in a log line.
+    auditLog.oldObject = {
+      workspaceId: access.workspaceId,
+      deleted: result.data.deleted,
+      tags: result.data.tags,
+    };
+  }
+
+  return successResponse({ deleted: result.data.deleted }, { requestId });
+}
