new file mode 100644
index 000000000..274cef768
--- /dev/null
+++ b/docs/api-v3-reference/src/paths/api_v3_tags_delete-unused.yml
@@ -0,0 +1,63 @@
+post:
+  operationId: deleteUnusedTagsV3
+  # Session-only by design, so an API-key caller reading the published reference would only ever get a
+  # 401. Excluded from the generated docs pages until ENG-2533 decides between dropping the paths
+  # and opening them to API keys; the operation stays in the bundle for the contract tests.
+  x-excluded: true
+  summary: Delete unused tags
+  description: |
+    Deletes every tag of the workspace that no response carries, and reports how many tags were deleted.
+
+    A tag is unused only when no response in the workspace carries it, including responses the caller
+    cannot see. A tag that is applied to a response while this call runs is kept.
+
+    **A POST custom method, not a `DELETE` on the collection.** A collection-level `DELETE` that loses
+    its query string degrades into erasing every tag in scope. A distinct path cannot be reached by
+    accident.
+
+    Requires `readWrite` access to the workspace, the same as rename, delete and merge.
+  tags:
+    - V3 Tags
+  parameters:
+    - $ref: ../components/parameters/WorkspaceIdQuery.yml
+  responses:
+    "200":
+      description: >-
+        Unused tags deleted. `deleted` counts the tags actually removed, which can be zero.
+      headers:
+        X-Request-Id:
+          schema:
+            type: string
+          description: Request correlation ID
+        Cache-Control:
+          schema:
+            type: string
+          example: private, no-store
+      content:
+        application/json:
+          schema:
+            type: object
+            required:
+              - data
+            properties:
+              data:
+                type: object
+                required:
+                  - deleted
+                properties:
+                  deleted:
+                    type: integer
+                    minimum: 0
+                    description: Number of tags deleted.
+    "400":
+      $ref: ../components/responses/V3BadRequest.yml
+    "401":
+      $ref: ../components/responses/V3UnauthorizedSession.yml
+    "403":
+      $ref: ../components/responses/V3Forbidden.yml
+    "429":
+      $ref: ../components/responses/V3TooManyRequests.yml
+    "500":
+      $ref: ../components/responses/V3InternalServerError.yml
+  security:
+    - sessionAuth: []
