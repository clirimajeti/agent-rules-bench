--- /dev/null
+++ b/apps/web/app/api/v3/api-keys/lib/operations.ts
@@ -0,0 +1,65 @@
+import "server-only";
+import { assertCan } from "@/lib/authorization";
+import { problemForbidden, successResponse } from "@/app/api/v3/lib/response";
+import { getV3SessionUserId } from "@/app/api/v3/lib/auth";
+import type { TV3AuditLog, TV3Authentication } from "@/app/api/v3/lib/types";
+import { assertCanGrantOrganizationAccess } from "@/modules/organization/settings/api-keys/lib/organization-access";
+import {
+  getApiKeyRotationScope,
+  rotateApiKey,
+} from "@/modules/organization/settings/api-keys/lib/api-key";
+
+type TRotateParams = {
+  authentication: TV3Authentication;
+  apiKeyId: string;
+  auditLog?: TV3AuditLog;
+  requestId: string;
+  instance?: string;
+};
+
+/**
+ * Replaces an organization API key's secret. The authorization matches the server action it replaces:
+ * `apiKey.manage` on the key, plus the organization's user-management floor for a key that carries
+ * organization write access, so rotating a key cannot hand out a grant the caller could not create.
+ *
+ * An unknown key answers 403, not 404, matching the tag and survey routes: a 404 would let any signed-in
+ * user probe key ids across the instance.
+ *
+ * The new secret is returned once in the response and is never written to the audit log.
+ */
+export async function rotateV3ApiKey(params: TRotateParams): Promise<Response> {
+  const { authentication, apiKeyId, auditLog, requestId, instance } = params;
+
+  const userId = getV3SessionUserId(authentication);
+  if (!userId) {
+    return problemForbidden(requestId, "You are not authorized to access this resource", instance);
+  }
+
+  const scope = await getApiKeyRotationScope(apiKeyId);
+  if (!scope) {
+    return problemForbidden(requestId, "You are not authorized to access this resource", instance);
+  }
+
+  await assertCan({ type: "user", id: userId }, "apiKey.manage", { type: "apiKey", id: apiKeyId });
+  await assertCanGrantOrganizationAccess(userId, scope.organizationId, scope.organizationAccess);
+
+  if (auditLog) {
+    auditLog.organizationId = scope.organizationId;
+    auditLog.targetId = apiKeyId;
+  }
+
+  const rotated = await rotateApiKey(apiKeyId);
+
+  if (auditLog) {
+    auditLog.newObject = { id: rotated.id, label: rotated.label, rotated: true };
+  }
+
+  return successResponse(
+    {
+      id: rotated.id,
+      apiKey: rotated.actualKey,
+      lastUsedAt: rotated.lastUsedAt,
+    },
+    { requestId }
+  );
+}
