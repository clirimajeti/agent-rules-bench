+/**
+ * Generates a fresh secret and its two stored hashes. The plaintext leaves this module only as `actualKey`,
+ * returned once to the caller that created or rotated the key.
+ */
+const issueApiKeySecret = async (): Promise<{ actualKey: string; lookupHash: string; hashedKey: string }> => {
+  // Generate a secure random secret (32 bytes base64url)
+  const secret = randomBytes(32).toString("base64url");
+
+  // Hybrid approach for security + performance:
+  // 1. SHA-256 lookup hash
+  const lookupHash = hashSha256(secret);
+
+  // 2. bcrypt hash
+  const hashedKey = await hashSecret(secret, 12);
+
+  return { actualKey: `fbk_${secret}`, lookupHash, hashedKey };
+};
+
+/**
+ * The scope a rotation is authorized against: the owning organization and the access the key already
+ * carries. Read before rotating so the caller can apply the same grant check as creation.
+ */
+export const getApiKeyRotationScope = reactCache(
+  async (apiKeyId: string): Promise<{ organizationId: string; organizationAccess: TOrganizationAccess } | null> => {
+    validateInputs([apiKeyId, ZId]);
+
+    const apiKey = await prisma.apiKey.findUnique({
+      where: { id: apiKeyId },
+      select: { organizationId: true, organizationAccess: true },
+    });
+    if (!apiKey) return null;
+
+    return {
+      organizationId: apiKey.organizationId,
+      organizationAccess: apiKey.organizationAccess as TOrganizationAccess,
+    };
+  }
+);
+
+/**
+ * Replaces a key's secret and keeps everything else: its id, label, organization access and workspace
+ * permissions. The old secret stops authenticating as soon as this commits. `lastUsedAt` is cleared
+ * because it recorded use of the old secret, and the new one has not been used yet.
+ */
+export const rotateApiKey = async (
+  apiKeyId: string
+): Promise<Pick<ApiKey, "id" | "label" | "createdAt" | "organizationAccess"> & { lastUsedAt: null; actualKey: string }> => {
+  validateInputs([apiKeyId, ZId]);
+
+  const { actualKey, lookupHash, hashedKey } = await issueApiKeySecret();
+
+  try {
+    const updated = await prisma.apiKey.update({
+      where: { id: apiKeyId },
+      data: { hashedKey, lookupHash, lastUsedAt: null },
+      select: { id: true, label: true, createdAt: true, organizationAccess: true },
+    });
+
+    return { ...updated, lastUsedAt: null, actualKey };
