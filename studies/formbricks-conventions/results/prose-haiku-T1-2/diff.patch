@@ -0,0 +1,24 @@
+import { parseV3ApiError } from "@/modules/api/lib/v3-client";
+
+const MUTATION_TIMEOUT_MS = 15_000;
+
+export type TRotatedApiKey = {
+  id: string;
+  /** The new secret in `fbk_{secret}` form. Returned once; it is not stored in plaintext. */
+  apiKey: string;
+  lastUsedAt: null;
+};
+
+/** Replaces an API key's secret. The old secret stops working as soon as this resolves. */
+export const rotateApiKeyRequest = async (apiKeyId: string): Promise<TRotatedApiKey> => {
+  const response = await fetch(`/api/v3/api-keys/${encodeURIComponent(apiKeyId)}/rotate`, {
+    method: "POST",
+    cache: "no-store",
+    signal: AbortSignal.timeout(MUTATION_TIMEOUT_MS),
+  });
+
+  if (!response.ok) throw await parseV3ApiError(response);
+
+  const body = (await response.json()) as { data: TRotatedApiKey };
+  return body.data;
+};
