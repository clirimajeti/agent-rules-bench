+import type { Webhook } from "@formbricks/database/prisma";
+
+/**
+ * Public v3 webhook shape. `secret` is the signing secret webhook settings shows; the routes that return
+ * this shape are session-only and need workspace access, the same bar as the page that rendered it before.
+ */
+export type TV3Webhook = {
+  id: string;
+  name: string | null;
+  url: string;
+  source: Webhook["source"];
+  workspaceId: string;
+  triggers: Webhook["triggers"];
+  surveyIds: string[];
+  secret: string | null;
+  createdAt: string;
+  updatedAt: string;
+};
+
+export const serializeV3Webhook = (webhook: Webhook): TV3Webhook => ({
+  id: webhook.id,
+  name: webhook.name,
+  url: webhook.url,
+  source: webhook.source,
+  workspaceId: webhook.workspaceId,
+  triggers: webhook.triggers,
+  surveyIds: webhook.surveyIds,
+  secret: webhook.secret,
+  createdAt: webhook.createdAt.toISOString(),
+  updatedAt: webhook.updatedAt.toISOString(),
+});
