@@ -0,0 +1,59 @@
+post:
+  operationId: duplicateWebhookV3
+  # Session-only by design; excluded from the generated docs pages like the other webhook operations.
+  x-excluded: true
+  summary: Duplicate a webhook
+  description: |
+    Creates a webhook with the same URL, triggers and surveys, named "Copy of" plus the original name (or
+    the original URL when it has no name). The copy gets a signing secret of its own, shown in the webhook's
+    settings. The workspace is resolved from the webhook, so the caller cannot choose which scope it is
+    authorized against. Requires organization owner/manager, or a workspace team membership with
+    read-write permission.
+
+    An unknown `webhookId` answers `403`, not `404`, so webhook ids cannot be probed for existence.
+  tags:
+    - V3 Webhooks
+  parameters:
+    - in: path
+      name: webhookId
+      required: true
+      schema:
+        type: string
+        format: cuid2
+  responses:
+    "201":
+      description: The copy
+      headers:
+        X-Request-Id:
+          schema:
+            type: string
+          description: Request correlation ID
+        Cache-Control:
+          schema:
+            type: string
+          example: private, no-store
+        Location:
+          schema:
+            type: string
+          example: /api/v3/webhooks/clwebhook000000000000002
+      content:
+        application/json:
+          schema:
+            type: object
+            required:
+              - data
+            properties:
+              data:
+                $ref: ../components/schemas/WebhookResource.yml
+    "400":
+      $ref: ../components/responses/V3BadRequest.yml
+    "401":
+      $ref: ../components/responses/V3UnauthorizedSession.yml
+    "403":
+      $ref: ../components/responses/V3Forbidden.yml
+    "429":
+      $ref: ../components/responses/V3TooManyRequests.yml
+    "500":
+      $ref: ../components/responses/V3InternalServerError.yml
+  security:
+    - sessionAuth: []
