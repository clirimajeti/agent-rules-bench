@@ -0,0 +1,73 @@
+import "server-only";
+import { requireV3WorkspaceAccess } from "@/app/api/v3/lib/auth";
+import { createdResponse, problemForbidden, successResponse } from "@/app/api/v3/lib/response";
+import type { TV3AuditLog, TV3Authentication } from "@/app/api/v3/lib/types";
+import { assertNewlyAttachedSurveysWorkspaceVisible } from "@/lib/survey/visibility/outbound";
+import { createWebhook, getWebhookById, getWebhooks } from "@/modules/integrations/webhooks/lib/webhook";
+import { serializeV3Webhook } from "../serializers";
+
+type TBaseParams = {
+  authentication: TV3Authentication;
+  requestId: string;
+  instance?: string;
+};
+
+export async function listV3Webhooks(params: TBaseParams & { workspaceId: string }): Promise<Response> {
+  const { authentication, workspaceId, requestId, instance } = params;
+
+  const access = await requireV3WorkspaceAccess(authentication, workspaceId, "read", requestId, instance);
+  if (access instanceof Response) return access;
+
+  const webhooks = await getWebhooks(access.workspaceId);
+
+  return successResponse(webhooks.map(serializeV3Webhook), { requestId });
+}
+
+/**
+ * Copies a webhook's URL, triggers and surveys into a new webhook named "Copy of <name>" with a signing
+ * secret of its own (`createWebhook` generates one when none is passed).
+ *
+ * The workspace is resolved from the webhook, never from the request, so the caller cannot choose the scope
+ * it is authorized against. An unknown webhook answers 403, not 404, so ids cannot be probed.
+ */
+export async function duplicateV3Webhook(
+  params: TBaseParams & { webhookId: string; auditLog?: TV3AuditLog }
+): Promise<Response> {
+  const { authentication, webhookId, auditLog, requestId, instance } = params;
+
+  const original = await getWebhookById(webhookId);
+  if (!original) {
+    return problemForbidden(requestId, "You are not authorized to access this resource", instance);
+  }
+
+  const access = await requireV3WorkspaceAccess(
+    authentication,
+    original.workspaceId,
+    "readWrite",
+    requestId,
+    instance
+  );
+  if (access instanceof Response) return access;
+
+  await assertNewlyAttachedSurveysWorkspaceVisible(original.surveyIds);
+
+  const webhookInput = {
+    name: `Copy of ${original.name || original.url}`,
+    url: original.url,
+    triggers: original.triggers,
+    surveyIds: original.surveyIds,
+  };
+
+  const copy = await createWebhook(original.workspaceId, webhookInput);
+
+  if (auditLog) {
+    auditLog.organizationId = access.organizationId;
+    auditLog.targetId = copy.id;
+    auditLog.newObject = webhookInput;
+  }
+
+  return createdResponse(serializeV3Webhook(copy), {
+    location: `/api/v3/webhooks/${copy.id}`,
+    requestId,
+  });
+}
