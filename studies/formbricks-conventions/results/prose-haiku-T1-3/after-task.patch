+// Mints a new secret and derives the two stored hashes from it. The plaintext `actualKey` is only ever
+// returned to the caller that created or rotated the key; it is never persisted.
+const generateApiKeyMaterial = async (): Promise<{
+  actualKey: string;
+  lookupHash: string;
+  hashedKey: string;
+}> => {
+  // Generate a secure random secret (32 bytes base64url)
+  const secret = randomBytes(32).toString("base64url");
+
+  // Hybrid approach for security + performance:
+  // 1. SHA-256 lookup hash
+  // 2. bcrypt hash
+  return {
+    // Return the new v2 format: fbk_{secret}
+    actualKey: `fbk_${secret}`,
+    lookupHash: hashSha256(secret),
+    hashedKey: await hashSecret(secret, 12),
+  };
+};
