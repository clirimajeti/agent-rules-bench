+import { parseV3ApiError } from "@/modules/api/lib/v3-client";
+import type { TApiKeyWithEnvironmentPermission } from "@/modules/organization/settings/api-keys/types/api-keys";
+
+/**
+ * Client fetchers for the API key v3 routes. Every call throws a parsed `V3ApiError` on a non-2xx response,
+ * so the mutation can surface the server's own message.
+ */
+
+const BASE_PATH = "/api/v3/api-keys";
+
+/** The rotated key as it arrives over JSON: dates are ISO strings until converted back here. */
+type TRotateApiKeyWire = Omit<TApiKeyWithEnvironmentPermission, "createdAt" | "lastUsedAt"> & {
+  createdAt: string;
+  lastUsedAt: string | null;
+  actualKey: string;
+};
+
+export type TRotatedApiKey = TApiKeyWithEnvironmentPermission & { actualKey: string };
+
+export async function rotateApiKey(params: { apiKeyId: string }): Promise<TRotatedApiKey> {
+  const response = await fetch(`${BASE_PATH}/${params.apiKeyId}/rotate`, {
+    method: "POST",
+    cache: "no-store",
+  });
+  if (!response.ok) {
+    throw await parseV3ApiError(response);
+  }
+
+  const { data } = (await response.json()) as { data: TRotateApiKeyWire };
+  return {
+    ...data,
+    createdAt: new Date(data.createdAt),
+    lastUsedAt: data.lastUsedAt ? new Date(data.lastUsedAt) : null,
+  };
+}
