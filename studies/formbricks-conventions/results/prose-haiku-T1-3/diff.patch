+"use client";
+
+import { FilesIcon } from "lucide-react";
+import toast from "react-hot-toast";
+import { useTranslation } from "react-i18next";
+import { Alert, AlertTitle } from "@/modules/ui/components/alert";
+import { Button } from "@/modules/ui/components/button";
+import {
+  Dialog,
+  DialogBody,
+  DialogContent,
+  DialogFooter,
+  DialogHeader,
+  DialogTitle,
+} from "@/modules/ui/components/dialog";
+
+export interface RotatedApiKey {
+  label: string;
+  actualKey: string;
+}
+
+interface RotatedApiKeyModalProps {
+  rotatedApiKey: RotatedApiKey | null;
+  onClose: () => void;
+}
+
+/**
+ * Shows the secret produced by a rotation. The plaintext exists only in the parent's state while this
+ * dialog is open, so closing it (by any route) discards it for good.
+ */
+export const RotatedApiKeyModal = ({ rotatedApiKey, onClose }: Readonly<RotatedApiKeyModalProps>) => {
+  const { t } = useTranslation();
+
+  const copyToClipboard = async () => {
+    if (!rotatedApiKey) return;
+    try {
+      await navigator.clipboard.writeText(rotatedApiKey.actualKey);
+      toast.success(t("workspace.api_keys.api_key_copied_to_clipboard"));
+    } catch {
+      toast.error(t("workspace.api_keys.unable_to_copy_api_key"));
+    }
+  };
+
+  return (
+    <Dialog
+      open={rotatedApiKey !== null}
+      onOpenChange={(open) => {
+        if (!open) onClose();
+      }}>
+      <DialogContent>
+        <DialogHeader>
+          <DialogTitle className="px-1">{t("workspace.api_keys.new_api_key_title")}</DialogTitle>
+        </DialogHeader>
+        <DialogBody className="space-y-4 overflow-y-auto px-1 py-4">
+          <Alert variant="warning" role="status">
+            <AlertTitle>{t("workspace.api_keys.api_key_security_warning")}</AlertTitle>
+          </Alert>
+          <div className="flex items-center justify-between gap-2 rounded-md border border-slate-200 bg-slate-50 p-3">
+            <span className="font-mono text-sm break-all" data-testid="rotated-api-key">
+              {rotatedApiKey?.actualKey}
+            </span>
+            <Button
+              type="button"
+              size="sm"
+              variant="secondary"
+              onClick={() => void copyToClipboard()}
+              data-testid="copy-rotated-api-key">
+              <FilesIcon className="size-4" />
+              {t("common.copy")}
+            </Button>
+          </div>
+        </DialogBody>
+        <DialogFooter>
+          <Button type="button" onClick={onClose}>
+            {t("common.done")}
+          </Button>
+        </DialogFooter>
+      </DialogContent>
+    </Dialog>
+  );
+};
