index 000000000..86dcd8a8a
--- /dev/null
+++ b/apps/web/app/api/v3/api-keys/lib/operations.ts
@@ -0,0 +1,58 @@
+import "server-only";
+import { AuthorizationError, ResourceNotFoundError } from "@formbricks/types/errors";
+import { problemForbidden, problemUnauthorized, successResponse } from "@/app/api/v3/lib/response";
+import type { TV3AuditLog, TV3Authentication } from "@/app/api/v3/lib/types";
+import { assertCan } from "@/lib/authorization";
+import { getApiKey } from "@/lib/utils/services";
+import { rotateApiKey } from "@/modules/organization/settings/api-keys/lib/api-key";
+
+type TBaseParams = {
+  authentication: TV3Authentication;
+  requestId: string;
+  instance?: string;
+};
+
+/**
+ * Rotates an API key's secret. Session-only, matching the server action it replaces.
+ *
+ * The response carries the new `actualKey`, the only copy of the secret. It is returned to the caller and
+ * never written to the audit log: the audit entry records only the target and the organization.
+ *
+ * An unknown key answers 403, not 404, so a signed-in user cannot probe key ids across the instance.
+ */
+export async function rotateV3ApiKey(
+  params: TBaseParams & { apiKeyId: string; auditLog?: TV3AuditLog }
+): Promise<Response> {
+  const { authentication, apiKeyId, auditLog, requestId, instance } = params;
+
+  if (!authentication || !("user" in authentication) || !authentication.user?.id) {
+    return problemUnauthorized(requestId, "Session required", instance);
+  }
+  const userId = authentication.user.id;
+
+  const apiKey = await getApiKey(apiKeyId);
+  if (!apiKey) {
+    return problemForbidden(requestId, "You are not authorized to access this resource", instance);
+  }
+
+  try {
+    await assertCan({ type: "user", id: userId }, "apiKey.manage", {
+      type: "apiKey",
+      id: apiKeyId,
+    });
+  } catch (error) {
+    if (error instanceof AuthorizationError || error instanceof ResourceNotFoundError) {
+      return problemForbidden(requestId, "You are not authorized to access this resource", instance);
+    }
+    throw error;
+  }
+
+  if (auditLog) {
+    auditLog.organizationId = apiKey.organizationId;
+    auditLog.targetId = apiKeyId;
+  }
+
+  const rotated = await rotateApiKey(apiKeyId);
+
+  return successResponse(rotated, { requestId });
+}
