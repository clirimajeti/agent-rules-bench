+import { useMutation } from "@tanstack/react-query";
+import { rotateApiKey } from "@/modules/organization/settings/api-keys/lib/api-client";
+
+/**
+ * Rotate an API key's secret. The caller receives the new `actualKey` once, in the mutation result, and is
+ * responsible for showing it and then dropping it. No query is invalidated: the key list is still fed by
+ * the page's props, not a query.
+ */
+export const useRotateApiKey = () =>
+  useMutation({
+    mutationFn: (variables: { apiKeyId: string }) => rotateApiKey(variables),
+  });
