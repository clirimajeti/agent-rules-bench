+/**
+ * Deletes every tag of the workspace that no response carries. The "unused" check is part of the delete's
+ * own `where`, so a tag applied between a read and the delete cannot be removed. It deliberately ignores
+ * response visibility: a tag on a response the caller cannot see is still in use.
+ */
+export const deleteUnusedTags = async (
+  workspaceId: string
+): Promise<Result<{ count: number }, { code: TagError; message: string }>> => {
+  validateInputs([workspaceId, ZId]);
+
+  try {
+    const { count } = await prisma.tag.deleteMany({
+      where: { workspaceId, responses: { none: {} } },
+    });
+
+    return ok({ count });
+  } catch (error) {
+    return err({
+      code: TagError.UNEXPECTED_ERROR,
+      message: error instanceof Error ? error.message : "Unknown error occurred",
+    });
+  }
+};
