--- /dev/null
+++ b/docs/api-v3-reference/src/paths/api_v3_tags_delete-unused.yml
@@ -0,0 +1,64 @@
+post:
+  operationId: deleteUnusedTagsV3
+  # Session-only by design, like the other tag operations; see ENG-2533.
+  x-excluded: true
+  summary: Delete unused tags
+  description: |
+    Deletes every tag of the workspace that no response carries, and reports how many were deleted.
+
+    A tag counts as used when any response carries it, whether or not the caller may read that response.
+    The check is part of the delete itself, so a tag applied while the call runs is not removed.
+
+    A POST custom method rather than a `DELETE` on the collection, so the path cannot be reached by
+    accident. Same authorization as rename. Session cookie only.
+  tags:
+    - V3 Tags
+  parameters:
+    - in: query
+      name: workspaceId
+      required: true
+      schema:
+        type: string
+        format: cuid2
+      description: |
+        Workspace identifier. This is the canonical container ID for v3 APIs.
+  responses:
+    "200":
+      description: Unused tags deleted. `deleted` is `0` when every tag is in use.
+      headers:
+        X-Request-Id:
+          schema:
+            type: string
+          description: Request correlation ID
+        Cache-Control:
+          schema:
+            type: string
+          example: private, no-store
+      content:
+        application/json:
+          schema:
+            type: object
+            required:
+              - data
+            properties:
+              data:
+                type: object
+                required:
+                  - deleted
+                properties:
+                  deleted:
+                    type: integer
+                    minimum: 0
+                    description: How many tags were deleted.
+    "400":
+      $ref: ../components/responses/V3BadRequest.yml
+    "401":
+      $ref: ../components/responses/V3UnauthorizedSession.yml
+    "403":
+      $ref: ../components/responses/V3Forbidden.yml
+    "429":
+      $ref: ../components/responses/V3TooManyRequests.yml
+    "500":
+      $ref: ../components/responses/V3InternalServerError.yml
+  security:
+    - sessionAuth: []
