+/**
+ * POST /api/v3/tags/delete-unused — delete every tag of a workspace that no response carries.
+ *
+ * A POST custom method rather than a `DELETE` on the collection, for the same reason as
+ * `/api/v3/responses/batch-delete`: a distinct path cannot be reached by accident. Session-only, like the
+ * other tag routes.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { deleteUnusedV3Tags } from "../lib/operations";
+import { ZV3DeleteUnusedTagsQuery } from "../lib/schemas";
+
+export const POST = withV3ApiWrapper({
+  auth: "session",
+  action: "deleted",
+  targetType: "tag",
+  schemas: { query: ZV3DeleteUnusedTagsQuery },
+  handler: async ({ authentication, parsedInput, auditLog, requestId, instance }) =>
+    deleteUnusedV3Tags({
+      authentication,
+      workspaceId: parsedInput.query.workspaceId,
+      auditLog,
+      requestId,
+      instance,
+    }),
+});
