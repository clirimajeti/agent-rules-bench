@@ -0,0 +1,46 @@
+"use client";
+
+import { useState } from "react";
+import { toast } from "react-hot-toast";
+import { useTranslation } from "react-i18next";
+import { getV3ApiErrorMessage } from "@/modules/api/lib/v3-client";
+import { Button } from "@/modules/ui/components/button";
+import { DeleteDialog } from "@/modules/ui/components/delete-dialog";
+import { useDeleteUnusedTags } from "../hooks/use-delete-unused-tags";
+
+/**
+ * Exported so `page.tsx` can pass it as the `cta` slot on `SettingsCard`.
+ */
+export const DeleteUnusedTagsButton = ({ workspaceId }: Readonly<{ workspaceId: string }>) => {
+  const { t } = useTranslation();
+  const [open, setOpen] = useState(false);
+  const { mutate: deleteUnusedTags, isPending: isDeleting } = useDeleteUnusedTags(workspaceId);
+
+  const handleDelete = () => {
+    deleteUnusedTags(undefined, {
+      onSuccess: (data) => {
+        toast.success(t("workspace.tags.tags_deleted", { count: data.count }));
+        setOpen(false);
+      },
+      onError: (error) => {
+        toast.error(getV3ApiErrorMessage(error, t("common.something_went_wrong_please_try_again")));
+      },
+    });
+  };
+
+  return (
+    <>
+      <Button variant="secondary" size="sm" onClick={() => setOpen(true)}>
+        {t("workspace.tags.delete_unused_tags")}
+      </Button>
+      <DeleteDialog
+        open={open}
+        setOpen={setOpen}
+        deleteWhat={t("workspace.tags.delete_unused_tags")}
+        onDelete={handleDelete}
+        text={t("workspace.tags.delete_unused_tags_confirmation")}
+        isDeleting={isDeleting}
+      />
+    </>
+  );
+};
