+/**
+ * DELETE /api/v3/tags/delete — delete all unused tags of the caller's workspace.
+ *
+ * The workspace is resolved from the authenticated request, matching the existing tags list route.
+ * Session-only, matching the other tags endpoints.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { requireV3WorkspaceAccess } from "@/app/api/v3/lib/auth";
+import { problemInternalError, problemUnprocessableContent, successResponse } from "@/app/api/v3/lib/response";
+import { ZV3TagDeleteQuery } from "../lib/schemas";
+import { deleteUnusedTags } from "@/modules/workspaces/settings/lib/tag";
+
+export const DELETE = withV3ApiWrapper({
+  auth: "session",
+  schemas: { query: ZV3TagDeleteQuery },
+  handler: async ({ authentication, parsedInput, requestId, instance }) => {
+    const access = await requireV3WorkspaceAccess(
+      authentication,
+      parsedInput.query.workspaceId,
+      "readWrite",
+      requestId,
+      instance
+    );
+    if (access instanceof Response) return access;
+
+    const result = await deleteUnusedTags(access.workspaceId);
+    if (result.count === 0) {
+      return problemUnprocessableContent(requestId, "No unused tags to delete", {
+        instance,
+      });
+    }
+
+    return successResponse({ count: result.count }, { requestId });
+  },
+});
