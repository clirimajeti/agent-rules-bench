+export const deleteUnusedTags = async (
+  workspaceId: string
+): Promise<{ count: number }> => {
+  validateInputs([workspaceId, ZId]);
+
+  try {
+    // Get all tags for this workspace
+    const tags = await prisma.tag.findMany({
+      where: { workspaceId },
+      select: { id: true },
+    });
+
+    const tagIds = tags.map((t) => t.id);
+
+    if (tagIds.length === 0) {
+      return { count: 0 };
+    }
+
+    // Get tag IDs that are used on at least one response
+    const usedTagIds = await prisma.tagsOnResponses.groupBy({
+      by: ["tagId"],
+      where: {
+        tag: {
+          workspaceId,
+        },
+      },
+      _count: { _all: true },
+    });
+
+    const usedTagIdSet = new Set(usedTagIds.map((t) => t.tagId));
+
+    // Collect unused tag IDs
+    const unusedTagIds = tagIds
+      .filter((t) => !usedTagIdSet.has(t.id))
+      .map((t) => t.id);
+
+    if (unusedTagIds.length === 0) {
+      return { count: 0 };
+    }
+
+    // Delete unused tags (the cascade will delete TagsOnResponses entries)
+    await prisma.tag.deleteMany({
+      where: {
+        id: { in: unusedTagIds },
+      },
+    });
+
+    return { count: unusedTagIds.length };
+  } catch (error) {
+    throw error;
+  }
+};
