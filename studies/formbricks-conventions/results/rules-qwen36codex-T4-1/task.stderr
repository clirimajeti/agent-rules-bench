import { getSettingsPageMetadata } from "@/modules/settings/lib/metadata";
import { TagsPage } from "@/modules/workspaces/settings/tags/page-content";
import { getTranslate } from "@/lingodotdev/server";
import { getWorkspaceAuth } from "@/modules/workspaces/lib/utils";

export const generateMetadata = () => getSettingsPageMetadata("common.tags");

export default async function DefaultPage(props: { params: Promise<{ workspaceId: string }> }) {
  const params = await props.params;
  const { isReadOnly } = await getWorkspaceAuth(params.workspaceId);

  return <TagsPage workspaceId={params.workspaceId} isReadOnly={isReadOnly} />;
}
