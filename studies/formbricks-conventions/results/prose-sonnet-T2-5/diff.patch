@@ -0,0 +1,97 @@
+post:
+  operationId: duplicateWebhookV3
+  # Session-only by design: it backs the Duplicate button on the webhooks settings page. Excluded from the
+  # generated docs pages like the other session-only operations; it stays in the bundle for the contract tests.
+  x-excluded: true
+  summary: Duplicate a webhook
+  description: |
+    Creates a new webhook in the same workspace with the source webhook's URL, triggers and surveys.
+    The copy is named `Copy of ` followed by the source name (or the source URL when it has no name)
+    and receives its own newly generated signing secret. The source webhook is unchanged.
+
+    The signing secret is never part of the response.
+
+    Session cookie only.
+  tags:
+    - V3 Webhooks
+  parameters:
+    - in: path
+      name: webhookId
+      required: true
+      schema:
+        type: string
+        format: cuid2
+      description: The webhook to copy.
+  responses:
+    "201":
+      description: Webhook duplicated successfully
+      headers:
+        X-Request-Id:
+          schema:
+            type: string
+          description: Request correlation ID
+        Cache-Control:
+          schema:
+            type: string
