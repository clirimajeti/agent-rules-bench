@@ -0,0 +1,25 @@
+/**
+ * POST /api/v3/webhooks/{webhookId}/duplicate — copy a webhook with the same URL, triggers and surveys,
+ * under a new name and a newly generated signing secret.
+ *
+ * Session-only, deliberately: it backs the webhooks settings page, like the tags routes.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { ZV3EmptyQuery } from "@/app/api/v3/lib/schemas";
+import { duplicateV3Webhook } from "../../lib/operations";
+import { ZV3WebhookIdParams } from "../../lib/schemas";
+
+export const POST = withV3ApiWrapper({
+  auth: "session",
+  action: "created",
+  targetType: "webhook",
+  schemas: { params: ZV3WebhookIdParams, query: ZV3EmptyQuery },
+  handler: async ({ authentication, parsedInput, auditLog, requestId, instance }) =>
+    duplicateV3Webhook({
+      authentication,
+      webhookId: parsedInput.params.webhookId,
+      auditLog,
+      requestId,
+      instance,
+    }),
+});
diff --git a/apps/web/app/api/v3/webhooks/lib/operations.ts b/apps/web/app/api/v3/webhooks/lib/operations.ts
new file mode 100644
index 000000000..a04020681
--- /dev/null
+++ b/apps/web/app/api/v3/webhooks/lib/operations.ts
@@ -0,0 +1,82 @@
+import "server-only";
+import { prisma } from "@formbricks/database";
+import { logger } from "@formbricks/logger";
+import { InvalidInputError } from "@formbricks/types/errors";
+import { requireV3WorkspaceAccess } from "@/app/api/v3/lib/auth";
+import { mapV3ThrownError } from "@/app/api/v3/lib/errors";
+import { createdResponse, problemForbidden, problemUnprocessableContent } from "@/app/api/v3/lib/response";
+import type { TV3AuditLog, TV3Authentication } from "@/app/api/v3/lib/types";
+import { assertNewlyAttachedSurveysWorkspaceVisible } from "@/lib/survey/visibility/outbound";
+import { createWebhook } from "@/modules/integrations/webhooks/lib/webhook";
+import { serializeV3Webhook } from "../serializers";
+
+export const WEBHOOK_COPY_NAME_PREFIX = "Copy of ";
+
+/**
+ * `POST /api/v3/webhooks/{webhookId}/duplicate` → 201 `{ data }` with `Location`.
+ *
+ * The workspace is resolved from the source webhook, never from the client, so the caller cannot pair
+ * someone else's webhook id with a workspace they can write to. An unknown webhook answers 403, not 404,
+ * so the route cannot be used to probe which webhook ids exist. `createWebhook` generates the copy's own
+ * signing secret and re-runs the URL checks, so a copy can never carry the original's secret or skip
+ * validation the original has since started to fail.
+ */
+export async function duplicateV3Webhook(params: {
+  authentication: TV3Authentication;
+  webhookId: string;
+  auditLog?: TV3AuditLog;
+  requestId: string;
+  instance?: string;
+}): Promise<Response> {
+  const { authentication, webhookId, auditLog, requestId, instance } = params;
+  const log = logger.withContext({ requestId, webhookId });
+
+  try {
+    const source = await prisma.webhook.findUnique({ where: { id: webhookId } });
+    if (!source) {
+      return problemForbidden(requestId, "You are not authorized to access this resource", instance);
+    }
+
+    const access = await requireV3WorkspaceAccess(
+      authentication,
+      source.workspaceId,
+      "readWrite",
+      requestId,
+      instance
+    );
+    if (access instanceof Response) return access;
+
+    // The copy attaches the same surveys, so apply the same guard as attaching them to a new webhook.
+    await assertNewlyAttachedSurveysWorkspaceVisible(source.surveyIds);
+
+    let created;
+    try {
+      created = await createWebhook(source.workspaceId, {
+        name: `${WEBHOOK_COPY_NAME_PREFIX}${source.name || source.url}`,
+        url: source.url,
+        source: "user",
+        triggers: source.triggers,
+        surveyIds: source.surveyIds,
+      });
+    } catch (error) {
+      if (error instanceof InvalidInputError) {
+        return problemUnprocessableContent(requestId, "Unable to duplicate webhook", {
+          instance,
+          invalid_params: [{ name: "url", reason: "invalid" }],
+        });
+      }
+      throw error;
+    }
+
+    const webhook = serializeV3Webhook(created);
+    if (auditLog) {
+      auditLog.targetId = webhook.id;
+      auditLog.organizationId = access.organizationId;
+      auditLog.newObject = { ...webhook, duplicatedFrom: webhookId };
+    }
+
+    return createdResponse(webhook, { location: `/api/v3/webhooks/${webhook.id}`, requestId });
+  } catch (error) {
+    return mapV3ThrownError(error, { log, requestId, instance, operation: "webhooks.duplicate" });
+  }
+}
