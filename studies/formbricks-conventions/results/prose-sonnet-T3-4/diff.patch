--- /dev/null
+++ b/apps/web/app/api/v3/account/data-export/lib/operations.ts
@@ -0,0 +1,53 @@
+import "server-only";
+import { prisma } from "@formbricks/database";
+import { getV3SessionUserId } from "@/app/api/v3/lib/auth";
+import { problemInternalError, problemUnauthorized, successResponse } from "@/app/api/v3/lib/response";
+import type { TV3Authentication } from "@/app/api/v3/lib/types";
+
+export type TV3AccountDataExport = {
+  name: string;
+  email: string;
+  locale: string;
+  notificationSettings: unknown;
+  memberships: { organizationName: string; role: string }[];
+};
+
+export async function getV3AccountDataExport(params: {
+  authentication: TV3Authentication;
+  requestId: string;
+  instance?: string;
+}): Promise<Response> {
+  const { authentication, requestId, instance } = params;
+
+  // The subject is always the signed-in user; there is deliberately no id in the request.
+  const userId = getV3SessionUserId(authentication);
+  if (!userId) return problemUnauthorized(requestId, "Session required", instance);
+
+  const user = await prisma.user.findUnique({
+    where: { id: userId },
+    select: {
+      name: true,
+      email: true,
+      locale: true,
+      notificationSettings: true,
+      memberships: {
+        where: { accepted: true },
+        select: { role: true, organization: { select: { name: true } } },
+      },
+    },
+  });
+  if (!user) return problemInternalError(requestId, "Unable to export account data", instance);
+
+  const data: TV3AccountDataExport = {
+    name: user.name,
+    email: user.email,
+    locale: user.locale,
+    notificationSettings: user.notificationSettings,
+    memberships: user.memberships.map((membership) => ({
+      organizationName: membership.organization.name,
+      role: membership.role,
+    })),
+  };
+
+  return successResponse(data, { requestId });
+}
