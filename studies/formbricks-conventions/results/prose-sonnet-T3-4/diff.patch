+get:
+  operationId: getAccountDataExportV3
+  # Session-only, like the tags operations: the Formbricks app calls it from the profile page.
+  x-excluded: true
+  summary: Export my account data
+  description: |
+    Returns the signed-in user's name, email, locale, notification settings and organization memberships
+    (organization name and role).
+
+    Session cookie only. The endpoint takes no identifier and always exports the account behind the session.
+  tags:
+    - V3 Account
+  responses:
+    "200":
+      description: Account data retrieved successfully
+      headers:
+        X-Request-Id:
+          schema:
+            type: string
+          description: Request correlation ID
+        Cache-Control:
+          schema:
+            type: string
+          example: private, no-store
+      content:
+        application/json:
+          schema:
+            type: object
+            required:
+              - data
+            properties:
+              data:
+                type: object
+                required:
+                  - name
+                  - email
+                  - locale
+                  - notificationSettings
+                  - memberships
+                properties:
+                  name:
+                    type: string
+                  email:
+                    type: string
+                  locale:
+                    type: string
+                  notificationSettings:
+                    type: object
+                    additionalProperties: true
+                  memberships:
+                    type: array
+                    items:
+                      type: object
+                      required:
+                        - organizationName
+                        - role
+                      properties:
+                        organizationName:
+                          type: string
+                        role:
+                          type: string
+    "401":
+      $ref: ../components/responses/V3UnauthorizedSession.yml
+    "429":
+      $ref: ../components/responses/V3TooManyRequests.yml
+    "500":
+      $ref: ../components/responses/V3InternalServerError.yml
+  security:
+    - sessionAuth: []
