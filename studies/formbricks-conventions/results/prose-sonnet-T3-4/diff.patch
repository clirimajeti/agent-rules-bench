@@ -0,0 +1,57 @@
+"use client";
+
+import { QueryClient, QueryClientProvider, useMutation } from "@tanstack/react-query";
+import { DownloadIcon } from "lucide-react";
+import { useState } from "react";
+import toast from "react-hot-toast";
+import { useTranslation } from "react-i18next";
+import { parseV3ApiError } from "@/modules/api/lib/v3-client";
+import { Button } from "@/modules/ui/components/button";
+
+const ACCOUNT_DATA_EXPORT_URL = "/api/v3/account/data-export";
+const EXPORT_FILE_NAME = "formbricks-account-data.json";
+
+async function fetchAccountDataExport(): Promise<unknown> {
+  const response = await fetch(ACCOUNT_DATA_EXPORT_URL, { cache: "no-store" });
+  if (!response.ok) {
+    throw await parseV3ApiError(response);
+  }
+  return ((await response.json()) as { data: unknown }).data;
+}
+
+function saveJsonFile(data: unknown, fileName: string) {
+  const blob = new Blob([JSON.stringify(data, null, 2)], { type: "application/json" });
+  const url = URL.createObjectURL(blob);
+  const anchor = document.createElement("a");
+  anchor.href = url;
+  anchor.download = fileName;
+  anchor.click();
+  URL.revokeObjectURL(url);
+}
+
+const DownloadMyDataButton = () => {
+  const { t } = useTranslation();
+  // A one-off action rather than cached server data, so a mutation, not a query.
+  const { mutate, isPending } = useMutation({
+    mutationFn: fetchAccountDataExport,
+    onSuccess: (data) => saveJsonFile(data, EXPORT_FILE_NAME),
+    onError: () => toast.error(t("workspace.settings.profile.download_my_data_failed")),
+  });
+
+  return (
+    <Button type="button" variant="secondary" loading={isPending} onClick={() => mutate()}>
+      <DownloadIcon className="size-4" />
+      {t("workspace.settings.profile.download_my_data")}
+    </Button>
+  );
+};
+
+export const DownloadMyData = () => {
+  const [queryClient] = useState(() => new QueryClient());
+
+  return (
+    <QueryClientProvider client={queryClient}>
+      <DownloadMyDataButton />
+    </QueryClientProvider>
+  );
+};
diff --git a/apps/web/app/api/v3/account/data-export/lib/operations.ts b/apps/web/app/api/v3/account/data-export/lib/operations.ts
