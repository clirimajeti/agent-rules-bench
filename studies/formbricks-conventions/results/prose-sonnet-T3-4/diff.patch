@@ -0,0 +1,14 @@
+/**
+ * GET /api/v3/account/data-export - the signed-in user's own personal data.
+ *
+ * Session-only, deliberately: it exports the account behind the session and takes no identifier, so an
+ * API key (which has no user) has nothing to export.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { getV3AccountDataExport } from "./lib/operations";
+
+export const GET = withV3ApiWrapper({
+  auth: "session",
+  handler: async ({ authentication, requestId, instance }) =>
+    getV3AccountDataExport({ authentication, requestId, instance }),
+});
