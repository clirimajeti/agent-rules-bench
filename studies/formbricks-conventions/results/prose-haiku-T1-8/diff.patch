@@ -0,0 +1,27 @@
+import { parseV3ApiError } from "@/modules/api/lib/v3-client";
+
+/**
+ * Client fetchers for the API key v3 routes. Every call throws a parsed `V3ApiError` on a non-2xx
+ * response, so the hooks can surface the server's own message.
+ */
+
+const BASE_PATH = "/api/v3/api-keys";
+
+export type TRotatedApiKey = {
+  id: string;
+  label: string;
+  lastUsedAt: string | null;
+  /** The new plaintext secret. Returned once; the server keeps only its hashes. */
+  apiKey: string;
+};
+
+export async function rotateApiKey(params: { apiKeyId: string }): Promise<TRotatedApiKey> {
+  const response = await fetch(`${BASE_PATH}/${params.apiKeyId}/rotate`, {
+    method: "POST",
+    cache: "no-store",
+  });
+  if (!response.ok) {
+    throw await parseV3ApiError(response);
+  }
+  return ((await response.json()) as { data: TRotatedApiKey }).data;
+}
