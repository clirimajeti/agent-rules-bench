+/**
+ * DELETE /api/v3/tags/delete-unused — bulk-delete tags that are not applied to any response.
+ *
+ * Accepts `workspaceId` as a query parameter (same as the list route). The workspace is resolved
+ * from that parameter via `requireV3WorkspaceAccess`, so the caller must have workspace-level
+ * readWrite access. Returns the number of tags deleted.
+ */
+import "server-only";
+
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { problemInternalError, successResponse } from "@/app/api/v3/lib/response";
+import { requireV3WorkspaceAccess } from "@/app/api/v3/lib/auth";
+import { getTagsByWorkspaceId } from "@/lib/tag/service";
+import { prisma } from "@formbricks/database";
+import { deleteTag } from "@/modules/workspaces/settings/lib/tag";
+import type { TV3Authentication } from "@/app/api/v3/lib/types";
+import { ZV3TagListQuery } from "../lib/schemas";
+
+type TBaseParams = {
+  authentication: TV3Authentication;
+  requestId: string;
+  instance?: string;
+};
+
+const deleteUnusedTagsForWorkspace = async (
+  authentication: TV3Authentication,
+  workspaceId: string,
+  organizationId: string
+): Promise<{ deletedCount: number }> => {
+  const [tags, tagsWithResponses] = await Promise.all([
+    getTagsByWorkspaceId(workspaceId),
+    prisma.tagsOnResponses.groupBy({
+      by: ["tagId"],
+      where: {
+        response: {
+          survey: {
+            workspaceId,
+            ...((await import("@/lib/survey/visibility/predicate")).andVisibleSurveys(
+              await (await import("@/app/api/v3/responses/lib/visibility")).resolveV3ResponsesActorContext(
+                authentication,
+                organizationId
+              )
+            )),
+          },
+        },
+      },
+      _count: {
+        _all: true,
+      },
+    }),
+  ]);
+
+  const usedTagIds = new Set(tagsWithResponses.map((entry) => entry.tagId));
+  const unusedTags = tags.filter((tag) => !usedTagIds.has(tag.id));
+
+  let deletedCount = 0;
+  for (const tag of unusedTags) {
+    const result = await deleteTag(tag.id);
+    if (result.ok) {
+      deletedCount++;
+    }
+  }
+
+  return { deletedCount };
+};
+
+export const DELETE = withV3ApiWrapper({
+  auth: "session",
+  action: "deleted",
+  targetType: "tag",
+  schemas: { query: ZV3TagListQuery },
+  handler: async ({ authentication, parsedInput, requestId, instance }) => {
+    const access = await requireV3WorkspaceAccess(
+      authentication,
+      parsedInput.query.workspaceId,
+      "readWrite",
+      requestId,
+      instance
+    );
+    if (access instanceof Response) return access;
+
+    try {
+      const { deletedCount } = await deleteUnusedTagsForWorkspace(
+        authentication,
+        access.workspaceId,
+        access.organizationId
+      );
+
+      return successResponse({ deletedCount }, { requestId });
+    } catch (error) {
+      return problemInternalError(
+        requestId,
+        "Unable to delete unused tags",
+        instance
+      );
+    }
+  },
+});
