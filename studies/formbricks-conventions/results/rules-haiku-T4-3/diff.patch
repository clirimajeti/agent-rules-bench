+/**
+ * DELETE /api/v3/tags/unused?workspaceId={workspaceId} - delete every tag of the workspace that no response
+ * carries. Answers `{ deleted }` with the number of tags removed.
+ *
+ * Session-only, like the other tag routes. Not in the OpenAPI bundle yet: the tag operations are
+ * `x-excluded`, and this one is only called by the workspace tags settings page.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { deleteUnusedV3Tags } from "../lib/operations";
+import { ZV3TagListQuery } from "../lib/schemas";
+
+export const DELETE = withV3ApiWrapper({
+  auth: "session",
+  action: "deleted",
+  targetType: "tag",
+  schemas: { query: ZV3TagListQuery },
+  handler: async ({ authentication, parsedInput, auditLog, requestId, instance }) =>
+    deleteUnusedV3Tags({
+      authentication,
+      workspaceId: parsedInput.query.workspaceId,
+      auditLog,
+      requestId,
+      instance,
+    }),
+});
