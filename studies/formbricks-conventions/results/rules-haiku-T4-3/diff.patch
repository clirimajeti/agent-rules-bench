+"use client";
+
+import { useState } from "react";
+import { toast } from "react-hot-toast";
+import { useTranslation } from "react-i18next";
+import { getV3ApiErrorMessage } from "@/modules/api/lib/v3-client";
+import { Button } from "@/modules/ui/components/button";
+import { DeleteDialog } from "@/modules/ui/components/delete-dialog";
+import { useDeleteUnusedTags } from "@/modules/workspaces/settings/tags/hooks/use-delete-unused-tags";
+
+interface DeleteUnusedTagsButtonProps {
+  workspaceId: string;
+}
+
+/**
+ * Deletes every tag of the workspace that no response uses, after a confirmation, and reports how many
+ * were removed. The server decides what is unused, so this component only carries the dialog and the
+ * result message.
+ */
+export const DeleteUnusedTagsButton = ({ workspaceId }: Readonly<DeleteUnusedTagsButtonProps>) => {
+  const { t } = useTranslation();
+  const [openDialog, setOpenDialog] = useState(false);
+  const deleteUnusedTags = useDeleteUnusedTags(workspaceId);
+
+  const confirmDelete = async () => {
+    try {
+      const { deleted } = await deleteUnusedTags.mutateAsync();
+      setOpenDialog(false);
+      toast.success(t("workspace.tags.unused_tags_deleted", { count: deleted }));
+    } catch (error) {
+      toast.error(getV3ApiErrorMessage(error, t("common.something_went_wrong_please_try_again")));
+    }
+  };
+
+  return (
+    <>
+      <Button variant="destructive" size="sm" onClick={() => setOpenDialog(true)}>
+        {t("workspace.tags.delete_unused_tags")}
+      </Button>
+      <DeleteDialog
+        open={openDialog}
+        setOpen={setOpenDialog}
+        deleteWhat={t("workspace.tags.delete_unused_tags")}
+        title={t("workspace.tags.delete_unused_tags")}
+        text={t("workspace.tags.delete_unused_tags_confirmation")}
+        onDelete={confirmDelete}
+        isDeleting={deleteUnusedTags.isPending}
+      />
+    </>
+  );
+};
