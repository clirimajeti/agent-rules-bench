+/**
+ * Deletes every tag of the workspace that no response carries.
+ *
+ * "Unused" is judged against all responses in the workspace, not the caller's visible subset: deleting a
+ * tag also deletes its links to responses, so a tag applied to a response the caller cannot read is still
+ * in use and must survive. The count shown in the list is the visibility-scoped one, which is why this
+ * cannot reuse it.
+ */
+export const deleteUnusedTags = async (
+  workspaceId: string
+): Promise<Result<{ deleted: number }, { code: TagError; message: string }>> => {
+  validateInputs([workspaceId, ZId]);
+
+  try {
+    const { count } = await prisma.tag.deleteMany({
+      where: {
+        workspaceId,
+        responses: { none: {} },
+      },
+    });
+
+    return ok({ deleted: count });
+  } catch (error) {
+    return err({
+      code: TagError.UNEXPECTED_ERROR,
+      message: error instanceof Error ? error.message : "Unknown error occurred",
+    });
+  }
+};
