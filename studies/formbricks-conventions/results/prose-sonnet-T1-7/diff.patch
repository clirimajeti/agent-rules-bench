+"use client";
+
+import { useMutation } from "@tanstack/react-query";
+import { rotateApiKey } from "../lib/api-client";
+
+/**
+ * Rotate an API key. The new plaintext key exists only in this mutation's response, so the caller shows it
+ * from `onSuccess` and does not mirror it anywhere else.
+ */
+export const useRotateApiKey = () =>
+  useMutation({
+    mutationFn: (variables: { apiKeyId: string }) => rotateApiKey(variables),
+  });
diff --git a/apps/web/modules/organization/settings/api-keys/lib/api-client.ts b/apps/web/modules/organization/settings/api-keys/lib/api-client.ts
