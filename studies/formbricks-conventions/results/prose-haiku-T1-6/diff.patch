+/**
+ * Replace an API key's secret. The old secret stops authenticating as soon as the row is written, because
+ * both lookup paths read the hashes this overwrites. Label, organization access, workspace permissions and
+ * `createdAt` are left alone. `lastUsedAt` is cleared, since it described the old secret.
+ *
+ * Returns the new plaintext key. It is not stored anywhere, so the caller must show it now or it is lost.
+ */
+export const rotateApiKey = async (apiKeyId: string): Promise<{ id: string; actualKey: string }> => {
+  validateInputs([apiKeyId, ZId]);
+
+  const { secret, lookupHash, hashedKey } = await generateApiKeySecret();
+
+  try {
+    await prisma.apiKey.update({
+      where: { id: apiKeyId },
+      data: { hashedKey, lookupHash, lastUsedAt: null },
+    });
+
+    return { id: apiKeyId, actualKey: `fbk_${secret}` };
+  } catch (error) {
+    if (error instanceof Prisma.PrismaClientKnownRequestError) {
+      throw new DatabaseError(error.message);
+    }
+    throw error;
+  }
+};
