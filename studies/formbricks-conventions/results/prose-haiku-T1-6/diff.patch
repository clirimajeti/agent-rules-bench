+/**
+ * POST /api/v3/api-keys/{apiKeyId}/rotate — replace the key's secret. Session only. The label, access
+ * settings and workspace permissions are kept; the previous secret stops working immediately.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { rotateV3ApiKey } from "../../lib/operations";
+import { ZV3ApiKeyIdParams } from "../../lib/schemas";
+
+export const POST = withV3ApiWrapper({
+  auth: "session",
+  action: "updated",
+  targetType: "apiKey",
+  schemas: { params: ZV3ApiKeyIdParams },
+  handler: async ({ authentication, parsedInput, auditLog, requestId, instance }) =>
+    rotateV3ApiKey({
+      authentication,
+      apiKeyId: parsedInput.params.apiKeyId,
+      auditLog,
+      requestId,
+      instance,
+    }),
+});
diff --git a/apps/web/app/api/v3/api-keys/lib/operations.ts b/apps/web/app/api/v3/api-keys/lib/operations.ts
new file mode 100644
index 000000000..9bf479c3f
--- /dev/null
+++ b/apps/web/app/api/v3/api-keys/lib/operations.ts
@@ -0,0 +1,50 @@
+import "server-only";
+import { AuthorizationError, ResourceNotFoundError } from "@formbricks/types/errors";
+import { problemForbidden, problemUnauthorized, successResponse } from "@/app/api/v3/lib/response";
+import type { TV3AuditLog, TV3Authentication } from "@/app/api/v3/lib/types";
+import { assertCan } from "@/lib/authorization";
+import { getOrganizationIdFromApiKeyId } from "@/lib/utils/helper";
+import { rotateApiKey } from "@/modules/organization/settings/api-keys/lib/api-key";
+
+/**
+ * Rotate an API key's secret. Session only: the caller must hold `apiKey.manage` on the key, the same
+ * check the settings page applies. An unknown key answers 403, not 404, so a signed-in user cannot use
+ * this route to learn which key ids exist.
+ *
+ * The response carries the new plaintext key once. It is not stored, so the client must show it now.
+ */
+export async function rotateV3ApiKey(params: {
+  authentication: TV3Authentication;
+  apiKeyId: string;
+  auditLog?: TV3AuditLog;
+  requestId: string;
+  instance?: string;
+}): Promise<Response> {
+  const { authentication, apiKeyId, auditLog, requestId, instance } = params;
+
+  if (!authentication || !("user" in authentication) || !authentication.user?.id) {
+    return problemUnauthorized(requestId, "Session required", instance);
+  }
+  const userId = authentication.user.id;
+
+  let organizationId: string;
+  try {
+    organizationId = await getOrganizationIdFromApiKeyId(apiKeyId);
+    await assertCan({ type: "user", id: userId }, "apiKey.manage", { type: "apiKey", id: apiKeyId });
+  } catch (error) {
+    if (error instanceof ResourceNotFoundError || error instanceof AuthorizationError) {
+      return problemForbidden(requestId, undefined, instance);
+    }
+    throw error;
+  }
+
+  if (auditLog) {
+    auditLog.organizationId = organizationId;
+    auditLog.targetId = apiKeyId;
+  }
+
+  // The audit entry records the rotation, not the secret: nothing from the new key is written to it.
+  const { id, actualKey } = await rotateApiKey(apiKeyId);
+
+  return successResponse({ id, key: actualKey }, { requestId });
+}
