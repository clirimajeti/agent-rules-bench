+"use client";
+
+import { CopyIcon } from "lucide-react";
+import toast from "react-hot-toast";
+import { useTranslation } from "react-i18next";
+import { Alert, AlertTitle } from "@/modules/ui/components/alert";
+import { Button } from "@/modules/ui/components/button";
+import {
+  Dialog,
+  DialogBody,
+  DialogContent,
+  DialogDescription,
+  DialogFooter,
+  DialogHeader,
+  DialogTitle,
+} from "@/modules/ui/components/dialog";
+
+interface RotatedApiKeyModalProps {
+  /** The new plaintext key, or `null` while the dialog is closed. It is held only for as long as this is set. */
+  rotatedKey: string | null;
+  onClose: () => void;
+}
+
+/**
+ * Shows the key a rotation produced. The server does not keep the plaintext, so once this closes the key
+ * cannot be shown again, and the security warning says so.
+ */
+export const RotatedApiKeyModal = ({ rotatedKey, onClose }: Readonly<RotatedApiKeyModalProps>) => {
+  const { t } = useTranslation();
+
+  const copyToClipboard = async () => {
+    if (!rotatedKey) return;
+    try {
+      await navigator.clipboard.writeText(rotatedKey);
+      toast.success(t("workspace.api_keys.api_key_copied_to_clipboard"));
+    } catch {
+      toast.error(t("workspace.api_keys.unable_to_copy_api_key"));
+    }
+  };
+
+  return (
+    <Dialog
+      open={rotatedKey !== null}
+      onOpenChange={(open) => {
+        if (!open) onClose();
+      }}>
+      <DialogContent>
+        <DialogHeader>
+          <DialogTitle className="px-1">{t("workspace.api_keys.rotated_api_key_title")}</DialogTitle>
+          <DialogDescription className="px-1">
+            {t("workspace.api_keys.rotated_api_key_description")}
+          </DialogDescription>
+        </DialogHeader>
+        <DialogBody className="space-y-4 px-1 py-4">
+          <div className="flex items-center justify-between gap-2 rounded-md bg-slate-50 p-3">
+            <span className="font-mono text-sm break-all">{rotatedKey}</span>
+            <Button
+              type="button"
+              size="icon"
+              variant="ghost"
+              aria-label={t("common.copy")}
+              onClick={() => void copyToClipboard()}>
+              <CopyIcon className="size-4" />
+            </Button>
+          </div>
+          <Alert variant="warning" role="status">
+            <AlertTitle>{t("workspace.api_keys.rotated_api_key_security_warning")}</AlertTitle>
+          </Alert>
+        </DialogBody>
+        <DialogFooter>
+          <Button type="button" onClick={onClose}>
+            {t("common.done")}
+          </Button>
+        </DialogFooter>
+      </DialogContent>
+    </Dialog>
+  );
+};
