+import { formatDateTimeForDisplay } from "@/lib/utils/datetime";
+
+interface AccountActivityProps {
+  createdAt: Date;
+  lastLoginAt: Date | null;
+  locale: string;
+  createdLabel: string;
+  lastLoginLabel: string;
+  neverLabel: string;
+}
+
+export const AccountActivity = ({
+  createdAt,
+  lastLoginAt,
+  locale,
+  createdLabel,
+  lastLoginLabel,
+  neverLabel,
+}: Readonly<AccountActivityProps>) => (
+  <dl className="space-y-3 text-sm">
+    <div className="flex justify-between">
+      <dt className="text-slate-500">{createdLabel}</dt>
+      <dd className="text-slate-900">{formatDateTimeForDisplay(createdAt, locale)}</dd>
+    </div>
+    <div className="flex justify-between">
+      <dt className="text-slate-500">{lastLoginLabel}</dt>
+      <dd className="text-slate-900">
+        {lastLoginAt ? formatDateTimeForDisplay(lastLoginAt, locale) : neverLabel}
+      </dd>
+    </div>
+  </dl>
+);
