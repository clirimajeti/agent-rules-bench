@@ -0,0 +1,68 @@
+get:
+  operationId: exportAccountDataV3
+  # Session-only, like the tags operations: it backs the Download my data button on the profile page.
+  x-excluded: true
+  summary: Download my account data
+  description: |
+    Returns the signed-in user's name, email, locale, notification settings and organization memberships
+    (organization name and role) as a JSON file attachment.
+
+    Session cookie only. This endpoint backs the profile page, so it does not accept `x-api-key`.
+  tags:
+    - V3 Account
+  responses:
+    "200":
+      description: Account data
+      headers:
+        X-Request-Id:
+          schema:
+            type: string
+          description: Request correlation ID
+        Content-Disposition:
+          schema:
+            type: string
+          example: attachment; filename="formbricks-account-data.json"
+        Cache-Control:
+          schema:
+            type: string
+          example: private, no-store
+      content:
+        application/json:
+          schema:
+            type: object
+            required:
+              - name
+              - email
+              - locale
+              - notificationSettings
+              - organizationMemberships
+            properties:
+              name:
+                type: string
+              email:
+                type: string
+              locale:
+                type: string
+              notificationSettings:
+                type: object
+                additionalProperties: true
+              organizationMemberships:
+                type: array
+                items:
+                  type: object
+                  required:
+                    - organizationName
+                    - role
+                  properties:
+                    organizationName:
+                      type: string
+                    role:
+                      type: string
+    "401":
+      $ref: ../components/responses/V3UnauthorizedSession.yml
+    "429":
+      $ref: ../components/responses/V3TooManyRequests.yml
+    "500":
+      $ref: ../components/responses/V3InternalServerError.yml
+  security:
+    - sessionAuth: []
