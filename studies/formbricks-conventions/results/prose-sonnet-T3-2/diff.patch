+"use client";
+
+import { useTranslation } from "react-i18next";
+import { Button } from "@/modules/ui/components/button";
+
+/**
+ * The export route answers with `Content-Disposition: attachment`, so navigating to it downloads the
+ * file and leaves the page where it is. There is no server data to cache or mirror here.
+ */
+export const DownloadMyData = () => {
+  const { t } = useTranslation();
+
+  return (
+    <div>
+      <p className="text-sm text-slate-700">{t("workspace.settings.profile.download_my_data_description")}</p>
+      <Button
+        className="mt-4"
+        variant="secondary"
+        size="sm"
+        onClick={() => window.location.assign("/api/v3/account/data-export")}>
+        {t("workspace.settings.profile.download_my_data")}
+      </Button>
+    </div>
+  );
+};
diff --git a/apps/web/app/api/v3/account/data-export/lib/operations.ts b/apps/web/app/api/v3/account/data-export/lib/operations.ts
new file mode 100644
index 000000000..382333917
--- /dev/null
+++ b/apps/web/app/api/v3/account/data-export/lib/operations.ts
@@ -0,0 +1,64 @@
+import "server-only";
+import { prisma } from "@formbricks/database";
+import { problemInternalError, problemUnauthorized } from "@/app/api/v3/lib/response";
+import type { TV3Authentication } from "@/app/api/v3/lib/types";
+
+type TBaseParams = {
+  authentication: TV3Authentication;
+  requestId: string;
+  instance?: string;
+};
+
+/**
+ * The caller's own personal data as a downloadable JSON attachment. Scoped to the session user id and
+ * nothing else, so there is no identifier a caller could swap for someone else's.
+ *
+ * Only the documented fields are selected: credentials, 2FA material and tokens never leave the database.
+ */
+export async function exportV3AccountData({
+  authentication,
+  requestId,
+  instance,
+}: TBaseParams): Promise<Response> {
+  if (!authentication || !("user" in authentication) || !authentication.user?.id) {
+    return problemUnauthorized(requestId, "Session required", instance);
+  }
+
+  const user = await prisma.user.findUnique({
+    where: { id: authentication.user.id },
+    select: {
+      name: true,
+      email: true,
+      locale: true,
+      notificationSettings: true,
+      memberships: {
+        select: { role: true, organization: { select: { name: true } } },
+      },
+    },
+  });
+
+  if (!user) {
+    return problemInternalError(requestId, "Account data could not be loaded.", instance);
+  }
+
+  const data = {
+    name: user.name,
+    email: user.email,
+    locale: user.locale,
+    notificationSettings: user.notificationSettings,
+    organizationMemberships: user.memberships.map((membership) => ({
+      organizationName: membership.organization.name,
+      role: membership.role,
+    })),
+  };
+
+  return new Response(JSON.stringify(data, null, 2), {
+    status: 200,
+    headers: {
+      "Content-Type": "application/json",
+      "Content-Disposition": 'attachment; filename="formbricks-account-data.json"',
+      "Cache-Control": "private, no-store",
+      "X-Request-Id": requestId,
+    },
+  });
+}
diff --git a/apps/web/app/api/v3/account/data-export/route.ts b/apps/web/app/api/v3/account/data-export/route.ts
