@@ -0,0 +1,80 @@
+import { Webhook } from "@formbricks/database/prisma";
+import { ResourceNotFoundError } from "@formbricks/types/errors";
+import { assertCan } from "@/lib/authorization";
+import { generateWebhookSecret } from "@/lib/crypto";
+import { capturePostHogEvent } from "@/lib/posthog";
+import {
+  getOrganizationIdFromWebhookId,
+  getWorkspaceIdFromWebhookId,
+} from "@/lib/utils/helper";
+import {
+  getWebhookWithSecret,
+} from "@/modules/api/v2/management/webhooks/[webhookId]/lib/webhook";
+import { applyRateLimit } from "@/modules/core/rate-limit/helpers";
+import { rateLimitConfigs } from "@/modules/core/rate-limit/rate-limit-configs";
+import { TV3Authentication, TV3AuditLog } from "@/app/api/v3/lib/types";
+import { createWebhook } from "@/modules/integrations/webhooks/lib/webhook";
+import { TWebhookInput } from "@/modules/integrations/webhooks/types/webhooks";
+import type { TV3WebhookIdParams } from "./schemas";
+
+export const duplicateV3Webhook = async ({
+  webhookId,
+  authentication,
+  auditLog,
+  requestId,
+  instance,
+}: {
+  webhookId: string;
+  authentication: TV3Authentication;
+  auditLog?: TV3AuditLog;
+  requestId: string;
+  instance: string;
+}): Promise<{ data: Webhook }> => {
+  const organizationId = await getOrganizationIdFromWebhookId(webhookId);
+  const workspaceId = await getWorkspaceIdFromWebhookId(webhookId);
+
+  await assertCan(
+    { type: "user", id: authentication.userId! },
+    "workspace.write",
+    { type: "workspace", id: workspaceId }
+  );
+
+  await applyRateLimit(rateLimitConfigs.api.v3, workspaceId);
+
+  const webhookResult = await getWebhookWithSecret(webhookId);
+  if (!webhookResult.ok) {
+    throw new ResourceNotFoundError("Webhook", webhookId);
+  }
+
+  const original = webhookResult.data;
+  const newSecret = generateWebhookSecret();
+
+  const webhookInput: TWebhookInput = {
+    name: original.name ? `Copy of ${original.name}` : null,
+    url: original.url,
+    source: "user" as const,
+    triggers: original.triggers,
+    surveyIds: original.surveyIds,
+  };
+
+  const webhook = await createWebhook(workspaceId, webhookInput, newSecret);
+
+  // Audit logging — mirror the server action's behavior
+  if (auditLog) {
+    auditLog.organizationId = organizationId;
+    auditLog.newObject = webhook;
+  }
+
+  capturePostHogEvent(
+    authentication.userId!,
+    "integration_connected",
+    {
+      integration_type: "webhook",
+      organization_id: organizationId,
+      workspace_id: workspaceId,
+    },
+    { organizationId, workspaceId }
+  );
+
+  return { data: webhook };
+};
