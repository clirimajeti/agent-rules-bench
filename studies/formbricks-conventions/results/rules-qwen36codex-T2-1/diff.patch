diff --git a/apps/web/modules/integrations/webhooks/lib/api-client.ts b/apps/web/modules/integrations/webhooks/lib/api-client.ts
new file mode 100644
index 000000000..04f37eb19
--- /dev/null
+++ b/apps/web/modules/integrations/webhooks/lib/api-client.ts
@@ -0,0 +1,54 @@
+import type { Webhook } from "@formbricks/database/prisma-browser";
+import { V3ApiError, parseV3ApiError } from "@/modules/api/lib/v3-client";
+
+const WEBHOOKS_PATH = "/api/v3/webhooks";
+
+/**
+ * The app's client for the webhook API. Every function throws the parsed problem (`V3ApiError`)
+ * on a non-2xx, so callers branch on `code` rather than on prose.
+ */
+
+/**
+ * A webhook as the app's components use it. Mirrors the TV3WebhookResource shape.
+ */
+export type TAppWebhook = Webhook;
+
+/**
+ * Duplicates a webhook. Returns the newly created webhook on success.
+ */
+export const duplicateWebhook = async (
+  webhookId: string
+): Promise<TAppWebhook> => {
+  const response = await fetch(`${WEBHOOKS_PATH}/${encodeURIComponent(webhookId)}/duplicate`, {
+    method: "POST",
+    headers: { "Content-Type": "application/json" },
+    cache: "no-store",
+    signal: AbortSignal.timeout(15_000),
+  });
+
+  if (!response.ok) {
+    throw await parseV3ApiError(response);
+  }
+
+  const json = (await response.json()) as { data: Webhook };
+  return json.data;
+};
+
+/**
+ * Returns a human-readable error message from a V3ApiError, falling back to a default.
+ */
+export const getWebhookApiErrorMessage = (error: unknown, fallback: string): string => {
+  if (error instanceof V3ApiError) {
+    if (error.code === "not_found") {
+      return "Webhook not found";
+    }
+    if (error.code === "unauthorized") {
+      return "You don't have permission to duplicate this webhook";
+    }
+    if (error.invalid_params?.length) {
+      return error.invalid_params[0].reason ?? fallback;
+    }
+    return error.detail ?? fallback;
+  }
+  return fallback;
+};
