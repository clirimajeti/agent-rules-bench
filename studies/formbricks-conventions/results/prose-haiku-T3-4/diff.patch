@@ -0,0 +1,43 @@
+"use client";
+
+import { useState } from "react";
+import toast from "react-hot-toast";
+import { useTranslation } from "react-i18next";
+import { Button } from "@/modules/ui/components/button";
+
+const DOWNLOAD_FILE_NAME = "formbricks-account-data.json";
+
+export const DownloadAccountDataButton = () => {
+  const { t } = useTranslation();
+  const [isDownloading, setIsDownloading] = useState(false);
+
+  const handleDownload = async () => {
+    setIsDownloading(true);
+    try {
+      const response = await fetch("/api/account/data-export");
+      if (!response.ok) {
+        throw new Error(`Account data export failed with status ${response.status}`);
+      }
+
+      const blob = await response.blob();
+      const url = URL.createObjectURL(blob);
+      const link = document.createElement("a");
+      link.href = url;
+      link.download = DOWNLOAD_FILE_NAME;
+      document.body.appendChild(link);
+      link.click();
+      link.remove();
+      URL.revokeObjectURL(url);
+    } catch {
+      toast.error(t("common.something_went_wrong_please_try_again"));
+    } finally {
+      setIsDownloading(false);
+    }
+  };
+
+  return (
+    <Button variant="secondary" loading={isDownloading} onClick={handleDownload}>
+      {t("workspace.settings.profile.download_my_data")}
+    </Button>
+  );
+};
diff --git a/apps/web/app/api/(internal)/account/data-export/route.ts b/apps/web/app/api/(internal)/account/data-export/route.ts
