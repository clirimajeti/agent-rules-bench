@@ -0,0 +1,40 @@
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { problemUnauthorized } from "@/app/api/v3/lib/response";
+import { getSessionUserId } from "@/app/api/v3/surveys/lib/operations";
+import { getAccountDataExport } from "@/modules/account/lib/account-data-export";
+
+/**
+ * `GET /api/account/data-export` - the signed-in user's own data as a JSON file.
+ *
+ * Lives under `(internal)` rather than `/api/v3` because it carries no OpenAPI entry and makes no
+ * compatibility promise: the only caller is the profile page's download button. Session-only, so the
+ * cookie is the credential and an API key cannot download another person's record.
+ *
+ * It still goes through `withV3ApiWrapper` for request handling, rate limiting and audit logging.
+ */
+export const GET = withV3ApiWrapper({
+  auth: "session",
+  action: "exported",
+  targetType: "user",
+  handler: async ({ authentication, requestId, instance, auditLog }) => {
+    const userId = getSessionUserId(authentication);
+    if (!userId) {
+      return problemUnauthorized(requestId, "Not authenticated", instance);
+    }
+
+    const data = await getAccountDataExport(userId);
+
+    if (auditLog) {
+      auditLog.targetId = userId;
+    }
+
+    return new Response(JSON.stringify(data, null, 2), {
+      status: 200,
+      headers: {
+        "Content-Type": "application/json; charset=utf-8",
+        "Content-Disposition": 'attachment; filename="formbricks-account-data.json"',
+        "Cache-Control": "no-store",
+      },
+    });
+  },
+});
