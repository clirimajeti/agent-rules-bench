+import { getTranslate } from "@/lingodotdev/server";
+import { formatDateTimeForDisplay } from "@/lib/utils/datetime";
+
+interface AccountActivityProps {
+  createdAt: Date;
+  lastLoginAt: Date | null;
+  locale: string;
+}
+
+const SHORT_DATE_TIME_OPTIONS: Intl.DateTimeFormatOptions = { dateStyle: "medium", timeStyle: "short" };
+
+export const AccountActivity = async ({ createdAt, lastLoginAt, locale }: Readonly<AccountActivityProps>) => {
+  const t = await getTranslate();
+
+  return (
+    <dl className="grid grid-cols-[max-content_1fr] gap-x-6 gap-y-2 text-sm">
+      <dt className="text-slate-500">{t("workspace.settings.profile.account_created")}</dt>
+      <dd className="text-slate-900">
+        {formatDateTimeForDisplay(createdAt, locale, SHORT_DATE_TIME_OPTIONS)}
+      </dd>
+      <dt className="text-slate-500">{t("workspace.settings.profile.last_login")}</dt>
+      <dd className="text-slate-900">
+        {lastLoginAt
+          ? formatDateTimeForDisplay(lastLoginAt, locale, SHORT_DATE_TIME_OPTIONS)
+          : t("workspace.settings.profile.never_logged_in")}
+      </dd>
+    </dl>
+  );
+};
