@@ -0,0 +1,32 @@
+import type { TUserNotificationSettings } from "@formbricks/types/user";
+
+export type TV3AccountDataExport = {
+  name: string;
+  email: string;
+  locale: string;
+  notificationSettings: TUserNotificationSettings;
+  organizationMemberships: { organizationName: string; role: string }[];
+};
+
+type TAccountDataExportSource = {
+  name: string;
+  email: string;
+  locale: string;
+  notificationSettings: unknown;
+  memberships: { role: string; organization: { name: string } }[];
+};
+
+/**
+ * Whitelists the exported fields. Building the payload field by field means a column added to `User`
+ * later is never exported by accident.
+ */
+export const serializeV3AccountDataExport = (user: TAccountDataExportSource): TV3AccountDataExport => ({
+  name: user.name,
+  email: user.email,
+  locale: user.locale,
+  notificationSettings: (user.notificationSettings ?? {}) as TUserNotificationSettings,
+  organizationMemberships: user.memberships.map((membership) => ({
+    organizationName: membership.organization.name,
+    role: membership.role,
+  })),
+});
