+/**
+ * GET /api/v3/account/data-export - the signed-in user's own personal data, for the profile page's
+ * "Download my data" button.
+ *
+ * Session-only, deliberately, like `/api/v3/tags`: it exports the caller's own account, so an API key
+ * (which belongs to an organization, not a person) has no user to export. There is no client-supplied
+ * identifier either - the user is always taken from the session, so a caller cannot ask for someone else's.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { exportV3AccountData } from "./lib/operations";
+
+export const GET = withV3ApiWrapper({
+  auth: "session",
+  handler: async ({ authentication, requestId, instance }) =>
+    exportV3AccountData({ authentication, requestId, instance }),
+});
