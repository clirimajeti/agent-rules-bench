+import { useMutation } from "@tanstack/react-query";
+import { getAccountDataExport } from "../lib/api-client";
+import { downloadAccountDataExport } from "../lib/file";
+
+/** Fetches the user's data on click, then saves it as a file. A mutation, not a query: nothing is cached or refetched. */
