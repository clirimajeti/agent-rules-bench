@@ -0,0 +1,20 @@
+import type { TV3AccountDataExport } from "@/app/api/v3/account/data-export/serializers";
+
+export const ACCOUNT_DATA_EXPORT_FILE_NAME = "formbricks-my-data.json";
+
+/** The file body: pretty-printed so a person can read it. Machine-facing, so never localized. */
+export const serializeAccountDataExportFile = (data: TV3AccountDataExport): string =>
+  JSON.stringify(data, null, 2);
+
+/** Hands the export to the browser as a file download. */
+export const downloadAccountDataExport = (data: TV3AccountDataExport): void => {
+  const blob = new Blob([serializeAccountDataExportFile(data)], { type: "application/json" });
+  const url = URL.createObjectURL(blob);
+  const link = document.createElement("a");
+  link.href = url;
+  link.download = ACCOUNT_DATA_EXPORT_FILE_NAME;
+  document.body.appendChild(link);
+  link.click();
+  link.remove();
+  URL.revokeObjectURL(url);
+};
