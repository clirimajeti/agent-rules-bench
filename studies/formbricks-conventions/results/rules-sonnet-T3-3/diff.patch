@@ -0,0 +1,11 @@
+import type { TV3AccountDataExport } from "@/app/api/v3/account/data-export/serializers";
+import { parseV3ApiError } from "@/modules/api/lib/v3-client";
+
+/** Client fetcher for `GET /api/v3/account/data-export`. Throws a parsed `V3ApiError` on a non-2xx response. */
+export async function getAccountDataExport(): Promise<TV3AccountDataExport> {
+  const response = await fetch("/api/v3/account/data-export", { method: "GET", cache: "no-store" });
+  if (!response.ok) {
+    throw await parseV3ApiError(response);
+  }
+  return ((await response.json()) as { data: TV3AccountDataExport }).data;
+}
