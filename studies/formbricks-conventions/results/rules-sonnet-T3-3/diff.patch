+import { describe, expect, test } from "vitest";
+import { serializeV3AccountDataExport } from "./serializers";
+
+describe("serializeV3AccountDataExport", () => {
+  test("exports only the documented fields", () => {
+    const source = {
+      name: "Ada",
+      email: "ada@example.com",
+      locale: "en-US",
+      notificationSettings: { alert: {}, weeklySummary: {} },
+      memberships: [{ role: "owner", organization: { name: "Acme" } }],
+      // Anything else on the row must not leak into the export.
+      password: "hash",
+      id: "u1",
+    };
+
+    expect(serializeV3AccountDataExport(source)).toEqual({
+      name: "Ada",
+      email: "ada@example.com",
+      locale: "en-US",
+      notificationSettings: { alert: {}, weeklySummary: {} },
+      organizationMemberships: [{ organizationName: "Acme", role: "owner" }],
+    });
+  });
+
+  test("returns an empty membership list for a user without organizations", () => {
+    const result = serializeV3AccountDataExport({
+      name: "Ada",
+      email: "ada@example.com",
+      locale: "de-DE",
+      notificationSettings: {},
+      memberships: [],
+    });
+
+    expect(result.organizationMemberships).toEqual([]);
+  });
+});
