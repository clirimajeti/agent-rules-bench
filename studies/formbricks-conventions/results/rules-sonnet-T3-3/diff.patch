+import { TFunction } from "i18next";
+import { formatDateTimeForDisplay } from "@/lib/utils/datetime";
+
+interface AccountActivityProps {
+  createdAt: Date;
+  lastLoginAt: Date | null;
+  locale: string;
+  t: TFunction;
+}
+
+// The stored values are UTC instants and the product has no time zone setting, so the zone is stated
+// explicitly instead of depending on the server's clock. Locale only controls the formatting.
+const ACTIVITY_DATE_OPTIONS: Intl.DateTimeFormatOptions = {
+  year: "numeric",
+  month: "long",
+  day: "numeric",
+  hour: "numeric",
+  minute: "2-digit",
+  timeZone: "UTC",
+  timeZoneName: "short",
+};
+
+export const AccountActivity = ({ createdAt, lastLoginAt, locale, t }: Readonly<AccountActivityProps>) => {
+  return (
+    <dl className="space-y-4 pb-4 text-sm">
+      <div>
+        <dt className="font-medium text-slate-900">{t("workspace.settings.profile.account_created")}</dt>
+        <dd className="mt-1 text-slate-600">{formatDateTimeForDisplay(createdAt, locale, ACTIVITY_DATE_OPTIONS)}</dd>
+      </div>
+      <div>
+        <dt className="font-medium text-slate-900">{t("workspace.settings.profile.last_login")}</dt>
+        <dd className="mt-1 text-slate-600">
+          {lastLoginAt
+            ? formatDateTimeForDisplay(lastLoginAt, locale, ACTIVITY_DATE_OPTIONS)
+            : t("workspace.settings.profile.no_login_recorded")}
+        </dd>
+      </div>
+    </dl>
+  );
+};
diff --git a/apps/web/app/api/v3/account/data-export/lib/operations.ts b/apps/web/app/api/v3/account/data-export/lib/operations.ts
new file mode 100644
index 000000000..f8e7189d6
--- /dev/null
+++ b/apps/web/app/api/v3/account/data-export/lib/operations.ts
@@ -0,0 +1,45 @@
+import "server-only";
+import { prisma } from "@formbricks/database";
+import { problemUnauthorized, successResponse } from "@/app/api/v3/lib/response";
+import type { TV3Authentication } from "@/app/api/v3/lib/types";
+import { serializeV3AccountDataExport } from "../serializers";
+
+type TParams = {
+  authentication: TV3Authentication;
+  requestId: string;
+  instance?: string;
+};
+
+export async function exportV3AccountData({
+  authentication,
+  requestId,
+  instance,
+}: TParams): Promise<Response> {
+  const userId = authentication && "user" in authentication ? authentication.user?.id : undefined;
+  if (!userId) {
+    return problemUnauthorized(requestId, "Session required", instance);
+  }
+
+  // One query for the user and their memberships, scoped to the session user's own id and bounded by
+  // the number of organizations they belong to. Pending invites (`accepted: false`) are not memberships.
+  const user = await prisma.user.findUnique({
+    where: { id: userId },
+    select: {
+      name: true,
+      email: true,
+      locale: true,
+      notificationSettings: true,
+      memberships: {
+        where: { accepted: true },
+        select: { role: true, organization: { select: { name: true } } },
+        orderBy: { organization: { name: "asc" } },
+      },
+    },
+  });
+
+  if (!user) {
+    return problemUnauthorized(requestId, "Session required", instance);
+  }
+
+  return successResponse(serializeV3AccountDataExport(user), { requestId });
+}
