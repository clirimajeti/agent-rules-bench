+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { rotateApiKeyOperation } from "./lib/operations";
+import { ZRotateApiKeyPathParams } from "./schemas";
+
+/**
+ * `POST /api/internal/api-keys/{apiKeyId}/rotate`: replace an API key's secret, keeping its label and
+ * access settings. The response carries the new secret once. Internal and session-only.
+ */
+export const POST = withV3ApiWrapper({
+  auth: "session",
+  schemas: { params: ZRotateApiKeyPathParams },
+  action: "updated",
+  targetType: "apiKey",
+  handler: async ({ authentication, parsedInput, requestId, instance, auditLog }) =>
+    rotateApiKeyOperation({
+      authentication,
+      apiKeyId: parsedInput.params.apiKeyId,
+      requestId,
+      instance,
+      auditLog,
+    }),
+});
