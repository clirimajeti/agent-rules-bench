+import "server-only";
+import { getV3AuthorizationActor } from "@/app/api/v3/lib/auth";
+import { problemForbidden, problemUnauthorized, successResponse } from "@/app/api/v3/lib/response";
+import type { TV3AuditLog, TV3Authentication } from "@/app/api/v3/lib/types";
+import { can } from "@/lib/authorization";
+import { getApiKey } from "@/lib/utils/services";
+import { rotateApiKey } from "@/modules/organization/settings/api-keys/lib/api-key";
+import { serializeRotatedApiKey } from "../serializers";
+
+/**
+ * Replace an API key's secret. Same question the delete and update actions ask: `apiKey.manage` on the
+ * key. A missing key and one the caller may not manage get the same 403, byte for byte, so the route
+ * can't be used to probe which key ids exist. The audit entry records the key and its organization but
+ * never the secret.
+ */
+export async function rotateApiKeyOperation({
+  authentication,
+  apiKeyId,
+  requestId,
+  instance,
+  auditLog,
+}: {
+  authentication: TV3Authentication;
+  apiKeyId: string;
+  requestId: string;
+  instance?: string;
+  auditLog?: TV3AuditLog;
+}): Promise<Response> {
+  const actor = getV3AuthorizationActor(authentication);
+  if (actor?.type !== "user") {
+    return problemUnauthorized(requestId, "Session required", instance);
+  }
+
+  if (auditLog) auditLog.targetId = apiKeyId;
+
+  const existing = await getApiKey(apiKeyId);
+  if (!existing || !(await can(actor, "apiKey.manage", { type: "apiKey", id: apiKeyId }))) {
+    return problemForbidden(requestId, undefined, instance);
+  }
+  if (auditLog) auditLog.organizationId = existing.organizationId;
+
+  const rotated = await rotateApiKey(apiKeyId);
+
+  return successResponse(serializeRotatedApiKey(rotated), { requestId });
+}
