+/**
+ * Deletes every tag of the workspace that no response carries. "Unused" is decided in the database,
+ * across all responses, in the same statement as the delete: the tag list shows counts limited to the
+ * surveys the caller may see (ENG-3282), and a tag that only restricted surveys use must not be deleted
+ * because its visible count is 0.
+ */
+export const deleteUnusedTags = async (
+  workspaceId: string
+): Promise<Result<{ count: number }, { code: TagError; message: string }>> => {
+  validateInputs([workspaceId, ZId]);
+
+  try {
+    const { count } = await prisma.tag.deleteMany({
+      where: { workspaceId, responses: { none: {} } },
+    });
+
+    return ok({ count });
+  } catch (error) {
+    return err({
+      code: TagError.UNEXPECTED_ERROR,
+      message: error instanceof Error ? error.message : "Unknown error occurred",
+    });
+  }
+};
