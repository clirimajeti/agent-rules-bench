   });
 }
+
+export async function deleteUnusedTags(params: { workspaceId: string }): Promise<{ deletedCount: number }> {
+  const query = new URLSearchParams({ workspaceId: params.workspaceId });
+  return request<{ deletedCount: number }>(`${BASE_PATH}/delete-unused?${query.toString()}`, {
+    method: "POST",
+  });
+}
