diff --git a/apps/web/modules/integrations/webhooks/lib/api-client.ts b/apps/web/modules/integrations/webhooks/lib/api-client.ts
new file mode 100644
index 000000000..168a750f3
--- /dev/null
+++ b/apps/web/modules/integrations/webhooks/lib/api-client.ts
@@ -0,0 +1,30 @@
+import type { Webhook } from "@formbricks/database/prisma-browser";
+import { parseV3ApiError } from "@/modules/api/lib/v3-client";
+
+/**
+ * Duplicates a webhook through the v3 API. The response carries the copy's signing secret, which is
+ * shown once. Dates arrive as ISO strings and are turned back into `Date` here.
+ */
+export async function duplicateWebhook({
+  workspaceId,
+  webhookId,
+}: Readonly<{ workspaceId: string; webhookId: string }>): Promise<Webhook> {
+  const response = await fetch(`/api/v3/workspaces/${workspaceId}/webhooks/${webhookId}/duplicate`, {
+    method: "POST",
+    cache: "no-store",
+  });
+
+  if (!response.ok) {
+    throw await parseV3ApiError(response);
+  }
+
+  const { data } = (await response.json()) as {
+    data: Omit<Webhook, "createdAt" | "updatedAt"> & { createdAt: string; updatedAt: string };
+  };
+
+  return {
+    ...data,
+    createdAt: new Date(data.createdAt),
+    updatedAt: new Date(data.updatedAt),
+  };
+}
