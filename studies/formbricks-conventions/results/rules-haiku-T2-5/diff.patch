index 000000000..7d4e7c11b
--- /dev/null
+++ b/apps/web/app/api/v3/workspaces/lib/webhook-duplicate.ts
@@ -0,0 +1,61 @@
+import "server-only";
+import { logger } from "@formbricks/logger";
+import { successResponse } from "@/app/api/v3/lib/response";
+import { requireV3WorkspaceAccess } from "@/app/api/v3/lib/auth";
+import { mapV3ThrownError } from "@/app/api/v3/lib/errors";
+import type { TV3AuditLog, TV3Authentication } from "@/app/api/v3/lib/types";
+import { assertNewlyAttachedSurveysWorkspaceVisible } from "@/lib/survey/visibility/outbound";
+import { createWebhook, getWebhookCopyInput } from "@/modules/integrations/webhooks/lib/webhook";
+
+type TOperationParams = {
+  workspaceId: string;
+  webhookId: string;
+  authentication: TV3Authentication;
+  requestId: string;
+  instance: string;
+  auditLog?: TV3AuditLog;
+};
+
+/**
+ * `POST /api/v3/workspaces/{workspaceId}/webhooks/{webhookId}/duplicate`. Creates a copy of the webhook
+ * with the same URL, triggers and surveys, named "Copy of <name>", and a new signing secret. The
+ * secret is returned once, in this response, as on create. Authorization is enforced here, not by the
+ * route wrapper, so every caller gets the same answer.
+ */
+export async function duplicateV3Webhook({
+  workspaceId,
+  webhookId,
+  authentication,
+  requestId,
+  instance,
+  auditLog,
+}: TOperationParams): Promise<Response> {
+  const log = logger.withContext({ requestId, workspaceId, webhookId });
+  const operation = "workspaces.webhooks.duplicate";
+
+  try {
+    const context = await requireV3WorkspaceAccess(authentication, workspaceId, "write", requestId, instance);
+    if (context instanceof Response) {
+      return context;
+    }
+
+    const input = await getWebhookCopyInput(context.workspaceId, webhookId);
+    await assertNewlyAttachedSurveysWorkspaceVisible(input.surveyIds ?? []);
+    const copy = await createWebhook(context.workspaceId, input);
+
+    if (auditLog) {
+      auditLog.organizationId = context.organizationId;
+      auditLog.targetId = copy.id;
+      // The input never carries the secret, so the audit trail does not either.
+      auditLog.newObject = input;
+    }
+
+    return successResponse(copy, {
+      requestId,
+      cache: "private, no-store",
+      status: 201,
+    });
+  } catch (error) {
+    return mapV3ThrownError(error, { log, requestId, instance, operation });
+  }
+}
