+/**
+ * The input for a copy of a webhook in the same workspace: same URL, triggers and surveys, named
+ * "Copy of <name>" (or "Copy of <url>" when the original has no name). The copy gets a new signing
+ * secret when it is created, so the caller must pass the result to `createWebhook` without a secret.
+ * A webhook that does not belong to `workspaceId` is reported as not found.
+ */
+export const getWebhookCopyInput = async (workspaceId: string, webhookId: string): Promise<TWebhookInput> => {
+  validateInputs([workspaceId, ZId], [webhookId, ZId]);
+
+  const source = await prisma.webhook.findFirst({
+    where: {
+      id: webhookId,
+      workspaceId,
+    },
+    select: {
+      name: true,
+      url: true,
+      triggers: true,
+      surveyIds: true,
+    },
+  });
+
+  if (!source) {
+    throw new ResourceNotFoundError("Webhook", webhookId);
+  }
+
+  return {
+    name: `Copy of ${source.name || source.url}`,
+    url: source.url,
+    triggers: source.triggers,
+    surveyIds: source.surveyIds,
+  };
+};
