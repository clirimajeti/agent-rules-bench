@@ -0,0 +1,33 @@
+/**
+ * POST /api/v3/workspaces/{workspaceId}/webhooks/{webhookId}/duplicate: copy a webhook into a new one with
+ * a new signing secret. Session cookie or x-api-key. Needs workspace write access, enforced by the operation.
+ */
+import { z } from "zod";
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { ZV3EmptyQuery } from "@/app/api/v3/lib/schemas";
+import { duplicateV3Webhook } from "@/app/api/v3/workspaces/lib/webhook-duplicate";
+
+const webhookParamsSchema = z.object({
+  workspaceId: z.cuid2(),
+  webhookId: z.cuid2(),
+});
+
+export const POST = withV3ApiWrapper({
+  auth: "both",
+  action: "created",
+  targetType: "webhook",
+  schemas: {
+    params: webhookParamsSchema,
+    query: ZV3EmptyQuery,
+  },
+  handler: async ({ parsedInput, authentication, requestId, instance, auditLog }) => {
+    return await duplicateV3Webhook({
+      workspaceId: parsedInput.params.workspaceId,
+      webhookId: parsedInput.params.webhookId,
+      authentication,
+      requestId,
+      instance,
+      auditLog,
+    });
+  },
+});
diff --git a/apps/web/app/api/v3/workspaces/lib/webhook-duplicate.ts b/apps/web/app/api/v3/workspaces/lib/webhook-duplicate.ts
