@@ -0,0 +1,113 @@
+"use client";
+
+import { RefreshCwIcon } from "lucide-react";
+import toast from "react-hot-toast";
+import { useTranslation } from "react-i18next";
+import { getV3ApiErrorMessage } from "@/modules/api/lib/v3-client";
+import { useRotateApiKey } from "@/modules/organization/settings/api-keys/hooks/use-rotate-api-key";
+import { Button } from "@/modules/ui/components/button";
+import {
+  Dialog,
+  DialogBody,
+  DialogContent,
+  DialogDescription,
+  DialogFooter,
+  DialogHeader,
+  DialogTitle,
+} from "@/modules/ui/components/dialog";
+import { ApiKeyDisplay } from "./api-key-display";
+
+interface RotateApiKeyDialogProps {
+  open: boolean;
+  setOpen: (open: boolean) => void;
+  apiKey: { id: string; label: string };
+  /** Called once the server has replaced the secret, so the table can drop anything it knew of the old one. */
+  onRotated: (apiKeyId: string) => void;
+}
+
+/**
+ * Two steps in one dialog: confirm, then show the new secret once.
+ *
+ * The secret lives only in the mutation result. Closing the dialog resets the mutation, which discards it,
+ * so there is no second chance to read it, matching how a newly created key behaves.
+ */
+export const RotateApiKeyDialog = ({ open, setOpen, apiKey, onRotated }: Readonly<RotateApiKeyDialogProps>) => {
+  const { t } = useTranslation();
+  const rotateMutation = useRotateApiKey();
+  const newKey = rotateMutation.data?.apiKey;
+
+  const handleOpenChange = (nextOpen: boolean) => {
+    // Never close mid-request: the user would lose the only response that carries the new secret.
+    if (!nextOpen && rotateMutation.isPending) return;
+    if (!nextOpen) rotateMutation.reset();
+    setOpen(nextOpen);
+  };
+
+  const handleRotate = () => {
+    rotateMutation.mutate(
+      { apiKeyId: apiKey.id },
+      {
+        onSuccess: (result) => {
+          onRotated(result.id);
+          toast.success(t("workspace.api_keys.api_key_rotated"));
+        },
+        onError: (error) => {
+          toast.error(getV3ApiErrorMessage(error, t("workspace.api_keys.unable_to_rotate_api_key")));
+        },
+      }
+    );
+  };
+
+  return (
+    <Dialog open={open} onOpenChange={handleOpenChange}>
+      <DialogContent
+        className="max-w-[540px]"
+        // Once the secret is on screen, a stray click outside must not throw it away.
+        disableCloseOnOutsideClick={Boolean(newKey) || rotateMutation.isPending}>
+        <DialogHeader className="flex justify-center gap-2">
+          <RefreshCwIcon className="size-4 text-slate-500" />
+          <div className="flex flex-col gap-1">
+            <DialogTitle className="w-full truncate text-left">
+              {newKey
+                ? t("workspace.api_keys.api_key_rotated_title", { label: apiKey.label })
+                : t("workspace.api_keys.rotate_api_key_title", { label: apiKey.label })}
+            </DialogTitle>
+            <DialogDescription className="w-full text-left">
+              {newKey
+                ? t("workspace.api_keys.api_key_security_warning_rotated")
+                : t("workspace.api_keys.rotate_api_key_confirmation")}
+            </DialogDescription>
+          </div>
+        </DialogHeader>
+
+        {newKey && (
+          <DialogBody>
+            <div
+              className="rounded-md border border-slate-200 bg-slate-50 p-3 font-mono text-sm text-slate-900"
+              data-testid="rotated-api-key">
+              <ApiKeyDisplay apiKey={newKey} />
+            </div>
+          </DialogBody>
+        )}
+
+        <DialogFooter>
+          {newKey ? (
+            <Button onClick={() => handleOpenChange(false)}>{t("common.done")}</Button>
+          ) : (
+            <>
+              <Button
+                variant="ghost"
+                disabled={rotateMutation.isPending}
+                onClick={() => handleOpenChange(false)}>
+                {t("common.cancel")}
+              </Button>
+              <Button variant="destructive" loading={rotateMutation.isPending} onClick={handleRotate}>
+                {t("workspace.api_keys.rotate")}
+              </Button>
+            </>
+          )}
+        </DialogFooter>
+      </DialogContent>
+    </Dialog>
+  );
+};
diff --git a/apps/web/modules/organization/settings/api-keys/hooks/use-rotate-api-key.ts b/apps/web/modules/organization/settings/api-keys/hooks/use-rotate-api-key.ts
