+"use client";
+
+import { QueryClient, QueryClientProvider } from "@tanstack/react-query";
+import { type ReactNode, useState } from "react";
+
+/**
+ * There is no app-wide `QueryClientProvider`; each route that uses TanStack Query mounts its own. The API
+ * keys page needs one for the rotate mutation, which goes through `/api/v3/api-keys`.
+ */
+export const ApiKeysQueryClientProvider = ({ children }: Readonly<{ children: ReactNode }>) => {
+  const [queryClient] = useState(() => new QueryClient());
+
+  return <QueryClientProvider client={queryClient}>{children}</QueryClientProvider>;
+};
