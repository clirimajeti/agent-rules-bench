@@ -0,0 +1,74 @@
+post:
+  operationId: rotateApiKeyV3
+  # Session-only by design: it backs the organization API keys settings page, and letting an API key
+  # rotate keys would let a leaked key mint itself a replacement. Excluded from the generated docs pages,
+  # like the session-only tag operations (ENG-2533); the operation stays in the bundle for the contract
+  # tests, which check it against the documented 401.
+  x-excluded: true
+  summary: Rotate an API key
+  description: |
+    Replaces the secret of API key `{apiKeyId}` and returns the new secret. The key keeps its id, label,
+    organization access and workspace permissions.
+
+    The old secret stops working immediately. The new one is returned in this response only; it is
+    stored hashed and cannot be read again. The key's `lastUsedAt` is cleared, because it describes the
+    secret and the new secret has not been used yet.
+
+    The caller needs to be allowed to manage the key. If the key grants organization `accessControl`
+    write access, the caller also needs to clear the organization's user-management floor, the same rule
+    that applies when such a key is created. An unknown key answers `403`, not `404`, so key ids cannot
+    be probed.
+  tags:
+    - V3 API Keys
+  parameters:
+    - in: path
+      name: apiKeyId
+      required: true
+      schema:
+        type: string
+        format: cuid2
+      description: The API key to rotate.
+  responses:
+    "200":
+      description: API key rotated
+      headers:
+        Cache-Control:
+          description: The body carries a secret, so it is never cached.
+          schema:
+            type: string
+            example: private, no-store
+      content:
+        application/json:
+          schema:
+            type: object
+            additionalProperties: false
+            required:
+              - data
+            properties:
+              data:
+                type: object
+                additionalProperties: false
+                required:
+                  - id
+                  - apiKey
+                properties:
+                  id:
+                    type: string
+                    format: cuid2
+                    description: The rotated key's id, unchanged by the rotation.
+                  apiKey:
+                    type: string
+                    pattern: "^fbk_"
+                    description: The new secret. Shown once; store it now.
+    "400":
+      $ref: ../components/responses/V3BadRequest.yml
+    "401":
+      $ref: ../components/responses/V3UnauthorizedSession.yml
+    "403":
+      $ref: ../components/responses/V3Forbidden.yml
+    "429":
+      $ref: ../components/responses/V3TooManyRequests.yml
+    "500":
+      $ref: ../components/responses/V3InternalServerError.yml
+  security:
+    - sessionAuth: []
