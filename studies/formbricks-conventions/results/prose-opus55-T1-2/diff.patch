+"use client";
+
+import { useMutation } from "@tanstack/react-query";
+import { rotateApiKey } from "../lib/api-client";
+
+/**
+ * Rotate one API key. The new secret is returned once and must never be cached, so this hook keeps it in
+ * the mutation result only: there is no query to invalidate, and the plaintext is gone when the
+ * mutation is reset.
+ */
+export const useRotateApiKey = () =>
+  useMutation({
+    mutationFn: (variables: { apiKeyId: string }) => rotateApiKey(variables),
+  });
