+ * secret's last use against a secret nobody has used yet, and "never used" is exactly the signal that
+ * tells an admin which integrations still have to be moved to the new value.
+ */
+export const rotateApiKey = async (apiKeyId: string): Promise<{ id: string; actualKey: string }> => {
+  validateInputs([apiKeyId, ZId]);
+
+  const { secret, lookupHash, hashedKey } = await generateApiKeySecret();
+
+  try {
+    const rotated = await prisma.apiKey.update({
+      where: { id: apiKeyId },
+      data: { hashedKey, lookupHash, lastUsedAt: null },
+      select: { id: true },
+    });
+
