@@ -0,0 +1,112 @@
+import { beforeEach, describe, expect, test, vi } from "vitest";
+import { AuthorizationError, OperationNotAllowedError } from "@formbricks/types/errors";
+import type { TV3AuditLog, TV3Authentication } from "@/app/api/v3/lib/types";
+import { assertCan } from "@/lib/authorization";
+import { getApiKeyForRotation, rotateApiKey } from "@/modules/organization/settings/api-keys/lib/api-key";
+import { assertCanGrantOrganizationAccess } from "@/modules/organization/settings/api-keys/lib/organization-access";
+import { rotateV3ApiKey } from "./operations";
+
+vi.mock("server-only", () => ({}));
+
+vi.mock("@/lib/authorization", () => ({ assertCan: vi.fn() }));
+vi.mock("@/lib/posthog", () => ({ capturePostHogEvent: vi.fn() }));
+vi.mock("@/modules/organization/settings/api-keys/lib/api-key", () => ({
+  getApiKeyForRotation: vi.fn(),
+  rotateApiKey: vi.fn(),
+}));
+vi.mock("@/modules/organization/settings/api-keys/lib/organization-access", () => ({
+  assertCanGrantOrganizationAccess: vi.fn(),
+}));
+vi.mock("@formbricks/logger", () => ({
+  logger: { withContext: vi.fn(() => ({ error: vi.fn(), warn: vi.fn() })) },
+}));
+
+const apiKeyId = "clkk1234567890123456789012";
+const organizationId = "clzz1234567890123456789012";
+const userId = "clus1234567890123456789012";
+
+const session = { user: { id: userId } } as unknown as TV3Authentication;
+const base = { authentication: session, apiKeyId, requestId: "req_1", instance: "/api/v3/api-keys" };
+
+const storedKey = {
+  id: apiKeyId,
+  organizationId,
+  organizationAccess: { accessControl: { read: true, write: true } },
+};
+
+beforeEach(() => {
+  vi.resetAllMocks();
+});
+
+describe("rotateV3ApiKey", () => {
+  test("returns the new secret once and records the key's organization in the audit log", async () => {
+    vi.mocked(getApiKeyForRotation).mockResolvedValue(storedKey);
+    vi.mocked(rotateApiKey).mockResolvedValue({ id: apiKeyId, actualKey: "fbk_newSecret" });
+    const auditLog = {} as TV3AuditLog;
+
+    const response = await rotateV3ApiKey({ ...base, auditLog });
+    const body = await response.json();
+
+    expect(response.status).toBe(200);
+    expect(response.headers.get("Cache-Control")).toBe("private, no-store");
+    expect(body.data).toEqual({ id: apiKeyId, apiKey: "fbk_newSecret" });
+    expect(auditLog).toMatchObject({ organizationId, targetId: apiKeyId });
+    // Neither the secret nor its hashes may reach the audit trail.
+    expect(JSON.stringify(auditLog)).not.toContain("fbk_newSecret");
+  });
+
+  test("authorizes against the key and the key's own organization access", async () => {
+    vi.mocked(getApiKeyForRotation).mockResolvedValue(storedKey);
+    vi.mocked(rotateApiKey).mockResolvedValue({ id: apiKeyId, actualKey: "fbk_newSecret" });
+
+    await rotateV3ApiKey(base);
+
+    expect(assertCan).toHaveBeenCalledWith({ type: "user", id: userId }, "apiKey.manage", {
+      type: "apiKey",
+      id: apiKeyId,
+    });
+    expect(assertCanGrantOrganizationAccess).toHaveBeenCalledWith(
+      userId,
+      organizationId,
+      storedKey.organizationAccess
+    );
+  });
+
+  test("answers 403 for an unknown key without rotating anything", async () => {
+    vi.mocked(getApiKeyForRotation).mockResolvedValue(null);
+
+    const response = await rotateV3ApiKey(base);
+
+    expect(response.status).toBe(403);
+    expect(rotateApiKey).not.toHaveBeenCalled();
+  });
+
+  test("answers 403 when the caller may not manage the key", async () => {
+    vi.mocked(getApiKeyForRotation).mockResolvedValue(storedKey);
+    vi.mocked(assertCan).mockRejectedValue(new AuthorizationError("Not authorized"));
+
+    const response = await rotateV3ApiKey(base);
+
+    expect(response.status).toBe(403);
+    expect(rotateApiKey).not.toHaveBeenCalled();
+  });
+
+  test("answers 403 when the key carries user-management access the caller could not grant", async () => {
+    vi.mocked(getApiKeyForRotation).mockResolvedValue(storedKey);
+    vi.mocked(assertCanGrantOrganizationAccess).mockRejectedValue(
+      new OperationNotAllowedError("User management is not allowed for your role")
+    );
+
+    const response = await rotateV3ApiKey(base);
+
+    expect(response.status).toBe(403);
+    expect(rotateApiKey).not.toHaveBeenCalled();
+  });
+
+  test("answers 401 without a session", async () => {
+    const response = await rotateV3ApiKey({ ...base, authentication: null });
+
+    expect(response.status).toBe(401);
+    expect(getApiKeyForRotation).not.toHaveBeenCalled();
+  });
+});
diff --git a/apps/web/app/api/v3/api-keys/lib/operations.ts b/apps/web/app/api/v3/api-keys/lib/operations.ts
new file mode 100644
index 000000000..9b8c602d1
--- /dev/null
+++ b/apps/web/app/api/v3/api-keys/lib/operations.ts
@@ -0,0 +1,71 @@
+import "server-only";
+import { logger } from "@formbricks/logger";
+import { mapV3ThrownError } from "@/app/api/v3/lib/errors";
+import { getV3SessionUserId } from "@/app/api/v3/lib/auth";
+import { problemForbidden, problemUnauthorized, successResponse } from "@/app/api/v3/lib/response";
+import type { TV3AuditLog, TV3Authentication } from "@/app/api/v3/lib/types";
+import { assertCan } from "@/lib/authorization";
+import { capturePostHogEvent } from "@/lib/posthog";
+import { getApiKeyForRotation, rotateApiKey } from "@/modules/organization/settings/api-keys/lib/api-key";
+import { assertCanGrantOrganizationAccess } from "@/modules/organization/settings/api-keys/lib/organization-access";
+import type { TV3RotatedApiKey } from "./schemas";
+
+/**
+ * Replace an API key's secret and return the new one, once.
+ *
+ * The organization is resolved from the key, never from the request, so a caller cannot pair someone
+ * else's key id with an organization they manage. An unknown key answers 403, not 404, so the route is not
+ * an existence oracle for key ids across the instance.
+ *
+ * Authorization is the union of what the actions behind this page already ask:
+ *   - `apiKey.manage` on the key, as `updateApiKeyAction` and `deleteApiKeyAction` do;
+ *   - the ENG-3075 user-management floor on the key's own organization access, as `createApiKeyAction`
+ *     does. Rotating hands the caller a working secret with that access, which is minting it in all but
+ *     name, so a role that could not create the key must not be able to rotate it either.
+ */
+export async function rotateV3ApiKey(params: {
+  authentication: TV3Authentication;
+  apiKeyId: string;
+  auditLog?: TV3AuditLog;
+  requestId: string;
+  instance: string;
+}): Promise<Response> {
+  const { authentication, apiKeyId, auditLog, requestId, instance } = params;
+  const log = logger.withContext({ requestId, apiKeyId });
+
+  const userId = getV3SessionUserId(authentication);
+  if (!userId) {
+    return problemUnauthorized(requestId, "Session required", instance);
+  }
+
+  try {
+    const apiKey = await getApiKeyForRotation(apiKeyId);
+    if (!apiKey) {
+      return problemForbidden(requestId, "You are not authorized to access this resource", instance);
+    }
+
+    await assertCan({ type: "user", id: userId }, "apiKey.manage", { type: "apiKey", id: apiKey.id });
+    await assertCanGrantOrganizationAccess(userId, apiKey.organizationId, apiKey.organizationAccess);
+
+    if (auditLog) {
+      auditLog.organizationId = apiKey.organizationId;
+      auditLog.targetId = apiKey.id;
+    }
+
+    const rotated = await rotateApiKey(apiKey.id);
+
+    capturePostHogEvent(
+      userId,
+      "api_key_rotated",
+      { api_key_id: apiKey.id },
+      { organizationId: apiKey.organizationId }
+    );
+
+    // The audit log deliberately records nothing about the secret: not the plaintext, and not the
+    // hashes either, which would let anyone reading audit exports check guesses offline.
+    const body: TV3RotatedApiKey = { id: rotated.id, apiKey: rotated.actualKey };
+    return successResponse(body, { requestId });
+  } catch (err) {
+    return mapV3ThrownError(err, { log, requestId, instance, operation: "apiKeys.rotate" });
+  }
+}
