+/**
+ * Deletes every tag of the workspace that no response carries. The `responses: { none: {} }` filter is
+ * evaluated across the whole workspace on purpose: a tag used only by a response the caller cannot see is
+ * still in use, so it must survive a bulk delete issued by a caller with a narrower view.
+ */
+export const deleteUnusedTags = async (
+  workspaceId: string
+): Promise<Result<{ count: number }, { code: TagError; message: string }>> => {
+  validateInputs([workspaceId, ZId]);
+
+  try {
+    const { count } = await prisma.tag.deleteMany({
+      where: {
+        workspaceId,
+        responses: { none: {} },
+      },
+    });
+
+    return ok({ count });
+  } catch (error) {
+    return err({
+      code: TagError.UNEXPECTED_ERROR,
+      message: error instanceof Error ? error.message : "Unknown error occurred",
+    });
+  }
+};
