+/**
+ * Delete every tag of a workspace that no response carries.
+ *
+ * "Unused" is the raw fact - no `TagsOnResponses` row at all - and deliberately not the count the tags
+ * table shows. That count only covers responses the caller may read (ENG-3282), so a tag used solely on
+ * a survey hidden from the caller shows 0 there; deleting on that number would let a member with partial
+ * visibility strip tags off responses they cannot see.
+ *
+ * The delete repeats the `none` filter instead of trusting the ids just read: a tag applied to a response
+ * between the two statements must survive, since deleting it would cascade the new link away.
+ * `deletedCount` is what the delete itself reports.
+ */
+export const deleteUnusedTags = async (
+  workspaceId: string
+): Promise<
+  Result<
+    { deletedCount: number; tags: Pick<TTag, "id" | "name">[] },
+    { code: TagError; message: string; meta?: Record<string, string> }
+  >
+> => {
+  validateInputs([workspaceId, ZId]);
+
+  try {
+    const result = await prisma.$transaction(async (tx) => {
+      const tags = await tx.tag.findMany({
+        where: { workspaceId, responses: { none: {} } },
+        select: { id: true, name: true },
+      });
+
+      if (tags.length === 0) {
+        return { deletedCount: 0, tags };
+      }
+
+      const { count } = await tx.tag.deleteMany({
+        where: { workspaceId, id: { in: tags.map((tag) => tag.id) }, responses: { none: {} } },
+      });
+
+      return { deletedCount: count, tags };
+    });
+
+    return ok(result);
+  } catch (error) {
+    return err({
+      code: TagError.UNEXPECTED_ERROR,
+      message: error instanceof Error ? error.message : "Unknown error occurred",
+    });
+  }
+};
+
