@@ -0,0 +1,69 @@
+post:
+  operationId: deleteUnusedTagsV3
+  # Session-only by design, so an API-key caller reading the published reference would only ever get a
+  # 401. Excluded from the generated docs pages until ENG-2533 decides between dropping the paths
+  # and opening them to API keys; the operation stays in the bundle for the contract tests.
+  x-excluded: true
+  summary: Delete unused tags
+  description: |
+    Deletes, in one request, every tag of `workspaceId` that no response carries, and reports how many
+    were deleted. Tags that are on at least one response are left as they are.
+
+    "Unused" means no response at all carries the tag, including responses of surveys the caller cannot
+    see. So a tag whose `count` reads `0` in `GET /api/v3/tags` only because its responses are hidden from
+    the caller is kept.
+
+    A POST custom method rather than a `DELETE` on the collection, like
+    `POST /api/v3/responses/batch-delete`. A workspace with nothing to delete answers `200` with
+    `deleted: 0`, so the call is safe to retry.
+
+    Read/write access to `workspaceId`, the same access deleting one tag needs.
+  tags:
+    - V3 Tags
+  requestBody:
+    required: true
+    content:
+      application/json:
+        schema:
+          type: object
+          additionalProperties: false
+          required:
+            - workspaceId
+          properties:
+            workspaceId:
+              type: string
+              format: cuid2
+              description: |
+                Workspace identifier. This is the canonical container ID for v3 APIs.
+  responses:
+    "200":
+      description: Unused tags deleted. `deleted` is `0` when every tag is in use.
+      content:
+        application/json:
+          schema:
+            type: object
+            required:
+              - data
+            properties:
+              data:
+                type: object
+                required:
+                  - deleted
+                properties:
+                  deleted:
+                    type: integer
+                    minimum: 0
+                    description: How many tags were deleted.
+                additionalProperties: false
+    "400":
+      $ref: ../components/responses/V3BadRequest.yml
+    "401":
+      $ref: ../components/responses/V3UnauthorizedSession.yml
+    "403":
+      $ref: ../components/responses/V3Forbidden.yml
+    "429":
+      $ref: ../components/responses/V3TooManyRequests.yml
+    "500":
+      $ref: ../components/responses/V3InternalServerError.yml
+  security:
+    - sessionAuth: []
