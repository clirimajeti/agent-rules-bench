+    createElement(QueryClientProvider, { client: queryClient }, children);
+  Wrapper.displayName = "useDeleteUnusedTagsTestWrapper";
+  return Wrapper;
+};
+
+const newQueryClient = () =>
+  new QueryClient({ defaultOptions: { mutations: { retry: false }, queries: { retry: false } } });
+
+describe("useDeleteUnusedTags", () => {
+  beforeEach(() => {
+    (globalThis as typeof globalThis & { IS_REACT_ACT_ENVIRONMENT?: boolean }).IS_REACT_ACT_ENVIRONMENT =
+      true;
+    vi.stubGlobal("fetch", vi.fn());
+  });
+
+  afterEach(() => {
+    vi.unstubAllGlobals();
+  });
+
+  test("resolves with the deleted count, then invalidates exactly this workspace's tag list", async () => {
+    vi.mocked(global.fetch).mockResolvedValue(
+      new Response(JSON.stringify({ data: { deleted: 4 } }), {
+        status: 200,
+        headers: { "Content-Type": "application/json" },
+      })
+    );
+    const queryClient = newQueryClient();
+    const invalidate = vi.spyOn(queryClient, "invalidateQueries");
+
+    const { result } = renderHook(() => useDeleteUnusedTags("ws_1"), { wrapper: wrapper(queryClient) });
+
+    // The count is what the toast shows, so it has to come back through `mutateAsync`.
+    await expect(result.current.mutateAsync()).resolves.toEqual({ deleted: 4 });
+    expect(vi.mocked(global.fetch).mock.calls[0][0]).toBe("/api/v3/tags/delete-unused");
+    expect(vi.mocked(global.fetch).mock.calls[0][1]).toMatchObject({
+      method: "POST",
+      body: JSON.stringify({ workspaceId: "ws_1" }),
+    });
+    expect(invalidate).toHaveBeenCalledWith({ queryKey: tagKeys.list("ws_1") });
+  });
+
+  test("surfaces a rejected request instead of reporting success", async () => {
+    vi.mocked(global.fetch).mockResolvedValue(
+      new Response(
+        JSON.stringify({ title: "Forbidden", status: 403, detail: "not yours", code: "forbidden" }),
+        { status: 403, headers: { "Content-Type": "application/problem+json" } }
+      )
+    );
+    const queryClient = newQueryClient();
+    const invalidate = vi.spyOn(queryClient, "invalidateQueries");
+
+    const { result } = renderHook(() => useDeleteUnusedTags("ws_1"), { wrapper: wrapper(queryClient) });
+
+    await expect(result.current.mutateAsync()).rejects.toThrow("not yours");
+    expect(invalidate).not.toHaveBeenCalled();
+  });
+});
