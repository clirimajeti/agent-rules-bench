+/**
+ * Unlike the single-tag mutations there is no tag to resolve the workspace from, so `workspaceId` comes
+ * from the caller. That is safe for the same reason as the responses batch delete: the value authorized
+ * against and the value the delete is filtered by are the same, so they cannot diverge.
+ */
+export async function deleteUnusedV3Tags(
+  params: TBaseParams & { workspaceId: string; auditLog?: TV3AuditLog }
+): Promise<Response> {
+  const { authentication, workspaceId, auditLog, requestId, instance } = params;
+
+  const access = await requireV3WorkspaceAccess(
+    authentication,
+    workspaceId,
+    "readWrite",
+    requestId,
+    instance
+  );
+  if (access instanceof Response) return access;
+
+  if (auditLog) {
+    auditLog.organizationId = access.organizationId;
+    auditLog.targetId = access.workspaceId;
+  }
+
+  const result = await deleteUnusedTags(access.workspaceId);
+  if (!result.ok) {
+    return problemInternalError(requestId, "Unable to delete unused tags", instance);
+  }
+
+  // The count only: the tags are removed in one statement, and a workspace can hold any number of them.
+  if (auditLog) auditLog.oldObject = { workspaceId: access.workspaceId, deleted: result.data.deleted };
+
+  return successResponse({ deleted: result.data.deleted }, { requestId });
+}
