+/**
+ * Delete every tag of the workspace that no response carries, and report how many went.
+ *
+ * Unlike the single-tag mutations there is no tag to resolve the workspace from, so the caller names it
+ * and is authorized against it directly - the same `readWrite` a single delete needs. The delete itself
+ * is scoped to that workspace, so the id cannot reach another tenant's tags.
+ *
+ * A workspace with nothing to delete answers 200 with `deleted: 0`, which keeps the call safe to retry.
+ */
+export async function deleteUnusedV3Tags(
+  params: TBaseParams & { workspaceId: string; auditLog?: TV3AuditLog }
+): Promise<Response> {
+  const { authentication, workspaceId, auditLog, requestId, instance } = params;
+
+  const access = await requireV3WorkspaceAccess(
+    authentication,
+    workspaceId,
+    "readWrite",
+    requestId,
+    instance
+  );
+  if (access instanceof Response) return access;
+
+  if (auditLog) auditLog.organizationId = access.organizationId;
+
+  const result = await deleteUnusedTags(access.workspaceId);
+  if (!result.ok) {
+    return problemInternalError(requestId, "Unable to delete unused tags", instance);
+  }
+
+  // Identity only, like the response batch delete: the ids and names are what make a bulk delete
+  // reviewable afterwards. `tags` is the set found unused; `deleted` is what the delete reported, and is
+  // lower only if a tag was applied to a response in between.
+  if (auditLog) {
+    auditLog.oldObject = {
+      workspaceId: access.workspaceId,
+      deleted: result.data.deletedCount,
+      tags: result.data.tags,
+    };
+  }
+
+  return successResponse({ deleted: result.data.deletedCount }, { requestId });
+}
