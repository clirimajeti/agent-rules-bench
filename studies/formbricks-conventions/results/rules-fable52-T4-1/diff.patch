+/**
+ * POST /api/v3/tags/delete-unused - delete every tag of a workspace that no response carries.
+ *
+ * A POST custom method rather than a `DELETE` on the collection, for the reason
+ * `responses/batch-delete` gives: a distinct path cannot be reached by a collection delete that lost its
+ * filters. Session-only, like the other tag routes.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { ZV3EmptyQuery } from "@/app/api/v3/lib/schemas";
+import { deleteUnusedV3Tags } from "../lib/operations";
+import { ZV3DeleteUnusedTagsBody } from "../lib/schemas";
+
+export const POST = withV3ApiWrapper({
+  auth: "session",
+  action: "deleted",
+  targetType: "tag",
+  schemas: { query: ZV3EmptyQuery, body: ZV3DeleteUnusedTagsBody },
+  handler: async ({ authentication, parsedInput, auditLog, requestId, instance }) =>
+    deleteUnusedV3Tags({
+      authentication,
+      workspaceId: parsedInput.body.workspaceId,
+      auditLog,
+      requestId,
+      instance,
+    }),
+});
