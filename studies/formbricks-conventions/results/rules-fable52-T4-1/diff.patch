+/**
+ * Deletes every tag of the workspace that no response carries, in one statement.
+ *
+ * "Unused" is decided inside the `deleteMany` itself, against every response and not only the ones the
+ * caller may see. The count the tags table shows is visibility-filtered (ENG-3282), so a tag that reads
+ * `0` there can still sit on a response of a restricted survey; deleting by that number would strip
+ * tags from responses the caller cannot read. One statement also means a tag applied between a read
+ * and the delete cannot be removed by mistake.
+ */
+export const deleteUnusedTags = async (
+  workspaceId: string
+): Promise<Result<{ deleted: number }, { code: TagError; message: string }>> => {
+  validateInputs([workspaceId, ZId]);
+
+  try {
+    const { count } = await prisma.tag.deleteMany({
+      where: { workspaceId, responses: { none: {} } },
+    });
+
+    return ok({ deleted: count });
+  } catch (error) {
+    return err({
+      code: TagError.UNEXPECTED_ERROR,
+      message: error instanceof Error ? error.message : "Unknown error occurred",
+    });
+  }
+};
