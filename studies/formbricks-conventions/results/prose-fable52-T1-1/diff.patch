index 000000000..032d61e51
--- /dev/null
+++ b/apps/web/app/api/v3/api-keys/[apiKeyId]/rotate/route.ts
@@ -0,0 +1,22 @@
+/**
+ * POST /api/v3/api-keys/{apiKeyId}/rotate - replace the key's secret. The key keeps its id, label and
+ * access settings; the old secret stops working at once and the new one is in this response only.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { rotateV3ApiKey } from "../../lib/operations";
+import { ZV3ApiKeyIdParams } from "../../lib/schemas";
+
+export const POST = withV3ApiWrapper({
+  auth: "session",
+  action: "rotated",
+  targetType: "apiKey",
+  schemas: { params: ZV3ApiKeyIdParams },
+  handler: async ({ authentication, parsedInput, auditLog, requestId, instance }) =>
+    rotateV3ApiKey({
+      authentication,
+      apiKeyId: parsedInput.params.apiKeyId,
+      auditLog,
+      requestId,
+      instance,
+    }),
+});
diff --git a/apps/web/app/api/v3/api-keys/lib/operations.test.ts b/apps/web/app/api/v3/api-keys/lib/operations.test.ts
new file mode 100644
index 000000000..ac7a3296a
--- /dev/null
+++ b/apps/web/app/api/v3/api-keys/lib/operations.test.ts
@@ -0,0 +1,145 @@
+import { beforeEach, describe, expect, test, vi } from "vitest";
+import { OperationNotAllowedError } from "@formbricks/types/errors";
+import type { TV3AuditLog, TV3Authentication } from "@/app/api/v3/lib/types";
+import { can } from "@/lib/authorization";
+import { getApiKeyAccess, rotateApiKey } from "@/modules/organization/settings/api-keys/lib/api-key";
+import { assertCanGrantOrganizationAccess } from "@/modules/organization/settings/api-keys/lib/organization-access";
+import { rotateV3ApiKey } from "./operations";
+
+vi.mock("server-only", () => ({}));
+
+vi.mock("@formbricks/logger", () => ({
+  logger: { withContext: vi.fn(() => ({ error: vi.fn(), warn: vi.fn() })) },
+}));
+vi.mock("@/lib/authorization", () => ({ can: vi.fn() }));
+vi.mock("@/modules/organization/settings/api-keys/lib/api-key", () => ({
+  getApiKeyAccess: vi.fn(),
+  rotateApiKey: vi.fn(),
+}));
+vi.mock("@/modules/organization/settings/api-keys/lib/organization-access", () => ({
+  assertCanGrantOrganizationAccess: vi.fn(),
+}));
+
+const apiKeyId = "clkk1234567890123456789012";
+const organizationId = "clzz1234567890123456789012";
+const userId = "cluu1234567890123456789012";
+
+const session = { user: { id: userId }, expires: "" } as unknown as TV3Authentication;
+const base = { authentication: session, apiKeyId, requestId: "req_1", instance: "/api/v3/api-keys" };
+
+const readOnlyAccess = { accessControl: { read: true, write: false } };
+const rotated = {
+  id: apiKeyId,
+  label: "Production integration",
+  createdAt: new Date("2026-04-21T10:00:00.000Z"),
+  lastUsedAt: null,
+  organizationAccess: readOnlyAccess,
+  apiKeyWorkspaces: [],
+  actualKey: "fbk_new",
+};
+
+const allowRotation = () => {
+  vi.mocked(getApiKeyAccess).mockResolvedValue({ organizationId, organizationAccess: readOnlyAccess });
+  vi.mocked(can).mockResolvedValue(true);
+  vi.mocked(rotateApiKey).mockResolvedValue(rotated);
+};
+
+beforeEach(() => {
+  vi.resetAllMocks();
+});
+
+describe("rotateV3ApiKey", () => {
+  test("rotates a key the caller may manage and returns the new key", async () => {
+    allowRotation();
+
+    const response = await rotateV3ApiKey(base);
+
+    expect(response.status).toBe(200);
+    expect((await response.json()).data).toEqual({
+      id: apiKeyId,
+      label: "Production integration",
+      createdAt: "2026-04-21T10:00:00.000Z",
+      lastUsedAt: null,
+      apiKey: "fbk_new",
+    });
+    expect(can).toHaveBeenCalledWith({ type: "user", id: userId }, "apiKey.manage", {
+      type: "apiKey",
+      id: apiKeyId,
+    });
+    expect(rotateApiKey).toHaveBeenCalledWith(apiKeyId);
+  });
+
+  test("the response is never cached, because it carries the secret", async () => {
+    allowRotation();
+
+    const response = await rotateV3ApiKey(base);
+
+    expect(response.headers.get("Cache-Control")).toContain("no-store");
+  });
+
+  test("refuses an API key caller without rotating", async () => {
+    const apiKeyAuthentication = {
+      type: "apiKey",
+      apiKeyId: "clyy1234567890123456789012",
+      organizationId,
+      workspacePermissions: [],
+    } as unknown as TV3Authentication;
+
+    const response = await rotateV3ApiKey({ ...base, authentication: apiKeyAuthentication });
+
+    expect(response.status).toBe(401);
+    expect(rotateApiKey).not.toHaveBeenCalled();
+  });
+
+  test("answers an unknown key and a key the caller may not manage with the same 403", async () => {
+    vi.mocked(getApiKeyAccess).mockResolvedValue(null);
+    const unknown = await rotateV3ApiKey(base);
+
+    vi.mocked(getApiKeyAccess).mockResolvedValue({ organizationId, organizationAccess: readOnlyAccess });
+    vi.mocked(can).mockResolvedValue(false);
+    const notAllowed = await rotateV3ApiKey(base);
+
+    expect(unknown.status).toBe(403);
+    expect(notAllowed.status).toBe(403);
+    // Byte for byte, so the route cannot be used to learn which key ids exist.
+    expect(await unknown.json()).toEqual(await notAllowed.json());
+    expect(rotateApiKey).not.toHaveBeenCalled();
+  });
+
+  test("applies the mint action's organization-access gate to the key's own access (ENG-3075)", async () => {
+    const writeAccess = { accessControl: { read: true, write: true } };
+    vi.mocked(getApiKeyAccess).mockResolvedValue({ organizationId, organizationAccess: writeAccess });
+    vi.mocked(can).mockResolvedValue(true);
+    vi.mocked(assertCanGrantOrganizationAccess).mockRejectedValue(
+      new OperationNotAllowedError("User management is not allowed for your role")
+    );
+
+    const response = await rotateV3ApiKey(base);
+
+    expect(response.status).toBe(403);
+    expect(assertCanGrantOrganizationAccess).toHaveBeenCalledWith(userId, organizationId, writeAccess);
+    expect(rotateApiKey).not.toHaveBeenCalled();
+  });
+
+  test("audits the key and its organization, never the secret", async () => {
+    allowRotation();
+    const auditLog = {} as TV3AuditLog;
+
+    await rotateV3ApiKey({ ...base, auditLog });
+
+    expect(auditLog.targetId).toBe(apiKeyId);
+    expect(auditLog.organizationId).toBe(organizationId);
+    expect(JSON.stringify(auditLog)).not.toContain("fbk_new");
+  });
+
+  test("does not name the owning organization in the audit entry of a refused caller", async () => {
+    vi.mocked(getApiKeyAccess).mockResolvedValue({ organizationId, organizationAccess: readOnlyAccess });
+    vi.mocked(can).mockResolvedValue(false);
+    const auditLog = {} as TV3AuditLog;
+
+    await rotateV3ApiKey({ ...base, auditLog });
+
+    expect(auditLog.targetId).toBe(apiKeyId);
+    expect(auditLog.organizationId).toBeUndefined();
+  });
+});
diff --git a/apps/web/app/api/v3/api-keys/lib/operations.ts b/apps/web/app/api/v3/api-keys/lib/operations.ts
new file mode 100644
index 000000000..1ff7e6f41
--- /dev/null
+++ b/apps/web/app/api/v3/api-keys/lib/operations.ts
@@ -0,0 +1,82 @@
+import "server-only";
+import { OperationNotAllowedError } from "@formbricks/types/errors";
+import { getV3AuthorizationActor } from "@/app/api/v3/lib/auth";
+import { problemForbidden, problemUnauthorized, successResponse } from "@/app/api/v3/lib/response";
+import type { TV3AuditLog, TV3Authentication } from "@/app/api/v3/lib/types";
+import { can } from "@/lib/authorization";
+import { getApiKeyAccess, rotateApiKey } from "@/modules/organization/settings/api-keys/lib/api-key";
+import { assertCanGrantOrganizationAccess } from "@/modules/organization/settings/api-keys/lib/organization-access";
+import { serializeV3RotatedApiKey } from "../serializers";
+
+/**
+ * Rotate an API key: a new secret on the same key, shown once.
+ *
+ * Session only. An API key must not be able to mint secrets, its own included: a leaked key could
+ * otherwise rotate itself and lock its owner out while staying valid for the attacker.
+ *
+ * Three checks, in this order:
+ * 1. The key exists. An unknown id answers the same 403 as a key the caller may not manage, so ids
+ *    cannot be probed for existence.
+ * 2. `apiKey.manage` on the key, the same question the delete and rename actions ask.
+ * 3. The user-management floor (ENG-3075). Whoever rotates a key receives a working secret for
+ *    everything that key can do, which makes rotation a second way to mint it. A key with organization
+ *    write access can manage users, so handing out its secret needs the same `organization.manage_access`
+ *    that creating it does. Without this, an install that restricts user management to owners could
+ *    have that restriction rotated away by a manager.
+ */
+export async function rotateV3ApiKey({
+  authentication,
+  apiKeyId,
+  auditLog,
+  requestId,
+  instance,
+}: {
+  authentication: TV3Authentication;
+  apiKeyId: string;
+  auditLog?: TV3AuditLog;
+  requestId: string;
+  instance?: string;
+}): Promise<Response> {
+  if (auditLog) auditLog.targetId = apiKeyId;
+
+  const actor = getV3AuthorizationActor(authentication);
+  if (actor?.type !== "user") {
+    return problemUnauthorized(requestId, "Session required", instance);
+  }
+
+  const apiKeyAccess = await getApiKeyAccess(apiKeyId);
+  if (!apiKeyAccess) {
+    return problemForbidden(requestId, undefined, instance);
+  }
+
+  if (!(await can(actor, "apiKey.manage", { type: "apiKey", id: apiKeyId }))) {
+    return problemForbidden(requestId, undefined, instance);
+  }
+
+  // Set only once the caller is known to be allowed to see which organization owns the key.
+  if (auditLog) auditLog.organizationId = apiKeyAccess.organizationId;
+
+  try {
+    // The mint action's own gate, so creating and rotating cannot drift on which access is gated.
+    await assertCanGrantOrganizationAccess(
+      actor.id,
+      apiKeyAccess.organizationId,
+      apiKeyAccess.organizationAccess
+    );
+  } catch (error) {
+    if (!(error instanceof OperationNotAllowedError)) throw error;
+    return problemForbidden(
+      requestId,
+      "This key can manage organization members, so rotating it needs permission to manage members.",
+      instance
+    );
+  }
+
+  const { actualKey, ...rotatedApiKey } = await rotateApiKey(apiKeyId);
+
+  // The audit entry records that the secret changed and for which key. It never carries the secret or
+  // its hashes.
+  if (auditLog) auditLog.newObject = { id: rotatedApiKey.id, label: rotatedApiKey.label };
+
+  return successResponse(serializeV3RotatedApiKey(rotatedApiKey, actualKey), { requestId });
+}
