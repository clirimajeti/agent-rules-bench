@@ -0,0 +1,85 @@
+post:
+  operationId: rotateApiKeyV3
+  # Session-only by design: an API key must not be able to mint secrets, its own included. An API-key
+  # caller reading the published reference would only ever get a 401, so the operation is excluded from
+  # the generated docs pages (as the tags operations are) and stays in the bundle for the contract tests.
+  x-excluded: true
+  summary: Rotate an API key
+  description: |
+    Replaces the secret of an API key. The key keeps its id, label, organization access and workspace
+    permissions. The previous secret stops working immediately, and `lastUsedAt` is reset to `null`.
+
+    The new key is returned in `data.apiKey` and is not stored in readable form: this response is the
+    only place it appears.
+
+    Requires a session whose user may manage the key (organization owner or manager). Rotating a key
+    that has organization write access also requires permission to manage organization members, the
+    same rule that applies when such a key is created.
+
+    An unknown `apiKeyId` answers `403`, not `404`, so key ids cannot be probed for existence.
+  tags:
+    - V3 API Keys
+  parameters:
+    - in: path
+      name: apiKeyId
+      required: true
+      schema:
+        type: string
+        format: cuid2
+      description: The API key to rotate.
+  responses:
+    "200":
+      description: API key rotated successfully
+      content:
+        application/json:
+          schema:
+            type: object
+            required:
+              - data
+            properties:
+              data:
+                type: object
+                required:
+                  - id
+                  - label
+                  - createdAt
+                  - lastUsedAt
+                  - apiKey
+                properties:
+                  id:
+                    type: string
+                    format: cuid2
+                  label:
+                    type: string
+                  createdAt:
+                    type: string
+                    format: date-time
+                    description: When the key was created. A rotation does not change it.
+                  lastUsedAt:
+                    type:
+                      - string
+                      - "null"
+                    format: date-time
+                    description: Always `null` after a rotation, because the new secret has not been used.
+                  apiKey:
+                    type: string
+                    description: The new API key in full. Shown once.
+          example:
+            data:
+              id: clxx1234567890123456789012
