+"use client";
+
+import { useMutation } from "@tanstack/react-query";
+import { rotateApiKey } from "../lib/api-client";
+
+/**
+ * Rotate one API key. The new secret lives in this mutation's `data` and nowhere else on the client:
+ * `reset()` drops it, which is what "shown once" means here.
+ *
+ * `gcTime: 0` so the result is not kept in the mutation cache after the component that shows it is gone.
+ */
+export const useRotateApiKey = () =>
+  useMutation({
+    mutationFn: (variables: { apiKeyId: string }) => rotateApiKey(variables),
+    gcTime: 0,
+  });
