+import type { TV3RotatedApiKey } from "@/app/api/v3/api-keys/serializers";
+import { parseV3ApiError } from "@/modules/api/lib/v3-client";
+
+/**
+ * Rotate an API key. Resolves with the key's new secret, which the server returns this once only;
+ * throws a parsed `V3ApiError` on a non-2xx response so the caller can show the server's own message.
+ */
+export async function rotateApiKey({ apiKeyId }: { apiKeyId: string }): Promise<TV3RotatedApiKey> {
+  const response = await fetch(`/api/v3/api-keys/${encodeURIComponent(apiKeyId)}/rotate`, {
+    method: "POST",
+    cache: "no-store",
+  });
+  if (!response.ok) throw await parseV3ApiError(response);
+  return ((await response.json()) as { data: TV3RotatedApiKey }).data;
+}
