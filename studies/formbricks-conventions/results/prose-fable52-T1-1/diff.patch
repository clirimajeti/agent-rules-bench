+"use client";
+
+import { CircleAlert, FilesIcon, RefreshCwIcon } from "lucide-react";
+import toast from "react-hot-toast";
+import { useTranslation } from "react-i18next";
+import { getV3ApiErrorMessage } from "@/modules/api/lib/v3-client";
+import { Button } from "@/modules/ui/components/button";
+import {
+  Dialog,
+  DialogBody,
+  DialogContent,
+  DialogDescription,
+  DialogFooter,
+  DialogHeader,
+  DialogTitle,
+} from "@/modules/ui/components/dialog";
+import { useRotateApiKey } from "../hooks/use-rotate-api-key";
+import { copyApiKeyToClipboard } from "../lib/copy-api-key";
+
+interface RotateApiKeyDialogProps {
+  apiKey: { id: string; label: string };
+  onClose: () => void;
+  /** The key now has a new, unused secret. Called once, when the server confirms the rotation. */
+  onRotated: (apiKeyId: string) => void;
+}
+
+/**
+ * Two steps in one dialog: confirm, then show the new key.
+ *
+ * The parent mounts this only while a key is being rotated, and the new secret is read straight from
+ * the mutation result. So closing the dialog unmounts it and the secret is gone from the client; there
+ * is no way to bring it back, which is the "shown once" guarantee.
+ *
+ * While the request runs, and once the key is on screen, a click outside or Escape does not close the
+ * dialog: a stray click must not cost the user the only copy of the secret.
+ */
+export const RotateApiKeyDialog = ({ apiKey, onClose, onRotated }: Readonly<RotateApiKeyDialogProps>) => {
+  const { t } = useTranslation();
+  const rotate = useRotateApiKey();
+  const newApiKey = rotate.data?.apiKey;
+
+  const handleRotate = () =>
+    rotate.mutate(
+      { apiKeyId: apiKey.id },
+      {
+        onSuccess: () => {
+          toast.success(t("workspace.api_keys.api_key_rotated"));
+          onRotated(apiKey.id);
+        },
+        onError: (error) =>
+          toast.error(getV3ApiErrorMessage(error, t("workspace.api_keys.unable_to_rotate_api_key"))),
+      }
+    );
+
+  return (
+    <Dialog
+      open
+      onOpenChange={(open) => {
+        if (!open && !rotate.isPending) onClose();
+      }}>
+      <DialogContent width="narrow" hideCloseButton disableCloseOnOutsideClick>
+        <DialogHeader>
+          <div className="flex items-center gap-2">
+            {!newApiKey && <CircleAlert className="size-4" />}
+            <div>
+              <DialogTitle>
+                {newApiKey
+                  ? t("workspace.api_keys.api_key_rotated")
+                  : t("workspace.api_keys.rotate_api_key")}
+              </DialogTitle>
+              <DialogDescription>{apiKey.label}</DialogDescription>
+            </div>
+          </div>
+        </DialogHeader>
+
+        {newApiKey ? (
+          <>
+            <DialogBody>
+              <p>{t("workspace.api_keys.rotated_api_key_shown_once")}</p>
+              <div className="mt-4 flex items-center justify-between gap-2 rounded-md border border-slate-200 bg-slate-50 p-3">
+                <code className="text-sm break-all" data-testid="rotated-api-key">
+                  {newApiKey}
+                </code>
+                <Button
+                  type="button"
+                  size="icon"
+                  variant="ghost"
+                  className="shrink-0"
+                  aria-label={t("common.copy")}
+                  onClick={() => void copyApiKeyToClipboard(newApiKey, t)}>
+                  <FilesIcon />
+                </Button>
+              </div>
+            </DialogBody>
+            <DialogFooter>
+              <Button type="button" onClick={onClose}>
+                {t("common.done")}
+              </Button>
+            </DialogFooter>
+          </>
+        ) : (
+          <>
+            <DialogBody>
+              <p>{t("workspace.api_keys.rotate_api_key_confirmation")}</p>
+            </DialogBody>
+            <DialogFooter>
+              <Button type="button" variant="secondary" onClick={onClose} disabled={rotate.isPending}>
+                {t("common.cancel")}
+              </Button>
+              <Button
+                type="button"
+                variant="destructive"
+                onClick={handleRotate}
+                loading={rotate.isPending}
+                disabled={rotate.isPending}>
+                <RefreshCwIcon />
+                {t("workspace.api_keys.rotate")}
+              </Button>
+            </DialogFooter>
+          </>
+        )}
+      </DialogContent>
+    </Dialog>
+  );
+};
