+/** What authorizing a change to one key needs: the organization that owns it and the access it carries. */
+export const getApiKeyAccess = async (
+  apiKeyId: string
+): Promise<Pick<ApiKey, "organizationId" | "organizationAccess"> | null> => {
+  validateInputs([apiKeyId, ZId]);
+
+  try {
+    return await prisma.apiKey.findUnique({
+      where: { id: apiKeyId },
+      select: { organizationId: true, organizationAccess: true },
+    });
+  } catch (error) {
+    if (error instanceof Prisma.PrismaClientKnownRequestError) {
+      throw new DatabaseError(error.message);
+    }
+    throw error;
+  }
+};
+
+/**
+ * Replace a key's secret in place. The row keeps its id, so the label, the organization access, the
+ * workspace permissions and the authorization relationships projected from them all stay as they are,
+ * and nothing has to be reconciled. The old secret stops working with this write: both hashes are
+ * overwritten in one statement, so there is no moment where both secrets authenticate.
+ *
+ * `lastUsedAt` is cleared because it described a secret that no longer exists; the new one has never
+ * been used.
+ *
+ * The plaintext is returned once and stored nowhere.
+ */
+export const rotateApiKey = async (
+  apiKeyId: string
+): Promise<TApiKeyWithEnvironmentPermission & { actualKey: string }> => {
+  validateInputs([apiKeyId, ZId]);
+
+  try {
+    const { secret, lookupHash, hashedKey } = await generateApiKeySecret();
+
+    const rotatedApiKey = await prisma.apiKey.update({
+      where: { id: apiKeyId },
+      data: { hashedKey, lookupHash, lastUsedAt: null },
+      select: {
+        id: true,
+        label: true,
+        createdAt: true,
+        lastUsedAt: true,
+        organizationAccess: true,
+        apiKeyWorkspaces: {
+          select: {
+            permission: true,
+            workspaceId: true,
+          },
+        },
+      },
+    });
+
+    return { ...rotatedApiKey, actualKey: `fbk_${secret}` };
+  } catch (error) {
+    if (error instanceof Prisma.PrismaClientKnownRequestError) {
+      // Deleted between the caller's authorization check and this write.
+      if (error.code === PrismaErrorType.RecordNotFound) {
+        throw new ResourceNotFoundError("apiKey", apiKeyId);
+      }
+      throw new DatabaseError(error.message);
+    }
+    throw error;
+  }
+};
