diff --git a/apps/web/app/api/v3/api-keys/serializers.ts b/apps/web/app/api/v3/api-keys/serializers.ts
new file mode 100644
index 000000000..6aad96dd5
--- /dev/null
+++ b/apps/web/app/api/v3/api-keys/serializers.ts
@@ -0,0 +1,22 @@
+import type { TApiKeyWithEnvironmentPermission } from "@/modules/organization/settings/api-keys/types/api-keys";
+
+export type TV3RotatedApiKey = {
+  id: string;
+  label: string;
+  createdAt: string;
+  /** Always `null` after a rotation: the new secret has not been used. */
+  lastUsedAt: string | null;
+  /** The new key in full. This response is the only place it ever appears. */
+  apiKey: string;
+};
+
+export const serializeV3RotatedApiKey = (
+  apiKey: Pick<TApiKeyWithEnvironmentPermission, "id" | "label" | "createdAt" | "lastUsedAt">,
+  actualKey: string
+): TV3RotatedApiKey => ({
+  id: apiKey.id,
+  label: apiKey.label,
+  createdAt: apiKey.createdAt.toISOString(),
+  lastUsedAt: apiKey.lastUsedAt?.toISOString() ?? null,
+  apiKey: actualKey,
+});
