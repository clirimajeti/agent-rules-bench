@@ -0,0 +1,60 @@
+post:
+  operationId: deleteUnusedTagsV3
+  # Session-only by design, so an API-key caller reading the published reference would only ever get a
+  # 401. Excluded from the generated docs pages until ENG-2533 decides between dropping the paths
+  # and opening them to API keys; the operation stays in the bundle for the contract tests.
+  x-excluded: true
+  summary: Delete unused tags
+  description: |
+    Deletes every tag of the workspace that is not on any response, and answers how many were deleted.
+    A tag is unused only when no response carries it, whatever the caller is allowed to see, so a tag
+    that sits on responses of a restricted survey is kept.
+
+    Requires organization owner/manager, or a workspace team membership with read-write permission.
+  tags:
+    - V3 Tags
+  requestBody:
+    required: true
+    content:
+      application/json:
+        schema:
+          type: object
+          additionalProperties: false
+          required:
+            - workspaceId
+          properties:
+            workspaceId:
+              type: string
+              format: cuid2
+              description: The workspace whose unused tags are deleted.
+  responses:
+    "200":
+      description: Unused tags deleted successfully
+      content:
+        application/json:
+          schema:
+            type: object
+            required:
+              - data
+            properties:
+              data:
+                type: object
+                required:
+                  - deletedCount
+                properties:
+                  deletedCount:
+                    type: integer
+                    minimum: 0
+                    description: How many tags were deleted. `0` when every tag is in use.
+    "400":
+      $ref: ../components/responses/V3BadRequest.yml
+    "401":
+      $ref: ../components/responses/V3UnauthorizedSession.yml
+    "403":
+      $ref: ../components/responses/V3Forbidden.yml
+    "429":
+      $ref: ../components/responses/V3TooManyRequests.yml
+    "500":
+      $ref: ../components/responses/V3InternalServerError.yml
+  security:
+    - sessionAuth: []
