+import { type NextResponse } from "next/server";
+import { DatabaseError } from "@formbricks/types/errors";
+import { assertCan } from "@/lib/authorization";
+import { rotateApiKey } from "@/modules/organization/settings/api-keys/lib/api-key";
+import { getFormattedErrorMessage } from "@/lib/utils/error-message";
+import type { TV3Authentication, TV3AuditLog } from "@/app/api/v3/lib/types";
+import { problemUnauthorized } from "@/app/api/v3/lib/response";
+import { getV3SessionUserId } from "@/app/api/v3/lib/auth";
+import { getOrganizationIdFromApiKeyId } from "@/lib/utils/helper";
+
+type TRotateV3ApiKeyParams = {
+  apiKeyId: string;
+  authentication: TV3Authentication;
+  auditLog: TV3AuditLog;
+  requestId: string;
+  instance: string;
+};
+
+/** POST /api/v3/api-keys/{apiKeyId}/rotate */
+export const rotateV3ApiKey = async ({
+  apiKeyId,
+  authentication,
+  auditLog,
+  requestId,
+  instance,
+}: TRotateV3ApiKeyParams): Promise<NextResponse> => {
+  if (!authentication) {
+    auditLog.status = "failure";
+    return problemUnauthorized();
+  }
+
+  const userId = getV3SessionUserId(authentication);
+  if (!userId) {
+    auditLog.status = "failure";
+    return problemUnauthorized();
+  }
+
+  try {
+    const organizationId = await getOrganizationIdFromApiKeyId(apiKeyId);
+
+    await assertCan({ type: "user", id: userId }, "apiKey.manage", {
+      type: "apiKey",
+      id: apiKeyId,
+    });
+
+    auditLog.organizationId = organizationId;
+    auditLog.apiKeyId = apiKeyId;
+
+    const result = await rotateApiKey(apiKeyId, userId);
+
+    auditLog.newObject = { apiKeyId: result.id };
+    auditLog.status = "success";
+
+    return NextResponse.json({
+      data: {
+        id: result.id,
+        label: result.label,
+        createdAt: result.createdAt,
+        lastUsedAt: result.lastUsedAt,
+        organizationAccess: result.organizationAccess,
+        apiKeyWorkspaces: result.apiKeyWorkspaces,
+        actualKey: result.actualKey,
+      },
+    });
+  } catch (error) {
+    auditLog.status = "failure";
+    const message = error instanceof DatabaseError ? error.message : getFormattedErrorMessage(error);
+    return NextResponse.json(
+      {
+        error: {
+          code: "internal",
+          message,
+        },
+      },
+      { status: 500 }
+    );
+  }
+};
