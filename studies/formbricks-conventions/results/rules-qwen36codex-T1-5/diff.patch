+/** POST /api/v3/api-keys/{apiKeyId}/rotate — rotate the secret for an API key. */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { ZV3EmptyQuery } from "@/app/api/v3/lib/schemas";
+import { ZV3ApiKeyIdParams } from "../../schemas";
+import { rotateV3ApiKey } from "./operations";
+
+export const POST = withV3ApiWrapper({
+  auth: "session",
+  action: "rotated",
+  targetType: "apiKey",
+  schemas: { params: ZV3ApiKeyIdParams, query: ZV3EmptyQuery },
+  handler: async ({ parsedInput, authentication, auditLog, requestId, instance }) =>
+    rotateV3ApiKey({
+      apiKeyId: parsedInput.params.apiKeyId,
+      authentication,
+      auditLog,
+      requestId,
+      instance,
+    }),
+});
