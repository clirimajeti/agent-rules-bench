+
+/**
+ * Replace a key's secret in place. The row keeps its id, label, organization access and workspace
+ * permissions, so nothing that refers to the key (SpiceDB relationships, audit history) has to move,
+ * and the old secret stops working in the same write that makes the new one valid.
+ *
+ * `lastUsedAt` is cleared: it describes the secret, and the new one has not been used. That also lets
+ * the owner see when the consumers have picked the new secret up. A legacy (pre-`fbk_`) key leaves
+ * rotation as a v2 key.
+ */
+export const rotateApiKey = async (apiKeyId: string): Promise<{ id: string; actualKey: string }> => {
+  validateInputs([apiKeyId, ZId]);
+
+  try {
+    const { secret, lookupHash, hashedKey } = await generateApiKeySecret();
+
+    const rotated = await prisma.apiKey.update({
+      where: { id: apiKeyId },
+      data: { hashedKey, lookupHash, lastUsedAt: null },
+      select: { id: true },
+    });
+
+    return { id: rotated.id, actualKey: `fbk_${secret}` };
+  } catch (error) {
+    if (error instanceof Prisma.PrismaClientKnownRequestError) {
+      throw new DatabaseError(error.message);
+    }
+    throw error;
+  }
+};
