--- /dev/null
+++ b/apps/web/app/api/v3/api-keys/[apiKeyId]/rotate/route.ts
@@ -0,0 +1,24 @@
+/**
+ * POST /api/v3/api-keys/{apiKeyId}/rotate - replace the key's secret with a new one. The key keeps its
+ * id, label and access; the old secret stops working at once and the new one is returned this once.
+ *
+ * Session-only: an API key cannot rotate itself or another key.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { rotateV3ApiKey } from "../../lib/operations";
+import { ZV3ApiKeyIdParams } from "../../lib/schemas";
+
+export const POST = withV3ApiWrapper({
+  auth: "session",
+  action: "rotated",
+  targetType: "apiKey",
+  schemas: { params: ZV3ApiKeyIdParams },
+  handler: async ({ authentication, parsedInput, auditLog, requestId, instance }) =>
+    rotateV3ApiKey({
+      authentication,
+      apiKeyId: parsedInput.params.apiKeyId,
+      auditLog,
+      requestId,
+      instance,
+    }),
+});
diff --git a/apps/web/app/api/v3/api-keys/lib/operations.test.ts b/apps/web/app/api/v3/api-keys/lib/operations.test.ts
new file mode 100644
index 000000000..cd076f6ea
