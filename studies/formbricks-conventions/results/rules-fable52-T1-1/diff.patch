+/**
+ * A fresh v2 secret with the two hashes stored for it. Hybrid approach for security + performance:
+ * the SHA-256 `lookupHash` finds the row through its index, the bcrypt `hashedKey` verifies the secret.
+ */
+const generateApiKeySecret = async (): Promise<{ secret: string; lookupHash: string; hashedKey: string }> => {
+  // 32 random bytes, base64url
+  const secret = randomBytes(32).toString("base64url");
+  return { secret, lookupHash: hashSha256(secret), hashedKey: await hashSecret(secret, 12) };
+};
