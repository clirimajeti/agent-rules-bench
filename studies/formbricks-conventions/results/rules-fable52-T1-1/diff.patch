@@ -0,0 +1,109 @@
+import { beforeEach, describe, expect, test, vi } from "vitest";
+import type { TV3AuditLog, TV3Authentication } from "@/app/api/v3/lib/types";
+import { can } from "@/lib/authorization";
+import {
+  getApiKeyOrganizationAccess,
+  rotateApiKey,
+} from "@/modules/organization/settings/api-keys/lib/api-key";
+import { canGrantOrganizationWriteAccess } from "@/modules/organization/settings/api-keys/lib/organization-access";
+import { rotateV3ApiKey } from "./operations";
+
+vi.mock("server-only", () => ({}));
+
+vi.mock("@/lib/authorization", () => ({ can: vi.fn() }));
+vi.mock("@/modules/organization/settings/api-keys/lib/api-key", () => ({
+  getApiKeyOrganizationAccess: vi.fn(),
+  rotateApiKey: vi.fn(),
+}));
+vi.mock("@/modules/organization/settings/api-keys/lib/organization-access", () => ({
+  canGrantOrganizationWriteAccess: vi.fn(),
+}));
+
+const userId = "clus1234567890123456789012";
+const apiKeyId = "clak1234567890123456789012";
+const organizationId = "clzz1234567890123456789012";
+
+const session = { user: { id: userId }, expires: "" } as TV3Authentication;
+const base = { authentication: session, apiKeyId, requestId: "req_1", instance: "/api/v3/api-keys" };
+
+const storedKey = (write: boolean) => ({
+  organizationId,
+  organizationAccess: { accessControl: { read: write, write } },
+});
+
+beforeEach(() => {
+  vi.resetAllMocks();
+  vi.mocked(rotateApiKey).mockResolvedValue({ id: apiKeyId, actualKey: "fbk_new" });
+});
+
+describe("rotateV3ApiKey", () => {
+  test("rotates a key the caller may manage and returns the new secret", async () => {
+    vi.mocked(getApiKeyOrganizationAccess).mockResolvedValue(storedKey(false));
+    vi.mocked(can).mockResolvedValue(true);
+    const auditLog = {} as TV3AuditLog;
+
+    const response = await rotateV3ApiKey({ ...base, auditLog });
+
+    expect(response.status).toBe(200);
+    expect(await response.json()).toEqual({ data: { id: apiKeyId, apiKey: "fbk_new" } });
+    // A response that carries a secret must never be stored by a cache.
+    expect(response.headers.get("Cache-Control")).toContain("no-store");
+    expect(can).toHaveBeenCalledWith({ type: "user", id: userId }, "apiKey.manage", {
+      type: "apiKey",
+      id: apiKeyId,
+    });
+    expect(auditLog).toMatchObject({ organizationId, targetId: apiKeyId });
+    // The floor is only asked about for a key that carries organization write access.
+    expect(canGrantOrganizationWriteAccess).not.toHaveBeenCalled();
+  });
+
+  test("403s an unknown key, so key ids cannot be probed for existence", async () => {
+    vi.mocked(getApiKeyOrganizationAccess).mockResolvedValue(null);
+
+    const response = await rotateV3ApiKey(base);
+
+    expect(response.status).toBe(403);
+    expect(can).not.toHaveBeenCalled();
+    expect(rotateApiKey).not.toHaveBeenCalled();
+  });
+
+  test("403s a caller who may not manage the key", async () => {
+    vi.mocked(getApiKeyOrganizationAccess).mockResolvedValue(storedKey(false));
+    vi.mocked(can).mockResolvedValue(false);
+
+    const response = await rotateV3ApiKey(base);
+
+    expect(response.status).toBe(403);
+    expect(rotateApiKey).not.toHaveBeenCalled();
+  });
+
+  test("403s a key with organization write access when the caller is below the user-management floor", async () => {
+    vi.mocked(getApiKeyOrganizationAccess).mockResolvedValue(storedKey(true));
+    vi.mocked(can).mockResolvedValue(true);
+    vi.mocked(canGrantOrganizationWriteAccess).mockResolvedValue(false);
+
+    const response = await rotateV3ApiKey(base);
+
+    expect(response.status).toBe(403);
+    expect(canGrantOrganizationWriteAccess).toHaveBeenCalledWith(userId, organizationId);
+    expect(rotateApiKey).not.toHaveBeenCalled();
+  });
+
+  test("rotates a key with organization write access for a caller who clears the floor", async () => {
+    vi.mocked(getApiKeyOrganizationAccess).mockResolvedValue(storedKey(true));
+    vi.mocked(can).mockResolvedValue(true);
+    vi.mocked(canGrantOrganizationWriteAccess).mockResolvedValue(true);
+
+    const response = await rotateV3ApiKey(base);
+
+    expect(response.status).toBe(200);
+    expect(rotateApiKey).toHaveBeenCalledWith(apiKeyId);
+  });
+
+  test("401s without a session user, whatever authenticated the request", async () => {
+    const response = await rotateV3ApiKey({ ...base, authentication: null });
+
+    expect(response.status).toBe(401);
+    expect(getApiKeyOrganizationAccess).not.toHaveBeenCalled();
+  });
+});
diff --git a/apps/web/app/api/v3/api-keys/lib/operations.ts b/apps/web/app/api/v3/api-keys/lib/operations.ts
new file mode 100644
index 000000000..ea09d313a
--- /dev/null
+++ b/apps/web/app/api/v3/api-keys/lib/operations.ts
@@ -0,0 +1,75 @@
+import "server-only";
+import { getV3SessionUserId } from "@/app/api/v3/lib/auth";
+import { problemForbidden, problemUnauthorized, successResponse } from "@/app/api/v3/lib/response";
+import type { TV3AuditLog, TV3Authentication } from "@/app/api/v3/lib/types";
+import { can } from "@/lib/authorization";
+import {
+  getApiKeyOrganizationAccess,
+  rotateApiKey,
+} from "@/modules/organization/settings/api-keys/lib/api-key";
+import { canGrantOrganizationWriteAccess } from "@/modules/organization/settings/api-keys/lib/organization-access";
+
+/** What `POST /api/v3/api-keys/{apiKeyId}/rotate` answers. `apiKey` is the only time the secret is readable. */
+export type TV3RotatedApiKey = { id: string; apiKey: string };
+
+type TRotateParams = {
+  authentication: TV3Authentication;
+  apiKeyId: string;
+  auditLog?: TV3AuditLog;
+  requestId: string;
+  instance?: string;
+};
+
+/**
+ * Replace an API key's secret, keeping its label and access.
+ *
+ * Authorization is the matrix `deleteApiKeyAction` and `updateApiKeyAction` already use
+ * (`apiKey.manage` on the key itself), plus one rule those do not need. Rotation hands the caller a
+ * working secret for the key, so for a key that carries organization `accessControl.write` it is the
+ * same grant as minting one: the caller must clear the organization's user-management floor
+ * (ENG-3075), or a manager on an owner-only install could rotate an owner's key and manage users
+ * with it.
+ *
+ * An unknown key answers 403, not 404, like every other v3 resource: a 404 would let any signed-in
+ * user probe key ids across the instance.
+ */
+export async function rotateV3ApiKey(params: TRotateParams): Promise<Response> {
+  const { authentication, apiKeyId, auditLog, requestId, instance } = params;
+
+  // The route is session-only, so this holds whenever the wrapper let the request through. It is
+  // checked here as well because the operation, not the route, is what decides who may rotate.
+  const userId = getV3SessionUserId(authentication);
+  if (!userId) {
+    return problemUnauthorized(requestId, "Session required", instance);
+  }
+
+  const apiKey = await getApiKeyOrganizationAccess(apiKeyId);
+  if (!apiKey) {
+    return problemForbidden(requestId, undefined, instance);
+  }
+
+  // Set before the permission checks so a refused attempt is recorded against the organization too.
+  if (auditLog) {
+    auditLog.organizationId = apiKey.organizationId;
+    auditLog.targetId = apiKeyId;
+  }
+
+  if (!(await can({ type: "user", id: userId }, "apiKey.manage", { type: "apiKey", id: apiKeyId }))) {
+    return problemForbidden(requestId, undefined, instance);
+  }
+
+  if (
+    apiKey.organizationAccess?.accessControl?.write === true &&
+    !(await canGrantOrganizationWriteAccess(userId, apiKey.organizationId))
+  ) {
+    return problemForbidden(
+      requestId,
+      "This key can manage organization members, and your role is not allowed to do that",
+      instance
+    );
+  }
+
+  const rotated = await rotateApiKey(apiKeyId);
+
+  return successResponse<TV3RotatedApiKey>({ id: rotated.id, apiKey: rotated.actualKey }, { requestId });
+}
