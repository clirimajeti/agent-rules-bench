@@ -0,0 +1,63 @@
+post:
+  operationId: rotateApiKeyV3
+  # Session-only by design, so an API-key caller reading the published reference would only ever get a
+  # 401: a key must not be able to rotate itself or another key. Excluded from the generated docs pages
+  # like the session-only tags operations (ENG-2533); the operation stays in the bundle for the contract
+  # tests.
+  x-excluded: true
+  summary: Rotate an API key
+  description: |
+    Replaces the secret of `{apiKeyId}` with a new one. The key keeps its id, label, organization access
+    and workspace permissions. The old secret stops working at once.
+
+    The new secret is in the response and is not readable again. Its `lastUsedAt` starts empty.
+
+    The caller must be allowed to manage the key. For a key with organization `accessControl.write`, the
+    caller must also be allowed to manage organization members, because rotation hands them a working
+    secret with that access. An unknown key answers `403`.
+  tags:
+    - V3 API Keys
+  parameters:
+    - in: path
+      name: apiKeyId
+      required: true
+      schema:
+        type: string
+        format: cuid2
+      description: The API key to rotate.
+  responses:
+    "200":
+      description: API key rotated successfully
+      content:
+        application/json:
+          schema:
+            type: object
+            required:
+              - data
+            properties:
+              data:
+                type: object
+                required:
+                  - id
+                  - apiKey
+                properties:
+                  id:
+                    type: string
+                    format: cuid2
+                    description: The rotated key's id. It does not change.
+                  apiKey:
+                    type: string
+                    description: The new secret, with its `fbk_` prefix. Shown this once.
+                    example: fbk_Zm9ybWJyaWNrcy1leGFtcGxlLXNlY3JldC1ub3QtcmVhbA
+    "400":
+      $ref: ../components/responses/V3BadRequest.yml
+    "401":
+      $ref: ../components/responses/V3UnauthorizedSession.yml
+    "403":
+      $ref: ../components/responses/V3Forbidden.yml
+    "429":
+      $ref: ../components/responses/V3TooManyRequests.yml
+    "500":
+      $ref: ../components/responses/V3InternalServerError.yml
+  security:
+    - sessionAuth: []
