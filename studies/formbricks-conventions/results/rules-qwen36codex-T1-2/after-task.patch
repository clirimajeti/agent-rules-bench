+      type: "apiKey",
+      id: parsedInput.apiKeyId,
+    });
+
+    ctx.auditLoggingCtx.organizationId = organizationId;
+    ctx.auditLoggingCtx.apiKeyId = parsedInput.apiKeyId;
+
+    const result = await rotateApiKey(parsedInput.apiKeyId, ctx.user.id);
+    ctx.auditLoggingCtx.newObject = { apiKeyId: result.id };
+    return result;
+  })
+);
