+export const rotateApiKey = async (
+  apiKeyId: string,
+  userId: string,
+): Promise<TApiKeyWithEnvironmentPermission & { actualKey: string }> => {
+  validateInputs([apiKeyId, ZId]);
+  try {
+    // Fetch the existing key to get its label and organizationAccess
+    const existingKey = await prisma.apiKey.findUnique({
+      where: { id: apiKeyId },
+      select: {
+        label: true,
+        organizationAccess: true,
+        organizationId: true,
+        apiKeyWorkspaces: {
+          select: {
+            workspaceId: true,
+            permission: true,
+          },
+        },
+      },
+    });
+
+    if (!existingKey) {
+      throw new DatabaseError("API key not found");
+    }
+
+    // Generate a new secret
+    const secret = randomBytes(32).toString("base64url");
+    const lookupHash = hashSha256(secret);
+    const hashedKey = await hashSecret(secret, 12);
+
+    // Update the key with new secret, keep existing label and permissions
+    const result = await prisma.apiKey.update({
+      where: { id: apiKeyId },
+      data: {
+        label: existingKey.label,
+        hashedKey,
+        lookupHash,
+        lastUsedAt: null,
+        organizationAccess: existingKey.organizationAccess,
+        apiKeyWorkspaces: {
+          // Delete existing workspace permissions and recreate them
+          deleteMany: { apiKeyId },
+          create: existingKey.apiKeyWorkspaces.map((wp) => ({
+            workspaceId: wp.workspaceId,
+            permission: wp.permission,
+          })),
+        },
+      },
+      include: {
+        apiKeyWorkspaces: true,
+      },
+    });
+
+    await runPostCommitProjection("api_key_rotate_relationship_reconciliation", () =>
+      reconcileApiKeyRelationships({ apiKeyIds: [apiKeyId] })
+    );
+
+    return { ...result, actualKey: `fbk_${secret}` };
+  } catch (error) {
+    if (error instanceof Prisma.PrismaClientKnownRequestError) {
+      throw new DatabaseError(error.message);
+    }
+    throw error;
+  }
+};
