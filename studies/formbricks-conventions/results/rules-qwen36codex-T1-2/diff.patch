+/**
+ * POST /api/v3/api-keys/{apiKeyId}/rotate — replace the secret for an existing API key.
+ *
+ * Thin adapter delegating to the framework-agnostic handler in the api-key lib.
+ */
+import { z } from "zod";
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { ZV3EmptyQuery } from "@/app/api/v3/lib/schemas";
+import { successResponse } from "@/app/api/v3/lib/response";
+import { ZId } from "@formbricks/types/common";
+import { rotateApiKey } from "@/modules/organization/settings/api-keys/lib/api-key";
+import { assertCan } from "@/lib/authorization";
+import { getOrganizationIdFromApiKeyId } from "@/lib/utils/helper";
+import { getV3SessionUserId } from "@/app/api/v3/lib/auth";
+
+const ZV3ApiKeyIdParams = z.strictObject({
+  apiKeyId: ZId,
+});
+type TV3ApiKeyIdParams = z.infer<typeof ZV3ApiKeyIdParams>;
+
+export const POST = withV3ApiWrapper({
+  auth: "both",
+  action: "rotated",
+  targetType: "apiKey",
+  schemas: { params: ZV3ApiKeyIdParams, query: ZV3EmptyQuery },
+  handler: async ({ parsedInput, authentication, auditLog, requestId, instance }) => {
+    const sessionUserId = getV3SessionUserId(authentication);
+    if (!sessionUserId) {
+      throw new Error("Session user is required for this operation");
+    }
+
+    const organizationId = await getOrganizationIdFromApiKeyId(parsedInput.params.apiKeyId);
+    await assertCan({ type: "user", id: sessionUserId }, "apiKey.manage", {
+      type: "apiKey",
+      id: parsedInput.params.apiKeyId,
+    });
+
+    const result = await rotateApiKey(parsedInput.params.apiKeyId, sessionUserId);
+
+    return successResponse(result, { requestId });
+  },
+});
