@@ -0,0 +1,29 @@
+"use client";
+
+import { useMutation, useQueryClient } from "@tanstack/react-query";
+import { rotateApiKey } from "../lib/api-client";
+
+/**
+ * Query key factory for api-keys data.
+ */
+export const apiKeyKeys = {
+  all: ["api-keys"] as const,
+  list: (organizationId: string) => [...apiKeyKeys.all, organizationId] as const,
+};
+
+/**
+ * Hook to rotate an API key.
+ *
+ * On success, the caller should invalidate the api-keys query so the list
+ * picks up the cleared `lastUsedAt` (rotation resets usage tracking).
+ */
+export const useRotateApiKey = (organizationId: string) => {
+  const queryClient = useQueryClient();
+
+  return useMutation({
+    mutationFn: (variables: { apiKeyId: string }) => rotateApiKey(variables.apiKeyId),
+    onSuccess: () => {
+      void queryClient.invalidateQueries({ queryKey: apiKeyKeys.list(organizationId) });
+    },
+  });
+};
