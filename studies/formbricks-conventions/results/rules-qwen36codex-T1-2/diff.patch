+import { parseV3ApiError } from "@/modules/api/lib/v3-client";
+
+/**
+ * Client fetchers for the api-keys v3 routes.
+ * Every call throws a parsed `V3ApiError` on a non-2xx response.
+ */
+
+const BASE_PATH = "/api/v3/api-keys";
+const MUTATION_TIMEOUT_MS = 15_000;
+
+export type TRotateApiKeyResponse = {
+  id: string;
+  label: string;
+  createdAt: string;
+  lastUsedAt: string | null;
+  organizationAccess: unknown;
+  apiKeyWorkspaces: Array<{ workspaceId: string; permission: string }>;
+  actualKey: string;
+};
+
+/**
+ * Rotate an existing API key, generating a new secret while preserving
+ * the key's label, organization access, and workspace permissions.
+ */
+export async function rotateApiKey(apiKeyId: string): Promise<TRotateApiKeyResponse> {
+  const response = await fetch(
+    `${BASE_PATH}/${encodeURIComponent(apiKeyId)}/rotate`,
+    {
+      method: "POST",
+      signal: AbortSignal.timeout(MUTATION_TIMEOUT_MS),
+    }
+  );
+
+  if (!response.ok) {
+    throw await parseV3ApiError(response);
+  }
+
+  return ((await response.json()) as { data: TRotateApiKeyResponse }).data;
+}
