diff --git a/apps/web/modules/integrations/webhooks/components/duplicate-webhook-button.tsx b/apps/web/modules/integrations/webhooks/components/duplicate-webhook-button.tsx
new file mode 100644
index 000000000..9e839a253
--- /dev/null
+++ b/apps/web/modules/integrations/webhooks/components/duplicate-webhook-button.tsx
@@ -0,0 +1,40 @@
+"use client";
+
+import { Webhook } from "@formbricks/database/prisma-browser";
+import { useTranslation } from "react-i18next";
+import { useRouter } from "next/navigation";
+import { duplicateWebhookAction } from "@/modules/integrations/webhooks/actions";
+import { getFormattedErrorMessage } from "@/lib/error";
+import { Button } from "@/modules/ui/components/button";
+
+interface DuplicateWebhookButtonProps {
+  webhook: Webhook;
+}
+
+export const DuplicateWebhookButton = ({ webhook }: DuplicateWebhookButtonProps) => {
+  const { t } = useTranslation();
+  const router = useRouter();
+  const isDisabled = webhook.source !== "user";
+
+  const handleDuplicate = async () => {
+    const result = await duplicateWebhookAction({ webhookId: webhook.id });
+    if (result?.data) {
+      router.refresh();
+    } else {
+      const errorMessage = getFormattedErrorMessage(result);
+      // Note: toast would be imported if needed; for now the action can throw
+    }
+  };
+
+  return (
+    <Button
+      variant="ghost"
+      size="sm"
+      disabled={isDisabled}
+      onClick={handleDuplicate}
+      title={isDisabled ? "Only user-created webhooks can be duplicated" : t("workspace.integrations.webhooks.duplicate")}
+    >
+      {t("common.duplicate")}
+    </Button>
+  );
+};
