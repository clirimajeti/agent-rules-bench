@@ -0,0 +1,53 @@
+"use client";
+
+import { useMutation, useQueryClient } from "@tanstack/react-query";
+import { Webhook } from "@formbricks/database/prisma-browser";
+import { useTranslation } from "react-i18next";
+import { useRouter } from "next/navigation";
+import toast from "react-hot-toast";
+import { Button } from "@/modules/ui/components/button";
+import { duplicateWebhook } from "@/modules/integrations/webhooks/lib/duplicate-webhook-client";
+
+interface DuplicateWebhookButtonProps {
+  webhook: Webhook;
+}
+
+/**
+ * Duplicate a webhook. Only user-created webhooks (source === "user") can be duplicated.
+ * The new copy gets "Copy of <name>" and its own secret. Refreshes the parent query cache.
+ */
+export const DuplicateWebhookButton = ({
+  webhook,
+}: Readonly<DuplicateWebhookButtonProps>) => {
+  const { t } = useTranslation();
+  const router = useRouter();
+  const queryClient = useQueryClient();
+  const isDisabled = webhook.source !== "user";
+
+  const duplicateMutation = useMutation({
+    mutationFn: () => duplicateWebhook({ webhookId: webhook.id }),
+    onSuccess: () => {
+      toast.success(t("workspace.integrations.webhooks.webhook_duplicated_successfully"));
+      queryClient.invalidateQueries({ queryKey: ["webhooks"] });
+      router.refresh();
+    },
+    onError: (error: Error) => {
+      toast.error(error.message);
+    },
+  });
+
+  const onClick = () => duplicateMutation.mutate();
+
+  return (
+    <Button
+      variant="ghost"
+      size="sm"
+      disabled={isDisabled}
+      onClick={onClick}
+      loading={duplicateMutation.isPending}
+      title={isDisabled ? "Only user-created webhooks can be duplicated" : t("workspace.integrations.webhooks.duplicate")}
+    >
+      {t("common.duplicate")}
+    </Button>
+  );
+};
