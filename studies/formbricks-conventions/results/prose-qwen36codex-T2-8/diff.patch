diff --git a/apps/web/modules/integrations/webhooks/lib/duplicate-webhook-client.ts b/apps/web/modules/integrations/webhooks/lib/duplicate-webhook-client.ts
new file mode 100644
index 000000000..62f933820
--- /dev/null
+++ b/apps/web/modules/integrations/webhooks/lib/duplicate-webhook-client.ts
@@ -0,0 +1,13 @@
+import { parseV3ApiError } from "@/modules/api/lib/v3-client";
+import type { Webhook } from "@formbricks/database/prisma-browser";
+
+/** Duplicate a webhook; the new copy gets "Copy of <name>" and its own secret. */
+export async function duplicateWebhook({ webhookId }: { webhookId: string }): Promise<Webhook> {
+  const response = await fetch(
+    `/api/v3/webhooks/${encodeURIComponent(webhookId)}/duplicate`,
+    { method: "POST", cache: "no-store", signal: AbortSignal.timeout(15_000) }
+  );
+  if (!response.ok) throw await parseV3ApiError(response);
+  const body = await response.json();
+  return body.data;
+}
