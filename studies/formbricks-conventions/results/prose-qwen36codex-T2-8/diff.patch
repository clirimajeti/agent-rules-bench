@@ -0,0 +1,49 @@
+import { generateWebhookSecret } from "@/lib/crypto";
+import { getWorkspaceIdFromWebhookId } from "@/lib/utils/helper";
+import { getWebhook } from "@/modules/api/v2/management/webhooks/[webhookId]/lib/webhook";
+import { createWebhook } from "@/modules/integrations/webhooks/lib/webhook";
+import { successResponse } from "@/app/api/v3/lib/response";
+import type { Webhook } from "@formbricks/database/prisma-browser";
+import type { TWebhookInput } from "@/modules/integrations/webhooks/types/webhooks";
+import type { TV3Authentication } from "@/app/api/v3/lib/types";
+import type { TV3AuditLog } from "@/app/api/v3/lib/types";
+
+export async function duplicateV3Webhook({
+  authentication,
+  webhookId,
+  auditLog,
+  requestId,
+  instance,
+}: {
+  authentication: TV3Authentication;
+  webhookId: string;
+  auditLog: TV3AuditLog;
+  requestId: string;
+  instance: string;
+}): Promise<Response> {
+  const workspaceId = await getWorkspaceIdFromWebhookId(webhookId);
+
+  const existingWebhookResult = await getWebhook(webhookId);
+  if (!existingWebhookResult.ok) {
+    return import("@/app/api/v3/lib/response").then((r) =>
+      r.problemNotFound(requestId, "Webhook", webhookId, instance)
+    );
+  }
+
+  const existing = existingWebhookResult.data;
+
+  // Build the new webhook input from the existing one
+  const webhookInput: TWebhookInput = {
+    name: existing.name ? `Copy of ${existing.name}` : null,
+    url: existing.url,
+    triggers: existing.triggers,
+    surveyIds: existing.surveyIds,
+  };
+
+  const newWebhook = await createWebhook(workspaceId, webhookInput, generateWebhookSecret());
+
+  auditLog.targetId = newWebhook.id;
+  auditLog.newObject = webhookInput;
+
+  return successResponse(newWebhook);
+}
