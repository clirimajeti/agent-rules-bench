@@ -0,0 +1,21 @@
+/**
+ * GET /api/v3/account/data-export - the signed-in user's own personal data, for the "Download my data"
+ * button on the profile settings page.
+ *
+ * Session-only, deliberately: the export is about the person behind the browser session, so an API key
+ * (which acts for a workspace, not a person) has nothing to export and is refused with 401.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { getV3SessionUserId } from "@/app/api/v3/lib/auth";
+import { problemUnauthorized } from "@/app/api/v3/lib/response";
+import { exportV3AccountData } from "./lib/operations";
+
+export const GET = withV3ApiWrapper({
+  auth: "session",
+  handler: async ({ authentication, requestId, instance }) => {
+    const userId = getV3SessionUserId(authentication);
+    if (!userId) return problemUnauthorized(requestId, "Not authenticated", instance);
+
+    return exportV3AccountData({ userId, requestId, instance });
+  },
+});
diff --git a/apps/web/app/api/v3/account/data-export/serializers.ts b/apps/web/app/api/v3/account/data-export/serializers.ts
new file mode 100644
index 000000000..24462bed4
--- /dev/null
+++ b/apps/web/app/api/v3/account/data-export/serializers.ts
@@ -0,0 +1,26 @@
+export type TV3AccountDataExport = {
+  name: string;
+  email: string;
+  locale: string;
+  notificationSettings: unknown;
+  organizationMemberships: { organizationName: string; role: string }[];
+};
+
+type TAccountDataUser = {
+  name: string;
+  email: string;
+  locale: string;
+  notificationSettings: unknown;
+  memberships: { role: string; organization: { name: string } }[];
+};
+
+export const serializeV3AccountDataExport = (user: TAccountDataUser): TV3AccountDataExport => ({
+  name: user.name,
+  email: user.email,
+  locale: user.locale,
+  notificationSettings: user.notificationSettings,
+  organizationMemberships: user.memberships.map((membership) => ({
+    organizationName: membership.organization.name,
+    role: membership.role,
+  })),
+});
