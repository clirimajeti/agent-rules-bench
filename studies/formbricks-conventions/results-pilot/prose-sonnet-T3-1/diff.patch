+get:
+  operationId: getAccountDataExportV3
+  # Session-only, like the tags endpoints: it backs the "Download my data" button on the profile
+  # settings page, so an API-key caller reading the published reference would only ever get a 401.
+  x-excluded: true
+  summary: Export my account data
+  description: |
+    Returns the signed-in user's own name, email, locale, notification settings and organization
+    memberships (organization name and role).
+
+    Session cookie only. The export is about the person behind the session, so it does not accept
+    `x-api-key`.
+  tags:
+    - V3 Account
+  responses:
+    "200":
+      description: Account data retrieved successfully
+      headers:
+        X-Request-Id:
+          schema:
+            type: string
+          description: Request correlation ID
+        Cache-Control:
+          schema:
+            type: string
+          example: private, no-store
+      content:
+        application/json:
+          schema:
+            type: object
+            required:
+              - data
+            properties:
+              data:
+                $ref: ../components/schemas/AccountDataExport.yml
+    "401":
+      $ref: ../components/responses/V3UnauthorizedSession.yml
+    "429":
+      $ref: ../components/responses/V3TooManyRequests.yml
+    "500":
+      $ref: ../components/responses/V3InternalServerError.yml
+  security:
+    - sessionAuth: []
