--- /dev/null
+++ b/apps/web/app/(app)/workspaces/[workspaceId]/settings/account/profile/components/DownloadMyData.tsx
@@ -0,0 +1,52 @@
+"use client";
+
+import { useQuery } from "@tanstack/react-query";
+import { DownloadIcon } from "lucide-react";
+import toast from "react-hot-toast";
+import { useTranslation } from "react-i18next";
+import { Button } from "@/modules/ui/components/button";
+import { accountDataKeys, getAccountDataExport } from "../lib/account-data-client";
+
+const EXPORT_FILE_NAME = "formbricks-account-data.json";
+
+const saveJsonFile = (data: unknown) => {
+  const blob = new Blob([JSON.stringify(data, null, 2)], { type: "application/json" });
+  const url = URL.createObjectURL(blob);
+  const link = document.createElement("a");
+  link.href = url;
+  link.download = EXPORT_FILE_NAME;
+  document.body.appendChild(link);
+  link.click();
+  link.remove();
+  URL.revokeObjectURL(url);
+};
+
+export const DownloadMyData = () => {
+  const { t } = useTranslation();
+
+  // Disabled until the click: the export is fetched on demand, and the query cache holds the result.
+  const { refetch, isFetching } = useQuery({
+    queryKey: accountDataKeys.all,
+    queryFn: ({ signal }) => getAccountDataExport(signal),
+    enabled: false,
+    staleTime: 0,
+    gcTime: 0,
+    retry: false,
+  });
+
+  const handleDownload = async () => {
+    const result = await refetch();
+    if (result.data) {
+      saveJsonFile(result.data);
+    } else {
+      toast.error(t("common.something_went_wrong_please_try_again"));
+    }
+  };
+
+  return (
+    <Button variant="secondary" size="sm" loading={isFetching} onClick={handleDownload}>
+      <DownloadIcon />
+      {t("workspace.settings.profile.download_my_data")}
+    </Button>
+  );
+};
diff --git a/apps/web/app/(app)/workspaces/[workspaceId]/settings/account/profile/lib/account-data-client.ts b/apps/web/app/(app)/workspaces/[workspaceId]/settings/account/profile/lib/account-data-client.ts
new file mode 100644
index 000000000..32b0bf5f0
--- /dev/null
+++ b/apps/web/app/(app)/workspaces/[workspaceId]/settings/account/profile/lib/account-data-client.ts
@@ -0,0 +1,23 @@
+import { parseV3ApiError } from "@/modules/api/lib/v3-client";
+
+export type TAccountDataExport = {
+  name: string;
+  email: string;
+  locale: string;
+  notificationSettings: unknown;
+  organizationMemberships: { organizationName: string; role: string }[];
+};
+
+export const accountDataKeys = {
+  all: ["account-data-export"] as const,
+};
+
+export async function getAccountDataExport(signal?: AbortSignal): Promise<TAccountDataExport> {
+  const response = await fetch("/api/v3/account/data-export", { signal });
+  if (!response.ok) {
+    throw await parseV3ApiError(response);
+  }
+
+  const body = (await response.json()) as { data: TAccountDataExport };
+  return body.data;
+}
diff --git a/apps/web/app/api/v3/account/data-export/lib/operations.ts b/apps/web/app/api/v3/account/data-export/lib/operations.ts
new file mode 100644
index 000000000..559d4bff7
--- /dev/null
+++ b/apps/web/app/api/v3/account/data-export/lib/operations.ts
@@ -0,0 +1,35 @@
+import "server-only";
+import { prisma } from "@formbricks/database";
+import { problemUnauthorized, successResponse } from "@/app/api/v3/lib/response";
+import { serializeV3AccountDataExport } from "../serializers";
+
+/**
+ * Scoped by the session's user id, never by a client-supplied one, so a caller can only ever read their
+ * own row. Only accepted memberships are exported: a pending one is an invitation, not a membership yet.
+ */
+export async function exportV3AccountData(params: {
+  userId: string;
+  requestId: string;
+  instance?: string;
+}): Promise<Response> {
+  const { userId, requestId, instance } = params;
+
+  const user = await prisma.user.findUnique({
+    where: { id: userId },
+    select: {
+      name: true,
+      email: true,
+      locale: true,
+      notificationSettings: true,
+      memberships: {
+        where: { accepted: true },
+        select: { role: true, organization: { select: { name: true } } },
+      },
+    },
+  });
+
+  // The session outlived its user (for example, the account was deleted in another tab).
+  if (!user) return problemUnauthorized(requestId, "Not authenticated", instance);
+
+  return successResponse(serializeV3AccountDataExport(user), { requestId });
+}
diff --git a/apps/web/app/api/v3/account/data-export/route.ts b/apps/web/app/api/v3/account/data-export/route.ts
