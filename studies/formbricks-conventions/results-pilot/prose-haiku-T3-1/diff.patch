@@ -0,0 +1,39 @@
+import { NextResponse } from "next/server";
+import { logger } from "@formbricks/logger";
+import { AuthenticationError, ResourceNotFoundError } from "@formbricks/types/errors";
+import { getUserDataExport } from "@/modules/account/lib/user-data-export";
+import { getSession } from "@/modules/auth/lib/session";
+
+export const GET = async () => {
+  try {
+    const session = await getSession();
+    if (!session?.user) {
+      throw new AuthenticationError("Not authenticated");
+    }
+
+    const data = await getUserDataExport(session.user.id);
+
+    return new NextResponse(JSON.stringify(data, null, 2), {
+      status: 200,
+      headers: {
+        "Content-Type": "application/json",
+        "Content-Disposition": 'attachment; filename="formbricks-my-data.json"',
+        "Cache-Control": "no-store",
+      },
+    });
+  } catch (error) {
+    if (error instanceof AuthenticationError) {
+      return NextResponse.json({ error: error.message }, { status: 401 });
+    }
+
+    if (error instanceof ResourceNotFoundError) {
+      return NextResponse.json({ error: error.message }, { status: 404 });
+    }
+
+    logger.error(
+      { errorName: error instanceof Error ? error.name : "unknown" },
+      "Failed to export account data"
+    );
+    return NextResponse.json({ error: "Failed to export account data" }, { status: 500 });
+  }
+};
