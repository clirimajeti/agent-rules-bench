diff --git a/apps/web/modules/account/lib/user-data-export.ts b/apps/web/modules/account/lib/user-data-export.ts
new file mode 100644
index 000000000..7017cc2ec
--- /dev/null
+++ b/apps/web/modules/account/lib/user-data-export.ts
@@ -0,0 +1,44 @@
+import "server-only";
+import { prisma } from "@formbricks/database";
+import { ResourceNotFoundError } from "@formbricks/types/errors";
+import { getUser } from "@/lib/user/service";
+
+export interface TUserDataExport {
+  name: string;
+  email: string;
+  locale: string;
+  notificationSettings: unknown;
+  organizationMemberships: { organizationName: string; role: string }[];
+}
+
+/**
+ * Collects the personal data the user may download: profile fields, notification settings and the
+ * organizations they belong to. Only accepted memberships are included, because a pending invite is not
+ * yet a membership the user holds.
+ */
+export const getUserDataExport = async (userId: string): Promise<TUserDataExport> => {
+  const user = await getUser(userId);
+  if (!user) {
+    throw new ResourceNotFoundError("User", userId);
+  }
+
+  const memberships = await prisma.membership.findMany({
+    where: { userId, accepted: true },
+    select: {
+      role: true,
+      organization: { select: { name: true } },
+    },
+    orderBy: { organization: { name: "asc" } },
+  });
+
+  return {
+    name: user.name,
+    email: user.email,
+    locale: user.locale,
+    notificationSettings: user.notificationSettings,
+    organizationMemberships: memberships.map((membership) => ({
+      organizationName: membership.organization.name,
+      role: membership.role,
+    })),
+  };
+};
