+"use client";
+
+import { useTranslation } from "react-i18next";
+import { formatDateTimeForDisplay } from "@/lib/utils/datetime";
+
+interface AccountActivityProps {
+  createdAt: Date;
+  lastLoginAt: Date | null;
+  locale: string;
+}
+
+export const AccountActivity = ({ createdAt, lastLoginAt, locale }: Readonly<AccountActivityProps>) => {
+  const { t } = useTranslation();
+
+  return (
+    <dl className="grid grid-cols-1 gap-4 sm:grid-cols-2">
+      <div className="flex flex-col">
+        <dt className="text-xs text-slate-600">{t("workspace.settings.profile.account_created")}</dt>
+        <dd className="text-sm font-semibold text-slate-800">{formatDateTimeForDisplay(createdAt, locale)}</dd>
+      </div>
+      <div className="flex flex-col">
+        <dt className="text-xs text-slate-600">{t("workspace.settings.profile.last_login")}</dt>
+        <dd className="text-sm font-semibold text-slate-800">
+          {lastLoginAt ? formatDateTimeForDisplay(lastLoginAt, locale) : t("workspace.settings.profile.never_logged_in")}
+        </dd>
+      </div>
+    </dl>
+  );
+};
