+/**
+ * A fresh secret with its two stored hashes. Hybrid approach for security + performance:
+ * 1. SHA-256 `lookupHash` for the indexed lookup
+ * 2. bcrypt `hashedKey` for verification
+ */
+const generateApiKeySecret = async () => {
+  // Generate a secure random secret (32 bytes base64url)
+  const secret = randomBytes(32).toString("base64url");
+  const lookupHash = hashSha256(secret);
+  const hashedKey = await hashSecret(secret, 12);
+  return { secret, lookupHash, hashedKey };
+};
+
+/**
+ * Replace the secret of an API key in place. The id, label, organization access and workspace
+ * permissions stay, so the key keeps its grants; `lastUsedAt` is reset because the new secret has not
+ * been used. The old secret stops working at once. Scoped by `organizationId`, so a key of another
+ * organization is never touched: returns `null` when no such key exists in this organization.
+ */
+export const rotateApiKey = async (
+  apiKeyId: string,
+  organizationId: string
+): Promise<(TApiKeyWithEnvironmentPermission & { actualKey: string }) | null> => {
+  validateInputs([apiKeyId, ZId], [organizationId, ZId]);
+
+  try {
+    const { secret, lookupHash, hashedKey } = await generateApiKeySecret();
+
+    const result = await prisma.apiKey.update({
+      where: { id: apiKeyId, organizationId },
+      data: { hashedKey, lookupHash, lastUsedAt: null },
+      select: {
+        id: true,
+        label: true,
+        createdAt: true,
+        lastUsedAt: true,
+        organizationAccess: true,
+        apiKeyWorkspaces: { select: { permission: true, workspaceId: true } },
+      },
+    });
+
+    return { ...result, actualKey: `fbk_${secret}` };
+  } catch (error) {
+    if (error instanceof Prisma.PrismaClientKnownRequestError) {
+      if (error.code === "P2025") return null;
+      throw new DatabaseError(error.message);
+    }
+    throw error;
+  }
+};
