+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { rotateApiKeyOperation } from "./lib/operations";
+import { ZRotateApiKeyPathParams, ZRotateApiKeyQuery } from "./schemas";
+
+/**
+ * `POST /api/internal/api-keys/{apiKeyId}/rotate?organizationId=`: replace an API key's secret and
+ * return the new key once. Internal and session-only.
+ */
+export const POST = withV3ApiWrapper({
+  auth: "session",
+  schemas: {
+    params: ZRotateApiKeyPathParams,
+    query: ZRotateApiKeyQuery,
+  },
+  action: "updated",
+  targetType: "apiKey",
+  handler: async ({ authentication, parsedInput, requestId, instance, auditLog }) =>
+    rotateApiKeyOperation({
+      authentication,
+      apiKeyId: parsedInput.params.apiKeyId,
+      organizationId: parsedInput.query.organizationId,
+      requestId,
+      instance,
+      auditLog,
+    }),
+});
