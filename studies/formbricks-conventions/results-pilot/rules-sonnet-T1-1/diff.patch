diff --git a/apps/web/modules/organization/settings/api-keys/lib/rotate-api-key-client.ts b/apps/web/modules/organization/settings/api-keys/lib/rotate-api-key-client.ts
new file mode 100644
index 000000000..ffa5e21d9
--- /dev/null
+++ b/apps/web/modules/organization/settings/api-keys/lib/rotate-api-key-client.ts
@@ -0,0 +1,26 @@
+import { parseV3ApiError } from "@/modules/api/lib/v3-client";
+import type { TApiKeyWithEnvironmentPermission } from "@/modules/organization/settings/api-keys/types/api-keys";
+
+export type TRotatedApiKey = Omit<TApiKeyWithEnvironmentPermission, "createdAt" | "lastUsedAt"> & {
+  createdAt: string;
+  lastUsedAt: string | null;
+  /** The new plaintext key. The server returns it once and never stores it. */
+  actualKey: string;
+};
+
+/** Replace the secret of an API key; label, access and permissions stay. */
+export async function rotateApiKey({
+  apiKeyId,
+  organizationId,
+}: {
+  apiKeyId: string;
+  organizationId: string;
+}): Promise<TRotatedApiKey> {
+  const response = await fetch(
+    `/api/internal/api-keys/${encodeURIComponent(apiKeyId)}/rotate?${new URLSearchParams({ organizationId })}`,
+    { method: "POST", cache: "no-store", signal: AbortSignal.timeout(15_000) }
+  );
+  if (!response.ok) throw await parseV3ApiError(response);
+  const body = (await response.json()) as { data: TRotatedApiKey };
+  return body.data;
+}
