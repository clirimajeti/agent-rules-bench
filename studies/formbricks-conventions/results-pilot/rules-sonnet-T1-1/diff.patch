@@ -0,0 +1,46 @@
+import "server-only";
+import { requireOrgActionAccess } from "@/app/api/internal/lib/organization-access";
+import { problemForbidden, successResponse } from "@/app/api/v3/lib/response";
+import type { TV3AuditLog, TV3Authentication } from "@/app/api/v3/lib/types";
+import { rotateApiKey } from "@/modules/organization/settings/api-keys/lib/api-key";
+
+/**
+ * Replace the secret of an API key of `organizationId`, keeping its label and access. Asks the same
+ * question as creating a key (`organization.manage_api_keys`). A missing key and one of another
+ * organization get the same 403, so the route cannot be used to probe key ids. The new secret is in the
+ * response once and nowhere else; the audit log records the key's id, never a secret or hash.
+ */
+export async function rotateApiKeyOperation({
+  authentication,
+  apiKeyId,
+  organizationId,
+  requestId,
+  instance,
+  auditLog,
+}: {
+  authentication: TV3Authentication;
+  apiKeyId: string;
+  organizationId: string;
+  requestId: string;
+  instance?: string;
+  auditLog?: TV3AuditLog;
+}): Promise<Response> {
+  if (auditLog) auditLog.targetId = apiKeyId;
+
+  const access = await requireOrgActionAccess({
+    authentication,
+    organizationId,
+    action: "organization.manage_api_keys",
+    requestId,
+    instance,
+  });
+  if (access instanceof Response) return access;
+  if (auditLog) auditLog.organizationId = access.organizationId;
+
+  const rotated = await rotateApiKey(apiKeyId, access.organizationId);
+  if (!rotated) return problemForbidden(requestId, undefined, instance);
+
+  if (auditLog) auditLog.newObject = { id: rotated.id, rotated: true };
+
+  return successResponse(rotated, { requestId });
+}
