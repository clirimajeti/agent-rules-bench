+
+// Returns the new plaintext key exactly once. The audit entry records only the key id, never the secret.
+export const rotateApiKeyAction = authenticatedActionClient.inputSchema(ZRotateApiKeyAction).action(
+  withAuditLogging("updated", "apiKey", async ({ ctx, parsedInput }) => {
+    const organizationId = await getOrganizationIdFromApiKeyId(parsedInput.id);
