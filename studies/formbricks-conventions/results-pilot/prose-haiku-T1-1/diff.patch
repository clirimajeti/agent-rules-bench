+/**
+ * Generates a fresh API key secret and the two hashes stored for it. The plaintext secret is only
+ * returned to the caller, which hands it to the user once; only the hashes are persisted.
+ */
+const generateApiKeySecret = async (): Promise<{ secret: string; lookupHash: string; hashedKey: string }> => {
+  // Generate a secure random secret (32 bytes base64url)
+  const secret = randomBytes(32).toString("base64url");
+
+  // Hybrid approach for security + performance:
+  // 1. SHA-256 lookup hash
+  // 2. bcrypt hash
+  return {
+    secret,
+    lookupHash: hashSha256(secret),
+    hashedKey: await hashSecret(secret, 12),
+  };
+};
