+/**
+ * Replaces the secret of an existing key. The label, organization access and workspace permissions are
+ * untouched. The previous secret stops working as soon as the update commits, and `lastUsedAt` is reset
+ * because usage of the old secret says nothing about the new one.
+ */
+export const rotateApiKey = async (
+  apiKeyId: string
+): Promise<TApiKeyWithEnvironmentPermission & { actualKey: string }> => {
+  validateInputs([apiKeyId, ZId]);
+
+  try {
+    const { secret, lookupHash, hashedKey } = await generateApiKeySecret();
+
+    const result = await prisma.apiKey.update({
+      where: { id: apiKeyId },
+      data: { hashedKey, lookupHash, lastUsedAt: null },
+      include: { apiKeyWorkspaces: true },
+    });
+
+    return { ...result, actualKey: `fbk_${secret}` };
+  } catch (error) {
+    if (error instanceof Prisma.PrismaClientKnownRequestError) {
+      throw new DatabaseError(error.message);
+    }
+    throw error;
+  }
+};
