+      type: "apiKey",
+      id: parsedInput.id,
+    });
+
+    ctx.auditLoggingCtx.organizationId = organizationId;
+    ctx.auditLoggingCtx.apiKeyId = parsedInput.id;
+
+    return await rotateApiKey(parsedInput.id);
+  })
+);
