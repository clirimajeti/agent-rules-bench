@@ -0,0 +1,67 @@
+post:
+  operationId: deleteUnusedTagsV3
+  # Session-only by design, like the other tag operations: an API-key caller would only ever get a 401.
+  # Excluded from the generated docs pages until ENG-2533 decides between dropping the paths and opening
+  # them to API keys; the operation stays in the bundle for the contract tests.
+  x-excluded: true
+  summary: Delete unused tags
+  description: |
+    Deletes every tag of the workspace that no response carries, and reports how many were deleted.
+
+    The check covers all responses in the workspace, not only the ones the caller can read, so a tag used
+    on a restricted survey's response is kept. Requires `readWrite` access to the workspace.
+
+    Session cookie only. Tags are managed from the Formbricks app (Workspace settings → Tags); this endpoint
+    backs that screen, so it does not accept `x-api-key`.
+  tags:
+    - V3 Tags
+  parameters:
+    - in: query
+      name: workspaceId
+      required: true
+      schema:
+        type: string
+        format: cuid2
+      description: |
+        Workspace identifier. This is the canonical container ID for v3 APIs.
+  responses:
+    "200":
+      description: Unused tags deleted. `deleted` is zero when every tag is in use.
+      headers:
+        X-Request-Id:
+          schema:
+            type: string
+          description: Request correlation ID
+        Cache-Control:
+          schema:
+            type: string
+          example: private, no-store
+      content:
+        application/json:
+          schema:
+            type: object
+            required:
+              - data
+            properties:
+              data:
+                type: object
+                required:
+                  - deleted
+                properties:
+                  deleted:
+                    type: integer
+                    minimum: 0
+                    description: How many unused tags were deleted.
+                additionalProperties: false
+    "400":
+      $ref: ../components/responses/V3BadRequest.yml
+    "401":
+      $ref: ../components/responses/V3UnauthorizedSession.yml
+    "403":
+      $ref: ../components/responses/V3Forbidden.yml
+    "429":
+      $ref: ../components/responses/V3TooManyRequests.yml
+    "500":
+      $ref: ../components/responses/V3InternalServerError.yml
+  security:
+    - sessionAuth: []
