+/**
+ * POST /api/v3/tags/delete-unused - delete every tag of a workspace that no response carries.
+ *
+ * A POST custom method rather than a `DELETE` on the tags collection: a collection-level delete that loses
+ * its scope would erase every tag, and a distinct path cannot be reached by accident. Session-only, matching
+ * the other tag routes.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { deleteUnusedV3Tags } from "../lib/operations";
+import { ZV3TagListQuery } from "../lib/schemas";
+
+export const POST = withV3ApiWrapper({
+  auth: "session",
+  schemas: { query: ZV3TagListQuery },
+  handler: async ({ authentication, parsedInput, requestId, instance }) =>
+    deleteUnusedV3Tags({
+      authentication,
+      workspaceId: parsedInput.query.workspaceId,
+      requestId,
+      instance,
+    }),
+});
