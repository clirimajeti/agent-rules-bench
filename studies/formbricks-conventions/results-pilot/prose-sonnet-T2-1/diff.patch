@@ -0,0 +1,14 @@
+"use client";
+
+import { useMutation, useQueryClient } from "@tanstack/react-query";
+import { duplicateWebhook } from "../lib/api-client";
+import { webhookKeys } from "../lib/query";
+
+/** Duplicate a webhook, then invalidate the list so the copy shows up in it. */
+export const useDuplicateWebhook = (workspaceId: string) => {
+  const queryClient = useQueryClient();
+  return useMutation({
+    mutationFn: (variables: { webhookId: string }) => duplicateWebhook(variables),
+    onSuccess: () => queryClient.invalidateQueries({ queryKey: webhookKeys.list(workspaceId) }),
+  });
+};
