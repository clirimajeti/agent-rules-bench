+post:
+  operationId: duplicateWebhookV3
+  # Session-only by design, like the tags operations: it backs the Webhooks settings screen.
+  x-excluded: true
+  summary: Duplicate a webhook
+  description: |
+    Creates a webhook with the same URL, triggers and surveys as `{webhookId}`, named `Copy of ` plus the
+    original name (or the original URL when it has no name). The copy gets a signing secret of its own.
+
+    Needs write access to the webhook's workspace. Takes no request body.
+  tags:
+    - V3 Webhooks
+  parameters:
+    - in: path
+      name: webhookId
+      required: true
+      schema:
+        type: string
+        format: cuid2
+      description: The webhook to copy.
+  responses:
+    "201":
+      description: The copy
+      headers:
+        X-Request-Id:
+          schema:
+            type: string
+          description: Request correlation ID
+        Cache-Control:
+          schema:
+            type: string
+          example: private, no-store
+        Location:
+          schema:
+            type: string
+          example: /api/v3/webhooks?workspaceId=clworkspace0000000000001
+      content:
+        application/json:
+          schema:
+            type: object
+            required:
+              - data
+            properties:
+              data:
+                $ref: ../components/schemas/WebhookResource.yml
+    "400":
+      $ref: ../components/responses/V3BadRequest.yml
+    "401":
+      $ref: ../components/responses/V3UnauthorizedSession.yml
+    "403":
+      $ref: ../components/responses/V3Forbidden.yml
+    "422":
+      $ref: ../components/responses/V3UnprocessableContent.yml
+    "429":
+      $ref: ../components/responses/V3TooManyRequests.yml
+    "500":
+      $ref: ../components/responses/V3InternalServerError.yml
+  security:
+    - sessionAuth: []
