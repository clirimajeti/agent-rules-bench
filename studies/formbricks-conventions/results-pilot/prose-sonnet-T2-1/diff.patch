+import { CopyIcon } from "lucide-react";
+import toast from "react-hot-toast";
+import { useTranslation } from "react-i18next";
+import { useDuplicateWebhook } from "@/modules/integrations/webhooks/hooks/use-duplicate-webhook";
+import { Button } from "@/modules/ui/components/button";
+
+export const DuplicateWebhookButton = ({
+  workspaceId,
+  webhookId,
+}: Readonly<{ workspaceId: string; webhookId: string }>) => {
+  const { t } = useTranslation();
+  const duplicateMutation = useDuplicateWebhook(workspaceId);
+
+  return (
+    <Button
+      type="button"
+      variant="outline"
+      size="sm"
+      loading={duplicateMutation.isPending}
+      onClick={() =>
+        duplicateMutation.mutate(
+          { webhookId },
+          {
+            onSuccess: () => toast.success(t("workspace.integrations.webhooks.webhook_duplicated_successfully")),
+            onError: (error) =>
+              toast.error(error.message || t("workspace.integrations.webhooks.webhook_duplicate_failed")),
+          }
+        )
+      }>
+      <CopyIcon className="mr-2 size-4" aria-hidden="true" />
+      {t("common.duplicate")}
+    </Button>
+  );
+};
