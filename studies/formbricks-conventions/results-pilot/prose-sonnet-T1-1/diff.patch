+/**
+ * Replace an API key's secret in place. The row keeps its id, label, organization access and workspace
+ * permissions; only the hashes change, and `lastUsedAt` resets because the new secret has not been used.
+ * The old secret stops authenticating as soon as the update commits. The plaintext is returned once.
+ */
+export const rotateApiKey = async (
+  apiKeyId: string
+): Promise<TApiKeyWithEnvironmentPermission & { actualKey: string }> => {
+  validateInputs([apiKeyId, ZId]);
+
+  try {
+    const secret = randomBytes(32).toString("base64url");
+    const lookupHash = hashSha256(secret);
+    const hashedKey = await hashSecret(secret, 12);
+
+    const rotated = await prisma.apiKey.update({
+      where: { id: apiKeyId },
+      data: { hashedKey, lookupHash, lastUsedAt: null },
+      select: {
+        id: true,
+        label: true,
+        createdAt: true,
+        lastUsedAt: true,
+        organizationAccess: true,
+        apiKeyWorkspaces: { select: { permission: true, workspaceId: true } },
+      },
+    });
+
+    return { ...rotated, actualKey: `fbk_${secret}` };
+  } catch (error) {
+    if (error instanceof Prisma.PrismaClientKnownRequestError) {
+      throw new DatabaseError(error.message);
+    }
+    throw error;
+  }
+};
