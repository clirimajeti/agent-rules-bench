index 000000000..c959c7c3f
--- /dev/null
+++ b/apps/web/app/api/v3/api-keys/lib/operations.ts
@@ -0,0 +1,62 @@
+import "server-only";
+import { AuthorizationError, ResourceNotFoundError } from "@formbricks/types/errors";
+import { getV3AuthorizationActor } from "@/app/api/v3/lib/auth";
+import {
+  problemForbidden,
+  problemUnauthorized,
+  successResponse,
+} from "@/app/api/v3/lib/response";
+import type { TV3AuditLog, TV3Authentication } from "@/app/api/v3/lib/types";
+import { assertCan } from "@/lib/authorization";
+import { getOrganizationIdFromApiKeyId } from "@/lib/utils/helper";
+import { rotateApiKey } from "@/modules/organization/settings/api-keys/lib/api-key";
+import { serializeV3RotatedApiKey } from "../serializers";
+
+type TRotateParams = {
+  authentication: TV3Authentication;
+  apiKeyId: string;
+  auditLog?: TV3AuditLog;
+  requestId: string;
+  instance?: string;
+};
+
+/**
+ * Replace a key's secret and return the new one, once. The organization is resolved from the key itself,
+ * never from the client, and an unknown key answers 403 rather than 404 so key ids cannot be probed.
+ * Same `apiKey.manage` check as delete: rotating grants nothing the key did not already hold.
+ */
+export async function rotateV3ApiKey({
+  authentication,
+  apiKeyId,
+  auditLog,
+  requestId,
+  instance,
+}: TRotateParams): Promise<Response> {
+  const actor = getV3AuthorizationActor(authentication);
+  if (actor?.type !== "user") {
+    return problemUnauthorized(requestId, "Session required", instance);
+  }
+
+  let organizationId: string;
+  try {
+    organizationId = await getOrganizationIdFromApiKeyId(apiKeyId);
+    await assertCan(actor, "apiKey.manage", { type: "apiKey", id: apiKeyId });
+  } catch (error) {
+    if (error instanceof ResourceNotFoundError || error instanceof AuthorizationError) {
+      return problemForbidden(requestId, "You are not authorized to access this resource", instance);
+    }
+    throw error;
+  }
+
+  if (auditLog) {
+    auditLog.organizationId = organizationId;
+    auditLog.targetId = apiKeyId;
+  }
+
+  const rotated = await rotateApiKey(apiKeyId);
+
+  // The audit trail records that the key changed, never the secret.
+  if (auditLog) auditLog.newObject = serializeV3RotatedApiKey(rotated, false);
+
+  return successResponse(serializeV3RotatedApiKey(rotated, true), { requestId });
+}
