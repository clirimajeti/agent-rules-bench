@@ -0,0 +1,92 @@
+post:
+  operationId: rotateApiKeyV3
+  # Session-only by design, like the tags operations: an API key cannot replace API keys.
+  x-excluded: true
+  summary: Rotate an API key
+  description: |
+    Replaces the key's secret with a new one. The label, organization access and workspace permissions
+    are kept, and `lastUsedAt` resets to `null`.
+
+    The old secret stops working immediately. The new key is in `actualKey`, in this response only; it
+    cannot be read again.
+
+    Same authorization as deleting the key. An unknown key answers `403`.
+  tags:
+    - V3 API Keys
+  parameters:
+    - in: path
+      name: apiKeyId
+      required: true
+      schema:
+        type: string
+        format: cuid2
+      description: The API key to rotate.
+  responses:
+    "200":
+      description: API key rotated
+      content:
+        application/json:
+          schema:
+            type: object
+            required:
+              - data
+            properties:
+              data:
+                type: object
+                required:
+                  - id
+                  - label
+                  - createdAt
+                  - lastUsedAt
+                  - organizationAccess
+                  - apiKeyWorkspaces
+                  - actualKey
+                properties:
+                  id:
+                    type: string
+                    format: cuid2
+                  label:
+                    type: string
+                  createdAt:
+                    type: string
+                    format: date-time
+                  lastUsedAt:
+                    type:
+                      - string
+                      - "null"
+                    format: date-time
+                  organizationAccess:
+                    type: object
+                    description: The key's organization-level access, unchanged by the rotation.
+                  apiKeyWorkspaces:
+                    type: array
+                    description: The key's workspace permissions, unchanged by the rotation.
+                    items:
+                      type: object
+                      required:
+                        - workspaceId
+                        - permission
+                      properties:
+                        workspaceId:
+                          type: string
+                        permission:
+                          type: string
+                          enum:
+                            - read
+                            - write
+                            - manage
+                  actualKey:
+                    type: string
+                    description: The new plaintext key. Shown once.
+    "400":
+      $ref: ../components/responses/V3BadRequest.yml
+    "401":
+      $ref: ../components/responses/V3UnauthorizedSession.yml
+    "403":
+      $ref: ../components/responses/V3Forbidden.yml
+    "429":
+      $ref: ../components/responses/V3TooManyRequests.yml
