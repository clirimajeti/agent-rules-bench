+"use client";
+
+import { useMutation } from "@tanstack/react-query";
+import { rotateApiKey } from "../lib/api-client";
+
+/**
+ * Rotate an API key. The new plaintext secret exists only in this response, so the caller holds it in
+ * component state rather than the query cache. The table is server-rendered, so there is no list query
+ * to invalidate.
+ */
+export const useRotateApiKey = () =>
+  useMutation({
+    mutationFn: (variables: { apiKeyId: string }) => rotateApiKey(variables),
+  });
