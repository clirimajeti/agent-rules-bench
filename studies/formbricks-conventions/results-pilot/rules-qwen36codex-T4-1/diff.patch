+/**
+ * POST /api/v3/tags/delete-unused — bulk delete tags that are not used on any response.
+ *
+ * Session-only, matching the other tag endpoints. Accepts a `workspaceId` query parameter and
+ * deletes every tag with zero response count in that workspace.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { deleteUnusedTags } from "./lib/operations";
+import { ZV3TagListQuery } from "../lib/schemas";
+
+export const POST = withV3ApiWrapper({
+  auth: "session",
+  action: "deleted",
+  targetType: "tag",
+  schemas: { query: ZV3TagListQuery },
+  handler: async ({ authentication, parsedInput, auditLog, requestId, instance }) =>
+    deleteUnusedTags({
+      authentication,
+      workspaceId: parsedInput.query.workspaceId,
+      auditLog,
+      requestId,
+      instance,
+    }),
+});
