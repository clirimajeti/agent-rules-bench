@@ -0,0 +1,59 @@
+"use client";
+
+import React from "react";
+import { useTranslation } from "react-i18next";
+import { Button } from "@/modules/ui/components/button";
+
+interface UserDataExport {
+  name: string;
+  email: string;
+  locale: string;
+  notificationSettings: {
+    alert: Record<string, boolean>;
+    unsubscribedOrganizationIds: string[] | undefined;
+  };
+  organizations: Array<{
+    name: string;
+    role: string;
+  }>;
+}
+
+export function DownloadMyDataButton() {
+  const { t } = useTranslation();
+  const [isDownloading, setIsDownloading] = React.useState(false);
+
+  const handleDownload = async () => {
+    setIsDownloading(true);
+    try {
+      const response = await fetch("/api/internal/user/data-export", {
+        method: "GET",
+        cache: "no-store",
+      });
+      if (!response.ok) {
+        return;
+      }
+      const data = (await response.json()) as { data: UserDataExport | null };
+      if (!data.data) {
+        return;
+      }
+      const jsonString = JSON.stringify(data.data, null, 2);
+      const blob = new Blob([jsonString], { type: "application/json" });
+      const url = URL.createObjectURL(blob);
+      const link = document.createElement("a");
+      link.href = url;
+      link.download = "formbricks-account-data.json";
+      document.body.appendChild(link);
+      link.click();
+      document.body.removeChild(link);
+      URL.revokeObjectURL(url);
+    } finally {
+      setIsDownloading(false);
+    }
+  };
+
+  return (
+    <Button variant="secondary" size="sm" onClick={handleDownload} loading={isDownloading}>
+      {t("workspace.settings.profile.download_my_data_button")}
+    </Button>
+  );
+}
