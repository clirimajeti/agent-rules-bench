diff --git a/apps/web/app/api/internal/user/data-export/route.ts b/apps/web/app/api/internal/user/data-export/route.ts
new file mode 100644
index 000000000..a093f78ae
--- /dev/null
+++ b/apps/web/app/api/internal/user/data-export/route.ts
@@ -0,0 +1,54 @@
+/**
+ * GET /api/internal/user/data-export — export the current user's personal data.
+ *
+ * Internal route (not `/api/v3`): only the Profile settings page calls this, and the response
+ * shape is a simple data export, not a full v3 resource. Session-only.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { successResponse } from "@/app/api/v3/lib/response";
+import { getOrganizationsByUserId } from "@/lib/organization/service";
+import { getUser } from "@/lib/user/service";
+
+interface UserDataExport {
+  name: string;
+  email: string;
+  locale: string;
+  notificationSettings: {
+    alert: Record<string, boolean>;
+    unsubscribedOrganizationIds: string[] | undefined;
+  };
+  organizations: Array<{
+    name: string;
+    role: string;
+  }>;
+}
+
+export const GET = withV3ApiWrapper({
+  auth: "session",
+  handler: async ({ authentication, requestId, instance }) => {
+    const userId = authentication && "user" in authentication ? authentication.user?.id : undefined;
+    if (!userId) {
+      return successResponse(null, { requestId });
+    }
+
+    const user = await getUser(userId);
+    if (!user) {
+      return successResponse(null, { requestId });
+    }
+
+    const organizations = await getOrganizationsByUserId(userId);
+
+    const data: UserDataExport = {
+      name: user.name,
+      email: user.email,
+      locale: user.locale,
+      notificationSettings: user.notificationSettings,
+      organizations: organizations.map((org) => ({
+        name: org.name,
+        role: org.memberships?.[0]?.role ?? "member",
+      })),
+    };
+
+    return successResponse(data, { requestId });
+  },
+});
