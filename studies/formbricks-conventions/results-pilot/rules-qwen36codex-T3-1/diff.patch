--- /dev/null
+++ b/apps/web/app/(app)/account/settings/profile/components/DownloadMyData.tsx
@@ -0,0 +1,50 @@
+"use client";
+
+import { useTranslation } from "react-i18next";
+import { TUser } from "@formbricks/types/user";
+import { Button } from "@/modules/ui/components/button";
+
+interface OrganizationMembership {
+  organizationId: string;
+  organizationName: string;
+  role: string;
+}
+
+interface DownloadMyDataProps {
+  user: TUser;
+  organizationMemberships: OrganizationMembership[];
+}
+
+export const DownloadMyData = ({ user, organizationMemberships }: Readonly<DownloadMyDataProps>) => {
+  const { t } = useTranslation();
+
+  const handleDownload = () => {
+    const data = {
+      name: user.name,
+      email: user.email,
+      locale: user.locale,
+      notificationSettings: user.notificationSettings,
+      organizationMemberships: organizationMemberships.map(({ organizationName, role }) => ({
+        organizationName,
+        role,
+      })),
+    };
+
+    const jsonString = JSON.stringify(data, null, 2);
+    const blob = new Blob([jsonString], { type: "application/json" });
+    const url = URL.createObjectURL(blob);
+    const link = document.createElement("a");
+    link.href = url;
+    link.download = "my-data.json";
+    document.body.appendChild(link);
+    link.click();
+    document.body.removeChild(link);
+    URL.revokeObjectURL(url);
+  };
+
+  return (
+    <Button variant="secondary" size="sm" onClick={handleDownload}>
+      {t("workspace.settings.profile.download_my_data")}
+    </Button>
+  );
+};
