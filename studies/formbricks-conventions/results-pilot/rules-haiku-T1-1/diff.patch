+/**
+ * POST /api/v3/api-keys/{apiKeyId}/rotate - replace an API key's secret.
+ *
+ * Returns the new key once, in the response body. The previous secret stops working immediately. Session-only,
+ * matching the organization API-key settings it serves.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { rotateV3ApiKey } from "../../lib/operations";
+import { ZV3ApiKeyIdParams } from "../../lib/schemas";
+
+export const POST = withV3ApiWrapper({
+  auth: "session",
+  action: "updated",
+  targetType: "apiKey",
+  schemas: { params: ZV3ApiKeyIdParams },
+  handler: async ({ authentication, parsedInput, auditLog, requestId, instance }) =>
+    rotateV3ApiKey({
+      authentication,
+      apiKeyId: parsedInput.params.apiKeyId,
+      auditLog,
+      requestId,
+      instance,
+    }),
+});
diff --git a/apps/web/app/api/v3/api-keys/lib/operations.ts b/apps/web/app/api/v3/api-keys/lib/operations.ts
new file mode 100644
index 000000000..44f6205ae
--- /dev/null
+++ b/apps/web/app/api/v3/api-keys/lib/operations.ts
@@ -0,0 +1,49 @@
+import "server-only";
+import { getV3SessionUserId } from "@/app/api/v3/lib/auth";
+import { problemForbidden, successResponse } from "@/app/api/v3/lib/response";
+import type { TV3AuditLog, TV3Authentication } from "@/app/api/v3/lib/types";
+import { assertCan } from "@/lib/authorization";
+import { getOrganizationIdFromApiKeyId } from "@/lib/utils/helper";
+import { rotateApiKey } from "@/modules/organization/settings/api-keys/lib/api-key";
+
+type TBaseParams = {
+  authentication: TV3Authentication;
+  requestId: string;
+  instance?: string;
+};
+
+/**
+ * Replaces an API key's secret. The organization is resolved from the key itself, never from the request,
+ * so the caller cannot supply the scope it is authorized against. The check is `apiKey.manage`, the same
+ * one the rest of the API-key settings use. Rotation keeps the key's label, organization access and
+ * workspace permissions, so it grants nothing that the key did not already carry.
+ *
+ * An unknown key answers 403, not 404, so a signed-in user cannot probe key ids across the instance.
+ */
+export async function rotateV3ApiKey(params: TBaseParams & { apiKeyId: string; auditLog?: TV3AuditLog }) {
+  const { authentication, apiKeyId, auditLog, requestId, instance } = params;
+
+  const userId = getV3SessionUserId(authentication);
+  if (!userId) {
+    return problemForbidden(requestId, "You are not authorized to access this resource", instance);
+  }
+
+  let organizationId: string;
+  try {
+    organizationId = await getOrganizationIdFromApiKeyId(apiKeyId);
+  } catch {
+    return problemForbidden(requestId, "You are not authorized to access this resource", instance);
+  }
+
+  await assertCan({ type: "user", id: userId }, "apiKey.manage", { type: "apiKey", id: apiKeyId });
+
+  if (auditLog) {
+    auditLog.organizationId = organizationId;
+    auditLog.targetId = apiKeyId;
+  }
+
+  // The plaintext secret is returned once, in this response only. It is never written to the audit log.
+  const rotated = await rotateApiKey(apiKeyId);
+
+  return successResponse(rotated, { requestId });
+}
