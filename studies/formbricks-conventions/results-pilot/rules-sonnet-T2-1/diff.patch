+"use client";
+
+import { useMutation } from "@tanstack/react-query";
+import { duplicateWebhook } from "@/modules/integrations/webhooks/lib/api-client";
+
+/**
+ * Duplicate a webhook. The list is server-rendered, so the caller refreshes the route on success; the
+ * mutation only serializes the request and exposes `isPending` to disable the button.
