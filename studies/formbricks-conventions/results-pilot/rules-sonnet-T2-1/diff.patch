+/**
+ * POST /api/v3/webhooks/{webhookId}/duplicate — copy a webhook (URL, triggers, surveys) under the name
+ * "Copy of <name>", with its own new signing secret.
+ *
+ * The workspace is resolved from the webhook, never from the request. Session-only: it backs the Duplicate
+ * button on the webhooks settings page, like the tags routes it follows.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { duplicateV3Webhook } from "../../lib/operations";
+import { ZV3WebhookIdParams } from "../../lib/schemas";
+
+export const POST = withV3ApiWrapper({
+  auth: "session",
+  action: "created",
+  targetType: "webhook",
+  schemas: { params: ZV3WebhookIdParams },
+  handler: async ({ authentication, parsedInput, auditLog, requestId, instance }) =>
+    duplicateV3Webhook({
+      authentication,
+      webhookId: parsedInput.params.webhookId,
+      auditLog,
+      requestId,
+      instance,
+    }),
+});
diff --git a/apps/web/app/api/v3/webhooks/lib/operations.ts b/apps/web/app/api/v3/webhooks/lib/operations.ts
new file mode 100644
index 000000000..400fc9669
--- /dev/null
+++ b/apps/web/app/api/v3/webhooks/lib/operations.ts
@@ -0,0 +1,103 @@
+import "server-only";
+import { InvalidInputError } from "@formbricks/types/errors";
+import { requireV3WorkspaceAccess } from "@/app/api/v3/lib/auth";
+import {
+  problemForbidden,
+  problemInternalError,
+  problemUnprocessableContent,
+  successResponse,
+} from "@/app/api/v3/lib/response";
+import type { TV3AuditLog, TV3Authentication } from "@/app/api/v3/lib/types";
+import {
+  SURVEY_NOT_WORKSPACE_VISIBLE_MESSAGE,
+  findNewlyAttachedNotWorkspaceVisibleSurveyIds,
+} from "@/lib/survey/visibility/outbound";
+import { getWebhook } from "@/modules/api/v2/management/webhooks/[webhookId]/lib/webhook";
+import { createWebhook } from "@/modules/integrations/webhooks/lib/webhook";
+import { serializeV3Webhook } from "../serializers";
+
+type TBaseParams = {
+  authentication: TV3Authentication;
+  requestId: string;
+  instance?: string;
+};
+
+/**
+ * Duplicate a webhook into a new one with the same URL, triggers and surveys, named "Copy of <name>", and
+ * its own signing secret.
+ *
+ * The workspace is resolved from the webhook itself, never from the request, so a caller cannot pair
+ * someone else's webhook id with a workspace they happen to have access to. Authorization is the one the
+ * create action used: write access to that workspace. An unknown webhook answers 403, not 404, so webhook
+ * ids cannot be probed.
+ */
+export async function duplicateV3Webhook(
+  params: TBaseParams & { webhookId: string; auditLog?: TV3AuditLog }
+): Promise<Response> {
+  const { webhookId, auditLog, requestId, instance } = params;
+
+  const source = await getWebhook(webhookId);
+  if (!source.ok) {
+    if (source.error.type === "not_found") {
+      return problemForbidden(requestId, "You are not authorized to access this resource", instance);
+    }
+    return problemInternalError(requestId, "Unable to duplicate webhook", instance);
+  }
+
+  const access = await requireV3WorkspaceAccess(
+    params.authentication,
+    source.data.workspaceId,
+    "readWrite",
+    requestId,
+    instance
+  );
+  if (access instanceof Response) return access;
+
+  if (auditLog) {
+    auditLog.organizationId = access.organizationId;
+    auditLog.oldObject = source.data;
+  }
+
+  // The copy is a new attachment, so it is held to the same outbound rule as creating a webhook: a survey
+  // that was restricted after the source was attached must not be carried over.
+  const blocked = await findNewlyAttachedNotWorkspaceVisibleSurveyIds(source.data.surveyIds, []);
+  if (blocked.length > 0) {
+    return problemUnprocessableContent(requestId, SURVEY_NOT_WORKSPACE_VISIBLE_MESSAGE, {
+      instance,
+      invalid_params: [{ name: "surveyIds", reason: SURVEY_NOT_WORKSPACE_VISIBLE_MESSAGE }],
+    });
+  }
+
+  let created;
+  try {
+    // No secret is passed, so `createWebhook` generates a fresh one for the copy.
+    created = await createWebhook(source.data.workspaceId, {
+      name: `Copy of ${source.data.name ?? ""}`.trim(),
+      url: source.data.url,
+      source: "user",
+      triggers: source.data.triggers,
+      surveyIds: source.data.surveyIds,
+    });
+  } catch (error) {
+    // The source URL is re-validated on create; one that no longer passes is the data's problem, not a fault.
+    if (error instanceof InvalidInputError) {
+      return problemUnprocessableContent(requestId, error.message, {
+        instance,
+        invalid_params: [{ name: "url", reason: error.message }],
+      });
+    }
+    throw error;
+  }
+
+  if (auditLog) {
+    auditLog.targetId = created.id;
+    // The audit trail never carries the signing secret.
+    const { secret: _secret, ...withoutSecret } = created;
+    auditLog.newObject = withoutSecret;
+  }
+
+  return successResponse(serializeV3Webhook({ ...created, secret: created.secret ?? "" }), {
+    requestId,
+    status: 201,
+  });
+}
