@@ -0,0 +1,114 @@
+post:
+  operationId: duplicateWebhookV3
+  # Session-only by design: it backs the Duplicate button on the webhooks settings page, so an API-key
+  # caller reading the published reference would only ever get a 401. Excluded from the generated docs
+  # pages, like the tags paths; the operation stays in the bundle for the contract tests.
+  x-excluded: true
+  summary: Duplicate a webhook
+  description: |
+    Creates a new webhook with the same URL, triggers and surveys as `{webhookId}`, named
+    `Copy of <original name>`. The copy gets its own signing secret, returned once in this response.
+    The source webhook is unchanged.
+
+    Session cookie only. Same authorization as creating a webhook: write access to the webhook's workspace.
+    An unknown webhook answers `403`, not `404`, so a caller cannot probe webhook ids.
+
+    Answers `422` when a survey on the source webhook is no longer visible to the whole workspace, because
+    outbound connections can only use workspace-visible surveys.
+  tags:
+    - V3 Webhooks
+  parameters:
+    - in: path
+      name: webhookId
+      required: true
+      schema:
+        type: string
+        format: cuid2
+      description: The webhook to copy.
+  responses:
+    "201":
+      description: Webhook duplicated successfully
+      headers:
+        X-Request-Id:
+          schema:
+            type: string
+          description: Request correlation ID
+        Cache-Control:
+          schema:
+            type: string
+          example: private, no-store
+      content:
+        application/json:
+          schema:
+            type: object
+            required:
+              - data
+            properties:
+              data:
+                type: object
+                required:
+                  - id
+                  - name
+                  - url
+                  - source
+                  - triggers
+                  - surveyIds
+                  - workspaceId
+                  - secret
+                  - createdAt
+                  - updatedAt
+                properties:
+                  id:
+                    type: string
+                    format: cuid2
+                  name:
+                    type:
+                      - string
+                      - "null"
+                  url:
+                    type: string
+                  source:
+                    type: string
+                    enum:
+                      - user
+                      - zapier
+                      - make
+                      - n8n
+                      - activepieces
+                  triggers:
+                    type: array
+                    items:
+                      type: string
+                      enum:
+                        - responseFinished
+                        - responseCreated
+                        - responseUpdated
+                  surveyIds:
+                    type: array
+                    items:
+                      type: string
+                      format: cuid2
+                  workspaceId:
+                    type: string
+                    format: cuid2
