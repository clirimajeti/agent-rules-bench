@@ -0,0 +1,31 @@
+import type { Webhook } from "@formbricks/database/prisma";
+
+/**
+ * The webhook as the settings page needs it right after a duplicate. `secret` is present because the copy's
+ * signing secret is shown once, exactly as in the create flow; no read route ever returns it again.
+ */
+export type TV3Webhook = {
+  id: string;
+  name: string | null;
+  url: string;
+  source: Webhook["source"];
+  triggers: Webhook["triggers"];
+  surveyIds: string[];
+  workspaceId: string;
+  secret: string;
+  createdAt: string;
+  updatedAt: string;
+};
+
+export const serializeV3Webhook = (webhook: Webhook & { secret: string }): TV3Webhook => ({
+  id: webhook.id,
+  name: webhook.name,
+  url: webhook.url,
+  source: webhook.source,
+  triggers: webhook.triggers,
+  surveyIds: webhook.surveyIds,
+  workspaceId: webhook.workspaceId,
+  secret: webhook.secret,
+  createdAt: webhook.createdAt.toISOString(),
+  updatedAt: webhook.updatedAt.toISOString(),
+});
