@@ -0,0 +1,52 @@
+"use client";
+
+import { CopyIcon } from "lucide-react";
+import { useRouter } from "next/navigation";
+import { useState } from "react";
+import { toast } from "react-hot-toast";
+import { useTranslation } from "react-i18next";
+import { Webhook } from "@formbricks/database/prisma-browser";
+import { getV3ApiErrorMessage } from "@/modules/api/lib/v3-client";
+import { WebhookCreatedModal } from "@/modules/integrations/webhooks/components/webhook-created-modal";
+import { useDuplicateWebhook } from "@/modules/integrations/webhooks/hooks/use-duplicate-webhook";
+import { Button } from "@/modules/ui/components/button";
+
+export const WebhookDuplicateButton = ({ webhookId }: Readonly<{ webhookId: string }>) => {
+  const { t } = useTranslation();
+  const router = useRouter();
+  const duplicateWebhook = useDuplicateWebhook();
+  const [duplicated, setDuplicated] = useState<Webhook | null>(null);
+
+  const handleDuplicate = async () => {
+    try {
+      const webhook = await duplicateWebhook.mutateAsync({ webhookId });
+      // The list is server-rendered: refreshing is what makes the copy appear in it.
+      router.refresh();
+      // The copy's signing secret is only ever shown here, once, as after creating a webhook.
+      setDuplicated({
+        ...webhook,
+        createdAt: new Date(webhook.createdAt),
+        updatedAt: new Date(webhook.updatedAt),
+      });
+    } catch (error) {
+      toast.error(getV3ApiErrorMessage(error, t("workspace.integrations.webhooks.duplicate_failed")));
+    }
+  };
+
+  return (
+    <>
+      <Button
+        type="button"
+        variant="secondary"
+        size="sm"
+        loading={duplicateWebhook.isPending}
+        onClick={handleDuplicate}>
+        <CopyIcon className="size-4" />
+        {t("common.duplicate")}
+      </Button>
+      {duplicated && (
+        <WebhookCreatedModal open={true} webhook={duplicated} onClose={() => setDuplicated(null)} />
+      )}
+    </>
+  );
+};
