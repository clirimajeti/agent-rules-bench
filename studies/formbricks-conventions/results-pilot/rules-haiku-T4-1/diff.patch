+/**
+ * Deletes every tag in the workspace that no response carries. The workspace is supplied rather than
+ * derived from a tag, because there is no single tag to resolve it from; the caller is authorized against
+ * that same value, so the two cannot diverge.
+ */
+export async function deleteUnusedV3Tags(
+  params: TBaseParams & { workspaceId: string; auditLog?: TV3AuditLog }
+): Promise<Response> {
+  const { workspaceId, auditLog, requestId, instance } = params;
+
+  const access = await requireV3WorkspaceAccess(
+    params.authentication,
+    workspaceId,
+    "readWrite",
+    requestId,
+    instance
+  );
+  if (access instanceof Response) return access;
+
+  const result = await deleteUnusedTags(access.workspaceId);
+  if (!result.ok) {
+    return problemInternalError(requestId, "Unable to delete unused tags", instance);
+  }
+
+  if (auditLog) {
+    auditLog.organizationId = access.organizationId;
+    auditLog.targetId = access.workspaceId;
+    // Only the count, not the tag names: a workspace can hold many tags, and the audit line should not
+    // grow with them.
+    auditLog.oldObject = { workspaceId: access.workspaceId, deleted: result.data.deleted };
+  }
+
+  return successResponse({ deleted: result.data.deleted }, { requestId });
+}
