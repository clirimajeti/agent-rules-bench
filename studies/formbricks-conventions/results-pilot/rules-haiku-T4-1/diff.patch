+/**
+ * POST /api/v3/tags/delete-unused - delete every tag in a workspace that no response carries.
+ *
+ * A POST custom method rather than a `DELETE` on the tag collection: a collection-level delete that loses
+ * its scope would erase every tag in the instance, and a distinct path cannot be reached by accident.
+ * Session-only, matching the tag operations it sits beside.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { deleteUnusedV3Tags } from "../lib/operations";
+import { ZV3DeleteUnusedTagsQuery } from "../lib/schemas";
+
+export const POST = withV3ApiWrapper({
+  auth: "session",
+  action: "deleted",
+  targetType: "tag",
+  schemas: { query: ZV3DeleteUnusedTagsQuery },
+  handler: async ({ authentication, parsedInput, auditLog, requestId, instance }) =>
+    deleteUnusedV3Tags({
+      authentication,
+      workspaceId: parsedInput.query.workspaceId,
+      auditLog,
+      requestId,
+      instance,
+    }),
+});
