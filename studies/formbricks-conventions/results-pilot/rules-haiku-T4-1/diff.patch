+/**
+ * Deletes every tag in the workspace that no response carries. The check is workspace-wide on purpose: a
+ * tag used only on responses the caller cannot read is still in use, so it must not be treated as unused
+ * just because the caller's visibility filter hides those responses.
+ */
+export const deleteUnusedTags = async (
+  workspaceId: string
+): Promise<Result<{ deleted: number }, { code: TagError; message: string; meta?: Record<string, string> }>> => {
+  validateInputs([workspaceId, ZId]);
+
+  try {
+    const { count } = await prisma.tag.deleteMany({
+      where: {
+        workspaceId,
+        responses: { none: {} },
+      },
+    });
+
+    return ok({ deleted: count });
+  } catch (error) {
+    return err({
+      code: TagError.UNEXPECTED_ERROR,
+      message: error instanceof Error ? error.message : "Unknown error occurred",
+    });
+  }
+};
