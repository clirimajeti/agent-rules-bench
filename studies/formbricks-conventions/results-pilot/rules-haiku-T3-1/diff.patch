+};
diff --git a/apps/web/modules/account/lib/user-data-export.ts b/apps/web/modules/account/lib/user-data-export.ts
new file mode 100644
index 000000000..48433dde7
--- /dev/null
+++ b/apps/web/modules/account/lib/user-data-export.ts
@@ -0,0 +1,42 @@
+import "server-only";
+import { prisma } from "@formbricks/database";
+import { ZId } from "@formbricks/types/common";
+import { ResourceNotFoundError } from "@formbricks/types/errors";
+import { getUser } from "@/lib/user/service";
+import { validateInputs } from "@/lib/utils/validate";
+
+/**
+ * The personal data a user can download from their profile page. Only the fields listed here are
+ * exported; credentials, two-factor secrets, sessions and internal ids stay out of the file.
+ */
+export const getUserDataExport = async (userId: string) => {
+  validateInputs([userId, ZId]);
+
+  const user = await getUser(userId);
+  if (!user) {
+    throw new ResourceNotFoundError("User", userId);
+  }
+
+  // Pending invitations are not memberships yet, so only accepted rows are exported.
+  const memberships = await prisma.membership.findMany({
+    where: { userId, accepted: true },
+    select: {
+      role: true,
+      organization: { select: { name: true } },
+    },
+    orderBy: { organization: { name: "asc" } },
+  });
+
+  return {
+    name: user.name,
+    email: user.email,
+    locale: user.locale,
+    notificationSettings: user.notificationSettings,
+    organizations: memberships.map((membership) => ({
+      name: membership.organization.name,
+      role: membership.role,
+    })),
+  };
+};
+
+export type TUserDataExport = Awaited<ReturnType<typeof getUserDataExport>>;
