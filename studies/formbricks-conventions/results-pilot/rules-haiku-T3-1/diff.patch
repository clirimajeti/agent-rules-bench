+"use client";
+
+import { useMutation } from "@tanstack/react-query";
+import { fetchUserDataExport } from "@/modules/account/lib/api-client";
+import { accountKeys } from "@/modules/account/lib/query";
+
+/** Fetches the signed-in user's data export on demand. The caller decides what to do with the result. */
+export const useUserDataExport = () =>
+  useMutation({
+    mutationKey: accountKeys.dataExport(),
+    mutationFn: fetchUserDataExport,
+  });
diff --git a/apps/web/modules/account/lib/api-client.ts b/apps/web/modules/account/lib/api-client.ts
new file mode 100644
index 000000000..d4f18310e
--- /dev/null
+++ b/apps/web/modules/account/lib/api-client.ts
@@ -0,0 +1,13 @@
+import { parseV3ApiError } from "@/modules/api/lib/v3-client";
+import type { TUserDataExport } from "./user-data-export";
+
+const ENDPOINT = "/api/v3/account/data-export";
+
+/** Client fetcher for the signed-in user's data export. */
+export async function fetchUserDataExport(): Promise<TUserDataExport> {
+  const response = await fetch(ENDPOINT, { method: "GET", cache: "no-store" });
+  if (!response.ok) {
+    throw await parseV3ApiError(response);
+  }
+  return ((await response.json()) as { data: TUserDataExport }).data;
+}
