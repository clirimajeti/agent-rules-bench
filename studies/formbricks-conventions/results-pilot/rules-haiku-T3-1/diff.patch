@@ -0,0 +1,20 @@
+/**
+ * GET /api/v3/account/data-export - the signed-in user's own personal data (name, email, locale,
+ * notification settings and organization memberships) as JSON. Session-only: an API key belongs to a
+ * workspace, not to a person, so it must not export a user's data.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { problemUnauthorized, successResponse } from "@/app/api/v3/lib/response";
+import { getUserDataExport } from "@/modules/account/lib/user-data-export";
+
+export const GET = withV3ApiWrapper({
+  auth: "session",
+  handler: async ({ authentication, requestId, instance }) => {
+    if (!authentication || !("user" in authentication) || !authentication.user?.id) {
+      return problemUnauthorized(requestId, "Session required", instance);
+    }
+
+    const data = await getUserDataExport(authentication.user.id);
+    return successResponse(data, { requestId });
+  },
+});
