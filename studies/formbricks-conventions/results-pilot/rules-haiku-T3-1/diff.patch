--- /dev/null
+++ b/apps/web/app/(app)/workspaces/[workspaceId]/settings/account/profile/components/DownloadMyDataButton.tsx
@@ -0,0 +1,43 @@
+"use client";
+
+import toast from "react-hot-toast";
+import { useTranslation } from "react-i18next";
+import { useUserDataExport } from "@/modules/account/hooks/use-user-data-export";
+import { Button } from "@/modules/ui/components/button";
+
+const DOWNLOAD_FILE_NAME = "formbricks-user-data.json";
+
+const saveJsonFile = (data: unknown, fileName: string) => {
+  const blob = new Blob([JSON.stringify(data, null, 2)], { type: "application/json" });
+  const url = URL.createObjectURL(blob);
+  const link = document.createElement("a");
+  link.href = url;
+  link.download = fileName;
+  link.style.display = "none";
+  document.body.appendChild(link);
+  try {
+    link.click();
+  } finally {
+    link.remove();
+    // Revoked on the next task: some browsers read the URL only after `click()` has returned.
+    setTimeout(() => URL.revokeObjectURL(url), 0);
+  }
+};
+
+export const DownloadMyDataButton = () => {
+  const { t } = useTranslation();
+  const dataExport = useUserDataExport();
+
+  const handleDownload = () => {
+    dataExport.mutate(undefined, {
+      onSuccess: (data) => saveJsonFile(data, DOWNLOAD_FILE_NAME),
+      onError: () => toast.error(t("common.something_went_wrong_please_try_again")),
+    });
+  };
+
+  return (
+    <Button variant="secondary" size="sm" onClick={handleDownload} loading={dataExport.isPending}>
+      {t("workspace.settings.profile.download_my_data")}
+    </Button>
+  );
+};
