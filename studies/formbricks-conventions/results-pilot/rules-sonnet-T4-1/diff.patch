+/**
+ * Deletes every tag of the workspace that no response carries. The "unused" check runs inside the single
+ * `deleteMany`, so a tag applied while this runs is never removed, and the count is exact. The check is
+ * deliberately not the per-caller visible count shown in the list: a tag used only on responses the caller
+ * cannot read is still in use.
+ */
+export const deleteUnusedTags = async (
+  workspaceId: string
+): Promise<Result<{ count: number }, { code: TagError; message: string }>> => {
+  validateInputs([workspaceId, ZId]);
+
+  try {
+    const { count } = await prisma.tag.deleteMany({
+      where: { workspaceId, responses: { none: {} } },
+    });
+
+    return ok({ count });
+  } catch (error) {
+    return err({
+      code: TagError.UNEXPECTED_ERROR,
+      message: error instanceof Error ? error.message : "Unknown error occurred",
+    });
+  }
+};
