+import { rotateApiKey } from "@/modules/organization/settings/api-keys/lib/api-key";
+import { successResponse } from "@/app/api/v3/lib/response";
+import type { TV3Authentication, TV3AuditLog } from "@/app/api/v3/lib/types";
+
+export const rotateV3ApiKey = async ({
+  apiKeyId,
+  authentication,
+  auditLog,
+  requestId,
+  instance,
+}: {
+  apiKeyId: string;
+  authentication: TV3Authentication;
+  auditLog: TV3AuditLog | undefined;
+  requestId: string;
+  instance: string;
+}): Promise<Response> => {
+  // Authorize: the caller must have apiKey.manage on this key
+  const { assertCan } = await import("@/lib/authorization");
+  await assertCan(
+    { type: authentication.type, id: authentication.id },
+    "apiKey.manage",
+    { type: "apiKey", id: apiKeyId }
+  );
+
+  const userId =
+    authentication.type === "session" ? authentication.user.id : authentication.apiKey.userId;
+
+  const result = await rotateApiKey(apiKeyId, userId);
+
+  if (auditLog) {
+    auditLog.status = "success";
+    auditLog.newObject = { id: result.id };
+  }
+
+  return successResponse(result, { requestId });
+};
