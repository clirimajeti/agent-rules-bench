--- /dev/null
+++ b/apps/web/modules/organization/settings/api-keys/hooks/use-rotate-api-key.ts
@@ -0,0 +1,22 @@
+"use client";
+
+import { useMutation, useQueryClient } from "@tanstack/react-query";
+import { rotateApiKeyClient } from "../lib/api-client";
+
+/**
+ * Mutation hook for rotating an API key.
+ *
+ * Invalidates the api-keys list query so the table picks up the updated key metadata
+ * (lastUsedAt resets, etc.) without needing an optimistic update.
+ */
+export const useRotateApiKey = () => {
+  const queryClient = useQueryClient();
+
+  return useMutation({
+    mutationFn: (apiKeyId: string) => rotateApiKeyClient(apiKeyId),
+    onSuccess: () => {
+      // Invalidate the api-keys list so the next render fetches fresh data.
+      void queryClient.invalidateQueries({ queryKey: ["api-keys"] });
+    },
+  });
+};
diff --git a/apps/web/modules/organization/settings/api-keys/lib/api-client.ts b/apps/web/modules/organization/settings/api-keys/lib/api-client.ts
new file mode 100644
index 000000000..7fe369d60
--- /dev/null
+++ b/apps/web/modules/organization/settings/api-keys/lib/api-client.ts
@@ -0,0 +1,29 @@
+import { parseV3ApiError } from "@/modules/api/lib/v3-client";
+import type { TApiKeyWithEnvironmentPermission } from "../types/api-keys";
+
+const BASE_PATH = "/api/v3/api-keys";
+const MUTATION_TIMEOUT_MS = 15_000;
+
+/**
+ * Response shape for the rotate operation: the rotated key with its permissions plus the
+ * plaintext secret (shown once, like create).
+ */
+export type TRotateApiKeyResponse = TApiKeyWithEnvironmentPermission & { actualKey: string };
+
+/**
+ * Rotate an API key, replacing its secret while keeping label and permissions intact.
+ *
+ * Resolves once the rotation has been *applied*. The caller must have `apiKey.manage` on the key.
+ */
+export async function rotateApiKeyClient(apiKeyId: string): Promise<TRotateApiKeyResponse> {
+  const response = await fetch(`${BASE_PATH}/${encodeURIComponent(apiKeyId)}/rotate`, {
+    method: "POST",
+    signal: AbortSignal.timeout(MUTATION_TIMEOUT_MS),
+  });
+
+  if (!response.ok) {
+    throw await parseV3ApiError(response);
+  }
+
+  return ((await response.json()) as { data: TRotateApiKeyResponse }).data;
+}
