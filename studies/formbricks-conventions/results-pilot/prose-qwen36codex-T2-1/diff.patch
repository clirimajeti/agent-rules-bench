+/**
+ * POST /api/v3/webhooks/{webhookId}/duplicate — clone a webhook.
+ * Thin adapter delegating to the framework-agnostic handler in `@formbricks/webhooks/server`.
+ */
+import { z } from "zod";
+import { ZId } from "@formbricks/types/common";
+import { ResourceNotFoundError } from "@formbricks/types/errors";
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { requireV3WorkspaceAccess } from "@/app/api/v3/lib/auth";
+import { problemBadRequest } from "@/app/api/v3/lib/response";
+import { getOrganizationIdFromWebhookId, getWorkspaceIdFromWebhookId } from "@/lib/utils/helper";
+import { capturePostHogEvent } from "@/lib/posthog";
+import { getWebhook } from "@/modules/api/v2/management/webhooks/[webhookId]/lib/webhook";
+import { applyRateLimit } from "@/modules/core/rate-limit/helpers";
+import { rateLimitConfigs } from "@/modules/core/rate-limit/rate-limit-configs";
+import { createWebhook } from "@/modules/integrations/webhooks/lib/webhook";
+
+const ZWebhookIdInput = z.object({
+  webhookId: ZId,
+});
+
+export const POST = withV3ApiWrapper({
+  auth: "both",
+  action: "created",
+  targetType: "webhook",
+  schemas: { params: ZWebhookIdInput },
+  handler: async ({ req, parsedInput, authentication, auditLog, requestId, instance }) => {
+    const { webhookId } = parsedInput.params;
+
+    const organizationId = await getOrganizationIdFromWebhookId(webhookId);
+    const workspaceId = await getWorkspaceIdFromWebhookId(webhookId);
+
+    const authorized = await requireV3WorkspaceAccess(
+      authentication,
+      workspaceId,
+      "workspace.write",
+      requestId,
+      instance
+    );
+    if (authorized instanceof Response) {
+      return authorized;
+    }
+
+    await applyRateLimit(rateLimitConfigs.actions.stateMutation, workspaceId);
+
+    const existing = await getWebhook(webhookId);
+    if (!existing.ok) {
+      return problemBadRequest(requestId, "Webhook not found");
+    }
+
+    const webhookData = existing.data;
+    const newName = webhookData.name ? `Copy of ${webhookData.name}` : "Copy of Webhook";
+
+    const webhook = await createWebhook(workspaceId, {
+      name: newName,
+      url: webhookData.url,
+      triggers: webhookData.triggers,
+      surveyIds: webhookData.surveyIds,
+      source: "user",
+    });
+
+    if (auditLog) {
+      auditLog.targetId = webhook.id;
+      auditLog.organizationId = organizationId;
+      auditLog.newObject = webhook;
+    }
+
+    capturePostHogEvent(
+      authentication.user?.id ?? "",
+      "integration_connected",
+      {
+        integration_type: "webhook",
+        organization_id: organizationId,
+        workspace_id: workspaceId,
+      },
+      { organizationId, workspaceId }
+    );
+
+    return new Response(JSON.stringify({ data: webhook }), {
+      status: 201,
+      headers: { "Content-Type": "application/json" },
+    });
+  },
+});
