@@ -0,0 +1,16 @@
+/**
+ * GET /api/v3/me/data-export - the signed-in user's name, email, locale, notification settings and
+ * organization memberships (organization name and role), for the profile page's "Download my data".
+ *
+ * Session-only: it returns the caller's own personal data, so an API key has no business here.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { rateLimitConfigs } from "@/modules/core/rate-limit/rate-limit-configs";
+import { getV3DataExport } from "./lib/operations";
+
+export const GET = withV3ApiWrapper({
+  auth: "session",
+  customRateLimitConfig: rateLimitConfigs.actions.dataExport,
+  handler: async ({ authentication, requestId, instance }) =>
+    getV3DataExport({ authentication, requestId, instance }),
+});
