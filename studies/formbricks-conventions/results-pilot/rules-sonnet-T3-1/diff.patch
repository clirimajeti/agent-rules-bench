@@ -0,0 +1,70 @@
+"use client";
+
+import { QueryClient, QueryClientProvider, useMutation } from "@tanstack/react-query";
+import { useState } from "react";
+import toast from "react-hot-toast";
+import { useTranslation } from "react-i18next";
+import { parseV3ApiError } from "@/modules/api/lib/v3-client";
+import { Button } from "@/modules/ui/components/button";
+
+const DATA_EXPORT_FILE_NAME = "formbricks-my-data.json";
+
+const fetchMyData = async (): Promise<unknown> => {
+  const response = await fetch("/api/v3/me/data-export", {
+    cache: "no-store",
+    signal: AbortSignal.timeout(15_000),
+  });
+  if (!response.ok) throw await parseV3ApiError(response);
+  const body: { data: unknown } = await response.json();
+  return body.data;
+};
+
+const saveJsonAsFile = (data: unknown, fileName: string): void => {
+  const url = URL.createObjectURL(new Blob([JSON.stringify(data, null, 2)], { type: "application/json" }));
+  const link = document.createElement("a");
+  link.href = url;
+  link.download = fileName;
+  link.style.display = "none";
+  document.body.appendChild(link);
+  try {
+    link.click();
+  } finally {
+    link.remove();
+    // Revoked on the next task: some browsers read the URL only after `click()` has returned.
+    setTimeout(() => URL.revokeObjectURL(url), 0);
+  }
+};
+
+const DownloadMyDataButton = () => {
+  const { t } = useTranslation();
+  const download = useMutation({
+    mutationFn: fetchMyData,
+    onSuccess: (data) => saveJsonAsFile(data, DATA_EXPORT_FILE_NAME),
+    onError: () => toast.error(t("workspace.settings.profile.data_download_failed")),
+  });
+
+  return (
+    <div>
+      <p className="text-sm text-slate-700">{t("workspace.settings.profile.download_my_data_description")}</p>
+      <Button
+        className="mt-4"
+        variant="secondary"
+        size="sm"
+        loading={download.isPending}
+        onClick={() => download.mutate()}>
+        {t("workspace.settings.profile.download_my_data")}
+      </Button>
+    </div>
+  );
+};
+
+/** The profile page has no app-wide query client, so this mounts its own (as the tags settings page does). */
+export const DownloadMyData = () => {
+  const [queryClient] = useState(() => new QueryClient());
+
+  return (
+    <QueryClientProvider client={queryClient}>
+      <DownloadMyDataButton />
+    </QueryClientProvider>
+  );
+};
