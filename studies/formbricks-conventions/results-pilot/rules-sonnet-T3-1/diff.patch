+import { TUser } from "@formbricks/types/user";
+import { formatDateTimeForDisplay } from "@/lib/utils/datetime";
+import { getTranslate } from "@/lingodotdev/server";
+
+interface AccountActivityProps {
+  user: Pick<TUser, "createdAt" | "lastLoginAt" | "locale">;
+}
+
+export const AccountActivity = async ({ user }: Readonly<AccountActivityProps>) => {
+  const t = await getTranslate();
+
+  return (
+    <dl className="space-y-4 text-sm">
+      <div>
+        <dt className="font-medium text-slate-900">{t("workspace.settings.profile.account_created")}</dt>
+        <dd className="text-slate-700">
+          <time dateTime={user.createdAt.toISOString()}>
+            {formatDateTimeForDisplay(user.createdAt, user.locale)}
+          </time>
+        </dd>
+      </div>
+      <div>
+        <dt className="font-medium text-slate-900">{t("workspace.settings.profile.last_login")}</dt>
+        <dd className="text-slate-700">
+          {user.lastLoginAt ? (
+            <time dateTime={user.lastLoginAt.toISOString()}>
+              {formatDateTimeForDisplay(user.lastLoginAt, user.locale)}
+            </time>
+          ) : (
+            t("workspace.settings.profile.never_logged_in")
+          )}
+        </dd>
+      </div>
+    </dl>
+  );
+};
diff --git a/apps/web/app/(app)/workspaces/[workspaceId]/settings/account/profile/components/DownloadMyData.tsx b/apps/web/app/(app)/workspaces/[workspaceId]/settings/account/profile/components/DownloadMyData.tsx
