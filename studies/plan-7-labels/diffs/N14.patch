+	async getIdsByUserIdLastMessageBefore(
+		userId: string,
+		cutoff: Date,
+		trx?: EntityManager,
+	): Promise<string[]> {
+		const em = trx ?? this.manager;
+		const sessions = await em.find(ChatHubSession, {
+			select: { id: true },
+			where: { ownerId: userId, lastMessageAt: LessThan(cutoff) },
+		});
+		return sessions.map((session) => session.id);
+	}
+
+	async deleteManyByIds(ids: string[], userId: string, trx?: EntityManager) {
+		if (ids.length === 0) return;
+		const em = trx ?? this.manager;
+		// Messages are removed by the ON DELETE CASCADE on the message table.
+		await em.delete(ChatHubSession, { id: In(ids), ownerId: userId });
+	}
