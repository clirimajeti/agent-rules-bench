+++ b/packages/nodes-base/nodes/KoBoToolbox/GenericFunctions.ts
@@ -105,6 +105,25 @@ export function parseStringList(value: string): string[] {
 	return split(toString(value), /[\s,]+/);
 }
 
+export function parseSubmissionIds(this: IExecuteFunctions, value: string): string[] {
+	const trimmedValue = trim(toString(value));
+	if (!trimmedValue) {
+		throw new NodeOperationError(this.getNode(), 'Enter at least one submission ID');
+	}
+
+	const ids = split(trimmedValue, ',').map((id) => trim(id));
+	for (const id of ids) {
+		if (!/^\d+$/.test(id)) {
+			throw new NodeOperationError(
+				this.getNode(),
+				`Submission ID "${id}" is not a number. Use a comma-separated list of numbers`,
+			);
+		}
+	}
+
+	return ids;
+}
+
 const matchWildcard = (value: string, pattern: string): boolean => {
 	return safeRegex.test(`^${escapeRegExp(pattern).replace('\\*', '.*')}$`, value);
 };
