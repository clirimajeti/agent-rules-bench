+import { NodeOperationError, safeRegex, UserError } from 'n8n-workflow';
 
 export async function koBoToolboxApiRequest(
 	this: IExecuteFunctions | IWebhookFunctions | IHookFunctions | ILoadOptionsFunctions,
@@ -105,6 +105,23 @@ export function parseStringList(value: string): string[] {
 	return split(toString(value), /[\s,]+/);
 }
 
+// Strict parser: rejects empty lists and any entry that is not a whole number.
+export function parseSubmissionIds(value: unknown): string[] {
+	const entries = split(toString(value), ',').map((entry) => trim(entry));
+
+	if (entries.length === 1 && entries[0] === '') {
+		throw new UserError('Enter at least one submission ID');
+	}
+
+	for (const entry of entries) {
+		if (!/^\d+$/.test(entry)) {
+			throw new UserError(`Submission ID "${entry}" is not a number`);
+		}
+	}
+
+	return entries;
+}
+
 const matchWildcard = (value: string, pattern: string): boolean => {
 	return safeRegex.test(`^${escapeRegExp(pattern).replace('\\*', '.*')}$`, value);
 };
