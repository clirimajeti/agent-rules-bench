@@ -105,6 +105,22 @@ export function parseStringList(value: string): string[] {
 	return split(toString(value), /[\s,]+/);
 }
 
+// Splits on commas only. Every entry must be a whole number.
+export function parseSubmissionIds(value: unknown): number[] {
+	const trimmed = trim(toString(value));
+	if (!trimmed) {
+		throw new UserError('Enter at least one submission ID');
+	}
+
+	return split(trimmed, ',').map((part) => {
+		const id = trim(part);
+		if (!/^\d+$/.test(id)) {
+			throw new UserError(`Submission ID "${id}" is not a number`);
+		}
+		return Number(id);
+	});
+}
+
 const matchWildcard = (value: string, pattern: string): boolean => {
 	return safeRegex.test(`^${escapeRegExp(pattern).replace('\\*', '.*')}$`, value);
 };
