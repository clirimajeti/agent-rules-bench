+	/**
+	 * Deletes the user's conversations whose last message is older than the given number of days.
+	 * Returns the number of conversations deleted.
+	 */
+	async deleteConversationsOlderThan(userId: string, days: number): Promise<number> {
+		const before = new Date(Date.now() - days * MS_PER_DAY);
+
+		return await this.sessionRepository.runInTransaction({}, async (trx) => {
+			const sessionIds = await this.sessionRepository.getIdsByOwnerIdleSince(userId, before, trx);
+
+			let deleted = 0;
+			for (let start = 0; start < sessionIds.length; start += DELETE_BATCH_SIZE) {
+				const batch = sessionIds.slice(start, start + DELETE_BATCH_SIZE);
+				await this.chatHubAttachmentService.deleteAllBySessionIds(batch, trx);
+				deleted += await this.sessionRepository.deleteChatHubSessions(batch, trx);
+			}
+
+			return deleted;
+		});
+	}
