 	return split(toString(value), /[\s,]+/);
 }
 
+// Validate all IDs before any request, so a bad list changes nothing.
+export function parseSubmissionIds(node: INode, value: unknown, itemIndex: number): string[] {
+	const ids = split(toString(value), ',').map((id) => trim(id));
+
+	if (ids.length === 1 && ids[0] === '') {
+		throw new NodeOperationError(node, 'Enter at least one submission ID', { itemIndex });
+	}
+
+	const invalid = ids.filter((id) => !/^\d+$/.test(id));
+	if (invalid.length > 0) {
+		const quoted = invalid.map((id) => `"${id}"`).join(', ');
+		throw new NodeOperationError(node, `Submission IDs must be numbers. Invalid: ${quoted}`, {
+			itemIndex,
+		});
+	}
+
+	return ids;
+}
+
 const matchWildcard = (value: string, pattern: string): boolean => {
 	return safeRegex.test(`^${escapeRegExp(pattern).replace('\\*', '.*')}$`, value);
 };
