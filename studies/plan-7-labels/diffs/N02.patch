+	/**
+	 * Counts unexpired access tokens per (client, user) pair at `now`. Pairs with
+	 * no unexpired token are absent from the result.
+	 */
+	async countActiveByGrant(
+		clientIds: string[],
+		userIds: string[],
+		now: number,
+	): Promise<ActiveAccessTokenCount[]> {
+		if (clientIds.length === 0 || userIds.length === 0) return [];
+
+		const rows = await this.createQueryBuilder('token')
+			.select('token.clientId', 'clientId')
+			.addSelect('token.userId', 'userId')
+			.addSelect('COUNT(*)', 'count')
+			.where('token.clientId IN (:...clientIds)', { clientIds })
+			.andWhere('token.userId IN (:...userIds)', { userIds })
+			.andWhere('token.expiresAt > :now', { now })
+			.groupBy('token.clientId')
+			.addGroupBy('token.userId')
+			.getRawMany<{ clientId: string; userId: string; count: string | number }>();
+
+		// COUNT comes back as a string on Postgres.
+		return rows.map((row) => ({
+			clientId: row.clientId,
+			userId: row.userId,
+			count: Number(row.count),
+		}));
+	}
+
+	/** Deletes every access token of a client, for all users. Returns the rows deleted. */
+	async deleteAllForClient(clientId: string, ctx: OperationContext): Promise<number> {
+		const result = await this.managerFor(ctx).delete(AccessToken, { clientId });
+		return result.affected ?? 0;
+	}
 }
