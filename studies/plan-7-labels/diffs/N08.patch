+	/**
+	 * Deletes the user's sessions whose last message is older than the given number of days,
+	 * together with their messages. Returns the number of deleted sessions.
+	 */
+	async deleteSessionsOlderThan(userId: string, olderThanDays: number): Promise<number> {
+		const cutoff = new Date(Date.now() - olderThanDays * 24 * 60 * 60 * 1000);
+
+		const { deletedCount, attachments } = await this.sessionRepository.runInTransaction(
+			{},
+			async (trx) => {
+				const sessionIds = await this.sessionRepository.findIdsByOwnerLastMessageBefore(
+					userId,
+					cutoff,
+					trx,
+				);
+				if (sessionIds.length === 0) return { deletedCount: 0, attachments: [] };
+
+				const attachments = await this.messageRepository.getAttachmentsBySessionIds(
+					sessionIds,
+					trx,
+				);
+				await this.messageRepository.deleteBySessionIds(sessionIds, trx);
+				await this.sessionRepository.deleteByIds(sessionIds, trx);
+
+				return { deletedCount: sessionIds.length, attachments };
+			},
+		);
+
+		// Attachment files cannot be rolled back, so they are removed only after the commit.
+		if (attachments.length > 0) {
+			await this.chatHubAttachmentService.deleteAttachments(attachments);
+		}
+
+		return deletedCount;
+	}
