--- a/packages/nodes-base/nodes/KoBoToolbox/GenericFunctions.ts
+++ b/packages/nodes-base/nodes/KoBoToolbox/GenericFunctions.ts
@@ -105,6 +105,33 @@ export function parseStringList(value: string): string[] {
 	return split(toString(value), /[\s,]+/);
 }
 
+// Strict parser: the list is comma-separated and every entry must be a numeric ID.
+export function parseSubmissionIds(
+	this: IExecuteFunctions,
+	value: unknown,
+	itemIndex: number,
+): string[] {
+	const ids = split(toString(value), ',').map((id) => trim(id));
+
+	if (ids.length === 1 && ids[0] === '') {
+		throw new NodeOperationError(this.getNode(), 'Enter at least one submission ID', {
+			itemIndex,
+		});
+	}
+
+	for (const id of ids) {
+		if (!/^\d+$/.test(id)) {
+			throw new NodeOperationError(
+				this.getNode(),
+				`Invalid submission ID "${id}": IDs must be numbers`,
+				{ itemIndex },
+			);
+		}
+	}
+
+	return ids;
+}
+
 const matchWildcard = (value: string, pattern: string): boolean => {
 	return safeRegex.test(`^${escapeRegExp(pattern).replace('\\*', '.*')}$`, value);
 };
