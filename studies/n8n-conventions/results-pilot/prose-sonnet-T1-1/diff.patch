+	async getIdsByUserIdLastMessageBefore(userId: string, cutoff: Date, ctx: OperationContext) {
+		const sessions = await this.managerFor(ctx).find(ChatHubSession, {
+			select: ['id'],
+			where: { ownerId: userId, lastMessageAt: LessThan(cutoff) },
+		});
+		return sessions.map((session) => session.id);
+	}
+
+	async deleteManyByIdsAndUserId(ids: string[], userId: string, ctx: OperationContext) {
+		if (ids.length === 0) return 0;
+		// Messages are removed by the ON DELETE CASCADE of the message table
+		const result = await this.managerFor(ctx).delete(ChatHubSession, { id: In(ids), ownerId: userId });
+		return result.affected ?? 0;
+	}
