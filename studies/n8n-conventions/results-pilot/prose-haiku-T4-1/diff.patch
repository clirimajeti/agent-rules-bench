+// Organization user status. A member with this status has not accepted the invitation yet.
+const MEMBER_STATUS_INVITED = 0;
+
+type BitwardenMember = {
+	id: string;
+	email: string;
+	status: number;
+};
+
+function isBitwardenMember(value: unknown): value is BitwardenMember {
+	return (
+		isRecord(value) &&
+		typeof value.id === 'string' &&
+		typeof value.email === 'string' &&
+		typeof value.status === 'number'
+	);
+}
+
+function isBitwardenMembersResponse(value: unknown): value is { data: BitwardenMember[] } {
+	return isRecord(value) && Array.isArray(value.data) && value.data.every(isBitwardenMember);
+}
