@@ -105,6 +105,25 @@ export function parseStringList(value: string): string[] {
 	return split(toString(value), /[\s,]+/);
 }
 
+// Parse a comma-separated list of numeric submission IDs. Reject the whole list on any invalid entry.
+export function parseSubmissionIds(this: IExecuteFunctions, value: unknown): number[] {
+	const parts = split(toString(value), ',').map((part) => trim(part));
+
+	if (parts.length === 1 && parts[0] === '') {
+		throw new NodeOperationError(this.getNode(), 'Enter at least one submission ID');
+	}
+
+	return parts.map((part) => {
+		if (!/^\d+$/.test(part)) {
+			throw new NodeOperationError(
+				this.getNode(),
+				`Submission ID "${part}" is not a number`,
+			);
+		}
+		return toNumber(part);
+	});
+}
+
 const matchWildcard = (value: string, pattern: string): boolean => {
 	return safeRegex.test(`^${escapeRegExp(pattern).replace('\\*', '.*')}$`, value);
 };
