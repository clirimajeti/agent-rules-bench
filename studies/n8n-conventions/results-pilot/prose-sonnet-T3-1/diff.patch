+/**
+ * Parse a comma-separated list of submission IDs.
+ * Throw if the list is empty or if an ID is not a whole number.
+ */
+export function parseSubmissionIds(this: IExecuteFunctions, value: string, itemIndex: number) {
+	const parts = toString(value)
+		.split(',')
+		.map((part) => part.trim());
+
+	if (parts.every((part) => part === '')) {
+		throw new NodeOperationError(this.getNode(), 'At least one submission ID is required', {
+			itemIndex,
+		});
+	}
+
+	return parts.map((part) => {
+		if (!/^\d+$/.test(part)) {
+			throw new NodeOperationError(
+				this.getNode(),
+				`Submission ID "${part}" is not a number. Use a comma-separated list of numbers.`,
+				{ itemIndex },
+			);
+		}
+		return part;
+	});
+}
+
+const matchWildcard =(value: string, pattern: string): boolean => {
 	return safeRegex.test(`^${escapeRegExp(pattern).replace('\\*', '.*')}$`, value);
 };
 
