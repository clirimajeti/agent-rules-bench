@@ -24,4 +32,30 @@ export class AccessTokenRepository extends BaseRepository<AccessToken> {
 	async isActive(token: string): Promise<boolean> {
 		return await this.existsBy({ token });
 	}
+
+	/** Counts the unexpired (at `now`) access tokens of each grant of the given clients. */
+	async countActiveByGrant(clientIds: string[], now: number): Promise<ActiveAccessTokenCount[]> {
+		if (clientIds.length === 0) return [];
+
+		const rows = await this.createQueryBuilder('token')
+			.select('token.clientId', 'clientId')
+			.addSelect('token.userId', 'userId')
+			.addSelect('COUNT(*)', 'count')
+			.where('token.clientId IN (:...clientIds)', { clientIds })
+			.andWhere('token.expiresAt > :now', { now })
+			.groupBy('token.clientId')
+			.addGroupBy('token.userId')
+			.getRawMany<{ clientId: string; userId: string; count: string | number }>();
+
+		// COUNT(*) comes back as a string on Postgres.
+		return rows.map((row) => ({
+			clientId: row.clientId,
+			userId: row.userId,
+			count: Number(row.count),
+		}));
+	}
+
+	async deleteAllForClient(clientId: string, ctx: OperationContext): Promise<void> {
+		await this.managerFor(ctx).delete(AccessToken, { clientId });
+	}
 }
