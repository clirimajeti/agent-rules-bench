@@ -0,0 +1,20 @@
+import type { MigrationContext, ReversibleMigration } from '../migration-types';
+
+/**
+ * Adds the expiry of each access token, so active tokens can be counted.
+ * Rows that exist before this migration get `0`, which counts as expired.
+ * Verification does not read this column, so they keep working until their JWT expires.
+ */
+export class AddExpiresAtToOAuthAccessTokens1795297764304 implements ReversibleMigration {
+	async up({ schemaBuilder: { addColumns, column } }: MigrationContext) {
+		await addColumns(
+			'oauth_access_tokens',
+			[column('expiresAt').bigint.notNull.default(0).comment('Unix timestamp in milliseconds')],
+			{ recreatesOnSqlite: true },
+		);
+	}
+
+	async down({ schemaBuilder: { dropColumns } }: MigrationContext) {
+		await dropColumns('oauth_access_tokens', ['expiresAt'], { recreatesOnSqlite: true });
+	}
+}
