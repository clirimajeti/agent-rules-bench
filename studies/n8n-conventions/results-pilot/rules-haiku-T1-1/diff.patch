+	/**
+	 * Deletes the user's conversations whose last message is older than `olderThanDays`.
+	 * Returns the number of deleted conversations.
+	 */
+	async deleteConversationsOlderThan(userId: string, olderThanDays: number): Promise<number> {
+		const cutoff = new Date(Date.now() - olderThanDays * 24 * 60 * 60 * 1000);
+
+		const { deletedCount, attachments } = await this.sessionRepository.runInTransaction(
+			{},
+			async (trx) => {
+				const sessionIds = await this.sessionRepository.getIdsByOwnerLastMessageBefore(
+					userId,
+					cutoff,
+					trx,
+				);
+				if (sessionIds.length === 0) return { deletedCount: 0, attachments: [] };
+
+				const attachments = await this.messageRepository.getAttachmentsBySessionIds(
+					sessionIds,
+					trx,
+				);
+				await this.sessionRepository.deleteChatHubSessionsByIds(sessionIds, trx);
+				return { deletedCount: sessionIds.length, attachments };
+			},
+		);
+
+		// Delete files after commit, so no committed message refers to a missing file
+		await this.chatHubAttachmentService.deleteAttachments(attachments);
+
+		return deletedCount;
+	}
