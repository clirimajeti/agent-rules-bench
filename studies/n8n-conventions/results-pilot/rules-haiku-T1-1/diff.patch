+	/**
+	 * Returns the attachments of all messages in the given sessions.
+	 */
+	async getAttachmentsBySessionIds(
+		sessionIds: string[],
+		trx?: EntityManager,
+	): Promise<IBinaryData[]> {
+		const em = trx ?? this.manager;
+		const attachments: IBinaryData[] = [];
+		// Batch the IDs to stay under the database's bind parameter limit
+		for (let start = 0; start < sessionIds.length; start += QUERY_BATCH_SIZE) {
+			const batch = sessionIds.slice(start, start + QUERY_BATCH_SIZE);
+			const messages = await em.find(ChatHubMessage, {
+				select: { attachments: true },
+				where: { sessionId: In(batch), attachments: Not(IsNull()) },
+			});
+			attachments.push(...messages.flatMap((message) => message.attachments ?? []));
+		}
+		return attachments;
+	}
