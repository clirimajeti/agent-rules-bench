+/** Parse a comma-separated list of numeric submission IDs. Throw on an empty list or a non-numeric ID. */
+export function parseSubmissionIds(value: unknown, node: INode): string[] {
+	if (typeof value !== 'string') {
+		throw new NodeOperationError(node, 'The list of submission IDs must be text');
+	}
+
+	const ids = value
+		.split(',')
+		.map((id) => id.trim());
+
+	if (ids.length === 1 && ids[0] === '') {
+		throw new NodeOperationError(node, 'The list of submission IDs is empty');
+	}
+
+	for (const id of ids) {
+		if (!/^\d+$/.test(id)) {
+			throw new NodeOperationError(node, `Submission ID "${id}" is not a number`, {
+				description: 'Use a comma-separated list of numbers, for example 245128, 245129',
+			});
+		}
+	}
+
+	return ids;
+}
+
 const matchWildcard = (value: string, pattern: string): boolean => {
 	return safeRegex.test(`^${escapeRegExp(pattern).replace('\\*', '.*')}$`, value);
 };
