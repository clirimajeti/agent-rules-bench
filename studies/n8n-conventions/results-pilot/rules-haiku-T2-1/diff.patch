+import type { MigrationContext, ReversibleMigration } from '../migration-types';
+
+const TABLE_NAME = 'oauth_access_tokens';
+const COLUMN_NAME = 'expiresAt';
+
+// Access tokens are 1-hour JWTs. Migrations are snapshots and must not import runtime code.
+const ACCESS_TOKEN_TTL_MS = 60 * 60 * 1000;
+
+/**
+ * Stores when each access token expires, so the admin clients list can count the
+ * tokens that are still valid. Rows never expire on their own, so the column is
+ * the only record of validity.
+ *
+ * Existing rows get the latest possible expiry, one hour from now. Every access
+ * token minted before this migration ends by then, so no live session is cut
+ * short. Counts can overstate validity for up to one hour after the upgrade.
+ *
+ * Reversible: the column is NOT NULL with no default, so a downgrade drops it
+ * before older code inserts tokens again.
+ */
+export class AddExpiresAtToOAuthAccessTokens1795219241000 implements ReversibleMigration {
+	async up({
+		schemaBuilder: { addColumns, addNotNull, column },
+		escape,
+		runQuery,
+	}: MigrationContext) {
+		await addColumns(
+			TABLE_NAME,
+			[
+				column(COLUMN_NAME).bigint.comment(
+					'Unix timestamp in milliseconds when the access token expires',
+				),
+			],
+			{ recreatesOnSqlite: true },
+		);
+
+		const table = escape.tableName(TABLE_NAME);
+		const expiresAtColumn = escape.columnName(COLUMN_NAME);
+		await runQuery(
+			`UPDATE ${table} SET ${expiresAtColumn} = :expiresAt WHERE ${expiresAtColumn} IS NULL`,
+			{ expiresAt: Date.now() + ACCESS_TOKEN_TTL_MS },
+		);
+
+		// No default on purpose: an insert that forgets the expiry must fail instead of
+		// producing a token that is counted as valid forever.
+		await addNotNull(TABLE_NAME, COLUMN_NAME, { recreatesOnSqlite: true });
+	}
+
+	/** Reversal drops the expiry values; older code does not read them. */
+	async down({ schemaBuilder: { dropColumns } }: MigrationContext) {
+		await dropColumns(TABLE_NAME, [COLUMN_NAME], { recreatesOnSqlite: true });
+	}
+}
