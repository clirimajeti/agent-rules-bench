+	/**
+	 * Deletes the user's sessions whose last message is older than `olderThanDays`.
+	 * Returns the number of deleted sessions.
+	 */
+	async deleteSessionsIdleFor(userId: string, olderThanDays: number): Promise<number> {
+		const cutoff = new Date(Date.now() - olderThanDays * MS_PER_DAY);
+
+		const { deleted, attachments } = await this.transactionRunner.run({}, async (ctx) => {
+			const attachments = await this.messageRepository.getAttachmentsOfOwnedSessionsIdleSince(
+				userId,
+				cutoff,
+				ctx,
+			);
+			const deleted = await this.sessionRepository.deleteOwnedSessionsIdleSince(
+				userId,
+				cutoff,
+				ctx,
+			);
+			return { deleted, attachments };
+		});
+
+		// Attachment deletion cannot be rolled back, so it runs after the commit.
+		await this.chatHubAttachmentService.deleteAttachments(attachments);
+
+		return deleted;
+	}
