+	/**
+	 * Deletes the user's conversations whose last message is older than `olderThanDays`,
+	 * together with their messages and attachments. Returns the number of deleted conversations.
+	 */
+	async deleteConversationsOlderThan(userId: string, olderThanDays: number): Promise<number> {
+		const cutoff = new Date(Date.now() - olderThanDays * MS_PER_DAY);
+
+		const { deletedCount, attachments } = await this.sessionRepository.runInTransaction(
+			{},
+			async (trx) => {
+				const sessionIds = await this.sessionRepository.getIdsByOwnerLastMessageBefore(
+					userId,
+					cutoff,
+					trx,
+				);
+
+				const attachments: IBinaryData[] = [];
+				let deletedCount = 0;
+				for (let i = 0; i < sessionIds.length; i += DELETE_BATCH_SIZE) {
+					const batch = sessionIds.slice(i, i + DELETE_BATCH_SIZE);
+					attachments.push(
+						...(await this.messageRepository.getAttachmentsBySessionIds(batch, trx)),
+					);
+					deletedCount += await this.sessionRepository.deleteByIds(batch, trx);
+				}
+
+				return { deletedCount, attachments };
+			},
+		);
+
+		// File deletion cannot be rolled back, so it runs after the transaction commits.
+		if (attachments.length > 0) {
+			try {
+				await this.chatHubAttachmentService.deleteAttachments(attachments);
+			} catch {
+				this.errorReporter.warn(`Could not clean up ${attachments.length} files`);
+			}
+		}
+
+		return deletedCount;
+	}
