--- a/packages/nodes-base/nodes/KoBoToolbox/GenericFunctions.ts
+++ b/packages/nodes-base/nodes/KoBoToolbox/GenericFunctions.ts
@@ -105,6 +105,27 @@ export function parseStringList(value: string): string[] {
 	return split(toString(value), /[\s,]+/);
 }
 
+// Splits a comma-separated list of numeric submission IDs. Rejects empty lists and non-numeric IDs.
+export function parseSubmissionIds(this: IExecuteFunctions, value: unknown): string[] {
+	const ids = split(toString(value), ',')
+		.map((id) => trim(id))
+		.filter((id) => id !== '');
+
+	if (ids.length === 0) {
+		throw new NodeOperationError(this.getNode(), 'Enter at least one submission ID');
+	}
+
+	const invalidIds = ids.filter((id) => !/^\d+$/.test(id));
+	if (invalidIds.length > 0) {
+		throw new NodeOperationError(
+			this.getNode(),
+			`Submission IDs must be numbers. Invalid values: ${invalidIds.join(', ')}`,
+		);
+	}
+
+	return ids;
+}
+
 const matchWildcard = (value: string, pattern: string): boolean => {
 	return safeRegex.test(`^${escapeRegExp(pattern).replace('\\*', '.*')}$`, value);
 };
