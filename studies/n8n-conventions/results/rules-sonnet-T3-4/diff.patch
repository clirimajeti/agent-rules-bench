+/**
+ * Parse a comma-separated list of submission IDs.
+ * Throw an error if the list is empty or if an ID is not a number.
+ */
+export function parseSubmissionIds(
+	this: IExecuteFunctions,
+	value: unknown,
+	itemIndex: number,
+): string[] {
+	const ids = toString(value)
+		.split(',')
+		.map((id) => id.trim())
+		.filter((id) => id !== '');
+
+	if (ids.length === 0) {
+		throw new NodeOperationError(this.getNode(), 'The list of submission IDs is empty', {
+			itemIndex,
+			description: 'Enter at least one submission ID, for example "245128, 245129"',
+		});
+	}
+
+	const invalid = ids.find((id) => !/^\d+$/.test(id));
+	if (invalid !== undefined) {
+		throw new NodeOperationError(this.getNode(), `Submission ID "${invalid}" is not a number`, {
+			itemIndex,
+			description: 'Use only numbers in the comma-separated list of submission IDs',
+		});
+	}
+
+	return ids;
+}
+
+const matchWildcard =(value: string, pattern: string): boolean => {
 	return safeRegex.test(`^${escapeRegExp(pattern).replace('\\*', '.*')}$`, value);
 };
 
