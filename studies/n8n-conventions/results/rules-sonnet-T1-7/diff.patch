+	async getIdsByUserIdLastMessageBefore(userId: string, cutoff: Date): Promise<string[]> {
+		const sessions = await this.createQueryBuilder('session')
+			.select('session.id')
+			.where('session.ownerId = :userId', { userId })
+			.andWhere('session.lastMessageAt < :cutoff', { cutoff })
+			.getMany();
+		return sessions.map((session) => session.id);
+	}
+
+	/**
+	 * Deletes the given sessions if they are still stale. Messages are removed by
+	 * the cascading foreign key. Returns the number of deleted sessions.
+	 */
+	async deleteStaleByIds(ids: string[], userId: string, cutoff: Date): Promise<number> {
+		if (ids.length === 0) return 0;
+		const result = await this.createQueryBuilder()
+			.delete()
+			.from(ChatHubSession)
+			.where('id IN (:...ids)', { ids })
+			.andWhere('ownerId = :userId', { userId })
+			.andWhere('lastMessageAt < :cutoff', { cutoff })
+			.execute();
+		return result.affected ?? 0;
+	}
+
