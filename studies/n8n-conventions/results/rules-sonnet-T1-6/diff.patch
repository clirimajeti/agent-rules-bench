+	async getIdsByUserIdLastMessageBefore(
+		userId: string,
+		cutoff: Date,
+		trx?: EntityManager,
+	): Promise<string[]> {
+		const em = trx ?? this.manager;
+		const sessions = await em
+			.createQueryBuilder(ChatHubSession, 'session')
+			.select('session.id')
+			.where('session.ownerId = :userId', { userId })
+			.andWhere('session.lastMessageAt < :cutoff', { cutoff })
+			.getMany();
+		return sessions.map((s) => s.id);
+	}
+
+	/** Deletes the sessions of the user. Messages are removed by the foreign key cascade. */
+	async deleteManyByUserId(userId: string, ids: string[], trx?: EntityManager): Promise<number> {
+		if (ids.length === 0) return 0;
+		const em = trx ?? this.manager;
+		const result = await em
+			.createQueryBuilder()
+			.delete()
+			.from(ChatHubSession)
+			.where('ownerId = :userId', { userId })
+			.andWhere('id IN (:...ids)', { ids })
+			.execute();
+		return result.affected ?? 0;
+	}
+
