+	async getIdsByUserIdWithLastMessageBefore(
+		userId: string,
+		cutoff: Date,
+		trx?: EntityManager,
+	): Promise<string[]> {
+		const em = trx ?? this.manager;
+		const sessions = await em.find(ChatHubSession, {
+			select: ['id'],
+			where: { ownerId: userId, lastMessageAt: LessThan(cutoff) },
+		});
+		return sessions.map((session) => session.id);
+	}
+
+	/**
+	 * Deletes the given sessions of a user. Messages are removed by the foreign key cascade.
+	 * Returns the number of deleted sessions.
+	 */
+	async deleteByIdsAndUserId(
+		ids: string[],
+		userId: string,
+		trx?: EntityManager,
+	): Promise<number> {
+		if (ids.length === 0) return 0;
+		const em = trx ?? this.manager;
+		const result = await em.delete(ChatHubSession, { id: In(ids), ownerId: userId });
+		return result.affected ?? 0;
+	}
