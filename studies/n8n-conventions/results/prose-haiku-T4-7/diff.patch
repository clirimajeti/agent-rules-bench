 	loadResource,
 } from './GenericFunctions';
 
+/** Member status for an invitation that the invitee has not accepted yet. */
+const INVITED_MEMBER_STATUS = 0;
+
+interface BitwardenMember {
+	id: string;
+	email: string;
+	status: number;
+}
+
+/**
+ * Resend the invitation to every member whose invitation is still pending.
+ * Return one item per pending member with the result of the resend.
+ */
+async function resendPendingInvitations(
+	this: IExecuteFunctions,
+	token: string,
+): Promise<INodeExecutionData[]> {
+	const response: { data: BitwardenMember[] } = await tokenlessBitwardenApiRequest.call(
+		this,
+		'GET',
+		'/public/members',
+		{},
+		{},
+		token,
+	);
+
+	const pendingMembers = response.data.filter(
+		(member) => member.status === INVITED_MEMBER_STATUS,
+	);
+
+	if (pendingMembers.length === 0) {
+		throw new NodeOperationError(
+			this.getNode(),
+			'The organization has no pending members. No invitations were resent.',
+		);
+	}
+
+	const results: IDataObject[] = [];
+
+	for (const member of pendingMembers) {
+		try {
+			await tokenlessBitwardenApiRequest.call(
+				this,
+				'POST',
+				`/public/members/${member.id}/re-invite`,
+				{},
+				{},
+				token,
+			);
+			results.push({ email: member.email, success: true });
+		} catch (error) {
+			results.push({
+				email: member.email,
+				success: false,
+				error: error instanceof Error ? error.message : 'Unknown error',
+			});
+		}
+	}
+
+	return this.helpers.constructExecutionMetaData(this.helpers.returnJsonArray(results), {
+		itemData: { item: 0 },
+	});
+}
