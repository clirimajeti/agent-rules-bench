+		userId: string,
+		cutoff: Date,
+		trx?: EntityManager,
+	): Promise<string[]> {
+		const em = trx ?? this.manager;
+		const sessions = await em.find(ChatHubSession, {
+			where: { ownerId: userId, lastMessageAt: LessThan(cutoff) },
+			select: ['id'],
+		});
+		return sessions.map((session) => session.id);
+	}
+
+	/**
+	 * Deletes the given sessions of one owner. Messages are removed by the cascade.
+	 * The cutoff check runs again, so a session that got a new message is kept.
+	 * Returns the number of deleted sessions.
+	 */
+	async deleteByOwnerAndIdsLastMessageBefore(
+		userId: string,
+		ids: string[],
+		cutoff: Date,
+		trx?: EntityManager,
+	): Promise<number> {
+		if (ids.length === 0) return 0;
+		const em = trx ?? this.manager;
+		const result = await em.delete(ChatHubSession, {
+			id: In(ids),
+			ownerId: userId,
+			lastMessageAt: LessThan(cutoff),
+		});
+		return result.affected ?? 0;
+	}
