+	async deleteByOwnerAndIdsLastMessageBefore(
+		userId: string,
+		ids: string[],
+		cutoff: Date,
+		ctx: OperationContext,
+	): Promise<number> {
+		if (ids.length === 0) return 0;
+		const result = await this.managerFor(ctx).delete(ChatHubSession, {
+			id: In(ids),
+			ownerId: userId,
+			lastMessageAt: LessThan(cutoff),
+		});
+		return result.affected ?? 0;
+	}
