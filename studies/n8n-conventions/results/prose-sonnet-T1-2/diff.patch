+	/**
+	 * Deletes the user's sessions whose last message is older than the given number of days.
+	 * Returns the number of deleted sessions.
+	 */
+	async deleteSessionsOlderThan(userId: string, olderThanDays: number): Promise<number> {
+		const cutoff = new Date(Date.now() - olderThanDays * 24 * 60 * 60 * 1000);
+
+		return await this.txRunner.run({}, async (ctx) => {
+			const ids = await this.sessionRepository.getIdsByOwnerLastMessageBefore(userId, cutoff, ctx);
+			await this.chatHubAttachmentService.deleteAllBySessionIds(ids, ctx);
+			return await this.sessionRepository.deleteByOwnerAndIdsLastMessageBefore(
+				userId,
+				ids,
+				cutoff,
+				ctx,
+			);
+		});
+	}
