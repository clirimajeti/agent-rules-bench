+import type { MigrationContext, ReversibleMigration } from '../migration-types';
+
+const TABLE_NAME = 'oauth_access_tokens';
+const COLUMN_NAME = 'expiresAt';
+
+/**
+ * Stores when each access token expires, in Unix milliseconds, so live tokens can
+ * be counted in SQL. Existing rows get 0, so they never count as live. Tokens
+ * issued before the upgrade keep working until they expire, which takes at most
+ * one hour. After that hour the count is exact.
+ */
+export class AddExpiresAtToOAuthAccessTokens1793800000000 implements ReversibleMigration {
+	async up({ schemaBuilder: { addColumns, column } }: MigrationContext) {
+		await addColumns(TABLE_NAME, [column(COLUMN_NAME).bigint.notNull.default(0)], {
+			recreatesOnSqlite: true,
+		});
+	}
+
+	async down({ schemaBuilder: { dropColumns } }: MigrationContext) {
+		await dropColumns(TABLE_NAME, [COLUMN_NAME], { recreatesOnSqlite: true });
+	}
+}
