+	/** Count unexpired access tokens per (client, user). `clientIds` must not be empty. */
+	async countLiveByClients(clientIds: string[], now: number): Promise<LiveAccessTokenCount[]> {
+		const rows = await this.createQueryBuilder('token')
+			.select('token.clientId', 'clientId')
+			.addSelect('token.userId', 'userId')
+			.addSelect('COUNT(*)', 'count')
+			.where('token.clientId IN (:...clientIds)', { clientIds })
+			.andWhere('token.expiresAt > :now', { now })
+			.groupBy('token.clientId')
+			.addGroupBy('token.userId')
+			.getRawMany<{ clientId: string; userId: string; count: string | number }>();
+
+		// COUNT comes back as a string on Postgres.
+		return rows.map((row) => ({
+			clientId: row.clientId,
+			userId: row.userId,
+			count: Number(row.count),
+		}));
+	}
+
+	/** Delete every access token of a client, across all users. Returns the rows deleted. */
+	async deleteByClient(clientId: string, ctx: OperationContext): Promise<number> {
+		const result = await this.managerFor(ctx).delete(AccessToken, { clientId });
+		return result.affected ?? 0;
+	}
 }
