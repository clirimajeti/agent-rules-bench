 export async function koBoToolboxApiRequest(
 	this: IExecuteFunctions | IWebhookFunctions | IHookFunctions | ILoadOptionsFunctions,
@@ -105,6 +105,24 @@ export function parseStringList(value: string): string[] {
 	return split(toString(value), /[\s,]+/);
 }
 
+// Parse a comma-separated list of numeric IDs. Reject the whole list if any ID is invalid.
+export function parseSubmissionIds(value: string): string[] {
+	const trimmed = trim(toString(value));
+	if (!trimmed) {
+		throw new UserError('Enter at least one submission ID');
+	}
+
+	const ids = split(trimmed, ',').map((id) => trim(id));
+	const invalidIds = ids.filter((id) => !/^\d+$/.test(id));
+	if (invalidIds.length > 0) {
+		throw new UserError(
+			`Submission IDs must be numbers. Invalid values: ${invalidIds.map((id) => `"${id}"`).join(', ')}`,
+		);
+	}
+
+	return ids;
+}
+
 const matchWildcard = (value: string, pattern: string): boolean => {
 	return safeRegex.test(`^${escapeRegExp(pattern).replace('\\*', '.*')}$`, value);
 };
