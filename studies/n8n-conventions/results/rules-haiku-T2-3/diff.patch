+	/**
+	 * Count the unexpired access tokens of each client. `clientIds` must be
+	 * non-empty. Clients without a match are absent from the result.
+	 */
+	async countUnexpiredByClientIds(
+		clientIds: string[],
+		now: number,
+	): Promise<Array<{ clientId: string; count: number }>> {
+		const rows = await this.createQueryBuilder('token')
+			.select('token.clientId', 'clientId')
+			.addSelect('COUNT(*)', 'count')
+			.where('token.clientId IN (:...clientIds)', { clientIds })
+			.andWhere('token.expiresAt > :now', { now })
+			.groupBy('token.clientId')
+			.getRawMany<{ clientId: string; count: string | number }>();
+
+		// COUNT comes back as a string on some drivers (Postgres bigint).
+		return rows.map((row) => ({ clientId: row.clientId, count: Number(row.count) }));
+	}
 }
