+import type { MigrationContext, ReversibleMigration } from '../migration-types';
+
+// Access tokens are 1-hour JWTs. Rows that exist before this migration get one
+// full TTL from the migration time, so live tokens count as valid straight away.
+const ACCESS_TOKEN_TTL_MS = 60 * 60 * 1000;
+
+export class AddExpiresAtToOAuthAccessTokens1795307533156 implements ReversibleMigration {
+	async up({ escape, runQuery, isPostgres }: MigrationContext) {
+		const tableName = escape.tableName('oauth_access_tokens');
+		const expiresAt = escape.columnName('expiresAt');
+
+		// Not using the addColumns DSL: a defaulted column can be added with a plain
+		// ALTER TABLE, which avoids recreating the table on SQLite.
+		await runQuery(`ALTER TABLE ${tableName} ADD COLUMN ${expiresAt} INT NOT NULL DEFAULT 0`);
+
+		await runQuery(`UPDATE ${tableName} SET ${expiresAt} = :expiresAt`, {
+			expiresAt: Date.now() + ACCESS_TOKEN_TTL_MS,
+		});
+
+		if (isPostgres) {
+			await runQuery(
+				`COMMENT ON COLUMN ${tableName}.${expiresAt} IS 'Unix ms when the access token JWT expires'`,
+			);
+		}
+	}
+
+	async down({ escape, runQuery }: MigrationContext) {
+		const tableName = escape.tableName('oauth_access_tokens');
+		const expiresAt = escape.columnName('expiresAt');
+
+		await runQuery(`ALTER TABLE ${tableName} DROP COLUMN ${expiresAt}`);
+	}
+}
