+++ b/packages/@n8n/db/src/migrations/common/1795392000000-AddExpiresAtToOAuthAccessTokens.ts
@@ -0,0 +1,38 @@
+import type { MigrationContext, ReversibleMigration } from '../migration-types';
+
+const TABLE_NAME = 'oauth_access_tokens';
+const COLUMN_NAME = 'expiresAt';
+
+/**
+ * Records when each access token expires, so the client list can count valid
+ * tokens in SQL instead of decoding every JWT.
+ *
+ * Existing rows are cleared first: they have no recorded expiry, and none can be
+ * derived in SQL. Access tokens last one hour. Clients refresh them with the
+ * refresh token, which is kept.
+ *
+ * Reversible on purpose: the column is dropped. Reversal excludes restoring the
+ * cleared access tokens.
+ */
+export class AddExpiresAtToOAuthAccessTokens1795392000000 implements ReversibleMigration {
+	async up({ schemaBuilder: { addColumns, column }, escape, runQuery }: MigrationContext) {
+		await runQuery(`DELETE FROM ${escape.tableName(TABLE_NAME)}`);
+
+		// No default on purpose: an insert that forgets the expiry must fail.
+		await addColumns(
+			TABLE_NAME,
+			[
+				column(COLUMN_NAME)
+					.bigint.notNull.comment(
+						'Unix timestamp in milliseconds when the access token JWT expires',
+					),
+			],
+			{ recreatesOnSqlite: true },
+		);
+	}
+
+	/** Reversal excludes restoring the cleared access tokens. */
+	async down({ schemaBuilder: { dropColumns } }: MigrationContext) {
+		await dropColumns(TABLE_NAME, [COLUMN_NAME], { recreatesOnSqlite: true });
+	}
+}
