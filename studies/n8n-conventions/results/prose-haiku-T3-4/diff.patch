 	return split(toString(value), /[\s,]+/);
 }
 
+// Accepts only a comma-separated list of numeric submission IDs
+export function parseSubmissionIds(value: unknown, node: INode): string[] {
+	const trimmed = trim(toString(value));
+	if (!trimmed) {
+		throw new NodeOperationError(node, 'Enter at least one submission ID');
+	}
+
+	const ids = split(trimmed, ',').map((id) => trim(id));
+	const invalid = ids.find((id) => !/^\d+$/.test(id));
+	if (invalid !== undefined) {
+		throw new NodeOperationError(node, `Submission ID "${invalid}" is not a number`);
+	}
+
+	return ids;
+}
+
 const matchWildcard = (value: string, pattern: string): boolean => {
 	return safeRegex.test(`^${escapeRegExp(pattern).replace('\\*', '.*')}$`, value);
 };
