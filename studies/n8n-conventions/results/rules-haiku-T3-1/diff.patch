 	INodePropertyOptions,
 	IWebhookFunctions,
@@ -105,6 +106,24 @@ export function parseStringList(value: string): string[] {
 	return split(toString(value), /[\s,]+/);
 }
 
+// Validate the whole list before any request is sent
+export function parseSubmissionIds(node: INode, value: string): string[] {
+	if (trim(toString(value)) === '') {
+		throw new NodeOperationError(node, 'Enter at least one submission ID');
+	}
+
+	const ids = split(toString(value), ',').map((id) => trim(id));
+	const invalidId = ids.find((id) => !/^\d+$/.test(id));
+	if (invalidId !== undefined) {
+		throw new NodeOperationError(
+			node,
+			`Submission ID "${invalidId}" is not a number. Use comma-separated numbers only`,
+		);
+	}
+
+	return ids;
+}
+
 const matchWildcard = (value: string, pattern: string): boolean => {
 	return safeRegex.test(`^${escapeRegExp(pattern).replace('\\*', '.*')}$`, value);
 };
