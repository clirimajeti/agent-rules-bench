@@ -105,6 +105,39 @@ export function parseStringList(value: string): string[] {
 	return split(toString(value), /[\s,]+/);
 }
 
+/**
+ * Parse a comma-separated list of submission IDs.
+ * Throw an error if the list is empty or if an ID is not a number.
+ */
+export function parseSubmissionIds(
+	this: IExecuteFunctions,
+	value: string,
+	itemIndex = 0,
+): string[] {
+	const ids = toString(value)
+		.split(',')
+		.map((id) => id.trim());
+
+	if (ids.length === 1 && ids[0] === '') {
+		throw new NodeOperationError(this.getNode(), 'The list of submission IDs is empty', {
+			itemIndex,
+			description: 'Enter at least one submission ID, for example "245128, 245129"',
+		});
+	}
+
+	for (const id of ids) {
+		if (!/^\d+$/.test(id)) {
+			throw new NodeOperationError(this.getNode(), `"${id}" is not a valid submission ID`, {
+				itemIndex,
+				description:
+					'Each submission ID must be a number. Separate the IDs with commas, for example "245128, 245129"',
+			});
+		}
+	}
+
+	return ids;
+}
