+/**
+ * Parse a comma-separated list of submission IDs.
+ * Throw an error when the list is empty or an ID is not a whole number.
+ */
+export function parseSubmissionIds(node: INode, value: string, itemIndex: number): string[] {
+	const ids = toString(value)
+		.split(',')
+		.map((id) => id.trim());
+
+	if (ids.every((id) => id === '')) {
+		throw new NodeOperationError(node, 'The list of submission IDs is empty', { itemIndex });
+	}
+
+	const invalid = ids.find((id) => !/^\d+$/.test(id));
+	if (invalid !== undefined) {
+		throw new NodeOperationError(node, `The submission ID "${invalid}" is not a number`, {
+			itemIndex,
+			description: 'Use a comma-separated list of numbers, for example 245128, 245129',
+		});
+	}
+
+	return ids;
+}
+
+const matchWildcard =(value: string, pattern: string): boolean => {
 	return safeRegex.test(`^${escapeRegExp(pattern).replace('\\*', '.*')}$`, value);
 };
 
