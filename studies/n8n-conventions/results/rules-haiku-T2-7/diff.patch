+export class AddExpiresAtToOAuthAccessTokens1795308230445 implements ReversibleMigration {
+	async up({ schemaBuilder: { addColumns, column } }: MigrationContext) {
+		// Rows written before this column existed get 0, so they count as expired.
+		await addColumns(
+			'oauth_access_tokens',
+			[
+				column('expiresAt')
+					.bigint.notNull.default('0')
+					.comment('Unix timestamp in milliseconds when the token expires'),
+			],
+			{ recreatesOnSqlite: true },
+		);
+	}
+
+	async down({ schemaBuilder: { dropColumns } }: MigrationContext) {
+		await dropColumns('oauth_access_tokens', ['expiresAt'], { recreatesOnSqlite: true });
+	}
+}
