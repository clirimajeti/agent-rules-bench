+interface MemberSummary {
+	id: string;
+	email: string;
+	status: number;
+}
+
+function isMemberSummary(value: unknown): value is MemberSummary {
+	return (
+		typeof value === 'object' &&
+		value !== null &&
+		'id' in value &&
+		typeof value.id === 'string' &&
+		'email' in value &&
+		typeof value.email === 'string' &&
+		'status' in value &&
+		typeof value.status === 'number'
+	);
+}
+
+function isMembersResponse(value: unknown): value is { data: MemberSummary[] } {
+	return (
+		typeof value === 'object' &&
+		value !== null &&
+		'data' in value &&
+		Array.isArray(value.data) &&
+		value.data.every(isMemberSummary)
+	);
+}
