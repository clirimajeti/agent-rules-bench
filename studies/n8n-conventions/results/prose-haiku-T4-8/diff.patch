diff --git a/packages/nodes-base/nodes/Bitwarden/GenericFunctions.ts b/packages/nodes-base/nodes/Bitwarden/GenericFunctions.ts
index db44352885..ae543cc49a 100644
--- a/packages/nodes-base/nodes/Bitwarden/GenericFunctions.ts
+++ b/packages/nodes-base/nodes/Bitwarden/GenericFunctions.ts
@@ -7,7 +7,7 @@ import type {
 	IRequestOptions,
 	JsonObject,
 } from 'n8n-workflow';
-import { NodeApiError } from 'n8n-workflow';
+import { NodeApiError, NodeOperationError } from 'n8n-workflow';
 
 /**
  * Return the access token URL based on the user's environment.
@@ -144,3 +144,65 @@ export async function loadResource(this: ILoadOptionsFunctions, resource: string
 
 	return returnData;
 }
+
+type BitwardenMember = {
+	id: string;
+	email: string;
+	status: number;
+};
+
+/** Member status for a member whose invitation has not been accepted yet. */
+const MEMBER_STATUS_INVITED = 0;
+
+/**
+ * Resend the invitation to every member whose invitation is still pending.
+ * Returns one result per pending member.
+ */
+export async function resendPendingInvitations(
+	this: IExecuteFunctions,
+	token: string,
+): Promise<IDataObject[]> {
+	const response: { data: BitwardenMember[] } = await bitwardenApiRequest.call(
+		this,
+		'GET',
+		'/public/members',
+		{},
+		{},
+		token,
+	);
+
+	const pendingMembers = response.data.filter(
+		(member) => member.status === MEMBER_STATUS_INVITED,
+	);
+
+	if (pendingMembers.length === 0) {
+		throw new NodeOperationError(
+			this.getNode(),
+			'This organization has no members with a pending invitation. Nothing to resend.',
+		);
+	}
+
+	const results: IDataObject[] = [];
+
+	for (const member of pendingMembers) {
+		try {
+			await bitwardenApiRequest.call(
+				this,
+				'POST',
+				`/public/members/${member.id}/reinvite`,
+				{},
+				{},
+				token,
+			);
+			results.push({ email: member.email, success: true });
+		} catch (error) {
+			results.push({
+				email: member.email,
+				success: false,
+				error: error instanceof Error ? error.message : String(error),
+			});
+		}
+	}
+
+	return results;
+}
