@@ -0,0 +1,36 @@
+import type { MigrationContext, ReversibleMigration } from '../migration-types';
+
+const TABLE_NAME = 'oauth_access_tokens';
+const COLUMN_NAME = 'expiresAt';
+
+/** Lifetime of an access token. Matches `OAUTH_ACCESS_TOKEN_TTL_SECONDS`. */
+const ACCESS_TOKEN_TTL_MS = 60 * 60 * 1000;
+
+/**
+ * Stores when each access token expires, so the admin client list can count the
+ * tokens that are still valid with a single query.
+ *
+ * Existing rows have no recorded expiry. They were all minted at or before this
+ * migration, so their JWT `exp` is at most one token lifetime after it. That upper
+ * bound is used for them. The count can be high for up to one lifetime after the
+ * upgrade, but a live token is never left out of it.
+ */
+export class AddExpiresAtToOAuthAccessTokens1795305600000 implements ReversibleMigration {
+	async up({ schemaBuilder: { addColumns, column }, escape, runQuery }: MigrationContext) {
+		// The default only fills existing rows. Inserts always set the value.
+		await addColumns(TABLE_NAME, [
+			column(COLUMN_NAME)
+				.bigint.notNull.default(0)
+				.comment('Unix timestamp in milliseconds when the access token expires'),
+		]);
+
+		await runQuery(
+			`UPDATE ${escape.tableName(TABLE_NAME)} SET ${escape.columnName(COLUMN_NAME)} = :expiresAt`,
+			{ expiresAt: Date.now() + ACCESS_TOKEN_TTL_MS },
+		);
+	}
+
+	async down({ schemaBuilder: { dropColumns } }: MigrationContext) {
+		await dropColumns(TABLE_NAME, [COLUMN_NAME], { recreatesOnSqlite: true });
+	}
+}
