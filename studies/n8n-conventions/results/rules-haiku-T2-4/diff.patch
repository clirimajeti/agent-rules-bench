+	/**
+	 * Unexpired access tokens at `now`, counted per (client, user) pair. Only the
+	 * pairs in the given id sets can match, so the caller filters the result.
+	 */
+	async countValidByGrant(
+		clientIds: string[],
+		userIds: string[],
+		now: number,
+	): Promise<Array<{ clientId: string; userId: string; count: string }>> {
+		return await this.createQueryBuilder('token')
+			.select('token.clientId', 'clientId')
+			.addSelect('token.userId', 'userId')
+			.addSelect('COUNT(*)', 'count')
+			.where('token.clientId IN (:...clientIds)', { clientIds })
+			.andWhere('token.userId IN (:...userIds)', { userIds })
+			.andWhere('token.expiresAt > :now', { now })
+			.groupBy('token.clientId')
+			.addGroupBy('token.userId')
+			.getRawMany<{ clientId: string; userId: string; count: string }>();
+	}
 }
