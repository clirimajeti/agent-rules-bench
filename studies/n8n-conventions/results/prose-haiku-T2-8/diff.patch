+
+	/** Counts unexpired access tokens per client. Clients with none are absent from the map. */
+	async countValidByClientIds(clientIds: string[], now: number): Promise<Map<string, number>> {
+		if (clientIds.length === 0) return new Map();
+
+		const rows = await this.createQueryBuilder('token')
+			.select('token.clientId', 'clientId')
+			.addSelect('COUNT(*)', 'count')
+			.where('token.clientId IN (:...clientIds)', { clientIds })
+			.andWhere('token.expiresAt > :now', { now })
+			.groupBy('token.clientId')
+			.getRawMany<{ clientId: string; count: string | number }>();
+
+		return new Map(rows.map((row) => [row.clientId, Number(row.count)]));
+	}
+
+	/** Delete every access token of a client, across all users. Returns the number deleted. */
+	async deleteByClientId(clientId: string): Promise<number> {
+		const result = await this.delete({ clientId });
+		return result.affected ?? 0;
+	}
 }
