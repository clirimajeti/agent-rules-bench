index 0000000000..ea5452ce12
--- /dev/null
+++ b/packages/@n8n/db/src/migrations/common/1793640000000-AddExpiresAtToOAuthAccessTokens.ts
@@ -0,0 +1,32 @@
+import type { MigrationContext, ReversibleMigration } from '../migration-types';
+
+const TABLE_NAME = 'oauth_access_tokens';
+const COLUMN_NAME = 'expiresAt';
+
+/**
+ * Stores when each access token expires, so the admin client list can count the
+ * tokens that are still valid.
+ *
+ * Existing rows are cleared first: they predate the column, so their expiry is
+ * unknown. Access tokens live for one hour and clients refresh them with their
+ * refresh token, so the cleared rows cost one refresh per client.
+ *
+ * Reversible. The reversal does not restore the cleared rows.
+ */
+export class AddExpiresAtToOAuthAccessTokens1793640000000 implements ReversibleMigration {
+	async up({ schemaBuilder: { addColumns, column }, escape, runQuery }: MigrationContext) {
+		await runQuery(`DELETE FROM ${escape.tableName(TABLE_NAME)}`);
+
+		// No default on purpose: an insert that forgets the expiry must fail.
+		await addColumns(
+			TABLE_NAME,
+			[column(COLUMN_NAME).bigint.notNull.comment('Unix timestamp in milliseconds')],
+			{ recreatesOnSqlite: true },
+		);
+	}
+
+	/** Reversal does not restore the cleared access tokens. */
+	async down({ schemaBuilder: { dropColumns } }: MigrationContext) {
+		await dropColumns(TABLE_NAME, [COLUMN_NAME], { recreatesOnSqlite: true });
+	}
+}
