diff --git a/packages/@n8n/db/src/migrations/common/1793640000000-AddExpiresAtToOAuthAccessTokens.ts b/packages/@n8n/db/src/migrations/common/1793640000000-AddExpiresAtToOAuthAccessTokens.ts
