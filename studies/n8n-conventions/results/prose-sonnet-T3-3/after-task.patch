+/**
+ * Parse a comma-separated list of submission IDs.
+ * Throw if the list is empty or an ID is not a whole number.
+ */
+export function parseSubmissionIds(
+	node: INode,
+	value: string,
+	itemIndex: number,
+): number[] {
+	const parts = toString(value)
+		.split(',')
+		.map((part) => part.trim());
+
+	if (parts.length === 1 && parts[0] === '') {
+		throw new NodeOperationError(node, 'The list of submission IDs is empty', { itemIndex });
+	}
+
+	const ids: number[] = [];
+	for (const part of parts) {
+		if (!/^\d+$/.test(part)) {
+			throw new NodeOperationError(
+				node,
+				`"${part}" is not a valid submission ID`,
+				{ itemIndex, description: 'Submission IDs must be whole numbers, separated by commas' },
+			);
+		}
+		const id = Number(part);
+		if (!ids.includes(id)) ids.push(id);
+	}
+
+	return ids;
+}
