+	async getIdsByUserIdLastMessageBefore(userId: string, cutoff: Date): Promise<string[]> {
+		const sessions = await this.find({
+			where: { ownerId: userId, lastMessageAt: LessThan(cutoff) },
+			select: ['id'],
+		});
+		return sessions.map((session) => session.id);
+	}
+
+	/**
+	 * Deletes the given sessions of a user that are still older than the cutoff.
+	 * Messages are removed by the database cascade. Returns the number of deleted sessions.
+	 */
+	async deleteByUserIdAndIdsLastMessageBefore(
+		userId: string,
+		ids: string[],
+		cutoff: Date,
+	): Promise<number> {
+		if (ids.length === 0) return 0;
+
+		const result = await this.delete({
+			id: In(ids),
+			ownerId: userId,
+			lastMessageAt: LessThan(cutoff),
+		});
+		return result.affected ?? 0;
+	}
