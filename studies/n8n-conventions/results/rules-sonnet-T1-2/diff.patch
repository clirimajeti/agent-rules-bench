+	/**
+	 * Deletes the user's sessions whose last message is older than the given number of days.
+	 * Messages are removed through the cascade on the session foreign key.
+	 */
+	async deleteStaleSessions(userId: string, olderThanDays: number): Promise<number> {
+		const cutoff = new Date(Date.now() - olderThanDays * 24 * 60 * 60 * 1000);
+
+		const ids = await this.sessionRepository.findIdsByOwnerLastMessageBefore(userId, cutoff);
+
+		// Attachment deletion cannot be rolled back, so it runs before the single atomic delete.
+		for (const id of ids) {
+			await this.chatHubAttachmentService.deleteAllBySessionId(id);
+		}
+		await this.sessionRepository.deleteManyByIds(ids);
+
+		return ids.length;
+	}
