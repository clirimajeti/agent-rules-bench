+	/**
+	 * Count unexpired access tokens per (client, user) pair at `now`. The caller
+	 * passes the client and user ids of a page; the result may include other pairs
+	 * from the same id sets, so the caller must match the pairs it needs.
+	 */
+	async countValidForGrants(
+		grants: { clientIds: string[]; userIds: string[] },
+		now: number,
+	): Promise<Array<{ clientId: string; userId: string; count: number }>> {
+		const rows = await this.createQueryBuilder('token')
+			.select('token.clientId', 'clientId')
+			.addSelect('token.userId', 'userId')
+			.addSelect('COUNT(*)', 'count')
+			.where('token.clientId IN (:...clientIds)', { clientIds: grants.clientIds })
+			.andWhere('token.userId IN (:...userIds)', { userIds: grants.userIds })
+			.andWhere('token.expiresAt > :now', { now })
+			.groupBy('token.clientId')
+			.addGroupBy('token.userId')
+			.getRawMany<{ clientId: string; userId: string; count: string | number }>();
+
+		// Postgres returns COUNT(*) as a string.
+		return rows.map((row) => ({
+			clientId: row.clientId,
+			userId: row.userId,
+			count: Number(row.count),
+		}));
+	}
+
+	/** Deletes every access token of a client, for all users. Returns the rows deleted. */
+	async deleteAllForClient(clientId: string): Promise<number> {
+		const result = await this.delete({ clientId });
+		return result.affected ?? 0;
+	}
 }
