+import type { MigrationContext, ReversibleMigration } from '../migration-types';
+
+export class AddExpiresAtToOAuthAccessTokens1793800000000 implements ReversibleMigration {
+	async up({ escape, runQuery, isPostgres }: MigrationContext) {
+		const tableName = escape.tableName('oauth_access_tokens');
+		const expiresAt = escape.columnName('expiresAt');
+
+		// Existing rows get 0, so they count as expired. Their JWT `exp` still governs verification.
+		await runQuery(`ALTER TABLE ${tableName} ADD COLUMN ${expiresAt} BIGINT NOT NULL DEFAULT 0`);
+
+		if (isPostgres) {
+			await runQuery(
+				`COMMENT ON COLUMN ${tableName}.${expiresAt} IS 'Unix ms after which the access token JWT is expired.'`,
+			);
+		}
+	}
+
+	async down({ escape, runQuery }: MigrationContext) {
+		const tableName = escape.tableName('oauth_access_tokens');
+		const expiresAt = escape.columnName('expiresAt');
+
+		await runQuery(`ALTER TABLE ${tableName} DROP COLUMN ${expiresAt}`);
+	}
+}
