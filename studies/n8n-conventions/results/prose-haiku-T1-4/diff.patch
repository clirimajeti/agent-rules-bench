+
+	/**
+	 * Deletes sessions by ID and returns the number of deleted rows.
+	 */
+	async deleteByIds(ids: string[], trx?: EntityManager): Promise<number> {
+		const em = trx ?? this.manager;
+		let deleted = 0;
+		for (const chunk of chunkIds(ids)) {
+			const result = await em.delete(ChatHubSession, { id: In(chunk) });
+			deleted += result.affected ?? 0;
+		}
+		return deleted;
+	}
