+	 * Returns the IDs of the owner's sessions whose last message is before `cutoff`.
+	 */
+	async getIdsByOwnerOlderThan(ownerId: string, cutoff: Date, trx?: EntityManager) {
+		const em = trx ?? this.manager;
+		const sessions = await em.find(ChatHubSession, {
+			select: ['id'],
+			where: { ownerId, lastMessageAt: LessThan(cutoff) },
+		});
+		return sessions.map((session) => session.id);
