+	/**
+	 * Deletes the user's sessions whose last message is older than `olderThanDays`,
+	 * together with their messages and attachments. Returns the number of deleted sessions.
+	 */
+	async deleteConversationsOlderThan(userId: string, olderThanDays: number): Promise<number> {
+		const cutoff = new Date(Date.now() - olderThanDays * 24 * 60 * 60 * 1000);
+
+		const { deletedCount, attachments } = await this.sessionRepository.runInTransaction(
+			{},
+			async (trx): Promise<{ deletedCount: number; attachments: IBinaryData[] }> => {
+				const sessionIds = await this.sessionRepository.getIdsByOwnerOlderThan(userId, cutoff, trx);
+				if (sessionIds.length === 0) {
+					return { deletedCount: 0, attachments: [] };
+				}
+
+				const attachments = await this.messageRepository.getAttachmentsBySessionIds(
+					sessionIds,
+					trx,
+				);
+				await this.messageRepository.deleteBySessionIds(sessionIds, trx);
+				const deletedCount = await this.sessionRepository.deleteByIds(sessionIds, trx);
+
+				return { deletedCount, attachments };
+			},
+		);
+
+		// Attachment deletion cannot be rolled back, so it runs after the transaction commits.
+		await this.chatHubAttachmentService.deleteAttachments(attachments);
+
+		return deletedCount;
+	}
