+	/**
+	 * Returns the IDs of the user's sessions whose last message is before `cutoff`.
+	 */
+	async getIdsOfUserSessionsLastMessageBefore(
+		userId: string,
+		cutoff: Date,
+		trx?: EntityManager,
+	): Promise<string[]> {
+		const em = trx ?? this.manager;
+		const sessions = await em
+			.createQueryBuilder(ChatHubSession, 'session')
+			.select('session.id', 'id')
+			.where('session.ownerId = :userId', { userId })
+			.andWhere('session.lastMessageAt < :cutoff', { cutoff })
+			.getRawMany<{ id: string }>();
+
+		return sessions.map((session) => session.id);
+	}
+
+	/**
+	 * Deletes the given sessions owned by the user. Their messages are removed by the database cascade.
+	 */
+	async deleteUserSessionsByIds(userId: string, ids: string[], trx?: EntityManager) {
+		if (ids.length === 0) return;
+
+		const em = trx ?? this.manager;
+		await em
+			.createQueryBuilder()
+			.delete()
+			.from(ChatHubSession)
+			.where('ownerId = :userId', { userId })
+			.andWhere('id IN (:...ids)', { ids })
+			.execute();
+	}
