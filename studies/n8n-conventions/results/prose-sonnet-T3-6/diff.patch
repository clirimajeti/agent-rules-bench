+/**
+ * Parse a comma-separated list of submission IDs.
+ * Throw an error if the list is empty or if an ID is not a number.
+ */
+export function parseSubmissionIds(this: IExecuteFunctions, value: unknown): string[] {
+	const ids = toString(value)
+		.split(',')
+		.map((id) => id.trim())
+		.filter((id) => id !== '');
+
+	if (ids.length === 0) {
+		throw new NodeOperationError(this.getNode(), 'The list of submission IDs is empty');
+	}
+
+	const invalidId = ids.find((id) => !/^\d+$/.test(id));
+	if (invalidId !== undefined) {
+		throw new NodeOperationError(
+			this.getNode(),
+			`The submission ID "${invalidId}" is not a number`,
+		);
+	}
+
+	return [...new Set(ids)];
+}
+
+const matchWildcard =(value: string, pattern: string): boolean => {
 	return safeRegex.test(`^${escapeRegExp(pattern).replace('\\*', '.*')}$`, value);
 };
 
