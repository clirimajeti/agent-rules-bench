+	/**
+	 * Deletes the user's sessions whose last message is older than the given number of days.
+	 * Returns the number of deleted sessions.
+	 */
+	async deleteStaleSessions(userId: string, olderThanDays: number): Promise<number> {
+		const cutoff = new Date(Date.now() - olderThanDays * 24 * 60 * 60 * 1000);
+
+		const { count, attachments } = await this.txRunner.run({}, async (ctx) => {
+			const sessionIds = await this.sessionRepository.getIdsByUserIdLastMessageBefore(
+				userId,
+				cutoff,
+				ctx,
+			);
+			const attachments = await this.messageRepository.getAttachmentsBySessionIds(sessionIds, ctx);
+			await this.sessionRepository.deleteByIds(sessionIds, ctx);
+
+			return { count: sessionIds.length, attachments };
+		});
+
+		// File deletion cannot be rolled back, so it runs after the commit.
+		await this.chatHubAttachmentService.deleteAttachments(attachments);
+
+		return count;
+	}
