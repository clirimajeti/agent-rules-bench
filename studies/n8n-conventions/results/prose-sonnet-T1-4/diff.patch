+	async getIdsByUserIdLastMessageBefore(userId: string, cutoff: Date, ctx: OperationContext) {
+		const sessions = await this.managerFor(ctx).find(ChatHubSession, {
+			select: { id: true },
+			where: { ownerId: userId, lastMessageAt: LessThan(cutoff) },
+		});
+		return sessions.map((session) => session.id);
+	}
+
+	/**
+	 * Deletes the given sessions of a user. Messages are removed by the FK cascade.
+	 */
+	async deleteManyByIds(userId: string, ids: string[], ctx: OperationContext) {
+		const em = this.managerFor(ctx);
+		// Chunk the ids to stay under the query parameter limit of the database
+		const chunkSize = 500;
+		let affected = 0;
+		for (let i = 0; i < ids.length; i += chunkSize) {
+			const result = await em.delete(ChatHubSession, {
+				id: In(ids.slice(i, i + chunkSize)),
+				ownerId: userId,
+			});
+			affected += result.affected ?? 0;
+		}
+		return affected;
+	}
