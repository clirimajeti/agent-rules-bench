+	/**
+	 * Deletes the user's sessions whose last message is older than the given number of days.
+	 * Returns the number of deleted sessions.
+	 */
+	async deleteStaleSessions(userId: string, olderThanDays: number): Promise<number> {
+		const cutoff = new Date(Date.now() - olderThanDays * 24 * 60 * 60 * 1000);
+
+		return await this.transactionRunner.run({}, async (ctx) => {
+			const ids = await this.sessionRepository.getIdsByUserIdLastMessageBefore(
+				userId,
+				cutoff,
+				ctx,
+			);
+
+			for (const id of ids) {
+				await this.chatHubAttachmentService.deleteAllBySessionIdInContext(id, ctx);
+			}
+
+			return await this.sessionRepository.deleteManyByIds(userId, ids, ctx);
+		});
+	}
