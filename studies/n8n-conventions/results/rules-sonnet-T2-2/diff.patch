+	/** Token rows (JWT strings) held by the given users for the given clients. */
+	async findByClientsAndUsers(
+		clientIds: string[],
+		userIds: string[],
+	): Promise<Array<{ token: string; clientId: string; userId: string }>> {
+		if (clientIds.length === 0 || userIds.length === 0) return [];
+		return await this.find({
