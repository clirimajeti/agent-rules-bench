 		return await this.existsBy({ token });
 	}
+
+	/** Token strings and their grant keys for the given (client, user) pairs. */
+	async findTokensForGrants(
+		grants: Array<{ clientId: string; userId: string }>,
+	): Promise<Array<{ token: string; clientId: string; userId: string }>> {
+		if (grants.length === 0) return [];
+
+		return await this.find({
+			select: { token: true, clientId: true, userId: true },
+			where: grants,
+		});
+	}
+
+	/** Deletes every access token of a client, for all users. Returns the rows deleted. */
+	async deleteAllForClient(clientId: string): Promise<number> {
+		const result = await this.delete({ clientId });
+		return result.affected ?? 0;
+	}
 }
