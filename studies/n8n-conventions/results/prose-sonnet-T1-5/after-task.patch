+	async getIdsByOwnerLastMessageBefore(userId: string, cutoff: Date, trx?: EntityManager) {
+		const em = trx ?? this.manager;
+		const sessions = await em.find(ChatHubSession, {
+			select: ['id'],
+			where: { ownerId: userId, lastMessageAt: LessThan(cutoff) },
+		});
+		return sessions.map((session) => session.id);
+	}
+
+	/**
+	 * Deletes the sessions of one owner by ID. The database cascades to the messages.
+	 * Returns the number of deleted sessions.
+	 */
+	async deleteManyByOwnerAndIds(userId: string, ids: string[], trx?: EntityManager) {
+		const em = trx ?? this.manager;
+		const chunkSize = 500;
+		let deleted = 0;
+
+		for (let i = 0; i < ids.length; i += chunkSize) {
+			const result = await em.delete(ChatHubSession, {
+				ownerId: userId,
+				id: In(ids.slice(i, i + chunkSize)),
+			});
+			deleted += result.affected ?? 0;
+		}
+
+		return deleted;
+	}
