+	/**
+	 * Counts unexpired access tokens per client and user at `now`. Restricted to
+	 * one user when `userId` is given. Returns no rows for an empty client list.
+	 */
+	async countActiveByGrant(options: {
+		clientIds: string[];
+		userId?: string;
+		now: number;
+	}): Promise<ActiveAccessTokenCount[]> {
+		if (options.clientIds.length === 0) return [];
+
+		const qb = this.createQueryBuilder('token')
+			.select('token.clientId', 'clientId')
+			.addSelect('token.userId', 'userId')
+			.addSelect('COUNT(*)', 'count')
+			.where('token.clientId IN (:...clientIds)', { clientIds: options.clientIds })
+			.andWhere('token.expiresAt > :now', { now: options.now });
+
+		if (options.userId) {
+			qb.andWhere('token.userId = :userId', { userId: options.userId });
+		}
+
+		const rows = await qb
+			.groupBy('token.clientId')
+			.addGroupBy('token.userId')
+			.getRawMany<{ clientId: string; userId: string; count: string | number }>();
+
+		// COUNT comes back as a string on Postgres.
+		return rows.map((row) => ({ ...row, count: Number(row.count) }));
+	}
+
+	/** Deletes every access token issued for a client, across all users. Returns the rows deleted. */
+	async deleteAllForClient(clientId: string): Promise<number> {
+		const result = await this.delete({ clientId });
+		return result.affected ?? 0;
+	}
 }
