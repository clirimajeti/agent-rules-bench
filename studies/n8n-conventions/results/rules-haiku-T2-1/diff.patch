@@ -0,0 +1,30 @@
+import type { MigrationContext, ReversibleMigration } from '../migration-types';
+
+const TABLE_NAME = 'oauth_access_tokens';
+const COLUMN_NAME = 'expiresAt';
+
+/**
+ * Stores when each access token expires, so the admin client list can count the
+ * tokens that are still valid. The expiry is only used for that count. Token
+ * verification still checks the signed `exp` claim.
+ *
+ * Existing rows get 0, which counts them as expired. They are at most one access
+ * token lifetime old, so the count can be low for that long after the upgrade.
+ */
+export class AddExpiresAtToOAuthAccessTokens1795306411000 implements ReversibleMigration {
+	async up({ schemaBuilder: { addColumns, column } }: MigrationContext) {
+		await addColumns(
+			TABLE_NAME,
+			[
+				column(COLUMN_NAME)
+					.bigint.notNull.default(0)
+					.comment('Unix timestamp in milliseconds when the access token expires.'),
+			],
+			{ recreatesOnSqlite: true },
+		);
+	}
+
+	async down({ schemaBuilder: { dropColumns } }: MigrationContext) {
+		await dropColumns(TABLE_NAME, [COLUMN_NAME], { recreatesOnSqlite: true });
+	}
+}
