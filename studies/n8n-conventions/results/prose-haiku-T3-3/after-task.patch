+// Parses a comma-separated list of numeric submission IDs. Rejects the list
+// before any API call if it is empty or contains a non-numeric ID.
+export function parseSubmissionIds(node: INode, value: string): string[] {
+	const ids = split(toString(value), ',')
+		.map((id) => trim(id))
+		.filter((id) => id !== '');
+
+	if (ids.length === 0) {
+		throw new NodeOperationError(node, 'Enter at least one submission ID');
+	}
+
+	const invalidIds = ids.filter((id) => !/^\d+$/.test(id));
+	if (invalidIds.length > 0) {
+		throw new NodeOperationError(
+			node,
+			`Submission IDs must be numbers. Invalid values: ${invalidIds.join(', ')}`,
+		);
+	}
+
+	return ids;
+}
+
 const matchWildcard = (value: string, pattern: string): boolean => {
 	return safeRegex.test(`^${escapeRegExp(pattern).replace('\\*', '.*')}$`, value);
 };
