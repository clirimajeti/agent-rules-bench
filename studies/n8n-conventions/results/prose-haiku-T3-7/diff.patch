 	return split(toString(value), /[\s,]+/);
 }
 
+// Split a comma-separated list of submission IDs. Empty entries are dropped.
+export function parseSubmissionIds(value: string): string[] {
+	return toString(value)
+		.split(',')
+		.map((id) => trim(id))
+		.filter((id) => id !== '');
+}
+
 const matchWildcard = (value: string, pattern: string): boolean => {
 	return safeRegex.test(`^${escapeRegExp(pattern).replace('\\*', '.*')}$`, value);
