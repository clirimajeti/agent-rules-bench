+	async getIdsByUserIdLastMessageBefore(
+		userId: string,
+		cutoff: Date,
+		trx?: EntityManager,
+	): Promise<string[]> {
+		const em = trx ?? this.manager;
+		const sessions = await em.find(ChatHubSession, {
+			where: { ownerId: userId, lastMessageAt: LessThan(cutoff) },
+			select: ['id'],
+		});
+		return sessions.map((session) => session.id);
+	}
+
+	/**
+	 * Deletes the sessions with the given IDs and returns how many were deleted.
+	 * The database cascades the delete to the messages of each session.
+	 */
+	async deleteManyByIds(ids: string[], userId: string, trx?: EntityManager): Promise<number> {
+		if (ids.length === 0) return 0;
+		const em = trx ?? this.manager;
+		const result = await em.delete(ChatHubSession, { id: In(ids), ownerId: userId });
+		return result.affected ?? 0;
+	}
