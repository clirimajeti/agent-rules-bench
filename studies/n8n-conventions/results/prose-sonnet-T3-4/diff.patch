+/**
+ * Parse a comma-separated list of submission IDs.
+ * Throw if the list is empty or if an ID is not a whole number.
+ * Remove duplicate IDs.
+ */
+export function parseSubmissionIds(node: INode, value: unknown): string[] {
+	const ids = toString(value)
+		.split(',')
+		.map((id) => id.trim());
+
+	if (ids.every((id) => id === '')) {
+		throw new NodeOperationError(node, 'The list of submission IDs is empty', {
+			description: 'Enter at least one submission ID. Separate IDs with commas.',
+		});
+	}
+
+	const invalid = ids.filter((id) => !/^\d+$/.test(id));
+	if (invalid.length > 0) {
+		throw new NodeOperationError(
+			node,
+			`Invalid submission ID: "${invalid[0]}". A submission ID must be a number.`,
+			{ description: 'Enter only numbers, separated by commas (e.g. 245128, 245129).' },
+		);
+	}
+
+	return [...new Set(ids)];
+}
+
+const matchWildcard =(value: string, pattern: string): boolean => {
 	return safeRegex.test(`^${escapeRegExp(pattern).replace('\\*', '.*')}$`, value);
 };
 
