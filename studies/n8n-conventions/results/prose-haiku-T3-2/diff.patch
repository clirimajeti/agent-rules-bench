 	return split(toString(value), /[\s,]+/);
 }
 
+// Splits a comma-separated list and drops empty entries. Callers validate the values.
+export function parseCommaSeparatedList(value: string): string[] {
+	return toString(value)
+		.split(',')
+		.map((entry) => trim(entry))
+		.filter((entry) => entry !== '');
+}
+
 const matchWildcard = (value: string, pattern: string): boolean => {
 	return safeRegex.test(`^${escapeRegExp(pattern).replace('\\*', '.*')}$`, value);
 };
