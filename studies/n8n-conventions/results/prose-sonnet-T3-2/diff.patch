+++ b/packages/nodes-base/nodes/KoBoToolbox/GenericFunctions.ts
@@ -105,6 +105,18 @@ export function parseStringList(value: string): string[] {
 	return split(toString(value), /[\s,]+/);
 }
 
+/**
+ * Parse a comma-separated list of submission IDs.
+ * Return `null` if the list is empty or an entry is not a whole number.
+ */
+export function parseSubmissionIds(value: string): string[] | null {
+	const ids = toString(value)
+		.split(',')
+		.map((id) => id.trim());
+	if (ids.some((id) => !/^\d+$/.test(id))) return null;
+	return ids;
+}
+
 const matchWildcard = (value: string, pattern: string): boolean => {
 	return safeRegex.test(`^${escapeRegExp(pattern).replace('\\*', '.*')}$`, value);
 };
