+	/**
+	 * Count the access tokens of each grant that have not expired at `now`.
+	 * Grants without a matching token are omitted from the result.
+	 */
+	async countUnexpiredForGrants(
+		grants: AccessTokenGrantKey[],
+		now: number,
+	): Promise<UnexpiredAccessTokenCount[]> {
+		if (grants.length === 0) return [];
+
+		const params: Record<string, string> = {};
+		const grantFilter = grants
+			.map((grant, i) => {
+				params[`clientId${i}`] = grant.clientId;
+				params[`userId${i}`] = grant.userId;
+				return `(token.clientId = :clientId${i} AND token.userId = :userId${i})`;
+			})
+			.join(' OR ');
+
+		const rows = await this.createQueryBuilder('token')
+			.select('token.clientId', 'clientId')
+			.addSelect('token.userId', 'userId')
+			.addSelect('COUNT(*)', 'count')
+			.where('token.expiresAt > :now', { now })
+			.andWhere(`(${grantFilter})`, params)
+			.groupBy('token.clientId')
+			.addGroupBy('token.userId')
+			.getRawMany<{ clientId: string; userId: string; count: number | string }>();
+
+		// COUNT comes back as a string on Postgres.
+		return rows.map((row) => ({
+			clientId: row.clientId,
+			userId: row.userId,
+			count: Number(row.count),
+		}));
+	}
+
+	/** Delete every access token of a client, across all users. Returns the number removed. */
+	async deleteAllForClient(clientId: string): Promise<number> {
+		const result = await this.delete({ clientId });
+		return result.affected ?? 0;
+	}
 }
