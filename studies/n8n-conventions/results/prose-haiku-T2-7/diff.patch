+import type { MigrationContext, ReversibleMigration } from '../migration-types';
+
+export class AddExpiresAtToOAuthAccessTokens1795305600123 implements ReversibleMigration {
+	async up({ schemaBuilder: { addColumns, column } }: MigrationContext) {
+		// Rows minted before this column existed get 0, so they count as expired.
+		// Verification still relies on the JWT `exp` claim, not on this column.
+		await addColumns(
+			'oauth_access_tokens',
+			[
+				column('expiresAt')
+					.bigint.notNull.default(0)
+					.comment('Unix timestamp in milliseconds when the access token expires'),
+			],
+			{ recreatesOnSqlite: true },
+		);
+	}
+
+	async down({ schemaBuilder: { dropColumns } }: MigrationContext) {
+		await dropColumns('oauth_access_tokens', ['expiresAt'], { recreatesOnSqlite: true });
+	}
+}
