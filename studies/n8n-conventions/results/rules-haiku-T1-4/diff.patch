+	/**
+	 * Deletes the user's conversations whose last message is older than the given number of days.
+	 * Returns the number of deleted conversations.
+	 */
+	async deleteConversationsOlderThan(userId: string, olderThanDays: number): Promise<number> {
+		const cutoff = new Date(Date.now() - olderThanDays * MS_PER_DAY);
+
+		const { sessionIds, attachments } = await this.sessionRepository.runInTransaction(
+			{},
+			async (trx) => {
+				const ids = await this.sessionRepository.getIdsByOwnerLastMessageBefore(
+					userId,
+					cutoff,
+					trx,
+				);
+				if (ids.length === 0) {
+					return { sessionIds: ids, attachments: [] };
+				}
+
+				const files = await this.messageRepository.getAttachmentsBySessionIds(ids, trx);
+				// Messages are removed by the ON DELETE CASCADE foreign key
+				await this.sessionRepository.deleteChatHubSessionsByIds(ids, trx);
+				return { sessionIds: ids, attachments: files };
+			},
+		);
+
+		// Files are removed after commit so a rolled-back transaction keeps its files
+		await this.chatHubAttachmentService.deleteAttachments(attachments);
+
+		return sessionIds.length;
+	}
