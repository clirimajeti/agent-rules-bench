+/**
+ * Resend the invitation to every member whose invitation is still pending.
+ * Return one item per member with the email and whether the resend worked.
+ */
+export async function resendPendingInvites(
+	this: IExecuteFunctions,
+	token: string,
+): Promise<INodeExecutionData[]> {
+	const response = await bitwardenApiRequest.call(this, 'GET', '/public/members', {}, {}, token);
+	const members: Array<{ id: string; email: string; status: number }> = response.data;
+	const pending = members.filter((member) => member.status === MEMBER_STATUS_INVITED);
+
+	if (pending.length === 0) {
+		throw new NodeOperationError(
+			this.getNode(),
+			'The organization has no pending members. No invitations were resent.',
+		);
+	}
+
+	const results: IDataObject[] = [];
+
+	for (const member of pending) {
+		let resent = true;
+
+		try {
+			await bitwardenApiRequest.call(
+				this,
+				'POST',
+				`/public/members/${member.id}/reinvite`,
+				{},
+				{},
+				token,
+			);
+		} catch {
+			resent = false;
+		}
+
+		results.push({ email: member.email, resent });
+	}
+
+	return this.helpers.returnJsonArray(results);
+}
