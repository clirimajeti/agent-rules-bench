+	async getIdsByUserIdLastMessageBefore(userId: string, cutoff: Date, trx?: EntityManager) {
+		const em = trx ?? this.manager;
+		const sessions = await em
+			.createQueryBuilder(ChatHubSession, 'session')
+			.select('session.id', 'id')
+			.where('session.ownerId = :userId', { userId })
+			.andWhere('session.lastMessageAt < :cutoff', { cutoff })
+			.getRawMany<{ id: string }>();
+		return sessions.map((session) => session.id);
+	}
+
+	/**
+	 * Deletes the given sessions of a user that are still older than the cutoff.
+	 * Messages are removed by the cascading foreign key.
+	 * Returns the number of deleted sessions.
+	 */
+	async deleteByIdsLastMessageBefore(
+		ids: string[],
+		userId: string,
+		cutoff: Date,
+		trx?: EntityManager,
+	) {
+		const em = trx ?? this.manager;
+		const chunkSize = 500; // stays below the SQLite parameter limit
+		let deleted = 0;
+		for (let i = 0; i < ids.length; i += chunkSize) {
+			const result = await em
+				.createQueryBuilder()
+				.delete()
+				.from(ChatHubSession)
+				.where('id IN (:...ids)', { ids: ids.slice(i, i + chunkSize) })
+				.andWhere('ownerId = :userId', { userId })
+				.andWhere('lastMessageAt < :cutoff', { cutoff })
+				.execute();
+			deleted += result.affected ?? 0;
+		}
+		return deleted;
+	}
