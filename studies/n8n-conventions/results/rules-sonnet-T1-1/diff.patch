+	/**
+	 * Deletes the user's sessions whose last message is older than the given
+	 * number of days, with their messages and attachments.
+	 * Returns the number of deleted sessions.
+	 */
+	async deleteStaleSessions(userId: string, olderThanDays: number): Promise<number> {
+		const cutoff = new Date(Date.now() - olderThanDays * 24 * 60 * 60 * 1000);
+
+		return await this.sessionRepository.runInTransaction({}, async (trx) => {
+			const sessionIds = await this.sessionRepository.getIdsByUserIdLastMessageBefore(
+				userId,
+				cutoff,
+				trx,
+			);
+			for (const sessionId of sessionIds) {
+				await this.chatHubAttachmentService.deleteAllBySessionId(sessionId, trx);
+			}
+			return await this.sessionRepository.deleteByIdsLastMessageBefore(
+				sessionIds,
+				userId,
+				cutoff,
+				trx,
+			);
+		});
+	}
