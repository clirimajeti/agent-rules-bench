+import type { MigrationContext, ReversibleMigration } from '../migration-types';
+
+/**
+ * Stores when each access token's JWT expires, so the client list can count
+ * the tokens that are still valid without decoding them.
+ */
+export class AddExpiresAtToOAuthAccessTokens1795307568431 implements ReversibleMigration {
+	async up({ escape, runQuery, isPostgres }: MigrationContext) {
+		const tableName = escape.tableName('oauth_access_tokens');
+		const expiresAt = escape.columnName('expiresAt');
+
+		// Rows that exist before this migration get 0, so they count as expired.
+		// Their JWTs still verify until their own `exp`, which only affects the count.
+		await runQuery(`ALTER TABLE ${tableName} ADD COLUMN ${expiresAt} BIGINT NOT NULL DEFAULT 0`);
+
+		if (isPostgres) {
+			await runQuery(
+				`COMMENT ON COLUMN ${tableName}.${expiresAt} IS 'Unix timestamp in milliseconds when the access token expires'`,
+			);
+		}
+	}
+
+	async down({ escape, runQuery }: MigrationContext) {
+		const tableName = escape.tableName('oauth_access_tokens');
+		const expiresAt = escape.columnName('expiresAt');
+
+		await runQuery(`ALTER TABLE ${tableName} DROP COLUMN ${expiresAt}`);
+	}
+}
