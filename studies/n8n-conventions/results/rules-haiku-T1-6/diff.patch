+	/**
+	 * Deletes the user's conversations whose last message is older than `olderThanDays`,
+	 * together with their messages. Returns the number of deleted conversations.
+	 */
+	async deleteConversationsOlderThan(userId: string, olderThanDays: number): Promise<number> {
+		const cutoff = new Date(Date.now() - olderThanDays * MS_PER_DAY);
+
+		return await this.sessionRepository.runInTransaction({}, async (trx) => {
+			const sessionIds = await this.sessionRepository.getIdsOwnedByUserWithLastMessageBefore(
+				userId,
+				cutoff,
+				trx,
+			);
+
+			// Batches keep the number of SQL parameters below the driver limit.
+			for (let i = 0; i < sessionIds.length; i += DELETE_CONVERSATIONS_BATCH_SIZE) {
+				const batch = sessionIds.slice(i, i + DELETE_CONVERSATIONS_BATCH_SIZE);
+				await this.chatHubAttachmentService.deleteAllBySessionIds(batch, trx);
+				await this.messageRepository.deleteChatMessagesBySessionIds(batch, trx);
+				await this.sessionRepository.deleteChatHubSessionsByIds(batch, trx);
+			}
+
+			return sessionIds.length;
+		});
+	}
