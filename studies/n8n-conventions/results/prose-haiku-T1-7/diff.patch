+	/**
+	 * Deletes the user's conversations whose last message is older than the given number of days.
+	 * Returns the number of deleted conversations.
+	 */
+	async deleteConversationsOlderThan(userId: string, days: number): Promise<number> {
+		const before = new Date(Date.now() - days * 24 * 60 * 60 * 1000);
+		const batchSize = 500;
+
+		return await this.sessionRepository.runInTransaction({}, async (trx) => {
+			const sessionIds = await this.sessionRepository.getIdsOfOwnerWithLastMessageBefore(
+				userId,
+				before,
+				trx,
+			);
+
+			let deletedCount = 0;
+			for (let i = 0; i < sessionIds.length; i += batchSize) {
+				const batch = sessionIds.slice(i, i + batchSize);
+				await this.chatHubAttachmentService.deleteAllBySessionIds(batch, trx);
+				deletedCount += await this.sessionRepository.deleteOfOwnerByIds(userId, batch, trx);
+			}
+
+			return deletedCount;
+		});
+	}
