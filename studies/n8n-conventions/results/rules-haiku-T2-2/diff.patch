+import type { MigrationContext, ReversibleMigration } from '../migration-types';
+
+const TABLE_NAME = 'oauth_access_tokens';
+const COLUMN_NAME = 'expiresAt';
+
+/**
+ * Stores the expiry of every access token so the admin list can count the
+ * unexpired ones with one indexed query.
+ *
+ * Existing rows are cleared first: they carry no expiry, so they cannot be
+ * counted. Clients keep their refresh tokens and mint a new access token on
+ * their next refresh, so no grant is lost.
+ *
+ * Reversible on purpose: the column is NOT NULL with no default, so a downgrade
+ * needs it dropped for the older code to insert tokens again. Reversal excludes
+ * restoring deleted rows.
+ */
+export class AddExpiresAtToOAuthAccessTokens1795308623201 implements ReversibleMigration {
+	async up({ schemaBuilder: { addColumns, column }, escape, runQuery }: MigrationContext) {
+		await runQuery(`DELETE FROM ${escape.tableName(TABLE_NAME)}`);
+
+		// No default on purpose: an insert that forgets the expiry must fail instead
+		// of storing a token that never shows as valid.
+		await addColumns(
+			TABLE_NAME,
+			[
+				column(COLUMN_NAME).bigint.notNull.comment(
+					'Unix timestamp in milliseconds; matches the JWT exp claim.',
+				),
+			],
+			{ recreatesOnSqlite: true },
+		);
+	}
+
+	/** Reversal excludes restoring the cleared access tokens. */
+	async down({ schemaBuilder: { dropColumns } }: MigrationContext) {
+		await dropColumns(TABLE_NAME, [COLUMN_NAME], { recreatesOnSqlite: true });
+	}
+}
