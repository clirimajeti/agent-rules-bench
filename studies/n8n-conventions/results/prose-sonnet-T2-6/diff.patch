+	/**
+	 * Count the unexpired access tokens of each given client. A row outlives its
+	 * JWT, and the expiry only lives in the JWT, so read `exp` from the stored
+	 * token. Only this server writes the rows, so the claim is safe to use for
+	 * display. Limit to one user's tokens with `userId`.
+	 */
+	async countValidAccessTokensByClient(
+		clientIds: string[],
+		userId?: string,
+	): Promise<Map<string, number>> {
+		const counts = new Map<string, number>();
+		const nowSeconds = Math.floor(Date.now() / 1000);
+		const rows = await this.accessTokenRepository.findTokensForClients(clientIds, userId);
+		for (const { token, clientId } of rows) {
+			const exp = this.jwtService.decodeUnverified<{ exp?: unknown } | null>(token)?.exp;
+			if (typeof exp === 'number' && exp > nowSeconds) {
+				counts.set(clientId, (counts.get(clientId) ?? 0) + 1);
+			}
+		}
+		return counts;
+	}
