+	async getIdsByUserIdLastMessageBefore(
+		userId: string,
+		cutoff: Date,
+		trx?: EntityManager,
+	): Promise<string[]> {
+		const em = trx ?? this.manager;
+		const sessions = await em
+			.createQueryBuilder(ChatHubSession, 'session')
+			.select('session.id')
+			.where('session.ownerId = :userId', { userId })
+			.andWhere('session.lastMessageAt < :cutoff', { cutoff })
+			.getMany();
+		return sessions.map((session) => session.id);
+	}
+
+	async deleteManyByIds(ids: string[], userId: string, trx?: EntityManager): Promise<number> {
+		if (ids.length === 0) return 0;
+		const em = trx ?? this.manager;
+		const result = await em
+			.createQueryBuilder()
+			.delete()
+			.from(ChatHubSession)
+			.where('id IN (:...ids)', { ids })
+			.andWhere('ownerId = :userId', { userId })
+			.execute();
+		return result.affected ?? 0;
+	}
