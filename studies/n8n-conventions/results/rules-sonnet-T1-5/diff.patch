+	/**
+	 * Deletes the user's sessions whose last message is older than the given number of days.
+	 * The database cascade removes the messages. Returns the number of deleted sessions.
+	 */
+	async deleteStaleSessions(userId: string, olderThanDays: number): Promise<number> {
+		const cutoff = new Date(Date.now() - olderThanDays * 24 * 60 * 60 * 1000);
+
+		const ids = await this.sessionRepository.getIdsByUserIdLastMessageBefore(userId, cutoff);
+		for (const id of ids) {
+			await this.chatHubAttachmentService.deleteAllBySessionId(id);
+		}
+
+		// One DELETE statement is atomic. Attachment files cannot be rolled back anyway.
+		return await this.sessionRepository.deleteManyByIds(ids, userId);
+	}
