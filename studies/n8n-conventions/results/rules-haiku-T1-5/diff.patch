+	/**
+	 * Deletes the user's conversations whose last message is older than the given number of days.
+	 * Returns the number of deleted conversations.
+	 */
+	async deleteConversationsOlderThan(userId: string, olderThanDays: number): Promise<number> {
+		const cutoff = new Date(Date.now() - olderThanDays * MS_PER_DAY);
+
+		return await this.sessionRepository.runInTransaction({}, async (trx) => {
+			const sessionIds = await this.sessionRepository.getIdsByOwnerLastMessageBefore(
+				userId,
+				cutoff,
+				trx,
+			);
+
+			// Batch the IDs to stay below the database bind parameter limit.
+			for (let start = 0; start < sessionIds.length; start += DELETE_BATCH_SIZE) {
+				const batch = sessionIds.slice(start, start + DELETE_BATCH_SIZE);
+				await this.chatHubAttachmentService.deleteAllBySessionIds(batch, trx);
+				await this.messageRepository.deleteBySessionIds(batch, trx);
+				await this.sessionRepository.deleteChatHubSessionsByIds(batch, trx);
+			}
+
+			return sessionIds.length;
+		});
+	}
