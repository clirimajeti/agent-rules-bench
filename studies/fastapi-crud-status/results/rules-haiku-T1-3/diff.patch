+def get_item_stats(
+    *, session: Session, owner_id: uuid.UUID | None = None
+) -> ItemStatsPublic:
+    """Count items and find the newest title; `owner_id=None` covers all items."""
+    base_filter = [] if owner_id is None else [Item.owner_id == owner_id]
+
+    count_statement = select(func.count()).select_from(Item).where(*base_filter)
+    count = session.exec(count_statement).one()
+
+    newest_statement = (
+        select(Item.title)
+        .where(*base_filter)
+        .order_by(col(Item.created_at).desc().nulls_last())
+        .limit(1)
+    )
+    newest_title = session.exec(newest_statement).first()
+
+    return ItemStatsPublic(count=count, newest_title=newest_title)
