+def get_item_stats(
+    *, session: Session, owner_id: uuid.UUID | None = None
+) -> ItemStatsPublic:
+    """
+    Count items and find the newest title.
+
+    Covers all items when owner_id is None, otherwise only that owner's items.
+    """
+    count_statement = select(func.count()).select_from(Item)
+    title_statement = (
+        select(Item.title)
+        .order_by(col(Item.created_at).desc(), col(Item.id).desc())
+        .limit(1)
+    )
+    if owner_id is not None:
+        count_statement = count_statement.where(Item.owner_id == owner_id)
+        title_statement = title_statement.where(Item.owner_id == owner_id)
+    count = session.exec(count_statement).one()
+    newest_title = session.exec(title_statement).first()
+    return ItemStatsPublic(count=count, newest_title=newest_title)
