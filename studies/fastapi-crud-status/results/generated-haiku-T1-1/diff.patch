+def test_read_item_stats_normal_user(
+    client: TestClient, normal_user_token_headers: dict[str, str], db: Session
+) -> None:
+    url = f"{settings.API_V1_STR}/items/stats"
+    before = client.get(url, headers=normal_user_token_headers).json()
+    user = crud.get_user_by_email(session=db, email=settings.EMAIL_TEST_USER)
+    assert user is not None
+    item = crud.create_item(
+        session=db, item_in=ItemCreate(title=random_lower_string()), owner_id=user.id
+    )
+    response = client.get(url, headers=normal_user_token_headers)
+    assert response.status_code == 200
+    content = response.json()
+    assert content["count"] == before["count"] + 1
+    assert content["newest_title"] == item.title
+
+
+def test_read_item_stats_superuser_sees_all_items(
+    client: TestClient, superuser_token_headers: dict[str, str], db: Session
+) -> None:
+    url = f"{settings.API_V1_STR}/items/stats"
+    before = client.get(url, headers=superuser_token_headers).json()
+    item = create_random_item(db)
+    response = client.get(url, headers=superuser_token_headers)
+    assert response.status_code == 200
+    content = response.json()
+    assert content["count"] == before["count"] + 1
+    assert content["newest_title"] == item.title
+
+
+def test_read_item_stats_no_items(client: TestClient, db: Session) -> None:
+    email = random_email()
+    password = random_lower_string()
+    crud.create_user(session=db, user_create=UserCreate(email=email, password=password))
+    headers = user_authentication_headers(
+        client=client, email=email, password=password
+    )
+    # Another user's item must not be counted for this user.
+    create_random_item(db)
+    response = client.get(f"{settings.API_V1_STR}/items/stats", headers=headers)
+    assert response.status_code == 200
+    assert response.json() == {"count": 0, "newest_title": None}
+
