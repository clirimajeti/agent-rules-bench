+def get_item_stats(*, session: Session, owner_id: uuid.UUID | None) -> ItemStats:
+    """Count items and get the newest title, optionally limited to one owner."""
+    count_statement = select(func.count()).select_from(Item)
+    newest_statement = select(Item.title)
+    if owner_id is not None:
+        count_statement = count_statement.where(Item.owner_id == owner_id)
+        newest_statement = newest_statement.where(Item.owner_id == owner_id)
+    newest_statement = newest_statement.order_by(
+        col(Item.created_at).desc(), col(Item.id).desc()
+    ).limit(1)
+
+    count = session.exec(count_statement).one()
+    newest_title = session.exec(newest_statement).first()
+    return ItemStats(count=count, newest_title=newest_title)
