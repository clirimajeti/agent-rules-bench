+def count_items(*, session: Session, owner_id: uuid.UUID | None = None) -> int:
+    """Count all items, or only the items owned by ``owner_id`` when given."""
+    statement = select(func.count()).select_from(Item)
+    if owner_id is not None:
+        statement = statement.where(Item.owner_id == owner_id)
+    return session.exec(statement).one()
+
+
+def get_newest_item_title(
+    *, session: Session, owner_id: uuid.UUID | None = None
+) -> str | None:
+    """Return the title of the newest item, optionally limited to one owner."""
+    statement = select(Item.title)
+    if owner_id is not None:
+        statement = statement.where(Item.owner_id == owner_id)
+    statement = statement.order_by(col(Item.created_at).desc()).limit(1)
+    return session.exec(statement).first()
