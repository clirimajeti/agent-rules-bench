+def count_items(*, session: Session, owner_id: uuid.UUID | None = None) -> int:
+    """Count items of one owner, or all items when `owner_id` is None."""
+    statement = select(func.count()).select_from(Item)
+    if owner_id is not None:
+        statement = statement.where(Item.owner_id == owner_id)
+    return session.exec(statement).one()
+
+
+def get_newest_item(
+    *, session: Session, owner_id: uuid.UUID | None = None
+) -> Item | None:
+    """Return the newest item of one owner, or of all items when `owner_id` is None."""
+    statement = select(Item).order_by(col(Item.created_at).desc(), col(Item.id).desc())
+    if owner_id is not None:
+        statement = statement.where(Item.owner_id == owner_id)
+    return session.exec(statement.limit(1)).first()
