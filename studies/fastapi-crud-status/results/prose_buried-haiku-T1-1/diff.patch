+++ b/backend/tests/crud/test_item.py
@@ -0,0 +1,45 @@
+from sqlmodel import Session
+
+from app import crud
+from app.models import ItemCreate
+from tests.utils.item import create_random_item
+from tests.utils.user import create_random_user
+from tests.utils.utils import random_lower_string
+
+
+def test_count_items_for_owner(db: Session) -> None:
+    user = create_random_user(db)
+    assert user.id is not None
+    assert crud.count_items(session=db, owner_id=user.id) == 0
+    for _ in range(2):
+        crud.create_item(
+            session=db,
+            item_in=ItemCreate(title=random_lower_string()),
+            owner_id=user.id,
+        )
+    assert crud.count_items(session=db, owner_id=user.id) == 2
+
+
+def test_count_items_without_owner_counts_all(db: Session) -> None:
+    before = crud.count_items(session=db)
+    create_random_item(db)
+    assert crud.count_items(session=db) == before + 1
+
+
+def test_get_newest_item_for_owner(db: Session) -> None:
+    user = create_random_user(db)
+    assert user.id is not None
+    assert crud.get_newest_item(session=db, owner_id=user.id) is None
+    crud.create_item(
+        session=db,
+        item_in=ItemCreate(title=random_lower_string()),
+        owner_id=user.id,
+    )
+    newest = crud.create_item(
+        session=db,
+        item_in=ItemCreate(title=random_lower_string()),
+        owner_id=user.id,
+    )
+    found = crud.get_newest_item(session=db, owner_id=user.id)
+    assert found is not None
+    assert found.id == newest.id
