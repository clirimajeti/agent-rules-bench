+# Declared before `/{id}` so that "stats" is not parsed as an item id.
+@router.get("/stats", response_model=ItemStats)
+def read_item_stats(session: SessionDep, current_user: CurrentUser) -> Any:
+    """
+    Count items and get the title of the newest one.
+
+    Covers the current user's items; superusers get the numbers across all items.
+    """
+    owner_id = None if current_user.is_superuser else current_user.id
+    count = crud.count_items(session=session, owner_id=owner_id)
+    newest = crud.get_newest_item(session=session, owner_id=owner_id)
+    return ItemStats(count=count, newest_title=newest.title if newest else None)
+
