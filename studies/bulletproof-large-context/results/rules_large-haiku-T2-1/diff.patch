@@ -0,0 +1,49 @@
+import { useUser } from '@/lib/auth';
+import { User } from '@/types/api';
+
+import {
+  UpdateUserRoleInput,
+  useUpdateUserRole,
+} from '../api/update-user-role';
+
+const ROLE_OPTIONS: UpdateUserRoleInput['role'][] = ['ADMIN', 'USER'];
+
+type UpdateUserRoleProps = {
+  user: User;
+};
+
+export const UpdateUserRole = ({ user }: UpdateUserRoleProps) => {
+  const currentUser = useUser();
+  const updateUserRoleMutation = useUpdateUserRole();
+
+  // Admins do not change their own role from the list, mirroring DeleteUser.
+  if (currentUser.data?.id === user.id) return <span>{user.role}</span>;
+
+  // While a change is in flight, show the requested role; otherwise show the server role.
+  const displayedRole = updateUserRoleMutation.isPending
+    ? updateUserRoleMutation.variables.data.role
+    : user.role;
+
+  return (
+    <select
+      aria-label={`Role of ${user.firstName} ${user.lastName}`}
+      className="block rounded-md border-gray-600 py-1 pl-2 pr-8 text-sm focus:border-blue-500 focus:outline-none focus:ring-blue-500"
+      value={displayedRole}
+      disabled={updateUserRoleMutation.isPending}
+      onChange={(event) => {
+        updateUserRoleMutation.mutate({
+          userId: user.id,
+          data: {
+            role: event.target.value as UpdateUserRoleInput['role'],
+          },
+        });
+      }}
+    >
+      {ROLE_OPTIONS.map((role) => (
+        <option key={role} value={role}>
+          {role}
+        </option>
+      ))}
+    </select>
+  );
+};
