@@ -0,0 +1,80 @@
+import { Pen } from 'lucide-react';
+
+import { Button } from '@/components/ui/button';
+import { Form, FormDrawer, Textarea } from '@/components/ui/form';
+import { useUser } from '@/lib/auth';
+import { Authorization, POLICIES } from '@/lib/authorization';
+import { Comment, User } from '@/types/api';
+
+import {
+  updateCommentInputSchema,
+  useUpdateComment,
+} from '../api/update-comment';
+
+type UpdateCommentProps = {
+  discussionId: string;
+  comment: Comment;
+};
+
+export const UpdateComment = ({
+  discussionId,
+  comment,
+}: UpdateCommentProps) => {
+  const user = useUser();
+  const updateCommentMutation = useUpdateComment({ discussionId });
+
+  return (
+    <Authorization
+      policyCheck={POLICIES['comment:update'](user.data as User, comment)}
+    >
+      <FormDrawer
+        isDone={updateCommentMutation.isSuccess}
+        triggerButton={
+          <Button
+            size="sm"
+            variant="outline"
+            icon={<Pen className="size-4" />}
+          >
+            Edit
+          </Button>
+        }
+        title="Edit Comment"
+        submitButton={
+          <Button
+            isLoading={updateCommentMutation.isPending}
+            form="update-comment"
+            type="submit"
+            size="sm"
+            disabled={updateCommentMutation.isPending}
+          >
+            Save
+          </Button>
+        }
+      >
+        <Form
+          id="update-comment"
+          onSubmit={(values) => {
+            updateCommentMutation.mutate({
+              data: values,
+              commentId: comment.id,
+            });
+          }}
+          schema={updateCommentInputSchema}
+          options={{
+            defaultValues: {
+              body: comment.body,
+            },
+          }}
+        >
+          {({ register, formState }) => (
+            <Textarea
+              label="Body"
+              error={formState.errors['body']}
+              registration={register('body')}
+            />
+          )}
+        </Form>
+      </FormDrawer>
+    </Authorization>
+  );
+};
