+++ b/apps/react-vite/src/features/users/components/update-user-role.tsx
@@ -0,0 +1,40 @@
+import { useUser } from '@/lib/auth';
+import { User } from '@/types/api';
+
+import { useUpdateUserRole } from '../api/update-user-role';
+
+const roleOptions: User['role'][] = ['ADMIN', 'USER'];
+
+type UpdateUserRoleProps = {
+  id: string;
+  role: User['role'];
+};
+
+export const UpdateUserRole = ({ id, role }: UpdateUserRoleProps) => {
+  const user = useUser();
+  const updateUserRoleMutation = useUpdateUserRole();
+
+  const isCurrentUser = user.data?.id === id;
+
+  return (
+    <select
+      aria-label="Role"
+      className="block w-full rounded-md border-gray-600 py-1 pl-2 pr-8 text-sm focus:border-blue-500 focus:outline-none focus:ring-blue-500 disabled:opacity-50"
+      value={role}
+      disabled={isCurrentUser || updateUserRoleMutation.isPending}
+      title={isCurrentUser ? 'You cannot change your own role' : undefined}
+      onChange={(event) =>
+        updateUserRoleMutation.mutate({
+          userId: id,
+          role: event.target.value as User['role'],
+        })
+      }
+    >
+      {roleOptions.map((option) => (
+        <option key={option} value={option}>
+          {option}
+        </option>
+      ))}
+    </select>
+  );
+};
