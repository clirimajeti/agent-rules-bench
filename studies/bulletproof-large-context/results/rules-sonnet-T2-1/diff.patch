@@ -0,0 +1,41 @@
+import { useUser } from '@/lib/auth';
+import { User } from '@/types/api';
+
+import {
+  updateUserRoleInputSchema,
+  useUpdateUserRole,
+} from '../api/update-user-role';
+
+type UpdateUserRoleProps = {
+  id: string;
+  role: User['role'];
+};
+
+const roles: User['role'][] = ['ADMIN', 'USER'];
+
+export const UpdateUserRole = ({ id, role }: UpdateUserRoleProps) => {
+  const user = useUser();
+  const updateUserRoleMutation = useUpdateUserRole();
+
+  return (
+    <select
+      aria-label="Role"
+      className="block w-full rounded-md border-gray-300 py-1 pl-2 pr-8 text-sm focus:border-blue-500 focus:outline-none focus:ring-blue-500 disabled:opacity-50"
+      value={role}
+      disabled={updateUserRoleMutation.isPending || user.data?.id === id}
+      onChange={(e) => {
+        const parsed = updateUserRoleInputSchema.safeParse({
+          role: e.target.value,
+        });
+        if (!parsed.success) return;
+        updateUserRoleMutation.mutate({ userId: id, data: parsed.data });
+      }}
+    >
+      {roles.map((r) => (
+        <option key={r} value={r}>
+          {r}
+        </option>
+      ))}
+    </select>
+  );
+};
