@@ -0,0 +1,37 @@
+import { useUser } from '@/lib/auth';
+import { ROLES } from '@/lib/authorization';
+import { User } from '@/types/api';
+
+import { useUpdateUserRole } from '../api/update-user-role';
+
+type UpdateUserRoleProps = {
+  id: string;
+  role: User['role'];
+};
+
+export const UpdateUserRole = ({ id, role }: UpdateUserRoleProps) => {
+  const user = useUser();
+  const updateUserRoleMutation = useUpdateUserRole();
+
+  return (
+    <select
+      aria-label="User role"
+      className="block w-full rounded-md border-gray-600 py-1 pl-2 pr-8 text-sm focus:border-blue-500 focus:outline-none focus:ring-blue-500"
+      value={role}
+      // admins cannot change their own role, to avoid locking themselves out
+      disabled={user.data?.id === id || updateUserRoleMutation.isPending}
+      onChange={(event) =>
+        updateUserRoleMutation.mutate({
+          userId: id,
+          data: { role: event.target.value as User['role'] },
+        })
+      }
+    >
+      {Object.values(ROLES).map((value) => (
+        <option key={value} value={value}>
+          {value}
+        </option>
+      ))}
+    </select>
+  );
+};
