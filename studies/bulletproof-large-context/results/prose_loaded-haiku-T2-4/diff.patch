+import { ChangeEvent } from 'react';
+
+import { useUser } from '@/lib/auth';
+import { User } from '@/types/api';
+import { cn } from '@/utils/cn';
+
+import {
+  UpdateUserRoleInput,
+  useUpdateUserRole,
+  userRoles,
+} from '../api/update-user-role';
+
+type UpdateUserRoleProps = {
+  id: string;
+  role: User['role'];
+};
+
+export const UpdateUserRole = ({ id, role }: UpdateUserRoleProps) => {
+  const user = useUser();
+  const updateUserRoleMutation = useUpdateUserRole();
+
+  const isOwnAccount = user.data?.id === id;
+  const isPending = updateUserRoleMutation.isPending;
+  // While the request is in flight, show the requested role instead of the stale one.
+  const displayedRole =
+    isPending && updateUserRoleMutation.variables
+      ? updateUserRoleMutation.variables.data.role
+      : role;
+
+  const handleChange = (event: ChangeEvent<HTMLSelectElement>) => {
+    const nextRole = userRoles.find((value) => value === event.target.value);
+    if (!nextRole) return;
+
+    const data: UpdateUserRoleInput = { role: nextRole };
+    updateUserRoleMutation.mutate({ userId: id, data });
+  };
+
+  return (
+    <select
+      aria-label="User role"
+      className={cn(
+        'block rounded-md border-gray-600 py-1 pl-2 pr-8 text-sm focus:border-blue-500 focus:outline-none focus:ring-blue-500',
+        isPending && 'opacity-60',
+      )}
+      disabled={isOwnAccount || isPending}
+      value={displayedRole}
+      onChange={handleChange}
+    >
+      {userRoles.map((value) => (
+        <option key={value} value={value}>
+          {value}
+        </option>
+      ))}
+    </select>
+  );
+};
