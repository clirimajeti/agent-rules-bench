@@ -0,0 +1,41 @@
+import { Select } from '@/components/ui/form';
+import { useUser } from '@/lib/auth';
+import { User } from '@/types/api';
+
+import { useUpdateUserRole } from '../api/update-user-role';
+
+type UpdateUserRoleProps = {
+  id: string;
+  role: User['role'];
+};
+
+export const UpdateUserRole = ({ id, role }: UpdateUserRoleProps) => {
+  const user = useUser();
+  const updateUserRoleMutation = useUpdateUserRole();
+
+  // Admins cannot change their own role, so they cannot lock themselves out.
+  if (user.data?.id === id) return <span>{role}</span>;
+
+  return (
+    <Select
+      key={role}
+      defaultValue={role}
+      disabled={updateUserRoleMutation.isPending}
+      options={[
+        { label: 'ADMIN', value: 'ADMIN' },
+        { label: 'USER', value: 'USER' },
+      ]}
+      registration={{
+        name: `role-${id}`,
+        onChange: async (event) => {
+          const nextRole = event.target.value as User['role'];
+          if (nextRole === role) return;
+          updateUserRoleMutation.mutate({
+            userId: id,
+            data: { role: nextRole },
+          });
+        },
+      }}
+    />
+  );
+};
