+import { ROLES } from '@/lib/authorization';
+import { User } from '@/types/api';
+
+import { useUpdateUserRole } from '../api/update-user-role';
+
+type UpdateUserRoleProps = {
+  userId: string;
+  role: User['role'];
+};
+
+export const UpdateUserRole = ({ userId, role }: UpdateUserRoleProps) => {
+  const updateUserRoleMutation = useUpdateUserRole();
+
+  return (
+    <select
+      aria-label="Role"
+      className="block rounded-md border-gray-300 py-1 pl-3 pr-8 text-sm focus:border-blue-500 focus:outline-none focus:ring-blue-500"
+      value={role}
+      disabled={updateUserRoleMutation.isPending}
+      onChange={(e) =>
+        updateUserRoleMutation.mutate({
+          userId,
+          data: { role: e.target.value as User['role'] },
+        })
+      }
+    >
+      {Object.values(ROLES).map((value) => (
+        <option key={value} value={value}>
+          {value}
+        </option>
+      ))}
+    </select>
+  );
+};
