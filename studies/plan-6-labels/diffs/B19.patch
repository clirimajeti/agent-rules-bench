diff --git a/apps/react-vite/src/features/users/components/users-toolbar.tsx b/apps/react-vite/src/features/users/components/users-toolbar.tsx
new file mode 100644
index 0000000..0268658
--- /dev/null
+++ b/apps/react-vite/src/features/users/components/users-toolbar.tsx
@@ -0,0 +1,87 @@
+import { Download, Search, X } from 'lucide-react';
+import * as React from 'react';
+
+import { Button } from '@/components/ui/button';
+import {
+  DropdownMenu,
+  DropdownMenuContent,
+  DropdownMenuItem,
+  DropdownMenuTrigger,
+} from '@/components/ui/dropdown/dropdown';
+import { Input } from '@/components/ui/form/input';
+
+import { ROLES } from '@/lib/authorization';
+
+type UsersToolbarProps = {
+  roleFilter: (typeof ROLES)[keyof typeof ROLES] | null;
+  onRoleFilterChange: (role: (typeof ROLES)[keyof typeof ROLES] | null) => void;
+  searchQuery: string;
+  onSearchChange: (query: string) => void;
+  onExportClick: () => void;
+};
+
+export const UsersToolbar = ({
+  roleFilter,
+  onRoleFilterChange,
+  searchQuery,
+  onSearchChange,
+  onExportClick,
+}: UsersToolbarProps) => {
+  const handleClearSearch = () => onSearchChange('');
+
+  return (
+    <div className="mb-4 flex items-center gap-3">
+      <div className="relative flex-1">
+        <Search className="absolute left-3 top-1/2 size-4 -translate-y-1/2 text-gray-400" />
+        <Input
+          type="text"
+          placeholder="Search by name or email..."
+          value={searchQuery}
+          onChange={(e) => onSearchChange(e.target.value)}
+          className="pl-9 pr-9"
+          registration={{}}
+        />
+        {searchQuery && (
+          <Button
+            variant="ghost"
+            size="icon"
+            className="absolute right-1 top-1/2 size-6 -translate-y-1/2 text-gray-400 hover:text-gray-600"
+            onClick={handleClearSearch}
+          >
+            <X className="size-3" />
+          </Button>
+        )}
+      </div>
+
+      <DropdownMenu>
+        <DropdownMenuTrigger asChild>
+          <Button variant="outline" className="shrink-0">
+            {roleFilter ? (
+              <>
+                Role: {roleFilter}
+              </>
+            ) : (
+              'All Roles'
+            )}
+          </Button>
+        </DropdownMenuTrigger>
+        <DropdownMenuContent align="end">
+          <DropdownMenuItem onClick={() => onRoleFilterChange(null)}>
+            All Roles
+          </DropdownMenuItem>
+          <DropdownMenuItem onClick={() => onRoleFilterChange(ROLES.ADMIN)}>
+            Admin
+          </DropdownMenuItem>
+          <DropdownMenuItem onClick={() => onRoleFilterChange(ROLES.USER)}>
+            User
+          </DropdownMenuItem>
+        </DropdownMenuContent>
+      </DropdownMenu>
+
+      <Button variant="outline" onClick={onExportClick}>
+        <Download className="mr-2 size-4" />
+        Export CSV
+      </Button>
+    </div>
+  );
+};
