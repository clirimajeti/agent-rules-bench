+/** What authorizing a rotation needs: the owning organization and the access the key already carries. */
+export const getApiKeyRotationScope = async (
+  apiKeyId: string
+): Promise<{ organizationId: string; organizationAccess: TOrganizationAccess } | null> => {
+  validateInputs([apiKeyId, ZId]);
+
+  try {
+    return await prisma.apiKey.findUnique({
+      where: { id: apiKeyId },
+      select: { organizationId: true, organizationAccess: true },
+    });
+  } catch (error) {
+    if (error instanceof Prisma.PrismaClientKnownRequestError) {
