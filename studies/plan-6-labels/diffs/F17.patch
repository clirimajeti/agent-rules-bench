@@ -0,0 +1,13 @@
+import { parseV3ApiError } from "@/modules/api/lib/v3-client";
+
+/** Rotate an API key. Throws a parsed `V3ApiError` on a non-2xx response. */
+export async function rotateApiKey(params: { apiKeyId: string }): Promise<{ id: string; actualKey: string }> {
+  const response = await fetch(`/api/v3/api-keys/${params.apiKeyId}/rotate`, {
+    method: "POST",
+    cache: "no-store",
+  });
+  if (!response.ok) {
+    throw await parseV3ApiError(response);
+  }
+  return ((await response.json()) as { data: { id: string; actualKey: string } }).data;
+}
