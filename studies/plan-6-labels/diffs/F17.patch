+/**
+ * POST /api/v3/api-keys/{apiKeyId}/rotate — replace a key's secret.
+ *
+ * The key keeps its id, label and access; only the secret changes, and the old one stops working at once.
+ * The new plaintext key is in this response and nowhere else. Session-only.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { rotateV3ApiKey } from "../../lib/operations";
+import { ZV3ApiKeyIdParams } from "../../lib/schemas";
+
+export const POST = withV3ApiWrapper({
+  auth: "session",
+  action: "updated",
+  targetType: "apiKey",
+  schemas: { params: ZV3ApiKeyIdParams },
+  handler: async ({ authentication, parsedInput, auditLog, requestId, instance }) =>
+    rotateV3ApiKey({
+      authentication,
+      apiKeyId: parsedInput.params.apiKeyId,
+      auditLog,
+      requestId,
+      instance,
+    }),
+});
diff --git a/apps/web/app/api/v3/api-keys/lib/operations.ts b/apps/web/app/api/v3/api-keys/lib/operations.ts
new file mode 100644
index 000000000..d836ff640
--- /dev/null
+++ b/apps/web/app/api/v3/api-keys/lib/operations.ts
@@ -0,0 +1,73 @@
+import "server-only";
+import { getV3AuthorizationActor } from "@/app/api/v3/lib/auth";
+import { problemForbidden, problemUnauthorized, successResponse } from "@/app/api/v3/lib/response";
+import type { TV3AuditLog, TV3Authentication } from "@/app/api/v3/lib/types";
+import { can } from "@/lib/authorization";
+import { capturePostHogEvent } from "@/lib/posthog";
+import {
+  getApiKeyRotationScope,
+  rotateApiKey,
+} from "@/modules/organization/settings/api-keys/lib/api-key";
+import { canGrantOrganizationWriteAccess } from "@/modules/organization/settings/api-keys/lib/organization-access";
+
+type TBaseParams = {
+  authentication: TV3Authentication;
+  requestId: string;
+  instance?: string;
+};
+
+/**
+ * Rotating a key hands out a working secret for it, so it is authorized like the other key mutations
+ * (`apiKey.manage`), resolved from the key itself rather than from anything the caller supplies. An
+ * unknown key answers 403, not 404, so key ids cannot be probed for existence.
+ *
+ * Session-only: a key must not be able to mint a replacement for itself or for another key.
+ *
+ * A key that carries organization write access is only rotated by someone who could grant that access
+ * today (ENG-3075). Otherwise a role below the user-management floor could read the secret of a key that
+ * manages users.
+ */
+export async function rotateV3ApiKey(
+  params: TBaseParams & { apiKeyId: string; auditLog?: TV3AuditLog }
+): Promise<Response> {
+  const { authentication, apiKeyId, auditLog, requestId, instance } = params;
+
+  const actor = getV3AuthorizationActor(authentication);
+  if (actor?.type !== "user") {
+    return problemUnauthorized(requestId, "Session required", instance);
+  }
+
+  const scope = await getApiKeyRotationScope(apiKeyId);
+  if (!scope) {
+    return problemForbidden(requestId, "You are not authorized to access this resource", instance);
+  }
+
+  const allowed = await can(actor, "apiKey.manage", { type: "apiKey", id: apiKeyId });
+  if (!allowed) {
+    return problemForbidden(requestId, "You are not authorized to access this resource", instance);
+  }
+
+  if (
+    scope.organizationAccess?.accessControl?.write === true &&
+    !(await canGrantOrganizationWriteAccess(actor.id, scope.organizationId))
+  ) {
+    return problemForbidden(requestId, "User management is not allowed for your role", instance);
+  }
+
+  if (auditLog) {
+    auditLog.organizationId = scope.organizationId;
+    auditLog.targetId = apiKeyId;
+  }
+
+  const rotated = await rotateApiKey(apiKeyId);
+
+  capturePostHogEvent(
+    actor.id,
+    "api_key_rotated",
+    { api_key_id: apiKeyId },
+    { organizationId: scope.organizationId }
+  );
+
+  // The audit entry records that a rotation happened, never the secret or its hashes.
+  return successResponse({ id: rotated.id, actualKey: rotated.actualKey }, { requestId });
+}
