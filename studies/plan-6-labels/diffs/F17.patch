@@ -0,0 +1,59 @@
+post:
+  operationId: rotateApiKeyV3
+  # Session-only by design, so an API-key caller reading the published reference would only ever get a
+  # 401. Kept out of the generated docs pages, like the tag operations; the operation stays in the bundle.
+  x-excluded: true
+  summary: Rotate an API key
+  description: |
+    Replaces the secret of an organization API key. The key keeps its id, label, organization access and
+    workspace permissions. The previous secret stops working immediately, and the key's last-used time is
+    cleared. Requires permission to manage the key; a key with organization write access can only be
+    rotated by a role that may grant that access.
+
+    The new key is returned once, in `actualKey`. It is not stored in plain text and cannot be read again.
+
+    An unknown `apiKeyId` answers `403`, not `404`, so key ids cannot be probed for existence.
+  tags:
+    - V3 API Keys
+  parameters:
+    - in: path
+      name: apiKeyId
+      required: true
+      schema:
+        type: string
+        format: cuid2
+  responses:
+    "200":
+      description: API key rotated successfully
+      content:
+        application/json:
+          schema:
+            type: object
+            required:
+              - data
