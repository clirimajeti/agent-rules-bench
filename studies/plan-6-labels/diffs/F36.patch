index 000000000..65b9bb964
--- /dev/null
+++ b/apps/web/app/(app)/workspaces/[workspaceId]/settings/account/profile/components/DownloadMyData.tsx
@@ -0,0 +1,57 @@
+"use client";
+
+import { QueryClient, QueryClientProvider, useMutation } from "@tanstack/react-query";
+import { useState } from "react";
+import toast from "react-hot-toast";
+import { useTranslation } from "react-i18next";
+import { getV3ApiErrorMessage, parseV3ApiError } from "@/modules/api/lib/v3-client";
+import { Button } from "@/modules/ui/components/button";
+
+const DATA_EXPORT_URL = "/api/v3/user/data-export";
+const FALLBACK_FILENAME = "formbricks-my-data.json";
+
+async function downloadMyData(): Promise<void> {
+  const response = await fetch(DATA_EXPORT_URL, { cache: "no-store" });
+  if (!response.ok) {
+    throw await parseV3ApiError(response);
+  }
+
+  const blob = await response.blob();
+  const url = URL.createObjectURL(blob);
+  const link = document.createElement("a");
+  link.href = url;
+  link.download = FALLBACK_FILENAME;
+  document.body.appendChild(link);
+  link.click();
+  link.remove();
+  URL.revokeObjectURL(url);
+}
+
+const DownloadMyDataButton = () => {
+  const { t } = useTranslation();
+  const mutation = useMutation({
+    mutationFn: downloadMyData,
+    onError: (error) =>
+      toast.error(getV3ApiErrorMessage(error, t("common.something_went_wrong_please_try_again"))),
+  });
+
+  return (
+    <Button
+      type="button"
+      variant="secondary"
+      loading={mutation.isPending}
+      onClick={() => mutation.mutate()}>
+      {t("workspace.settings.profile.download_my_data")}
+    </Button>
+  );
+};
+
+export const DownloadMyData = () => {
+  const [queryClient] = useState(() => new QueryClient());
+
+  return (
+    <QueryClientProvider client={queryClient}>
+      <DownloadMyDataButton />
+    </QueryClientProvider>
+  );
+};
diff --git a/apps/web/app/api/v3/user/data-export/lib/operations.ts b/apps/web/app/api/v3/user/data-export/lib/operations.ts
new file mode 100644
index 000000000..37b905a43
--- /dev/null
+++ b/apps/web/app/api/v3/user/data-export/lib/operations.ts
@@ -0,0 +1,63 @@
+import "server-only";
+import { prisma } from "@formbricks/database";
+import { getV3SessionUserId } from "@/app/api/v3/lib/auth";
+import { problemInternalError, problemUnauthorized } from "@/app/api/v3/lib/response";
+import type { TV3Authentication } from "@/app/api/v3/lib/types";
+
+export const DATA_EXPORT_FILENAME = "formbricks-my-data.json";
+
+type TExportParams = {
+  authentication: TV3Authentication;
+  requestId: string;
+  instance?: string;
+};
+
+/**
+ * The signed-in user's own profile data as a JSON attachment. The user id always comes from the
+ * session, never from the request, so a caller can only ever export their own data.
+ */
+export async function exportV3UserData({ authentication, requestId, instance }: TExportParams) {
+  const userId = getV3SessionUserId(authentication);
+  if (!userId) {
+    return problemUnauthorized(requestId, "Session required", instance);
+  }
+
+  // One query: the memberships of a single user are bounded by the organizations they belong to.
+  const user = await prisma.user.findUnique({
+    where: { id: userId },
+    select: {
+      name: true,
+      email: true,
+      locale: true,
+      notificationSettings: true,
+      memberships: {
+        select: { role: true, organization: { select: { name: true } } },
+      },
+    },
+  });
+
+  if (!user) {
+    return problemInternalError(requestId, "Unable to export data", instance);
+  }
+
+  const body = {
+    name: user.name,
+    email: user.email,
+    locale: user.locale,
+    notificationSettings: user.notificationSettings,
+    organizationMemberships: user.memberships.map((membership) => ({
+      organizationName: membership.organization.name,
+      role: membership.role,
+    })),
+  };
+
+  return new Response(JSON.stringify(body, null, 2), {
+    status: 200,
+    headers: {
+      "Content-Type": "application/json",
+      "Content-Disposition": `attachment; filename="${DATA_EXPORT_FILENAME}"`,
+      "Cache-Control": "no-store",
+      "X-Request-Id": requestId,
+    },
+  });
+}
diff --git a/apps/web/app/api/v3/user/data-export/route.ts b/apps/web/app/api/v3/user/data-export/route.ts
new file mode 100644
index 000000000..f1f3257fa
--- /dev/null
+++ b/apps/web/app/api/v3/user/data-export/route.ts
@@ -0,0 +1,14 @@
+/**
+ * GET /api/v3/user/data-export — download the signed-in user's own data as a JSON file.
+ *
+ * Session-only, deliberately: the export is about the caller's own account, so an API key has no
+ * business here.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { exportV3UserData } from "./lib/operations";
+
+export const GET = withV3ApiWrapper({
+  auth: "session",
+  handler: async ({ authentication, requestId, instance }) =>
+    exportV3UserData({ authentication, requestId, instance }),
+});
