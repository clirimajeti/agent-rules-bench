+
+export const UsersFilters = ({
+  search,
+  onSearchChange,
+  onExport,
+  canExport,
+}: UsersFiltersProps) => {
+  return (
+    <div className="mb-4 flex flex-col gap-4 sm:flex-row sm:items-end">
+      <div className="flex-1">
+        <Input
+          label="Search"
