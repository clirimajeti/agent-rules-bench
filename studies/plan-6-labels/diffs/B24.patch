diff --git a/apps/react-vite/src/features/users/utils/export-users-csv.ts b/apps/react-vite/src/features/users/utils/export-users-csv.ts
new file mode 100644
index 0000000..c4624c5
--- /dev/null
+++ b/apps/react-vite/src/features/users/utils/export-users-csv.ts
@@ -0,0 +1,46 @@
+import { User } from '@/types/api';
+import { formatDate } from '@/utils/format';
+
+const CSV_HEADERS = ['Name', 'Email', 'Role', 'Joined'];
+
+// Cells starting with these characters can be interpreted as formulas by
+// spreadsheet apps. Prefixing them with a single quote neutralises them.
+const FORMULA_PREFIXES = ['=', '+', '-', '@', '\t', '\r'];
+
+const escapeCsvValue = (value: string) => {
+  const neutralised = FORMULA_PREFIXES.some((prefix) => value.startsWith(prefix))
+    ? `'${value}`
+    : value;
+
+  return `"${neutralised.replace(/"/g, '""')}"`;
+};
+
+export const buildUsersCsv = (users: User[]) => {
+  const rows = users.map((user) => [
+    `${user.firstName} ${user.lastName}`.trim(),
+    user.email,
+    user.role,
+    formatDate(user.createdAt),
+  ]);
+
+  return [CSV_HEADERS, ...rows]
+    .map((row) => row.map(escapeCsvValue).join(','))
+    .join('\r\n');
+};
+
+export const downloadUsersCsv = (users: User[]) => {
+  // The UTF-8 byte order mark lets spreadsheet apps detect the encoding.
+  const content = `﻿${buildUsersCsv(users)}`;
+  const blob = new Blob([content], { type: 'text/csv;charset=utf-8' });
+  const url = URL.createObjectURL(blob);
+  const fileName = `users-${new Date().toISOString().slice(0, 10)}.csv`;
+
+  const link = document.createElement('a');
+  link.href = url;
+  link.download = fileName;
+  document.body.appendChild(link);
+  link.click();
+  link.remove();
+
+  setTimeout(() => URL.revokeObjectURL(url), 0);
+};
diff --git a/apps/react-vite/src/features/users/utils/filter-users.ts b/apps/react-vite/src/features/users/utils/filter-users.ts
new file mode 100644
index 0000000..17a79ce
--- /dev/null
+++ b/apps/react-vite/src/features/users/utils/filter-users.ts
@@ -0,0 +1,20 @@
+import { User } from '@/types/api';
+
+export type UserFilters = {
+  search: string;
+};
+
+export const filterUsers = (users: User[], { search }: UserFilters) => {
+  const query = search.trim().toLowerCase();
+
+  if (!query) {
+    return users;
+  }
+
+  return users.filter((user) => {
+    const fullName = `${user.firstName} ${user.lastName}`.toLowerCase();
+    const email = user.email.toLowerCase();
+
+    return fullName.includes(query) || email.includes(query);
+  });
+};
