+/**
+ * Deletes every tag in the workspace that no response carries. The scope is the `workspaceId` the caller
+ * was authorized against, so no tag from another workspace can match. Deleting a tag is authorized as
+ * `readWrite`, the same level the single-tag delete requires.
+ */
+export async function deleteUnusedV3Tags(
+  params: TBaseParams & { workspaceId: string; auditLog?: TV3AuditLog }
+): Promise<Response> {
+  const { workspaceId, auditLog, requestId, instance, authentication } = params;
+
+  const access = await requireV3WorkspaceAccess(authentication, workspaceId, "readWrite", requestId, instance);
+  if (access instanceof Response) return access;
+
+  if (auditLog) {
+    auditLog.organizationId = access.organizationId;
+    auditLog.targetId = workspaceId;
+  }
+
+  const result = await deleteUnusedTags(workspaceId);
+  if (!result.ok) {
+    return problemInternalError(requestId, "Unable to delete unused tags", instance);
+  }
+
+  if (auditLog) auditLog.oldObject = { workspaceId, deleted: result.data };
+
+  return successResponse({ deleted: result.data }, { requestId });
+}
