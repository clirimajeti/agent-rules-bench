index 0000000..9fd704f
--- /dev/null
+++ b/apps/react-vite/src/features/users/utils/export-users-csv.ts
@@ -0,0 +1,42 @@
+import { User } from '@/types/api';
+import { formatDate } from '@/utils/format';
+
+const CSV_HEADERS = ['Name', 'Email', 'Role', 'Joined'];
+
+// Spreadsheet apps may evaluate cells starting with these characters as formulas.
+const FORMULA_PREFIX = /^[=+\-@\t\r]/;
+
+const escapeCell = (value: string) => {
+  const safeValue = FORMULA_PREFIX.test(value) ? `'${value}` : value;
+  return `"${safeValue.replace(/"/g, '""')}"`;
+};
+
+export const buildUsersCsv = (users: User[]) => {
+  const rows = users.map((user) => [
+    `${user.firstName} ${user.lastName}`,
+    user.email,
+    user.role,
+    formatDate(user.createdAt),
+  ]);
+
+  return [CSV_HEADERS, ...rows]
+    .map((row) => row.map(escapeCell).join(','))
+    .join('\r\n');
+};
+
+export const downloadUsersCsv = (users: User[]) => {
+  // The BOM makes spreadsheet apps detect UTF-8 so non-ASCII names display correctly.
+  const blob = new Blob(['﻿', buildUsersCsv(users)], {
+    type: 'text/csv;charset=utf-8',
+  });
+  const url = URL.createObjectURL(blob);
+
+  const link = document.createElement('a');
+  link.href = url;
+  link.download = `users-${new Date().toISOString().slice(0, 10)}.csv`;
+  document.body.appendChild(link);
+  link.click();
+  link.remove();
+
+  setTimeout(() => URL.revokeObjectURL(url), 0);
+};
diff --git a/apps/react-vite/src/features/users/utils/filter-users.ts b/apps/react-vite/src/features/users/utils/filter-users.ts
new file mode 100644
index 0000000..d512873
--- /dev/null
+++ b/apps/react-vite/src/features/users/utils/filter-users.ts
@@ -0,0 +1,29 @@
+import { User } from '@/types/api';
+
+export type RoleFilter = User['role'] | 'ALL';
+
+export type UsersFilter = {
+  search: string;
+  role: RoleFilter;
+};
+
+const getFullName = (user: User) => `${user.firstName} ${user.lastName}`;
+
+export const filterUsers = (users: User[], { search, role }: UsersFilter) => {
+  const term = search.trim().toLowerCase();
+
+  return users.filter((user) => {
+    if (role !== 'ALL' && user.role !== role) {
+      return false;
+    }
+
+    if (!term) {
+      return true;
+    }
+
+    return (
+      getFullName(user).toLowerCase().includes(term) ||
+      user.email.toLowerCase().includes(term)
+    );
+  });
+};
