+"use client";
+
+import { useTranslation } from "react-i18next";
+
+interface AccountActivityProps {
+  createdAt: Date;
+  lastLoginAt: Date | null;
+}
+
+export const AccountActivity = ({ createdAt, lastLoginAt }: Readonly<AccountActivityProps>) => {
+  const { t, i18n } = useTranslation();
+
+  const formatDate = (date: Date) =>
+    new Intl.DateTimeFormat(i18n.language, { dateStyle: "medium", timeStyle: "short" }).format(date);
+
+  return (
+    <dl className="grid grid-cols-[max-content_1fr] gap-x-6 gap-y-3 text-sm">
+      <dt className="font-medium text-slate-800">{t("workspace.settings.profile.account_created")}</dt>
+      <dd className="text-slate-600">{formatDate(createdAt)}</dd>
+
+      <dt className="font-medium text-slate-800">{t("workspace.settings.profile.last_login")}</dt>
+      <dd className="text-slate-600">
+        {lastLoginAt ? formatDate(lastLoginAt) : t("workspace.settings.profile.never_logged_in")}
+      </dd>
+    </dl>
+  );
+};
