diff --git a/apps/web/modules/account/hooks/use-download-account-data.ts b/apps/web/modules/account/hooks/use-download-account-data.ts
new file mode 100644
index 000000000..9edac7e80
--- /dev/null
+++ b/apps/web/modules/account/hooks/use-download-account-data.ts
@@ -0,0 +1,29 @@
+"use client";
+
+import { useMutation } from "@tanstack/react-query";
+import { getAccountDataExport } from "@/modules/account/lib/api-client";
+
+const DOWNLOAD_FILE_NAME = "formbricks-account-data.json";
+
+/** Saves the export as a JSON file through a temporary object URL, which is released straight after the click. */
+const saveAsJsonFile = (data: unknown, fileName: string) => {
+  const blob = new Blob([JSON.stringify(data, null, 2)], { type: "application/json" });
+  const url = URL.createObjectURL(blob);
+  const link = document.createElement("a");
+  link.href = url;
+  link.download = fileName;
+  document.body.appendChild(link);
+  link.click();
+  link.remove();
+  URL.revokeObjectURL(url);
+};
+
+/**
+ * Fetches the signed-in user's data and saves it as a JSON file. The fetch is a mutation rather than a
+ * query: it runs on a button press and must not be cached or refetched on focus.
+ */
+export const useDownloadAccountData = () =>
+  useMutation({
+    mutationFn: getAccountDataExport,
+    onSuccess: (data) => saveAsJsonFile(data, DOWNLOAD_FILE_NAME),
+  });
diff --git a/apps/web/modules/account/lib/api-client.ts b/apps/web/modules/account/lib/api-client.ts
new file mode 100644
index 000000000..5db1330f6
--- /dev/null
+++ b/apps/web/modules/account/lib/api-client.ts
@@ -0,0 +1,13 @@
+import type { TAccountDataExport } from "@/modules/account/lib/data-export";
+import { parseV3ApiError } from "@/modules/api/lib/v3-client";
+
+const ACCOUNT_DATA_EXPORT_PATH = "/api/v3/account/data-export";
+
+/** Fetches the signed-in user's own data. Throws a parsed `V3ApiError` on a non-2xx response. */
+export async function getAccountDataExport(): Promise<TAccountDataExport> {
+  const response = await fetch(ACCOUNT_DATA_EXPORT_PATH, { method: "GET", cache: "no-store" });
+  if (!response.ok) {
+    throw await parseV3ApiError(response);
+  }
+  return ((await response.json()) as { data: TAccountDataExport }).data;
+}
diff --git a/apps/web/modules/account/lib/data-export.ts b/apps/web/modules/account/lib/data-export.ts
new file mode 100644
index 000000000..36eeff359
--- /dev/null
+++ b/apps/web/modules/account/lib/data-export.ts
@@ -0,0 +1,45 @@
+import "server-only";
+import { prisma } from "@formbricks/database";
+import { getUser } from "@/lib/user/service";
+
+/**
+ * The personal data a user can download from their profile page. Built from an explicit field list so
+ * that a column added to `User` later (password hash, 2FA secret, tokens) can never leak into the export.
+ */
+export type TAccountDataExport = {
+  name: string;
+  email: string;
+  locale: string;
+  notificationSettings: unknown;
+  organizations: { name: string; role: string }[];
+};
+
+/**
+ * Returns the caller's own data. Only accepted memberships are listed: a pending invite is not yet a
+ * membership of the user, and the user cannot act in that organization until they accept it.
+ */
+export const getAccountDataExport = async (userId: string): Promise<TAccountDataExport | null> => {
+  const [user, memberships] = await Promise.all([
+    getUser(userId),
+    prisma.membership.findMany({
+      where: { userId, accepted: true },
+      select: { role: true, organization: { select: { name: true } } },
+      orderBy: { organization: { name: "asc" } },
+    }),
+  ]);
+
+  if (!user) {
+    return null;
+  }
+
+  return {
+    name: user.name,
+    email: user.email,
+    locale: user.locale,
+    notificationSettings: user.notificationSettings,
+    organizations: memberships.map((membership) => ({
+      name: membership.organization.name,
+      role: membership.role,
+    })),
+  };
+};
