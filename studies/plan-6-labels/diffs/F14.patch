new file mode 100644
index 000000000..8d9668ff3
--- /dev/null
+++ b/apps/web/app/api/v3/account/data-export/route.ts
@@ -0,0 +1,26 @@
+/**
+ * GET /api/v3/account/data-export - the signed-in user's own personal data as JSON.
+ *
+ * Session-only: the export is the caller's own profile, so an API key has no meaning here and accepting
+ * one would only widen the surface.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { problemNotFound, problemUnauthorized, successResponse } from "@/app/api/v3/lib/response";
+import { getAccountDataExport } from "@/modules/account/lib/data-export";
+
+export const GET = withV3ApiWrapper({
+  auth: "session",
+  handler: async ({ authentication, requestId, instance }) => {
+    const userId = authentication && "user" in authentication ? authentication.user?.id : undefined;
+    if (!userId) {
+      return problemUnauthorized(requestId, "Session required", instance);
+    }
+
+    const data = await getAccountDataExport(userId);
+    if (!data) {
+      return problemNotFound(requestId, "user", userId, instance);
+    }
+
+    return successResponse(data, { requestId });
+  },
+});
