@@ -0,0 +1,42 @@
+"use client";
+
+import { QueryClient, QueryClientProvider } from "@tanstack/react-query";
+import { useState } from "react";
+import { toast } from "react-hot-toast";
+import { useTranslation } from "react-i18next";
+import { useDownloadAccountData } from "@/modules/account/hooks/use-download-account-data";
+import { getV3ApiErrorMessage } from "@/modules/api/lib/v3-client";
+import { Button } from "@/modules/ui/components/button";
+
+const DownloadAccountDataButton = () => {
+  const { t } = useTranslation();
+  const downloadAccountData = useDownloadAccountData();
+
+  return (
+    <Button
+      variant="secondary"
+      loading={downloadAccountData.isPending}
+      onClick={() =>
+        downloadAccountData.mutate(undefined, {
+          onError: (error) =>
+            toast.error(getV3ApiErrorMessage(error, t("common.something_went_wrong_please_try_again"))),
+        })
+      }>
+      {t("workspace.settings.profile.download_my_data")}
+    </Button>
+  );
+};
+
+/**
+ * Mounts its own `QueryClientProvider`: the account settings segment has no app-wide one, the same
+ * reason the tags settings page carries a provider of its own.
+ */
+export const DownloadAccountData = () => {
+  const [queryClient] = useState(() => new QueryClient());
+
+  return (
+    <QueryClientProvider client={queryClient}>
+      <DownloadAccountDataButton />
+    </QueryClientProvider>
+  );
+};
