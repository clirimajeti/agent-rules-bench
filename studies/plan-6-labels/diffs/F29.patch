+/**
+ * POST /api/v3/account/download-my-data
+ *
+ * Returns a JSON blob with the authenticated user's name, email, locale,
+ * notification settings, and organization memberships for data export.
+ */
+import { prisma } from "@formbricks/database";
+import { AuthorizationError } from "@formbricks/types/errors";
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { getUser } from "@/lib/user/service";
+
+interface TOrganizationMembership {
+  name: string;
+  role: string;
+}
+
+interface DownloadMyDataResult {
+  name: string;
+  email: string;
+  locale: string;
+  notificationSettings: Record<string, unknown> | null;
+  organizationMemberships: TOrganizationMembership[];
+}
+
+export const POST = withV3ApiWrapper({
+  auth: "session",
+  handler: async ({ authentication }) => {
+    const user = await getUser(authentication.userId);
+    if (!user) {
+      throw new AuthorizationError("User not found");
+    }
+
+    const memberships = await prisma.membership.findMany({
+      where: {
+        userId: authentication.userId,
+      },
+      select: {
+        role: true,
+        organization: {
+          select: {
+            name: true,
+          },
+        },
+      },
+    });
+
+    const organizationMemberships: TOrganizationMembership[] = memberships.map((m) => ({
+      name: m.organization.name,
+      role: m.role,
+    }));
+
+    const result: DownloadMyDataResult = {
+      name: user.name,
+      email: user.email,
+      locale: user.locale,
+      notificationSettings: user.notificationSettings,
+      organizationMemberships,
+    };
+
+    return new Response(JSON.stringify(result), {
+      status: 200,
+      headers: { "Content-Type": "application/json" },
+    });
+  },
+});
