+"use client";
+
+import { useMutation } from "@tanstack/react-query";
+import { DownloadIcon, Loader2 } from "lucide-react";
+import { useRouter } from "next/navigation";
+import toast from "react-hot-toast";
+import { useTranslation } from "react-i18next";
+import { Button } from "@/modules/ui/components/button";
+import { parseV3ApiError } from "@/modules/api/lib/v3-client";
+
+interface DownloadMyDataResult {
+  name: string;
+  email: string;
+  locale: string;
+  notificationSettings: Record<string, unknown> | null;
+  organizationMemberships: { name: string; role: string }[];
+}
+
+/** Fetch the user's downloadable data from the API. */
+async function downloadMyData(): Promise<DownloadMyDataResult> {
+  const response = await fetch("/api/v3/account/download-my-data", {
+    method: "POST",
+    cache: "no-store",
+    signal: AbortSignal.timeout(15_000),
+  });
+  if (!response.ok) throw await parseV3ApiError(response);
+  return response.json();
+}
+
+export const DownloadMyDataButton = () => {
+  const { t } = useTranslation();
+  const router = useRouter();
+  const download = useMutation({ mutationFn: downloadMyData });
+
+  const onClick = () =>
+    download.mutate(undefined, {
+      onSuccess: (data) => {
+        const jsonString = JSON.stringify(data, null, 2);
+        const blob = new Blob([jsonString], { type: "application/json" });
+        const url = URL.createObjectURL(blob);
+        const link = document.createElement("a");
+        link.href = url;
+        link.download = `formbricks-account-data-${new Date().toISOString().slice(0, 10)}.json`;
+        document.body.appendChild(link);
+        link.click();
+        document.body.removeChild(link);
+        URL.revokeObjectURL(url);
+        toast.success(t("workspace.settings.profile.download_success"));
+        router.refresh();
+      },
+      onError: () => toast.error(t("workspace.settings.profile.download_error")),
+    });
+
+  return (
+    <Button variant="secondary" size="sm" onClick={onClick} disabled={download.isPending}>
+      {download.isPending ? (
+        <Loader2 className="size-4 animate-spin" />
+      ) : (
+        <DownloadIcon className="size-4" />
+      )}
+      {t("workspace.settings.profile.download_my_data")}
+    </Button>
+  );
+};
