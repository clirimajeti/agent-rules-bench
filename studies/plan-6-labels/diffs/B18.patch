+const getCommentStats = (discussionId: string) => {
+  const comments = db.comment.findMany({
+    where: {
+      discussionId: {
+        equals: discussionId,
+      },
+    },
+  });
+
+  return {
+    commentCount: comments.length,
+    lastCommentAt: comments.length
+      ? Math.max(...comments.map((comment) => comment.createdAt))
+      : null,
+  };
+};
