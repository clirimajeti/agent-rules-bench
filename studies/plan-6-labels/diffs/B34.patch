+++ b/apps/react-vite/src/features/users/utils/export-users-csv.ts
@@ -0,0 +1,18 @@
+import { User } from '@/types/api';
+import { downloadCsv, toCsv } from '@/utils/csv';
+import { formatDate } from '@/utils/format';
+
+export const exportUsersCsv = (users: User[]) => {
+  const csv = toCsv(
+    ['Name', 'Email', 'Role', 'Joined'],
+    users.map((user) => [
+      `${user.firstName} ${user.lastName}`,
+      user.email,
+      user.role,
+      formatDate(user.createdAt),
+    ]),
+  );
+
+  const date = new Date().toISOString().slice(0, 10);
+  downloadCsv(`users-${date}.csv`, csv);
+};
diff --git a/apps/react-vite/src/features/users/utils/filter-users.ts b/apps/react-vite/src/features/users/utils/filter-users.ts
new file mode 100644
index 0000000..a0d1e3c
--- /dev/null
+++ b/apps/react-vite/src/features/users/utils/filter-users.ts
@@ -0,0 +1,33 @@
+import { ROLES } from '@/lib/authorization';
+import { User } from '@/types/api';
+
+export type RoleFilter = 'ALL' | keyof typeof ROLES;
+
+export const isRoleFilter = (value: string): value is RoleFilter => {
+  return value === 'ALL' || value in ROLES;
+};
+
+type UserFilters = {
+  search: string;
+  role: RoleFilter;
+};
+
+export const filterUsers = (users: User[], { search, role }: UserFilters) => {
+  const term = search.trim().toLowerCase();
+
+  return users.filter((user) => {
+    if (role !== 'ALL' && user.role !== role) {
+      return false;
+    }
+
+    if (!term) {
+      return true;
+    }
+
+    const fullName = `${user.firstName} ${user.lastName}`.toLowerCase();
+
+    return (
+      fullName.includes(term) || user.email.toLowerCase().includes(term)
+    );
+  });
+};
diff --git a/apps/react-vite/src/utils/csv.ts b/apps/react-vite/src/utils/csv.ts
new file mode 100644
index 0000000..be3afea
--- /dev/null
+++ b/apps/react-vite/src/utils/csv.ts
@@ -0,0 +1,35 @@
+// Cells starting with these characters are interpreted as formulas by
+// spreadsheet applications, so they are prefixed with a single quote.
+const FORMULA_PREFIX_PATTERN = /^[=+\-@\t\r]/;
+const CELL_NEEDS_QUOTES_PATTERN = /[",\r\n]/;
+
+const escapeCell = (value: string) => {
+  const safeValue = FORMULA_PREFIX_PATTERN.test(value) ? `'${value}` : value;
+
+  if (!CELL_NEEDS_QUOTES_PATTERN.test(safeValue)) {
+    return safeValue;
+  }
+
+  return `"${safeValue.replace(/"/g, '""')}"`;
+};
+
+export const toCsv = (headers: string[], rows: string[][]) => {
+  return [headers, ...rows]
+    .map((row) => row.map(escapeCell).join(','))
+    .join('\r\n');
+};
+
+export const downloadCsv = (filename: string, csv: string) => {
+  // The byte order mark tells spreadsheet applications that the file is UTF-8.
+  const blob = new Blob(['﻿', csv], { type: 'text/csv;charset=utf-8' });
+  const url = URL.createObjectURL(blob);
+
+  const link = document.createElement('a');
+  link.href = url;
+  link.download = filename;
+  document.body.appendChild(link);
+  link.click();
+  link.remove();
+
+  setTimeout(() => URL.revokeObjectURL(url), 0);
+};
