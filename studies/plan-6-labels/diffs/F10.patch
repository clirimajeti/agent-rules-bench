+
+export async function deleteUnusedTags(params: { workspaceId: string }): Promise<{ deletedCount: number }> {
+  return request<{ deletedCount: number }>(`${BASE_PATH}/delete-unused`, {
+    method: "POST",
+    headers: { "Content-Type": "application/json" },
+    body: JSON.stringify({ workspaceId: params.workspaceId }),
+  });
+}
