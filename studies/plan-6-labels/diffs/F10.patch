 import "server-only";
+import { prisma } from "@formbricks/database";
 import { requireV3WorkspaceAccess } from "@/app/api/v3/lib/auth";
 import {
   problemBadRequest,
@@ -188,3 +189,47 @@ export async function mergeV3Tags(
 
   return successResponse({ id: newTagId }, { requestId });
 }
+
+export async function deleteUnusedV3Tags(
+  params: TBaseParams & { workspaceId: string }
+): Promise<Response> {
+  const { workspaceId, authentication, requestId, instance } = params;
+
+  const access = await requireV3WorkspaceAccess(
+    authentication,
+    workspaceId,
+    "readWrite",
+    requestId,
+    instance
+  );
+  if (access instanceof Response) return access;
+
+  // Find tags that have no response links. This is a workspace-level admin operation,
+  // so we count all tags regardless of survey visibility.
+  const tags = await getTagsByWorkspaceId(access.workspaceId);
+  const tagIdsWithResponses = await prisma.tagsOnResponses.findMany({
+    where: {
+      response: {
+        survey: { workspaceId: access.workspaceId },
+      },
+    },
+    distinct: ["tagId"],
+    select: { tagId: true },
+  });
+  const responseTagIds = new Set(tagIdsWithResponses.map((entry) => entry.tagId));
+
+  const unusedTagIds = tags
+    .filter((tag) => !responseTagIds.has(tag.id))
+    .map((tag) => tag.id);
+
+  if (unusedTagIds.length === 0) {
+    return successResponse({ deletedCount: 0 }, { requestId });
+  }
+
+  // Delete all unused tags in a single transaction.
+  await prisma.$transaction(
+    unusedTagIds.map((id) => prisma.tag.delete({ where: { id } }))
+  );
+
+  return successResponse({ deletedCount: unusedTagIds.length }, { requestId });
+}
