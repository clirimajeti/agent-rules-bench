+/**
+ * POST /api/v3/tags/delete-unused — delete every tag in the caller's workspace that is not
+ * attached to any response, then return how many were removed.
+ *
+ * Session-only, matching the other tags endpoints.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { deleteUnusedV3Tags } from "../lib/operations";
+import { ZV3DeleteUnusedTagsBody } from "../lib/schemas";
+
+export const POST = withV3ApiWrapper({
+  auth: "session",
+  schemas: { body: ZV3DeleteUnusedTagsBody },
+  handler: async ({ authentication, parsedInput, requestId, instance }) =>
+    deleteUnusedV3Tags({
+      authentication,
+      workspaceId: parsedInput.body.workspaceId,
+      requestId,
+      instance,
+    }),
+});
