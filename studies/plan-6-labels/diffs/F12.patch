     throw error;
   }
 };
+export const rotateApiKey = async (
+  apiKeyId: string,
+  userId: string
+): Promise<TApiKeyWithEnvironmentPermission & { actualKey: string }> => {
+  validateInputs([apiKeyId, ZId]);
+
+  try {
+    // Fetch the existing key with its workspace permissions
+    const existingKey = await prisma.apiKey.findUnique({
+      where: { id: apiKeyId },
+      include: {
+        apiKeyWorkspaces: true,
+      },
+    });
+
+    if (!existingKey) {
+      throw new DatabaseError("API key not found");
+    }
+
+    // Generate a new secret
+    const secret = randomBytes(32).toString("base64url");
+
+    // Generate hashes
+    const lookupHash = hashSha256(secret);
+    const hashedKey = await hashSecret(secret, 12);
+
+    // Delete old workspace permissions
+    await prisma.apiKeyWorkspace.deleteMany({
+      where: { apiKeyId },
+    });
+
+    // Update the API key with new secret
+    const updatedApiKey = await prisma.apiKey.update({
+      where: { id: apiKeyId },
+      data: {
+        hashedKey,
+        lookupHash,
+        lastUsedAt: null,
+      },
+      include: {
+        apiKeyWorkspaces: true,
+      },
+    });
+
+    // Re-create workspace permissions
+    if (existingKey.apiKeyWorkspaces.length > 0) {
+      await prisma.apiKeyWorkspace.createMany({
+        data: existingKey.apiKeyWorkspaces.map((wp) => ({
+          apiKeyId,
+          workspaceId: wp.workspaceId,
+          permission: wp.permission,
+        })),
+      });
+    }
+
+    await runPostCommitProjection("api_key_rotate_relationship_reconciliation", () =>
+      reconcileApiKeyRelationships({ apiKeyIds: [apiKeyId] })
+    );
+
+    return { ...updatedApiKey, actualKey: `fbk_${secret}` };
+  } catch (error) {
+    if (error instanceof Prisma.PrismaClientKnownRequestError) {
+      throw new DatabaseError(error.message);
+    }
+    throw error;
+  }
+};
