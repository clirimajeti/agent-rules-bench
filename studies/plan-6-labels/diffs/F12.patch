+export const rotateApiKeyAction = authenticatedActionClient.inputSchema(ZRotateApiKeyAction).action(
+  withAuditLogging("rotated", "apiKey", async ({ ctx, parsedInput }) => {
+    const organizationId = await getOrganizationIdFromApiKeyId(parsedInput.apiKeyId);
