@@ -0,0 +1,47 @@
+/**
+ * POST /api/v3/api-keys/{apiKeyId}/rotate — replace the secret of an existing API key while
+ * preserving its label, organization access, and workspace permissions.
+ *
+ * Session cookie or x-api-key. Requires `apiKey.manage` on the key itself.
+ */
+import { z } from "zod";
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { getOrganizationIdFromApiKeyId } from "@/lib/utils/helper";
+import { assertCan } from "@/lib/authorization";
+import { rotateApiKey } from "@/modules/organization/settings/api-keys/lib/api-key";
+import { problemForbidden, successResponse } from "@/app/api/v3/lib/response";
+
+const ZApiKeyIdParam = z.object({
+  apiKeyId: z.string().cuid2(),
+});
+
+export const POST = withV3ApiWrapper({
+  auth: "both",
+  action: "updated",
+  targetType: "apiKey",
+  schemas: { params: ZApiKeyIdParam },
+  handler: async ({ parsedInput, authentication, auditLog, requestId, instance }) => {
+    // Resolve the organization for audit logging before authorization (the key may belong to
+    // someone the caller cannot see — but that is an authorization failure, not a 400).
+    const organizationId = await getOrganizationIdFromApiKeyId(parsedInput.params.apiKeyId);
+
+    // Authorization: the caller must have `apiKey.manage` on the specific key.
+    const can = await assertCan(
+      { type: "user", id: authentication.userId },
+      "apiKey.manage",
+      { type: "apiKey", id: parsedInput.params.apiKeyId }
+    );
+    if (can instanceof Response) {
+      return can;
+    }
+
+    auditLog!.organizationId = organizationId;
+    auditLog!.targetId = parsedInput.params.apiKeyId;
+
+    const result = await rotateApiKey(parsedInput.params.apiKeyId);
+
+    auditLog!.newObject = { apiKeyId: parsedInput.params.apiKeyId };
+
+    return successResponse(result, { requestId });
+  },
+});
