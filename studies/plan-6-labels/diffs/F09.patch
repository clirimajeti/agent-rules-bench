index 000000000..e4fee0f9c
--- /dev/null
+++ b/docs/api-v3-reference/src/paths/api_v3_account_export.yml
@@ -0,0 +1,81 @@
+get:
+  operationId: exportAccountV3
+  # Session-only by design (it exports the signed-in person's own data), so an API-key caller reading the
+  # published reference would only ever get a 401. Excluded from the generated docs pages like the other
+  # session-only operations (ENG-2533); the operation stays in the bundle for the contract tests.
+  x-excluded: true
+  summary: Export my account data
+  description: |
+    Returns the signed-in user's own name, email, locale, notification settings and organization
+    memberships (organization name and role). Pending invitations are not included.
+
+    Session cookie only. This backs the "Download my data" button on the profile settings page, so it
+    does not accept `x-api-key`.
+  tags:
+    - V3 Account
+  responses:
+    "200":
+      description: Account data retrieved successfully
+      headers:
+        X-Request-Id:
+          schema:
+            type: string
+          description: Request correlation ID
+        Cache-Control:
+          schema:
+            type: string
+          example: private, no-store
+      content:
+        application/json:
+          schema:
+            type: object
+            required:
+              - data
+            properties:
+              data:
+                type: object
+                required:
+                  - name
+                  - email
+                  - locale
+                  - notificationSettings
+                  - organizations
+                properties:
+                  name:
+                    type: string
+                  email:
+                    type: string
+                  locale:
+                    type: string
+                    example: en-US
+                  notificationSettings:
+                    type: object
+                    description: The user's notification preferences, as stored.
+                    additionalProperties: true
+                  organizations:
+                    type: array
+                    items:
+                      type: object
+                      required:
+                        - name
+                        - role
+                      properties:
+                        name:
+                          type: string
+                        role:
+                          type: string
+                          enum:
+                            - owner
+                            - manager
+                            - member
+                            - billing
+    "401":
+      $ref: ../components/responses/V3UnauthorizedSession.yml
+    "403":
+      $ref: ../components/responses/V3Forbidden.yml
+    "429":
+      $ref: ../components/responses/V3TooManyRequests.yml
+    "500":
+      $ref: ../components/responses/V3InternalServerError.yml
+  security:
+    - sessionAuth: []
