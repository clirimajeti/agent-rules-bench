diff --git a/apps/web/app/(app)/workspaces/[workspaceId]/settings/account/profile/components/DownloadMyData.tsx b/apps/web/app/(app)/workspaces/[workspaceId]/settings/account/profile/components/DownloadMyData.tsx
new file mode 100644
index 000000000..cadc5e3a5
--- /dev/null
+++ b/apps/web/app/(app)/workspaces/[workspaceId]/settings/account/profile/components/DownloadMyData.tsx
@@ -0,0 +1,50 @@
+"use client";
+
+import { QueryClient, QueryClientProvider, useMutation } from "@tanstack/react-query";
+import { DownloadIcon } from "lucide-react";
+import { useState } from "react";
+import toast from "react-hot-toast";
+import { useTranslation } from "react-i18next";
+import { getV3ApiErrorMessage, parseV3ApiError } from "@/modules/api/lib/v3-client";
+import { saveBlobAsFile } from "@/modules/ee/data-retention/lib/file-download";
+import { Button } from "@/modules/ui/components/button";
+
+const ACCOUNT_EXPORT_URL = "/api/v3/account/export";
+const ACCOUNT_EXPORT_FILE_NAME = "my-formbricks-data.json";
+
+/** Fetched rather than linked: a refusal is problem JSON, which a plain link would save as the file. */
+const fetchAccountExport = async (): Promise<Blob> => {
+  const response = await fetch(ACCOUNT_EXPORT_URL, { method: "GET", cache: "no-store" });
+  if (!response.ok) throw await parseV3ApiError(response);
+
+  const { data } = (await response.json()) as { data: unknown };
+  return new Blob([JSON.stringify(data, null, 2)], { type: "application/json" });
+};
+
+const DownloadMyDataButton = () => {
+  const { t } = useTranslation();
+  const download = useMutation({
+    mutationFn: fetchAccountExport,
+    onSuccess: (blob) => saveBlobAsFile(blob, ACCOUNT_EXPORT_FILE_NAME),
+    onError: (error) =>
+      toast.error(getV3ApiErrorMessage(error, t("workspace.settings.profile.download_my_data_failed"))),
+  });
+
+  return (
+    <Button variant="secondary" loading={download.isPending} onClick={() => download.mutate()}>
+      <DownloadIcon className="h-4 w-4" />
+      {t("workspace.settings.profile.download_my_data")}
+    </Button>
+  );
+};
+
+/** There is no app-wide `QueryClientProvider`; like each other query consumer, this mounts its own. */
+export const DownloadMyData = () => {
+  const [queryClient] = useState(() => new QueryClient());
+
+  return (
+    <QueryClientProvider client={queryClient}>
+      <DownloadMyDataButton />
+    </QueryClientProvider>
+  );
+};
diff --git a/apps/web/app/api/v3/account/export/lib/operations.ts b/apps/web/app/api/v3/account/export/lib/operations.ts
new file mode 100644
index 000000000..13820c8a8
--- /dev/null
+++ b/apps/web/app/api/v3/account/export/lib/operations.ts
@@ -0,0 +1,45 @@
+import "server-only";
+import { prisma } from "@formbricks/database";
+import { getV3SessionUserId } from "@/app/api/v3/lib/auth";
+import { problemForbidden, problemUnauthorized, successResponse } from "@/app/api/v3/lib/response";
+import type { TV3Authentication } from "@/app/api/v3/lib/types";
+import { type TV3AccountExport, serializeV3AccountExport } from "./serializers";
+
+type TExportParams = {
+  authentication: TV3Authentication;
+  requestId: string;
+  instance?: string;
+};
+
+/**
+ * Only ever reads the session user's own row, never an id from the request, so there is nothing to
+ * forge. A pending invite is not a membership yet, so it is left out.
+ */
+export async function exportV3Account({
+  authentication,
+  requestId,
+  instance,
+}: TExportParams): Promise<Response> {
+  const userId = getV3SessionUserId(authentication);
+  if (!userId) return problemUnauthorized(requestId, "Session required", instance);
+
+  const user = await prisma.user.findUnique({
+    where: { id: userId },
+    select: {
+      name: true,
+      email: true,
+      locale: true,
+      notificationSettings: true,
+      memberships: {
+        where: { accepted: true },
+        select: { role: true, organization: { select: { name: true } } },
+        orderBy: { organization: { name: "asc" } },
+      },
+    },
+  });
+
+  // A valid session whose user row is gone: same answer as an unknown resource elsewhere in v3.
+  if (!user) return problemForbidden(requestId, "You are not authorized to access this resource", instance);
+
+  return successResponse<TV3AccountExport>(serializeV3AccountExport(user), { requestId });
+}
diff --git a/apps/web/app/api/v3/account/export/lib/serializers.ts b/apps/web/app/api/v3/account/export/lib/serializers.ts
new file mode 100644
index 000000000..0f6713e00
--- /dev/null
+++ b/apps/web/app/api/v3/account/export/lib/serializers.ts
@@ -0,0 +1,24 @@
+export type TV3AccountExport = {
+  name: string;
+  email: string;
+  locale: string;
+  notificationSettings: unknown;
+  organizations: { name: string; role: string }[];
+};
+
+export const serializeV3AccountExport = (user: {
+  name: string;
+  email: string;
+  locale: string;
+  notificationSettings: unknown;
+  memberships: { role: string; organization: { name: string } }[];
+}): TV3AccountExport => ({
+  name: user.name,
+  email: user.email,
+  locale: user.locale,
+  notificationSettings: user.notificationSettings,
+  organizations: user.memberships.map((membership) => ({
+    name: membership.organization.name,
+    role: membership.role,
+  })),
+});
