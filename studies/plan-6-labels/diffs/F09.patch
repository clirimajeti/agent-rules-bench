--- /dev/null
+++ b/apps/web/app/api/v3/account/export/route.ts
@@ -0,0 +1,14 @@
+/**
+ * GET /api/v3/account/export - the signed-in user's own account data, for the "Download my data" button.
+ *
+ * Session-only, deliberately: it exports the caller's personal data, so an API key (which acts for a
+ * workspace, not for a person) has no business here.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { exportV3Account } from "./lib/operations";
+
+export const GET = withV3ApiWrapper({
+  auth: "session",
+  handler: async ({ authentication, requestId, instance }) =>
+    exportV3Account({ authentication, requestId, instance }),
+});
