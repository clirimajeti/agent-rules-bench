+/**
+ * DELETE /api/v3/tags/delete-unused — delete every tag that has no response links.
+ *
+ * The workspace is resolved from the first tag the caller can read, which is the same
+ * authorization model the other tag endpoints use. Session-only, matching the server actions
+ * these replace.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { deleteUnusedTags } from "./lib/operations";
+import { ZV3DeleteUnusedTagsQuery } from "./lib/schemas";
+
+export const DELETE = withV3ApiWrapper({
+  auth: "session",
+  action: "deleted",
+  targetType: "tag",
+  schemas: { query: ZV3DeleteUnusedTagsQuery },
+  handler: async ({ authentication, parsedInput, auditLog, requestId, instance }) =>
+    deleteUnusedTags({
+      authentication,
+      workspaceId: parsedInput.query.workspaceId,
+      auditLog,
+      requestId,
+      instance,
+    }),
+});
