+/**
+ * POST /api/v3/tags/delete-unused — delete every tag in a workspace that no response carries.
+ *
+ * A POST custom method rather than a collection-level `DELETE`, for the same reason as
+ * `/api/v3/responses/batch-delete`: a `DELETE` on `/api/v3/tags` that lost its query string would read as
+ * "delete every tag", and a distinct path cannot be reached by accident. Session-only, matching the tag
+ * screen it backs.
+ */
+import { withV3ApiWrapper } from "@/app/api/v3/lib/api-wrapper";
+import { deleteUnusedV3Tags } from "../lib/operations";
+import { ZV3DeleteUnusedTagsQuery } from "../lib/schemas";
+
+export const POST = withV3ApiWrapper({
+  auth: "session",
+  action: "deleted",
+  targetType: "tag",
+  schemas: { query: ZV3DeleteUnusedTagsQuery },
+  handler: async ({ authentication, parsedInput, auditLog, requestId, instance }) =>
+    deleteUnusedV3Tags({
+      authentication,
+      workspaceId: parsedInput.query.workspaceId,
+      auditLog,
+      requestId,
+      instance,
+    }),
+});
