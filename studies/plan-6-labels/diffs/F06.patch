+/**
+ * Deletes every tag in the workspace that no response carries.
+ *
+ * "Unused" is judged across all responses, not the caller's visible subset: the list's counts are
+ * visibility-scoped (ENG-3282), so a zero there can hide links to responses the caller cannot read. Only
+ * tags with no links at all are removed, so no response loses a tag. The `responses: { none }` filter is
+ * part of the delete itself, so a tag applied between a read and this write is kept.
+ */
+export const deleteUnusedTags = async (
+  workspaceId: string
+): Promise<Result<number, { code: TagError; message: string; meta?: Record<string, string> }>> => {
+  validateInputs([workspaceId, ZId]);
+
+  try {
+    const { count } = await prisma.tag.deleteMany({
+      where: {
+        workspaceId,
+        responses: { none: {} },
+      },
+    });
+
+    return ok(count);
+  } catch (error) {
+    return err({
+      code: TagError.UNEXPECTED_ERROR,
+      message: error instanceof Error ? error.message : "Unknown error occurred",
+    });
+  }
+};
