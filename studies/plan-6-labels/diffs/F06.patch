+export async function deleteUnusedV3Tags(
+  params: TBaseParams & { workspaceId: string; auditLog?: TV3AuditLog }
+): Promise<Response> {
+  const { workspaceId, auditLog, requestId, instance } = params;
+
+  // Same authority as deleting a single tag: a workspace team member with `readWrite`, or an owner or
+  // manager. It is checked against the workspace the caller named, which is also what the delete filters
+  // by, so the two cannot diverge.
+  const access = await requireV3WorkspaceAccess(
+    params.authentication,
+    workspaceId,
+    "readWrite",
+    requestId,
+    instance
+  );
+  if (access instanceof Response) return access;
+
+  if (auditLog) {
+    auditLog.organizationId = access.organizationId;
+    auditLog.targetId = workspaceId;
+  }
+
+  const result = await deleteUnusedTags(access.workspaceId);
+  if (!result.ok) {
+    return problemInternalError(requestId, "Unable to delete unused tags", instance);
+  }
+
+  if (auditLog) auditLog.oldObject = { workspaceId: access.workspaceId, deleted: result.data };
+
+  return successResponse({ deleted: result.data }, { requestId });
+}
