@@ -0,0 +1,66 @@
+post:
+  operationId: deleteUnusedTagsV3
+  # Session-only by design, so an API-key caller reading the published reference would only ever get a
+  # 401. Excluded from the generated docs pages until ENG-2533 decides between dropping the paths
+  # and opening them to API keys; the operation stays in the bundle for the contract tests.
+  x-excluded: true
+  summary: Delete unused tags
+  description: |
+    Deletes every tag in the workspace that no response carries. Tags applied to any response, including
+    responses the caller cannot read, are kept, so no response loses a tag.
+
+    `deleted` reports how many tags were removed; zero means every tag is in use.
+
+    Session cookie only. Same authorization as deleting a single tag.
+  tags:
+    - V3 Tags
+  parameters:
+    - in: query
+      name: workspaceId
+      required: true
+      schema:
+        type: string
+        format: cuid2
+      description: |
+        Workspace identifier. Only this workspace's tags are considered.
+  responses:
+    "200":
+      description: Unused tags deleted
+      headers:
+        X-Request-Id:
+          schema:
+            type: string
+          description: Request correlation ID
+        Cache-Control:
+          schema:
+            type: string
+          example: private, no-store
+      content:
+        application/json:
+          schema:
+            type: object
+            required:
+              - data
+            properties:
+              data:
+                type: object
+                required:
+                  - deleted
+                properties:
+                  deleted:
+                    type: integer
+                    minimum: 0
+                    description: How many unused tags were deleted.
+                additionalProperties: false
+    "400":
+      $ref: ../components/responses/V3BadRequest.yml
+    "401":
+      $ref: ../components/responses/V3UnauthorizedSession.yml
+    "403":
+      $ref: ../components/responses/V3Forbidden.yml
+    "429":
+      $ref: ../components/responses/V3TooManyRequests.yml
+    "500":
+      $ref: ../components/responses/V3InternalServerError.yml
+  security:
+    - sessionAuth: []
