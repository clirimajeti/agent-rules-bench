--- /dev/null
+++ b/apps/react-vite/src/features/users/components/export-users.tsx
@@ -0,0 +1,52 @@
+import { Download } from 'lucide-react';
+
+import { Button } from '@/components/ui/button';
+import { User } from '@/types/api';
+import { formatDate } from '@/utils/format';
+
+const escapeCsvValue = (value: string) =>
+  /[",\n\r]/.test(value) ? `"${value.replace(/"/g, '""')}"` : value;
+
+const buildUsersCsv = (users: User[]) => {
+  const rows = [
+    ['Name', 'Email', 'Role', 'Joined'],
+    ...users.map((user) => [
+      `${user.firstName} ${user.lastName}`,
+      user.email,
+      user.role,
+      formatDate(user.createdAt),
+    ]),
+  ];
+
+  return rows.map((row) => row.map(escapeCsvValue).join(',')).join('\r\n');
+};
+
+type ExportUsersProps = {
+  users: User[];
+};
+
+export const ExportUsers = ({ users }: ExportUsersProps) => {
+  const handleExport = () => {
+    const blob = new Blob([buildUsersCsv(users)], {
+      type: 'text/csv;charset=utf-8;',
+    });
+    const url = URL.createObjectURL(blob);
+    const link = document.createElement('a');
+    link.href = url;
+    link.download = 'users.csv';
+    link.click();
+    URL.revokeObjectURL(url);
+  };
+
+  return (
+    <Button
+      variant="outline"
+      size="sm"
+      icon={<Download className="size-4" />}
+      disabled={users.length === 0}
+      onClick={handleExport}
+    >
+      Export CSV
+    </Button>
+  );
+};
