@@ -0,0 +1,18 @@
+import { parseV3ApiError } from "@/modules/api/lib/v3-client";
+import type { Webhook } from "@formbricks/database/prisma-browser";
+
+const BASE_PATH = "/api/v3/webhooks";
+const MUTATION_TIMEOUT_MS = 15_000;
+
+export async function duplicateWebhook(webhookId: string): Promise<Webhook> {
+  const response = await fetch(`${BASE_PATH}/${encodeURIComponent(webhookId)}/duplicate`, {
+    method: "POST",
+    signal: AbortSignal.timeout(MUTATION_TIMEOUT_MS),
+  });
+
+  if (!response.ok) {
+    throw await parseV3ApiError(response);
+  }
+
+  return (await response.json()) as Webhook;
+}
