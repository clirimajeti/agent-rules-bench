diff --git a/apps/web/modules/integrations/webhooks/hooks/use-duplicate-webhook.ts b/apps/web/modules/integrations/webhooks/hooks/use-duplicate-webhook.ts
new file mode 100644
index 000000000..7a884f77a
--- /dev/null
+++ b/apps/web/modules/integrations/webhooks/hooks/use-duplicate-webhook.ts
@@ -0,0 +1,26 @@
+"use client";
+
+import { useMutation, useQueryClient } from "@tanstack/react-query";
+import { duplicateWebhook } from "@/modules/integrations/webhooks/lib/api-client";
+import type { Webhook } from "@formbricks/database/prisma-browser";
+
+/**
+ * Hook for duplicating a webhook via the v3 API.
+ *
+ * On success, the new webhook is inserted at the top of the webhook list cache
+ * so the UI reflects it immediately without a full refetch.
+ */
+export const useDuplicateWebhook = (workspaceId: string) => {
+  const queryClient = useQueryClient();
+
+  return useMutation({
+    mutationFn: (webhookId: string) => duplicateWebhook(webhookId),
+    onSuccess: (newWebhook: Webhook) => {
+      const key = ["webhooks", workspaceId];
+      queryClient.setQueryData(key, (old: Webhook[] | undefined) => {
+        if (!old) return [newWebhook];
+        return [newWebhook, ...old];
+      });
+    },
+  });
+};
diff --git a/apps/web/modules/integrations/webhooks/lib/api-client.ts b/apps/web/modules/integrations/webhooks/lib/api-client.ts
