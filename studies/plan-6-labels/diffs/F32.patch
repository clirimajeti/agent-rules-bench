@@ -0,0 +1,106 @@
+import "server-only";
+import { logger } from "@formbricks/logger";
+import { ResourceNotFoundError } from "@formbricks/types/errors";
+import {
+  createdResponse,
+  problemForbidden,
+  problemNotFound,
+  problemUnauthorized,
+} from "@/app/api/v3/lib/response";
+import type { TV3AuditLog, TV3Authentication } from "@/app/api/v3/lib/types";
+import { requireV3WorkspaceAccess } from "@/app/api/v3/lib/auth";
+import { getOrganizationIdFromWebhookId, getWorkspaceIdFromWebhookId } from "@/lib/utils/helper";
+import { getWebhook } from "@/modules/api/v2/management/webhooks/[webhookId]/lib/webhook";
+import { applyRateLimit } from "@/modules/core/rate-limit/helpers";
+import { rateLimitConfigs } from "@/modules/core/rate-limit/rate-limit-configs";
+import { createWebhook } from "@/modules/integrations/webhooks/lib/webhook";
+import { capturePostHogEvent } from "@/lib/posthog";
+
+export type TV3WebhookDuplicateContext = {
+  authentication: TV3Authentication;
+  auditLog?: TV3AuditLog;
+  requestId: string;
+  instance: string;
+};
+
+/**
+ * POST /api/v3/webhooks/{webhookId}/duplicate — clone a webhook into a new draft.
+ */
+export async function duplicateV3Webhook({
+  webhookId,
+  authentication,
+  auditLog,
+  requestId,
+  instance,
+}: TV3WebhookDuplicateContext & { webhookId: string }): Promise<Response> {
+  const log = logger.withContext({ requestId, webhookId });
+
+  try {
+    const workspaceId = await getWorkspaceIdFromWebhookId(webhookId);
+    const organizationId = await getOrganizationIdFromWebhookId(webhookId);
+
+    // Authorization: require workspace.write access
+    const authorized = await requireV3WorkspaceAccess(
+      authentication,
+      workspaceId,
+      "write",
+      requestId,
+      instance
+    );
+    if (authorized instanceof Response) {
+      return authorized;
+    }
+
+    // Rate limit
+    await applyRateLimit(rateLimitConfigs.api.v3, workspaceId);
+
+    // Fetch the existing webhook
+    const existingWebhookResult = await getWebhook(webhookId);
+    if (!existingWebhookResult.ok) {
+      return problemNotFound(requestId, "Webhook", null, instance);
+    }
+    const existingWebhook = existingWebhookResult.data;
+
+    // Create the duplicate
+    const newWebhook = await createWebhook(workspaceId, {
+      name: `Copy of ${existingWebhook.name ?? ""}`,
+      url: existingWebhook.url,
+      triggers: [...existingWebhook.triggers],
+      surveyIds: [...(existingWebhook.surveyIds ?? [])],
+    });
+
+    // Audit log
+    if (auditLog) {
+      auditLog.targetId = newWebhook.id;
+      auditLog.organizationId = organizationId;
+      auditLog.newObject = {
+        name: newWebhook.name,
+        url: newWebhook.url,
+        triggers: newWebhook.triggers,
+        surveyIds: newWebhook.surveyIds,
+      };
+    }
+
+    // PostHog event
+    const userId =
+      authentication && "user" in authentication && authentication.user?.id
+        ? authentication.user.id
+        : "";
+    capturePostHogEvent(userId, "integration_connected", {
+      integration_type: "webhook",
+      organization_id: organizationId,
+      workspace_id: workspaceId,
+    });
+
+    return createdResponse(newWebhook, {
+      location: `/api/v3/webhooks/${newWebhook.id}`,
+      requestId,
+    });
+  } catch (error) {
+    if (error instanceof ResourceNotFoundError) {
+      return problemNotFound(requestId, "Webhook", null, instance);
+    }
+    log.error({ error }, "Failed to duplicate webhook");
+    throw error;
+  }
+}
