diff --git a/apps/react-vite/src/features/users/utils/export-users.ts b/apps/react-vite/src/features/users/utils/export-users.ts
new file mode 100644
index 0000000..1daa46a
--- /dev/null
+++ b/apps/react-vite/src/features/users/utils/export-users.ts
@@ -0,0 +1,26 @@
+import { User } from '@/types/api';
+import { formatDate } from '@/utils/format';
+
+export const exportUsersToCSV = (users: User[], filename: string = 'users.csv'): void => {
+  const header = 'Name,Email,Role,Joined\n';
+  const rows = users
+    .map((user) => {
+      const name = `"${user.firstName} ${user.lastName}"`;
+      const email = `"${user.email}"`;
+      const role = user.role;
+      const joined = `"${formatDate(user.createdAt)}"`;
+      return `${name},${email},${role},${joined}`;
+    })
+    .join('\n');
+
+  const csvContent = header + rows;
+  const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
+  const link = document.createElement('a');
+  const url = URL.createObjectURL(blob);
+  link.setAttribute('href', url);
+  link.setAttribute('download', filename);
+  link.style.visibility = 'hidden';
+  document.body.appendChild(link);
+  link.click();
+  document.body.removeChild(link);
+};
