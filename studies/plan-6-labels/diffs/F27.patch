--- /dev/null
+++ b/docs/api-v3-reference/src/paths/api_v3_api-keys_{apiKeyId}_rotate.yml
@@ -0,0 +1,93 @@
+post:
+  operationId: rotateApiKeyV3
+  # Session-only by design, like the tags operations: an API-key caller would only ever get a 401.
+  # Excluded from the generated docs pages; the operation stays in the bundle for the contract tests.
+  x-excluded: true
+  summary: Rotate an API key
+  description: |
+    Replaces the key's secret. The old secret stops working at once. The label, organization access and
+    workspace permissions are kept, and `lastUsedAt` is reset to `null`.
+
+    The response carries the new key in `actualKey`. It is shown once and cannot be read again.
+
+    Requires permission to manage the key. A key that grants organization write access can only be
+    rotated by a user who may grant that access.
+  tags:
+    - V3 API Keys
+  parameters:
+    - in: path
+      name: apiKeyId
+      required: true
+      schema:
+        type: string
+        format: cuid2
+      description: The API key to rotate.
+  responses:
+    "200":
+      description: API key rotated successfully
+      content:
+        application/json:
+          schema:
+            type: object
+            required:
+              - data
+            properties:
+              data:
+                type: object
+                required:
+                  - id
+                  - label
+                  - createdAt
+                  - lastUsedAt
+                  - organizationAccess
+                  - apiKeyWorkspaces
+                  - actualKey
+                properties:
+                  id:
+                    type: string
+                    format: cuid2
+                  label:
+                    type: string
+                  createdAt:
+                    type: string
+                    format: date-time
+                  lastUsedAt:
+                    type: string
+                    format: date-time
+                    nullable: true
+                  organizationAccess:
+                    type: object
+                    additionalProperties: true
+                    description: Unchanged by the rotation.
+                  apiKeyWorkspaces:
+                    type: array
+                    description: Unchanged by the rotation.
+                    items:
+                      type: object
+                      required:
+                        - workspaceId
+                        - permission
+                      properties:
+                        workspaceId:
+                          type: string
+                        permission:
+                          type: string
+                          enum:
+                            - read
+                            - write
+                            - manage
+                  actualKey:
+                    type: string
+                    description: The new plaintext API key, returned once.
+    "400":
+      $ref: ../components/responses/V3BadRequest.yml
+    "401":
+      $ref: ../components/responses/V3UnauthorizedSession.yml
+    "403":
+      $ref: ../components/responses/V3Forbidden.yml
+    "429":
+      $ref: ../components/responses/V3TooManyRequests.yml
+    "500":
+      $ref: ../components/responses/V3InternalServerError.yml
+  security:
+    - sessionAuth: []
