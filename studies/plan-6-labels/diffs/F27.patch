+import type { TV3RotatedApiKey } from "@/app/api/v3/api-keys/serializers";
+import { parseV3ApiError } from "@/modules/api/lib/v3-client";
+
+/** Client fetcher for the API key v3 route. Throws a parsed `V3ApiError` on a non-2xx response. */
+export async function rotateApiKey(params: { apiKeyId: string }): Promise<TV3RotatedApiKey> {
+  const response = await fetch(`/api/v3/api-keys/${params.apiKeyId}/rotate`, {
+    method: "POST",
+    cache: "no-store",
+  });
+  if (!response.ok) {
+    throw await parseV3ApiError(response);
+  }
+  return ((await response.json()) as { data: TV3RotatedApiKey }).data;
+}
