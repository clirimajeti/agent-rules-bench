+"use client";
+
+import { useMutation } from "@tanstack/react-query";
+import { rotateApiKey } from "../lib/api-client";
+
+/**
+ * Rotate an API key. There is no query to invalidate: the list is server-rendered, and the one response
+ * carrying the new plaintext key is applied to the table by the caller. `useMutation` also gives the row
+ * an `isPending` flag, so a second click cannot start a second rotation while the first is in flight.
+ */
+export const useRotateApiKey = () =>
+  useMutation({
+    mutationFn: (variables: { apiKeyId: string }) => rotateApiKey(variables),
+  });
