@@ -0,0 +1,55 @@
+import "server-only";
+import { ResourceNotFoundError } from "@formbricks/types/errors";
+import { getV3SessionUserId } from "@/app/api/v3/lib/auth";
+import { problemUnauthorized, successResponse } from "@/app/api/v3/lib/response";
+import type { TV3AuditLog, TV3Authentication } from "@/app/api/v3/lib/types";
+import { assertCan } from "@/lib/authorization";
+import { getOrganizationIdFromApiKeyId } from "@/lib/utils/helper";
+import { getApiKeyOrganizationAccess, rotateApiKey } from "@/modules/organization/settings/api-keys/lib/api-key";
+import { assertCanGrantOrganizationAccess } from "@/modules/organization/settings/api-keys/lib/organization-access";
+import { serializeV3RotatedApiKey } from "../serializers";
+
+type TRotateParams = {
+  authentication: TV3Authentication;
+  apiKeyId: string;
+  auditLog?: TV3AuditLog;
+  requestId: string;
+  instance?: string;
+};
+
+/**
+ * Replace a key's secret and return the new plaintext key, once.
+ *
+ * Authorization matches the other key mutations (`apiKey.manage` on the key), with one addition: the
+ * secret of a key that grants organization write access is only handed to a user who could mint such a
+ * key today (ENG-3075). Without it, a manager under an owners-only user-management floor could rotate
+ * that key and walk away with its authority. An unknown key surfaces as a thrown `ResourceNotFoundError`,
+ * which the wrapper answers as 403, so key ids cannot be probed.
+ *
+ * Session-only: an API key must not be able to replace the secret of any key, itself included.
+ */
+export async function rotateV3ApiKey(params: TRotateParams): Promise<Response> {
+  const { authentication, apiKeyId, auditLog, requestId, instance } = params;
+
+  const userId = getV3SessionUserId(authentication);
+  if (!userId) {
+    return problemUnauthorized(requestId, "Session required", instance);
+  }
+
+  const organizationId = await getOrganizationIdFromApiKeyId(apiKeyId);
+  await assertCan({ type: "user", id: userId }, "apiKey.manage", { type: "apiKey", id: apiKeyId });
+
+  const organizationAccess = await getApiKeyOrganizationAccess(apiKeyId);
+  if (!organizationAccess) throw new ResourceNotFoundError("apiKey", apiKeyId);
+  await assertCanGrantOrganizationAccess(userId, organizationId, organizationAccess);
+
+  if (auditLog) {
+    auditLog.organizationId = organizationId;
+    auditLog.targetId = apiKeyId;
+  }
+
+  // The audit entry records the id only, never the secret or its hashes.
+  const rotated = await rotateApiKey(apiKeyId);
+
+  return successResponse(serializeV3RotatedApiKey(rotated), { requestId });
+}
