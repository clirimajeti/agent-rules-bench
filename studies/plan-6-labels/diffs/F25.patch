+"use client";
+
+import { useTranslation } from "react-i18next";
+import { formatDate } from "@/lib/time";
+import { TUser } from "@formbricks/types/user";
+
+interface AccountActivityProps {
+  user: TUser;
+}
+
+export const AccountActivity = ({ user }: AccountActivityProps) => {
+  const { t } = useTranslation();
+  const locale = user.locale ?? "en-US";
+
+  return (
+    <div className="flex flex-col gap-4">
+      <div className="flex flex-col gap-1">
+        <span className="text-sm text-slate-500">{t("workspace.settings.profile.account_created")}</span>
+        <span className="text-sm font-medium text-slate-800">
+          {formatDate(user.createdAt, locale)}
+        </span>
+      </div>
+      <div className="flex flex-col gap-1">
+        <span className="text-sm text-slate-500">{t("workspace.settings.profile.last_login")}</span>
+        <span className="text-sm font-medium text-slate-800">
+          {user.lastLoginAt ? formatDate(user.lastLoginAt, locale) : "—"}
+        </span>
+      </div>
+    </div>
+  );
+};
diff --git a/apps/web/app/(app)/workspaces/[workspaceId]/settings/account/profile/components/DownloadMyData.tsx b/apps/web/app/(app)/workspaces/[workspaceId]/settings/account/profile/components/DownloadMyData.tsx
