index 000000000..415ea6135
--- /dev/null
+++ b/apps/web/app/(app)/workspaces/[workspaceId]/settings/account/profile/components/DownloadMyData.tsx
@@ -0,0 +1,45 @@
+"use client";
+
+import { useState } from "react";
+import { useTranslation } from "react-i18next";
+import { downloadMyDataAction } from "../server-actions";
+import { Button } from "@/modules/ui/components/button";
+import { toast } from "@/modules/ui/components/toast";
+
+interface DownloadMyDataProps {
+  userId: string;
+}
+
+export const DownloadMyData = ({ userId }: DownloadMyDataProps) => {
+  const { t } = useTranslation();
+  const [isDownloading, setIsDownloading] = useState(false);
+
+  const handleDownload = async () => {
+    setIsDownloading(true);
+    try {
+      const data = await downloadMyDataAction({ userId });
+
+      const blob = new Blob([JSON.stringify(data, null, 2)], { type: "application/json" });
+      const url = URL.createObjectURL(blob);
+      const link = document.createElement("a");
+      link.href = url;
+      link.download = "formbricks-account-data.json";
+      document.body.appendChild(link);
+      link.click();
+      document.body.removeChild(link);
+      URL.revokeObjectURL(url);
+
+      toast.success(t("workspace.settings.profile.download_my_data_success"));
+    } catch {
+      toast.error(t("common.something_went_wrong"));
+    } finally {
+      setIsDownloading(false);
+    }
+  };
+
+  return (
+    <Button variant="secondary" size="sm" onClick={handleDownload} disabled={isDownloading}>
+      {isDownloading ? t("common.downloading") : t("workspace.settings.profile.download_my_data")}
+    </Button>
+  );
+};
diff --git a/apps/web/app/(app)/workspaces/[workspaceId]/settings/account/profile/server-actions.ts b/apps/web/app/(app)/workspaces/[workspaceId]/settings/account/profile/server-actions.ts
new file mode 100644
index 000000000..1ae1451fe
--- /dev/null
+++ b/apps/web/app/(app)/workspaces/[workspaceId]/settings/account/profile/server-actions.ts
@@ -0,0 +1,67 @@
+"use server";
+
+import { z } from "zod";
+import { ZId } from "@formbricks/types/common";
+import { DatabaseError } from "@formbricks/types/errors";
+import { prisma } from "@formbricks/database";
+import { lookupAuthorizedOrganizationIds } from "@/lib/authorization/resource-list";
+import { authenticatedActionClient } from "@/lib/utils/action-client";
+
+export const ZDownloadMyDataInput = z.object({
+  userId: ZId,
+});
+
+export type DownloadMyDataResult = {
+  name: string;
+  email: string;
+  locale: string;
+  notificationSettings: Record<string, unknown>;
+  organizations: { name: string; role: string }[];
+};
+
+export const downloadMyDataAction = authenticatedActionClient
+  .inputSchema(ZDownloadMyDataInput)
+  .action(async ({ ctx, parsedInput }) => {
+    const user = await prisma.user.findUnique({
+      where: { id: parsedInput.userId },
+      select: {
+        name: true,
+        email: true,
+        locale: true,
+        notificationSettings: true,
+      },
+    });
+
+    if (!user) {
+      throw new DatabaseError("User not found");
+    }
+
+    const organizationIds = await lookupAuthorizedOrganizationIds({
+      type: "user",
+      id: parsedInput.userId,
+    });
+
+    const memberships = await prisma.membership.findMany({
+      where: {
+        userId: parsedInput.userId,
+        organizationId: { in: organizationIds },
+      },
+      select: {
+        role: true,
+        organization: {
+          select: { name: true },
+        },
+      },
+    });
+
+    return {
+      name: user.name,
+      email: user.email,
+      locale: user.locale,
+      notificationSettings: user.notificationSettings,
+      organizations: memberships.map((m) => ({
+        name: m.organization.name,
+        role: m.role,
+      })),
+    } satisfies DownloadMyDataResult;
+  });
