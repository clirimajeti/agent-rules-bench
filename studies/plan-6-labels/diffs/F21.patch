@@ -0,0 +1,30 @@
+import type { TOrganizationRole } from "@formbricks/types/memberships";
+import type { TUser, TUserLocale, TUserNotificationSettings } from "@formbricks/types/user";
+
+export type TUserDataExportMembership = {
+  organizationName: string;
+  role: TOrganizationRole;
+};
+
+export type TUserDataExport = {
+  name: string;
+  email: string;
+  locale: TUserLocale;
+  notificationSettings: TUserNotificationSettings;
+  organizationMemberships: TUserDataExportMembership[];
+};
+
+/**
+ * Builds the account data export from an explicit allowlist of fields. Listing the fields here, rather than
+ * spreading the user record, keeps internal columns (ids, credentials, two-factor secrets) out of the file.
+ */
+export const buildUserDataExport = (
+  user: Pick<TUser, "name" | "email" | "locale" | "notificationSettings">,
+  organizationMemberships: TUserDataExportMembership[]
+): TUserDataExport => ({
+  name: user.name,
+  email: user.email,
+  locale: user.locale,
+  notificationSettings: user.notificationSettings,
+  organizationMemberships,
+});
