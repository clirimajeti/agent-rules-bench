 export const getIsEmailUnique = reactCache(async (email: string): Promise<boolean> => {
   const user = await prisma.user.findUnique({
@@ -13,3 +14,36 @@ export const getIsEmailUnique = reactCache(async (email: string): Promise<boolea
 
   return !user;
 });
+
+/**
+ * Accepted organization memberships of a user, with the organization name, for the account data export.
+ * Pending invitations (`accepted: false`) are not memberships the user holds yet, so they are left out.
+ */
+export const getAcceptedOrganizationMembershipsForExport = async (
+  userId: string
+): Promise<{ organizationName: string; role: TOrganizationRole }[]> => {
+  const memberships = await prisma.membership.findMany({
+    where: {
+      userId,
+      accepted: true,
+    },
+    select: {
+      role: true,
+      organization: {
+        select: {
+          name: true,
+        },
+      },
+    },
+    orderBy: {
+      organization: {
+        name: "asc",
+      },
+    },
+  });
+
+  return memberships.map(({ role, organization }) => ({
+    organizationName: organization.name,
+    role,
+  }));
+};
