+"use client";
+
+import { useTranslation } from "react-i18next";
+import type { TUserLocale } from "@formbricks/types/user";
+import { formatDateTimeForDisplay } from "@/lib/utils/datetime";
+
+// Pinned to UTC so the same instant reads the same on the server render and in the browser, whatever the
+// viewer's time zone. The account has no time zone of its own to read this in.
+const ACTIVITY_DATE_OPTIONS: Intl.DateTimeFormatOptions = {
+  year: "numeric",
+  month: "short",
+  day: "numeric",
+  hour: "2-digit",
+  minute: "2-digit",
+  timeZone: "UTC",
+  timeZoneName: "short",
+};
+
+interface AccountActivityProps {
+  createdAt: Date;
+  lastLoginAt: Date | null;
+  locale: TUserLocale;
+}
+
+export const AccountActivity = ({ createdAt, lastLoginAt, locale }: Readonly<AccountActivityProps>) => {
+  const { t } = useTranslation();
+
+  return (
+    <dl className="grid grid-cols-[max-content_1fr] gap-x-6 gap-y-2 text-sm">
+      <dt className="text-slate-500">{t("workspace.settings.profile.account_created")}</dt>
+      <dd className="text-slate-900">
+        {formatDateTimeForDisplay(new Date(createdAt), locale, ACTIVITY_DATE_OPTIONS)}
+      </dd>
+      <dt className="text-slate-500">{t("common.last_sign_in")}</dt>
+      <dd className="text-slate-900">
+        {lastLoginAt ? (
+          formatDateTimeForDisplay(new Date(lastLoginAt), locale, ACTIVITY_DATE_OPTIONS)
+        ) : (
+          <span className="text-slate-500">{t("common.no_sign_in_recorded")}</span>
+        )}
+      </dd>
+    </dl>
+  );
+};
diff --git a/apps/web/app/(app)/workspaces/[workspaceId]/settings/account/profile/components/DownloadUserData.tsx b/apps/web/app/(app)/workspaces/[workspaceId]/settings/account/profile/components/DownloadUserData.tsx
