@@ -0,0 +1,41 @@
+"use client";
+
+import { useTranslation } from "react-i18next";
+import { Button } from "@/modules/ui/components/button";
+import type { TUserDataExport } from "@/app/(app)/workspaces/[workspaceId]/settings/account/profile/lib/user-data-export";
+
+const downloadJsonFile = (data: unknown, fileName: string) => {
+  const url = URL.createObjectURL(
+    new Blob([JSON.stringify(data, null, 2)], { type: "application/json;charset=utf-8" })
+  );
+  const link = document.createElement("a");
+  link.href = url;
+  link.download = fileName;
+  document.body.appendChild(link);
+  link.click();
+  link.remove();
+  // Safari starts the download after the click returns, so the URL is released on the next task.
+  setTimeout(() => URL.revokeObjectURL(url), 0);
+};
+
+interface DownloadUserDataProps {
+  data: TUserDataExport;
+}
+
+export const DownloadUserData = ({ data }: Readonly<DownloadUserDataProps>) => {
+  const { t } = useTranslation();
+
+  const handleDownload = () => {
+    const date = new Date().toISOString().slice(0, 10);
+    downloadJsonFile(data, `formbricks-my-data-${date}.json`);
+  };
+
+  return (
+    <div>
+      <p className="text-sm text-slate-700">{t("workspace.settings.profile.download_my_data_description")}</p>
+      <Button className="mt-4" variant="secondary" size="sm" onClick={handleDownload}>
+        {t("workspace.settings.profile.download_my_data")}
+      </Button>
+    </div>
+  );
+};
diff --git a/apps/web/app/(app)/workspaces/[workspaceId]/settings/account/profile/lib/user-data-export.ts b/apps/web/app/(app)/workspaces/[workspaceId]/settings/account/profile/lib/user-data-export.ts
