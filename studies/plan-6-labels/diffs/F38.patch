+/**
+ * Deletes every tag of the workspace that is on no response. One `deleteMany` with a `none` filter, so
+ * the check and the delete are a single statement. "Unused" is judged on all responses, not only the ones
+ * the caller may see: a tag that is on a response in a restricted survey is in use.
+ */
+export const deleteUnusedTags = async (
+  workspaceId: string
+): Promise<Result<{ count: number }, { code: TagError; message: string }>> => {
+  validateInputs([workspaceId, ZId]);
+
+  try {
+    const { count } = await prisma.tag.deleteMany({
+      where: { workspaceId, responses: { none: {} } },
+    });
+
+    return ok({ count });
+  } catch (error) {
+    return err({
+      code: TagError.UNEXPECTED_ERROR,
+      message: error instanceof Error ? error.message : "Unknown error occurred",
+    });
+  }
+};
