@@ -0,0 +1,42 @@
+import { Download } from 'lucide-react';
+
+import { Button } from '@/components/ui/button';
+import { Input } from '@/components/ui/form';
+
+type UsersToolbarProps = {
+  search: string;
+  onSearchChange: (search: string) => void;
+  onExport: () => void;
+  canExport: boolean;
+};
+
+export const UsersToolbar = ({
+  search,
+  onSearchChange,
+  onExport,
+  canExport,
+}: UsersToolbarProps) => {
+  return (
+    <div className="mb-4 flex flex-wrap items-end justify-between gap-4">
+      <div className="w-64">
+        <Input
+          label="Search"
+          type="search"
+          placeholder="Name or email"
+          value={search}
+          onChange={(event) => onSearchChange(event.target.value)}
+          registration={{}}
+        />
+      </div>
+      <Button
+        type="button"
+        variant="outline"
+        onClick={onExport}
+        disabled={!canExport}
+        icon={<Download className="size-4" />}
+      >
+        Export CSV
+      </Button>
+    </div>
+  );
+};
diff --git a/apps/react-vite/src/features/users/utils/export-users-csv.ts b/apps/react-vite/src/features/users/utils/export-users-csv.ts
new file mode 100644
index 0000000..0765093
--- /dev/null
+++ b/apps/react-vite/src/features/users/utils/export-users-csv.ts
@@ -0,0 +1,44 @@
+import { User } from '@/types/api';
+import { formatDate } from '@/utils/format';
+
+const CSV_HEADERS = ['Name', 'Email', 'Role', 'Joined'];
+
+// Prefixing with an apostrophe stops spreadsheet apps from evaluating
+// cells that start with a formula character (CSV injection).
+const FORMULA_PREFIX = /^[=+\-@\t\r]/;
+
+const escapeCell = (value: string) => {
+  const safe = FORMULA_PREFIX.test(value) ? `'${value}` : value;
+
+  return /[",\r\n]/.test(safe) ? `"${safe.replace(/"/g, '""')}"` : safe;
+};
+
+export const buildUsersCsv = (users: User[]) => {
+  const rows = users.map((user) =>
+    [
+      `${user.firstName} ${user.lastName}`,
+      user.email,
+      user.role,
+      formatDate(user.createdAt),
+    ]
+      .map(escapeCell)
+      .join(','),
+  );
+
+  return [CSV_HEADERS.join(','), ...rows].join('\r\n');
+};
+
+export const downloadUsersCsv = (users: User[]) => {
+  // The BOM lets Excel detect UTF-8 so non-ASCII names display correctly.
+  const csv = `﻿${buildUsersCsv(users)}`;
+  const blob = new Blob([csv], { type: 'text/csv;charset=utf-8' });
+  const url = URL.createObjectURL(blob);
+
+  const link = document.createElement('a');
+  link.href = url;
+  link.download = 'users.csv';
+  document.body.appendChild(link);
+  link.click();
+  link.remove();
+  URL.revokeObjectURL(url);
+};
diff --git a/apps/react-vite/src/features/users/utils/filter-users.ts b/apps/react-vite/src/features/users/utils/filter-users.ts
new file mode 100644
index 0000000..e2cafdf
--- /dev/null
+++ b/apps/react-vite/src/features/users/utils/filter-users.ts
@@ -0,0 +1,12 @@
+import { User } from '@/types/api';
+
+export const filterUsers = (users: User[], search: string) => {
+  const query = search.trim().toLowerCase();
+
+  if (!query) return users;
+
+  return users.filter((user) => {
+    const fullName = `${user.firstName} ${user.lastName}`.toLowerCase();
+    return fullName.includes(query) || user.email.toLowerCase().includes(query);
+  });
+};
