--- /dev/null
+++ b/apps/react-vite/eslint-rules/gen-lazy-state-initializer.cjs
@@ -0,0 +1,43 @@
+'use strict';
+
+function isUseState(callee) {
+  if (callee.type === 'Identifier') return callee.name === 'useState';
+  return (
+    callee.type === 'MemberExpression' &&
+    !callee.computed &&
+    callee.object.type === 'Identifier' &&
+    callee.object.name === 'React' &&
+    callee.property.name === 'useState'
+  );
+}
+
+module.exports = {
+  meta: {
+    type: 'suggestion',
+    hasSuggestions: true,
+    schema: [],
+    messages: {
+      eager:
+        'useState runs this call on every render. Pass an initializer function instead: `useState(() => {{call}})`.',
+      wrap: 'Wrap the call in an initializer function.',
+    },
+  },
+  create(context) {
+    const sourceCode = context.sourceCode ?? context.getSourceCode();
+    return {
+      CallExpression(node) {
+        if (!isUseState(node.callee)) return;
+        const arg = node.arguments[0];
+        if (!arg || arg.type !== 'CallExpression') return;
+        const text = sourceCode.getText(arg);
+        const call = text.length > 40 ? `${text.slice(0, 37)}...` : text;
+        context.report({
+          node: arg,
+          messageId: 'eager',
+          data: { call },
+          suggest: [{ messageId: 'wrap', fix: (fixer) => fixer.replaceText(arg, `() => ${text}`) }],
+        });
+      },
+    };
+  },
+};
