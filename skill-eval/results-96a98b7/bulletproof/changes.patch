diff --git a/apps/react-vite/eslint-rules/gen-sanitized-inner-html.cjs b/apps/react-vite/eslint-rules/gen-sanitized-inner-html.cjs
new file mode 100644
index 0000000..3dc35f4
--- /dev/null
+++ b/apps/react-vite/eslint-rules/gen-sanitized-inner-html.cjs
@@ -0,0 +1,54 @@
+'use strict';
+
+module.exports = {
+  meta: {
+    type: 'problem',
+    schema: [
+      {
+        type: 'object',
+        properties: { sanitizers: { type: 'array', items: { type: 'string' } } },
+        additionalProperties: false,
+      },
+    ],
+    messages: {
+      unsanitized:
+        'Sanitize HTML before rendering it: `dangerouslySetInnerHTML={{ __html: DOMPurify.sanitize(html) }}`, or render it through the MDPreview component.',
+    },
+  },
+  create(context) {
+    const sanitizers = new Set(context.options[0]?.sanitizers ?? ['sanitize']);
+
+    function isSanitizerCall(node) {
+      if (!node || node.type !== 'CallExpression') return false;
+      const callee = node.callee;
+      if (callee.type === 'Identifier') return sanitizers.has(callee.name);
+      return (
+        callee.type === 'MemberExpression' &&
+        !callee.computed &&
+        callee.property.type === 'Identifier' &&
+        sanitizers.has(callee.property.name)
+      );
+    }
+
+    function isSanitized(value) {
+      if (!value || value.type !== 'JSXExpressionContainer') return false;
+      const obj = value.expression;
+      if (obj.type !== 'ObjectExpression') return false;
+      const html = obj.properties.find(
+        (p) =>
+          p.type === 'Property' &&
+          !p.computed &&
+          ((p.key.type === 'Identifier' && p.key.name === '__html') ||
+            (p.key.type === 'Literal' && p.key.value === '__html')),
+      );
+      return Boolean(html) && isSanitizerCall(html.value);
+    }
+
+    return {
+      JSXAttribute(node) {
+        if (node.name.type !== 'JSXIdentifier' || node.name.name !== 'dangerouslySetInnerHTML') return;
+        if (!isSanitized(node.value)) context.report({ node, messageId: 'unsanitized' });
+      },
+    };
+  },
+};
