diff --git a/apps/react-vite/eslint-rules/gen-lazy-routes.cjs b/apps/react-vite/eslint-rules/gen-lazy-routes.cjs
new file mode 100644
index 0000000..6e92a03
--- /dev/null
+++ b/apps/react-vite/eslint-rules/gen-lazy-routes.cjs
@@ -0,0 +1,70 @@
+'use strict';
+
+const fs = require('node:fs');
+const path = require('node:path');
+
+const roots = new Map();
+function appRoot(file) {
+  const start = path.dirname(file);
+  if (roots.has(start)) return roots.get(start);
+  let dir = start;
+  while (!fs.existsSync(path.join(dir, 'package.json')) && path.dirname(dir) !== dir) {
+    dir = path.dirname(dir);
+  }
+  roots.set(start, dir);
+  return dir;
+}
+
+module.exports = {
+  meta: {
+    type: 'suggestion',
+    schema: [
+      {
+        type: 'object',
+        properties: {
+          routesDir: { type: 'string' },
+          aliases: { type: 'object', additionalProperties: { type: 'string' } },
+        },
+        additionalProperties: false,
+      },
+    ],
+    messages: {
+      eager:
+        "Load route modules lazily so each route is its own chunk: `lazy: () => import('{{source}}').then(convert(queryClient))` instead of a static import.",
+    },
+  },
+  create(context) {
+    const options = context.options[0] ?? {};
+    const routesDir = (options.routesDir ?? 'src/app/routes').replace(/\/$/, '');
+    const aliases = options.aliases ?? { '@/': 'src/' };
+    const filename = context.filename ?? context.getFilename();
+    const root = appRoot(filename);
+
+    function isRoute(spec) {
+      let abs = null;
+      if (spec.startsWith('./') || spec.startsWith('../')) abs = path.resolve(path.dirname(filename), spec);
+      const alias = Object.keys(aliases).find((a) => spec.startsWith(a));
+      if (alias) abs = path.join(root, aliases[alias], spec.slice(alias.length));
+      if (!abs) return false;
+      const rel = path.relative(root, abs).split(path.sep).join('/');
+      return rel === routesDir || rel.startsWith(`${routesDir}/`);
+    }
+
+    function check(node, source, typeOnly) {
+      if (typeOnly || !source || typeof source.value !== 'string') return;
+      if (isRoute(source.value)) context.report({ node: source, messageId: 'eager', data: { source: source.value } });
+    }
+
+    return {
+      ImportDeclaration: (node) =>
+        check(
+          node,
+          node.source,
+          node.importKind === 'type' ||
+            (node.specifiers.length > 0 && node.specifiers.every((s) => s.importKind === 'type')),
+        ),
+      ExportNamedDeclaration: (node) => check(node, node.source, node.exportKind === 'type'),
+      ExportAllDeclaration: (node) => check(node, node.source, node.exportKind === 'type'),
+    };
+  },
+};
