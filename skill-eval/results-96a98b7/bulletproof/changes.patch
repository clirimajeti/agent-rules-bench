diff --git a/apps/react-vite/eslint-rules/gen-no-nested-render-functions.cjs b/apps/react-vite/eslint-rules/gen-no-nested-render-functions.cjs
new file mode 100644
index 0000000..66ef1b4
--- /dev/null
+++ b/apps/react-vite/eslint-rules/gen-no-nested-render-functions.cjs
@@ -0,0 +1,45 @@
+'use strict';
+
+const RENDER_NAME = /^render[A-Z0-9_]/;
+
+function functionName(node) {
+  if (node.id) return node.id.name;
+  const parent = node.parent;
+  if (parent.type === 'VariableDeclarator' && parent.id.type === 'Identifier') return parent.id.name;
+  return null;
+}
+
+module.exports = {
+  meta: {
+    type: 'suggestion',
+    schema: [],
+    messages: {
+      nested:
+        "Extract '{{name}}' into its own component (e.g. `<{{component}} />`) instead of a render function inside another component.",
+    },
+  },
+  create(context) {
+    const stack = [];
+
+    return {
+      ':function'(node) {
+        stack.push({ node, name: functionName(node), nested: stack.length > 0, hasJsx: false });
+      },
+      ':function:exit'() {
+        const frame = stack.pop();
+        if (frame.hasJsx && stack.length > 0) stack[stack.length - 1].hasJsx = true;
+        if (frame.nested && frame.hasJsx && frame.name && RENDER_NAME.test(frame.name)) {
+          const component = frame.name.slice('render'.length).replace(/^_+/, '') || 'Component';
+          context.report({
+            node: frame.node.id ?? frame.node.parent.id ?? frame.node,
+            messageId: 'nested',
+            data: { name: frame.name, component },
+          });
+        }
+      },
+      'JSXElement, JSXFragment'() {
+        if (stack.length > 0) stack[stack.length - 1].hasJsx = true;
+      },
+    };
+  },
+};
