diff --git a/apps/react-vite/eslint-rules/gen-no-http-mocking.cjs b/apps/react-vite/eslint-rules/gen-no-http-mocking.cjs
new file mode 100644
index 0000000..b33399e
--- /dev/null
+++ b/apps/react-vite/eslint-rules/gen-no-http-mocking.cjs
@@ -0,0 +1,120 @@
+'use strict';
+
+const fs = require('node:fs');
+const path = require('node:path');
+
+const roots = new Map();
+function appRoot(file) {
+  const start = path.dirname(file);
+  if (roots.has(start)) return roots.get(start);
+  let dir = start;
+  while (!fs.existsSync(path.join(dir, 'package.json')) && path.dirname(dir) !== dir) {
+    dir = path.dirname(dir);
+  }
+  roots.set(start, dir);
+  return dir;
+}
+
+const TEST_OBJECTS = new Set(['vi', 'jest']);
+const MOCK_METHODS = new Set(['mock', 'doMock']);
+const GLOBAL_OBJECTS = new Set(['window', 'globalThis', 'global', 'self']);
+const HTTP_GLOBALS = new Set(['fetch', 'XMLHttpRequest']);
+
+const memberName = (node) =>
+  node.computed ? node.property.type === 'Literal' && node.property.value : node.property.name;
+
+function testCall(callee) {
+  if (
+    callee.type === 'MemberExpression' &&
+    callee.object.type === 'Identifier' &&
+    TEST_OBJECTS.has(callee.object.name)
+  ) {
+    return memberName(callee);
+  }
+  return null;
+}
+
+module.exports = {
+  meta: {
+    type: 'suggestion',
+    schema: [
+      {
+        type: 'object',
+        properties: {
+          modules: { type: 'array', items: { type: 'string' } },
+          aliases: { type: 'object', additionalProperties: { type: 'string' } },
+        },
+        additionalProperties: false,
+      },
+    ],
+    messages: {
+      mockModule:
+        "Do not mock '{{source}}'. Let the request go through the real API client and answer it with an MSW handler (src/testing/mocks/handlers).",
+      mockGlobal:
+        "Do not stub '{{name}}'. Let the request go through the real API client and answer it with an MSW handler (src/testing/mocks/handlers).",
+    },
+  },
+  create(context) {
+    const options = context.options[0] ?? {};
+    const modules = options.modules ?? ['axios', 'src/lib/api-client'];
+    const aliases = options.aliases ?? { '@/': 'src/' };
+    const filename = context.filename ?? context.getFilename();
+    const root = appRoot(filename);
+    const clientNames = new Set();
+
+    function moduleKey(spec) {
+      let abs = null;
+      if (spec.startsWith('./') || spec.startsWith('../')) abs = path.resolve(path.dirname(filename), spec);
+      const alias = Object.keys(aliases).find((a) => spec.startsWith(a));
+      if (alias) abs = path.join(root, aliases[alias], spec.slice(alias.length));
+      if (!abs) return spec;
+      return path.relative(root, abs).split(path.sep).join('/').replace(/\.(tsx?|jsx?)$/, '');
+    }
+
+    const isHttpModule = (spec) => {
+      const key = moduleKey(spec);
+      return modules.some((m) => key === m || key.startsWith(`${m}/`));
+    };
+
+    const isGlobalHttp = (node) =>
+      node.type === 'MemberExpression' &&
+      node.object.type === 'Identifier' &&
+      GLOBAL_OBJECTS.has(node.object.name) &&
+      HTTP_GLOBALS.has(memberName(node));
+
+    return {
+      ImportDeclaration(node) {
+        if (typeof node.source.value === 'string' && isHttpModule(node.source.value)) {
+          for (const spec of node.specifiers) clientNames.add(spec.local.name);
+        }
+      },
+      CallExpression(node) {
+        const method = testCall(node.callee);
+        if (!method) return;
+        const [first, second] = node.arguments;
+        if (MOCK_METHODS.has(method) && first?.type === 'Literal' && typeof first.value === 'string') {
+          if (isHttpModule(first.value)) {
+            context.report({ node: first, messageId: 'mockModule', data: { source: first.value } });
+          }
+          return;
+        }
+        if (method === 'stubGlobal' && first?.type === 'Literal' && HTTP_GLOBALS.has(first.value)) {
+          context.report({ node: first, messageId: 'mockGlobal', data: { name: first.value } });
+          return;
+        }
+        if (method === 'spyOn' && first?.type === 'Identifier') {
+          if (GLOBAL_OBJECTS.has(first.name) && second?.type === 'Literal' && HTTP_GLOBALS.has(second.value)) {
+            context.report({ node, messageId: 'mockGlobal', data: { name: second.value } });
+          } else if (clientNames.has(first.name)) {
+            context.report({ node, messageId: 'mockGlobal', data: { name: first.name } });
+          }
+        }
+      },
+      AssignmentExpression(node) {
+        if (isGlobalHttp(node.left)) {
+          context.report({ node, messageId: 'mockGlobal', data: { name: memberName(node.left) } });
+        }
+      },
+    };
+  },
+};
