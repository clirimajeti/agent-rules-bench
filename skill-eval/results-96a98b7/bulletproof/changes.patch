diff --git a/apps/react-vite/eslint-rules/gen-no-feature-barrel.cjs b/apps/react-vite/eslint-rules/gen-no-feature-barrel.cjs
new file mode 100644
index 0000000..b8b190b
--- /dev/null
+++ b/apps/react-vite/eslint-rules/gen-no-feature-barrel.cjs
@@ -0,0 +1,88 @@
+'use strict';
+
+const fs = require('node:fs');
+const path = require('node:path');
+
+const roots = new Map();
+function appRoot(file) {
+  const start = path.dirname(file);
+  if (roots.has(start)) return roots.get(start);
+  let dir = start;
+  while (!fs.existsSync(path.join(dir, 'package.json')) && path.dirname(dir) !== dir) {
+    dir = path.dirname(dir);
+  }
+  roots.set(start, dir);
+  return dir;
+}
+
+const INDEX_FILE = /(^|\/)index\.[cm]?[jt]sx?$/;
+
+module.exports = {
+  meta: {
+    type: 'suggestion',
+    schema: [
+      {
+        type: 'object',
+        properties: {
+          featuresDir: { type: 'string' },
+          aliases: { type: 'object', additionalProperties: { type: 'string' } },
+        },
+        additionalProperties: false,
+      },
+    ],
+    messages: {
+      barrelFile:
+        'Do not add barrel (index) files inside features: they break Vite tree shaking. Export from the file that defines the code and import that file directly.',
+      barrelImport:
+        "Import the file directly (e.g. '@/features/discussions/api/get-discussions'), not the folder '{{source}}': feature barrels break Vite tree shaking.",
+    },
+  },
+  create(context) {
+    const options = context.options[0] ?? {};
+    const featuresDir = (options.featuresDir ?? 'src/features').replace(/\/$/, '');
+    const aliases = options.aliases ?? { '@/': 'src/' };
+    const filename = context.filename ?? context.getFilename();
+    const root = appRoot(filename);
+    const toRel = (abs) => path.relative(root, abs).split(path.sep).join('/');
+
+    function resolve(spec) {
+      if (spec.startsWith('./') || spec.startsWith('../')) return path.resolve(path.dirname(filename), spec);
+      const alias = Object.keys(aliases).find((a) => spec.startsWith(a));
+      return alias ? path.join(root, aliases[alias], spec.slice(alias.length)) : null;
+    }
+
+    function isDirectory(abs) {
+      try {
+        return fs.statSync(abs).isDirectory();
+      } catch {
+        return false;
+      }
+    }
+
+    function checkSource(source) {
+      if (!source || source.type !== 'Literal' || typeof source.value !== 'string') return;
+      const abs = resolve(source.value);
+      if (!abs) return;
+      const rel = toRel(abs);
+      if (!rel.startsWith(`${featuresDir}/`)) return;
+      if (INDEX_FILE.test(rel) || /(^|\/)index$/.test(rel) || isDirectory(abs)) {
+        context.report({ node: source, messageId: 'barrelImport', data: { source: source.value } });
+      }
+    }
+
+    return {
+      Program(node) {
+        const rel = toRel(filename);
+        if (rel.startsWith(`${featuresDir}/`) && INDEX_FILE.test(rel)) {
+          context.report({ node, loc: { line: 1, column: 0 }, messageId: 'barrelFile' });
+        }
+      },
+      ImportDeclaration: (node) => checkSource(node.source),
+      ImportExpression: (node) => checkSource(node.source),
+      ExportNamedDeclaration: (node) => checkSource(node.source),
+      ExportAllDeclaration: (node) => checkSource(node.source),
+      'CallExpression[callee.type="Identifier"][callee.name="require"]': (node) =>
+        checkSource(node.arguments[0]),
+    };
+  },
+};
