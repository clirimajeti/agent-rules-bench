diff --git a/apps/react-vite/eslint-rules/gen-api-calls-in-api-folder.cjs b/apps/react-vite/eslint-rules/gen-api-calls-in-api-folder.cjs
new file mode 100644
index 0000000..b9a8fbd
--- /dev/null
+++ b/apps/react-vite/eslint-rules/gen-api-calls-in-api-folder.cjs
@@ -0,0 +1,110 @@
+'use strict';
+
+const fs = require('node:fs');
+const path = require('node:path');
+
+const DEFAULT_HOOKS = [
+  'useQuery',
+  'useQueries',
+  'useInfiniteQuery',
+  'useSuspenseQuery',
+  'useSuspenseQueries',
+  'useSuspenseInfiniteQuery',
+  'useMutation',
+];
+
+const roots = new Map();
+function appRoot(file) {
+  const start = path.dirname(file);
+  if (roots.has(start)) return roots.get(start);
+  let dir = start;
+  while (!fs.existsSync(path.join(dir, 'package.json')) && path.dirname(dir) !== dir) {
+    dir = path.dirname(dir);
+  }
+  roots.set(start, dir);
+  return dir;
+}
+
+function resolveToAppPath(spec, file, aliases) {
+  const root = appRoot(file);
+  let abs = null;
+  if (spec.startsWith('./') || spec.startsWith('../')) {
+    abs = path.resolve(path.dirname(file), spec);
+  } else {
+    const alias = Object.keys(aliases).find((a) => spec.startsWith(a));
+    if (alias) abs = path.join(root, aliases[alias], spec.slice(alias.length));
+  }
+  if (!abs) return null;
+  return path
+    .relative(root, abs)
+    .split(path.sep)
+    .join('/')
+    .replace(/\.(tsx?|jsx?)$/, '');
+}
+
+module.exports = {
+  meta: {
+    type: 'suggestion',
+    schema: [
+      {
+        type: 'object',
+        properties: {
+          clientModule: { type: 'string' },
+          aliases: { type: 'object', additionalProperties: { type: 'string' } },
+          hooks: { type: 'array', items: { type: 'string' } },
+        },
+        additionalProperties: false,
+      },
+    ],
+    messages: {
+      client:
+        "Import the API client only in a feature's api/ folder. Declare the request (fetcher + query/mutation hook) in src/features/<feature>/api/ and import the hook here.",
+      hook:
+        "Call '{{name}}' only in a feature's api/ folder. Wrap it in a hook in src/features/<feature>/api/ next to its fetcher, and import that hook here.",
+    },
+  },
+  create(context) {
+    const options = context.options[0] ?? {};
+    const clientModule = options.clientModule ?? 'src/lib/api-client';
+    const aliases = options.aliases ?? { '@/': 'src/' };
+    const hooks = new Set(options.hooks ?? DEFAULT_HOOKS);
+    const filename = context.filename ?? context.getFilename();
+
+    function isClient(source) {
+      return (
+        source &&
+        source.type === 'Literal' &&
+        typeof source.value === 'string' &&
+        resolveToAppPath(source.value, filename, aliases) === clientModule
+      );
+    }
+
+    function checkSource(source) {
+      if (isClient(source)) context.report({ node: source, messageId: 'client' });
+    }
+
+    return {
+      ImportDeclaration(node) {
+        if (node.importKind === 'type') return;
+        if (node.source.value === '@tanstack/react-query') {
+          for (const spec of node.specifiers) {
+            if (
+              spec.type === 'ImportSpecifier' &&
+              spec.importKind !== 'type' &&
+              hooks.has(spec.imported.name)
+            ) {
+              context.report({ node: spec, messageId: 'hook', data: { name: spec.imported.name } });
+            }
+          }
+          return;
+        }
+        checkSource(node.source);
+      },
+      ImportExpression: (node) => checkSource(node.source),
+      ExportNamedDeclaration: (node) => checkSource(node.source),
+      ExportAllDeclaration: (node) => checkSource(node.source),
+      'CallExpression[callee.type="Identifier"][callee.name="require"]': (node) =>
+        checkSource(node.arguments[0]),
+    };
+  },
+};
