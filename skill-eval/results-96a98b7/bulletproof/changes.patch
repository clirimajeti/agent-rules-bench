diff --git a/apps/react-vite/eslint-rules/gen-absolute-imports.cjs b/apps/react-vite/eslint-rules/gen-absolute-imports.cjs
new file mode 100644
index 0000000..f5b7355
--- /dev/null
+++ b/apps/react-vite/eslint-rules/gen-absolute-imports.cjs
@@ -0,0 +1,88 @@
+'use strict';
+
+const fs = require('node:fs');
+const path = require('node:path');
+
+const roots = new Map();
+function appRoot(file) {
+  const start = path.dirname(file);
+  if (roots.has(start)) return roots.get(start);
+  let dir = start;
+  while (!fs.existsSync(path.join(dir, 'package.json')) && path.dirname(dir) !== dir) {
+    dir = path.dirname(dir);
+  }
+  roots.set(start, dir);
+  return dir;
+}
+
+const MOCK_CALLEES = new Set(['mock', 'doMock', 'unmock', 'importActual', 'importMock']);
+
+module.exports = {
+  meta: {
+    type: 'suggestion',
+    hasSuggestions: true,
+    schema: [
+      {
+        type: 'object',
+        properties: {
+          alias: { type: 'string' },
+          root: { type: 'string' },
+        },
+        additionalProperties: false,
+      },
+    ],
+    messages: {
+      parent:
+        "Use the absolute '{{alias}}' import instead of the parent-relative '{{source}}', so the import survives moving the file.",
+      useAlias: "Replace with '{{fixed}}'.",
+    },
+  },
+  create(context) {
+    const options = context.options[0] ?? {};
+    const alias = options.alias ?? '@/';
+    const srcRoot = (options.root ?? 'src').replace(/\/$/, '');
+    const filename = context.filename ?? context.getFilename();
+    const srcAbs = path.join(appRoot(filename), srcRoot);
+
+    function check(source) {
+      if (!source || source.type !== 'Literal' || typeof source.value !== 'string') return;
+      if (!source.value.startsWith('../')) return;
+      const target = path.resolve(path.dirname(filename), source.value);
+      const inSrc = path.relative(srcAbs, target);
+      const suggest = [];
+      if (inSrc && !inSrc.startsWith('..') && !path.isAbsolute(inSrc)) {
+        const fixed = alias + inSrc.split(path.sep).join('/');
+        const quote = source.raw[0];
+        suggest.push({
+          messageId: 'useAlias',
+          data: { fixed },
+          fix: (fixer) => fixer.replaceText(source, quote + fixed + quote),
+        });
+      }
+      context.report({
+        node: source,
+        messageId: 'parent',
+        data: { alias, source: source.value },
+        suggest,
+      });
+    }
+
+    return {
+      ImportDeclaration: (node) => check(node.source),
+      ImportExpression: (node) => check(node.source),
+      ExportNamedDeclaration: (node) => check(node.source),
+      ExportAllDeclaration: (node) => check(node.source),
+      CallExpression(node) {
+        const callee = node.callee;
+        const isRequire = callee.type === 'Identifier' && callee.name === 'require';
+        const isMock =
+          callee.type === 'MemberExpression' &&
+          callee.object.type === 'Identifier' &&
+          (callee.object.name === 'vi' || callee.object.name === 'jest') &&
+          callee.property.type === 'Identifier' &&
+          MOCK_CALLEES.has(callee.property.name);
+        if (isRequire || isMock) check(node.arguments[0]);
+      },
+    };
+  },
+};
