diff --git a/apps/react-vite/eslint-rules/gen-query-key-from-options.cjs b/apps/react-vite/eslint-rules/gen-query-key-from-options.cjs
new file mode 100644
index 0000000..5bdefc7
--- /dev/null
+++ b/apps/react-vite/eslint-rules/gen-query-key-from-options.cjs
@@ -0,0 +1,74 @@
+'use strict';
+
+const DEFAULT_FACTORIES = ['queryOptions', 'infiniteQueryOptions'];
+const DEFAULT_KEY_METHODS = ['getQueryData', 'setQueryData', 'getQueryState'];
+
+function calleeName(callee) {
+  if (callee.type === 'Identifier') return callee.name;
+  if (callee.type === 'MemberExpression' && !callee.computed && callee.property.type === 'Identifier') {
+    return callee.property.name;
+  }
+  return null;
+}
+
+// an array literal, possibly behind `cond ? [...] : [...]` or `a ?? [...]`
+function literalArray(node) {
+  if (!node) return null;
+  if (node.type === 'ArrayExpression') return node;
+  if (node.type === 'ConditionalExpression') return literalArray(node.consequent) ?? literalArray(node.alternate);
+  if (node.type === 'LogicalExpression') return literalArray(node.left) ?? literalArray(node.right);
+  if (node.type === 'TSAsExpression' || node.type === 'TSSatisfiesExpression') return literalArray(node.expression);
+  return null;
+}
+
+module.exports = {
+  meta: {
+    type: 'suggestion',
+    schema: [
+      {
+        type: 'object',
+        properties: {
+          factories: { type: 'array', items: { type: 'string' } },
+          keyMethods: { type: 'array', items: { type: 'string' } },
+        },
+        additionalProperties: false,
+      },
+    ],
+    messages: {
+      literalKey:
+        "Take the query key from the feature's query options (e.g. `getUsersQueryOptions().queryKey`). Write literal key arrays only inside queryOptions(...) / infiniteQueryOptions(...).",
+    },
+  },
+  create(context) {
+    const options = context.options[0] ?? {};
+    const factories = new Set(options.factories ?? DEFAULT_FACTORIES);
+    const keyMethods = new Set(options.keyMethods ?? DEFAULT_KEY_METHODS);
+    let factoryDepth = 0;
+
+    const isFactoryCall = (node) => factories.has(calleeName(node.callee));
+
+    return {
+      CallExpression(node) {
+        if (isFactoryCall(node)) {
+          factoryDepth += 1;
+          return;
+        }
+        if (factoryDepth > 0) return;
+        if (keyMethods.has(calleeName(node.callee))) {
+          const array = literalArray(node.arguments[0]);
+          if (array) context.report({ node: array, messageId: 'literalKey' });
+        }
+      },
+      'CallExpression:exit'(node) {
+        if (isFactoryCall(node)) factoryDepth -= 1;
+      },
+      Property(node) {
+        if (factoryDepth > 0 || node.computed) return;
+        const key = node.key.type === 'Identifier' ? node.key.name : node.key.value;
+        if (key !== 'queryKey') return;
+        const array = literalArray(node.value);
+        if (array) context.report({ node: array, messageId: 'literalKey' });
+      },
+    };
+  },
+};
