diff --git a/apps/react-vite/eslint-rules/gen-fetcher-outside-hook.cjs b/apps/react-vite/eslint-rules/gen-fetcher-outside-hook.cjs
new file mode 100644
index 0000000..c17acd3
--- /dev/null
+++ b/apps/react-vite/eslint-rules/gen-fetcher-outside-hook.cjs
@@ -0,0 +1,112 @@
+'use strict';
+
+const fs = require('node:fs');
+const path = require('node:path');
+
+const roots = new Map();
+function appRoot(file) {
+  const start = path.dirname(file);
+  if (roots.has(start)) return roots.get(start);
+  let dir = start;
+  while (!fs.existsSync(path.join(dir, 'package.json')) && path.dirname(dir) !== dir) {
+    dir = path.dirname(dir);
+  }
+  roots.set(start, dir);
+  return dir;
+}
+
+function resolveToAppPath(spec, file, aliases) {
+  const root = appRoot(file);
+  let abs = null;
+  if (spec.startsWith('./') || spec.startsWith('../')) {
+    abs = path.resolve(path.dirname(file), spec);
+  } else {
+    const alias = Object.keys(aliases).find((a) => spec.startsWith(a));
+    if (alias) abs = path.join(root, aliases[alias], spec.slice(alias.length));
+  }
+  if (!abs) return null;
+  return path
+    .relative(root, abs)
+    .split(path.sep)
+    .join('/')
+    .replace(/\.(tsx?|jsx?)$/, '');
+}
+
+const HOOK_NAME = /^use[A-Z0-9]/;
+const INLINE_KEYS = new Set(['queryFn', 'mutationFn']);
+
+function functionName(node) {
+  if (node.id) return node.id.name;
+  const parent = node.parent;
+  if (parent.type === 'VariableDeclarator' && parent.id.type === 'Identifier') return parent.id.name;
+  return null;
+}
+
+function isInlineFn(node) {
+  const parent = node.parent;
+  return (
+    parent.type === 'Property' &&
+    parent.value === node &&
+    !parent.computed &&
+    ((parent.key.type === 'Identifier' && INLINE_KEYS.has(parent.key.name)) ||
+      (parent.key.type === 'Literal' && INLINE_KEYS.has(parent.key.value)))
+  );
+}
+
+module.exports = {
+  meta: {
+    type: 'suggestion',
+    schema: [
+      {
+        type: 'object',
+        properties: {
+          clientModule: { type: 'string' },
+          aliases: { type: 'object', additionalProperties: { type: 'string' } },
+        },
+        additionalProperties: false,
+      },
+    ],
+    messages: {
+      inline:
+        'Keep the API call in an exported fetcher function (e.g. `export const getDiscussions = () => api.get(...)`) and call that fetcher from the hook, queryFn or mutationFn.',
+    },
+  },
+  create(context) {
+    const options = context.options[0] ?? {};
+    const clientModule = options.clientModule ?? 'src/lib/api-client';
+    const aliases = options.aliases ?? { '@/': 'src/' };
+    const filename = context.filename ?? context.getFilename();
+    const clientNames = new Set();
+    // number of enclosing hook / queryFn / mutationFn functions
+    const stack = [];
+    let depth = 0;
+
+    return {
+      ImportDeclaration(node) {
+        if (typeof node.source.value !== 'string') return;
+        if (resolveToAppPath(node.source.value, filename, aliases) !== clientModule) return;
+        for (const spec of node.specifiers) clientNames.add(spec.local.name);
+      },
+      ':function'(node) {
+        const name = functionName(node);
+        const counts = (name !== null && HOOK_NAME.test(name)) || isInlineFn(node);
+        stack.push(counts);
+        if (counts) depth += 1;
+      },
+      ':function:exit'() {
+        if (stack.pop()) depth -= 1;
+      },
+      CallExpression(node) {
+        if (depth === 0) return;
+        const callee = node.callee;
+        if (
+          callee.type === 'MemberExpression' &&
+          callee.object.type === 'Identifier' &&
+          clientNames.has(callee.object.name)
+        ) {
+          context.report({ node, messageId: 'inline' });
+        }
+      },
+    };
+  },
+};
