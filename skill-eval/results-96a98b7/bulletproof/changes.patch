diff --git a/apps/react-vite/eslint-rules/gen-no-raw-http.cjs b/apps/react-vite/eslint-rules/gen-no-raw-http.cjs
new file mode 100644
index 0000000..48ef495
--- /dev/null
+++ b/apps/react-vite/eslint-rules/gen-no-raw-http.cjs
@@ -0,0 +1,84 @@
+'use strict';
+
+const GLOBAL_OBJECTS = new Set(['window', 'globalThis', 'global', 'self']);
+const RAW_GLOBALS = new Set(['fetch', 'XMLHttpRequest']);
+
+module.exports = {
+  meta: {
+    type: 'problem',
+    schema: [
+      {
+        type: 'object',
+        properties: { modules: { type: 'array', items: { type: 'string' } } },
+        additionalProperties: false,
+      },
+    ],
+    messages: {
+      rawModule:
+        "Import '{{name}}' only in the shared API client (src/lib/api-client.ts). Use `api` from '@/lib/api-client' instead.",
+      rawGlobal:
+        "Do not use '{{name}}' directly. HTTP requests go through `api` from '@/lib/api-client', which adds auth, the base URL and error notifications.",
+    },
+  },
+  create(context) {
+    const modules = context.options[0]?.modules ?? ['axios'];
+    const sourceCode = context.sourceCode ?? context.getSourceCode();
+    const isRawModule = (value) =>
+      typeof value === 'string' &&
+      modules.some((m) => value === m || value.startsWith(`${m}/`));
+
+    function checkSource(source) {
+      if (source && source.type === 'Literal' && isRawModule(source.value)) {
+        context.report({ node: source, messageId: 'rawModule', data: { name: source.value } });
+      }
+    }
+
+    function isGlobalReference(node) {
+      let scope = sourceCode.getScope ? sourceCode.getScope(node) : context.getScope();
+      while (scope) {
+        const variable = scope.set.get(node.name);
+        if (variable) return variable.defs.length === 0;
+        scope = scope.upper;
+      }
+      return true;
+    }
+
+    function rawGlobalName(node) {
+      if (node.type === 'Identifier' && RAW_GLOBALS.has(node.name) && isGlobalReference(node)) {
+        return node.name;
+      }
+      if (
+        node.type === 'MemberExpression' &&
+        node.object.type === 'Identifier' &&
+        GLOBAL_OBJECTS.has(node.object.name) &&
+        isGlobalReference(node.object)
+      ) {
+        const name = node.computed
+          ? node.property.type === 'Literal' && node.property.value
+          : node.property.name;
+        if (RAW_GLOBALS.has(name)) return name;
+      }
+      return null;
+    }
+
+    function checkCallee(node) {
+      const name = rawGlobalName(node.callee);
+      if (name) context.report({ node: node.callee, messageId: 'rawGlobal', data: { name } });
+    }
+
+    return {
+      ImportDeclaration: (node) => checkSource(node.source),
+      ImportExpression: (node) => checkSource(node.source),
+      ExportNamedDeclaration: (node) => checkSource(node.source),
+      ExportAllDeclaration: (node) => checkSource(node.source),
+      CallExpression(node) {
+        if (node.callee.type === 'Identifier' && node.callee.name === 'require') {
+          checkSource(node.arguments[0]);
+          return;
+        }
+        checkCallee(node);
+      },
+      NewExpression: checkCallee,
+    };
+  },
+};
