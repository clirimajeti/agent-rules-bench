new file mode 100644
index 0000000..4399386
--- /dev/null
+++ b/apps/react-vite/eslint-rules/gen-ui-wrappers.cjs
@@ -0,0 +1,106 @@
+'use strict';
+
+const fs = require('node:fs');
+const path = require('node:path');
+
+const roots = new Map();
+function appRoot(file) {
+  const start = path.dirname(file);
+  if (roots.has(start)) return roots.get(start);
+  let dir = start;
+  while (!fs.existsSync(path.join(dir, 'package.json')) && path.dirname(dir) !== dir) {
+    dir = path.dirname(dir);
+  }
+  roots.set(start, dir);
+  return dir;
+}
+
+// 'pkg' matches 'pkg' and 'pkg/sub'; '@scope/*' matches every package of the scope
+function moduleMatches(pattern, value) {
+  if (pattern.endsWith('/*')) return value.startsWith(pattern.slice(0, -1));
+  return value === pattern || value.startsWith(`${pattern}/`);
+}
+
+module.exports = {
+  meta: {
+    type: 'suggestion',
+    schema: [
+      {
+        type: 'object',
+        properties: {
+          wrappers: {
+            type: 'array',
+            items: {
+              type: 'object',
+              properties: {
+                modules: { type: 'array', items: { type: 'string' }, minItems: 1 },
+                importNames: { type: 'array', items: { type: 'string' } },
+                allowIn: { type: 'string' },
+                wrapper: { type: 'string' },
+              },
+              required: ['modules', 'allowIn', 'wrapper'],
+              additionalProperties: false,
+            },
+          },
+        },
+        required: ['wrappers'],
+        additionalProperties: false,
+      },
+    ],
+    messages: {
+      wrapped:
+        "Import {{what}} from '{{source}}' only inside {{allowIn}}. Use the project's wrapper from '{{wrapper}}' instead, or add what you need to it.",
+    },
+  },
+  create(context) {
+    const wrappers = context.options[0]?.wrappers ?? [];
+    const filename = context.filename ?? context.getFilename();
+    const rel = path.relative(appRoot(filename), filename).split(path.sep).join('/');
+    const active = wrappers.filter((w) => !rel.startsWith(w.allowIn));
+    if (active.length === 0) return {};
+
+    function report(node, source, wrapper, what) {
+      context.report({
+        node,
+        messageId: 'wrapped',
+        data: { what, source, allowIn: wrapper.allowIn, wrapper: wrapper.wrapper },
+      });
+    }
+
+    function check(node, source, specifiers, isTypeOnly) {
+      if (!source || source.type !== 'Literal' || typeof source.value !== 'string') return;
+      if (isTypeOnly) return;
+      for (const wrapper of active) {
+        if (!wrapper.modules.some((m) => moduleMatches(m, source.value))) continue;
+        if (!wrapper.importNames) {
+          report(source, source.value, wrapper, 'anything');
+          continue;
+        }
+        for (const spec of specifiers ?? []) {
+          const imported = spec.type === 'ImportSpecifier' ? spec.imported : spec.local;
+          if (spec.type !== 'ImportSpecifier' && spec.type !== 'ExportSpecifier') continue;
+          if (spec.importKind === 'type' || spec.exportKind === 'type') continue;
+          const name = imported.name ?? imported.value;
+          if (wrapper.importNames.includes(name)) report(spec, source.value, wrapper, `'${name}'`);
+        }
+      }
+    }
+
+    return {
+      ImportDeclaration: (node) =>
+        check(
+          node,
+          node.source,
+          node.specifiers,
+          node.importKind === 'type' ||
+            (node.specifiers.length > 0 && node.specifiers.every((s) => s.importKind === 'type')),
+        ),
+      ExportNamedDeclaration: (node) =>
+        check(node, node.source, node.specifiers, node.exportKind === 'type'),
+      ExportAllDeclaration: (node) => check(node, node.source, null, node.exportKind === 'type'),
+      ImportExpression: (node) => check(node, node.source, null, false),
+      'CallExpression[callee.type="Identifier"][callee.name="require"]': (node) =>
+        check(node, node.arguments[0], null, false),
+    };
+  },
+};
