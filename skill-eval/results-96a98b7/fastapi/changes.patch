+# docs/backend.md "General": keyword-only arguments for functions with more than two parameters, as crud.py does.
+# Layout values: `files`/`ignores`.
+id: gen-keyword-only-params
+language: Python
+severity: error
+message: 'Functions with more than two parameters make them keyword-only with `*`, as crud.py does.'
+note: 'Insert `*` before the parameters: def update_item(*, session: SessionDep, current_user: CurrentUser, id: uuid.UUID, ...).'
+files:
+  - backend/app/**/*.py
+ignores:
+  - backend/app/alembic/**
+utils:
+  param:
+    any:
+      - kind: identifier
+      - kind: typed_parameter
+      - kind: default_parameter
+      - kind: typed_default_parameter
+  positional-param:
+    matches: param
+    not:
+      follows:
+        stopBy: end
+        any:
+          - kind: keyword_separator
+          - kind: list_splat_pattern
+          - kind: dictionary_splat_pattern
+rule:
+  kind: parameters
+  inside: {kind: function_definition}
+  any:
+    - not:
+        has: {nthChild: 1, regex: '^(self|cls)$'}
+      has:
+        matches: positional-param
+        nthChild: {position: 'n+3', ofRule: {matches: param}}
+    - all:
+        - has: {nthChild: 1, regex: '^(self|cls)$'}
+        - has:
+            matches: positional-param
+            nthChild: {position: 'n+4', ofRule: {matches: param}}
