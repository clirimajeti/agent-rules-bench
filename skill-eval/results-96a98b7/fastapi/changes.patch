diff --git a/ast-grep/rules/gen-no-manual-422.yml b/ast-grep/rules/gen-no-manual-422.yml
new file mode 100644
index 0000000..3f824d1
--- /dev/null
+++ b/ast-grep/rules/gen-no-manual-422.yml
@@ -0,0 +1,25 @@
+# docs/api.md "Status codes and errors": validation errors (422) come from FastAPI and Pydantic.
+# Layout values: `files`.
+id: gen-no-manual-422
+language: Python
+severity: error
+message: 'Do not build 422 validation errors by hand; constrain the Pydantic schema instead.'
+note: 'Add the constraint to the request schema in models.py (Field(max_length=...), a validator); use 400 for business-rule violations.'
+files:
+  - backend/app/**/*.py
+rule:
+  any:
+    - kind: keyword_argument
+      all:
+        - has: {field: name, regex: '^status_code$'}
+        - has: {field: value, regex: '^(422|(status\.)?HTTP_422_\w+)$'}
+    - kind: call
+      all:
+        - has: {field: function, regex: '(^|\.)HTTPException$'}
+        - has:
+            field: arguments
+            has:
+              nthChild: 1
+              regex: '^(422|(status\.)?HTTP_422_\w+)$'
+    - kind: call
+      has: {field: function, regex: '(^|\.)(RequestValidationError|ResponseValidationError)$'}
diff --git a/ast-grep/rules/gen-no-raw-sql.yml b/ast-grep/rules/gen-no-raw-sql.yml
new file mode 100644
index 0000000..b1d843c
--- /dev/null
+++ b/ast-grep/rules/gen-no-raw-sql.yml
@@ -0,0 +1,30 @@
+# docs/database.md "Sessions" and "Queries", docs/security.md "Input handling".
+# Layout values: `files`/`ignores`.
+id: gen-no-raw-sql
+language: Python
+severity: error
+message: 'Use select(...) statements with session.exec; no raw SQL strings.'
+note: 'Build the query with sqlmodel `select`, `delete` or `func`, so every value is a bound parameter.'
+files:
+  - backend/app/**/*.py
+ignores:
+  - backend/app/alembic/**
+rule:
+  any:
+    - kind: import_from_statement
+      regex: '(?s)^from\s+(sqlalchemy|sqlmodel)(\.sql)?(\.expression)?\s+import\s[^#]*\btext\b'
+    - kind: call
+      has:
+        field: function
+        regex: '^(sqlalchemy|sa|sqlmodel)\.text$'
+    - kind: call
+      all:
+        - has:
+            field: function
+            regex: '\.(exec|execute)$'
+        - has:
+            field: arguments
+            has:
+              any:
+                - kind: string
+                - kind: concatenated_string
