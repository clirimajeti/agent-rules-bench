diff --git a/ast-grep/rules/gen-crud-imports.yml b/ast-grep/rules/gen-crud-imports.yml
new file mode 100644
index 0000000..4d39efc
--- /dev/null
+++ b/ast-grep/rules/gen-crud-imports.yml
@@ -0,0 +1,19 @@
+# docs/architecture.md "Dependency rules": crud depends on models and core.security only.
+# Layout values: `files` and the allowed module names (models, core.security) in the regexes.
+id: gen-crud-imports
+language: Python
+severity: error
+message: 'crud.py imports only app.models and app.core.security from the application.'
+note: 'Move what crud needs into models.py or core/security.py; crud must not depend on api, utils, core.db or core.config (docs/architecture.md).'
+files:
+  - backend/app/crud.py
+rule:
+  any:
+    - kind: import_statement
+      regex: '\bapp\b'
+      not:
+        regex: '^import\s+app\.(models|core\.security)(\s+as\s+\w+)?\s*$'
+    - kind: import_from_statement
+      regex: '^from\s+(app\b|\.)'
+      not:
+        regex: '(?s)^from\s+((app\.|\.)(models|core\.security)\s+import\b|(app|\.)\s+import\s+\(?\s*models\s*,?\s*\)?\s*$|(app\.|\.)core\s+import\s+\(?\s*security\s*,?\s*\)?\s*$)'
