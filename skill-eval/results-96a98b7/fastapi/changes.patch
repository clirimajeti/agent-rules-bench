diff --git a/ast-grep/rules/gen-core-no-api-imports.yml b/ast-grep/rules/gen-core-no-api-imports.yml
new file mode 100644
index 0000000..3901725
--- /dev/null
+++ b/ast-grep/rules/gen-core-no-api-imports.yml
@@ -0,0 +1,15 @@
+# docs/architecture.md "Dependency rules": core must not import from api.
+# Layout values: `files` and the `app.api` module path in the regexes.
+id: gen-core-no-api-imports
+language: Python
+severity: error
+message: 'app/core must not import from app/api.'
+note: 'Move the shared code into core, models or utils so api depends on core and never the other way round (docs/architecture.md).'
+files:
+  - backend/app/core/**/*.py
+rule:
+  any:
+    - kind: import_statement
+      regex: '\bapp\.api\b'
+    - kind: import_from_statement
+      regex: '^from\s+(app\.api\b|app\s+import\s[^#]*\bapi\b|\.\.api\b|\.\.\s+import\s[^#]*\bapi\b)'
