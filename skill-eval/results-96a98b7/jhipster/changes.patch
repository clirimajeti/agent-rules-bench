diff --git a/eslint-rules/gen-no-hardcoded-template-text.js b/eslint-rules/gen-no-hardcoded-template-text.js
new file mode 100644
index 00000000..8b45085d
--- /dev/null
+++ b/eslint-rules/gen-no-hardcoded-template-text.js
@@ -0,0 +1,46 @@
+const TRANSLATE_ATTRIBUTE = 'jhiTranslate';
+const WORD = /\p{L}{2,}/u;
+const INTERPOLATION = /\{\{[\s\S]*?\}\}/g;
+const EXEMPT_ELEMENTS = new Set(['code', 'pre', 'script', 'style']);
+
+const hasTranslateAttribute = element =>
+  [...(element.attributes ?? []), ...(element.inputs ?? [])].some(attribute => attribute.name === TRANSLATE_ATTRIBUTE);
+
+export default {
+  meta: {
+    type: 'suggestion',
+    schema: [],
+    messages: {
+      hardcoded:
+        'Visible text "{{text}}" needs a translation key in src/main/webapp/i18n/en/*.json, shown with the jhiTranslate directive or the translate pipe.',
+    },
+  },
+  create(context) {
+    // Elements are entered before their text children, so a stack of "is translated or exempt" flags is enough.
+    const stack = [];
+    const covered = () => stack.includes(true);
+
+    const check = (node, text) => {
+      if (covered() || !WORD.test(text)) {
+        return;
+      }
+      context.report({ node, messageId: 'hardcoded', data: { text: text.trim().replace(/\s+/g, ' ').slice(0, 40) } });
+    };
+
+    return {
+      Element(node) {
+        stack.push(hasTranslateAttribute(node) || EXEMPT_ELEMENTS.has(node.name));
+      },
+      'Element:exit'() {
+        stack.pop();
+      },
+      Text(node) {
+        check(node, node.value);
+      },
+      BoundText(node) {
+        const source = node.value?.source ?? '';
+        check(node, source.replace(INTERPOLATION, ' '));
+      },
+    };
+  },
+};
