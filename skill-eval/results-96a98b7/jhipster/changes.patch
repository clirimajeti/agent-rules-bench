diff --git a/ast-grep/rules/gen-admin-resource-preauthorize.yml b/ast-grep/rules/gen-admin-resource-preauthorize.yml
new file mode 100644
index 00000000..de218c26
--- /dev/null
+++ b/ast-grep/rules/gen-admin-resource-preauthorize.yml
@@ -0,0 +1,36 @@
+# Source: docs/security.md "admin resources also carry a method-level check so moving a method does not open it up";
+# "Method-level checks use `@PreAuthorize` on resource methods."
+# Layout: edit `files` and the "/api/admin" regex for another layout.
+id: gen-admin-resource-preauthorize
+language: Java
+severity: error
+message: Endpoints of an /api/admin resource carry @PreAuthorize as well as the URL-level rule.
+note: 'Add `@PreAuthorize("hasAuthority(\"" + AuthoritiesConstants.ADMIN + "\")")`.'
+files:
+  - src/main/java/**/web/rest/**
+rule:
+  kind: method_declaration
+  has:
+    kind: modifiers
+    all:
+      - has:
+          any:
+            - kind: marker_annotation
+            - kind: annotation
+          has:
+            field: name
+            regex: ^(Get|Post|Put|Patch|Delete|Request)Mapping$
+      - not:
+          has:
+            kind: annotation
+            has:
+              field: name
+              regex: ^PreAuthorize$
+  inside:
+    kind: class_declaration
+    stopBy: end
+    has:
+      kind: modifiers
+      has:
+        kind: annotation
+        regex: ^@RequestMapping\(\s*(value\s*=\s*|path\s*=\s*)?\{?\s*"/api/admin
diff --git a/ast-grep/rules/gen-cache-name-constant.yml b/ast-grep/rules/gen-cache-name-constant.yml
new file mode 100644
index 00000000..5d214dac
--- /dev/null
+++ b/ast-grep/rules/gen-cache-name-constant.yml
@@ -0,0 +1,34 @@
+# Source: docs/persistence.md "Repository methods that are cached use a cache name constant from the repository interface (`USERS_BY_LOGIN_CACHE`)."
+id: gen-cache-name-constant
+language: Java
+severity: error
+message: Cached repository methods name their cache with a constant from the repository interface.
+note: 'Declare `String USERS_BY_LOGIN_CACHE = "usersByLogin";` in the repository, use it here and register it in CacheConfiguration.'
+files:
+  - src/main/java/**/repository/**
+utils:
+  literal-name:
+    any:
+      - kind: string_literal
+      - kind: element_value_array_initializer
+        has:
+          kind: string_literal
+rule:
+  kind: annotation
+  has:
+    field: name
+    regex: ^(Cacheable|CachePut|CacheEvict)$
+  all:
+    - has:
+        field: arguments
+        has:
+          any:
+            - matches: literal-name
+            - kind: element_value_pair
+              all:
+                - has:
+                    field: key
+                    regex: ^(cacheNames|value)$
+                - has:
+                    field: value
+                    matches: literal-name
