new file mode 100644
index 00000000..2a191d8f
--- /dev/null
+++ b/eslint-rules/gen-route-authorities-need-guard.js
@@ -0,0 +1,38 @@
+const GUARD = 'userRouteAccessService';
+
+const propertyName = property =>
+  property.type === 'Property' && !property.computed
+    ? property.key.type === 'Identifier'
+      ? property.key.name
+      : property.key.value
+    : undefined;
+
+const findProperty = (object, name) => object.properties.find(property => propertyName(property) === name);
+
+export default {
+  meta: {
+    type: 'problem',
+    schema: [],
+    messages: {
+      missingGuard:
+        'A route with data.authorities needs `canActivate: [userRouteAccessService]`; without the guard the authorities are never checked.',
+    },
+  },
+  create(context) {
+    return {
+      ObjectExpression(node) {
+        const data = findProperty(node, 'data');
+        if (data?.value.type !== 'ObjectExpression' || !findProperty(data.value, 'authorities')) {
+          return;
+        }
+        const canActivate = findProperty(node, 'canActivate');
+        const guarded =
+          canActivate?.value.type === 'ArrayExpression' &&
+          canActivate.value.elements.some(element => element?.type === 'Identifier' && element.name === GUARD);
+        if (!guarded) {
+          context.report({ node: data, messageId: 'missingGuard' });
+        }
+      },
+    };
+  },
+};
