diff --git a/ast-grep/rules/gen-no-log-concatenation.yml b/ast-grep/rules/gen-no-log-concatenation.yml
new file mode 100644
index 00000000..2cca1f4f
--- /dev/null
+++ b/ast-grep/rules/gen-no-log-concatenation.yml
@@ -0,0 +1,28 @@
+# docs/backend.md "Logging": parameterised messages, never string concatenation.
+# Layout values: the `files` glob and the logger-name regex.
+id: gen-no-log-concatenation
+language: Java
+severity: error
+message: 'Use a parameterised log message (`LOG.debug("Request to get User : {}", login)`), not string concatenation.'
+files:
+  - src/main/java/**
+rule:
+  any:
+    - pattern: $L.$M($A + $B)
+    - pattern: $L.$M($A + $B, $$$R)
+  # Joining two string literals (line wrapping) is fine; a value in the message is not.
+  has:
+    field: arguments
+    has:
+      kind: binary_expression
+      has:
+        stopBy: end
+        any:
+          - kind: identifier
+          - kind: method_invocation
+          - kind: field_access
+constraints:
+  L:
+    regex: '^(LOG|LOGGER|log|logger)$'
+  M:
+    regex: '^(trace|debug|info|warn|error)$'
