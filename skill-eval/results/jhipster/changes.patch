@@ -0,0 +1,55 @@
+// docs/frontend.md "Structure": shared holds reusable code without business logic; feature code stays in its folder.
+import path from 'node:path';
+
+const DEFAULTS = { appRoot: 'src/main/webapp/app', alias: 'app/', features: ['entities', 'admin', 'account'] };
+
+export default {
+  meta: {
+    type: 'problem',
+    schema: [
+      {
+        type: 'object',
+        properties: {
+          appRoot: { type: 'string' },
+          alias: { type: 'string' },
+          features: { type: 'array', items: { type: 'string' } },
+        },
+        additionalProperties: false,
+      },
+    ],
+    messages: {
+      featureImport:
+        "shared must not depend on the '{{feature}}' feature; move the code it needs into shared, or keep this code in the feature.",
+    },
+  },
+  create(context) {
+    const options = { ...DEFAULTS, ...context.options[0] };
+    const appRoot = path.resolve(context.cwd, options.appRoot);
+    const fileDir = path.dirname(context.filename);
+
+    const featureOf = specifier => {
+      let target;
+      if (specifier.startsWith('.')) target = path.resolve(fileDir, specifier);
+      else if (specifier.startsWith(options.alias)) target = path.join(appRoot, specifier.slice(options.alias.length));
+      else return undefined;
+      const relative = path.relative(appRoot, target).split(path.sep).join('/');
+      if (relative.startsWith('..')) return undefined;
+      const first = relative.split('/')[0];
+      return options.features.includes(first) ? first : undefined;
+    };
+
+    const check = source => {
+      if (source?.type !== 'Literal' || typeof source.value !== 'string') return;
+      const feature = featureOf(source.value);
+      if (feature) context.report({ node: source, messageId: 'featureImport', data: { feature } });
+    };
+
+    return {
+      ImportDeclaration: node => check(node.source),
+      ImportExpression: node => check(node.source),
+      ExportNamedDeclaration: node => check(node.source),
+      ExportAllDeclaration: node => check(node.source),
+      'CallExpression[callee.name="require"]': node => check(node.arguments[0]),
+    };
+  },
+};
