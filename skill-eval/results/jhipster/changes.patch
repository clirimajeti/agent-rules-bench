diff --git a/eslint-rules/gen-template-translated-text.js b/eslint-rules/gen-template-translated-text.js
new file mode 100644
index 00000000..c75380b3
--- /dev/null
+++ b/eslint-rules/gen-template-translated-text.js
@@ -0,0 +1,44 @@
+// docs/frontend.md "i18n": every visible text has a translation key; never hard-code text.
+const TRANSLATE_ATTRIBUTE = 'jhiTranslate';
+const HAS_WORD = /\p{L}{2,}/u;
+
+export default {
+  meta: {
+    type: 'suggestion',
+    schema: [],
+    messages: {
+      hardCoded:
+        "Hard-coded text '{{text}}': add a key to src/main/webapp/i18n/en/*.json and show it with the jhiTranslate directive or the translate pipe.",
+    },
+  },
+  create(context) {
+    const parserServices = context.sourceCode.parserServices;
+    if (typeof parserServices?.convertNodeSourceSpanToLoc !== 'function') return {};
+
+    // One entry per open element or ng-template: true when it or an ancestor carries jhiTranslate.
+    const translated = [];
+    const isTranslated = node =>
+      (node.attributes ?? []).some(a => a.name === TRANSLATE_ATTRIBUTE) || (node.inputs ?? []).some(i => i.name === TRANSLATE_ATTRIBUTE);
+    const enter = node => translated.push(translated.at(-1) === true || isTranslated(node));
+    const exit = () => translated.pop();
+
+    const report = (node, text) => {
+      if (translated.at(-1) === true || !HAS_WORD.test(text)) return;
+      context.report({
+        loc: parserServices.convertNodeSourceSpanToLoc(node.sourceSpan),
+        messageId: 'hardCoded',
+        data: { text: text.trim().slice(0, 40) },
+      });
+    };
+
+    return {
+      Element: enter,
+      'Element:exit': exit,
+      Template: enter,
+      'Template:exit': exit,
+      Text: node => report(node, node.value),
+      // Text around interpolations: only the literal parts count, `{{ 'key' | translate }}` is fine.
+      BoundText: node => report(node, (node.value?.ast?.strings ?? []).join(' ')),
+    };
+  },
+};
