+  ],
+  invalid: [
+    { filename: 'a.html', code: '<h2>Spring configuration</h2>', errors: [{ messageId: 'hardCoded' }] },
+    { filename: 'a.html', code: '<th scope="col" class="text-end">Count</th><th>Mean</th>', errors: 2 },
+    { filename: 'a.html', code: '<div jhiTranslate="a">ok</div><div>Done</div>', errors: [{ messageId: 'hardCoded' }] },
+    { filename: 'a.html', code: '@if (x) { <span>Expand</span> }', errors: [{ messageId: 'hardCoded' }] },
+    { filename: 'a.html', code: '<ng-template #t><span>Blocked</span></ng-template>', errors: [{ messageId: 'hardCoded' }] },
+    { filename: 'a.html', code: '<p>Hello {{ name }}</p>', errors: [{ messageId: 'hardCoded' }] },
+  ],
+});
