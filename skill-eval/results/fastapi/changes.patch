diff --git a/ast-grep/rules/gen-core-no-api-imports.yml b/ast-grep/rules/gen-core-no-api-imports.yml
new file mode 100644
index 0000000..a277e38
--- /dev/null
+++ b/ast-grep/rules/gen-core-no-api-imports.yml
@@ -0,0 +1,18 @@
+# docs/architecture.md "Dependency rules": core must not import from api.
+id: gen-core-no-api-imports
+language: python
+severity: error
+message: app.core must not import from app.api.
+note: Move what both need into core, models.py or utils.py.
+files:
+  - backend/app/core/**/*.py
+rule:
+  any:
+    - kind: import_statement
+      has: { kind: dotted_name, regex: '^app\.api(\.|$)', stopBy: end }
+    - kind: import_from_statement
+      has: { field: module_name, regex: '^(app\.api|\.\.api)(\.|$)' }
+    - kind: import_from_statement
+      all:
+        - has: { field: module_name, regex: '^(app|\.\.)$' }
+        - has: { kind: dotted_name, regex: '^api$', stopBy: end }
diff --git a/ast-grep/rules/gen-cors-no-wildcard-origin.yml b/ast-grep/rules/gen-cors-no-wildcard-origin.yml
new file mode 100644
index 0000000..ab2dee7
--- /dev/null
+++ b/ast-grep/rules/gen-cors-no-wildcard-origin.yml
@@ -0,0 +1,19 @@
+# docs/security.md "Transport and CORS".
+id: gen-cors-no-wildcard-origin
+language: python
+severity: error
+message: Do not allow every CORS origin.
+note: Origins come from `settings.BACKEND_CORS_ORIGINS` and `settings.FRONTEND_HOST`.
+files:
+  - backend/app/**/*.py
+rule:
+  kind: keyword_argument
+  any:
+    - all:
+        - has: { field: name, regex: '^allow_origins$' }
+        - any:
+            - has: { field: value, kind: string, regex: '^[rbuf]*["'']\*["'']$' }
+            - has: { field: value, has: { kind: string, regex: '^[rbuf]*["'']\*["'']$', stopBy: end } }
+    - all:
+        - has: { field: name, regex: '^allow_origin_regex$' }
+        - has: { field: value, regex: '^[rbuf]*["'']\.\*["'']$' }
diff --git a/ast-grep/rules/gen-count-in-database.yml b/ast-grep/rules/gen-count-in-database.yml
