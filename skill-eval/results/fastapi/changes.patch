diff --git a/ast-grep/rules/gen-crud-dependencies.yml b/ast-grep/rules/gen-crud-dependencies.yml
new file mode 100644
index 0000000..23c43fc
--- /dev/null
+++ b/ast-grep/rules/gen-crud-dependencies.yml
@@ -0,0 +1,19 @@
+# docs/architecture.md "Dependency rules": crud depends on models and core.security only.
+id: gen-crud-dependencies
+language: python
+severity: error
+message: crud may import only from app.models and app.core.security.
+note: Pass anything else in as an argument, or move the shared type into models.py.
+files:
+  - backend/app/crud.py
+rule:
+  any:
+    - kind: import_statement
+      has: { kind: dotted_name, regex: '^app(\.|$)', stopBy: end }
+      not: { regex: '^import\s+app\.(models|core\.security)(\s+as\s+\w+)?$' }
+    - kind: import_from_statement
+      has: { field: module_name, regex: '^(app(\.|$)|\.)' }
+      not:
+        any:
+          - has: { field: module_name, regex: '^(app)?\.(models|core\.security)$' }
+          - regex: '^from\s+(app)?\.core\s+import\s+security(\s+as\s+\w+)?$'
diff --git a/ast-grep/rules/gen-crud-keyword-session.yml b/ast-grep/rules/gen-crud-keyword-session.yml
new file mode 100644
index 0000000..b1ec0aa
--- /dev/null
+++ b/ast-grep/rules/gen-crud-keyword-session.yml
@@ -0,0 +1,13 @@
+# docs/backend.md "CRUD layer". Edit `files` for another layout.
+id: gen-crud-keyword-session
+language: python
+severity: error
+message: CRUD functions take the session as a keyword-only argument.
+note: 'Put `*` first: `def get_user_by_email(*, session: Session, email: str)`.'
+files:
+  - backend/app/crud.py
+rule:
+  any: [{ kind: identifier }, { kind: typed_parameter }, { kind: default_parameter }, { kind: typed_default_parameter }]
+  regex: '^session\b'
+  inside: { kind: parameters }
+  not: { follows: { kind: keyword_separator, stopBy: end } }
diff --git a/ast-grep/rules/gen-http-exception-detail.yml b/ast-grep/rules/gen-http-exception-detail.yml
new file mode 100644
index 0000000..0434a81
--- /dev/null
+++ b/ast-grep/rules/gen-http-exception-detail.yml
@@ -0,0 +1,15 @@
+# docs/api.md "Status codes and errors", docs/backend.md "Errors".
+id: gen-http-exception-detail
+language: python
+severity: error
+message: Raise `HTTPException` with a `detail=` keyword; the frontend shows it in a toast.
+note: Use a short, user-facing text, the same wording as other endpoints for the same situation.
+files:
+  - backend/app/**/*.py
+rule:
+  kind: call
+  has: { field: function, regex: '(^|\.)HTTPException$' }
+  not:
+    has:
+      field: arguments
+      has: { kind: keyword_argument, has: { field: name, regex: '^detail$' } }
diff --git a/ast-grep/rules/gen-jinja-autoescape.yml b/ast-grep/rules/gen-jinja-autoescape.yml
new file mode 100644
index 0000000..451a113
--- /dev/null
+++ b/ast-grep/rules/gen-jinja-autoescape.yml
@@ -0,0 +1,15 @@
+# docs/security.md "Input handling": escape user content in emails.
+id: gen-jinja-autoescape
+language: python
+severity: warning
+message: Jinja templates must escape user content; pass `autoescape=True`.
+note: '`jinja2.Template` and `Environment` do not escape by default. Check that the rendered email still looks right before changing it.'
+files:
+  - backend/app/**/*.py
+rule:
+  kind: call
+  has: { field: function, regex: '^(jinja2\.)?(Template|Environment)$' }
+  not:
+    has:
+      field: arguments
+      has: { kind: keyword_argument, regex: '^autoescape\s*=\s*(?:[^F]|F[^a])' }
