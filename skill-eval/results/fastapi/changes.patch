+# docs/backend.md "General": keyword-only arguments past two parameters, as crud.py does.
+id: gen-keyword-only-params
+language: python
+severity: warning
+message: Make the parameters keyword-only (`*`) when a function has more than two.
+note: 'Example: `def create_item(*, session: Session, item_in: ItemCreate, owner_id: uuid.UUID)`. Call sites then pass names.'
+files:
+  - backend/app/**/*.py
+ignores:
+  - backend/app/alembic/**
+rule:
+  kind: parameters
+  inside: { kind: function_definition }
+  not:
+    has:
+      any: [{ kind: keyword_separator }, { kind: list_splat_pattern }, { kind: typed_parameter, has: { kind: list_splat_pattern } }]
+  any:
+    - all:
+        - has: { nthChild: 3, not: { kind: comment } }
+        - not: { has: { nthChild: 1, regex: '^(self|cls)\b' } }
+    - has: { nthChild: 4, not: { kind: comment } }
